{
  "problemMatcher": [
    {
      "owner": "callisto",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(E[0-9]{3,4})$",
          "code": 1
        },
        {
          "regexp": "^$"
        },
        {
          "regexp": "^\\s+× (.+)$",
          "message": 1
        }
      ]
    }
  ]
}
