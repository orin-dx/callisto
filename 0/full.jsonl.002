{"parentUuid":"fd421b3e-a95c-4c92-8811-c36ab895f120","isSidechain":false,"promptId":"fbb155ba-b167-49bf-8715-f1b81bf02c2f","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QyURfYc9mfGtUdeUrHpEeg","type":"tool_result","content":"509\t#[test]\n510\tfn test_linked_group_propagates_severity_to_unseeded_member_and_converges() {\n511\t    let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n512\t    let pkg_b = PackageId::parse(\"pkg-b\").unwrap();\n513\t\n514\t    let graph = TwoPackageGraph {\n515\t        packages: vec![bare_package(&pkg_a), bare_package(&pkg_b)],\n516\t    };\n517\t\n518\t    let mut base = BTreeMap::new();\n519\t    base.insert(pkg_a.clone(), Version::semver(1, 0, 0));\n520\t    base.insert(pkg_b.clone(), Version::semver(1, 0, 0));\n521\t\n522\t    // Only pkg_b receives a severity via a changeset; pkg_a starts\n523\t    // completely unseeded.\n524\t    let mut seed = BTreeMap::new();\n525\t    seed.insert(pkg_b.clone(), Severity::Major);\n526\t\n527\t    let mut groups = GroupTable::default();\n528\t    let group_def = GroupDef {\n529\t        name: GroupName(\"linked-pair\".to_string()),\n530\t        kind: GroupKind::Linked,\n531\t        members: vec![GroupMember::Package(pkg_a.clone()), GroupMember::Package(pkg_b.clone())],\n532\t    };\n533\t    groups.linked.insert(group_def.name.clone(), group_def);\n534\t\n535\t    let cfg = CascadeConfig {\n536\t        mode: CascadeMode::OutOfRange,\n537\t        bump_severity: CascadeBumpSeverity::Patch,\n538\t        peer_escalation: true,\n539\t        preserve_npm_ranges: false,\n540\t    };\n541\t\n542\t    let reasons = BTreeMap::new();\n543\t    let named_by = BTreeMap::new();\n544\t\n545\t    let input = CascadeInput {\n546\t        graph: &graph,\n547\t        groups: &groups,\n548\t        cfg: &cfg,\n549\t        seed: &seed,\n550\t        reasons: &reasons,\n551\t        named_by: &named_by,\n552\t        base: &base,\n553\t        pre: None,\n554\t        tags: &TagIndex::empty(),\n555\t        identity: &IdentityIndex::default(),\n556\t    };\n557\t\n558\t    let outcome = run_cascade(input).unwrap();\n559\t\n560\t    // pkg_a was never seeded directly; it must pick up pkg_b's severity\n561\t    // purely through linked-group union.\n562\t    assert_eq!(outcome.severities.get(&pkg_a), Some(&Severity::Major));\n563\t    assert_eq!(outcome.severities.get(&pkg_b), Some(&Severity::Major));\n564\t\n565\t    let target_a = outcome.targets.get(&pkg_a).unwrap();\n566\t    let target_b = outcome.targets.get(&pkg_b).unwrap();\n567\t\n568\t    // Both members share the same base version, so convergence must\n569\t    // land them on the exact same target version.\n570\t    assert_eq!(target_a, target_b);\n571\t    assert_eq!(target_a.render(), \"2.0.0\");\n572\t\n573\t    assert_eq!(\n574\t        outcome.reasons.get(&pkg_a),\n575\t        Some(&BumpReason::LinkedGroupUnion {\n576\t            group: GroupName(\"linked-pair\".to_string()),\n577\t        })\n578\t    );\n579\t}\n580\t\n581\t/// Linked group members with *different* base versions must\n582\t/// converge on the SAME winning target version (the max of each member's\n583\t/// individually-computed candidate at the converged severity), not just\n584\t/// the same severity.\n585\t#[test]\n586\tfn test_linked_group_converges_target_version_across_divergent_bases() {\n587\t    let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n588\t    let pkg_b = PackageId::parse(\"pkg-b\").unwrap();"}]},"uuid":"3d36387d-a46c-459c-b2a7-46ce88fec395","timestamp":"2026-10-25T16:41:33.127Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/cascade/tests.rs","content":"#[test]\nfn test_linked_group_propagates_severity_to_unseeded_member_and_converges() {\n    let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n    let pkg_b = PackageId::parse(\"pkg-b\").unwrap();\n\n    let graph = TwoPackageGraph {\n        packages: vec![bare_package(&pkg_a), bare_package(&pkg_b)],\n    };\n\n    let mut base = BTreeMap::new();\n    base.insert(pkg_a.clone(), Version::semver(1, 0, 0));\n    base.insert(pkg_b.clone(), Version::semver(1, 0, 0));\n\n    // Only pkg_b receives a severity via a changeset; pkg_a starts\n    // completely unseeded.\n    let mut seed = BTreeMap::new();\n    seed.insert(pkg_b.clone(), Severity::Major);\n\n    let mut groups = GroupTable::default();\n    let group_def = GroupDef {\n        name: GroupName(\"linked-pair\".to_string()),\n        kind: GroupKind::Linked,\n        members: vec![GroupMember::Package(pkg_a.clone()), GroupMember::Package(pkg_b.clone())],\n    };\n    groups.linked.insert(group_def.name.clone(), group_def);\n\n    let cfg = CascadeConfig {\n        mode: CascadeMode::OutOfRange,\n        bump_severity: CascadeBumpSeverity::Patch,\n        peer_escalation: true,\n        preserve_npm_ranges: false,\n    };\n\n    let reasons = BTreeMap::new();\n    let named_by = BTreeMap::new();\n\n    let input = CascadeInput {\n        graph: &graph,\n        groups: &groups,\n        cfg: &cfg,\n        seed: &seed,\n        reasons: &reasons,\n        named_by: &named_by,\n        base: &base,\n        pre: None,\n        tags: &TagIndex::empty(),\n        identity: &IdentityIndex::default(),\n    };\n\n    let outcome = run_cascade(input).unwrap();\n\n    // pkg_a was never seeded directly; it must pick up pkg_b's severity\n    // purely through linked-group union.\n    assert_eq!(outcome.severities.get(&pkg_a), Some(&Severity::Major));\n    assert_eq!(outcome.severities.get(&pkg_b), Some(&Severity::Major));\n\n    let target_a = outcome.targets.get(&pkg_a).unwrap();\n    let target_b = outcome.targets.get(&pkg_b).unwrap();\n\n    // Both members share the same base version, so convergence must\n    // land them on the exact same target version.\n    assert_eq!(target_a, target_b);\n    assert_eq!(target_a.render(), \"2.0.0\");\n\n    assert_eq!(\n        outcome.reasons.get(&pkg_a),\n        Some(&BumpReason::LinkedGroupUnion {\n            group: GroupName(\"linked-pair\".to_string()),\n        })\n    );\n}\n\n/// Linked group members with *different* base versions must\n/// converge on the SAME winning target version (the max of each member's\n/// individually-computed candidate at the converged severity), not just\n/// the same severity.\n#[test]\nfn test_linked_group_converges_target_version_across_divergent_bases() {\n    let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n    let pkg_b = PackageId::parse(\"pkg-b\").unwrap();","numLines":80,"startLine":509,"totalLines":1975}},"sourceToolAssistantUUID":"fd421b3e-a95c-4c92-8811-c36ab895f120","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"test/cascade-properties","slug":"lexical-jingling-puppy"}
