xt = match &own {\n        ReleaseNotes::Section(section) => section.clone(),\n        ReleaseNotes::Generated { .. } => String::new(),\n    };\n    let mut extra = Vec::new();\n    for (name, member_changelog) in members {\n        let Ok(section) = changelog_section(root, member_changelog, version)? else {\n            continue;\n        };\n        for entry in entries(&section) {\n            let Some(body) = entry.strip_prefix(\"- \") else {\n                continue;\n            };\n            if is_group_boilerplate(&entry) || text.contains(body) || extra.iter().any(|seen: &String| seen.contains(body)) {\n                continue;\n            }\n            extra.push(format!(\"- `{name}`: {body}\"));\n        }\n    }\n    if extra.is_empty() {\n        return Ok(own);\n    }\n    if !text.is_empty() {\n        text.push('\\n');\n    }\n    text.push_str(&extra.join(\"\\n\"));\n    Ok(ReleaseNotes::Section(text))\n}\n\n#[cfg(test)]\nmod tests {\n    use callisto_model::VersionGrammar;"}},"serverClassifierRequest":"95c86863-f999-4eeb-8fd7-8901884c2dd6","apiBlockIndex":2,"requestId":"req_011CgLbA2EnN2sNyxccoKwqD","requestRef":"08dec725-5913-4cb2-96d7-20cc2a88f454","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"78298bd7-2cb9-4a81-94dc-3c58869d26de","timestamp":"2026-10-24T06:29:13.268Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/group-release-notes","slug":"lexical-jingling-puppy"}
{"parentUuid":"78298bd7-2cb9-4a81-94dc-3c58869d26de","isSidechain":false,"promptId":"611a0958-8088-4957-ad50-7eed36897c7a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SVDbrYcdUA5VKkHHXvGY1B","type":"tool_result","content":"The file /Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release/notes.rs has been updated successfully."}]},"uuid":"1a887171-4972-4209-a720-f967e17fba35","timestamp":"2026-10-24T06:29:13.426Z","toolUseResult":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release/notes.rs","oldString":"#[cfg(test)]\nmod tests {\n    use callisto_model::VersionGrammar;","newString":"/// A fixed-group member's changelog line that only says it was released with the group.\nfn is_group_boilerplate(entry: &str) -> bool {\n    entry.starts_with(\"- Released together with the `\") || entry.starts_with(\"- Joined the `\")\n}\n\n/// The changelog entries of a section: each `- ` bullet with its indented continuation lines.\nfn entries(section: &str) -> Vec<String> {\n    let mut entries: Vec<String> = Vec::new();\n    for line in section.lines() {\n        match entries.last_mut() {\n            Some(last) if line.starts_with(' ') || line.is_empty() => {\n                last.push('\\n');\n                last.push_str(line);\n            }\n            _ if line.starts_with(\"- \") => entries.push(line.to_owned()),\n            _ => {}\n        }\n    }\n    entries.iter().map(|entry| entry.trim_end().to_owned()).collect()\n}\n\n/// Release notes for a package in a fixed group: its own changelog section, then the entries that the group's other\n/// members recorded for the same version, each marked with the member it came from. The group is released as one\n/// unit, so a change recorded against a member that owns no release still belongs in the release's notes. An entry\n/// that is only the group boilerplate, or that the notes already hold, is left out. With no entry from another member\n/// the notes are exactly [`release_notes`].\n///\n/// # Errors\n///\n/// A changelog exists but cannot be read.\npub(crate) fn group_release_notes(\n    root: &Path,\n    changelog: Option<&Path>,\n    members: &[(String, &Path)],\n    version: &Version,\n) -> Result<ReleaseNotes, GraphError> {\n    let own = release_notes(root, changelog, version)?;\n    let mut text = match &own {\n        ReleaseNotes::Section(section) => section.clone(),\n        ReleaseNotes::Generated { .. } => String::new(),\n    };\n    let mut extra = Vec::new();\n    for (name, member_changelog) in members {\n        let Ok(section) = changelog_section(root, member_changelog, version)? else {\n            continue;\n        };\n        for entry in entries(&section) {\n            let Some(body) = entry.strip_prefix(\"- \") else {\n                continue;\n            };\n            if is_group_boilerplate(&entry) || text.contains(body) || extra.iter().any(|seen: &String| seen.contains(body)) {\n                continue;\n            }\n            extra.push(format!(\"- `{name}`: {body}\"));\n        }\n    }\n    if extra.is_empty() {\n        return Ok(own);\n    }\n    if !text.is_empty() {\n        text.push('\\n');\n    }\n    text.push_str(&extra.join(\"\\n\"));\n    Ok(ReleaseNotes::Section(text))\n}\n\n#[cfg(test)]\nmod tests {\n    use callisto_model::VersionGrammar;","originalFile":"//! The one changelog-section reader behind release notes.\n\nuse std::path::Path;\n\nuse callisto_model::Version;\n\nuse crate::error::GraphError;\n\nuse super::provider::{NotesFallback, ReleaseNotes};\n\n/// The non-empty `## {version}` section of the changelog at `root.join(changelog)`, or why there is none. A changelog\n/// that is there but cannot be read is an error, not a reason: the notes would silently differ from what was reviewed.\nfn changelog_section(\n    root: &Path,\n    changelog: &Path,\n    version: &Version,\n) -> Result<Result<String, NotesFallback>, GraphError> {\n    let path = root.join(changelog);\n    let content = match callisto_model::strict_fs::read_optional(&path) {\n        Ok(Some(content)) => content,\n        Ok(None) => return Ok(Err(NotesFallback::FileMissing)),\n        Err(error) => {\n            return Err(GraphError::ReleaseInputRead {\n                path,\n                message: error.to_string(),\n            })\n        }\n    };\n    Ok(match crate::changelog::find_section(&content, version) {\n        None => Err(NotesFallback::SectionMissing),\n        Some(\"\") => Err(NotesFallback::SectionEmpty),\n        Some(section) => Ok(section.to_owned()),\n    })\n}\n\n/// Release notes for a package: its changelog section, else generated notes and why.\n///\n/// # Errors\n///\n/// The changelog exists but cannot be read.\npub(crate) fn release_notes(\n    root: &Path,\n    changelog: Option<&Path>,\n    version: &Version,\n) -> Result<ReleaseNotes, GraphError> {\n    let Some(changelog) = changelog else {\n        return Ok(ReleaseNotes::Generated {\n            reason: NotesFallback::NotConfigured,\n        });\n    };\n    Ok(match changelog_section(root, changelog, version)? {\n        Ok(section) => ReleaseNotes::Section(section),\n        Err(reason) => ReleaseNotes::Generated { reason },\n    })\n}\n\n#[cfg(test)]\nmod tests {\n    use callisto_model::VersionGrammar;\n\n    use super::*;\n\n    fn notes(changelog: Option<&str>, body: Option<&str>) -> ReleaseNotes {\n        let dir = tempfile::tempdir().unwrap();\n        if let Some(body) = body {\n            std::fs::write(dir.path().join(\"CHANGELOG.md\"), body).unwrap();\n        }\n        let version = Version::parse(\"1.0.0\", VersionGrammar::SemVer).unwrap();\n        release_notes(dir.path(), changelog.map(Path::new), &version).unwrap()\n    }\n\n    fn generated(reason: NotesFallback) -> ReleaseNotes {\n        ReleaseNotes::Generated { reason }\n    }\n\n    #[test]\n    fn the_version_section_becomes_the_release_notes() {\n        assert_eq!(\n            notes(Some(\"CHANGELOG.md\"), Some(\"## 1.0.0\\n\\n- fix\\n\\n## 0.9.0\\n\\n- old\\n\")),\n            ReleaseNotes::Section(\"- fix\".to_owned())\n        );\n    }\n\n    /// A missing file, a missing heading, or an empty section falls back, never fails.\n    #[test]\n    fn missing_file_heading_or_content_falls_back_to_generated_notes() {\n        assert_eq!(notes(Some(\"CHANGELOG.md\"), None), generated(NotesFallback::FileMissing));\n        assert_eq!(\n            notes(Some(\"CHANGELOG.md\"), Some(\"## 0.9.0\\n\\n- old\\n\")),\n            generated(NotesFallback::SectionMissing)\n        );\n        assert_eq!(\n            notes(Some(\"CHANGELOG.md\"), Some(\"## 1.0.0\\n\\n## 0.9.0\\n\\n- old\\n\")),\n            generated(NotesFallback::SectionEmpty)\n        );\n        assert_eq!(notes(None, None), generated(NotesFallback::NotConfigured));\n    }\n\n    /// A changelog that exists but cannot be read (a directory, bytes that are not UTF-8) fails planning, not falls\n    /// back: generated notes would replace what the release PR reviewed without anyone choosing that.\n    #[test]\n    fn an_unreadable_changelog_is_an_error_not_generated_notes() {\n        let version = Version::parse(\"1.0.0\", VersionGrammar::SemVer).unwrap();\n        for unreadable in [\"directory\", \"not utf-8\"] {\n            let dir = tempfile::tempdir().unwrap();\n            let path = dir.path().join(\"CHANGELOG.md\");\n            if unreadable == \"directory\" {\n                std::fs::create_dir(&path).unwrap();\n            } else {\n                std::fs::write(&path, b\"## 1.0.0\\n\\n- caf\\xe9\\n\").unwrap();\n            }\n            let error = release_notes(dir.path(), Some(Path::new(\"CHANGELOG.md\")), &version).unwrap_err();\n            assert!(\n                matches!(&error, GraphError::ReleaseInputRead { path, .. } if path.ends_with(\"CHANGELOG.md\")),\n                \"{unreadable}: {error:?}\"\n            );\n        }\n    }\n}\n","structuredPatch":[{"oldStart":54,"oldLines":6,"newStart":54,"newLines":72,"lines":["     })"," }"," ","+/// A fixed-group member's changelog line that only says it was released with the group.","+fn is_group_boilerplate(entry: &str) -> bool {","+    entry.starts_with(\"- Released together with the `\") || entry.starts_with(\"- Joined the `\")","+}","+","+/// The changelog entries of a section: each `- ` bullet with its indented continuation lines.","+fn entries(section: &str) -> Vec<String> {","+    let mut entries: Vec<String> = Vec::new();","+    for line in section.lines() {","+        match entries.last_mut() {","+            Some(last) if line.starts_with(' ') || line.is_empty() => {","+                last.push('\\n');","+                last.push_str(line);","+            }","+            _ if line.starts_with(\"- \") => entries.push(line.to_owned()),","+            _ => {}","+        }","+    }","+    entries.iter().map(|entry| entry.trim_end().to_owned()).collect()","+}","+","+/// Release notes for a package in a fixed group: its own changelog section, then the entries that the group's other","+/// members recorded for the same version, each marked with the member it came from. The group is released as one","+/// unit, so a change recorded against a member that owns no release still belongs in the release's notes. An entry","+/// that is only the group boilerplate, or that the notes already hold, is left out. With no entry from another member","+/// the notes are exactly [`release_notes`].","+///","+/// # Errors","+///","+/// A changelog exists but cannot be read.","+pub(crate) fn group_release_notes(","+    root: &Path,","+    changelog: Option<&Path>,","+    members: &[(String, &Path)],","+    version: &Version,","+) -> Result<ReleaseNotes, GraphError> {","+    let own = release_notes(root, changelog, version)?;","+    let mut text = match &own {","+        ReleaseNotes::Section(section) => section.clone(),","+        ReleaseNotes::Generated { .. } => String::new(),","+    };","+    let mut extra = Vec::new();","+    for (name, member_changelog) in members {","+        let Ok(section) = changelog_section(root, member_changelog, version)? else {","+            continue;","+        };","+        for entry in entries(&section) {","+            let Some(body) = entry.strip_prefix(\"- \") else {","+                continue;","+            };","+            if is_group_boilerplate(&entry) || text.contains(body) || extra.iter().any(|seen: &String| seen.contains(body)) {","+                continue;","+            }","+            extra.push(format!(\"- `{name}`: {body}\"));","+        }","+    }","+    if extra.is_empty() {","+        return Ok(own);","+    }","+    if !text.is_empty() {","+        text.push('\\n');","+    }","+    text.push_str(&extra.join(\"\\n\"));","+    Ok(ReleaseNotes::Section(text))","+}","+"," #[cfg(test)]"," mod tests {","     use callisto_model::VersionGrammar;"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"78298bd7-2cb9-4a81-94dc-3c58869d26de","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/group-release-notes","slug":"lexical-jingling-puppy"}
