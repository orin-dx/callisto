s the decision file; it deletes no direct-child changeset `.md` file (nested Markdown files and `README.md` do not count); a claimed package's manifest does not change to its claimed version; a claimed package's changelog is unchanged; an unclaimed manifest version changes; a claimed package is not found; or the commit changes any path other than a manifest (`Cargo.toml`, `package.json`, `pyproject.toml`) or lockfile (`Cargo.lock`, `package-lock.json`, `npm-shrinkwrap.json`, `pnpm-lock.yaml`, `yarn.lock`, `bun.lock`, `bun.lockb`, `uv.lock`, `poetry.lock`, `pdm.lock`) anywhere, a package's changelog, the decision file, a direct-child changeset, or the changesets directory's `pre.json`.\",","       \"is_error_case\": true","     },","     {"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"b86322ef-053e-4bf8-84de-cea0d3b66fdc","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/release-commit-allowlist","slug":"lexical-jingling-puppy"}
