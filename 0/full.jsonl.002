{"type":"api-request-blob","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","hash":"5a8c64aa4d7f102930234e0c76556f72a3b9d00fe832323367b60b7580be368e","message":{"role":"user","content":[{"tool_use_id":"toolu_01TGS9FaSHChpnqxSyeF1Q4N","type":"tool_result","content":"862\t                .into_boxed_str(),\n863\t        ),\n864\t    }\n865\t}\n866\t\n867\t// Answering yes to the interactive question writes the generated workflow.\n868\t#[test]\n869\tfn interactive_workflow_confirm_writes_the_generated_file() {\n870\t    let dir = workspace(0);\n871\t    let run = run_init_with_runner(\n872\t        dir.path(),\n873\t        InitArgs::default(),\n874\t        true,\n875\t        vec![Answer::Select(0), Answer::Confirm(true), Answer::Confirm(true)],\n876\t        false,\n877\t        &fake_ls_remote(env!(\"CARGO_PKG_VERSION\")),\n878\t    );\n879\t    run.result.unwrap();\n880\t    assert_eq!(\n881\t        run.prompter.prompts(),\n882\t        [VERSIONING_PROMPT, WORKFLOW_PROMPT, WRITE_PROMPT]\n883\t    );\n884\t    assert_eq!(run.prompter.asked[1].1.as_deref(), Some(\"false\"), \"defaults to N\");\n885\t    let workflow = workflow_file(dir.path());\n886\t    assert!(\n887\t        workflow.contains(&format!(\n888\t            \"uses: orin-dx/callisto/.github/actions/callisto-action@{FAKE_COMMIT} # callisto@{}\",\n889\t            env!(\"CARGO_PKG_VERSION\")\n890\t        )),\n891\t        \"{workflow}\"\n892\t    );\n893\t    assert!(workflow.contains(\"with: {mode: version-pr, branch: main}\"));\n894\t    assert!(workflow.contains(\"with: {mode: release}\"));\n895\t    assert!(\n896\t        run.out.contains(\".github/workflows/callisto-release.yml:\"),\n897\t        \"{}\",\n898\t        run.out\n899\t    );\n900\t}\n901\t"},{"tool_use_id":"toolu_0125K7Z2myL9wjm2Xzn22vJo","type":"tool_result","content":"968\t}\n969\t\n970\t// A pre-existing `.changeset/config.json` warns per unhonoured key it declares, naming\n971\t// `fixed`'s callisto.toml replacement; init still writes normally alongside the warning.\n972\t#[test]\n973\tfn preexisting_changesets_config_json_warns_per_unhonoured_key() {\n974\t    let dir = workspace(0);\n975\t    std::fs::create_dir_all(dir.path().join(\".changeset\")).unwrap();\n976\t    std::fs::write(\n977\t        dir.path().join(\".changeset/config.json\"),\n978\t        r#\"{\"fixed\": [[\"core\"]], \"linked\": [[\"core\"]]}\"#,\n979\t    )\n980\t    .unwrap();\n981\t\n982\t    let out = Shared::default();\n983\t    let err = Shared::default();\n984\t    run_with_json(dir.path(), yes(InitVersioning::Independent), false, &out, &err);\n985\t    let report: serde_json::Value = serde_json::from_str(&out.text()).unwrap();\n986\t    let diagnostics = report[\"diagnostics\"].as_array().unwrap();\n987\t    assert_eq!(diagnostics.len(), 2, \"{report}\");\n988\t    assert!(diagnostics\n989\t        .iter()\n990\t        .all(|d| d[\"code\"] == \"changesets-config-key-dropped\" && d[\"severity\"] == \"warning\"));\n991\t    let fixed = diagnostics\n992\t        .iter()\n993\t        .find(|d| d[\"message\"].as_str().unwrap().contains(\"`fixed`\"))\n994\t        .unwrap();\n995\t    assert!(\n996\t        fixed[\"message\"].as_str().unwrap().contains(\"[[fixed-group]]\"),\n997\t        \"{fixed}\"\n998\t    );\n999\t    let linked = diagnostics\n1000\t        .iter()\n1001\t        .find(|d| d[\"message\"].as_str().unwrap().contains(\"`linked`\"))\n1002\t        .unwrap();\n1003\t    assert!(\n1004\t        linked[\"message\"].as_str().unwrap().contains(\"no equivalent\"),\n1005\t        \"{linked}\"\n1006\t    );\n1007\t    assert!(dir.path().join(\"callisto.toml\").exists());\n1008\t}\n1009\t\n1010\tfn run_with_json(root: &Path, args: InitArgs, dry_run: bool, out: &Shared, err: &Shared) {\n1011\t    run(\n1012\t        args,\n1013\t        &global(root, OutputFormat::Json, dry_run),\n1014\t        false,\n1015\t        &mut Scripted::new(vec![], out),\n1016\t        &mut out.clone(),\n1017\t        &mut err.clone(),\n1018\t        &fake_ls_remote(env!(\"CARGO_PKG_VERSION\")),\n1019\t    )\n1020\t    .unwrap();\n1021\t}\n1022\t\n1023\t// An unresolvable tag (offline, or an unreleased version) errors clearly, naming the fix.\n1024\t#[test]\n1025\tfn unresolvable_version_errors_naming_the_fix() {\n1026\t    let dir = workspace(0);\n1027\t    let empty = FakeLsRemote { stdout: \"\" };\n1028\t    let args = InitArgs {\n1029\t        workflow: true,\n1030\t        ..yes(InitVersioning::Independent)\n1031\t    };\n1032\t    let run = run_init_with_runner(dir.path(), args, false, vec![], false, &empty);\n1033\t    let error = run.result.unwrap_err();\n1034\t    assert!(\n1035\t        matches!(\n1036\t            &error,\n1037\t            CliError::Graph(GraphError::InitWorkflowVersionUnresolved { .. })\n1038\t        ),\n1039\t        \"{error}\"\n1040\t    );\n1041\t    assert!(error.to_string().contains(\"couldn't resolve\"), \"{error}\");\n1042\t    assert!(error.to_string().contains(env!(\"CARGO_PKG_VERSION\")), \"{error}\");\n1043\t    assert!(!dir.path().join(\".github/workflows/callisto-release.yml\").exists());\n1044\t}\n1045\t\n1046\t// Declining interactively, `--no-workflow`, and `--yes` with neither flag all write nothing.\n1047\t#[test]\n1048\tfn workflow_not_requested_writes_nothing() {\n1049\t    let declined = workspace(0);\n1050\t    let run = run_init(\n1051\t        declined.path(),\n1052\t        InitArgs::default(),\n1053\t        true,\n1054\t        vec![Answer::Select(0), Answer::Confirm(false), Answer::Confirm(true)],\n1055\t        false,\n1056\t    );\n1057\t    run.result.unwrap();\n1058\t    assert!(!declined.path().join(\".github/workflows/callisto-release.yml\").exists());\n1059\t\n1060\t    let no_flag = workspace(0);\n1061\t    let args = InitArgs {\n1062\t        no_workflow: true,\n1063\t        ..yes(InitVersioning::Independent)\n1064\t    };\n1065\t    let run = run_init(no_flag.path(), args, false, vec![], false);\n1066\t    run.result.unwrap();\n1067\t    assert!(run.prompter.prompts().is_empty());\n1068\t    assert!(!no_flag.path().join(\".github/workflows/callisto-release.yml\").exists());\n1069\t\n1070\t    let default_yes = workspace(0);\n1071\t    run_init(\n1072\t        default_yes.path(),\n1073\t        yes(InitVersioning::Independent),\n1074\t        false,\n1075\t        vec![],\n1076\t        false,\n1077\t    )\n1078\t    .result\n1079\t    .unwrap();\n1080\t    assert!(!default_yes\n1081\t        .path()\n1082\t        .join(\".github/workflows/callisto-release.yml\")\n1083\t        .exists());\n1084\t}\n1085\t\n1086\t// An existing workflow file errors before the preview, in both normal and --dry-run runs.\n1087\t#[test]"}]}}
