{"parentUuid":"335926d2-a871-4734-b2dc-65a135dc4fa0","isSidechain":false,"promptId":"81e97b21-5b87-4de1-93b0-c0727fa54480","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N4iZ8GrAin66Rn6NCv5bhW","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# Regression test for a real production incident (2026-08-27): consumer CI\n3\t# (orin-dx/michi) failed to install callisto because setup-callisto's\n4\t# fallback chain never tried crates.io -- only a GitHub Release binary\n5\t# tarball (which has no assets attached to any release, always 404s) and\n6\t# `cargo install --git` (broken on main by an unrelated yanked dependency).\n7\t# callisto-cli@0.5.0 was already published and installable from crates.io\n8\t# the whole time. This proves the new crates.io fallback is actually tried,\n9\t# in the right order, with the right args, before the git-source fallback.\n10\tset -u\n11\tINSTALL_SCRIPT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)/scripts/install-callisto.sh\"\n12\t\n13\textract_snippet() {\n14\t  # Starts after the TAG_NAME assignment line -- the caller sets TAG_NAME\n15\t  # directly instead. Uses explicit line numbers, not a `fi`-pattern range,\n16\t  # because the block contains a nested if/elif/fi (OS detection) before the\n17\t  # outer if/elif/elif/else/fi this test targets -- a pattern-based range\n18\t  # would stop at the first (inner) `fi` it finds.\n19\t  local start end\n20\t  start=$(grep -n '# Detect OS platform architecture for pre-built binaries' \"$INSTALL_SCRIPT\" | head -1 | cut -d: -f1)\n21\t  end=$(grep -n 'CALLISTO_BIN_DIR\" >> \\$GITHUB_PATH' \"$INSTALL_SCRIPT\" | head -1 | cut -d: -f1)\n22\t  end=$((end - 1))\n23\t  sed -n \"${start},${end}p\" \"$INSTALL_SCRIPT\"\n24\t}\n25\t\n26\trun_case() {\n27\t  local version=\"$1\"\n28\t  local curl_behavior=\"$2\"    # \"fail\" or \"succeed\"\n29\t  local cargo_behavior=\"$3\"   # \"crates-io-succeeds\" or \"crates-io-fails\"\n30\t  local calls_file tmp_script workdir\n31\t  calls_file=\"$(mktemp)\"\n32\t  workdir=\"$(mktemp -d)\"\n33\t  tmp_script=\"$(mktemp)\"\n34\t  {\n35\t    echo \"curl() { echo \\\"curl \\$*\\\" >> '${calls_file}'; [[ '${curl_behavior}' == fail ]] && return 1 || return 0; }\"\n36\t    echo \"tar() { return 0; }\"\n37\t    echo \"unzip() { return 99; }\"\n38\t    echo \"git() { return 99; }\"\n39\t    echo \"gh() { echo \\\"gh \\$*\\\" >> '${calls_file}'; return 1; }\"\n40\t    echo \"cargo() {\"\n41\t    echo \"  echo \\\"cargo \\$*\\\" >> '${calls_file}'\"\n42\t    echo \"  if [[ \\\"\\$1\\\" == install && \\\"\\$*\\\" == *'callisto-cli'* && \\\"\\$*\\\" != *'--git'* ]]; then\"\n43\t    echo \"    [[ '${cargo_behavior}' == crates-io-succeeds ]] && { mkdir -p \\\"\\${RUNNER_TEMP}/callisto-cargo-install/bin\\\"; touch \\\"\\${RUNNER_TEMP}/callisto-cargo-install/bin/callisto\\\"; return 0; } || return 1\"\n44\t    echo \"  fi\"\n45\t    echo \"  if [[ \\\"\\$*\\\" == *'--git'* ]]; then\"\n46\t    echo \"    mkdir -p \\\"\\${RUNNER_TEMP}/callisto-cargo-install/bin\\\"; touch \\\"\\${RUNNER_TEMP}/callisto-cargo-install/bin/callisto\\\"; return 0\"\n47\t    echo \"  fi\"\n48\t    echo \"}\"\n49\t    echo \"cp() { command cp \\\"\\$@\\\"; }\"\n50\t    echo \"mkdir() { command mkdir \\\"\\$@\\\"; }\"\n51\t    echo \"grep() { command grep \\\"\\$@\\\"; }\"\n52\t    echo \"uname() { [[ \\\"\\$1\\\" == -s ]] && echo Linux || echo x86_64; }\"\n53\t    echo \"RUNNER_TEMP='${workdir}'\"\n54\t    echo \"GITHUB_WORKSPACE='${workdir}/not-callisto'\"\n55\t    echo \"mkdir -p \\\"\\$GITHUB_WORKSPACE\\\"\"\n56\t    echo \"GITHUB_PATH='${workdir}/github_path'\"\n57\t    echo \"touch \\\"\\$GITHUB_PATH\\\"\"\n58\t    echo \"TAG_NAME='${version}'\"\n59\t    echo \"SOURCE=auto\"\n60\t    echo \"CALLISTO_BIN_DIR='${workdir}/callisto-bin'\"\n61\t    echo \"mkdir -p '${workdir}/callisto-bin'\"\n62\t    extract_snippet\n63\t  } > \"$tmp_script\"\n64\t  bash \"$tmp_script\" 2>/dev/null\n65\t  local code=$?\n66\t  cat \"$calls_file\"\n67\t  rm -f \"$tmp_script\" \"$calls_file\"\n68\t  rm -rf \"$workdir\"\n69\t  return $code\n70\t}\n71\t\n72\tfail=0\n73\t\n74\t# crates.io install must be attempted (and succeed) before the git fallback,\n75\t# when the GH-release binary download fails and version=\"latest\".\n76\tout=$(run_case \"latest\" \"fail\" \"crates-io-succeeds\")\n77\tif [[ \"$out\" != *\"cargo install callisto-cli --locked\"* ]]; then\n78\t  echo \"FAIL: crates.io install (latest) must be attempted, got: $out\"; fail=1\n79\telif [[ \"$out\" == *\"--git\"* ]]; then\n80\t  echo \"FAIL: git fallback must not run when crates.io install succeeds, got: $out\"; fail=1\n81\telse\n82\t  echo \"PASS: crates.io install (latest) attempted, git fallback skipped\"\n83\tfi\n84\t\n85\t# An explicit \"callisto-cli@0.5.0\" version must strip to a bare \"0.5.0\" for\n86\t# `cargo install --version`.\n87\tout=$(run_case \"callisto-cli@0.5.0\" \"fail\" \"crates-io-succeeds\")\n88\tif [[ \"$out\" != *\"--version 0.5.0\"* ]]; then\n89\t  echo \"FAIL: explicit version must strip the callisto-cli@ prefix, got: $out\"; fail=1\n90\telse\n91\t  echo \"PASS: explicit version tag strips to bare semver for --version\"\n92\tfi\n93\t\n94\t# When crates.io install also fails, the git-source fallback must still run\n95\t# (it isn't removed, just demoted to last resort).\n96\tout=$(run_case \"latest\" \"fail\" \"crates-io-fails\")\n97\tif [[ \"$out\" != *\"--git\"* ]]; then\n98\t  echo \"FAIL: git fallback must still run when crates.io install fails too, got: $out\"; fail=1\n99\telse\n100\t  echo \"PASS: git fallback still runs when crates.io install fails\"\n101\tfi\n102\t\n103\tfor version in callisto@0.5.0 callisto-cli@0.5.0 0.5.0; do\n104\t  out=$(run_case \"$version\" fail crates-io-fails); code=$?\n105\t  if [[ $code -eq 0 || \"$out\" != *\"--version 0.5.0\"* || \"$out\" == *\"--git\"* ]]; then\n106\t    echo \"FAIL: unavailable pin $version must fail without git fallback: code=$code out=$out\"; fail=1\n107\t  else\n108\t    echo \"PASS: unavailable pin $version fails without git fallback\"\n109\t  fi\n110\tdone\n111\t\n112\texit $fail\n113\t"}]},"uuid":"f58968b6-3b8d-47e0-afc7-fabd30055b10","timestamp":"2026-10-24T18:42:24.062Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/.github/actions/setup-callisto/tests/test_crates_io_fallback.sh","content":"#!/usr/bin/env bash\n# Regression test for a real production incident (2026-08-27): consumer CI\n# (orin-dx/michi) failed to install callisto because setup-callisto's\n# fallback chain never tried crates.io -- only a GitHub Release binary\n# tarball (which has no assets attached to any release, always 404s) and\n# `cargo install --git` (broken on main by an unrelated yanked dependency).\n# callisto-cli@0.5.0 was already published and installable from crates.io\n# the whole time. This proves the new crates.io fallback is actually tried,\n# in the right order, with the right args, before the git-source fallback.\nset -u\nINSTALL_SCRIPT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)/scripts/install-callisto.sh\"\n\nextract_snippet() {\n  # Starts after the TAG_NAME assignment line -- the caller sets TAG_NAME\n  # directly instead. Uses explicit line numbers, not a `fi`-pattern range,\n  # because the block contains a nested if/elif/fi (OS detection) before the\n  # outer if/elif/elif/else/fi this test targets -- a pattern-based range\n  # would stop at the first (inner) `fi` it finds.\n  local start end\n  start=$(grep -n '# Detect OS platform architecture for pre-built binaries' \"$INSTALL_SCRIPT\" | head -1 | cut -d: -f1)\n  end=$(grep -n 'CALLISTO_BIN_DIR\" >> \\$GITHUB_PATH' \"$INSTALL_SCRIPT\" | head -1 | cut -d: -f1)\n  end=$((end - 1))\n  sed -n \"${start},${end}p\" \"$INSTALL_SCRIPT\"\n}\n\nrun_case() {\n  local version=\"$1\"\n  local curl_behavior=\"$2\"    # \"fail\" or \"succeed\"\n  local cargo_behavior=\"$3\"   # \"crates-io-succeeds\" or \"crates-io-fails\"\n  local calls_file tmp_script workdir\n  calls_file=\"$(mktemp)\"\n  workdir=\"$(mktemp -d)\"\n  tmp_script=\"$(mktemp)\"\n  {\n    echo \"curl() { echo \\\"curl \\$*\\\" >> '${calls_file}'; [[ '${curl_behavior}' == fail ]] && return 1 || return 0; }\"\n    echo \"tar() { return 0; }\"\n    echo \"unzip() { return 99; }\"\n    echo \"git() { return 99; }\"\n    echo \"gh() { echo \\\"gh \\$*\\\" >> '${calls_file}'; return 1; }\"\n    echo \"cargo() {\"\n    echo \"  echo \\\"cargo \\$*\\\" >> '${calls_file}'\"\n    echo \"  if [[ \\\"\\$1\\\" == install && \\\"\\$*\\\" == *'callisto-cli'* && \\\"\\$*\\\" != *'--git'* ]]; then\"\n    echo \"    [[ '${cargo_behavior}' == crates-io-succeeds ]] && { mkdir -p \\\"\\${RUNNER_TEMP}/callisto-cargo-install/bin\\\"; touch \\\"\\${RUNNER_TEMP}/callisto-cargo-install/bin/callisto\\\"; return 0; } || return 1\"\n    echo \"  fi\"\n    echo \"  if [[ \\\"\\$*\\\" == *'--git'* ]]; then\"\n    echo \"    mkdir -p \\\"\\${RUNNER_TEMP}/callisto-cargo-install/bin\\\"; touch \\\"\\${RUNNER_TEMP}/callisto-cargo-install/bin/callisto\\\"; return 0\"\n    echo \"  fi\"\n    echo \"}\"\n    echo \"cp() { command cp \\\"\\$@\\\"; }\"\n    echo \"mkdir() { command mkdir \\\"\\$@\\\"; }\"\n    echo \"grep() { command grep \\\"\\$@\\\"; }\"\n    echo \"uname() { [[ \\\"\\$1\\\" == -s ]] && echo Linux || echo x86_64; }\"\n    echo \"RUNNER_TEMP='${workdir}'\"\n    echo \"GITHUB_WORKSPACE='${workdir}/not-callisto'\"\n    echo \"mkdir -p \\\"\\$GITHUB_WORKSPACE\\\"\"\n    echo \"GITHUB_PATH='${workdir}/github_path'\"\n    echo \"touch \\\"\\$GITHUB_PATH\\\"\"\n    echo \"TAG_NAME='${version}'\"\n    echo \"SOURCE=auto\"\n    echo \"CALLISTO_BIN_DIR='${workdir}/callisto-bin'\"\n    echo \"mkdir -p '${workdir}/callisto-bin'\"\n    extract_snippet\n  } > \"$tmp_script\"\n  bash \"$tmp_script\" 2>/dev/null\n  local code=$?\n  cat \"$calls_file\"\n  rm -f \"$tmp_script\" \"$calls_file\"\n  rm -rf \"$workdir\"\n  return $code\n}\n\nfail=0\n\n# crates.io install must be attempted (and succeed) before the git fallback,\n# when the GH-release binary download fails and version=\"latest\".\nout=$(run_case \"latest\" \"fail\" \"crates-io-succeeds\")\nif [[ \"$out\" != *\"cargo install callisto-cli --locked\"* ]]; then\n  echo \"FAIL: crates.io install (latest) must be attempted, got: $out\"; fail=1\nelif [[ \"$out\" == *\"--git\"* ]]; then\n  echo \"FAIL: git fallback must not run when crates.io install succeeds, got: $out\"; fail=1\nelse\n  echo \"PASS: crates.io install (latest) attempted, git fallback skipped\"\nfi\n\n# An explicit \"callisto-cli@0.5.0\" version must strip to a bare \"0.5.0\" for\n# `cargo install --version`.\nout=$(run_case \"callisto-cli@0.5.0\" \"fail\" \"crates-io-succeeds\")\nif [[ \"$out\" != *\"--version 0.5.0\"* ]]; then\n  echo \"FAIL: explicit version must strip the callisto-cli@ prefix, got: $out\"; fail=1\nelse\n  echo \"PASS: explicit version tag strips to bare semver for --version\"\nfi\n\n# When crates.io install also fails, the git-source fallback must still run\n# (it isn't removed, just demoted to last resort).\nout=$(run_case \"latest\" \"fail\" \"crates-io-fails\")\nif [[ \"$out\" != *\"--git\"* ]]; then\n  echo \"FAIL: git fallback must still run when crates.io install fails too, got: $out\"; fail=1\nelse\n  echo \"PASS: git fallback still runs when crates.io install fails\"\nfi\n\nfor version in callisto@0.5.0 callisto-cli@0.5.0 0.5.0; do\n  out=$(run_case \"$version\" fail crates-io-fails); code=$?\n  if [[ $code -eq 0 || \"$out\" != *\"--version 0.5.0\"* || \"$out\" == *\"--git\"* ]]; then\n    echo \"FAIL: unavailable pin $version must fail without git fallback: code=$code out=$out\"; fail=1\n  else\n    echo \"PASS: unavailable pin $version fails without git fallback\"\n  fi\ndone\n\nexit $fail\n","numLines":113,"startLine":1,"totalLines":113}},"sourceToolAssistantUUID":"335926d2-a871-4734-b2dc-65a135dc4fa0","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"chore/remove-legacy-surface","slug":"lexical-jingling-puppy"}
