{"parentUuid":"b1c8fd13-e6dd-42be-9308-14bc01179399","isSidechain":false,"promptId":"e05639b3-9150-41dd-8002-a9fd8a53af89","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016Av61xUiqBZcYb5Q5yfXWy","type":"tool_result","content":"1\tuse std::path::{Path, PathBuf};\n2\t\n3\tuse callisto_model::vcs::{GitAccess, VcsError};\n4\tuse callisto_model::CommandRunner;\n5\t\n6\tuse crate::locate::membership::{parse_error, read_root_manifest};\n7\tuse crate::locate::LocateError;\n8\t\n9\t/// Finds the root between `start` and its Git toplevel (never above it): the nearest\n10\t/// workspace marker, else the outermost package manifest so vendored packages can't shadow it.\n11\t///\n12\t/// The toplevel comes from `git rev-parse --show-toplevel` (via `runner`), not a hand-rolled\n13\t/// walk for a `.git` entry -- `git` alone honors `GIT_DIR`/`GIT_WORK_TREE`/\n14\t/// `GIT_CEILING_DIRECTORIES` the way every other Git-aware tool does.\n15\tpub fn find_workspace_root(start: &Path, runner: &dyn CommandRunner) -> Result<PathBuf, LocateError> {\n16\t    let canonical = dunce::canonicalize(start).unwrap_or_else(|_| start.to_path_buf());\n17\t    let toplevel = GitAccess::new(&canonical, runner).toplevel().map_err(|e| match &e {\n18\t        VcsError::Git(message) if message.to_lowercase().contains(\"not a git repository\") => {\n19\t            LocateError::NotAGitRepository {\n20\t                start: start.to_path_buf(),\n21\t            }\n22\t        }\n23\t        _ => LocateError::from(e),\n24\t    })?;\n25\t    let range = || canonical.ancestors().take_while(|dir| dir.starts_with(&toplevel));\n26\t    for dir in range() {\n27\t        if is_workspace_root(dir)? {\n28\t            return Ok(dir.to_path_buf());\n29\t        }\n30\t    }\n31\t    let mut outermost = None;\n32\t    for dir in range() {\n33\t        if is_package_root(dir)? {\n34\t            outermost = Some(dir);\n35\t        }\n36\t    }\n37\t    outermost\n38\t        .map(Path::to_path_buf)\n39\t        .ok_or_else(|| LocateError::WorkspaceRootNotFound {\n40\t            start: start.to_path_buf(),\n41\t            toplevel: toplevel.clone(),\n42\t        })\n43\t}\n44\t\n45\t/// Loads `dir/Cargo.toml` as a TOML document, or `None` if it does not exist. A manifest that cannot be read or\n46\t/// parsed is an error: skipping it would let the search settle on a different root.\n47\tfn cargo_document(dir: &Path) -> Result<Option<toml_edit::DocumentMut>, LocateError> {\n48\t    let path = dir.join(\"Cargo.toml\");\n49\t    read_root_manifest(&path)?\n50\t        .map(|content| {\n51\t            content\n52\t                .parse::<toml_edit::DocumentMut>()\n53\t                .map_err(|error| parse_error(&path, error.to_string()))\n54\t        })\n55\t        .transpose()\n56\t}\n57\t\n58\tfn path_exists(path: &Path) -> Result<bool, LocateError> {\n59\t    callisto_model::strict_fs::exists(path).map_err(|error| LocateError::ManifestReadError {\n60\t        path: path.to_path_buf(),\n61\t        message: error.to_string(),\n62\t    })\n63\t}\n64\t\n65\t/// A single-package repository root: `Cargo.toml` with `[package]`, `package.json`, or `pyproject.toml`.\n66\tfn is_package_root(dir: &Path) -> Result<bool, LocateError> {\n67\t    // Parsed, so a comment that mentions the name does not count; any spelling of the table does.\n68\t    if cargo_document(dir)?.is_some_and(|doc| doc.get(\"package\").is_some_and(toml_edit::Item::is_table_like)) {\n69\t        return Ok(true);\n70\t    }\n71\t    Ok(path_exists(&dir.join(\"package.json\"))? || path_exists(&dir.join(\"pyproject.toml\"))?)\n72\t}\n73\t\n74\tfn is_workspace_root(dir: &Path) -> Result<bool, LocateError> {\n75\t    if cargo_document(dir)?.is_some_and(|doc| callisto_manifests::declares_workspace(&doc)) {\n76\t        return Ok(true);\n77\t    }\n78\t\n79\t    let pkg_json = dir.join(\"package.json\");\n80\t    if let Some(content) = read_root_manifest(&pkg_json)? {\n81\t        let value = serde_json::from_str::<serde_json::Value>(&content)\n82\t            .map_err(|error| parse_error(&pkg_json, error.to_string()))?;\n83\t        if value.get(\"workspaces\").is_some() {\n84\t            return Ok(true);\n85\t        }\n86\t    }\n87\t\n88\t    Ok(path_exists(&dir.join(\"pnpm-workspace.yaml\"))? || dir.join(\".moon\").is_dir())\n89\t}\n90\t\n91\t#[cfg(test)]\n92\tmod tests {\n93\t    use std::fs;\n94\t\n95\t    use callisto_model::{CommandError, CommandOutput, CommandRunner};\n96\t\n97\t    use super::*;\n98\t\n99\t    fn write(root: &Path, path: &str, content: &str) {\n100\t        let path = root.join(path);\n101\t        fs::create_dir_all(path.parent().unwrap()).unwrap();\n102\t        fs::write(path, content).unwrap();\n103\t    }\n104\t\n105\t    /// A tempdir holding a `.git` marker: the Git toplevel.\n106\t    fn repo() -> (tempfile::TempDir, PathBuf) {\n107\t        let dir = tempfile::tempdir().unwrap();\n108\t        fs::create_dir(dir.path().join(\".git\")).unwrap();\n109\t        let root = dunce::canonicalize(dir.path()).unwrap();\n110\t        (dir, root)\n111\t    }\n112\t\n113\t    /// Stands in for the real `git` binary's `rev-parse --show-toplevel`, so these tests stay\n114\t    /// deterministic and don't require a real repository on disk. It answers by walking `cwd`'s\n115\t    /// ancestors for the nearest `.git` entry (file or directory), the same observable result\n116\t    /// real `git` gives for these fixtures -- `find_workspace_root` itself is what's under test\n117\t    /// here, not `git`'s own toplevel resolution.\n118\t    struct FakeGitToplevel;\n119\t\n120\t    impl CommandRunner for FakeGitToplevel {\n121\t        fn run(&self, _program: &str, args: &[&str], cwd: &Path) -> Result<CommandOutput, CommandError> {\n122\t            assert_eq!(args, [\"rev-parse\", \"--show-toplevel\"]);\n123\t            match cwd.ancestors().find(|dir| dir.join(\".git\").exists()) {\n124\t                Some(toplevel) => Ok(CommandOutput {\n125\t                    exit_code: Some(0),\n126\t                    stdout: format!(\"{}\\n\", toplevel.display()),\n127\t                    stderr: String::new(),\n128\t                }),\n129\t                None => Ok(CommandOutput {\n130\t                    exit_code: Some(128),\n131\t                    stdout: String::new(),\n132\t                    stderr: \"fatal: not a git repository (or any of the parent directories): .git\".to_string(),\n133\t                }),\n134\t            }\n135\t        }\n136\t    }\n137\t\n138\t    fn find(start: &Path) -> Result<PathBuf, LocateError> {\n139\t        find_workspace_root(start, &FakeGitToplevel)\n140\t    }\n141\t\n142\t    const CRATE: &str = \"[package]\\nname = \\\"app\\\"\\nversion = \\\"1.0.0\\\"\\n\";\n143\t\n144\t    #[test]\n145\t    fn a_single_package_at_the_toplevel_is_the_root_from_a_subdirectory() {\n146\t        for (manifest, content) in [\n147\t            (\"Cargo.toml\", CRATE),\n148\t            (\"package.json\", r#\"{\"name\":\"app\",\"version\":\"1.0.0\"}\"#),\n149\t            (\"pyproject.toml\", \"[project]\\nname = \\\"app\\\"\\nversion = \\\"1.0.0\\\"\\n\"),\n150\t        ] {"}]},"uuid":"01f18c00-b3ba-43be-8cdb-4e3a6ea54627","timestamp":"2026-10-25T00:00:55.301Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/locate/root.rs","content":"use std::path::{Path, PathBuf};\n\nuse callisto_model::vcs::{GitAccess, VcsError};\nuse callisto_model::CommandRunner;\n\nuse crate::locate::membership::{parse_error, read_root_manifest};\nuse crate::locate::LocateError;\n\n/// Finds the root between `start` and its Git toplevel (never above it): the nearest\n/// workspace marker, else the outermost package manifest so vendored packages can't shadow it.\n///\n/// The toplevel comes from `git rev-parse --show-toplevel` (via `runner`), not a hand-rolled\n/// walk for a `.git` entry -- `git` alone honors `GIT_DIR`/`GIT_WORK_TREE`/\n/// `GIT_CEILING_DIRECTORIES` the way every other Git-aware tool does.\npub fn find_workspace_root(start: &Path, runner: &dyn CommandRunner) -> Result<PathBuf, LocateError> {\n    let canonical = dunce::canonicalize(start).unwrap_or_else(|_| start.to_path_buf());\n    let toplevel = GitAccess::new(&canonical, runner).toplevel().map_err(|e| match &e {\n        VcsError::Git(message) if message.to_lowercase().contains(\"not a git repository\") => {\n            LocateError::NotAGitRepository {\n                start: start.to_path_buf(),\n            }\n        }\n        _ => LocateError::from(e),\n    })?;\n    let range = || canonical.ancestors().take_while(|dir| dir.starts_with(&toplevel));\n    for dir in range() {\n        if is_workspace_root(dir)? {\n            return Ok(dir.to_path_buf());\n        }\n    }\n    let mut outermost = None;\n    for dir in range() {\n        if is_package_root(dir)? {\n            outermost = Some(dir);\n        }\n    }\n    outermost\n        .map(Path::to_path_buf)\n        .ok_or_else(|| LocateError::WorkspaceRootNotFound {\n            start: start.to_path_buf(),\n            toplevel: toplevel.clone(),\n        })\n}\n\n/// Loads `dir/Cargo.toml` as a TOML document, or `None` if it does not exist. A manifest that cannot be read or\n/// parsed is an error: skipping it would let the search settle on a different root.\nfn cargo_document(dir: &Path) -> Result<Option<toml_edit::DocumentMut>, LocateError> {\n    let path = dir.join(\"Cargo.toml\");\n    read_root_manifest(&path)?\n        .map(|content| {\n            content\n                .parse::<toml_edit::DocumentMut>()\n                .map_err(|error| parse_error(&path, error.to_string()))\n        })\n        .transpose()\n}\n\nfn path_exists(path: &Path) -> Result<bool, LocateError> {\n    callisto_model::strict_fs::exists(path).map_err(|error| LocateError::ManifestReadError {\n        path: path.to_path_buf(),\n        message: error.to_string(),\n    })\n}\n\n/// A single-package repository root: `Cargo.toml` with `[package]`, `package.json`, or `pyproject.toml`.\nfn is_package_root(dir: &Path) -> Result<bool, LocateError> {\n    // Parsed, so a comment that mentions the name does not count; any spelling of the table does.\n    if cargo_document(dir)?.is_some_and(|doc| doc.get(\"package\").is_some_and(toml_edit::Item::is_table_like)) {\n        return Ok(true);\n    }\n    Ok(path_exists(&dir.join(\"package.json\"))? || path_exists(&dir.join(\"pyproject.toml\"))?)\n}\n\nfn is_workspace_root(dir: &Path) -> Result<bool, LocateError> {\n    if cargo_document(dir)?.is_some_and(|doc| callisto_manifests::declares_workspace(&doc)) {\n        return Ok(true);\n    }\n\n    let pkg_json = dir.join(\"package.json\");\n    if let Some(content) = read_root_manifest(&pkg_json)? {\n        let value = serde_json::from_str::<serde_json::Value>(&content)\n            .map_err(|error| parse_error(&pkg_json, error.to_string()))?;\n        if value.get(\"workspaces\").is_some() {\n            return Ok(true);\n        }\n    }\n\n    Ok(path_exists(&dir.join(\"pnpm-workspace.yaml\"))? || dir.join(\".moon\").is_dir())\n}\n\n#[cfg(test)]\nmod tests {\n    use std::fs;\n\n    use callisto_model::{CommandError, CommandOutput, CommandRunner};\n\n    use super::*;\n\n    fn write(root: &Path, path: &str, content: &str) {\n        let path = root.join(path);\n        fs::create_dir_all(path.parent().unwrap()).unwrap();\n        fs::write(path, content).unwrap();\n    }\n\n    /// A tempdir holding a `.git` marker: the Git toplevel.\n    fn repo() -> (tempfile::TempDir, PathBuf) {\n        let dir = tempfile::tempdir().unwrap();\n        fs::create_dir(dir.path().join(\".git\")).unwrap();\n        let root = dunce::canonicalize(dir.path()).unwrap();\n        (dir, root)\n    }\n\n    /// Stands in for the real `git` binary's `rev-parse --show-toplevel`, so these tests stay\n    /// deterministic and don't require a real repository on disk. It answers by walking `cwd`'s\n    /// ancestors for the nearest `.git` entry (file or directory), the same observable result\n    /// real `git` gives for these fixtures -- `find_workspace_root` itself is what's under test\n    /// here, not `git`'s own toplevel resolution.\n    struct FakeGitToplevel;\n\n    impl CommandRunner for FakeGitToplevel {\n        fn run(&self, _program: &str, args: &[&str], cwd: &Path) -> Result<CommandOutput, CommandError> {\n            assert_eq!(args, [\"rev-parse\", \"--show-toplevel\"]);\n            match cwd.ancestors().find(|dir| dir.join(\".git\").exists()) {\n                Some(toplevel) => Ok(CommandOutput {\n                    exit_code: Some(0),\n                    stdout: format!(\"{}\\n\", toplevel.display()),\n                    stderr: String::new(),\n                }),\n                None => Ok(CommandOutput {\n                    exit_code: Some(128),\n                    stdout: String::new(),\n                    stderr: \"fatal: not a git repository (or any of the parent directories): .git\".to_string(),\n                }),\n            }\n        }\n    }\n\n    fn find(start: &Path) -> Result<PathBuf, LocateError> {\n        find_workspace_root(start, &FakeGitToplevel)\n    }\n\n    const CRATE: &str = \"[package]\\nname = \\\"app\\\"\\nversion = \\\"1.0.0\\\"\\n\";\n\n    #[test]\n    fn a_single_package_at_the_toplevel_is_the_root_from_a_subdirectory() {\n        for (manifest, content) in [\n            (\"Cargo.toml\", CRATE),\n            (\"package.json\", r#\"{\"name\":\"app\",\"version\":\"1.0.0\"}\"#),\n            (\"pyproject.toml\", \"[project]\\nname = \\\"app\\\"\\nversion = \\\"1.0.0\\\"\\n\"),\n        ] {","numLines":150,"startLine":1,"totalLines":335}},"sourceToolAssistantUUID":"b1c8fd13-e6dd-42be-9308-14bc01179399","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"feat/callisto-toml-roots-workspace","slug":"lexical-jingling-puppy"}
