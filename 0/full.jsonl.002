{"parentUuid":"e8a70ff4-e077-4da4-b10b-65ff14e1fc32","isSidechain":false,"promptId":"fbb155ba-b167-49bf-8715-f1b81bf02c2f","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MSGwRRBHFKp28dhkPcm7mi","type":"tool_result","content":"212\t#[test]\n213\tfn cascade_input_accepts_identity_field() {\n214\t    let graph = TwoPackageGraph { packages: vec![] };\n215\t    let groups = GroupTable::default();\n216\t    let cfg = CascadeConfig {\n217\t        mode: CascadeMode::OutOfRange,\n218\t        bump_severity: CascadeBumpSeverity::Patch,\n219\t        peer_escalation: true,\n220\t        preserve_npm_ranges: false,\n221\t    };\n222\t    let seed = BTreeMap::new();\n223\t    let reasons = BTreeMap::new();\n224\t    let named_by = BTreeMap::new();\n225\t    let base = BTreeMap::new();\n226\t    let identity = IdentityIndex::default();\n227\t\n228\t    let input = CascadeInput {\n229\t        graph: &graph,\n230\t        groups: &groups,\n231\t        cfg: &cfg,\n232\t        seed: &seed,\n233\t        reasons: &reasons,\n234\t        named_by: &named_by,\n235\t        base: &base,\n236\t        pre: None,\n237\t        tags: &TagIndex::empty(),\n238\t        identity: &identity,\n239\t    };\n240\t\n241\t    assert!(input.identity.native.is_empty());\n242\t}\n243\t\n244\tstruct TwoPackageGraph {\n245\t    packages: Vec<Package>,\n246\t}\n247\t\n248\timpl DependencyResolver for TwoPackageGraph {\n249\t    fn packages(&self) -> impl Iterator<Item = &Package> {\n250\t        self.packages.iter()\n251\t    }\n252\t\n253\t    fn dependencies_of(&self, _id: &PackageId) -> impl Iterator<Item = &DepEdge> {\n254\t        std::iter::empty()\n255\t    }\n256\t\n257\t    fn dependents_of(&self, _id: &PackageId) -> impl Iterator<Item = &DepEdge> {\n258\t        std::iter::empty()\n259\t    }\n260\t}\n261\t\n262\t/// In-memory graph that supports arbitrary edges for cascade tests.\n263\tstruct TestGraph {\n264\t    packages: Vec<Package>,\n265\t    edges: Vec<DepEdge>,\n266\t}\n267\t\n268\timpl DependencyResolver for TestGraph {\n269\t    fn packages(&self) -> impl Iterator<Item = &Package> {\n270\t        self.packages.iter()\n271\t    }\n272\t\n273\t    fn dependencies_of(&self, id: &PackageId) -> impl Iterator<Item = &DepEdge> {\n274\t        // Return edges where `from == id` (id depends on the target).\n275\t        self.edges.iter().filter(move |e| &e.from == id)\n276\t    }\n277\t\n278\t    fn dependents_of(&self, id: &PackageId) -> impl Iterator<Item = &DepEdge> {\n279\t        // Return edges where `to == id` (i.e. the caller depends on id).\n280\t        self.edges.iter().filter(move |e| &e.to == id)\n281\t    }\n282\t}\n283\t\n284\tfn make_dep_edge(from: &PackageId, to: &PackageId, spec_str: &str, ecosystem: callisto_model::Ecosystem) -> DepEdge {\n285\t    let spec = DepSpec::Range(\n286\t        callisto_model::VersionReq::parse(spec_str, ecosystem).unwrap(),\n287\t        spec_str.to_string(),\n288\t    );\n289\t    DepEdge {\n290\t        locator: Default::default(),\n291\t        from: from.clone(),\n292\t        to: to.clone(),\n293\t        name: to.name().to_string(),\n294\t        kind: DepKind::Runtime,\n295\t        spec,\n296\t        from_manifest: std::path::PathBuf::from(format!(\"{}/Cargo.toml\", from.name())),\n297\t        inherited: false,\n298\t    }\n299\t}\n300\t\n301\tfn bare_package(id: &PackageId) -> Package {\n302\t    Package {\n303\t        id: id.clone(),\n304\t        manifests: Vec::new(),\n305\t        changelog: None,\n306\t        release_trigger: ReleaseTrigger::Changeset,\n307\t        publish_to: Vec::new(),\n308\t        tag_template: None,\n309\t    }\n310\t}\n311\t"}]},"uuid":"95571458-afba-44d6-9af9-a5b823cb5e0d","timestamp":"2026-10-25T16:41:32.599Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/cascade/tests.rs","content":"#[test]\nfn cascade_input_accepts_identity_field() {\n    let graph = TwoPackageGraph { packages: vec![] };\n    let groups = GroupTable::default();\n    let cfg = CascadeConfig {\n        mode: CascadeMode::OutOfRange,\n        bump_severity: CascadeBumpSeverity::Patch,\n        peer_escalation: true,\n        preserve_npm_ranges: false,\n    };\n    let seed = BTreeMap::new();\n    let reasons = BTreeMap::new();\n    let named_by = BTreeMap::new();\n    let base = BTreeMap::new();\n    let identity = IdentityIndex::default();\n\n    let input = CascadeInput {\n        graph: &graph,\n        groups: &groups,\n        cfg: &cfg,\n        seed: &seed,\n        reasons: &reasons,\n        named_by: &named_by,\n        base: &base,\n        pre: None,\n        tags: &TagIndex::empty(),\n        identity: &identity,\n    };\n\n    assert!(input.identity.native.is_empty());\n}\n\nstruct TwoPackageGraph {\n    packages: Vec<Package>,\n}\n\nimpl DependencyResolver for TwoPackageGraph {\n    fn packages(&self) -> impl Iterator<Item = &Package> {\n        self.packages.iter()\n    }\n\n    fn dependencies_of(&self, _id: &PackageId) -> impl Iterator<Item = &DepEdge> {\n        std::iter::empty()\n    }\n\n    fn dependents_of(&self, _id: &PackageId) -> impl Iterator<Item = &DepEdge> {\n        std::iter::empty()\n    }\n}\n\n/// In-memory graph that supports arbitrary edges for cascade tests.\nstruct TestGraph {\n    packages: Vec<Package>,\n    edges: Vec<DepEdge>,\n}\n\nimpl DependencyResolver for TestGraph {\n    fn packages(&self) -> impl Iterator<Item = &Package> {\n        self.packages.iter()\n    }\n\n    fn dependencies_of(&self, id: &PackageId) -> impl Iterator<Item = &DepEdge> {\n        // Return edges where `from == id` (id depends on the target).\n        self.edges.iter().filter(move |e| &e.from == id)\n    }\n\n    fn dependents_of(&self, id: &PackageId) -> impl Iterator<Item = &DepEdge> {\n        // Return edges where `to == id` (i.e. the caller depends on id).\n        self.edges.iter().filter(move |e| &e.to == id)\n    }\n}\n\nfn make_dep_edge(from: &PackageId, to: &PackageId, spec_str: &str, ecosystem: callisto_model::Ecosystem) -> DepEdge {\n    let spec = DepSpec::Range(\n        callisto_model::VersionReq::parse(spec_str, ecosystem).unwrap(),\n        spec_str.to_string(),\n    );\n    DepEdge {\n        locator: Default::default(),\n        from: from.clone(),\n        to: to.clone(),\n        name: to.name().to_string(),\n        kind: DepKind::Runtime,\n        spec,\n        from_manifest: std::path::PathBuf::from(format!(\"{}/Cargo.toml\", from.name())),\n        inherited: false,\n    }\n}\n\nfn bare_package(id: &PackageId) -> Package {\n    Package {\n        id: id.clone(),\n        manifests: Vec::new(),\n        changelog: None,\n        release_trigger: ReleaseTrigger::Changeset,\n        publish_to: Vec::new(),\n        tag_template: None,\n    }\n}\n","numLines":100,"startLine":212,"totalLines":1975}},"sourceToolAssistantUUID":"e8a70ff4-e077-4da4-b10b-65ff14e1fc32","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"test/cascade-properties","slug":"lexical-jingling-puppy"}
