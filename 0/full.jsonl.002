{"parentUuid":"57a5b30d-e0fc-4ad6-88f4-f958c98de01a","isSidechain":false,"promptId":"fdaba07c-479e-42b3-b532-6f24a7e8d57d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013DsYnmvPZEaMKMeZh5dyRR","type":"tool_result","content":"The file /Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/docs/specs/versioning.json has been updated successfully."}]},"uuid":"b2f2ed31-010b-4abb-9e93-fe15dccfe5d8","timestamp":"2026-10-24T06:17:48.366Z","toolUseResult":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/docs/specs/versioning.json","oldString":"`workspace = true`, pnpm rolling `workspace:` shorthands and catalog specs are never rewritten by either rule;","newString":"A member's `workspace = true` entry, pnpm rolling `workspace:` shorthands and catalog specs are never rewritten in place by either rule (a Cargo `workspace = true` spec is rewritten in the root `[workspace.dependencies]`);","originalFile":null,"structuredPatch":[{"oldStart":110,"oldLines":7,"newStart":110,"newLines":7,"lines":["     },","     {","       \"id\": \"VER-CAS-06\",","-      \"criterion\": \"A spec that no longer covers the new version is rewritten to it, keeping the operator and precision for Cargo and npm (`^1.2` becomes `^2.0` for 2.0.0), or to the exact version for npm when `preserve-npm-ranges = false`. A runtime, optional, build or peer dependent that is itself released in this run, for any reason, has every such spec on a bumped internal dependency raised to the dependency's new version the same way, even when the spec still covers it (a covering spec that cannot be raised, such as a wildcard or a bare Python requirement, is left unchanged); a dependent that is not releasing keeps its spec unless out of range. `workspace = true`, pnpm rolling `workspace:` shorthands and catalog specs are never rewritten by either rule; an out-of-range pnpm explicit range is rewritten while retaining its `workspace:` protocol and alias. A dev dependent's spec is rewritten only when out of range. An npm range may carry a prerelease or build clause (`^2.0.0-next.0` becomes `^3.0.0`). A runtime, optional, build or peer spec that is out of range and cannot be rewritten mechanically, such as an npm range with spaces, `||`, a hyphen or a wildcard, or a Cargo range whose upper bound excludes the new version, fails the run with E319 before anything is written. A rewrite that would still exclude the new version, such as `<2.0.0` for 2.0.0, counts as one that cannot be rewritten. A dev spec that cannot be rewritten is left unchanged with a RangeNotRoundTrippable warning.\"","+      \"criterion\": \"A spec that no longer covers the new version is rewritten to it, keeping the operator and precision for Cargo and npm (`^1.2` becomes `^2.0` for 2.0.0), or to the exact version for npm when `preserve-npm-ranges = false`. A runtime, optional, build or peer dependent that is itself released in this run, for any reason, has every such spec on a bumped internal dependency raised to the dependency's new version the same way, even when the spec still covers it (a covering spec that cannot be raised, such as a wildcard or a bare Python requirement, is left unchanged); a dependent that is not releasing keeps its spec unless out of range. A member's `workspace = true` entry, pnpm rolling `workspace:` shorthands and catalog specs are never rewritten in place by either rule (a Cargo `workspace = true` spec is rewritten in the root `[workspace.dependencies]`); an out-of-range pnpm explicit range is rewritten while retaining its `workspace:` protocol and alias. A dev dependent's spec is rewritten only when out of range. An npm range may carry a prerelease or build clause (`^2.0.0-next.0` becomes `^3.0.0`). A runtime, optional, build or peer spec that is out of range and cannot be rewritten mechanically, such as an npm range with spaces, `||`, a hyphen or a wildcard, or a Cargo range whose upper bound excludes the new version, fails the run with E319 before anything is written. A rewrite that would still exclude the new version, such as `<2.0.0` for 2.0.0, counts as one that cannot be rewritten. A dev spec that cannot be rewritten is left unchanged with a RangeNotRoundTrippable warning.\"","     },","     {","       \"id\": \"VER-CAS-07\","]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"57a5b30d-e0fc-4ad6-88f4-f958c98de01a","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"docs/spec-drift","slug":"lexical-jingling-puppy"}
