{"parentUuid":"741160c4-7b41-4238-8a27-5ef00df2af49","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PreToolUse:Bash","toolUseID":"toolu_01PrVZpmfahKpBSBqWeFVW7d","hookEvent":"PreToolUse","content":"","stdout":"{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecisionReason\":\"RTK auto-rewrite\",\"updatedInput\":{\"command\":\"rtk grep -n \\\"coverage-per-crate\\\" -B3 -A22 justfile | head -50; sed -n 190,240p .github/workflows/callisto-ci.yml\",\"description\":\"Read coverage-per-crate recipe and the CI coverage/audit jobs\",\"dangerouslyDisableSandbox\":true}}}\n","stderr":"","exitCode":0,"command":"rtk hook claude","durationMs":13},"type":"attachment","uuid":"088f46a3-abce-4653-b242-2a215e10739e","timestamp":"2026-10-25T16:26:21.849Z","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"ci/gate-machete-semver","slug":"lexical-jingling-puppy"}
{"parentUuid":"741160c4-7b41-4238-8a27-5ef00df2af49","isSidechain":false,"promptId":"fbb155ba-b167-49bf-8715-f1b81bf02c2f","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PrVZpmfahKpBSBqWeFVW7d","type":"tool_result","content":"149-# count -- this catches that case. Requires profile data from a prior\n150-# `cargo llvm-cov` run in this session (e.g. `just coverage` just ran, or\n151-# CI's own coverage step ran first); does not re-run tests itself.\n152:coverage-per-crate threshold=\"90\":\n153-    #!/usr/bin/env bash\n154-    set -euo pipefail\n155-    cargo llvm-cov report --json --summary-only > /tmp/callisto-cov-summary.json\n156-    report=$(jq -r '\n157-        .data[0].files[]\n158-        | select(.filename | test(\"/crates/\"))\n159-        | {crate: (.filename | capture(\"/crates/(?<c>[^/]+)/\").c), count: .summary.lines.count, covered: .summary.lines.covered}\n160-        | [.crate, .count, .covered]\n161-        | @tsv\n162-      ' /tmp/callisto-cov-summary.json \\\n163-      | awk -F'\\t' -v threshold=\"{{threshold}}\" '\n164-          {sum[$1]+=$2; cov[$1]+=$3}\n165-          END {\n166-            for (c in sum) {\n167-              pct = (cov[c]/sum[c]*100)\n168-              status = (pct+0 < threshold+0) ? \"FAIL\" : \"pass\"\n169-              printf \"%s\\t%d\\t%d\\t%.2f\\t%s\\n\", c, sum[c], cov[c], pct, status\n170-            }\n171-          }\n172-        ' | sort)\n173-    echo \"$report\" | awk -F'\\t' '{printf \"%-25s lines=%-6s covered=%-6s cover=%6s%%  %s\\n\", $1, $2, $3, $4, $5}'\n174-    echo \"$report\" | grep -q FAIL && exit 1 || exit 0\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: taiki-e/install-action@1168f6810a3cb30a3514bf5756a3b7f0422c6df8 # v2\n        with:\n          tool: just@1.58.0\n      - uses: orin-dx/actions/setup-rust@2521888266780dabc7f5fd4c32b02d6ab82849db # v1.1\n        with:\n          components: llvm-tools-preview\n      - uses: taiki-e/install-action@1168f6810a3cb30a3514bf5756a3b7f0422c6df8 # v2\n        with:\n          tool: cargo-llvm-cov\n      - name: Install workflow linters\n        uses: $/.github/actions/install-workflow-linters\n      # Measures lines only: the Test Suite job installs the real-registry tools and runs those tests for real.\n      - run: just coverage 90\n        env:\n          CALLISTO_ALLOW_MISSING_TOOLS: \"1\"\n      # Non-blocking for now: the workspace-total gate above can pass while\n      # a small crate is far below threshold (a few large crates dominate\n      # the total line count). Visible in logs so regressions get noticed;\n      # promote to a required check once existing per-crate gaps are closed.\n      - run: just coverage-per-crate 90 || echo \"::warning::one or more crates below 90% line coverage (non-blocking, see job log above)\"\n\n  security:\n    name: Security & Advisory Audit (Moon & Just)\n    runs-on: ubuntu-latest\n    timeout-minutes: 45\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: taiki-e/install-action@1168f6810a3cb30a3514bf5756a3b7f0422c6df8 # v2\n        with:\n          tool: just@1.58.0\n      - uses: moonrepo/setup-toolchain@261c62cb5b0f580c7be7c8cd0f023a2e96756095 # v0\n      - uses: orin-dx/actions/setup-rust@2521888266780dabc7f5fd4c32b02d6ab82849db # v1.1\n      - uses: taiki-e/install-action@1168f6810a3cb30a3514bf5756a3b7f0422c6df8 # v2\n        with:\n          tool: cargo-deny\n      - run: just audit\n\n  validate:\n    name: Validate Changesets & Workspace Status\n    runs-on: ubuntu-latest\n    timeout-minutes: 45\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false","is_error":false}]},"uuid":"fd1341e0-e9a5-433c-8556-1d3efcca129c","timestamp":"2026-10-25T16:26:24.538Z","toolUseResu