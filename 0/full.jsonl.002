+        fn run_with_stdin(","+            &self,","+            program: &str,","+            args: &[&str],","+            cwd: &Path,","+            stdin: &[u8],","+        ) -> Result<callisto_model::CommandOutput, callisto_model::CommandError> {","+            RealGitRunner.run_with_stdin(program, args, cwd, stdin)","+        }","+    }","+","+    #[test]","+    fn an_unreachable_registry_costs_the_name_check_one_retry_and_does_not_stop_the_plan() {","+        let (dir, _) = fixture();","+        let runner = DeadRegistry {","+            lookups: std::sync::atomic::AtomicUsize::new(0),","+        };","+        let preview = plan_local_release(","+            dir.path(),","+            &crate::IgnoreWalkLocator::new(dir.path()),","+            &runner,","+            &[],","+            LocalReleaseSource::Preview,","+        )","+        .unwrap();","+        assert!(preview.is_some());","+        assert_eq!(runner.lookups.load(std::sync::atomic::Ordering::Relaxed), 2);","+    }","+","     fn fixture_id() -> ReleasePackageId {","         ReleasePackageId::new(Ecosystem::Cargo, \"release-fixture\").unwrap()","     }"]}],"userModified":false,"replaceAll":false,"staleRecovered":true,"contentNotInModelContext":true},"sourceToolAssistantUUID":"a9bf68c7-634a-46d4-8b55-50d9a10fd636","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"fix/advisory-check-patience","slug":"lexical-jingling-puppy"}
