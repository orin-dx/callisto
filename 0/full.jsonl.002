{"parentUuid":"c770f171-b1ef-4f3c-823d-1ecbc12c43e8","isSidechain":false,"promptId":"bd6ac0ce-389b-4193-aca8-c1bc4969277a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RdDjam5rfbkve7cZ65aMmK","type":"tool_result","content":"700\tfn rendered_simple_workflow_bytes_are_pinned() {\n701\t    let mut facts = cargo_only_facts();\n702\t    facts.ecosystems = BTreeSet::from([Ecosystem::Cargo, Ecosystem::Npm, Ecosystem::Pypi]);\n703\t    let workflow = render_workflow_0_8_0(&facts, \"trunk\");\n704\t    assert!(workflow.ends_with(\"\\n\") && !workflow.ends_with(\"\\n\\n\"), \"{workflow:?}\");\n705\t    insta::assert_snapshot!(workflow);\n706\t}\n707\t\n708\t#[test]\n709\tfn rendered_matrix_workflow_bytes_are_pinned() {\n710\t    let workflow = render_matrix_workflow();\n711\t    assert!(workflow.ends_with(\"\\n\") && !workflow.ends_with(\"\\n\\n\"), \"{workflow:?}\");\n712\t    insta::assert_snapshot!(workflow);\n713\t}\n714\t\n715\tfn lint_workflow(workflow: &str) {\n716\t    let dir = tempfile::tempdir().unwrap();\n717\t    let workflows_dir = dir.path().join(\".github/workflows\");\n718\t    std::fs::create_dir_all(&workflows_dir).unwrap();\n719\t    let path = workflows_dir.join(\"callisto-release.yml\");\n720\t    std::fs::write(&path, workflow).unwrap();\n721\t\n722\t    match std::process::Command::new(\"actionlint\").arg(&path).output() {\n723\t        Ok(output) => assert!(\n724\t            output.status.success(),\n725\t            \"actionlint:\\n{}{}\",\n726\t            String::from_utf8_lossy(&output.stdout),\n727\t            String::from_utf8_lossy(&output.stderr)\n728\t        ),\n729\t        Err(_) => eprintln!(\"actionlint not installed; skipping that check\"),\n730\t    }\n731\t    match std::process::Command::new(\"zizmor\")\n732\t        .args([\"--offline\", path.to_str().unwrap()])\n733\t        .output()\n734\t    {\n735\t        Ok(output) => assert!(\n736\t            output.status.success(),\n737\t            \"zizmor:\\n{}{}\",\n738\t            String::from_utf8_lossy(&output.stdout),\n739\t            String::from_utf8_lossy(&output.stderr)\n740\t        ),\n741\t        Err(_) => eprintln!(\"zizmor not installed; skipping that check\"),\n742\t    }\n743\t}\n744\t\n745\t/// oxc-react-codegen's shape: a cargo CLI shipping binaries, plus a napi addon with platform packages.\n746\tfn oxc_shaped_facts() -> InitFacts {\n747\t    let package = |id: &str, bins: &[&str]| InitPackage {\n748\t        id: id.to_owned(),\n749\t        version: Version::parse(\"0.1.0\", callisto_model::VersionGrammar::SemVer).unwrap(),\n750\t        bin_names: bins.iter().map(|bin| (*bin).to_owned()).collect(),\n751\t        cargo_bin_names: bins.iter().map(|bin| (*bin).to_owned()).collect(),\n752\t        unsupported_bin_ecosystems: Vec::new(),\n753\t        last_tag: None,\n754\t        publish_to: Vec::new(),"}]},"uuid":"8842f36d-0f45-47e6-89d0-51c12093d933","timestamp":"2026-10-24T21:45:00.582Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/init/tests.rs","content":"fn rendered_simple_workflow_bytes_are_pinned() {\n    let mut facts = cargo_only_facts();\n    facts.ecosystems = BTreeSet::from([Ecosystem::Cargo, Ecosystem::Npm, Ecosystem::Pypi]);\n    let workflow = render_workflow_0_8_0(&facts, \"trunk\");\n    assert!(workflow.ends_with(\"\\n\") && !workflow.ends_with(\"\\n\\n\"), \"{workflow:?}\");\n    insta::assert_snapshot!(workflow);\n}\n\n#[test]\nfn rendered_matrix_workflow_bytes_are_pinned() {\n    let workflow = render_matrix_workflow();\n    assert!(workflow.ends_with(\"\\n\") && !workflow.ends_with(\"\\n\\n\"), \"{workflow:?}\");\n    insta::assert_snapshot!(workflow);\n}\n\nfn lint_workflow(workflow: &str) {\n    let dir = tempfile::tempdir().unwrap();\n    let workflows_dir = dir.path().join(\".github/workflows\");\n    std::fs::create_dir_all(&workflows_dir).unwrap();\n    let path = workflows_dir.join(\"callisto-release.yml\");\n    std::fs::write(&path, workflow).unwrap();\n\n    match std::process::Command::new(\"actionlint\").arg(&path).output() {\n        Ok(output) => assert!(\n            output.status.success(),\n            \"actionlint:\\n{}{}\",\n            String::from_utf8_lossy(&output.stdout),\n            String::from_utf8_lossy(&output.stderr)\n        ),\n        Err(_) => eprintln!(\"actionlint not installed; skipping that check\"),\n    }\n    match std::process::Command::new(\"zizmor\")\n        .args([\"--offline\", path.to_str().unwrap()])\n        .output()\n    {\n        Ok(output) => assert!(\n            output.status.success(),\n            \"zizmor:\\n{}{}\",\n            String::from_utf8_lossy(&output.stdout),\n            String::from_utf8_lossy(&output.stderr)\n        ),\n        Err(_) => eprintln!(\"zizmor not installed; skipping that check\"),\n    }\n}\n\n/// oxc-react-codegen's shape: a cargo CLI shipping binaries, plus a napi addon with platform packages.\nfn oxc_shaped_facts() -> InitFacts {\n    let package = |id: &str, bins: &[&str]| InitPackage {\n        id: id.to_owned(),\n        version: Version::parse(\"0.1.0\", callisto_model::VersionGrammar::SemVer).unwrap(),\n        bin_names: bins.iter().map(|bin| (*bin).to_owned()).collect(),\n        cargo_bin_names: bins.iter().map(|bin| (*bin).to_owned()).collect(),\n        unsupported_bin_ecosystems: Vec::new(),\n        last_tag: None,\n        publish_to: Vec::new(),","numLines":55,"startLine":700,"totalLines":1375}},"sourceToolAssistantUUID":"c770f171-b1ef-4f3c-823d-1ecbc12c43e8","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"ci/hardening-cheap","slug":"lexical-jingling-puppy"}
