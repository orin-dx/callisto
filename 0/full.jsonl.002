s(&rig, root);\n102-\n103-    let run = rig.run(root, &[\"--format\", \"json\", \"release\"]);\n104-    assert!(run.status.success(), \"{}\\n{}\", stderr(&run), rig.effects());\n105-    let effects = rig.effects();\n106-    for effect in [\"cargo publish\", \"git push\", \"gh release create\"] {\n107-        assert_eq!(effects.matches(effect).count(), 1, \"`{effect}` once:\\n{effects}\");","is_error":false}]},"uuid":"487744f0-c8fb-42a9-9212-489132a33eab","timestamp":"2026-10-24T21:53:13.309Z","toolUseResult":{"stdout":"610:/// Runs bare `callisto release` (local route) against the fake publishers.\n783:        subcommand: &[\"ls-remote\"],\n1199:/// records the pushed tag exactly as `ls-remote` would report it (the tag\n1200:/// object plus its peeled commit, the captured `ls-remote` line shape), and\n1201:/// `ls-remote` answers from that record. Real git is used instead wherever the\n1202:/// rig points at a real bare remote. `push` and `ls-remote` take no flags.\n1221:if [ \"$1\" = ls-remote ]; then\n1373:    /// `git push`/`ls-remote` are real git against a bare `file://` remote that replaces `remote_url` in their arguments.\n1374:    pub fn real_git_push(&mut self, bare: &Path, remote_url: &str) -> &mut Self {\n1376:            .set(\"CALLISTO_TEST_BARE_REMOTE\", &format!(\"file://{}\", bare.display()))\n1406:pub fn bare_remote(dir: &Path) -> PathBuf {\n1407:    let bare = dir.join(\"remote.git\");\n82:fn on_branch() -> (tempfile::TempDir, String) {\n83-    let (dir, release_commit) = release_commit_fixture();\n84-    git(dir.path(), &[\"checkout\", \"-q\", \"main\"]);\n85-    (dir, release_commit)\n86-}\n87-\n88-fn stderr(output: &std::process::Output) -> String {\n89-    String::from_utf8_lossy(&output.stderr).into_owned()\n90-}\n91-\n92-#[test]\n93-fn release_on_a_branch_publishes_tags_and_releases_then_has_nothing_left() {\n94-    let (dir, release_commit) = on_branch();\n95-    let root = dir.path();\n96-    let rig = Rig::new(&release_commit);\n97-\n98-  