ase_commit);\n    assert_eq!(\n        rig.effects().matches(\"cargo publish\").count(),\n        0,\n        \"adopted, not published again\"\n    );\n591:        .env(\"CALLISTO_TEST_CARGO_MARKER\", registry_marker(root))\n632:        .env(\"CALLISTO_TEST_CARGO_MARKER\", registry_marker(root))\n674:        .env(\"CALLISTO_TEST_CARGO_MARKER\", registry_marker(source))\n719:        .env(\"CALLISTO_TEST_CARGO_MARKER\", registry_marker(root))\n895:/// `$CALLISTO_TEST_CARGO_MARKER.<crate>`; `info` answers from exactly that\n904:/// `$CALLISTO_TEST_CARGO_MARKER`'s directory also holds the two knobs the\n937:state=$(dirname \"$CALLISTO_TEST_CARGO_MARKER\")\n958:  published=$(cat \"$CALLISTO_TEST_CARGO_MARKER.$crate\" 2>/dev/null)\n998:printf '%s\\n' \"$version\" > \"$CALLISTO_TEST_CARGO_MARKER.$name\"\n1487:        .env(\"CALLISTO_TEST_CARGO_MARKER\", registry_marker(root))","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"classifierBoundary":true,"serverClassifierContext":{"request":"e5280c8d-848a-43f9-a456-c26c62e3ec93","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","root":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","branch":"fix/taken-name-first-release","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":7,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callisto","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","platform":"macos"}},"sourceToolAssistantUUID":"0d781ee6-bd55-4b6b-9809-2c10a8111f98","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"15c732d1-457b-4