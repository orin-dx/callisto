be parsed. |","-| E165 | Release commit verification failed | The committed release decision, changelog, or manifest diff does not match what this commit claims to release. Reconcile the commit's contents with its release decision instead of regenerating the intent. |","+| E165 | Release commit verification failed | The committed release decision, changelog, or manifest diff does not match what this commit claims to release, or the commit changes a path a version commit may not (anything but manifests, lockfiles, changelogs, changesets and the decision file). Reconcile the commit's contents with its release decision instead of regenerating the intent, and move other edits to a separate commit. |"," | E166 | Cannot decode the committed release decision file | Restore the committed release-decision file from a known-good commit; it was not treated as authorizing a release. |"," | E167 | Remote release state (tag, forge release, registry, or artifact) conflicts with this release intent | Either remote state differs from this release intent, or an effect this run made was not visible within a minute. Re-run to adopt a completed effect; if the conflict remains, reconcile the remote state by hand -- this intent's authorization is not in question. |"," | E168 | Release feature/combination is not implemented | This combination is not implemented for release; adjust the release configuration to use a supported combination. |"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"7c2f0327-6571-4846-92fe-a53eda077f6b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/release-commit-allowlist","slug":"lexical-jingling-puppy"}
