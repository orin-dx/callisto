rsionGrammar::SemVer).unwrap());\n    assert_eq!(read(declared).unwrap(), expected);\n    assert_eq!(read(&format!(\"\\u{feff}{declared}\")).unwrap(), expected);\n    assert_eq!(read(\"[workspace]\\nmembers = []\\n\").unwrap(), None);\n\n    let malformed = read(\"[workspace.package\\nversion = \\\"1.0.0\\\"\\n\").unwrap_err();\n    assert!(\n        matches!(&malformed, ManifestError::Parse { format: ManifestFormat::CargoToml, .. }),\n        \"{malformed:?}\"\n    );\n    let not_semver = read(\"[workspace.package]\\nversion = \\\"one\\\"\\n\").unwrap_err();\n    assert!(\n        matches!(&not_semver, ManifestError::Parse { message, .. } if message.contains(\"invalid [workspace.package] version\")),\n        \"{not_semver:?}\"\n    );\n}\n\n/// Regression lock for F25: `CargoToml` no longer overrides"}},"serverClassifierRequest":"8bf23458-9a78-4ad0-a724-579a7500a0d3","apiBlockIndex":2,"requestId":"req_011CgPGkT5XRdaQttkjB687i","requestRef":"b6061e6a-dfd0-4db5-95d2-b91803de614c","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"154f80fb-8ac9-4f5f-8961-797ea71fa6c0","timestamp":"2026-10-25T16:29:40.709Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"ci/gate-machete-semver","slug":"lexical-jingling-puppy"}
