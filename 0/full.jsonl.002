{"parentUuid":"0bda7a31-64f5-47e3-9163-0deba44f558b","isSidechain":false,"promptId":"a1fe58f8-dc01-43a8-a00c-e2f78060ffdd","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DeWAocyoJnftSiaAop5quJ","type":"tool_result","content":"56\t/// Exact stdout when no package has an unreleased version.\n57\tpub const NOTHING_TO_RELEASE: &str = \"Nothing to release.\";\n58\t\n59\tfn release(\n60\t    packages: &[String],\n61\t    receipt: Option<std::path::PathBuf>,\n62\t    global: &GlobalArgs,\n63\t) -> Result<ExitCode, CliError> {\n64\t    let selections = parse_selections(packages)?;\n65\t    let runner = CliCommandRunner;\n66\t    let workspace = load_workspace(global, &runner)?;\n67\t    let root = workspace.root.clone();\n68\t    let locator = IgnoreWalkLocator::new(&root);\n69\t    // Best effort: a tag that never reached `origin` is a release that did not finish, whatever the plan says next.\n70\t    for tag in tags_missing_from_origin(&root, &locator, &runner).unwrap_or_default() {\n71\t        eprintln!(\"{}\", tag_missing_from_origin_note(&tag));\n72\t    }\n73\t    if global.dry_run {\n74\t        let plan = plan_local_release(&root, &locator, &runner, &selections, LocalReleaseSource::Preview)?;\n75\t        write_release_preview(plan.as_ref(), global.format, &mut std::io::stdout())?;\n76\t        return Ok(ExitCode::SUCCESS);\n77\t    }\n78\t    if let Some(route) = ci_release_route(&workspace)? {\n79\t        return Err(CliError::ReleaseRequiresCiRoute {\n80\t            reason: route.to_string(),\n81\t        });\n82\t    }\n83\t    let Some(plan) = plan_local_release(&root, &locator, &runner, &selections, LocalReleaseSource::Trusted)? else {\n84\t        print_nothing_to_release(global)?;\n85\t        return Ok(ExitCode::SUCCESS);\n86\t    };\n87\t    for diagnostic in &plan.diagnostics {\n88\t        eprintln!(\"warning: {}\", diagnostic.message);\n89\t    }\n90\t    let intent = plan.intent;\n91\t    let permit = ApplyPermit::granted_unless_dry_run(global.dry_run).expect(\"non-dry-run permits writes\");\n92\t    // A receipt records only full success; a partial run is recovered by rerunning.\n93\t    if let Some(path) = &receipt {\n94\t        callisto_model::atomic::probe_atomic_write(path, &permit).map_err(|source| CliError::Io {\n95\t            source,\n96\t            path: Some(path.clone()),\n97\t        })?;\n98\t    }\n99\t    let callisto_model::SourceIdentity::GitCommit { sha } = &intent.snapshot.source else {\n100\t        return Err(CliError::ReleaseEnvelopeInvalid {\n101\t            detail: \"a local release source must be a Git commit\".to_owned(),\n102\t        });\n103\t    };\n104\t    // A local run is its own orchestration, so both revisions are the source commit.\n105\t    let envelope =\n106\t        ReleaseRunEnvelopeV1::new(sha.clone(), &intent, None).map_err(|error| CliError::ReleaseEnvelopeInvalid {\n107\t            detail: error.to_string(),\n108\t        })?;\n109\t    let capability = validate_local_release_intent(&root, &locator, &runner, intent)?;\n110\t    let state = execute_release(&capability, &permit, &envelope, None)?;\n111\t    let receipt_document =\n112\t        ReleaseReceiptV1::from_state(capability.intent(), &state).map_err(|error| CliError::ReleaseReceiptIssue {\n113\t            detail: error.to_string(),\n114\t        })?;\n115\t    if let Some(path) = &receipt {\n116\t        write_receipt(path, &receipt_document, &permit)?;\n117\t    }\n118\t    match global.format {\n119\t        OutputFormat::Json => emit_report(\n120\t            &mut std::io::stdout(),\n121\t            &ReleaseReport {\n122\t                receipt: receipt_document.clone(),\n123\t            },\n124\t            global.dry_run,\n125\t        )?,"}]},"uuid":"0ff3156b-1e64-4331-b439-ff06d8c78ef7","timestamp":"2026-10-25T00:26:20.360Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-cli/src/commands/release.rs","content":"/// Exact stdout when no package has an unreleased version.\npub const NOTHING_TO_RELEASE: &str = \"Nothing to release.\";\n\nfn release(\n    packages: &[String],\n    receipt: Option<std::path::PathBuf>,\n    global: &GlobalArgs,\n) -> Result<ExitCode, CliError> {\n    let selections = parse_selections(packages)?;\n    let runner = CliCommandRunner;\n    let workspace = load_workspace(global, &runner)?;\n    let root = workspace.root.clone();\n    let locator = IgnoreWalkLocator::new(&root);\n    // Best effort: a tag that never reached `origin` is a release that did not finish, whatever the plan says next.\n    for tag in tags_missing_from_origin(&root, &locator, &runner).unwrap_or_default() {\n        eprintln!(\"{}\", tag_missing_from_origin_note(&tag));\n    }\n    if global.dry_run {\n        let plan = plan_local_release(&root, &locator, &runner, &selections, LocalReleaseSource::Preview)?;\n        write_release_preview(plan.as_ref(), global.format, &mut std::io::stdout())?;\n        return Ok(ExitCode::SUCCESS);\n    }\n    if let Some(route) = ci_release_route(&workspace)? {\n        return Err(CliError::ReleaseRequiresCiRoute {\n            reason: route.to_string(),\n        });\n    }\n    let Some(plan) = plan_local_release(&root, &locator, &runner, &selections, LocalReleaseSource::Trusted)? else {\n        print_nothing_to_release(global)?;\n        return Ok(ExitCode::SUCCESS);\n    };\n    for diagnostic in &plan.diagnostics {\n        eprintln!(\"warning: {}\", diagnostic.message);\n    }\n    let intent = plan.intent;\n    let permit = ApplyPermit::granted_unless_dry_run(global.dry_run).expect(\"non-dry-run permits writes\");\n    // A receipt records only full success; a partial run is recovered by rerunning.\n    if let Some(path) = &receipt {\n        callisto_model::atomic::probe_atomic_write(path, &permit).map_err(|source| CliError::Io {\n            source,\n            path: Some(path.clone()),\n        })?;\n    }\n    let callisto_model::SourceIdentity::GitCommit { sha } = &intent.snapshot.source else {\n        return Err(CliError::ReleaseEnvelopeInvalid {\n            detail: \"a local release source must be a Git commit\".to_owned(),\n        });\n    };\n    // A local run is its own orchestration, so both revisions are the source commit.\n    let envelope =\n        ReleaseRunEnvelopeV1::new(sha.clone(), &intent, None).map_err(|error| CliError::ReleaseEnvelopeInvalid {\n            detail: error.to_string(),\n        })?;\n    let capability = validate_local_release_intent(&root, &locator, &runner, intent)?;\n    let state = execute_release(&capability, &permit, &envelope, None)?;\n    let receipt_document =\n        ReleaseReceiptV1::from_state(capability.intent(), &state).map_err(|error| CliError::ReleaseReceiptIssue {\n            detail: error.to_string(),\n        })?;\n    if let Some(path) = &receipt {\n        write_receipt(path, &receipt_document, &permit)?;\n    }\n    match global.format {\n        OutputFormat::Json => emit_report(\n            &mut std::io::stdout(),\n            &ReleaseReport {\n                receipt: receipt_document.clone(),\n            },\n            global.dry_run,\n        )?,","numLines":70,"startLine":56,"totalLines":850}},"sourceToolAssistantUUID":"0bda7a31-64f5-47e3-9163-0deba44f558b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"perf/measure","slug":"lexical-jingling-puppy"}
