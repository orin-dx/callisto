{"parentUuid":"78d8b2e3-63a2-4dd7-8f4e-f22789da21b3","isSidechain":false,"promptId":"81e97b21-5b87-4de1-93b0-c0727fa54480","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LWp7zgX2ZQMo6QsfjkLoJ8","type":"tool_result","content":"      \"id\": \"REL-PUB-14\",\n      \"criterion\": \"When a Cargo or npm registry publish is adopted because the exact version is already published, and the registry entry names a repository whose host, owner and name differ from the `origin` remote's (compared case-insensitively, ignoring `.git`, `git+` and URL form), Callisto prints a warning on stderr naming both repositories. The run still adopts the version. No warning is printed when the registry names no repository, when either value cannot be read as a repository, or when they match. PyPI is not checked.\"\n    },","is_error":false}]},"uuid":"4c258d7b-5808-47a7-87da-1e812bcb3bf2","timestamp":"2026-10-24T19:00:19.985Z","toolUseResult":{"stdout":"      \"id\": \"REL-PUB-14\",\n      \"criterion\": \"When a Cargo or npm registry publish is adopted because the exact version is already published, and the registry entry names a repository whose host, owner and name differ from the `origin` remote's (compared case-insensitively, ignoring `.git`, `git+` and URL form), Callisto prints a warning on stderr naming both repositories. The run still adopts the version. No warning is printed when the registry names no repository, when either value cannot be read as a repository, or when they match. PyPI is not checked.\"\n    },","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"fa31dea5-63cb-4cfb-8ac2-f248aae7686f","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","root":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","branch":"fix/taken-name-first-release","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":7,"untracked":null,"untrac