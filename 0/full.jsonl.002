edOperation {\n                format: ManifestFormat::CargoToml,\n                ..\n            }\n        ),\n        \"{error:?}\"\n    );\n}\n\n#[test]\nfn a_workspace_version_is_read_with_or_without_a_byte_order_mark_and_bad_input_is_an_error() {\n    let path = std::path::Path::new(\"Cargo.toml\");\n    let read = |source: &str| workspace_version_from_source(source, path);\n\n    let declared = \"[workspace.package]\\nversion = \\\"2.3.4\\\"\\n\";\n    let expected = Some(Version::parse(\"2.3.4\", VersionGrammar::SemVer).unwrap());\n    assert_eq!(read(declared).unwrap(), expected);\n    assert_eq!(read(&format!(\"\\u{feff}{declared}\")).unwrap(), expected);\n    assert_eq!(read(\"[workspace]\\nmembers = []\\n\").unwrap(), None);\n\n    let malformed = read(\"[workspace.package\\nversion = \\\"1.0.0\\\"\\n\").unwrap_err();\n    assert!(\n        matches!(&malformed, ManifestError::Parse { format: ManifestFormat::CargoToml, .. }),\n        \"{malformed:?}\"\n    );\n    let not_semver = read(\"[workspace.package]\\nversion = \\\"one\\\"\\n\").unwrap_err();\n    assert!(\n        matches!(&not_semver, ManifestError::Parse { message, .. } if message.contains(\"invalid [workspace.package] version\")),\n        \"{not_semver:?}\"\n    );\n}\n\n/// Regression lock for F25: `CargoToml` no longer overrides","originalFile":null,"structuredPatch":[{"oldStart":599,"oldLines":6,"newStart":599,"newLines":68,"lines":["     assert!(!manifest.is_publishable());"," }"," ","+#[test]","+fn publish_field_decides_whether_a_crate_is_publishable() {","+    let dir = tempdir().unwrap();","+    for (publish, expected) in [","+        (\"\", true),","+        (\"publish = true\\n\", true),","+        (\"publish = false\\n\", false),","+        (\"publish = []\\n\", false),","+        (\"publish = [\\\"my-registry\\\"]\\n\", true),","+    ] {","+        let manifest = open_cargo(","+            dir.path(),","+            &format!(\"[package]\\nname = \\\"c\\\"\\nversion = \\\"0.1.0\\\"\\n{publish}\"),","+        );","+        assert_eq!(manifest.is_publishable(), expected, \"{publish:?}\");","+    }","+    // A manifest with no `[package]` table (a virtual workspace root) publishes nothing.","+    assert!(!open_cargo(dir.path(), \"[workspace]\\nmembers = []\\n\").is_publishable());","+}","+","+#[test]","+fn optional_dependencies_are_not_a_cargo_concept_and_refuse_to_be_updated() {","+    let dir = tempdir().unwrap();","+    let mut manifest = open_cargo(dir.path(), \"[package]\\nname = \\\"c\\\"\\nversion = \\\"0.1.0\\\"\\n\");","+    let error = manifest","+        .update_optional_dependencies(&[(\"x\".to_owned(), Version::parse(\"1.0.0\", VersionGrammar::SemVer).unwrap())], &permit())","+        .unwrap_err();","+    assert!(","+        matches!(","+            error,","+            ManifestError::UnsupportedOperation {","+                format: ManifestFormat::CargoToml,","+                ..","+            }","+        ),","+        \"{error:?}\"","+    );","+}","+","+#[test]","+fn a_workspace_version_is_read_with_or_without_a_byte_order_mark_and_bad_input_is_an_error() {","+    let path = std::path::Path::new(\"Cargo.toml\");","+    let read = |source: &str| workspace_version_from_source(source, path);","+","+    let declared = \"[workspace.package]\\nversion = \\\"2.3.4\\\"\\n\";","+    let expected = Some(Version::parse(\"2.3.4\", VersionGrammar::SemVer).unwrap());","+    assert_eq!(read(declared).unwrap(), expected);","+    assert_eq!(read(&format!(\"\\u{feff}{declared}\")).unwrap(), expected);","+    assert_eq!(read(\"[workspace]\\nmembers = []\\n\").unwrap(), None);","+","+    let malformed = read(\"[workspace.package\\nversion = \\\"1.0.0\\\"\\n\").unwrap_err();","+    assert!(","+        matches!(&malformed, ManifestError::Parse { format: ManifestFormat::CargoToml, .. }),","+        \"{malformed:?}\"","+    );","+    let not_semver = read(\"[workspace.package]\\nversion = \\\"one\\\"\\n\").unwrap_err();","+    assert!(","+        matches!(&not_semver, ManifestError::Parse { message, .. } if message.contains(\"invalid [workspace.package] version\")),","+        \"{not_semver:?}\"","+    );","+}","+"," /// Regression lock for F25: `CargoToml` no longer overrides"," /// `publish_targets()` -- it falls through to the `Manifest` trait's"," /// default impl, which dispatches on `ecosystem()` (`Ecosystem::Cargo`"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"154f80fb-8ac9-4f5f-8961-797ea71fa6c0","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"ci/gate-machete-semver","slug":"lexical-jingling-puppy"}
