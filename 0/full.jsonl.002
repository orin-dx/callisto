ote(secrets: &[&str]) -> String {","+    let secrets = if secrets.is_empty() {","+        String::new()","+    } else {","+        format!(","+            \"\\n  1. Add the repository secrets {} (GitHub → Settings → Secrets and variables → Actions).\",","+            secrets.join(\", \")","+        )","+    };","+    format!(","+        \"\\nNext steps:{secrets}\\n  - Describe a change with `callisto add`, then commit.\\n  - Preview the first release with `callisto release --dry-run`.\\n  - A new package's first publish needs a token that can create it: see {FIRST_PUBLISH_URL}.\"","+    )","+}","+/// Where the registry-by-registry first-publish guidance lives.","+const FIRST_PUBLISH_URL: &str = \"https://github.com/orin-dx/callisto/blob/main/docs/publishing.md#first-publish\";"," const VERSIONING_CHOICES: [&str; 2] = [","     \"independent: each package has its own version\",","     \"fixed: every package shares one version\","]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"07117003-9ced-4eb5-9e0e-934db9d11ba4","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"feat/init-defaults","slug":"lexical-jingling-puppy"}
