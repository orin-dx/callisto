n `kind` is `changeset`, `inference`, `fixedGroup` or `linkedGroup` (with `groupId`), `cascade` (with `from`, the source package, and `edgeKind`: `Runtime`, `Optional`, `Build` or `Peer`, or lowercase `peer` for peer escalation) or `preReleasePolicy` (with `policyId`, the prerelease tag).\"","     },","     {","       \"id\": \"VER-APPLY-11\","]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"01dae933-3996-4a5f-a2ca-25dbc57e67c2","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"docs/spec-drift","slug":"lexical-jingling-puppy"}
