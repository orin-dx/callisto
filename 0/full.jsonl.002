{"parentUuid":"1dc41bb1-37d3-41ed-ba26-82a2b847a791","isSidechain":false,"promptId":"bd6ac0ce-389b-4193-aca8-c1bc4969277a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019DYtjFNSxs1ygVmhiu7THc","type":"tool_result","content":"112\t\n113\t/// A pnpm workspace where `app` takes `lib` through a `catalog:` entry.\n114\tfn pnpm_catalog_workspace() -> tempfile::TempDir {\n115\t    let dir = tempfile::tempdir().unwrap();\n116\t    let root = dir.path();\n117\t    callisto_fixtures::git::init_repo(root);\n118\t    fs::write(\n119\t        root.join(\"package.json\"),\n120\t        \"{\\n  \\\"name\\\": \\\"root\\\",\\n  \\\"private\\\": true\\n}\\n\",\n121\t    )\n122\t    .unwrap();\n123\t    fs::write(\n124\t        root.join(\"pnpm-workspace.yaml\"),\n125\t        \"packages:\\n  - packages/*\\ncatalog:\\n  lib: ^0.1.0\\n\",\n126\t    )\n127\t    .unwrap();\n128\t    for (name, deps) in [\n129\t        (\"lib\", String::new()),\n130\t        (\n131\t            \"app\",\n132\t            \",\\n  \\\"dependencies\\\": {\\n    \\\"lib\\\": \\\"catalog:\\\"\\n  }\".to_owned(),\n133\t        ),\n134\t    ] {\n135\t        fs::create_dir_all(root.join(format!(\"packages/{name}\"))).unwrap();\n136\t        fs::write(\n137\t            root.join(format!(\"packages/{name}/package.json\")),\n138\t            format!(\"{{\\n  \\\"name\\\": \\\"{name}\\\",\\n  \\\"version\\\": \\\"0.1.0\\\"{deps}\\n}}\\n\"),\n139\t        )\n140\t        .unwrap();\n141\t    }\n142\t    git(root, &[\"add\", \".\"]);\n143\t    git(root, &[\"commit\", \"-q\", \"-m\", \"workspace\"]);\n144\t    let init = callisto(root, &[\"init\", \"--yes\", \"--versioning\", \"independent\", \"--no-workflow\"]);\n145\t    assert!(init.status.success(), \"{}\", String::from_utf8_lossy(&init.stderr));\n146\t    git(root, &[\"add\", \".\"]);\n147\t    git(root, &[\"commit\", \"-q\", \"-m\", \"configure callisto\"]);\n148\t    dir\n149\t}\n150\t\n151\t#[test]\n152\tfn a_catalog_dependency_is_reported_not_rewritten_and_does_not_cascade() {\n153\t    let dir = pnpm_catalog_workspace();\n154\t    let root = dir.path();\n155\t    add_changeset(root, \"npm/lib\", \"minor\");\n156\t    let out = callisto(root, &[\"version\", \"--dry-run\"]);\n157\t    assert!(out.status.success(), \"{}\", String::from_utf8_lossy(&out.stderr));\n158\t    let plan: serde_json::Value = serde_json::from_slice(&out.stdout).unwrap();\n159\t    let diagnostics = plan[\"diagnostics\"].as_array().expect(\"a catalog spec must be reported\");\n160\t    let catalog = diagnostics\n161\t        .iter()\n162\t        .find(|d| d[\"code\"] == \"catalog-spec-not-rewritten\")\n163\t        .unwrap_or_else(|| panic!(\"missing catalog diagnostic: {diagnostics:?}\"));\n164\t    assert_eq!(catalog[\"package\"], \"npm/app\");\n165\t    assert_eq!(catalog[\"path\"], \"packages/app/package.json\");\n166\t    let bumped: Vec<&str> = plan[\"bumps\"]\n167\t        .as_array()\n168\t        .unwrap()\n169\t        .iter()\n170\t        .map(|bump| bump[\"package\"].as_str().unwrap())\n171\t        .collect();\n172\t    assert_eq!(\n173\t        bumped,\n174\t        [\"npm/lib\"],\n175\t        \"a spec that cannot be tested must not cascade a release\"\n176\t    );\n177\t    assert!(read(root, \"packages/app/package.json\").contains(\"\\\"lib\\\": \\\"catalog:\\\"\"));\n178\t}\n179\t\n180\t#[test]\n181\tfn every_cargo_dependency_table_is_rewritten_without_disturbing_the_rest_of_the_file() {"}]},"uuid":"24381469-1754-42a8-a9a9-ac2752f43864","timestamp":"2026-10-24T22:05:50.625Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-cli/tests/cascade_scenarios_tests.rs","content":"\n/// A pnpm workspace where `app` takes `lib` through a `catalog:` entry.\nfn pnpm_catalog_workspace() -> tempfile::TempDir {\n    let dir = tempfile::tempdir().unwrap();\n    let root = dir.path();\n    callisto_fixtures::git::init_repo(root);\n    fs::write(\n        root.join(\"package.json\"),\n        \"{\\n  \\\"name\\\": \\\"root\\\",\\n  \\\"private\\\": true\\n}\\n\",\n    )\n    .unwrap();\n    fs::write(\n        root.join(\"pnpm-workspace.yaml\"),\n        \"packages:\\n  - packages/*\\ncatalog:\\n  lib: ^0.1.0\\n\",\n    )\n    .unwrap();\n    for (name, deps) in [\n        (\"lib\", String::new()),\n        (\n            \"app\",\n            \",\\n  \\\"dependencies\\\": {\\n    \\\"lib\\\": \\\"catalog:\\\"\\n  }\".to_owned(),\n        ),\n    ] {\n        fs::create_dir_all(root.join(format!(\"packages/{name}\"))).unwrap();\n        fs::write(\n            root.join(format!(\"packages/{name}/package.json\")),\n            format!(\"{{\\n  \\\"name\\\": \\\"{name}\\\",\\n  \\\"version\\\": \\\"0.1.0\\\"{deps}\\n}}\\n\"),\n        )\n        .unwrap();\n    }\n    git(root, &[\"add\", \".\"]);\n    git(root, &[\"commit\", \"-q\", \"-m\", \"workspace\"]);\n    let init = callisto(root, &[\"init\", \"--yes\", \"--versioning\", \"independent\", \"--no-workflow\"]);\n    assert!(init.status.success(), \"{}\", String::from_utf8_lossy(&init.stderr));\n    git(root, &[\"add\", \".\"]);\n    git(root, &[\"commit\", \"-q\", \"-m\", \"configure callisto\"]);\n    dir\n}\n\n#[test]\nfn a_catalog_dependency_is_reported_not_rewritten_and_does_not_cascade() {\n    let dir = pnpm_catalog_workspace();\n    let root = dir.path();\n    add_changeset(root, \"npm/lib\", \"minor\");\n    let out = callisto(root, &[\"version\", \"--dry-run\"]);\n    assert!(out.status.success(), \"{}\", String::from_utf8_lossy(&out.stderr));\n    let plan: serde_json::Value = serde_json::from_slice(&out.stdout).unwrap();\n    let diagnostics = plan[\"diagnostics\"].as_array().expect(\"a catalog spec must be reported\");\n    let catalog = diagnostics\n        .iter()\n        .find(|d| d[\"code\"] == \"catalog-spec-not-rewritten\")\n        .unwrap_or_else(|| panic!(\"missing catalog diagnostic: {diagnostics:?}\"));\n    assert_eq!(catalog[\"package\"], \"npm/app\");\n    assert_eq!(catalog[\"path\"], \"packages/app/package.json\");\n    let bumped: Vec<&str> = plan[\"bumps\"]\n        .as_array()\n        .unwrap()\n        .iter()\n        .map(|bump| bump[\"package\"].as_str().unwrap())\n        .collect();\n    assert_eq!(\n        bumped,\n        [\"npm/lib\"],\n        \"a spec that cannot be tested must not cascade a release\"\n    );\n    assert!(read(root, \"packages/app/package.json\").contains(\"\\\"lib\\\": \\\"catalog:\\\"\"));\n}\n\n#[test]\nfn every_cargo_dependency_table_is_rewritten_without_disturbing_the_rest_of_the_file() {","numLines":70,"startLine":112,"totalLines":319}},"sourceToolAssistantUUID":"1dc41bb1-37d3-41ed-ba26-82a2b847a791","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"fix/npm-space-ranges","slug":"lexical-jingling-puppy"}
