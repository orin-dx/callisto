{"type":"api-request-blob","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","hash":"a071fa65a064299b5d619e5d17e4e5e1b60b1a6d0f391b60354adf14d277059e","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01F1VvCGDabYuet2xvXFDvzL","name":"Edit","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release/provider/registry.rs","old_string":"/// The production adapter set, keyed by ecosystem.","new_str":"/// The repository the registry records for a published version of this package, if it records one and can be read.\npub(crate) fn recorded_repository(\n    context: &ProviderContext<'_>,\n    ecosystem: Ecosystem,\n    operation: &RegistryPublishOperation,\n) -> Option<String> {\n    adapter_for(ecosystem).ok()?.repository(context, operation)\n}\n\n/// The production adapter set, keyed by ecosystem."},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01LDCVw7SCm84UWrNQDf7HXJ","name":"Edit","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release/capability.rs","old_string":"pub(crate) fn canonical_root(root: &Path) -> Result<std::path::PathBuf, GraphError> {","new_str":"/// A published version whose registry entry names another project's repository.\npub(crate) struct TakenName {\n    pub(crate) package: callisto_model::ReleasePackageId,\n    pub(crate) version: String,\n    pub(crate) registry_repository: String,\n    pub(crate) origin: String,\n}\n\n/// Of the registry publishes of `among`, those whose version the registry already holds under a repository other than\n/// this one. An unreadable or unrecorded repository proves nothing, so it is not reported; neither is a publish that\n/// cannot be observed.\npub(crate) fn names_taken_by_other_projects(\n    root: &Path,\n    runner: &dyn CommandRunner,\n    prepared: &super::derive::PreparedDerivation,\n    among: &std::collections::BTreeSet<callisto_model::ReleasePackageId>,\n) -> Result<Vec<TakenName>, GraphError> {\n    let context = ProviderContext::new(root, runner, prepared.git_remote.as_ref());\n    let Some(origin) = context.origin_endpoint() else {\n        return Ok(Vec::new());\n    };\n    let mut taken = Vec::new();\n    for (id, operation) in &prepared.operations {\n        let PreparedOperation::RegistryPublish(publish) = operation else {\n            continue;\n        };\n        if !among.contains(&id.package) {\n            continue;\n        }\n        let observed = checked_provider_for(operation)?.observe(\n            &context,\n            &ProviderRequest {\n                id,\n                operation,\n                artifacts: None,\n            },\n        )?;\n        if !matches!(observed, ProviderObservationV1::Exact { .. }) {\n            continue;\n        }\n        let recorded = super::provider::registry::recorded_repository(&context, id.package.ecosystem(), publish);\n        if let Some((registry_repository, origin)) =\n            super::provider::repository::differing_repositories(recorded.as_deref(), origin)\n        {\n            taken.push(TakenName {\n                package: id.package.clone(),\n                version: publish.version.render().to_string(),\n                registry_repository,\n                origin,\n            });\n        }\n    }\n    Ok(taken)\n}\n\npub(crate) fn canonical_root(root: &Path) -> Result<std::path::PathBuf, GraphError> {"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01Tr48vx8C2RN2nqvuJGh8ax","name":"Edit","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/error.rs","old_string":"    #[error(\"release precondition unmet: requires {requirement}\")]","new_str":"    #[error(\n        \"`{package}` {version} is already published, and its registry entry names {registry_repository}, not this \\\n         repository ({origin})\"\n    )]\n    #[diagnostic(\n        code(E322),\n        help(\n            \"This looks like another project's package: this repository has never released `{package}`, yet the \\\n             registry holds that version for a different repository. Rename the package. If it is yours (it moved \\\n             repositories), tag the commit that set this version by hand and run `callisto release` again.\"\n        )\n    )]\n    ReleaseNameTaken {\n        package: String,\n        version: String,\n        registry_repository: String,\n        origin: String,\n    },\n\n    #[error(\"release precondition unmet: requires {requirement}\")]"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_012X8AdQKQfCqerrhHWZKee4","name":"Edit","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release/local.rs","old_string":"    refuse_a_published_version_left_behind(workspace, &decision, &resumable, &source, profile, mode)?;\n    // A local run is its own orchestration","new_str":"    refuse_a_name_another_project_owns(workspace, &decision, &source, profile, mode)?;\n    refuse_a_published_version_left_behind(workspace, &decision, &resumable, &source, profile, mode)?;\n    // A local run is its own orchestration"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01SPyTczdeQEdhgkkyy9TCxy","name":"Edit","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release/local.rs","old_string":"/// Refuses to tag a version the registry already holds while its package has moved on since the commit that set it.","new_str":"/// Refuses a first release whose name another project already owns.\n///\n/// A package this repository has never tagged has no history here, so a version of it that the registry already holds\n/// under a different repository is that project's, not ours; adopting it would tag this commit as their release.\n/// A package that has a tag is left alone: its published versions are its own history.\nfn refuse_a_name_another_project_owns<R: CommandRunner, D: DependencyResolver>(\n    workspace: &Workspace<'_, R, D>,\n    decision: &callisto_model::ReleaseDecisionV1,\n    source: &SourceIdentity,\n    profile: ExecutionTrustProfileV1,\n    mode: LocalReleaseSource,\n) -> Result<(), GraphError> {\n    let tags = workspace.tags()?;\n    let first_releases: std::collections::BTreeSet<ReleasePackageId> = decision\n        .entries\n        .iter()\n        .filter(|entry| {\n            crate::commands::release_decision::workspace_package(workspace, &entry.package)\n                .is_some_and(|package| tags.last_tag(&package.id).is_none())\n        })\n        .map(|entry| entry.package.clone())\n        .collect();\n    // Without an `origin` push URL a preview cannot tell whose repository the registry names.\n    if first_releases.is_empty()\n        || (mode == LocalReleaseSource::Preview && optional_git_remote(&workspace.root, workspace.runner)?.is_none())\n    {\n        return Ok(());\n    }\n    let (_, prepared) =\n        derive_release_intent_with_prepared(workspace, decision, source.clone(), profile, None, &mut Vec::new())?;\n    match names_taken_by_other_projects(&workspace.root, workspace.runner, &prepared, &first_releases)?\n        .into_iter()\n        .next()\n    {\n        Some(taken) => Err(GraphError::ReleaseNameTaken {\n            package: taken.package.to_string(),\n            version: taken.version,\n            registry_repository: taken.registry_repository,\n            origin: taken.origin,\n        }),\n        None => Ok(()),\n    }\n}\n\n/// Refuses to tag a version the registry already holds while its package has moved on since the commit that set it."},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01YBeXHcPBCH9WGFyPzaA1FQ","name":"Bash","input":{"command":"grep -n \"^use\\|published_packages\" crates/callisto-graph/src/commands/release/local.rs | head -20","description":"Check imports in local.rs"},"caller":{"type":"direct"}}]}}
