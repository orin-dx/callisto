{"parentUuid":"b3e71271-ddbd-4d64-9be5-bafbe35a3131","isSidechain":false,"promptId":"292a1ddc-3040-4aad-8fec-ec43ab952564","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011ksqxhM17GX28furGhk78u","type":"tool_result","content":"660\t}\n661\t\n662\t// Flags produce the interactive run's config and preview, without prompting.\n663\t#[test]\n664\tfn non_interactive_matches_interactive() {\n665\t    let interactive_dir = workspace(1);\n666\t    let interactive = run_init(\n667\t        interactive_dir.path(),\n668\t        InitArgs::default(),\n669\t        true,\n670\t        vec![\n671\t            Answer::Select(1),\n672\t            Answer::Confirm(true),\n673\t            Answer::Input(\"example/tools\"),\n674\t            Answer::Input(\"x86_64-unknown-linux-gnu\"),\n675\t            Answer::Confirm(false),\n676\t            Answer::Confirm(true),\n677\t        ],\n678\t        false,\n679\t    );\n680\t    interactive.result.unwrap();\n681\t    let flags_dir = workspace(1);\n682\t    let flags = run_init(\n683\t        flags_dir.path(),\n684\t        InitArgs {\n685\t            versioning: Some(InitVersioning::Fixed),\n686\t            ..with_targets(&[\"x86_64-unknown-linux-gnu\"])\n687\t        },\n688\t        false,\n689\t        vec![],\n690\t        false,\n691\t    );\n692\t    flags.result.unwrap();\n693\t    assert!(flags.prompter.asked.is_empty());\n694\t    assert_eq!(config(interactive_dir.path()), config(flags_dir.path()));\n695\t    let preview = |out: &str| {\n696\t        let start = out.find(\"First release preview\").unwrap();\n697\t        let end = out.find(\"Initialized\").unwrap();\n698\t        let text = out[start..end].to_owned();\n699\t        text.replace(interactive_dir.path().to_str().unwrap(), \"\")\n700\t    };\n701\t    assert_eq!(preview(&interactive.out), preview(&flags.out));\n702\t}\n703\t\n704\t// A repository with no commit gets the config and a note instead of a preview.\n705\t#[test]\n706\tfn no_commits_skips_the_preview_and_still_writes() {\n707\t    let dir = tempfile::tempdir().unwrap();\n708\t    let root = dir.path();\n709\t    std::fs::write(\n710\t        root.join(\"Cargo.toml\"),\n711\t        \"[package]\\nname = \\\"app\\\"\\nversion = \\\"0.1.0\\\"\\nedition = \\\"2021\\\"\\n\",\n712\t    )\n713\t    .unwrap();\n714\t    callisto_fixtures::git::init_repo(root);\n715\t    git(root, &[\"remote\", \"add\", \"origin\", \"https://github.com/example/app.git\"]);\n716\t    let run = run_init(root, yes(InitVersioning::Independent), false, vec![], false);\n717\t    assert_eq!(run.result.unwrap(), ExitCode::SUCCESS);\n718\t    assert!(run.out.contains(NO_COMMITS), \"{}\", run.out);\n719\t    assert!(!run.out.contains(\"First release preview\"), \"{}\", run.out);\n720\t    assert_eq!(config(root), \"# callisto configuration\\n\");\n721\t    assert!(root.join(\".changeset/README.md\").exists());\n722\t}\n723\t\n724\t// --dry-run detects, asks, and previews, then writes nothing.\n725\t#[test]\n726\tfn dry_run_previews_and_writes_nothing() {\n727\t    let dir = workspace(0);\n728\t    let run = run_init(\n729\t        dir.path(),\n730\t        InitArgs::default(),\n731\t        true,\n732\t        vec![Answer::Select(0), Answer::Confirm(false)],\n733\t        true,\n734\t    );\n735\t    run.result.unwrap();\n736\t    assert_eq!(run.prompter.prompts(), [VERSIONING_PROMPT, WORKFLOW_PROMPT]);\n737\t    assert!(run.out.contains(\"Release plan:\"), \"{}\", run.out);\n738\t    assert!(run.out.contains(\"[DRY-RUN]\"));\n739\t    assert!(nothing_written(dir.path()));\n740\t}\n741\t\n742\t// --dry-run --workflow lists every file it would write: config, changeset README and workflow.\n743\t#[test]\n744\tfn dry_run_with_workflow_lists_every_file() {\n745\t    let dir = workspace(0);\n746\t    let args = InitArgs {\n747\t        workflow: true,\n748\t        ..yes(InitVersioning::Independent)\n749\t    };\n750\t    let out = Shared::default();\n751\t    let err = Shared::default();\n752\t    run(\n753\t        args,\n754\t        &global(dir.path(), OutputFormat::Json, true),\n755\t        false,\n756\t        &mut Scripted::new(vec![], &out),\n757\t        &mut out.clone(),\n758\t        &mut err.clone(),\n759\t        &fake_ls_remote(env!(\"CARGO_PKG_VERSION\")),"}]},"uuid":"7352d374-5421-4bd9-844e-e5fe800b3a10","timestamp":"2026-10-24T17:52:29.704Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-cli/src/commands/init/tests.rs","content":"}\n\n// Flags produce the interactive run's config and preview, without prompting.\n#[test]\nfn non_interactive_matches_interactive() {\n    let interactive_dir = workspace(1);\n    let interactive = run_init(\n        interactive_dir.path(),\n        InitArgs::default(),\n        true,\n        vec![\n            Answer::Select(1),\n            Answer::Confirm(true),\n            Answer::Input(\"example/tools\"),\n            Answer::Input(\"x86_64-unknown-linux-gnu\"),\n            Answer::Confirm(false),\n            Answer::Confirm(true),\n        ],\n        false,\n    );\n    interactive.result.unwrap();\n    let flags_dir = workspace(1);\n    let flags = run_init(\n        flags_dir.path(),\n        InitArgs {\n            versioning: Some(InitVersioning::Fixed),\n            ..with_targets(&[\"x86_64-unknown-linux-gnu\"])\n        },\n        false,\n        vec![],\n        false,\n    );\n    flags.result.unwrap();\n    assert!(flags.prompter.asked.is_empty());\n    assert_eq!(config(interactive_dir.path()), config(flags_dir.path()));\n    let preview = |out: &str| {\n        let start = out.find(\"First release preview\").unwrap();\n        let end = out.find(\"Initialized\").unwrap();\n        let text = out[start..end].to_owned();\n        text.replace(interactive_dir.path().to_str().unwrap(), \"\")\n    };\n    assert_eq!(preview(&interactive.out), preview(&flags.out));\n}\n\n// A repository with no commit gets the config and a note instead of a preview.\n#[test]\nfn no_commits_skips_the_preview_and_still_writes() {\n    let dir = tempfile::tempdir().unwrap();\n    let root = dir.path();\n    std::fs::write(\n        root.join(\"Cargo.toml\"),\n        \"[package]\\nname = \\\"app\\\"\\nversion = \\\"0.1.0\\\"\\nedition = \\\"2021\\\"\\n\",\n    )\n    .unwrap();\n    callisto_fixtures::git::init_repo(root);\n    git(root, &[\"remote\", \"add\", \"origin\", \"https://github.com/example/app.git\"]);\n    let run = run_init(root, yes(InitVersioning::Independent), false, vec![], false);\n    assert_eq!(run.result.unwrap(), ExitCode::SUCCESS);\n    assert!(run.out.contains(NO_COMMITS), \"{}\", run.out);\n    assert!(!run.out.contains(\"First release preview\"), \"{}\", run.out);\n    assert_eq!(config(root), \"# callisto configuration\\n\");\n    assert!(root.join(\".changeset/README.md\").exists());\n}\n\n// --dry-run detects, asks, and previews, then writes nothing.\n#[test]\nfn dry_run_previews_and_writes_nothing() {\n    let dir = workspace(0);\n    let run = run_init(\n        dir.path(),\n        InitArgs::default(),\n        true,\n        vec![Answer::Select(0), Answer::Confirm(false)],\n        true,\n    );\n    run.result.unwrap();\n    assert_eq!(run.prompter.prompts(), [VERSIONING_PROMPT, WORKFLOW_PROMPT]);\n    assert!(run.out.contains(\"Release plan:\"), \"{}\", run.out);\n    assert!(run.out.contains(\"[DRY-RUN]\"));\n    assert!(nothing_written(dir.path()));\n}\n\n// --dry-run --workflow lists every file it would write: config, changeset README and workflow.\n#[test]\nfn dry_run_with_workflow_lists_every_file() {\n    let dir = workspace(0);\n    let args = InitArgs {\n        workflow: true,\n        ..yes(InitVersioning::Independent)\n    };\n    let out = Shared::default();\n    let err = Shared::default();\n    run(\n        args,\n        &global(dir.path(), OutputFormat::Json, true),\n        false,\n        &mut Scripted::new(vec![], &out),\n        &mut out.clone(),\n        &mut err.clone(),\n        &fake_ls_remote(env!(\"CARGO_PKG_VERSION\")),","numLines":100,"startLine":660,"totalLines":1241}},"sourceToolAssistantUUID":"b3e71271-ddbd-4d64-9be5-bafbe35a3131","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"feat/init-defaults","slug":"lexical-jingling-puppy"}
