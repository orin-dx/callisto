s: Vec<callisto_model::Diagnostic>,\n}\n\n/// Derives the intent for every unreleased package (or exactly `selections`).\n///\n/// This is the one plan derivation behind both `callisto release --dry-run`\n/// and `callisto release`; `None` means nothing is unreleased.\npub fn plan_local_release<L: ProjectLocator, R: CommandRunner>(\n    root: &Path,\n    locator: &L,\n    runner: &R,\n    selections: &[ReleasePackageId],\n    mode: LocalReleaseSource,\n) -> Result<Option<LocalReleasePlan>, GraphError> {\n    let root = canonical_root(root)?;\n    let workspace = Workspace::load(root, locator, runner)?;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"44ac03e8-c645-4e70-b8a0-adbaeac69f7e","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","root":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","branch":"fix/taken-name-first-release","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":9,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callisto","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","platform":"macos"}},"sourceToolAssistantUUID":"328c0e05-16e2-4c60-b2f1-116ed64fdfb5","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/taken-name-first-release","slug":"lexical-jingling-puppy"}
