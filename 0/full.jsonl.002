{"parentUuid":"8a965e71-92c2-476e-9f38-71c3862058a2","isSidechain":false,"promptId":"81e97b21-5b87-4de1-93b0-c0727fa54480","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0142Xt9MVSgHCpnnhZ4Zaxv2","type":"tool_result","content":"260\t                    agg.severities.insert(pkg.id.clone(), outcome.severity);\n261\t                    agg.reasons.insert(\n262\t                        pkg.id.clone(),\n263\t                        BumpReason::Inference {\n264\t                            commits: outcome.commit_count,\n265\t                            remapped: outcome.remapped,\n266\t                        },\n267\t                    );\n268\t                    agg.named_by.insert(pkg.id.clone(), NamedBy::Inference);\n269\t                    agg.inference_commits.insert(pkg.id.clone(), outcome.commits.clone());\n270\t                }\n271\t            }\n272\t            Ok(None) => {}\n273\t            Err(e) => {\n274\t                agg.diagnostics.push(Diagnostic {\n275\t                    code: callisto_model::DiagnosticCode::PreMajorInferenceInert,\n276\t                    severity: callisto_model::DiagnosticSeverity::Warning,\n277\t                    message: format!(\"Commit inference failed for package `{}`: {e}\", pkg.id.display_name()),\n278\t                    package: Some(pkg.id.clone()),\n279\t                    path: None,\n280\t                    governed_by: None,\n281\t                    escalated_by: None,\n282\t                });\n283\t            }\n284\t        }\n285\t    }\n286\t\n287\t    // During a pre-release cycle (PreMode::Pre) changesets must NOT be consumed:\n288\t    // they remain on disk so they can be re-applied when the cycle exits.\n289\t    let is_pre_mode = pre\n290\t        .map(|s| s.mode == callisto_model::format::PreMode::Pre)\n291\t        .unwrap_or(false);\n292\t    // Ids already recorded in pre.json still resolve for severity, but are not re-added to the changelog.\n293\t    let already_recorded: std::collections::HashSet<&str> = pre\n294\t        .map(|s| s.changesets.iter().map(String::as_str).collect())\n295\t        .unwrap_or_default();\n296\t    let mut recorded_only: std::collections::HashSet<PackageId> = std::collections::HashSet::new();\n297\t\n298\t    for cs in loaded {\n299\t        let is_already_recorded = is_pre_mode && already_recorded.contains(cs.id.as_str());\n300\t        // Defer adding to `consumed` until after we confirm at least one entry\n301\t        // resolved to a real workspace package. A changeset where every entry\n302\t        // names a removed package must NOT be consumed (which would delete it\n303\t        // on disk); instead, an UnknownPackage diagnostic is emitted and the\n304\t        // file is left for the user to clean up manually.\n305\t        //\n306\t        // A changeset with a MIX of resolved and unresolved entries must also\n307\t        // stay unconsumed: consuming it would delete the file (or, in pre\n308\t        // mode, mark it as already-applied) and permanently lose the\n309\t        // unresolved entry's bump once that entry's target reappears.\n310\t        let mut matched_any = false;\n311\t        let mut has_unresolved = false;\n312\t        for entry in cs.changeset.entries {\n313\t            let id = match PackageId::parse(&entry.name) {\n314\t                Ok(id) => id,\n315\t                Err(_) => {\n316\t                    has_unresolved = true;\n317\t                    agg.diagnostics.push(Diagnostic {\n318\t                        code: callisto_model::DiagnosticCode::UnknownPackage,\n319\t                        severity: callisto_model::DiagnosticSeverity::Warning,\n320\t                        message: format!(\n321\t                            \"Changeset `{}` contains invalid package name `{}`; the changeset \\\n322\t                             will not be consumed until this entry is resolved\",\n323\t                            cs.path.display(),\n324\t                            entry.name\n325\t                        ),\n326\t                        package: None,\n327\t                        path: Some(cs.path.clone()),\n328\t                        governed_by: None,\n329\t                        escalated_by: None,\n330\t                    });\n331\t                    continue;\n332\t                }\n333\t            };\n334\t            match resolve_target_package(graph.packages(), identity, &id)? {\n335\t                Some(target_pkg) => {\n336\t                    matched_any = true;\n337\t                    let canonical_id = target_pkg.id.clone();\n338\t                    let cur_sev = agg.severities.get(&canonical_id).copied().unwrap_or(Severity::None);\n339\t                    if entry.severity > cur_sev {\n340\t                        agg.severities.insert(canonical_id.clone(), entry.severity);\n341\t                        agg.reasons.insert(\n342\t                            canonical_id.clone(),\n343\t                            BumpReason::Changeset {\n344\t                                changesets: vec![cs.id.clone()],\n345\t                            },\n346\t                        );\n347\t                        agg.named_by.insert(canonical_id.clone(), NamedBy::Changeset);\n348\t                    }\n349\t\n350\t                    if entry.severity != Severity::None && is_already_recorded {\n351\t                        recorded_only.insert(canonical_id.clone());\n352\t                    }\n353\t                    if entry.severity != Severity::None && !is_already_recorded {\n354\t                        // In pre-release mode use the pre-cycle entry version as the\n355\t                        // changelog \"from\" baseline so the log covers the full pre\n356\t                        // range rather than reflecting live (pre-tagged) versions.\n357\t                        let pkg_ver = if is_pre_mode {\n358\t                            pre.and_then(|s| crate::pre_initial_version(s, &canonical_id))\n359\t                                .cloned()\n360\t                                .or_else(|| base_versions.get(&canonical_id).cloned())\n361\t                                .unwrap_or_else(|| Version::semver(0, 0, 0))\n362\t                        } else {\n363\t                            tags.last_tag(&canonical_id)\n364\t                                .map(|t| t.version.clone())\n365\t                                .or_else(|| base_versions.get(&canonical_id).cloned())\n366\t                                .unwrap_or_else(|| Version::semver(0, 0, 0))\n367\t                        };\n368\t                        let cl_input =\n369\t                            agg.changelog_inputs\n370\t                                .entry(canonical_id.clone())\n371\t                                .or_insert_with(|| ChangelogInput {\n372\t                                    package: canonical_id.clone(),\n373\t                                    from: pkg_ver,\n374\t                                    to: None,\n375\t                                    entries: Vec::new(),\n376\t                                });\n377\t                        cl_input.entries.push(ChangelogEntry {\n378\t                            severity: entry.severity,\n379\t                            source: ChangeSource::Changeset {\n380\t                                filename: cs.id.clone(),\n381\t                                summary: cs.changeset.summary.clone(),\n382\t                            },\n383\t                        });\n384\t                    }\n385\t                }\n386\t                None => {\n387\t                    // Entry references a package not in the workspace (e.g. a\n388\t                    // package that was removed since the changeset was written).\n389\t                    // Emit a diagnostic so the user knows, but do NOT count\n390\t                    // this as a match -- a fully-orphaned changeset stays on\n391\t                    // disk rather than being silently deleted.\n392\t                    has_unresolved = true;\n393\t                    agg.diagnostics.push(Diagnostic {\n394\t                        code: callisto_model::DiagnosticCode::UnknownPackage,\n395\t                        severity: callisto_model::DiagnosticSeverity::Warning,\n396\t                        message: format!(\n397\t                            \"Changeset `{}` references package `{}` which is not in the \\\n398\t                             workspace; the changeset will not be consumed until this entry \\\n399\t                             is resolved\",\n400\t                            cs.path.display(),\n401\t                            entry.name\n402\t                        ),\n403\t                        package: None,\n404\t                        path: Some(cs.path.clone()),\n405\t                        governed_by: None,\n406\t                        escalated_by: None,\n407\t                    });\n408\t                }\n409\t            }"}]},"uuid":"994b0b97-e1bc-49fd-8120-e8ce799ee7d8","timestamp":"2026-10-24T18:26:07.894Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/aggregate.rs","content":"                    agg.severities.insert(pkg.id.clone(), outcome.severity);\n                    agg.reasons.insert(\n                        pkg.id.clone(),\n                        BumpReason::Inference {\n                            commits: outcome.commit_count,\n                            remapped: outcome.remapped,\n                        },\n                    );\n                    agg.named_by.insert(pkg.id.clone(), NamedBy::Inference);\n                    agg.inference_commits.insert(pkg.id.clone(), outcome.commits.clone());\n                }\n            }\n            Ok(None) => {}\n            Err(e) => {\n                agg.diagnostics.push(Diagnostic {\n                    code: callisto_model::DiagnosticCode::PreMajorInferenceInert,\n                    severity: callisto_model::DiagnosticSeverity::Warning,\n                    message: format!(\"Commit inference failed for package `{}`: {e}\", pkg.id.display_name()),\n                    package: Some(pkg.id.clone()),\n                    path: None,\n                    governed_by: None,\n                    escalated_by: None,\n                });\n            }\n        }\n    }\n\n    // During a pre-release cycle (PreMode::Pre) changesets must NOT be consumed:\n    // they remain on disk so they can be re-applied when the cycle exits.\n    let is_pre_mode = pre\n        .map(|s| s.mode == callisto_model::format::PreMode::Pre)\n        .unwrap_or(false);\n    // Ids already recorded in pre.json still resolve for severity, but are not re-added to the changelog.\n    let already_recorded: std::collections::HashSet<&str> = pre\n        .map(|s| s.changesets.iter().map(String::as_str).collect())\n        .unwrap_or_default();\n    let mut recorded_only: std::collections::HashSet<PackageId> = std::collections::HashSet::new();\n\n    for cs in loaded {\n        let is_already_recorded = is_pre_mode && already_recorded.contains(cs.id.as_str());\n        // Defer adding to `consumed` until after we confirm at least one entry\n        // resolved to a real workspace package. A changeset where every entry\n        // names a removed package must NOT be consumed (which would delete it\n        // on disk); instead, an UnknownPackage diagnostic is emitted and the\n        // file is left for the user to clean up manually.\n        //\n        // A changeset with a MIX of resolved and unresolved entries must also\n        // stay unconsumed: consuming it would delete the file (or, in pre\n        // mode, mark it as already-applied) and permanently lose the\n        // unresolved entry's bump once that entry's target reappears.\n        let mut matched_any = false;\n        let mut has_unresolved = false;\n        for entry in cs.changeset.entries {\n            let id = match PackageId::parse(&entry.name) {\n                Ok(id) => id,\n                Err(_) => {\n                    has_unresolved = true;\n                    agg.diagnostics.push(Diagnostic {\n                        code: callisto_model::DiagnosticCode::UnknownPackage,\n                        severity: callisto_model::DiagnosticSeverity::Warning,\n                        message: format!(\n                            \"Changeset `{}` contains invalid package name `{}`; the changeset \\\n                             will not be consumed until this entry is resolved\",\n                            cs.path.display(),\n                            entry.name\n                        ),\n                        package: None,\n                        path: Some(cs.path.clone()),\n                        governed_by: None,\n                        escalated_by: None,\n                    });\n                    continue;\n                }\n            };\n            match resolve_target_package(graph.packages(), identity, &id)? {\n                Some(target_pkg) => {\n                    matched_any = true;\n                    let canonical_id = target_pkg.id.clone();\n                    let cur_sev = agg.severities.get(&canonical_id).copied().unwrap_or(Severity::None);\n                    if entry.severity > cur_sev {\n                        agg.severities.insert(canonical_id.clone(), entry.severity);\n                        agg.reasons.insert(\n                            canonical_id.clone(),\n                            BumpReason::Changeset {\n                                changesets: vec![cs.id.clone()],\n                            },\n                        );\n                        agg.named_by.insert(canonical_id.clone(), NamedBy::Changeset);\n                    }\n\n                    if entry.severity != Severity::None && is_already_recorded {\n                        recorded_only.insert(canonical_id.clone());\n                    }\n                    if entry.severity != Severity::None && !is_already_recorded {\n                        // In pre-release mode use the pre-cycle entry version as the\n                        // changelog \"from\" baseline so the log covers the full pre\n                        // range rather than reflecting live (pre-tagged) versions.\n                        let pkg_ver = if is_pre_mode {\n                            pre.and_then(|s| crate::pre_initial_version(s, &canonical_id))\n                                .cloned()\n                                .or_else(|| base_versions.get(&canonical_id).cloned())\n                                .unwrap_or_else(|| Version::semver(0, 0, 0))\n                        } else {\n                            tags.last_tag(&canonical_id)\n                                .map(|t| t.version.clone())\n                                .or_else(|| base_versions.get(&canonical_id).cloned())\n                                .unwrap_or_else(|| Version::semver(0, 0, 0))\n                        };\n                        let cl_input =\n                            agg.changelog_inputs\n                                .entry(canonical_id.clone())\n                                .or_insert_with(|| ChangelogInput {\n                                    package: canonical_id.clone(),\n                                    from: pkg_ver,\n                                    to: None,\n                                    entries: Vec::new(),\n                                });\n                        cl_input.entries.push(ChangelogEntry {\n                            severity: entry.severity,\n                            source: ChangeSource::Changeset {\n                                filename: cs.id.clone(),\n                                summary: cs.changeset.summary.clone(),\n                            },\n                        });\n                    }\n                }\n                None => {\n                    // Entry references a package not in the workspace (e.g. a\n                    // package that was removed since the changeset was written).\n                    // Emit a diagnostic so the user knows, but do NOT count\n                    // this as a match -- a fully-orphaned changeset stays on\n                    // disk rather than being silently deleted.\n                    has_unresolved = true;\n                    agg.diagnostics.push(Diagnostic {\n                        code: callisto_model::DiagnosticCode::UnknownPackage,\n                        severity: callisto_model::DiagnosticSeverity::Warning,\n                        message: format!(\n                            \"Changeset `{}` references package `{}` which is not in the \\\n                             workspace; the changeset will not be consumed until this entry \\\n                             is resolved\",\n                            cs.path.display(),\n                            entry.name\n                        ),\n                        package: None,\n                        path: Some(cs.path.clone()),\n                        governed_by: None,\n                        escalated_by: None,\n                    });\n                }\n            }","numLines":150,"startLine":260,"totalLines":560}},"sourceToolAssistantUUID":"8a965e71-92c2-476e-9f38-71c3862058a2","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/unresolved-changeset-entry","slug":"lexical-jingling-puppy"}
