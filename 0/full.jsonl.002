{"type":"api-request-blob","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","hash":"28cc9d579e48b351459881d1d61590b9851748973ecbc845674ec2e1b4346e8a","message":{"role":"assistant","content":[{"type":"text","text":"Writing the graph function, then wiring it into the CLI."},{"type":"tool_use","id":"toolu_01VGWPUreUrGJkKkozdtmK55","name":"Edit","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release/local.rs","old_string":"/// A derived local release.","new_str":"/// The tags that name a package's last release here but are not on `origin`.\n///\n/// A release that tagged locally and then failed to push leaves exactly this, and a later rerun on another commit\n/// treats the tagged version as finished, so the remote tag and the forge release never happen. Best effort: no\n/// `origin`, no tags, or a remote that cannot be read all report nothing.\npub fn tags_missing_from_origin<L: ProjectLocator, R: CommandRunner>(\n    root: &Path,\n    locator: &L,\n    runner: &R,\n) -> Result<Vec<String>, GraphError> {\n    let workspace = Workspace::load(canonical_root(root)?, locator, runner)?;\n    let Some(remote) = optional_git_remote(&workspace.root, runner)? else {\n        return Ok(Vec::new());\n    };\n    let tags = workspace.tags()?;\n    let names: std::collections::BTreeSet<String> = workspace\n        .graph\n        .packages()\n        .filter_map(|package| tags.last_tag(&package.id))\n        .map(|tag| tag.name.as_str().to_owned())\n        .collect();\n    if names.is_empty() {\n        return Ok(Vec::new());\n    }\n    let references: Vec<String> = names.iter().map(|name| format!(\"refs/tags/{name}\")).collect();\n    let mut args = vec![\"ls-remote\", remote.endpoint.as_str()];\n    args.extend(references.iter().map(String::as_str));\n    let Ok(output) = runner.run_with_timeout(\n        super::provider::policy::programs::GIT,\n        &args,\n        &workspace.root,\n        super::provider::policy::timeouts::GIT_LS_REMOTE,\n    ) else {\n        return Ok(Vec::new());\n    };\n    if !output.success() {\n        return Ok(Vec::new());\n    }\n    let on_remote: std::collections::BTreeSet<&str> = output\n        .stdout\n        .lines()\n        .filter_map(|line| line.split_once('\\t'))\n        .filter_map(|(_, reference)| reference.strip_prefix(\"refs/tags/\"))\n        .map(|name| name.strip_suffix(\"^{}\").unwrap_or(name))\n        .collect();\n    Ok(names\n        .into_iter()\n        .filter(|name| !on_remote.contains(name.as_str()))\n        .collect())\n}\n\n/// A derived local release."},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_018AdgP6Q39NeN1tn3PPdNyv","name":"Bash","input":{"command":"sed -i '' 's/    ci_release_route, plan_local_release, plan_workspace_release, CiReleaseRoute, LocalReleasePlan, LocalReleaseSource,/    ci_release_route, plan_local_release, plan_workspace_release, tags_missing_from_origin, CiReleaseRoute,\\n    LocalReleasePlan, LocalReleaseSource,/' crates/callisto-graph/src/commands/release/mod.rs; sed -n 22,28p crates/callisto-graph/src/commands/mod.rs; sed -n 83,88p crates/callisto-graph/src/commands/release/mod.rs","description":"Re-export the new function from the release module and inspect the commands re-export"},"caller":{"type":"direct"}}]}}
