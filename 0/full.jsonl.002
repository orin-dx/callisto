oin(\".github/workflows/callisto-release.yml\").exists());\n    assert!(run.out.contains(\"Skipping the GitHub Actions workflow\"), \"{}\", run.out);\n}\n\n// An origin that is not on GitHub gets no workflow unasked.\n#[test]\nfn a_non_github_origin_gets_no_unrequested_workflow() {\n    let dir = workspace(0);\n    git(\n        dir.path(),\n        &[\"remote\", \"set-url\", \"origin\", \"https://gitlab.example.com/example/tools.git\"],\n    );\n    let args = InitArgs {\n        yes: true,\n        ..Default::default()\n    };\n    run_init(dir.path(), args, false, vec![], false).result.unwrap();\n    assert!(!dir.path().join(\".github/workflows/callisto-release.yml\").exists());\n}"}},"serverClassifierRequest":"0820fb9c-adde-47b0-84a0-9b3d325865ca","apiBlockIndex":3,"requestId":"req_011CgMVJiksbUwiTWZkyuiYm","requestRef":"f57ce319-f19b-4908-a3ee-2192b655f986","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"29c3724a-d4e5-4e96-a5b7-2ef839e059a5","timestamp":"2026-10-24T17:53:08.094Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"feat/init-defaults","slug":"lexical-jingling-puppy"}
