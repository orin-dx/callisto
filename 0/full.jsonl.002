ve_release_commit_decision, derive_release_decision, derive_selected_release_decision,\n    derive_unreleased_decision,\n};\npub use release_execution::execute_release;\npub use snapshot::plan_snapshot;\npub use status::{status, StatusOptions};\npub use version::{check_partial_run, plan_version, VersionOptions};\n\npub fn escalate(diagnostics: &mut [Diagnostic], strict: bool) {\n    for d in diagnostics {\n        if strict && d.escalated_by == Some(callisto_model::StrictFlag::Strict) {\n            d.severity = DiagnosticSeverity::Error;\n        }\n    }\n}\n","structuredPatch":[{"oldStart":21,"oldLines":8,"newStart":21,"newLines":8,"lines":[" pub use matrix::{matrix, MatrixOptions};"," pub use pr_body::{compose_pr_body, PrBodyOptions};"," pub use release::{","-    build_release_intent, build_release_intent_with_artifacts, ci_release_route, plan_local_release,","-    plan_workspace_release, origin_tag_probe, OriginTagProbe, validate_local_release_intent, validate_release_intent,","+    build_release_intent, build_release_intent_with_artifacts, ci_release_route, plan_loaded_release,","+    plan_local_release, plan_workspace_release, origin_tag_probe, OriginTagProbe, validate_local_release_intent, validate_release_intent,","     ArtifactBuildPolicy, CiReleaseRoute, LocalReleasePlan, LocalReleaseSource, ReleasePreflight, ReleaseProviderSet,","     ValidatedReleaseIntent,"," };"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"11851eb7-2562-4f98-8228-8b6aa056a75d","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"perf/measure","slug":"lexical-jingling-puppy"}
