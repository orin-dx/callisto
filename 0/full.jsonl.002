{"type":"api-request-blob","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","hash":"b464aa76ada5c26aa2e807cf31d53d28d8c3e751929528b6402cb20b52dbe936","message":{"role":"assistant","content":[{"type":"text","text":"Not `Copy`, so the variant can carry the offending path. Adding it and the check."},{"type":"tool_use","id":"toolu_01MiUTUXVhYpXcgtSVGaEiQq","name":"Edit","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/error.rs","old_string":"    #[error(\"a claimed package was not observed in this commit\")]\n    ClaimedPackageNotObserved,\n}","new_str":"    #[error(\"a claimed package was not observed in this commit\")]\n    ClaimedPackageNotObserved,\n    #[error(\"`{path}` is changed by this commit, but a version commit only changes manifests, lockfiles, changelogs, changesets and the decision file\")]\n    UnexpectedPath { path: String },\n}"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01CBKeBrJwUCDhX7RGm73xhV","name":"Edit","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release_decision.rs","old_string":"    // The decision must be freshly authored as part of *this* commit, not a\n    // stale leftover an earlier release already committed and this one never\n    // touched -- otherwise a commit that changes nothing real could still\n    // carry forward a prior, unrelated decision's authority.\n    let decision_path_str = normalized_git_path(decision_path)?;","new_str":"    // A version commit changes versions and what records them, nothing else. Any other path (build scripts, source,\n    // a package manager's `.npmrc` or `.cargo/config.toml`, `callisto.toml`, an action) could change what is published\n    // or where, under the cover of a bot-authored diff.\n    let decision_path_str = normalized_git_path(decision_path)?;\n    let changeset_dir = normalized_git_path(&workspace.config.changesets_dir)?;\n    let changelogs = workspace\n        .graph\n        .packages()\n        .filter_map(|package| package.changelog.as_deref())\n        .map(normalized_git_path)\n        .collect::<Result<std::collections::BTreeSet<_>, _>>()?;\n    for (_, path) in &changed {\n        if !is_version_commit_path(path, &decision_path_str, &changeset_dir, &changelogs) {\n            return Err(GraphError::ReleaseCommitVerificationFailed {\n                commit: release_commit.clone(),\n                reason: CommitVerificationFailure::UnexpectedPath { path: path.clone() },\n            });\n        }\n    }\n\n    // The decision must be freshly authored as part of *this* commit, not a\n    // stale leftover an earlier release already committed and this one never\n    // touched -- otherwise a commit that changes nothing real could still\n    // carry forward a prior, unrelated decision's authority."},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01RzjZjKuUH8Wo6687Gf3UyG","name":"Edit","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release_decision.rs","old_string":"    let changeset_dir = normalized_git_path(&workspace.config.changesets_dir)?;\n    let consumed_a_changeset = changed","new_str":"    let consumed_a_changeset = changed"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01CsbaiLdy29Sk1tKghs2Zso","name":"Edit","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release_decision.rs","old_string":"fn is_changeset_path(path: &str, changeset_dir: &str) -> bool {","new_str":"/// The manifests Callisto writes versions and dependency ranges into.\nconst VERSION_MANIFESTS: &[&str] = &[\"Cargo.toml\", \"package.json\", \"pyproject.toml\"];\n\n/// The lockfiles Callisto refreshes after it writes versions.\nconst VERSION_LOCKFILES: &[&str] = &[\n    \"Cargo.lock\",\n    \"package-lock.json\",\n    \"npm-shrinkwrap.json\",\n    \"pnpm-lock.yaml\",\n    \"yarn.lock\",\n    \"bun.lock\",\n    \"bun.lockb\",\n    \"uv.lock\",\n    \"poetry.lock\",\n    \"pdm.lock\",\n];\n\n/// Whether a version commit may change `path`: a manifest or lockfile anywhere, a package's changelog, the decision\n/// file, a changeset, or the changesets directory's `pre.json`.\nfn is_version_commit_path(\n    path: &str,\n    decision_path: &str,\n    changeset_dir: &str,\n    changelogs: &std::collections::BTreeSet<String>,\n) -> bool {\n    let file_name = path.rsplit('/').next().unwrap_or(path);\n    let pre_json = if changeset_dir.is_empty() {\n        \"pre.json\".to_owned()\n    } else {\n        format!(\"{changeset_dir}/pre.json\")\n    };\n    path == decision_path\n        || path == pre_json\n        || VERSION_MANIFESTS.contains(&file_name)\n        || VERSION_LOCKFILES.contains(&file_name)\n        || changelogs.contains(path)\n        || is_changeset_path(path, changeset_dir)\n}\n\nfn is_changeset_path(path: &str, changeset_dir: &str) -> bool {"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01SGRf8GQJxNr3nRBai1MxA1","name":"Bash","input":{"command":"cargo build -p callisto-graph 2>&1 | tail -15","description":"Build","timeout":600000},"caller":{"type":"direct"}}]}}
