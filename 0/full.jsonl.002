n RELEASE_CREDENTIALS.iter().chain(ACTION_SECRET_INPUTS) {\n            assert!(\n                callisto_model::SECRET_CREDENTIAL_ENV.contains(name) || NOT_SECRET.contains(name),\n                \"`{name}` is neither redacted from output nor listed as carrying no secret\"\n            );\n        }\n    }\n\n    /// The whole least-privilege matrix: each release credential survives only in the tools that\n    /// read it, and in no other child process.\n    #[test]\n    fn every_release_credential_reaches_only_the_tools_that_use_it() {\n        let owners: &[(&str, &[&str])] = &[\n            (\"NPM_CONFIG_TOKEN\", &[\"npm\", \"pnpm\", \"yarn\", \"bun\"]),\n            (\"NPM_TOKEN\", &[\"npm\", \"pnpm\", \"yarn\", \"bun\"]),\n            (\"NODE_AUTH_TOKEN\", &[\"npm\", \"pnpm\", \"yarn\", \"bun\"]),\n            (\"CARGO_REGISTRY_TOKEN\", &[\"cargo\"]),\n            (\"GH_TOKEN\", &[\"gh\"]),\n241-/// rather than reading the environment directly -- deterministic, no\n242-/// process-env mutation in tests.\n243:pub fn known_credential_env_values(vars: impl Iterator<Item = (String, String)>) -> Vec<String> {\n244-    vars.filter(|(key, value)| {\n245-        !value.is_empty()\n246-            && (SECRET_CREDENTIAL_ENV.contains(&key.as_str())\n247-                || (key.starts_with(\"CARGO_REGISTRIES_\") && key.ends_with(\"_TOKEN\"))\n248-                || (value.len() >= MIN_SECRET_VALUE_LEN && SECRET_NAME_SUFFIXES.iter().any(|s| key.ends_with(s))))\n249-    })\n250-    .map(|(_, value)| value)\n251-    .collect()\n252-}\n253-\n254-/// Any variable named like a secret has its value redacted too, unless the value is so short that masking it would\n255-/// mangle ordinary text.\n256-const SECRET_NAME_SUFFIXES: &[&str] = &[\"_TOKEN\", \"_SECRET\", \"_PASSWORD\"];\n257-const MIN_SECRET_VALUE_LEN: usize = 8;\n258-\n259-/// The environment variables whose values are secrets. A username and the paths of generated config files\n260-/// (`TWINE_USERNAME`, `NPM_CONFIG_US