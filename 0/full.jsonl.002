/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"fix/first-release-metadata","slug":"lexical-jingling-puppy"}
{"parentUuid":"b2645b07-2ca2-4796-9c71-ac4b85d88f6f","isSidechain":false,"promptId":"e05639b3-9150-41dd-8002-a9fd8a53af89","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NhfFV4pgYRiwpoJT5pjg4Y","type":"tool_result","content":"140\t///\n141\t/// This is the one plan derivation behind both `callisto release --dry-run`\n142\t/// and `callisto release`; `None` means nothing is unreleased.\n143\tpub fn plan_local_release<L: ProjectLocator, R: CommandRunner>(\n144\t    root: &Path,\n145\t    locator: &L,\n146\t    runner: &R,\n147\t    selections: &[ReleasePackageId],\n148\t    mode: LocalReleaseSource,\n149\t) -> Result<Option<LocalReleasePlan>, GraphError> {\n150\t    let root = canonical_root(root)?;\n151\t    let workspace = Workspace::load(root, locator, runner)?;\n152\t    plan_release(&workspace, selections, mode, true)\n153\t}\n154\t\n155\t/// The tagged releases on HEAD whose operations are not all observed satisfied: a rerun finishes them.\n156\t///\n157\t/// A tag proves only that the tag was created. Releases tagged on an older commit are settled and\n158\t/// never observed, so only a rerun at the release commit reaches the providers.\n159\tfn incomplete_tagged_releases<R: CommandRunner, D: DependencyResolver>(\n160\t    workspace: &Workspace<'_, R, D>,\n161\t    mode: LocalReleaseSource,\n162\t) -> Result<std::collections::BTreeSet<ReleasePackageId>, GraphError> {\n163\t    let head = workspace.git_access().head_sha()?;\n164\t    let tagged: std::collections::BTreeSet<ReleasePackageId> =\n165\t        crate::commands::release_decision::releases_tagged_at(workspace, &head)?\n166\t            .into_iter()\n167\t            .map(|entry| entry.package)\n168\t            .collect();\n169\t    if tagged.is_empty() {\n170\t        return Ok(tagged);\n171\t    }\n172\t    // Without an `origin` push URL a preview cannot observe anything, so it cannot call a tagged release finished.\n173\t    if mode == LocalReleaseSource::Preview && optional_git_remote(&workspace.root, workspace.runner)?.is_none() {\n174\t        return Ok(tagged);\n175\t    }\n176\t    let profile = ExecutionTrustProfileV1::GitCommit;\n177\t    let source = match mode {\n178\t        LocalReleaseSource::Preview => SourceIdentity::GitCommit { sha: head },\n179\t        LocalReleaseSource::Trusted => observe_source(workspace, profile, ReleaseCheckout::AnyHead)?,\n180\t    };\n181\t    // The roster a run would plan with every tagged release still open, so a dependency left untagged by the\n182\t    // failed run is part of it and the dependency checks see the same packages as the real derivation.\n183\t    let Some(decision) = crate::commands::release_decision::derive_release_roster(workspace, &[], &tagged)? else {\n184\t        return Ok(Default::default());\n185\t    };\n186\t    let (_, prepared) =\n187\t        derive_release_intent_with_prepared(workspace, &decision, source, profile, None, &mut Vec::new())?;\n188\t    Ok(unsatisfied_packages(\n189\t        &workspace.root,\n190\t        workspace.runner,\n191\t        &prepared,\n192\t        &tagged,\n193\t    ))\n194\t}\n195\t\n196\t/// Refuses a first release whose name another project already owns.\n197\t///\n198\t/// A package this repository has never tagged has no history here, so a version of it that the registry already holds\n199\t/// under a different repository is that project's, not ours; adopting it would tag this commit as their release.\n200\t/// A package that has a tag is left alone: its published versions are its own history.\n201\tfn refuse_a_name_another_project_owns<R: CommandRunner, D: DependencyResolver>(\n202\t    workspace: &Workspace<'_, R, D>,\n203\t    decision: &callisto_model::ReleaseDecisionV1,\n204\t    source: &SourceIdentity,\n205\t    profile: ExecutionTrustProfileV1,\n206\t    mode: LocalReleaseSource,\n207\t) -> Result<(), GraphError> {\n208\t    let tags = workspace.tags()?;\n209\t    let first_releases: std::collections::BTreeSet<ReleasePackageId> = decision\n210\t        .entries\n211\t        .iter()\n212\t        .filter(|entry| {\n213\t            crate::commands::release_decision::workspace_package(workspace, &entry.package)\n214\t                .is_some_and(|package| tags.last_tag(&package.id).is_none())\n215\t        })\n216\t        .map(|entry| entry.package.clone())\n217\t        .collect();\n218\t    // Without an `origin` push URL a preview cannot tell whose repository the registry names.\n219\t    if first_releases.is_empty()\n220\t        || (mode == LocalReleaseSource::Preview && optional_git_remote(&workspace.root, workspace.runner)?.is_none())\n221\t    {\n222\t        return Ok(());\n223\t    }\n224\t    let (_, prepared) =\n225\t        derive_release_intent_with_prepared(workspace, decision, source.clone(), profile, None, &mut Vec::new())?;\n226\t    match names_taken_by_other_projects(&workspace.root, workspace.runner, &prepared, &first_releases)?\n227\t        .into_iter()\n228\t        .next()\n229\t    {\n230\t        Some(taken) => Err(GraphError::ReleaseNameTaken {\n231\t            package: taken.package.to_string(),\n232\t            version: taken.version,\n233\t            registry_repository: taken.registry_repository,\n234\t            origin: taken.origin,\n235\t        }),\n236\t        None => Ok(()),\n237\t    }\n238\t}\n239\t\n240\t/// Refuses to tag a version the registry already holds while its package has moved on since the commit that set it.\n241\t///\n242\t/// A release that stopped after publishing leaves exactly this state. A rerun on a later commit would tag code that\n243\t/// was never published, so it finishes from the version commit instead. Nothing is observed unless a package moved.\n244\tfn refuse_a_published_version_left_behind<R: CommandRunner, D: DependencyResolver>(\n245\t    workspace: &Workspace<'_, R, D>,\n246\t    decision: &callisto_model::ReleaseDecisionV1,\n247\t    resumable: &std::collections::BTreeSet<ReleasePackageId>,\n248\t    source: &SourceIdentity,\n249\t    profile: ExecutionTrustProfileV1,\n250\t    mode: LocalReleaseSource,\n251\t) -> Result<(), GraphError> {\n252\t    let moved = super::version_commit::packages_moved_past_their_version(workspace, decision, resumable)?;\n253\t    // Without an `origin` push URL a preview cannot observe the registry either.\n254\t    if moved.is_empty()\n255\t        || (mode == LocalReleaseSource::Preview && optional_git_remote(&workspace.root, workspace.runner)?.is_none())\n256\t    {\n257\t        return Ok(());\n258\t    }\n259\t    let (_, prepared) =\n260\t        derive_release_intent_with_prepared(workspace, decision, source.clone(), profile, None, &mut Vec::new())?;\n261\t    let among = moved.iter().map(|moved| moved.package.clone()).collect();\n262\t    let published = published_packages(&workspace.root, workspace.runner, &prepared, &among)?;\n263\t    match moved.into_iter().find(|moved| published.contains(&moved.package)) {\n264\t        Some(moved) => {\n265\t            let (since, fix) = match moved.version_commit {\n266\t                Some(commit) => {\n267\t                    let short: String = commit.chars().take(12).collect();\n268\t                    (\n269\t                        format!(\"{short}, the commit that set it\"),\n270\t                        format!(\"Check out {short} (`git checkout --detach {short}`) and run `callisto release` again to finish that release. Releasing from here would tag code that was not published.\"),\n271\t                    )\n272\t                }\n273\t                None => (\n274\t                    \"the commit that set it, which this history does not show\".to_owned(),\n275\t                    \"Check out the commit that was published and run `callisto release` again, or tag that commit by hand. Releasing from here could tag code that was not published.\".to_owned(),\n276\t                ),\n277\t            };\n278\t            Err(GraphError::ReleasePublishedVersionMoved {\n279\t                package: moved.package.to_string(),\n280\t                version: moved.version,\n281\t                since,\n282\t                fix,\n283\t            })\n284\t        }\n285\t        None => Ok(()),\n286\t    }\n287\t}\n288\t\n289\t/// [`plan_local_release`] over an already-loaded workspace, e.g. one built from an in-memory config.\n290\t///\n291\t/// This looks at no registry for a name another project owns, so a caller that must stay offline, such as the plan\n292\t/// `init` previews, can use it; [`plan_local_release`] does look.\n293\tpub fn plan_workspace_release<R: CommandRunner, D: DependencyResolver>(\n294\t    workspace: &Workspace<'_, R, D>,\n295\t    selections: &[ReleasePackageId],\n296\t    mode: LocalReleaseSource,\n297\t) -> Result<Option<LocalReleasePlan>, GraphError> {\n298\t    plan_release(workspace, selections, mode, false)\n299\t}\n300\t\n301\tfn plan_release<R: CommandRunner, D: DependencyResolver>(\n302\t    workspace: &Workspace<'_, R, D>,\n303\t    selections: &[ReleasePackageId],\n304\t    mode: LocalReleaseSource,\n305\t    check_taken_names: bool,\n306\t) -> Result<Option<LocalReleasePlan>, GraphError> {\n307\t    let resumable = incomplete_tagged_releases(workspace, mode)?;\n308\t    let Some(decision) = crate::commands::release_decision::derive_release_roster(workspace, selections, &resumable)?\n309\t    else {\n310\t        return Ok(None);\n311\t    };\n312\t    let profile = ExecutionTrustProfileV1::GitCommit;\n313\t    let source = match mode {\n314\t        LocalReleaseSource::Preview => SourceIdentity::GitCommit {\n315\t            sha: workspace.git_access().head_sha()?,\n316\t        },\n317\t        LocalReleaseSource::Trusted => observe_source(workspace, profile, ReleaseCheckout::AnyHead)?,\n318\t    };\n319\t    if check_taken_names {\n320\t        refuse_a_name_another_project_owns(workspace, &decision, &source, profile, mode)?;\n321\t    }\n322\t    refuse_a_published_version_left_behind(workspace, &decision, &resumable, &source, profile, mode)?;\n323\t    // A local run is its own orchestration: slots bind to the source commit.\n324\t    let artifact_policy = match (&workspace.config.product_release, &source) {\n325\t        (Some(release), SourceIdentity::GitCommit { sha }) if !release.artifacts.is_empty() => {\n326\t            release.forge_repository.clone().map(|repository| ArtifactBuildPolicy {\n327\t                repository,\n328\t                workflow_path: callisto_model::RELEASE_COORDINATOR_WORKFLOW_PATH.to_owned(),\n329\t                workflow_commit: sha.clone(),"}]},"uuid":"0a16a454-85ba-4583-9eff-a636c61922ba","timestamp":"2026-10-24T23:37:20.774Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release/local.rs","content":"///\n/// This is the one plan derivation behind both `callisto release --dry-run`\n/// and `callisto release`; `None` means nothing is unreleased.\npub fn plan_local_release<L: ProjectLocator, R: CommandRunner>(\n    root: &Path,\n    locator: &L,\n    runner: &R,\n    selections: &[ReleasePackageId],\n    mode: LocalReleaseSource,\n) -> Result<Option<LocalReleasePlan>, GraphError> {\n    let root = canonical_root(root)?;\n    let workspace = Workspace::load(root, locator, runner)?;\n    plan_release(&workspace, selections, mode, true)\n}\n\n/// The tagged releases on HEAD whose operations are not all observed satisfied: a rerun finishes them.\n///\n/// A tag proves only that the tag was created. Releases tagged on an older commit are settled and\n/// never observed, so only a rerun at the release commit reaches the providers.\nfn incomplete_tagged_releases<R: CommandRunner, D: DependencyResolver>(\n    workspace: &Workspace<'_, R, D>,\n    mode: LocalReleaseSource,\n) -> Result<std::collections::BTreeSet<ReleasePackageId>, GraphError> {\n    let head = workspace.git_access().head_sha()?;\n    let tagged: std::collections::BTreeSet<ReleasePackageId> =\n        crate::commands::release_decision::releases_tagged_at(workspace, &head)?\n            .into_iter()\n            .map(|entry| entry.package)\n            .collect();\n    if tagged.is_empty() {\n        return Ok(tagged);\n    }\n    // Without an `origin` push URL a preview cannot observe anything, so it cannot call a tagged release finished.\n    if mode == LocalReleaseSource::Preview && optional_git_remote(&workspace.root, workspace.runner)?.is_none() {\n        return Ok(tagged);\n    }\n    let profile = ExecutionTrustProfileV1::GitCommit;\n    let source = match mode {\n        LocalReleaseSource::Preview => SourceIdentity::GitCommit { sha: head },\n        LocalReleaseSource::Trusted => observe_source(workspace, profile, ReleaseCheckout::AnyHead)?,\n    };\n    // The roster a run would plan with every tagged release still open, so a dependency left untagged by the\n    // failed run is part of it and the dependency checks see the same packages as the real derivation.\n    let Some(decision) = crate::commands::release_decision::derive_release_roster(workspace, &[], &tagged)? else {\n        return Ok(Default::default());\n    };\n    let (_, prepared) =\n        derive_release_intent_with_prepared(workspace, &decision, source, profile, None, &mut Vec::new())?;\n    Ok(unsatisfied_packages(\n        &workspace.root,\n        workspace.runner,\n        &prepared,\n        &tagged,\n    ))\n}\n\n/// Refuses a first release whose name another project already owns.\n///\n/// A package this repository has never tagged has no history here, so a version of it that the registry already holds\n/// under a different repository is that project's, not ours; adopting it would tag this commit as their release.\n/// A package that has a tag is left alone: its published versions are its own history.\nfn refuse_a_name_another_project_owns<R: CommandRunner, D: DependencyResolver>(\n    workspace: &Workspace<'_, R, D>,\n    decision: &callisto_model::ReleaseDecisionV1,\n    source: &SourceIdentity,\n    profile: ExecutionTrustProfileV1,\n    mode: LocalReleaseSource,\n) -> Result<(), GraphError> {\n    let tags = workspace.tags()?;\n    let first_releases: std::collections::BTreeSet<ReleasePackageId> = decision\n        .entries\n        .iter()\n        .filter(|entry| {\n            crate::commands::release_decision::workspace_package(workspace, &entry.package)\n                .is_some_and(|package| tags.last_tag(&package.id).is_none())\n        })\n        .map(|entry| entry.package.clone())\n        .collect();\n    // Without an `origin` push URL a preview cannot tell whose repository the registry names.\n    if first_releases.is_empty()\n        || (mode == LocalReleaseSource::Preview && optional_git_remote(&workspace.root, workspace.runner)?.is_none())\n    {\n        return Ok(());\n    }\n    let (_, prepared) =\n        derive_release_intent_with_prepared(workspace, decision, source.clone(), profile, None, &mut Vec::new())?;\n    match names_taken_by_other_projects(&workspace.root, workspace.runner, &prepared, &first_releases)?\n        .into_iter()\n        .next()\n    {\n        Some(taken) => Err(GraphError::ReleaseNameTaken {\n            package: taken.package.to_string(),\n            version: taken.version,\n            registry_repository: taken.registry_repository,\n            origin: taken.origin,\n        }),\n        None => Ok(()),\n    }\n}\n\n/// Refuses to tag a version the registry already holds while its package has moved on since the commit that set it.\n///\n/// A release that stopped after publishing leaves exactly this state. A rerun on a later commit would tag code that\n/// was never published, so it finishes from the version commit instead. Nothing is observed unless a package moved.\nfn refuse_a_published_version_left_behind<R: CommandRunner, D: DependencyResolver>(\n    workspace: &Workspace<'_, R, D>,\n    decision: &callisto_model::ReleaseDecisionV1,\n    resumable: &std::collections::BTreeSet<ReleasePackageId>,\n    source: &SourceIdentity,\n    profile: ExecutionTrustProfileV1,\n    mode: LocalReleaseSource,\n) -> Result<(), GraphError> {\n    let moved = super::version_commit::packages_moved_past_their_version(workspace, decision, resumable)?;\n    // Without an `origin` push URL a preview cannot observe the registry either.\n    if moved.is_empty()\n        || (mode == LocalReleaseSource::Preview && optional_git_remote(&workspace.root, workspace.runner)?.is_none())\n    {\n        return Ok(());\n    }\n    let (_, prepared) =\n        derive_release_intent_with_prepared(workspace, decision, source.clone(), profile, None, &mut Vec::new())?;\n    let among = moved.iter().map(|moved| moved.package.clone()).collect();\n    let published = published_packages(&workspace.root, workspace.runner, &prepared, &among)?;\n    match moved.into_iter().find(|moved| published.contains(&moved.package)) {\n        Some(moved) => {\n            let (since, fix) = match moved.version_commit {\n                Some(commit) => {\n                    let short: String = commit.chars().take(12).collect();\n                    (\n                        format!(\"{short}, the commit that set it\"),\n                        format!(\"Check out {short} (`git checkout --detach {short}`) and run `callisto release` again to finish that release. Releasing from here would tag code that was not published.\"),\n                    )\n                }\n                None => (\n                    \"the commit that set it, which this history does not show\".to_owned(),\n                    \"Check out the commit that was published and run `callisto release` again, or tag that commit by hand. Releasing from here could tag code that was not published.\".to_owned(),\n                ),\n            };\n            Err(GraphError::ReleasePublishedVersionMoved {\n                package: moved.package.to_string(),\n                version: moved.version,\n                since,\n                fix,\n            })\n        }\n        None => Ok(()),\n    }\n}\n\n/// [`plan_local_release`] over an already-loaded workspace, e.g. one built from an in-memory config.\n///\n/// This looks at no registry for a name another project owns, so a caller that must stay offline, such as the plan\n/// `init` previews, can use it; [`plan_local_release`] does look.\npub fn plan_workspace_release<R: CommandRunner, D: DependencyResolver>(\n    workspace: &Workspace<'_, R, D>,\n    selections: &[ReleasePackageId],\n    mode: LocalReleaseSource,\n) -> Result<Option<LocalReleasePlan>, GraphError> {\n    plan_release(workspace, selections, mode, false)\n}\n\nfn plan_release<R: CommandRunner, D: DependencyResolver>(\n    workspace: &Workspace<'_, R, D>,\n    selections: &[ReleasePackageId],\n    mode: LocalReleaseSource,\n    check_taken_names: bool,\n) -> Result<Option<LocalReleasePlan>, GraphError> {\n    let resumable = incomplete_tagged_releases(workspace, mode)?;\n    let Some(decision) = crate::commands::release_decision::derive_release_roster(workspace, selections, &resumable)?\n    else {\n        return Ok(None);\n    };\n    let profile = ExecutionTrustProfileV1::GitCommit;\n    let source = match mode {\n        LocalReleaseSource::Preview => SourceIdentity::GitCommit {\n            sha: workspace.git_access().head_sha()?,\n        },\n        LocalReleaseSource::Trusted => observe_source(workspace, profile, ReleaseCheckout::AnyHead)?,\n    };\n    if check_taken_names {\n        refuse_a_name_another_project_owns(workspace, &decision, &source, profile, mode)?;\n    }\n    refuse_a_published_version_left_behind(workspace, &decision, &resumable, &source, profile, mode)?;\n    // A local run is its own orchestration: slots bind to the source commit.\n    let artifact_policy = match (&workspace.config.product_release, &source) {\n        (Some(release), SourceIdentity::GitCommit { sha }) if !release.artifacts.is_empty() => {\n            release.forge_repository.clone().map(|repository| ArtifactBuildPolicy {\n                repository,\n                workflow_path: callisto_model::RELEASE_COORDINATOR_WORKFLOW_PATH.to_owned(),\n                workflow_commit: sha.clone(),","numLines":190,"startLine":140,"totalLines":796}},"sourceToolAssistantUUID":"b2645b07-2ca2-4796-9c71-ac4b85d88f6f","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"fix/first-release-metadata","slug":"lexical-jingling-puppy"}
