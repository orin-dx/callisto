er().map(String::as_str));\n        let Ok(output) = runner.run_with_timeout(\n            super::provider::policy::programs::GIT,\n            &args,\n            &self.cwd,\n            super::provider::policy::timeouts::GIT_LS_REMOTE,\n        ) else {\n            return Vec::new();\n        };\n        if !output.success() {\n            return Vec::new();\n        }\n        let on_remote: std::collections::BTreeSet<&str> = output\n            .stdout\n            .lines()\n            .filter_map(|line| line.split_once('\\t'))\n            .filter_map(|(_, reference)| reference.strip_prefix(\"refs/tags/\"))\n            .map(|name| name.strip_suffix(\"^{}\").unwrap_or(name))\n            .collect();\n        self.tags\n            .iter()\n            .filter(|name| !on_remote.contains(name.as_str()))\n            .cloned()\n            .collect()\n    }\n}\n\n"}},"serverClassifierRequest":"2aaccc9f-64ec-48fb-9016-d094daf7f6c3","apiBlockIndex":1,"requestId":"req_011CgN1GeWpMCLFepo7NqLYs","requestRef":"16f4c049-9308-415f-b283-f0a0de28e5aa","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"e2e4207c-933a-4355-b42d-8fc474e59078","timestamp":"2026-10-25T00:26:02.088Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"perf/measure","slug":"lexical-jingling-puppy"}
