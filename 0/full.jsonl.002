{"parentUuid":"3bf7ac04-27de-4e63-ba92-82fe73bc320c","isSidechain":false,"promptId":"bd6ac0ce-389b-4193-aca8-c1bc4969277a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015EwMvSwmBqBf1Gxkr59Qg2","type":"tool_result","content":"424\t\n425\t    #[test]\n426\t    fn npm_ranges_match_all_valid_disjunctions_without_changing_wire_spelling() {\n427\t        for (range, candidate, expected) in [\n428\t            (\"^1.0.0 || ^2.0.0\", \"2.4.0\", true),\n429\t            (\"^1.0.0 || ^2.0.0\", \"3.0.0\", false),\n430\t            (\"1.2.3\", \"1.2.4\", false),\n431\t            (\"1.2\", \"1.2.9\", true),\n432\t            (\"1.2\", \"1.3.0\", false),\n433\t        ] {\n434\t            let requirement = VersionReq::parse(range, Ecosystem::Npm).unwrap();\n435\t            let version = Version::parse(candidate, VersionGrammar::SemVer).unwrap();\n436\t            assert_eq!(requirement.matches(&version).unwrap(), expected, \"{range}: {candidate}\");\n437\t            assert_eq!(requirement.render(), range);\n438\t        }\n439\t        for invalid in [\"^1.0.0 ||\", \"|| ^1.0.0\", \"^1.0.0 || nonsense\"] {\n440\t            assert!(VersionReq::parse(invalid, Ecosystem::Npm).is_err(), \"{invalid}\");\n441\t        }\n442\t    }\n443\t\n444\t    #[test]\n445\t    fn parses_valid_semver_and_exposes_components() {\n446\t        let v = Version::parse(\"1.2.3\", VersionGrammar::SemVer).unwrap();\n447\t        assert_eq!(v.grammar(), VersionGrammar::SemVer);\n448\t        assert_eq!(v.major(), Some(1));\n449\t        assert_eq!(v.minor(), Some(2));\n450\t        assert_eq!(v.patch(), Some(3));\n451\t        assert!(!v.is_prerelease());\n452\t    }\n453\t"}]},"uuid":"b6601c1c-d37a-4a38-87ac-2ec6d031741f","timestamp":"2026-10-24T22:05:16.541Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-model/src/version.rs","content":"\n    #[test]\n    fn npm_ranges_match_all_valid_disjunctions_without_changing_wire_spelling() {\n        for (range, candidate, expected) in [\n            (\"^1.0.0 || ^2.0.0\", \"2.4.0\", true),\n            (\"^1.0.0 || ^2.0.0\", \"3.0.0\", false),\n            (\"1.2.3\", \"1.2.4\", false),\n            (\"1.2\", \"1.2.9\", true),\n            (\"1.2\", \"1.3.0\", false),\n        ] {\n            let requirement = VersionReq::parse(range, Ecosystem::Npm).unwrap();\n            let version = Version::parse(candidate, VersionGrammar::SemVer).unwrap();\n            assert_eq!(requirement.matches(&version).unwrap(), expected, \"{range}: {candidate}\");\n            assert_eq!(requirement.render(), range);\n        }\n        for invalid in [\"^1.0.0 ||\", \"|| ^1.0.0\", \"^1.0.0 || nonsense\"] {\n            assert!(VersionReq::parse(invalid, Ecosystem::Npm).is_err(), \"{invalid}\");\n        }\n    }\n\n    #[test]\n    fn parses_valid_semver_and_exposes_components() {\n        let v = Version::parse(\"1.2.3\", VersionGrammar::SemVer).unwrap();\n        assert_eq!(v.grammar(), VersionGrammar::SemVer);\n        assert_eq!(v.major(), Some(1));\n        assert_eq!(v.minor(), Some(2));\n        assert_eq!(v.patch(), Some(3));\n        assert!(!v.is_prerelease());\n    }\n","numLines":30,"startLine":424,"totalLines":704}},"sourceToolAssistantUUID":"3bf7ac04-27de-4e63-ba92-82fe73bc320c","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"fix/npm-space-ranges","slug":"lexical-jingling-puppy"}
