","-/// commas. `None` for a clause that is a single comparator or a hyphen range, which are left as they are.","+/// commas. A hyphen range of two full versions (`1.0.0 - 2.0.0`) is the pair `>=1.0.0, <=2.0.0`. `None` for a clause","+/// that is a single comparator, or a hyphen range with a partial version, whose upper bound npm rounds up."," fn npm_comparators(clause: &str) -> Option<String> {","     let mut comparators: Vec<String> = Vec::new();","     let mut operator = String::new();","-    for token in clause.split_whitespace() {","+    let tokens: Vec<&str> = clause.split_whitespace().collect();","+    if let [low, \"-\", high] = tokens.as_slice() {","+        let full = |version: &str| Version::parse(version, VersionGrammar::SemVer).is_ok();","+        return (full(low) && full(high)).then(|| format!(\">={low}, <={high}\"));","+    }","+    for token in tokens {","         if token == \"-\" {","             return None;","         }"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"65d85942-ac18-4113-baa3-2f26d9aa7143","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"fix/npm-space-ranges","slug":"lexical-jingling-puppy"}
