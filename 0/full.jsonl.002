{"parentUuid":"fdb4ce17-2340-4fa8-b48a-a50fca771706","isSidechain":false,"promptId":"a1fe58f8-dc01-43a8-a00c-e2f78060ffdd","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011xrhQG7cwE8jfHaBANPfMz","type":"tool_result","content":"//! The commit that set a package's version, so a rerun after a half-finished release cannot tag later code.\n\nuse std::cell::RefCell;\nuse std::collections::BTreeSet;\n\nuse callisto_manifests::{read_effective_version, WorkspaceReads};\nuse callisto_model::vcs::{GitAccess, VcsError};\nuse callisto_model::{ManifestDecl, ManifestError, ReleaseDecisionV1, ReleasePackageId, Version};\n\nuse crate::changed::package_paths;\nuse crate::{DependencyResolver, GraphError, Workspace};\n\n/// A package whose files differ from the commit that set the version it is about to release, or whose version\n/// commit could not be found.\npub(super) struct MovedPast {\n    pub package: ReleasePackageId,\n    pub version: String,\n    /// `None` when no commit on the first-parent history sets this version.\n    pub version_commit: Option<String>,\n}","is_error":false}]},"uuid":"eedde485-bb5a-42c6-ad94-6d28c419cfc4","timestamp":"2026-10-25T00:32:17.165Z","toolUseResult":{"stdout":"//! The commit that set a package's version, so a rerun after a half-finished release cannot tag later code.\n\nuse std::cell::RefCell;\nuse std::collections::BTreeSet;\n\nuse callisto_manifests::{read_effective_version, WorkspaceReads};\nuse callisto_model::vcs::{GitAccess, VcsError};\nuse callisto_model::{ManifestDecl, ManifestError, ReleaseDecisionV1, ReleasePackageId, Version};\n\nuse crate::changed::package_paths;\nuse crate::{DependencyResolver, GraphError, Workspace};\n\n/// A package whose files differ from the commit that set the version it is about to release, or whose version\n/// commit could not be found.\npub(super) struct MovedPast {\n    pub package: ReleasePackageId,\n    pub version: String,\n    /// `None` when no commit on the first-parent his