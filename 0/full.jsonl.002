{"parentUuid":"e0034cd6-deee-40e0-8ea6-3f07055fcbab","isSidechain":false,"promptId":"fdaba07c-479e-42b3-b532-6f24a7e8d57d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011Wt3M4naWp43RjpGdpxkkq","type":"tool_result","content":"The file /Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/docs/specs/versioning.json has been updated successfully."}]},"uuid":"b36311b4-7de3-4054-bc31-a56aa74be2fc","timestamp":"2026-10-24T06:17:48.301Z","toolUseResult":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/docs/specs/versioning.json","oldString":"Outside pre mode, `version` refreshes affected lockfiles and stages written manifests, changelogs, `pre.json` changes and existing lockfiles before consuming release inputs.","newString":"`version` refreshes affected lockfiles and stages written manifests, changelogs, `pre.json` changes and existing lockfiles before consuming release inputs; in pre mode it consumes no changesets.","originalFile":null,"structuredPatch":[{"oldStart":255,"oldLines":7,"newStart":255,"newLines":7,"lines":["     },","     {","       \"id\": \"VER-APPLY-08\",","-      \"criterion\": \"Outside pre mode, `version` refreshes affected lockfiles and stages written manifests, changelogs, `pre.json` changes and existing lockfiles before consuming release inputs. It stages consumed changeset and `pre.json` deletions via `git rm --cached --ignore-unmatch` before unlinking those files from disk. If refresh, generated-state staging or input-deletion staging fails, changesets and pre-state deletion inputs remain on disk for retry.\"","+      \"criterion\": \"`version` refreshes affected lockfiles and stages written manifests, changelogs, `pre.json` changes and existing lockfiles before consuming release inputs; in pre mode it consumes no changesets. It stages consumed changeset and `pre.json` deletions via `git rm --cached --ignore-unmatch` before unlinking those files from disk. If refresh, generated-state staging or input-deletion staging fails, changesets and pre-state deletion inputs remain on disk for retry.\"","     },","     {","       \"id\": \"VER-APPLY-09\","]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"e0034cd6-deee-40e0-8ea6-3f07055fcbab","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"docs/spec-drift","slug":"lexical-jingling-puppy"}
