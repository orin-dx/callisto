ified form to write, and `status` reports it as an error diagnostic. `callisto add --package` and `callisto matrix --package` reject any bare name with E317 and a qualified name no package has with E102. A changeset entry naming a package that does not exist is a warning in `version`, and the changeset is not consumed.\",","       \"is_error_case\": true","     },","     {"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"ede24a76-dda8-4c1d-868c-eae80d371ff5","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"docs/spec-drift","slug":"lexical-jingling-puppy"}
