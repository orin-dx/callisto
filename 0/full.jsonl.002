ize)]\n#[serde(deny_unknown_fields)]\npub struct RawArtifactConfig {\n    pub package: String,\n    pub target: String,\n    #[serde(rename = \"asset-name\")]\n    pub asset_name: String,\n}\n\n#[derive(Clone, Debug, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct RawLegacyReleaseProfile {\n    #[serde(rename = \"forge-repository\")]\n    pub forge_repository: String,\n    /// Accepted so legacy files parse; never read.\n    #[serde(rename = \"registry-routes\")]\n    pub registry_routes: Option<toml::Value>,\n}\n\n/// Deprecated `[init]` table; accepted so older configs still load.\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct RawInitConfig {\n    pub ecosystems: Option<Vec<String>>,\n}\n\n#[derive(Clone, Debug, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct RawChangesetsConfig {\n    /// Workspace-root-relative. Always forward-slash-separated (`/`), never `\\`, regardless\n    /// of the OS this value was authored or is read on — `\\` is a legal filename character\n    /// on POSIX, not a separator, so a backslash-separated value would silently name a\n    /// single oddly-named directory rather than a nested path the moment this file is read\n    /// on a non-Windows host. Rejected if absolute or containing `..` components\n    /// (`ConfigError::InvalidChangesetsDir`, E116).\n    pub dir: Option<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct RawCascadeConfig {\n    pub mode: Option<String>,\n    #[serde(rename = \"bump-severity\")]\n    pub bump_severity: Option<String>,\n    #[serde(rename = \"peer-escalation\")]\n    pub peer_escalation: Option<bool>,","numLines":80,"startLine":10,"totalLines":163}},"sourceToolAssistantUUID":"c8829328-1ce0-46cf-a110-1b8b4bd301d1","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypo