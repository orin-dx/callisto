_stop_the_plan() {\n        let (dir, _) = fixture();\n        let runner = DeadRegistry {\n            lookups: std::sync::atomic::AtomicUsize::new(0),\n        };\n        let preview = plan_local_release(\n            dir.path(),\n            &crate::IgnoreWalkLocator::new(dir.path()),\n            &runner,\n            &[],\n            LocalReleaseSource::Preview,\n        )\n        .unwrap();\n        assert!(preview.is_some());\n        assert_eq!(runner.lookups.load(std::sync::atomic::Ordering::Relaxed), 2);\n    }\n\n    fn fixture_id() -> ReleasePackageId {"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01Q4EqGrawyc4r3fih1dwZuC","name":"Bash","input":{"command":"cd /Users/gabe/Projects/callisto/.claude/worktrees/smoke-main && cargo test -p callisto-graph --lib an_unreachable_registry 2>&1 | grep -E \"^error|panicked|left|right|test result\" -A3 | head -12","description":"Run the patience test","dangerouslyDisableSandbox":true,"timeout":600000},"caller":{"type":"direct"}}]}}
