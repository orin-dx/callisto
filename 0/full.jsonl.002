mmit.to_string(), path.to_string())) {\n1213\t                    Some(content) => {\n1214\t                        stdout.push_str(&format!(\"{} blob {}\\n{}\\n\", \"0\".repeat(40), content.len(), content));\n1215\t                    }\n1216\t                    None => {\n1217\t                        stdout.push_str(&format!(\"{object} missing\\n\"));\n1218\t                    }\n1219\t                }\n1220\t            }\n1221\t            Ok(callisto_model::CommandOutput {\n1222\t                exit_code: Some(0),\n1223\t                stdout,\n1224\t                stderr: String::new(),\n1225\t            })\n1226\t        }\n1227\t    }\n1228\t\n1229\t    /// Builds a `Workspace` wired to `runner` and `packages`, matching the\n1230\t    /// fixture every `derive_release_commit_decision` test in this module\n1231\t    /// shares.\n1232\t    fn fixture_workspace<'a>(\n1233\t        runner: &'a CountingBatchRunner,\n1234\t        packages: Vec<Package>,\n1235\t    ) -> Workspace<'a, CountingBatchRunner, FixedManifestGraph> {\n1236\t        let config = crate::config::load(std::path::Path::new(\"/nonexistent-test-root\")).unwrap();\n1237\t        let graph = FixedManifestGraph { packages };\n1238\t        Workspace {\n1239\t            root: std::path::PathBuf::from(\"/nonexistent-test-root\"),\n1240\t            config,\n1241\t            graph,\n1242\t            tags: std::cell::OnceCell::new(),\n1243\t            git: std::cell::OnceCell::new(),\n1244\t            runner,\n1245\t            manifest_cache: Default::default(),\n1246\t            identity: crate::IdentityIndex::default(),\n1247\t        }\n1248\t    }\n1249\t\n1250\t    /// AC: for a release commit touching multiple canonical manifests,\n1251\t    /// `derive_release_commit_decision` issues exactly 2 `git cat-file\n1252\t    /// --batch` invocations (one per commit) -- not 2*N separate `git show`\n1253\t    /// spawns, one per manifest per commit, as the pre-fix implementation\n1254\t    /// did.\n1255\t    #[test]\n1256\t    fn derive_release_commit_decision_issues_exactly_two_batch_invocations_for_multiple_manifests() {\n1257\t        let release_commit_sha = \"a\".repeat(40);\n1258\t        let parent_sha = \"b\".repeat(40);\n1259\t\n1260\t        let packages = vec![cargo_package(\"pkg-a\"), cargo_package(\"pkg-b\"), cargo_package(\"pkg-c\")];\n1261\t\n1262\t        let bumps = [\n1263\t            (\"pkg-a\", \"1.0.0\", \"1.1.0\"),\n1264\t            (\"pkg-b\", \"2.0.0\", \"2.1.0\"),\n1265\t            (\"pkg-c\", \"3.0.0\", \"3.1.0\"),\n1266\t        ];\n1267\t\n1268\t        let mut blobs = std::collections::BTreeMap::new();\n1269\t        let mut entries = Vec::new();\n1270\t        for (name, before, after) in bumps {\n1271\t            let path = format!(\"{name}/Cargo.toml\");\n1272\t            blobs.insert((parent_sha.clone(), path.clone()), cargo_manifest_source(name, before));\n1273\t            blobs.insert((release_commit_sha.clone(), path), cargo_manifest_source(name, after));\n1274\t            let target = Version::parse(after, Ecosystem::Cargo.version_grammar()).unwrap();\n1275\t            entries.push(ReleaseDecisionEntry {\n1276\t                package: ReleasePackageId::new(Ecosystem::Cargo, name).unwrap(),\n1277\t                target_version: target,\n1278\t                reasons: vec![ReleaseInclusionReason::Changeset],\n1279\t            });\n1280\t        }\n1281\t        let decision = ReleaseDecisionV1::new(entries).unwrap();\n1282\t        let decision_json = serde_json::to_string(&decision).unwrap();\n1283\t\n1284\t        let name_status = [\n1285\t            \"A\\t.callisto/release-decision.json\".to_string(),\n1286\t            \"D\\t.changeset/multi-pkg-minor.md\".to_string(),\n1287\t            \"M\\tpkg-a/Cargo.toml\".to_string(),\n1288\t            \"M\\tpkg-a/CHANGELOG.md\".to_string(),\n1289\t            \"M\\tpkg-b/Cargo.toml\".to_string(),\n1290\t            \"M\\tpkg-b/CHANGELOG.md\".to_string(),\n1291\t            \"M\\tpkg-c/Cargo.toml\".to_string(),\n1292\t            \"M\\tpkg-c/CHANGELOG.md\".to_string(),\n1293\t        ]\n1294\t        .join(\"\\n\");\n1295\t\n1296\t        let runner = CountingBatchRunner {\n1297\t            release_commit: release_commit_sha.clone(),\n1298\t            parent: parent_sha,\n1299\t            decision_json,\n1300\t            name_status,\n1301\t            blobs,\n1302\t            run_calls: std::sync::Mutex::new(Vec::new()),\n1303\t            batch_calls: std::sync::Mutex::new(0),\n1304\t        };\n1305\t\n1306\t        let workspace = fixture_workspace(&runner, packages);\n1307\t\n1308\t        let release_commit = CommitSha::parse(&release_commit_sha).unwrap();\n1309\t        let decision_path = std::path::Path::new(\".callisto/release-decision.json\");\n1310\t        let result = derive_release_commit_decision(&workspace, &release_commit, decision_path);\n1311\t\n1312\t        assert!(result.is_ok(), \"expected Ok, got {result:?}\");\n1313\t        assert_eq!(\n1314\t            *runner.batch_calls.lock().unwrap(),\n1315\t            2,\n1316\t            \"expected exactly 2 `git cat-file --batch` invocations (one per commit) for 3 \\\n1317\t             canonical manifests, not one per manifest per commit\"\n1318\t        );\n1319\t    }\n1320\t\n1321\t    /// A merged commit whose actual `HEAD` differs from the commit\n1322\t    /// being verified must report `ReleaseCommitVerificationFailed{reason:\n1323\t    /// HeadMismatch}`, naming the *verified* commit -- not the fieldless\n1324\t    /// `ReleaseIntentStale` every other mismatch used to collapse into.\n1325\t    #[test]\n1326\t    fn derive_release_commit_decision_reports_head_mismatch_distinctly() {\n1327\t        let actual_head = \"a\".repeat(40);\n1328\t        let claimed_commit = \"c\".repeat(40);\n1329\t"}]},"uuid":"fee1a8aa-d91b-47d5-96d2-1058782e0d9b","timestamp":"2026-10-24T18:48:22.460Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release_decision.rs","content":"            }\n            if args.first().copied() == Some(\"rev-parse\") && args.get(1).copied() == Some(rev_parse_parent.as_str()) {\n                return ok(self.parent.clone());\n            }\n            if args.first().copied() == Some(\"diff-tree\") {\n                return ok(self.name_status.clone());\n            }\n            if args.first().copied() == Some(\"show\") && args.get(1).copied() == Some(decision_object.as_str()) {\n                return ok(self.decision_json.clone());\n            }\n            panic!(\"unexpected `{program} {args:?}` in CountingBatchRunner::run\");\n        }\n\n        fn run_with_stdin(\n            &self,\n            program: &str,\n            args: &[&str],\n            _cwd: &std::path::Path,\n            stdin: &[u8],\n        ) -> Result<callisto_model::CommandOutput, callisto_model::CommandError> {\n            self.run_calls\n                .lock()\n                .unwrap()\n                .push((program.to_string(), args.iter().map(|s| s.to_string()).collect()));\n            assert_eq!(program, \"git\");\n            assert_eq!(args, [\"cat-file\", \"--batch\"]);\n            *self.batch_calls.lock().unwrap() += 1;\n\n            let requested = std::str::from_utf8(stdin).expect(\"test stdin is always valid UTF-8\");\n            let mut stdout = String::new();\n            for object in requested.lines() {\n                let (commit, path) = object.split_once(':').expect(\"object identifier must be commit:path\");\n                match self.blobs.get(&(commit.to_string(), path.to_string())) {\n                    Some(content) => {\n                        stdout.push_str(&format!(\"{} blob {}\\n{}\\n\", \"0\".repeat(40), content.len(), content));\n                    }\n                    None => {\n                        stdout.push_str(&format!(\"{object} missing\\n\"));\n                    }\n                }\n            }\n            Ok(callisto_model::CommandOutput {\n                exit_code: Some(0),\n                stdout,\n                stderr: String::new(),\n            })\n        }\n    }\n\n    /// Builds a `Workspace` wired to `runner` and `packages`, matching the\n    /// fixture every `derive_release_commit_decision` test in this module\n    /// shares.\n    fn fixture_workspace<'a>(\n        runner: &'a CountingBatchRunner,\n        packages: Vec<Package>,\n    ) -> Workspace<'a, CountingBatchRunner, FixedManifestGraph> {\n        let config = crate::config::load(std::path::Path::new(\"/nonexistent-test-root\")).unwrap();\n        let graph = FixedManifestGraph { packages };\n        Workspace {\n            root: std::path::PathBuf::from(\"/nonexistent-test-root\"),\n            config,\n            graph,\n            tags: std::cell::OnceCell::new(),\n            git: std::cell::OnceCell::new(),\n            runner,\n            manifest_cache: Default::default(),\n            identity: crate::IdentityIndex::default(),\n        }\n    }\n\n    /// AC: for a release commit touching multiple canonical manifests,\n    /// `derive_release_commit_decision` issues exactly 2 `git cat-file\n    /// --batch` invocations (one per commit) -- not 2*N separate `git show`\n    /// spawns, one per manifest per commit, as the pre-fix implementation\n    /// did.\n    #[test]\n    fn derive_release_commit_decision_issues_exactly_two_batch_invocations_for_multiple_manifests() {\n        let release_commit_sha = \"a\".repeat(40);\n        let parent_sha = \"b\".repeat(40);\n\n        let packages = vec![cargo_package(\"pkg-a\"), cargo_package(\"pkg-b\"), cargo_package(\"pkg-c\")];\n\n        let bumps = [\n            (\"pkg-a\", \"1.0.0\", \"1.1.0\"),\n            (\"pkg-b\", \"2.0.0\", \"2.1.0\"),\n            (\"pkg-c\", \"3.0.0\", \"3.1.0\"),\n        ];\n\n        let mut blobs = std::collections::BTreeMap::new();\n        let mut entries = Vec::new();\n        for (name, before, after) in bumps {\n            let path = format!(\"{name}/Cargo.toml\");\n            blobs.insert((parent_sha.clone(), path.clone()), cargo_manifest_source(name, before));\n            blobs.insert((release_commit_sha.clone(), path), cargo_manifest_source(name, after));\n            let target = Version::parse(after, Ecosystem::Cargo.version_grammar()).unwrap();\n            entries.push(ReleaseDecisionEntry {\n                package: ReleasePackageId::new(Ecosystem::Cargo, name).unwrap(),\n                target_version: target,\n                reasons: vec![ReleaseInclusionReason::Changeset],\n            });\n        }\n        let decision = ReleaseDecisionV1::new(entries).unwrap();\n        let decision_json = serde_json::to_string(&decision).unwrap();\n\n        let name_status = [\n            \"A\\t.callisto/release-decision.json\".to_string(),\n            \"D\\t.changeset/multi-pkg-minor.md\".to_string(),\n            \"M\\tpkg-a/Cargo.toml\".to_string(),\n            \"M\\tpkg-a/CHANGELOG.md\".to_string(),\n            \"M\\tpkg-b/Cargo.toml\".to_string(),\n            \"M\\tpkg-b/CHANGELOG.md\".to_string(),\n            \"M\\tpkg-c/Cargo.toml\".to_string(),\n            \"M\\tpkg-c/CHANGELOG.md\".to_string(),\n        ]\n        .join(\"\\n\");\n\n        let runner = CountingBatchRunner {\n            release_commit: release_commit_sha.clone(),\n            parent: parent_sha,\n            decision_json,\n            name_status,\n            blobs,\n            run_calls: std::sync::Mutex::new(Vec::new()),\n            batch_calls: std::sync::Mutex::new(0),\n        };\n\n        let workspace = fixture_workspace(&runner, packages);\n\n        let release_commit = CommitSha::parse(&release_commit_sha).unwrap();\n        let decision_path = std::path::Path::new(\".callisto/release-decision.json\");\n        let result = derive_release_commit_decision(&workspace, &release_commit, decision_path);\n\n        assert!(result.is_ok(), \"expected Ok, got {result:?}\");\n        assert_eq!(\n            *runner.batch_calls.lock().unwrap(),\n            2,\n            \"expected exactly 2 `git cat-file --batch` invocations (one per commit) for 3 \\\n             canonical manifests, not one per manifest per commit\"\n        );\n    }\n\n    /// A merged commit whose actual `HEAD` differs from the commit\n    /// being verified must report `ReleaseCommitVerificationFailed{reason:\n    /// HeadMismatch}`, naming the *verified* commit -- not the fieldless\n    /// `ReleaseIntentStale` every other mismatch used to collapse into.\n    #[test]\n    fn derive_release_commit_decision_reports_head_mismatch_distinctly() {\n        let actual_head = \"a\".repeat(40);\n        let claimed_commit = \"c\".repeat(40);\n","numLines":150,"startLine":1180,"totalLines":1690}},"sourceToolAssistantUUID":"eefe9d52-859b-4211-84f4-6b79f3364059","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/release-commit-allowlist","slug":"lexical-jingling-puppy"}
