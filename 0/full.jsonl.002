{"parentUuid":"80c474e5-81bd-4de5-9d10-de1aa2d62027","isSidechain":false,"promptId":"a1fe58f8-dc01-43a8-a00c-e2f78060ffdd","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ha5zBUwH1YBXXeMaPssAAy","type":"tool_result","content":"21-\n22-/// The selected packages that differ from the commit that set their release version, or whose version commit is\n23-/// unknown. `resumable` packages are tagged on HEAD already.\n24-///\n25-/// A package is compared by tree content, so a revert or a change made only inside a merge commit counts the same as\n26-/// a plain commit. The caller refuses only the ones whose version the registry already holds.\n27:pub(super) fn packages_moved_past_their_version<R: callisto_model::CommandRunner, D: DependencyResolver>(\n28-    workspace: &Workspace<'_, R, D>,\n29-    decision: &ReleaseDecisionV1,\n30-    resumable: &BTreeSet<ReleasePackageId>,\n31-) -> Result<Vec<MovedPast>, GraphError> {\n32-    let git = workspace.git_access();\n33-    let mut moved = Vec::new();\n34-    for package in workspace.graph.packages() {\n35-        let ids = crate::commands::release_decision::release_package_ids(&workspace.identity, package)?;\n36-        let Some(entry) = decision\n37-            .entries\n38-            .iter()\n39-            .find(|entry| ids.contains(&entry.package) && !resumable.contains(&entry.package))\n40-        else {\n41-            continue;\n42-        };\n43-        let Some(manifest) = package.canonical_manifests().next() else {\n44-            continue;\n45-        };\n46-        // A manifest that is not committed has no history to compare; the clean-tree rule covers it.\n47-        let Some(head) = effective_version_at(git, \"HEAD\", manifest)? else {\n48-            continue;\n49-        };\n50-        let version_commit = commit_setting_version(git, manifest, &head, &entry.target_version)?;\n51-        let unchanged = match &version_commit {\n52-            Some(commit) => git.same_content_at(commit, \"HEAD\", &package_paths(package))?,\n53-            None => false,\n54-        };\n55-        if !unchanged {\n56-            moved.push(MovedPast {\n57-                package: entry.package.clone(),\n58-                version: entry.target_version.render().to_owned(),\n59-                version_commit,\n60-            });\n61-        }\n62-    }\n63-    Ok(moved)\n64-}\n65-\n66-/// The newest first-parent commit whose manifest holds `version` while its parent's does not.\n67-///\n68-/// Only the manifest and, for an inherited version, the workspace manifest that declares it can set the version, so\n69-/// those are the only paths walked. A history with no such commit gives `None`, never a guess.\n70-fn commit_setting_version(\n71-    git: &GitAccess<'_>,\n72-    manifest: &ManifestDecl,\n73-    head: &callisto_manifests::EffectiveManifestVersion,\n74-    version: &Version,\n75-) -> Result<Option<String>, GraphError> {\n76-    let mut paths = vec![manifest.path.clone()];\n77-    if head.authority != manifest.path {\n78-        paths.push(head.authority.clone());\n79-    }\n80-    for commit in git.first_parent_commits_touching(&paths)? {\n81-        if effective_version_at(git, &commit, manifest)?\n82-            .map(|found| found.version)\n83-            .as_ref()\n84-            != Some(version)\n85-        {\n86-            continue;\n87-        }\n88-        // A root commit has no parent, so the version was set there.\n89-        let parent = effective_version_at(git, &format!(\"{commit}^\"), manifest)?;\n90-        if parent.map(|found| found.version).as_ref() != Some(version) {\n91-            return Ok(Some(commit));\n92-        }\n93-    }\n94-    Ok(None)\n95-}\n96-\n97-/// The version `manifest` holds at `rev`, resolving a workspace-inherited one. A manifest that is absent, does not\n98-/// parse or declares no version there gives `None`; a failing git read is an error.\n99-fn effective_version_at(\n100-    git: &GitAccess<'_>,\n101-    rev: &str,\n102-    manifest: &ManifestDecl,","is_error":false}]},"uuid":"ff5328e9-61cb-45a0-b406-2d91bfc5f612","timestamp":"2026-10-25T00:32:00.604Z","toolUseResult":{"stdout":"21-\n22-/// The selected packages that differ from the commit that set their release version, or whose version commit is\n23-/// unknown. `resumable` packages are tagged on HEAD already.\n24-///\n25-/// A package is compared by tree content, so a revert or a change made only inside a merge commit counts the same as\n26-/// a plain commit. The caller refuses only the ones whose version the registry already holds.\n27:pub(super) fn packages_moved_past_their_version<R: callisto_model::CommandRunner, D: DependencyResolver>(\n28-    workspace: &Workspace<'_, R, D>,\n29-    decision: &ReleaseDecisionV1,\n30-    resumable: &BTreeSet<ReleasePackageId>,\n31-) -> Result<Vec<MovedPast>, GraphError> {\n32-    let git = workspace.git_access();\n33-    let mut moved = Vec::new();\n34-    for package in workspace.graph.packages() {\n35-        let ids = crate::commands::release_decision::release_package_ids(&workspace.identity, package)?;\n36-        let Some(entry) = decision\n37-            .entries\n38-            .iter()\n39-            .find(|entry| ids.contains(&entry.package) && !resumable.contains(&entry.package))\n40-        else {\n41-            continue;\n42-        };\n43-        let Some(manifest) = package.canonical_manifests().next() else {\n44-            continue;\n45-        };\n46-        // A manifest that is not committed has no history to compare; the clean-tree rule covers it.\n47-        let Some(head) = effective_version_at(git, \"HEAD\", manifest)? else {\n48-            continue;\n49-        };\n50-        let version_commit = commit_setting_version(git, manifest, &head, &entry.target_version)?;\n51-        let unchanged = match &version_commit {\n52-            Some(commit) => git.same_content_at(commit, \"HEAD\", &package_paths(package))?,\n53-            None => false,\n54-        };\n55