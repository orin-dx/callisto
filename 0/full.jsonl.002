 or `None` when not publishable). This test pins that\n/// dispatch still produces the same output the deleted override did.\n#[test]\nfn publish_targets_uses_trait_default_dispatch_for_cargo() {\n    let dir = tempdir().unwrap();\n\n    let publishable_path = dir.path().join(\"publishable\").join(\"Cargo.toml\");\n    fs::create_dir_all(publishable_path.parent().unwrap()).unwrap();\n    fs::write(&publishable_path, \"[package]\\nname = \\\"dummy\\\"\\nversion = \\\"0.1.0\\\"\\n\").unwrap();\n    let decl = ManifestDecl::new(\n        \"publishable/Cargo.toml\",\n672:    fn update_dependency_spec(\n673-        &mut self,\n674-        name: &str,\n675-        kind: DepKind,\n676-        at: &DepLocator,\n677-        new: DepSpec,\n678-        permit: &ApplyPermit,\n679-    ) -> Result<(), ManifestError> {\n680-        let not_found = || ManifestError::DependencyNotFound {\n681-            path: self.path.clone(),\n682-            name: name.to_string(),\n683-            kind,\n684-        };","is_error":false}]},"uuid":"bb6171dc-1028-4c32-a0a9-f7a627a840cb","timestamp":"2026-10-25T16:29:27.013Z","toolUseResult":{"stdout":"465:/// `CargoToml::update_dependency_spec`'s own test for why this is a\n581:fn test_cargo_is_publishable() {\n691:        .update_dependency_spec(\n712:fn update_dependency_spec_errors_on_unrecognized_value_shape_instead_of_silently_no_opping() {\n731:    let result = manifest.update_dependency_spec(\n752:fn update_dependency_spec_errors_on_array_of_tables_dependency_shape() {\n772:    let result = manifest.update_dependency_spec(\n787:fn update_dependency_spec_does_not_touch_disk_until_persist_called() {\n807:        .update_dependency_spec(\n819:        \"update_dependency_spec alone must not write to disk\"\n    let updated = fs::read_to_string(&manifest_path).unwrap();\n    assert!(updated.contains(\"\\tversion = \\\"1.0.1\\\"\"));\n    assert!(updated.contains(\"\\tname = \\\"tabbed-crate\\\"\"));\n}\n\n#[test]\nfn test_cargo_is_publishable()