{"parentUuid":"938d59a1-666b-4a0a-a07c-534406dd2146","isSidechain":false,"promptId":"949bc951-5bef-4b5d-830c-9fdf26037a79","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D7wWqN8gaHLEKVh2H56eau","type":"tool_result","content":"196\t    #[test]\n197\t    fn prepend_does_not_displace_header_in_crlf_changelog() {\n198\t        let workspace = tempfile::tempdir().unwrap();\n199\t        let root = workspace.path();\n200\t        let changelog_path = std::path::Path::new(\"CHANGELOG.md\");\n201\t        let full_path = root.join(changelog_path);\n202\t\n203\t        // Write an existing CRLF changelog.\n204\t        let existing_crlf = \"# My Package\\r\\n\\r\\n## 1.0.0\\r\\n\\r\\nSome content\\r\\n\";\n205\t        fs::write(&full_path, existing_crlf).unwrap();\n206\t\n207\t        prepend(root, changelog_path, \"My Package\", \"## 1.1.0\\n\\nNew stuff\\n\", &permit())\n208\t            .expect(\"prepend should succeed on a CRLF changelog\");\n209\t\n210\t        let result = fs::read_to_string(&full_path).unwrap();\n211\t\n212\t        // The header must remain the very first thing in the file.\n213\t        assert!(\n214\t            result.starts_with(\"# My Package\"),\n215\t            \"header was displaced — got:\\n{result}\"\n216\t        );\n217\t\n218\t        // The new section must appear before the old section.\n219\t        let pos_new = result.find(\"1.1.0\").expect(\"new version missing\");\n220\t        let pos_old = result.find(\"1.0.0\").expect(\"old version missing\");\n221\t        assert!(pos_new < pos_old, \"new entry should precede old entry — got:\\n{result}\");\n222\t    }\n223\t\n224\t    #[test]\n225\t    fn prepend_else_branch_inserts_h1_header_before_new_entry_when_display_name_mismatches() {"}]},"uuid":"caf6b66b-2778-404e-97b4-c2076992ef12","timestamp":"2026-10-24T22:59:44.358Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/changelog/write.rs","content":"    #[test]\n    fn prepend_does_not_displace_header_in_crlf_changelog() {\n        let workspace = tempfile::tempdir().unwrap();\n        let root = workspace.path();\n        let changelog_path = std::path::Path::new(\"CHANGELOG.md\");\n        let full_path = root.join(changelog_path);\n\n        // Write an existing CRLF changelog.\n        let existing_crlf = \"# My Package\\r\\n\\r\\n## 1.0.0\\r\\n\\r\\nSome content\\r\\n\";\n        fs::write(&full_path, existing_crlf).unwrap();\n\n        prepend(root, changelog_path, \"My Package\", \"## 1.1.0\\n\\nNew stuff\\n\", &permit())\n            .expect(\"prepend should succeed on a CRLF changelog\");\n\n        let result = fs::read_to_string(&full_path).unwrap();\n\n        // The header must remain the very first thing in the file.\n        assert!(\n            result.starts_with(\"# My Package\"),\n            \"header was displaced — got:\\n{result}\"\n        );\n\n        // The new section must appear before the old section.\n        let pos_new = result.find(\"1.1.0\").expect(\"new version missing\");\n        let pos_old = result.find(\"1.0.0\").expect(\"old version missing\");\n        assert!(pos_new < pos_old, \"new entry should precede old entry — got:\\n{result}\");\n    }\n\n    #[test]\n    fn prepend_else_branch_inserts_h1_header_before_new_entry_when_display_name_mismatches() {","numLines":30,"startLine":196,"totalLines":360}},"sourceToolAssistantUUID":"938d59a1-666b-4a0a-a07c-534406dd2146","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"fix/release-pr-stage-only","slug":"lexical-jingling-puppy"}
