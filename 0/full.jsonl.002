ke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/taken-name-first-release","slug":"lexical-jingling-puppy"}
{"parentUuid":"9fab6789-f422-4e0b-b499-0c528e921034","isSidechain":false,"promptId":"81e97b21-5b87-4de1-93b0-c0727fa54480","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017rnJdCtKCTj8xCkyhGDwH8","type":"tool_result","content":"pub fn plan_workspace_release<R: CommandRunner, D: DependencyResolver>(\n    workspace: &Workspace<'_, R, D>,\n    selections: &[ReleasePackageId],\n    mode: LocalReleaseSource,\n) -> Result<Option<LocalReleasePlan>, GraphError> {\n    let resumable = incomplete_tagged_releases(workspace, mode)?;\n    let Some(decision) = crate::commands::release_decision::derive_release_roster(workspace, selections, &resumable)?\n    else {\n        return Ok(None);\n    };\n    let profile = ExecutionTrustProfileV1::GitCommit;\n    let source = match mode {\n        LocalReleaseSource::Preview => SourceIdentity::GitCommit {\n            sha: workspace.git_access().head_sha()?,\n        },\n        LocalReleaseSource::Trusted => observe_source(workspace, profile, ReleaseCheckout::AnyHead)?,\n    };\n    refuse_a_published_version_left_behind(workspace, &decision, &resumable, &source, profile, mode)?;\n    // A local run is its own orchestration: slots bind to the source commit.\n    let artifact_policy = match (&workspace.config.product_release, &source) {\n        (Some(release), SourceIdentity::GitCommit { sha }) if !release.artifacts.is_empty() => {\n            release.forge_repository.clone().map(|repository| ArtifactBuildPolicy {\n                repository,\n                workflow_path: callisto_model::RELEASE_COORDINATOR_WORKFLOW_PATH.to_owned(),\n                workflow_commit: sha.clone(),\n            })\n        }\n        _ => None,\n    };\n    let remote = match mode {\n        LocalReleaseSource::Preview => GitRemoteRequirement::OptionalForPreview,\n        LocalReleaseSource::Trusted => GitRemoteRequirement::Required,\n    };\n    let mut diagnostics = Vec::new();\n    let intent = derive_release_intent(\n        workspace,\n        &decision,\n        source.clone(),\n        profile,\n        artifact_policy.as_ref(),\n        remote,\n        &mut diagnostics,\n    )?;\n    let tags_unbound = mode == LocalReleaseSource::Preview\n        && intent\n            .operations\n            .iter()\n            .any(|operation| operation.id().role == callisto_model::ReleaseOperationRole::Tag)\n        && optional_git_remote(&workspace.root, workspace.runner)?.is_none();\n    if mode == LocalReleaseSource::Trusted && observe_source(workspace, profile, ReleaseCheckout::AnyHead)? != source {\n        return Err(GraphError::ReleaseIntentStale {\n            reason: StaleReason::source_identity_changed(),\n        });\n    }\n    Ok(Some(LocalReleasePlan {\n        intent,\n        tags_unbound,\n        diagnostics,\n    }))\n}\n\n#[cfg(test)]\nmod tests {\n    use std::path::Path;\n\n    use callisto_model::{Ecosystem, ReleaseInclusionReason, ReleasePackageId};\n\n    use super::*;\n    use crate::commands::release::tests::{fixture, RealGitRunner};\n    use crate::error::{ReleasePreconditionRequirement, ReleaseSelectionInvalidReason};","is_error":false}]},"uuid":"cec6f030-9b21-46e2-9c77-322f06427ece","timestamp":"2026-10-24T18:57:58.261Z","toolUseResult":{"stdout":"pub fn plan_workspace_release<R: CommandRunner, D: DependencyResolver>(\n    workspace: &Workspace<'_, R, D>,\n    selections: &[ReleasePackageId],\n    mode: LocalReleaseSource,\n) -> Result<Option<LocalReleasePlan>, GraphError> {\n    let resumable = incomplete_tagged_releases(workspace, mode)?;\n    let Some(decision) = crate::commands::release_decision::derive_release_roster(workspace, selections, &resumable)?\n    else {\n        return Ok(None);\n    };\n    let profile = ExecutionTrustProfileV1::GitCommit;\n    let source = match mode {\n        LocalReleaseSource::Preview => SourceIdentity::GitCommit {\n            sha: workspace.git_access().head_sha()?,\n        },\n        LocalReleaseSource::Trusted => observe_source(workspace, profile, ReleaseCheckout::AnyHead)?,\n    };\n    refuse_a_published_version_left_behind(workspace, &decision, &resumable, &source, profile, mode)?;\n    // A local run is its own orchestration: slots bind to the source commit.\n    let artifact_policy = match (&workspace.config.product_release, &source) {\n        (Some(release), SourceIdentity::GitCommit { sha }) if !release.artifacts.is_empty() => {\n            release.forge_repository.clone().map(|repository| ArtifactBuildPolicy {\n                repository,\n                workflow_path: callisto_model::RELEASE_COORDINATOR_WORKFLOW_PATH.to_owned(),\n                workflow_commit: sha.clone(),\n            })\n        }\n        _ => None,\n    };\n    let remote = match mode {\n        LocalReleaseSource::Preview => GitRemoteRequirement::OptionalForPreview,\n        LocalReleaseSource::Trusted => GitRemoteRequirement::Required,\n    };\n    let mut diagnostics = Vec::new();\n    let intent = derive_release_intent(\n        workspace,\n        &decision,\n        source.clone(),\n        profile,\n        artifact_policy.as_ref(),\n        remote,\n        &mut diagnostics,\n    )?;\n    let tags_unbound = mode == LocalReleaseSource::Preview\n        && intent\n            .operations\n            .iter()\n            .any(|operation| operation.id().role == callisto_model::ReleaseOperationRole::Tag)\n        && optional_git_remote(&workspace.root, workspace.runner)?.is_none();\n    if mode == LocalReleaseSource::Trusted && observe_source(workspace, profile, ReleaseCheckout::AnyHead)? != source {\n        return Err(GraphError::ReleaseIntentStale {\n            reason: StaleReason::source_identity_changed(),\n        });\n    }\n    Ok(Some(LocalReleasePlan {\n        intent,\n        tags_unbound,\n        diagnostics,\n    }))\n}\n\n#[cfg(test)]\nmod tests {\n    use std::path::Path;\n\n    use callisto_model::{Ecosystem, ReleaseInclusionReason, ReleasePackageId};\n\n    use super::*;\n    use crate::commands::release::tests::{fixture, RealGitRunner};\n    use crate::error::{ReleasePreconditionRequirement, ReleaseSelectionInvalidReason};","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"98be5a21-00b7-431e-be7a-c1d0fbc7cf16","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","root":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","branch":"fix/taken-name-first-release","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callisto","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","platform":"macos"}},"sourceToolAssistantUUID":"9fab6789-f422-4e0b-b499-0c528e921034","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/taken-name-first-release","slug":"lexical-jingling-puppy"}
