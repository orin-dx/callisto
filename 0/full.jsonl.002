about who owns the name.\npub(crate) fn differing_repositories(registry_repository: Option<&str>, origin: &str) -> Option<(String, String)> {\n    let registry = repository_identity(registry_repository?)?;\n    let ours = repository_identity(origin)?;\n    (registry != ours).then_some((registry, ours))\n}\n\n/// The warning for adopting a published version whose registry entry names another repository, if it does.\npub(crate) fn foreign_repository_warning(\n    package: &str,\n    version: &str,\n    registry_repository: Option<&str>,\n    origin: &str,\n) -> Option<String> {\n    differing_repositories(registry_repository, origin).map(|(registry, ours)| {\n        format!("}},"serverClassifierRequest":"eaffc2df-2056-46ca-b5f6-6952d94d79e3","apiBlockIndex":1,"requestId":"req_011CgMaF8x93cRdscureq4y1","requestRef":"37d60302-7023-4293-8d12-6d908152b122","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"bec21990-b0fb-47da-9310-295f3b49b56a","timestamp":"2026-10-24T18:57:47.449Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/taken-name-first-release","slug":"lexical-jingling-puppy"}
