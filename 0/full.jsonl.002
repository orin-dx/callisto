{"parentUuid":"e8fb4182-d29b-4a4b-bc9f-79af9369153e","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Edit","toolUseID":"toolu_012X8AdQKQfCqerrhHWZKee4","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"15c732d1-457b-4efc-91e5-664943f21b1c\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main\\\",\\\"project\\\":\\\"smoke-main\\\",\\\"tool_name\\\":\\\"Edit\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":42},"type":"attachment","uuid":"73fb6b92-687f-4016-a04d-e44e97fc7a2c","timestamp":"2026-10-24T18:58:31.031Z","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/taken-name-first-release","slug":"lexical-jingling-puppy"}
{"parentUuid":"e5ba4c72-3ab8-4d30-97f0-2a92805223bb","isSidechain":false,"promptId":"81e97b21-5b87-4de1-93b0-c0727fa54480","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SPyTczdeQEdhgkkyy9TCxy","type":"tool_result","content":"The file /Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release/local.rs has been updated successfully."}]},"uuid":"b42096e2-3072-45f0-87b4-c7eeffd98478","timestamp":"2026-10-24T18:58:31.104Z","toolUseResult":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release/local.rs","oldString":"/// Refuses to tag a version the registry already holds while its package has moved on since the commit that set it.","newString":"/// Refuses a first release whose name another project already owns.\n///\n/// A package this repository has never tagged has no history here, so a version of it that the registry already holds\n/// under a different repository is that project's, not ours; adopting it would tag this commit as their release.\n/// A package that has a tag is left alone: its published versions are its own history.\nfn refuse_a_name_another_project_owns<R: CommandRunner, D: DependencyResolver>(\n    workspace: &Workspace<'_, R, D>,\n    decision: &callisto_model::ReleaseDecisionV1,\n    source: &SourceIdentity,\n    profile: ExecutionTrustProfileV1,\n    mode: LocalReleaseSource,\n) -> Result<(), GraphError> {\n    let tags = workspace.tags()?;\n    let first_releases: std::collections::BTreeSet<ReleasePackageId> = decision\n        .entries\n        .iter()\n        .filter(|entry| {\n            crate::commands::release_decision::workspace_package(workspace, &entry.package)\n                .is_some_and(|package| tags.last_tag(&package.id).is_none())\n        })\n        .map(|entry| entry.package.clone())\n        .collect();\n    // Without an `origin` push URL a preview cannot tell whose repository the registry names.\n    if first_releases.is_empty()\n        || (mode == LocalReleaseSource::Preview && optional_git_remote(&workspace.root, workspace.runner)?.is_none())\n    {\n        return Ok(());\n    }\n    let (_, prepared) =\n        derive_release_intent_with_prepared(workspace, decision, source.clone(), profile, None, &mut Vec::new())?;\n    match names_taken_by_other_projects(&workspace.root, workspace.runner, &prepared, &first_releases)?\n        .into_iter()\n        .next()\n    {\n        Some(taken) => Err(GraphError::ReleaseNameTaken {\n            package: taken.package.to_string(),\n            version: taken.version,\n            registry_repository: taken.registry_repository,\n            origin: taken.origin,\n        }),\n        None => Ok(()),\n    }\n}\n\n/// Refuses to tag a version the registry already holds while its package has moved on since the commit that set it.","originalFile":null,"structuredPatch":[{"oldStart":139,"oldLines":6,"newStart":139,"newLines":50,"lines":["     ))"," }"," ","+/// Refuses a first release whose name another project already owns.","+///","+/// A package this repository has never tagged has no history here, so a version of it that the registry already holds","+/// under a different repository is that project's, not ours; adopting it would tag this commit as their release.","+/// A package that has a tag is left alone: its published versions are its own history.","+fn refuse_a_name_another_project_owns<R: CommandRunner, D: DependencyResolver>(","+    workspace: &Workspace<'_, R, D>,","+    decision: &callisto_model::ReleaseDecisionV1,","+    source: &SourceIdentity,","+    profile: ExecutionTrustProfileV1,","+    mode: LocalReleaseSource,","+) -> Result<(), GraphError> {","+    let tags = workspace.tags()?;","+    let first_releases: std::collections::BTreeSet<ReleasePackageId> = decision","+        .entries","+        .iter()","+        .filter(|entry| {","+            crate::commands::release_decision::workspace_package(workspace, &entry.package)","+                .is_some_and(|package| tags.last_tag(&package.id).is_none())","+        })","+        .map(|entry| entry.package.clone())","+        .collect();","+    // Without an `origin` push URL a preview cannot tell whose repository the registry names.","+    if first_releases.is_empty()","+        || (mode == LocalReleaseSource::Preview && optional_git_remote(&workspace.root, workspace.runner)?.is_none())","+    {","+        return Ok(());","+    }","+    let (_, prepared) =","+        derive_release_intent_with_prepared(workspace, decision, source.clone(), profile, None, &mut Vec::new())?;","+    match names_taken_by_other_projects(&workspace.root, workspace.runner, &prepared, &first_releases)?","+        .into_iter()","+        .next()","+    {","+        Some(taken) => Err(GraphError::ReleaseNameTaken {","+            package: taken.package.to_string(),","+            version: taken.version,","+            registry_repository: taken.registry_repository,","+            origin: taken.origin,","+        }),","+        None => Ok(()),","+    }","+}","+"," /// Refuses to tag a version the registry already holds while its package has moved on since the commit that set it."," ///"," /// A release that stopped after publishing leaves exactly this state. A rerun on a later commit would tag code that"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"e5ba4c72-3ab8-4d30-97f0-2a92805223bb","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/taken-name-first-release","slug":"lexical-jingling-puppy"}
