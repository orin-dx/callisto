{"type":"api-request-blob","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","hash":"28e7e014e5312fa044ca2facf33df85712c080ea3af0b57c83f5193269c8c930","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qsf9eAn2Pz9RSjZXks4dNZ","type":"tool_result","content":"10\t    pub release: Option<RawProductReleaseConfig>,\n11\t    pub registries: Option<BTreeMap<String, RawRegistryConfig>>,\n12\t    pub package: Option<Vec<RawPackageConfig>>,\n13\t    #[serde(rename = \"package-set\")]\n14\t    pub package_set: Option<Vec<RawPackageSetConfig>>,\n15\t    #[serde(rename = \"fixed-group\")]\n16\t    pub fixed_group: Option<Vec<crate::config::groups::RawGroup>>,\n17\t    #[serde(rename = \"linked-group\")]\n18\t    pub linked_group: Option<Vec<crate::config::groups::RawGroup>>,\n19\t    /// Deprecated `[init]` bookkeeping from the removed reconcile flow: parsed, never read.\n20\t    pub init: Option<RawInitConfig>,\n21\t}\n22\t\n23\t/// Product binary release declaration. Credentials and provider endpoints are\n24\t/// intentionally excluded: this configuration only identifies immutable\n25\t/// intent slots; execution receives credentials from its caller.\n26\t#[derive(Clone, Debug, Deserialize)]\n27\t#[serde(deny_unknown_fields)]\n28\tpub struct RawProductReleaseConfig {\n29\t    #[serde(rename = \"product-package\")]\n30\t    pub product_package: String,\n31\t    /// Binary artifacts attached to the product's forge release. Each names the\n32\t    /// package that builds it, so an artifact need not come from the product.\n33\t    #[serde(default)]\n34\t    pub artifact: Vec<RawArtifactConfig>,\n35\t    /// The GitHub repository (`owner/repo`) the product release publishes to.\n36\t    #[serde(rename = \"forge-repository\")]\n37\t    pub forge_repository: Option<String>,\n38\t    /// Legacy `[release.profiles]`, read only to migrate `production`.\n39\t    pub profiles: Option<BTreeMap<String, RawLegacyReleaseProfile>>,\n40\t}\n41\t\n42\t/// One declared release artifact. `target` is opaque to Callisto: it is passed\n43\t/// through to whatever builds the bytes, never parsed.\n44\t#[derive(Clone, Debug, Deserialize)]\n45\t#[serde(deny_unknown_fields)]\n46\tpub struct RawArtifactConfig {\n47\t    pub package: String,\n48\t    pub target: String,\n49\t    #[serde(rename = \"asset-name\")]\n50\t    pub asset_name: String,\n51\t}\n52\t\n53\t#[derive(Clone, Debug, Deserialize)]\n54\t#[serde(deny_unknown_fields)]\n55\tpub struct RawLegacyReleaseProfile {\n56\t    #[serde(rename = \"forge-repository\")]\n57\t    pub forge_repository: String,\n58\t    /// Accepted so legacy files parse; never read.\n59\t    #[serde(rename = \"registry-routes\")]\n60\t    pub registry_routes: Option<toml::Value>,\n61\t}\n62\t\n63\t/// Deprecated `[init]` table; accepted so older configs still load.\n64\t#[derive(Clone, Debug, Default, Deserialize)]\n65\t#[serde(deny_unknown_fields)]\n66\tpub struct RawInitConfig {\n67\t    pub ecosystems: Option<Vec<String>>,\n68\t}\n69\t\n70\t#[derive(Clone, Debug, Deserialize)]\n71\t#[serde(deny_unknown_fields)]\n72\tpub struct RawChangesetsConfig {\n73\t    /// Workspace-root-relative. Always forward-slash-separated (`/`), never `\\`, regardless\n74\t    /// of the OS this value was authored or is read on — `\\` is a legal filename character\n75\t    /// on POSIX, not a separator, so a backslash-separated value would silently name a\n76\t    /// single oddly-named directory rather than a nested path the moment this file is read\n77\t    /// on a non-Windows host. Rejected if absolute or containing `..` components\n78\t    /// (`ConfigError::InvalidChangesetsDir`, E116).\n79\t    pub dir: Option<String>,\n80\t}\n81\t\n82\t#[derive(Clone, Debug, Default, Deserialize)]\n83\t#[serde(deny_unknown_fields)]\n84\tpub struct RawCascadeConfig {\n85\t    pub mode: Option<String>,\n86\t    #[serde(rename = \"bump-severity\")]\n87\t    pub bump_severity: Option<String>,\n88\t    #[serde(rename = \"peer-escalation\")]\n89\t    pub peer_escalation: Option<bool>,"},{"tool_use_id":"toolu_01XZ3kcUrniY9EZHH1hsk5xp","type":"tool_result","content":"195\t        artifacts,\n196\t        forge_repository,\n197\t    })\n198\t}\n199\t\n200\t/// `[release].forge-repository`, else the legacy `[release.profiles.production]` one.\n201\tfn resolve_forge_repository(raw: &RawProductReleaseConfig) -> Result<Option<String>, ConfigError> {\n202\t    let mut legacy = None;\n203\t    for (name, profile) in raw.profiles.iter().flatten() {\n204\t        if name != LEGACY_PRODUCTION_PROFILE {\n205\t            return Err(ConfigError::InvalidProductRelease {\n206\t                detail: format!(\n207\t                    \"release profile `{name}` is not supported: only a top-level [release].forge-repository key, or the `production` profile name for migration, is accepted\"\n208\t                ),\n209\t            });\n210\t        }\n211\t        legacy = Some(profile.forge_repository.clone());\n212\t    }\n213\t    match (raw.forge_repository.clone(), legacy) {\n214\t        (Some(current), Some(legacy)) if current != legacy => Err(ConfigError::InvalidProductRelease {\n215\t            detail: format!(\n216\t                \"[release].forge-repository `{current}` conflicts with [release.profiles.production].forge-repository `{legacy}`\"\n217\t            ),\n218\t        }),\n219\t        (current, legacy) => Ok(current.or(legacy)),\n220\t    }\n221\t}\n222\t\n223\tconst LEGACY_PRODUCTION_PROFILE: &str = \"production\";\n224\t\n225\t/// Per-package overrides from a `[[package]]` block in `callisto.toml`.\n226\t///\n227\t/// Every field is `Option<T>` — `None` means \"not specified; use the package's default.\"\n228\t/// Only fields that the user explicitly set in the `[[package]]` block are `Some`.\n229\t#[derive(Clone, Debug)]\n230\tpub struct PackageConfig {\n231\t    pub release_trigger: Option<ReleaseTrigger>,\n232\t    pub publish_to: Option<Vec<PublishTarget>>,\n233\t    pub tag_template: Option<TagTemplate>,\n234\t    /// Consulted for the last tag only after `tag_template` finds none.\n235\t    pub previous_tag_templates: Vec<TagTemplate>,\n236\t    /// Changelog path relative to the package's own root directory.\n237\t    pub changelog: Option<PathBuf>,\n238\t    pub pre_major_inference: Option<PreMajorInferencePolicy>,\n239\t}"}]}}
