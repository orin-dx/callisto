xt.","+    let probe = origin_tag_probe(&workspace).ok().flatten();","+    let (missing, planned) = std::thread::scope(|scope| {","+        let missing = probe.as_ref().map(|probe| scope.spawn(|| probe.missing(&runner)));","+        let planned = plan_loaded_release(&workspace, &selections, mode);","+        (missing.map(|handle| handle.join().unwrap_or_default()), planned)","+    });","+    for tag in missing.unwrap_or_default() {","         eprintln!(\"{}\", tag_missing_from_origin_note(&tag));","     }","+    let plan = planned?;","     if global.dry_run {","-        let plan = plan_local_release(&root, &locator, &runner, &selections, LocalReleaseSource::Preview)?;","         write_release_preview(plan.as_ref(), global.format, &mut std::io::stdout())?;","         return Ok(ExitCode::SUCCESS);","     }","-    if let Some(route) = ci_release_route(&workspace)? {","-        return Err(CliError::ReleaseRequiresCiRoute {","-            reason: route.to_string(),","-        });","-    }","-    let Some(plan) = plan_local_release(&root, &locator, &runner, &selections, LocalReleaseSource::Trusted)? else {","+    let Some(plan) = plan else {","         print_nothing_to_release(global)?;","         return Ok(ExitCode::SUCCESS);","     };"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"be595ac3-b242-4a8c-acac-a649d78e8a4b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"perf/measure","slug":"lexical-jingling-puppy"}
