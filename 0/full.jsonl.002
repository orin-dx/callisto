nifestError::MissingField { field: \"name\", .. })\n    ));\n    let versionless = open_manifest(&dir, r#\"{\"name\":\"p\"}\"#);\n    assert!(matches!(\n        versionless.current_version(),\n        Err(ManifestError::MissingField { field: \"version\", .. })\n    ));\n    let invalid = open_manifest(&dir, r#\"{\"name\":\"p\",\"version\":\"one.two\"}\"#);\n    assert!(matches!(\n        invalid.current_version(),\n        Err(ManifestError::InvalidVersion { raw, .. }) if raw == \"one.two\"\n    ));\n}\n\n#[test]\nfn bin_names_read_string_and_object_bin_fields() {"}},"serverClassifierRequest":"3d173f39-adbd-4776-9f21-ee8797ac75eb","apiBlockIndex":0,"requestId":"req_011CgPGoKPFoFH2dNapdukVU","requestRef":"36847e98-ef75-46b2-a2da-731a75b39711","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"28954366-544e-4e8a-b63c-7cdaa89490bb","timestamp":"2026-10-25T16:30:17.239Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"ci/gate-machete-semver","slug":"lexical-jingling-puppy"}
