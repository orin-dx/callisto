);","+        assert!(manifest.contains(\"version = \\\"1.0.0\\\"\"), \"{manifest}\");","+        assert!(root.join(\".changeset/typo.md\").exists());","+    }","+}"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"ac62dc27-68c8-45ce-aeb9-14684a270d28","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/unresolved-changeset-entry","slug":"lexical-jingling-puppy"}
