\n\").unwrap();\n1628-        let (after_snapshot, after_operations, after_prepared, _, _) =\n1629-            derive_release_inputs(&workspace, &decision, source, None, &mut Vec::new()).unwrap();\n1630-        assert_eq!(\n1631-            forge_notes(&after_prepared),\n1632-            ReleaseNotes::Generated {\n1633-                reason: NotesFallback::SectionEmpty\n1634-            }\n1635-        );\n1636-        assert_eq!(snapshot, after_snapshot);\n1637-        assert_eq!(operations, after_operations);\n1638-    }\n1639-\n1640-    /// core publishes to github-release; plugin owns one `[[release.artifact]]` slot on core's release.\n1641-    fn product_and_plugin_repo(core_version: &str, plugin_version: &str) -> tempfile::TempDir {\n1642-        repo(&[\n1643-            (\"Cargo.toml\", \"[workspace]\\nmembers = [\\\"core\\\", \\\"plugin\\\"]\\n\"),\n1644-            (\n1645-                \"core/Cargo.toml\",\n1646-                &format!(\"[package]\\nname = \\\"core\\\"\\nversion = \\\"{core_version}\\\"\\nedition = \\\"2021\\\"\\n\"),\n1647-            ),\n1648-            (\n1649-                \"plugin/Cargo.toml\",\n1650-                &format!(\"[package]\\nname = \\\"plugin\\\"\\nversion = \\\"{plugin_version}\\\"\\nedition = \\\"2021\\\"\\n\"),\n1651-            ),\n1652-            (\n1653-                \"callisto.toml\",\n1654-                \"[release]\\nproduct-package = \\\"cargo/core\\\"\\nforge-repository = \\\"example/parity\\\"\\n\\n\\","is_error":false}]},"uuid":"39246214-fe3a-41e4-b597-26c3681af181","timestamp":"2026-10-24T06:30:20.015Z","toolUseResult":{"stdout":"1596-    /// The forge release carries the changelog section, and the notes stay\n1597-    /// out of the intent: changing them changes neither snapshot nor operations.\n1598-    #[test]\n1599:    fn forge_release_notes_come_from_the_changelog_and_do_not_affect_the_intent() {\n1600-        let dir = repo(&[\n1601-            (\n1602-                \"Cargo.toml\",\n1603