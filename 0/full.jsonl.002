{"type":"api-request-blob","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","hash":"bdcd62af914464c34fd5f619942f5ed2168fe3cdb0e7d1f38f1d28d42d0fc964","message":{"role":"user","content":[{"tool_use_id":"toolu_01MSGwRRBHFKp28dhkPcm7mi","type":"tool_result","content":"212\t#[test]\n213\tfn cascade_input_accepts_identity_field() {\n214\t    let graph = TwoPackageGraph { packages: vec![] };\n215\t    let groups = GroupTable::default();\n216\t    let cfg = CascadeConfig {\n217\t        mode: CascadeMode::OutOfRange,\n218\t        bump_severity: CascadeBumpSeverity::Patch,\n219\t        peer_escalation: true,\n220\t        preserve_npm_ranges: false,\n221\t    };\n222\t    let seed = BTreeMap::new();\n223\t    let reasons = BTreeMap::new();\n224\t    let named_by = BTreeMap::new();\n225\t    let base = BTreeMap::new();\n226\t    let identity = IdentityIndex::default();\n227\t\n228\t    let input = CascadeInput {\n229\t        graph: &graph,\n230\t        groups: &groups,\n231\t        cfg: &cfg,\n232\t        seed: &seed,\n233\t        reasons: &reasons,\n234\t        named_by: &named_by,\n235\t        base: &base,\n236\t        pre: None,\n237\t        tags: &TagIndex::empty(),\n238\t        identity: &identity,\n239\t    };\n240\t\n241\t    assert!(input.identity.native.is_empty());\n242\t}\n243\t\n244\tstruct TwoPackageGraph {\n245\t    packages: Vec<Package>,\n246\t}\n247\t\n248\timpl DependencyResolver for TwoPackageGraph {\n249\t    fn packages(&self) -> impl Iterator<Item = &Package> {\n250\t        self.packages.iter()\n251\t    }\n252\t\n253\t    fn dependencies_of(&self, _id: &PackageId) -> impl Iterator<Item = &DepEdge> {\n254\t        std::iter::empty()\n255\t    }\n256\t\n257\t    fn dependents_of(&self, _id: &PackageId) -> impl Iterator<Item = &DepEdge> {\n258\t        std::iter::empty()\n259\t    }\n260\t}\n261\t\n262\t/// In-memory graph that supports arbitrary edges for cascade tests.\n263\tstruct TestGraph {\n264\t    packages: Vec<Package>,\n265\t    edges: Vec<DepEdge>,\n266\t}\n267\t\n268\timpl DependencyResolver for TestGraph {\n269\t    fn packages(&self) -> impl Iterator<Item = &Package> {\n270\t        self.packages.iter()\n271\t    }\n272\t\n273\t    fn dependencies_of(&self, id: &PackageId) -> impl Iterator<Item = &DepEdge> {\n274\t        // Return edges where `from == id` (id depends on the target).\n275\t        self.edges.iter().filter(move |e| &e.from == id)\n276\t    }\n277\t\n278\t    fn dependents_of(&self, id: &PackageId) -> impl Iterator<Item = &DepEdge> {\n279\t        // Return edges where `to == id` (i.e. the caller depends on id).\n280\t        self.edges.iter().filter(move |e| &e.to == id)\n281\t    }\n282\t}\n283\t\n284\tfn make_dep_edge(from: &PackageId, to: &PackageId, spec_str: &str, ecosystem: callisto_model::Ecosystem) -> DepEdge {\n285\t    let spec = DepSpec::Range(\n286\t        callisto_model::VersionReq::parse(spec_str, ecosystem).unwrap(),\n287\t        spec_str.to_string(),\n288\t    );\n289\t    DepEdge {\n290\t        locator: Default::default(),\n291\t        from: from.clone(),\n292\t        to: to.clone(),\n293\t        name: to.name().to_string(),\n294\t        kind: DepKind::Runtime,\n295\t        spec,\n296\t        from_manifest: std::path::PathBuf::from(format!(\"{}/Cargo.toml\", from.name())),\n297\t        inherited: false,\n298\t    }\n299\t}\n300\t\n301\tfn bare_package(id: &PackageId) -> Package {\n302\t    Package {\n303\t        id: id.clone(),\n304\t        manifests: Vec::new(),\n305\t        changelog: None,\n306\t        release_trigger: ReleaseTrigger::Changeset,\n307\t        publish_to: Vec::new(),\n308\t        tag_template: None,\n309\t    }\n310\t}\n311\t"},{"tool_use_id":"toolu_01QyURfYc9mfGtUdeUrHpEeg","type":"tool_result","content":"509\t#[test]\n510\tfn test_linked_group_propagates_severity_to_unseeded_member_and_converges() {\n511\t    let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n512\t    let pkg_b = PackageId::parse(\"pkg-b\").unwrap();\n513\t\n514\t    let graph = TwoPackageGraph {\n515\t        packages: vec![bare_package(&pkg_a), bare_package(&pkg_b)],\n516\t    };\n517\t\n518\t    let mut base = BTreeMap::new();\n519\t    base.insert(pkg_a.clone(), Version::semver(1, 0, 0));\n520\t    base.insert(pkg_b.clone(), Version::semver(1, 0, 0));\n521\t\n522\t    // Only pkg_b receives a severity via a changeset; pkg_a starts\n523\t    // completely unseeded.\n524\t    let mut seed = BTreeMap::new();\n525\t    seed.insert(pkg_b.clone(), Severity::Major);\n526\t\n527\t    let mut groups = GroupTable::default();\n528\t    let group_def = GroupDef {\n529\t        name: GroupName(\"linked-pair\".to_string()),\n530\t        kind: GroupKind::Linked,\n531\t        members: vec![GroupMember::Package(pkg_a.clone()), GroupMember::Package(pkg_b.clone())],\n532\t    };\n533\t    groups.linked.insert(group_def.name.clone(), group_def);\n534\t\n535\t    let cfg = CascadeConfig {\n536\t        mode: CascadeMode::OutOfRange,\n537\t        bump_severity: CascadeBumpSeverity::Patch,\n538\t        peer_escalation: true,\n539\t        preserve_npm_ranges: false,\n540\t    };\n541\t\n542\t    let reasons = BTreeMap::new();\n543\t    let named_by = BTreeMap::new();\n544\t\n545\t    let input = CascadeInput {\n546\t        graph: &graph,\n547\t        groups: &groups,\n548\t        cfg: &cfg,\n549\t        seed: &seed,\n550\t        reasons: &reasons,\n551\t        named_by: &named_by,\n552\t        base: &base,\n553\t        pre: None,\n554\t        tags: &TagIndex::empty(),\n555\t        identity: &IdentityIndex::default(),\n556\t    };\n557\t\n558\t    let outcome = run_cascade(input).unwrap();\n559\t\n560\t    // pkg_a was never seeded directly; it must pick up pkg_b's severity\n561\t    // purely through linked-group union.\n562\t    assert_eq!(outcome.severities.get(&pkg_a), Some(&Severity::Major));\n563\t    assert_eq!(outcome.severities.get(&pkg_b), Some(&Severity::Major));\n564\t\n565\t    let target_a = outcome.targets.get(&pkg_a).unwrap();\n566\t    let target_b = outcome.targets.get(&pkg_b).unwrap();\n567\t\n568\t    // Both members share the same base version, so convergence must\n569\t    // land them on the exact same target version.\n570\t    assert_eq!(target_a, target_b);\n571\t    assert_eq!(target_a.render(), \"2.0.0\");\n572\t\n573\t    assert_eq!(\n574\t        outcome.reasons.get(&pkg_a),\n575\t        Some(&BumpReason::LinkedGroupUnion {\n576\t            group: GroupName(\"linked-pair\".to_string()),\n577\t        })\n578\t    );\n579\t}\n580\t\n581\t/// Linked group members with *different* base versions must\n582\t/// converge on the SAME winning target version (the max of each member's\n583\t/// individually-computed candidate at the converged severity), not just\n584\t/// the same severity.\n585\t#[test]\n586\tfn test_linked_group_converges_target_version_across_divergent_bases() {\n587\t    let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n588\t    let pkg_b = PackageId::parse(\"pkg-b\").unwrap();"}]}}
