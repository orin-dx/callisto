ng: &std::collections::BTreeSet<callisto_model::ReleasePackageId>,\n384\t) -> std::collections::BTreeSet<callisto_model::ReleasePackageId> {\n385\t    let context = ProviderContext::new(root, runner, prepared.git_remote.as_ref());\n386\t    prepared\n387\t        .operations\n388\t        .iter()\n389\t        .filter(|(id, _)| among.contains(&id.package))\n390\t        .filter(|(id, operation)| {\n391\t            let observed = checked_provider_for(operation).and_then(|provider| {\n392\t                provider.observe(\n393\t                    &context,\n394\t                    &ProviderRequest {\n395\t                        id,\n396\t                        operation,\n397\t                        artifacts: None,\n398\t                    },\n399\t                )\n400\t            });\n401\t            !matches!(observed, Ok(ProviderObservationV1::Exact { .. }))\n402\t        })\n403\t        .map(|(id, _)| id.package.clone())\n404\t        .collect()\n405\t}\n406\t\n407\t/// The packages in `among` with a registry publish already observed exactly satisfied.\n408\t///\n409\t/// A registry that cannot be read is an error, never \"not published\": the caller decides whether to tag from this.\n410\t/// A conflicting registry state is left to the run, which stops on it before any effect.\n411\tpub(crate) fn published_packages(\n412\t    root: &Path,\n413\t    runner: &dyn CommandRunner,\n414\t    prepared: &super::derive::PreparedDerivation,\n415\t    among: &std::collections::BTreeSet<callisto_model::ReleasePackageId>,\n416\t) -> Result<std::collections::BTreeSet<callisto_model::ReleasePackageId>, GraphError> {\n417\t    let context = ProviderContext::new(root, runner, prepared.git_remote.as_ref());\n418\t    let mut published = std::collections::BTreeSet::new();\n419\t    for (id, operation) in &prepared.operations {\n420\t        if !among.contains(&id.package) || !matches!(operation, PreparedOperation::RegistryPublish(_)) {\n421\t            continue;\n422