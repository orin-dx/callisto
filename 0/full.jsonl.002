{"parentUuid":"4c258d7b-5808-47a7-87da-1e812bcb3bf2","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Bash","toolUseID":"toolu_01LWp7zgX2ZQMo6QsfjkLoJ8","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"15c732d1-457b-4efc-91e5-664943f21b1c\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main\\\",\\\"project\\\":\\\"smoke-main\\\",\\\"tool_name\\\":\\\"Bash\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":42},"type":"attachment","uuid":"ddcd612a-c273-419f-b5c7-f677ce7e0334","timestamp":"2026-10-24T19:00:19.984Z","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/taken-name-first-release","slug":"lexical-jingling-puppy"}
{"parentUuid":"ebcc4980-c8fe-48d0-a236-1d64ebd6c4a4","isSidechain":false,"promptId":"81e97b21-5b87-4de1-93b0-c0727fa54480","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019WVAccUY1kPbNjT8g8Aq8m","type":"tool_result","content":"The file /Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release/provider/repository.rs has been updated successfully."}]},"uuid":"2e19d6e4-1c07-40de-a65f-7d1f587cde01","timestamp":"2026-10-24T19:00:20.057Z","toolUseResult":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release/provider/repository.rs","oldString":"    #[test]\n    fn a_different_repository_is_warned_about_and_the_same_one_is_not() {","newString":"    #[test]\n    fn differing_repositories_names_both_sides_and_stays_silent_when_it_cannot_tell() {\n        let origin = \"https://github.com/example/single.git\";\n        assert_eq!(\n            differing_repositories(Some(\"https://github.com/CAD97/rust-single\"), origin),\n            Some((\"github.com/cad97/rust-single\".to_owned(), \"github.com/example/single\".to_owned()))\n        );\n        // The same repository in another spelling, no recorded repository, and unreadable values prove nothing.\n        assert_eq!(differing_repositories(Some(\"git+https://github.com/example/single\"), origin), None);\n        assert_eq!(differing_repositories(None, origin), None);\n        assert_eq!(differing_repositories(Some(\"not a url\"), origin), None);\n        assert_eq!(differing_repositories(Some(\"https://github.com/a/b\"), \"/tmp/local/remote.git\"), None);\n    }\n\n    #[test]\n    fn a_different_repository_is_warned_about_and_the_same_one_is_not() {","originalFile":"//! Whether a version already on a registry names this repository, so adopting it can be flagged when it does not.\n\n/// `host/owner/repo` for a repository URL in any form a registry records, lowercased and without a `.git` suffix.\n///\n/// Reads `https://`, `git+https://`, `ssh://`, `git://`, `git@host:owner/repo`, `github:owner/repo` and npm's bare\n/// `owner/repo` shorthand. Only the first two path segments count, so a `/tree/main` or `#readme` tail is ignored.\npub(crate) fn repository_identity(url: &str) -> Option<String> {\n    let url = url.trim();\n    let url = url.strip_prefix(\"git+\").unwrap_or(url);\n    let (host, path) = if let Some(rest) = url.strip_prefix(\"github:\") {\n        (\"github.com\", rest)\n    } else if let Some((_, rest)) = url.split_once(\"://\") {\n        let rest = rest.rsplit_once('@').map_or(rest, |(_, after)| after);\n        rest.split_once('/')?\n    } else if let Some((front, path)) = url.split_once(':') {\n        (front.rsplit_once('@').map_or(front, |(_, host)| host), path)\n    } else if url.matches('/').count() == 1 && !url.contains('.') {\n        (\"github.com\", url)\n    } else {\n        return None;\n    };\n    let host = host.split(':').next().unwrap_or(host);\n    let path = path.split(['#', '?']).next().unwrap_or(path);\n    let mut segments = path.split('/').filter(|segment| !segment.is_empty());\n    let owner = segments.next()?;\n    let repo = segments.next()?;\n    let repo = repo.strip_suffix(\".git\").unwrap_or(repo);\n    (!host.is_empty() && !repo.is_empty()).then(|| format!(\"{host}/{owner}/{repo}\").to_ascii_lowercase())\n}\n\n/// The repository a registry entry names and this repository, as `host/owner/repo`, when they differ.\n///\n/// `None` when the registry names no repository, when either side cannot be read as a repository, and when they\n/// match: a missing or unreadable value proves nothing about who owns the name.\npub(crate) fn differing_repositories(registry_repository: Option<&str>, origin: &str) -> Option<(String, String)> {\n    let registry = repository_identity(registry_repository?)?;\n    let ours = repository_identity(origin)?;\n    (registry != ours).then_some((registry, ours))\n}\n\n/// The warning for adopting a published version whose registry entry names another repository, if it does.\npub(crate) fn foreign_repository_warning(\n    package: &str,\n    version: &str,\n    registry_repository: Option<&str>,\n    origin: &str,\n) -> Option<String> {\n    differing_repositories(registry_repository, origin).map(|(registry, ours)| {\n        format!(\n            \"warning: {package} {version} is already published, and its registry entry names {registry}, not this \\\n             repository ({ours}). Callisto adopts the published version and tags this commit; check that the name is \\\n             yours.\"\n        )\n    })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn every_form_a_registry_records_reads_as_host_owner_repo() {\n        for url in [\n            \"https://github.com/Orin-DX/Callisto\",\n            \"https://github.com/orin-dx/callisto.git\",\n            \"git+https://github.com/orin-dx/callisto.git\",\n            \"git://github.com/orin-dx/callisto.git\",\n            \"ssh://git@github.com/orin-dx/callisto.git\",\n            \"git@github.com:orin-dx/callisto.git\",\n            \"github:orin-dx/callisto\",\n            \"orin-dx/callisto\",\n            \"https://github.com/orin-dx/callisto/tree/main/crates/x#readme\",\n            \"https://token@github.com/orin-dx/callisto/\",\n            \"  https://github.com/orin-dx/callisto  \",\n        ] {\n            assert_eq!(\n                repository_identity(url).as_deref(),\n                Some(\"github.com/orin-dx/callisto\"),\n                \"{url}\"\n            );\n        }\n    }\n\n    #[test]\n    fn other_hosts_keep_their_host_and_nonsense_reads_as_nothing() {\n        assert_eq!(\n            repository_identity(\"https://gitlab.com/group/project.git\").as_deref(),\n            Some(\"gitlab.com/group/project\")\n        );\n        assert_eq!(\n            repository_identity(\"ssh://git@git.example.com:2222/team/app.git\").as_deref(),\n            Some(\"git.example.com/team/app\")\n        );\n        for url in [\n            \"\",\n            \"   \",\n            \"https://github.com\",\n            \"https://github.com/onlyowner\",\n            \"not a url\",\n            \"a/b/c\",\n        ] {\n            assert_eq!(repository_identity(url), None, \"{url:?}\");\n        }\n    }\n\n    #[test]\n    fn a_different_repository_is_warned_about_and_the_same_one_is_not() {\n        let origin = \"https://github.com/orin-dx/callisto.git\";\n        let warning =\n            foreign_repository_warning(\"cargo/itoa\", \"1.0.0\", Some(\"https://github.com/dtolnay/itoa\"), origin)\n                .expect(\"a foreign repository warns\");\n        assert!(warning.contains(\"cargo/itoa 1.0.0\"), \"{warning}\");\n        assert!(warning.contains(\"github.com/dtolnay/itoa\"), \"{warning}\");\n        assert!(warning.contains(\"github.com/orin-dx/callisto\"), \"{warning}\");\n        assert_eq!(\n            foreign_repository_warning(\n                \"cargo/itoa\",\n                \"1.0.0\",\n                Some(\"git+https://github.com/Orin-DX/callisto\"),\n                origin\n            ),\n            None\n        );\n    }\n\n    #[test]\n    fn a_missing_or_unreadable_repository_is_never_a_warning() {\n        let origin = \"https://github.com/orin-dx/callisto\";\n        assert_eq!(foreign_repository_warning(\"npm/x\", \"1.0.0\", None, origin), None);\n        assert_eq!(\n            foreign_repository_warning(\"npm/x\", \"1.0.0\", Some(\"nonsense\"), origin),\n            None\n        );\n        assert_eq!(\n            foreign_repository_warning(\"npm/x\", \"1.0.0\", Some(\"https://github.com/a/b\"), \"nonsense\"),\n            None\n        );\n    }\n}\n","structuredPatch":[{"oldStart":104,"oldLines":6,"newStart":104,"newLines":20,"lines":["     }"," ","     #[test]","+    fn differing_repositories_names_both_sides_and_stays_silent_when_it_cannot_tell() {","+        let origin = \"https://github.com/example/single.git\";","+        assert_eq!(","+            differing_repositories(Some(\"https://github.com/CAD97/rust-single\"), origin),","+            Some((\"github.com/cad97/rust-single\".to_owned(), \"github.com/example/single\".to_owned()))","+        );","+        // The same repository in another spelling, no recorded repository, and unreadable values prove nothing.","+        assert_eq!(differing_repositories(Some(\"git+https://github.com/example/single\"), origin), None);","+        assert_eq!(differing_repositories(None, origin), None);","+        assert_eq!(differing_repositories(Some(\"not a url\"), origin), None);","+        assert_eq!(differing_repositories(Some(\"https://github.com/a/b\"), \"/tmp/local/remote.git\"), None);","+    }","+","+    #[test]","     fn a_different_repository_is_warned_about_and_the_same_one_is_not() {","         let origin = \"https://github.com/orin-dx/callisto.git\";","         let warning ="]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"ebcc4980-c8fe-48d0-a236-1d64ebd6c4a4","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/taken-name-first-release","slug":"lexical-jingling-puppy"}
