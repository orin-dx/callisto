hyphen range, which are left as they are.","+fn npm_comparators(clause: &str) -> Option<String> {","+    let mut comparators: Vec<String> = Vec::new();","+    let mut operator = String::new();","+    for token in clause.split_whitespace() {","+        if token == \"-\" {","+            return None;","+        }","+        if token.chars().all(|c| matches!(c, '<' | '>' | '=' | '^' | '~')) {","+            operator.push_str(token);","+        } else {","+            comparators.push(format!(\"{operator}{token}\"));","+            operator.clear();","+        }","+    }","+    (operator.is_empty() && comparators.len() > 1).then(|| comparators.join(\", \"))","+}","+"," /// Parsed version requirement."," #[derive(Clone, Debug, PartialEq, Eq)]"," pub struct VersionReq {"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"8991b5ff-1c54-4f42-b6ef-316661f06c2f","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"fix/npm-space-ranges","slug":"lexical-jingling-puppy"}
