es, detail) = status_with(\n        \"forge-repository = \\\"org/one\\\"\\n\",\n        \"\\n[release.profiles.production]\\nforge-repository = \\\"org/two\\\"\\n\",\n    );\n    assert!(\n        !ok && codes.iter().any(|c| c == E197) && detail.contains(\"org/one\") && detail.contains(\"org/two\"),\n        \"expected E197, got ok={ok} codes {codes:?}: {detail}\"\n    );\n}\n","new_str":"/// The old `[release.profiles]` table is gone: it is an unknown key, named in the error.\n#[test]\nfn a_release_profile_table_is_rejected() {\n    for profile in [\"production\", \"rehearsal\"] {\n        let (ok, _, detail) = status_with(\n            \"forge-repository = \\\"org/one\\\"\\n\",\n            &format!(\"\\n[release.profiles.{profile}]\\nforge-repository = \\\"org/two\\\"\\n\"),\n        );\n        assert!(!ok && detail.contains(\"profiles\"), \"{profile}: ok={ok}: {detail}\");\n    }\n}\n"}},"serverClassifierRequest":"a28c8020-9bcd-452a-bb4f-76869cea846d","apiBlockIndex":1,"requestId":"req_011CgMYdPTPkkATtRH6s94d2","requestRef":"8aafb29f-c2bd-442a-aa65-a29a6212b67a","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"652edc21-f106-4d26-bf1a-6fc4f8ef36e8","timestamp":"2026-10-24T18:36:36.590Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"chore/remove-legacy-surface","slug":"lexical-jingling-puppy"}
