&format!(\"M\\t{path}\")) {\n                Err(GraphError::ReleaseCommitVerificationFailed {\n                    reason: CommitVerificationFailure::UnexpectedPath { path: refused },\n                    ..\n                }) => assert_eq!(refused, path),\n                other => panic!(\"{path}: expected UnexpectedPath, got {other:?}\"),\n            }\n        }\n    }\n\n    /// A merged commit whose actual `HEAD` differs from the commit\n    /// being verified must report `ReleaseCommitVerificationFailed{reason:\n    /// HeadMismatch}`, naming the *verified* commit -- not the fieldless\n    /// `ReleaseIntentStale` every other mismatch used to collapse into.","originalFile":null,"structuredPatch":[{"oldStart":1318,"oldLines":6,"newStart":1318,"newLines":83,"lines":["         );","     }"," ","+    /// The same version commit with one more changed path, `extra`: verification stops at that path.","+    fn verify_with_extra_path(extra: &str) -> Result<ReleaseDecisionV1, GraphError> {","+        let release_commit_sha = \"a\".repeat(40);","+        let parent_sha = \"b\".repeat(40);","+        let mut blobs = std::collections::BTreeMap::new();","+        blobs.insert(","+            (parent_sha.clone(), \"pkg-a/Cargo.toml\".to_owned()),","+            cargo_manifest_source(\"pkg-a\", \"1.0.0\"),","+        );","+        blobs.insert(","+            (release_commit_sha.clone(), \"pkg-a/Cargo.toml\".to_owned()),","+            cargo_manifest_source(\"pkg-a\", \"1.1.0\"),","+        );","+        let decision = ReleaseDecisionV1::new(vec![ReleaseDecisionEntry {","+            package: ReleasePackageId::new(Ecosystem::Cargo, \"pkg-a\").unwrap(),","+            target_version: Version::parse(\"1.1.0\", Ecosystem::Cargo.version_grammar()).unwrap(),","+            reasons: vec![ReleaseInclusionReason::Changeset],","+        }])","+        .unwrap();","+        let name_status = [","+            \"A\\t.callisto/release-decision.json\",","+            \"D\\t.changeset/a-minor.md\",","+            \"M\\tpkg-a/Cargo.toml\",","+            \"M\\tpkg-a/CHANGELOG.md\",","+            \"M\\tCargo.lock\",","+            extra,","+        ]","+        .join(\"\\n\");","+        let runner = CountingBatchRunner {","+            release_commit: release_commit_sha.clone(),","+            parent: parent_sha,","+            decision_json: serde_json::to_string(&decision).unwrap(),","+            name_status,","+            blobs,","+            run_calls: std::sync::Mutex::new(Vec::new()),","+            batch_calls: std::sync::Mutex::new(0),","+        };","+        let workspace = fixture_workspace(&runner, vec![cargo_package(\"pkg-a\")]);","+        derive_release_commit_decision(","+            &workspace,","+            &CommitSha::parse(&release_commit_sha).unwrap(),","+            std::path::Path::new(\".callisto/release-decision.json\"),","+        )","+    }","+","+    /// A version commit may change manifests, lockfiles, changelogs, changesets and the decision file, anywhere.","+    #[test]","+    fn a_version_commit_that_changes_only_what_a_version_commit_changes_verifies() {","+        for extra in [\"M\\tcrates/inner/Cargo.toml\", \"M\\tpackages/web/pnpm-lock.yaml\", \"M\\t.changeset/pre.json\"] {","+            let result = verify_with_extra_path(extra);","+            assert!(result.is_ok(), \"{extra}: {result:?}\");","+        }","+    }","+","+    /// Anything else could change what is published or where, so a version commit that carries it is refused.","+    #[test]","+    fn a_version_commit_that_also_changes_anything_else_is_refused() {","+        for path in [","+            \"build.rs\",","+            \"src/lib.rs\",","+            \".npmrc\",","+            \".cargo/config.toml\",","+            \"callisto.toml\",","+            \".github/actions/setup/action.yml\",","+            \"pkg-a/Cargo.toml.bak\",","+            \".changeset/config.json\",","+        ] {","+            match verify_with_extra_path(&format!(\"M\\