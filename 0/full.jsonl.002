{"parentUuid":"328c0e05-16e2-4c60-b2f1-116ed64fdfb5","isSidechain":false,"promptId":"81e97b21-5b87-4de1-93b0-c0727fa54480","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PQVa8X87E2rrAiLivNptYx","type":"tool_result","content":"crates/callisto-graph/src/commands/release/mod.rs:85:    ci_release_route, plan_local_release, plan_workspace_release, CiReleaseRoute, LocalReleasePlan, LocalReleaseSource,\ncrates/callisto-graph/src/commands/mod.rs:25:    plan_workspace_release, validate_local_release_intent, validate_release_intent, ArtifactBuildPolicy,\ncrates/callisto-graph/src/commands/release/local.rs:92:pub fn plan_local_release<L: ProjectLocator, R: CommandRunner>(\ncrates/callisto-graph/src/commands/release/local.rs:101:    plan_workspace_release(&workspace, selections, mode)\ncrates/callisto-graph/src/commands/init.rs:12:    canonical_root, is_platform_package, optional_git_remote, plan_workspace_release, programs, timeouts,\ncrates/callisto-graph/src/commands/init.rs:474:    plan_workspace_release(&workspace, &[], LocalReleaseSource::Preview)\n    let matrix = crate::commands::matrix(workspace, &crate::commands::MatrixOptions::default())?;\n    Ok(matrix\n        .platform_targets\n        .keys()\n        .next()\n        .map(|package| CiReleaseRoute::PlatformPackage {\n            package: package.clone(),\n        }))\n}\n\n/// A derived local release.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct LocalReleasePlan {\n    pub intent: ReleaseIntentV1,\n    /// A preview only: `origin` has no push URL, so tags carry no remote and a run would refuse.\n    pub tags_unbound: bool,\n    /// Advisory findings from derivation (e.g. an artifact owner selected without its product).\n    pub diagnostics: Vec<callisto_model::Diagnostic>,\n}\n\n/// Derives the intent for every unreleased package (or exactly `selections`).\n///\n/// This is the one plan derivation behind both `callisto release --dry-run`\n/// and `callisto release`; `None` means