y the kind of duplicated derivation\n27-/// that drifts -- so it lives here once instead.\n28-pub(crate) fn release_package_ids(\n29-    identity: &crate::IdentityIndex,\n30-    package: &Package,\n31-) -> Result<Vec<ReleasePackageId>, GraphError> {\n32-    package\n33-        .canonical_manifests()\n34-        .map(|manifest| {\n35-            let ecosystem = manifest.ecosystem();\n36-            // A dual-manifest package's manifests may declare different names.\n--\n781-    paths: &[&str],\n782-) -> Result<Vec<BatchBlob>, GraphError> {\n783-    let objects: Vec<String> = paths.iter().map(|path| format!(\"{commit}:{path}\")).collect();\n784:    batch_blobs(runner, root, &objects)\n785-}\n786-\n787-/// The manifests of one commit: those fetched up front in one batch, and any other fetched on first ask. A package that\n788-/// names its workspace with `package.workspace` can name a different one at each of two commits, so the second commit's\n789-/// workspace manifest is not among those fetched for the first.\n790-struct CommitBlobs<'a, R: CommandRunner> {\n791-    runner: &'a R,\n792-    root: &'a std::path::Path,\n793-    commit: &'a str,\n794-    blobs: std::cell::RefCell<std::collections::BTreeMap<String, BatchBlob>>,\n795-}\n796-\n797-impl<'a, R: CommandRunner> CommitBlobs<'a, R> {\n798-    fn new(runner: &'a R, root: &'a std::path::Path, commit: &'a str, paths: &[&str], blobs: Vec<BatchBlob>) -> Self {\n799-        CommitBlobs {\n800-            runner,\n801-            root,\n802-            commit,\n803-            blobs: std::cell::RefCell::new(paths.iter().map(|path| (*path).to_owned()).zip(blobs).collect()),\n804-        }\n805-    }\n806-\n807-    /// The text of `path` at the commit, `None` when it has none there.\n808-    fn text(&self, path: &str) -> Result<Option<String>, GraphError> {\n809-        if !self.blobs.borrow().contains_key(path) {","is_error":false}]},"uuid":"9585c694-8d7c-4bd9-af34-2e7d5d008476","timestamp":"2026-10-25T02:28:06.828Z","t