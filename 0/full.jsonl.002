{"type":"api-request-blob","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","hash":"0ff70fffb00d4dbda8053f0eaff782d9cbbda5db13f8ee948d42261a98e5c93e","message":{"role":"user","content":[{"tool_use_id":"toolu_01LR7MYtsZ7RPszBxqTCqqwZ","type":"tool_result","content":"400\t    assert!(error.to_string().contains(\"`x86_64-unknown-linux-gnu`\"), \"{error}\");\n401\t    assert!(nothing_written(dir.path()));\n402\t}\n403\t\n404\t#[test]\n405\tfn declining_the_preview_writes_nothing() {\n406\t    let dir = workspace(0);\n407\t    let run = run_init(\n408\t        dir.path(),\n409\t        InitArgs::default(),\n410\t        true,\n411\t        vec![Answer::Select(0), Answer::Confirm(false), Answer::Confirm(false)],\n412\t        false,\n413\t    );\n414\t    assert_eq!(run.result.unwrap(), ExitCode::SUCCESS);\n415\t    assert!(run.out.contains(\"nothing was written\"));\n416\t    assert!(nothing_written(dir.path()));\n417\t}\n418\t\n419\t#[test]\n420\tfn an_existing_config_errors() {\n421\t    let dir = workspace(0);\n422\t    std::fs::write(dir.path().join(\"callisto.toml\"), \"[init]\\necosystems = []\\n\").unwrap();\n423\t    let error = run_init(dir.path(), yes(InitVersioning::Fixed), false, vec![], false)\n424\t        .result\n425\t        .unwrap_err();\n426\t    assert!(error.to_string().contains(\"already initialized\"), \"{error}\");\n427\t    assert!(!dir.path().join(\".changeset\").exists());\n428\t}\n429\t\n430\t#[test]\n431\tfn non_tty_without_yes_names_yes_and_missing_flags() {\n432\t    let dir = workspace(0);\n433\t    let error = run_init(dir.path(), InitArgs::default(), false, vec![], false)\n434\t        .result\n435\t        .unwrap_err();\n436\t    assert!(matches!(&error, CliError::InitRequiresYes { missing } if missing == &[\"--yes\", \"--versioning\"]));\n437\t    assert!(error.to_string().contains(\"--yes, --versioning\"), \"{error}\");\n438\t    assert!(nothing_written(dir.path()));\n439\t}\n440\t\n441\t#[test]\n442\tfn yes_requires_versioning_forge_and_product() {\n443\t    let dir = workspace(2);\n444\t    let missing = |args| match run_init(dir.path(), args, false, vec![], false).result.unwrap_err() {\n445\t        CliError::InitMissingFlags { missing } => missing,\n446\t        other => panic!(\"{other}\"),\n447\t    };\n448\t    assert_eq!(\n449\t        missing(InitArgs {\n450\t            yes: true,\n451\t            ..Default::default()\n452\t        }),\n453\t        [\"--versioning\"]\n454\t    );\n455\t    assert_eq!(\n456\t        missing(InitArgs {\n457\t            artifact_targets: vec![\"x86_64-unknown-linux-gnu\".to_owned()],\n458\t            ..yes(InitVersioning::Fixed)\n459\t        }),\n460\t        [\"--forge-repository\", \"--product-package\"]\n461\t    );\n462\t    assert!(nothing_written(dir.path()));\n463\t}\n464\t\n465\t// --yes without --artifact-target opts out of shipping.\n466\t#[test]\n467\tfn yes_without_targets_ships_nothing() {\n468\t    let dir = workspace(1);\n469\t    run_init(dir.path(), yes(InitVersioning::Independent), false, vec![], false)\n470\t        .result\n471\t        .unwrap();\n472\t    assert!(!config(dir.path()).contains(\"[release]\"));\n473\t}\n474\t"},{"tool_use_id":"toolu_011ksqxhM17GX28furGhk78u","type":"tool_result","content":"660\t}\n661\t\n662\t// Flags produce the interactive run's config and preview, without prompting.\n663\t#[test]\n664\tfn non_interactive_matches_interactive() {\n665\t    let interactive_dir = workspace(1);\n666\t    let interactive = run_init(\n667\t        interactive_dir.path(),\n668\t        InitArgs::default(),\n669\t        true,\n670\t        vec![\n671\t            Answer::Select(1),\n672\t            Answer::Confirm(true),\n673\t            Answer::Input(\"example/tools\"),\n674\t            Answer::Input(\"x86_64-unknown-linux-gnu\"),\n675\t            Answer::Confirm(false),\n676\t            Answer::Confirm(true),\n677\t        ],\n678\t        false,\n679\t    );\n680\t    interactive.result.unwrap();\n681\t    let flags_dir = workspace(1);\n682\t    let flags = run_init(\n683\t        flags_dir.path(),\n684\t        InitArgs {\n685\t            versioning: Some(InitVersioning::Fixed),\n686\t            ..with_targets(&[\"x86_64-unknown-linux-gnu\"])\n687\t        },\n688\t        false,\n689\t        vec![],\n690\t        false,\n691\t    );\n692\t    flags.result.unwrap();\n693\t    assert!(flags.prompter.asked.is_empty());\n694\t    assert_eq!(config(interactive_dir.path()), config(flags_dir.path()));\n695\t    let preview = |out: &str| {\n696\t        let start = out.find(\"First release preview\").unwrap();\n697\t        let end = out.find(\"Initialized\").unwrap();\n698\t        let text = out[start..end].to_owned();\n699\t        text.replace(interactive_dir.path().to_str().unwrap(), \"\")\n700\t    };\n701\t    assert_eq!(preview(&interactive.out), preview(&flags.out));\n702\t}\n703\t\n704\t// A repository with no commit gets the config and a note instead of a preview.\n705\t#[test]\n706\tfn no_commits_skips_the_preview_and_still_writes() {\n707\t    let dir = tempfile::tempdir().unwrap();\n708\t    let root = dir.path();\n709\t    std::fs::write(\n710\t        root.join(\"Cargo.toml\"),\n711\t        \"[package]\\nname = \\\"app\\\"\\nversion = \\\"0.1.0\\\"\\nedition = \\\"2021\\\"\\n\",\n712\t    )\n713\t    .unwrap();\n714\t    callisto_fixtures::git::init_repo(root);\n715\t    git(root, &[\"remote\", \"add\", \"origin\", \"https://github.com/example/app.git\"]);\n716\t    let run = run_init(root, yes(InitVersioning::Independent), false, vec![], false);\n717\t    assert_eq!(run.result.unwrap(), ExitCode::SUCCESS);\n718\t    assert!(run.out.contains(NO_COMMITS), \"{}\", run.out);\n719\t    assert!(!run.out.contains(\"First release preview\"), \"{}\", run.out);\n720\t    assert_eq!(config(root), \"# callisto configuration\\n\");\n721\t    assert!(root.join(\".changeset/README.md\").exists());\n722\t}\n723\t\n724\t// --dry-run detects, asks, and previews, then writes nothing.\n725\t#[test]\n726\tfn dry_run_previews_and_writes_nothing() {\n727\t    let dir = workspace(0);\n728\t    let run = run_init(\n729\t        dir.path(),\n730\t        InitArgs::default(),\n731\t        true,\n732\t        vec![Answer::Select(0), Answer::Confirm(false)],\n733\t        true,\n734\t    );\n735\t    run.result.unwrap();\n736\t    assert_eq!(run.prompter.prompts(), [VERSIONING_PROMPT, WORKFLOW_PROMPT]);\n737\t    assert!(run.out.contains(\"Release plan:\"), \"{}\", run.out);\n738\t    assert!(run.out.contains(\"[DRY-RUN]\"));\n739\t    assert!(nothing_written(dir.path()));\n740\t}\n741\t\n742\t// --dry-run --workflow lists every file it would write: config, changeset README and workflow.\n743\t#[test]\n744\tfn dry_run_with_workflow_lists_every_file() {\n745\t    let dir = workspace(0);\n746\t    let args = InitArgs {\n747\t        workflow: true,\n748\t        ..yes(InitVersioning::Independent)\n749\t    };\n750\t    let out = Shared::default();\n751\t    let err = Shared::default();\n752\t    run(\n753\t        args,\n754\t        &global(dir.path(), OutputFormat::Json, true),\n755\t        false,\n756\t        &mut Scripted::new(vec![], &out),\n757\t        &mut out.clone(),\n758\t        &mut err.clone(),\n759\t        &fake_ls_remote(env!(\"CARGO_PKG_VERSION\")),"}]}}
