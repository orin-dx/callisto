{"parentUuid":"2fc86d78-3e61-45c8-881e-ec53c6b0a203","isSidechain":false,"promptId":"81e97b21-5b87-4de1-93b0-c0727fa54480","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UW8AhpK4XaK89i5Uyjxkyo","type":"tool_result","content":"410\t        \"-r\",\n411\t        \"--no-renames\",\n412\t        parent.as_str(),\n413\t        release_commit.as_str(),\n414\t    ];\n415\t    let changed = git_stdout(workspace.runner, &workspace.root, &diff_tree_args)?;\n416\t    let changed = parse_name_status(&changed, &diff_tree_args)?;\n417\t\n418\t    // The decision must be freshly authored as part of *this* commit, not a\n419\t    // stale leftover an earlier release already committed and this one never\n420\t    // touched -- otherwise a commit that changes nothing real could still\n421\t    // carry forward a prior, unrelated decision's authority.\n422\t    let decision_path_str = normalized_git_path(decision_path)?;\n423\t    let decision_freshly_written = changed\n424\t        .iter()\n425\t        .any(|(status, path)| path == &decision_path_str && matches!(status.as_str(), \"A\" | \"M\"));\n426\t    if !decision_freshly_written {\n427\t        return Err(GraphError::ReleaseCommitVerificationFailed {\n428\t            commit: release_commit.clone(),\n429\t            reason: CommitVerificationFailure::DecisionNotWrittenByCommit,\n430\t        });\n431\t    }\n432\t\n433\t    // A cheap, independent sanity check that this commit is a real version\n434\t    // application and not just a hand-crafted decision file: some real\n435\t    // changeset was actually consumed. The decision's own entries, not this\n436\t    // changeset's content, remain the sole authority verified below.\n437\t    let changeset_dir = normalized_git_path(&workspace.config.changesets_dir)?;\n438\t    let consumed_a_changeset = changed\n439\t        .iter()\n440\t        .any(|(status, path)| status == \"D\" && is_changeset_path(path, &changeset_dir));\n441\t    if !consumed_a_changeset {\n442\t        return Err(GraphError::ReleaseCommitVerificationFailed {\n443\t            commit: release_commit.clone(),\n444\t            reason: CommitVerificationFailure::NoChangesetConsumed,\n445\t        });\n446\t    }\n447\t\n448\t    let decision_source = git_file(\n449\t        workspace.runner,\n450\t        &workspace.root,\n451\t        release_commit.as_str(),\n452\t        &decision_path_str,\n453\t    )?;\n454\t    let decision: ReleaseDecisionV1 =\n455\t        serde_json::from_str(&decision_source).map_err(|error| GraphError::ReleaseDecisionDecode {\n456\t            path: decision_path.to_path_buf(),\n457\t            message: error.to_string(),\n458\t        })?;\n459\t    let claimed = decision\n460\t        .entries\n461\t        .iter()\n462\t        .map(|entry| (entry.package.clone(), entry.target_version.clone()))\n463\t        .collect::<std::collections::BTreeMap<_, _>>();\n464\t\n465\t    let changed_paths = changed\n466\t        .iter()\n467\t        .filter_map(|(status, path)| matches!(status.as_str(), \"A\" | \"M\").then_some(path.as_str()))\n468\t        .collect::<std::collections::BTreeSet<_>>();\n469\t\n470\t    // Every canonical manifest path this workspace currently declares, in\n471\t    // the exact order `workspace.graph.packages()` and\n472\t    // `Package::canonical_manifests()` yield -- both are backed by ordered\n473\t    // (`BTreeMap`/`Vec`) storage with no interior mutation between calls, so\n474\t    // the second traversal below visits the same (package, manifest) pairs\n475\t    // in the same order. That lets it zip the batched `before`/`after`\n476\t    // results back on by position instead of re-keying by path, which would\n477\t    // misbehave if two packages ever declared an identical manifest path.\n478\t    let manifest_queries: Vec<(String, Ecosystem)> = workspace\n479\t        .graph\n480\t        .packages()\n481\t        .flat_map(Package::canonical_manifests)\n482\t        .map(|manifest| Ok((normalized_git_path(&manifest.path)?, manifest.ecosystem())))\n483\t        .collect::<Result<_, GraphError>>()?;\n484\t    // Each Cargo manifest may inherit its version from a workspace manifest above it, so those are fetched too.\n485\t    let mut query_path_list: Vec<String> = manifest_queries.iter().map(|(path, _)| path.clone()).collect();\n486\t    for (path, _) in manifest_queries\n487\t        .iter()\n488\t        .filter(|(_, ecosystem)| *ecosystem == Ecosystem::Cargo)\n489\t    {\n490\t        for candidate in callisto_manifests::workspace_manifest_candidates(&workspace.root, std::path::Path::new(path))?\n491\t        {\n492\t            let candidate = normalized_git_path(&candidate)?;\n493\t            if !query_path_list.contains(&candidate) {\n494\t                query_path_list.push(candidate);\n495\t            }\n496\t        }\n497\t    }\n498\t    let query_paths: Vec<&str> = query_path_list.iter().map(String::as_str).collect();\n499\t\n500\t    // Exactly two `git cat-file --batch` subprocess invocations total (one\n501\t    // per commit), regardless of how many canonical manifests the\n502\t    // workspace has -- replaces what was previously 2*N separate `git\n503\t    // show` spawns (one `manifest_version_at` call per manifest per\n504\t    // commit).\n505\t    let before_blobs = batch_manifest_blobs_at(workspace.runner, &workspace.root, &parent, &query_paths)?;\n506\t    let after_blobs =\n507\t        batch_manifest_blobs_at(workspace.runner, &workspace.root, release_commit.as_str(), &query_paths)?;\n508\t    let before = CommitBlobs::new(workspace.runner, &workspace.root, &parent, &query_paths, before_blobs);\n509\t    let after = CommitBlobs::new(\n510\t        workspace.runner,\n511\t        &workspace.root,\n512\t        release_commit.as_str(),\n513\t        &query_paths,\n514\t        after_blobs,\n515\t    );\n516\t    let before_versions = resolve_batch_versions(&before, &manifest_queries)?;\n517\t    let after_versions = resolve_batch_versions(&after, &manifest_queries)?;\n518\t\n519\t    let mut observed = std::collections::BTreeSet::new();\n520\t    let mut manifest_index = 0usize;\n521\t    for package in workspace.graph.packages() {\n522\t        let package_ids = release_package_ids(&workspace.identity, package)?;\n523\t        let package_is_claimed = package_ids.iter().any(|id| claimed.contains_key(id));\n524\t        if package_is_claimed {\n525\t            let changelog = package.changelog.as_ref().ok_or(GraphError::ReleasePreconditionUnmet {\n526\t                requirement: ReleasePreconditionRequirement::ChangelogConfigured,\n527\t            })?;\n528\t            let changelog = normalized_git_path(changelog)?;\n529\t            if !changed_paths.contains(changelog.as_str()) {\n530\t                return Err(GraphError::ReleaseCommitVerificationFailed {\n531\t                    commit: release_commit.clone(),\n532\t                    reason: CommitVerificationFailure::ChangelogNotTouched,\n533\t                });\n534\t            }\n535\t        }\n536\t        for id in package_ids {\n537\t            let before = &before_versions[manifest_index];\n538\t            let after = &after_versions[manifest_index];\n539\t            manifest_index += 1;\n540\t            let changed_version = before.version != after.version;\n541\t            match claimed.get(&id) {\n542\t                Some(target_version) => {\n543\t                    if !changed_paths.contains(after.authority.to_string_lossy().as_ref()) {\n544\t                        return Err(GraphError::ReleaseCommitVerificationFailed {\n545\t                            commit: release_commit.clone(),\n546\t                            reason: CommitVerificationFailure::ManifestNotInDiff,\n547\t                        });\n548\t                    }\n549\t                    if !changed_version || &after.version != target_version {\n550\t                        return Err(GraphError::ReleaseCommitVerificationFailed {\n551\t                            commit: release_commit.clone(),\n552\t                            reason: CommitVerificationFailure::ManifestVersionMismatch,\n553\t                        });\n554\t                    }\n555\t                    observed.insert(id);\n556\t                }\n557\t                None => {\n558\t                    if changed_version {\n559\t                        // A changed version the committed decision never\n560\t                        // claimed is not this commit's authority -- fail\n561\t                        // closed rather than trust a partial match.\n562\t                        return Err(GraphError::ReleaseCommitVerificationFailed {\n563\t                            commit: release_commit.clone(),\n564\t                            reason: CommitVerificationFailure::UnclaimedVersionChange,\n565\t                        });\n566\t                    }\n567\t                }\n568\t            }\n569\t        }\n570\t    }\n571\t    if observed.len() != claimed.len() {\n572\t        return Err(GraphError::ReleaseCommitVerificationFailed {\n573\t            commit: release_commit.clone(),\n574\t            reason: CommitVerificationFailure::ClaimedPackageNotObserved,\n575\t        });\n576\t    }\n577\t\n578\t    Ok(decision)\n579\t}\n580\t\n581\tfn is_changeset_path(path: &str, changeset_dir: &str) -> bool {\n582\t    let Some(file_name) = path.strip_prefix(changeset_dir).and_then(|path| {\n583\t        if changeset_dir.is_empty() {\n584\t            Some(path)\n585\t        } else {\n586\t            path.strip_prefix('/')\n587\t        }\n588\t    }) else {\n589\t        return false;\n590\t    };\n591\t\n592\t    !file_name.contains('/') && file_name.ends_with(\".md\") && file_name != \"README.md\"\n593\t}\n594\t\n595\t/// Builds a [`GraphError::ReleaseCommand`] (E164) for a git invocation that\n596\t/// exited non-zero, carrying its real exit status and stderr instead of\n597\t/// discarding them.\n598\tpub(super) fn command_non_zero_exit(\n599\t    program: &str,"}]},"uuid":"c4623165-411a-4d88-8a83-fc45b6b6b2e0","timestamp":"2026-10-24T18:47:14.673Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/crates/callisto-graph/src/commands/release_decision.rs","content":"        \"-r\",\n        \"--no-renames\",\n        parent.as_str(),\n        release_commit.as_str(),\n    ];\n    let changed = git_stdout(workspace.runner, &workspace.root, &diff_tree_args)?;\n    let changed = parse_name_status(&changed, &diff_tree_args)?;\n\n    // The decision must be freshly authored as part of *this* commit, not a\n    // stale leftover an earlier release already committed and this one never\n    // touched -- otherwise a commit that changes nothing real could still\n    // carry forward a prior, unrelated decision's authority.\n    let decision_path_str = normalized_git_path(decision_path)?;\n    let decision_freshly_written = changed\n        .iter()\n        .any(|(status, path)| path == &decision_path_str && matches!(status.as_str(), \"A\" | \"M\"));\n    if !decision_freshly_written {\n        return Err(GraphError::ReleaseCommitVerificationFailed {\n            commit: release_commit.clone(),\n            reason: CommitVerificationFailure::DecisionNotWrittenByCommit,\n        });\n    }\n\n    // A cheap, independent sanity check that this commit is a real version\n    // application and not just a hand-crafted decision file: some real\n    // changeset was actually consumed. The decision's own entries, not this\n    // changeset's content, remain the sole authority verified below.\n    let changeset_dir = normalized_git_path(&workspace.config.changesets_dir)?;\n    let consumed_a_changeset = changed\n        .iter()\n        .any(|(status, path)| status == \"D\" && is_changeset_path(path, &changeset_dir));\n    if !consumed_a_changeset {\n        return Err(GraphError::ReleaseCommitVerificationFailed {\n            commit: release_commit.clone(),\n            reason: CommitVerificationFailure::NoChangesetConsumed,\n        });\n    }\n\n    let decision_source = git_file(\n        workspace.runner,\n        &workspace.root,\n        release_commit.as_str(),\n        &decision_path_str,\n    )?;\n    let decision: ReleaseDecisionV1 =\n        serde_json::from_str(&decision_source).map_err(|error| GraphError::ReleaseDecisionDecode {\n            path: decision_path.to_path_buf(),\n            message: error.to_string(),\n        })?;\n    let claimed = decision\n        .entries\n        .iter()\n        .map(|entry| (entry.package.clone(), entry.target_version.clone()))\n        .collect::<std::collections::BTreeMap<_, _>>();\n\n    let changed_paths = changed\n        .iter()\n        .filter_map(|(status, path)| matches!(status.as_str(), \"A\" | \"M\").then_some(path.as_str()))\n        .collect::<std::collections::BTreeSet<_>>();\n\n    // Every canonical manifest path this workspace currently declares, in\n    // the exact order `workspace.graph.packages()` and\n    // `Package::canonical_manifests()` yield -- both are backed by ordered\n    // (`BTreeMap`/`Vec`) storage with no interior mutation between calls, so\n    // the second traversal below visits the same (package, manifest) pairs\n    // in the same order. That lets it zip the batched `before`/`after`\n    // results back on by position instead of re-keying by path, which would\n    // misbehave if two packages ever declared an identical manifest path.\n    let manifest_queries: Vec<(String, Ecosystem)> = workspace\n        .graph\n        .packages()\n        .flat_map(Package::canonical_manifests)\n        .map(|manifest| Ok((normalized_git_path(&manifest.path)?, manifest.ecosystem())))\n        .collect::<Result<_, GraphError>>()?;\n    // Each Cargo manifest may inherit its version from a workspace manifest above it, so those are fetched too.\n    let mut query_path_list: Vec<String> = manifest_queries.iter().map(|(path, _)| path.clone()).collect();\n    for (path, _) in manifest_queries\n        .iter()\n        .filter(|(_, ecosystem)| *ecosystem == Ecosystem::Cargo)\n    {\n        for candidate in callisto_manifests::workspace_manifest_candidates(&workspace.root, std::path::Path::new(path))?\n        {\n            let candidate = normalized_git_path(&candidate)?;\n            if !query_path_list.contains(&candidate) {\n                query_path_list.push(candidate);\n            }\n        }\n    }\n    let query_paths: Vec<&str> = query_path_list.iter().map(String::as_str).collect();\n\n    // Exactly two `git cat-file --batch` subprocess invocations total (one\n    // per commit), regardless of how many canonical manifests the\n    // workspace has -- replaces what was previously 2*N separate `git\n    // show` spawns (one `manifest_version_at` call per manifest per\n    // commit).\n    let before_blobs = batch_manifest_blobs_at(workspace.runner, &workspace.root, &parent, &query_paths)?;\n    let after_blobs =\n        batch_manifest_blobs_at(workspace.runner, &workspace.root, release_commit.as_str(), &query_paths)?;\n    let before = CommitBlobs::new(workspace.runner, &workspace.root, &parent, &query_paths, before_blobs);\n    let after = CommitBlobs::new(\n        workspace.runner,\n        &workspace.root,\n        release_commit.as_str(),\n        &query_paths,\n        after_blobs,\n    );\n    let before_versions = resolve_batch_versions(&before, &manifest_queries)?;\n    let after_versions = resolve_batch_versions(&after, &manifest_queries)?;\n\n    let mut observed = std::collections::BTreeSet::new();\n    let mut manifest_index = 0usize;\n    for package in workspace.graph.packages() {\n        let package_ids = release_package_ids(&workspace.identity, package)?;\n        let package_is_claimed = package_ids.iter().any(|id| claimed.contains_key(id));\n        if package_is_claimed {\n            let changelog = package.changelog.as_ref().ok_or(GraphError::ReleasePreconditionUnmet {\n                requirement: ReleasePreconditionRequirement::ChangelogConfigured,\n            })?;\n            let changelog = normalized_git_path(changelog)?;\n            if !changed_paths.contains(changelog.as_str()) {\n                return Err(GraphError::ReleaseCommitVerificationFailed {\n                    commit: release_commit.clone(),\n                    reason: CommitVerificationFailure::ChangelogNotTouched,\n                });\n            }\n        }\n        for id in package_ids {\n            let before = &before_versions[manifest_index];\n            let after = &after_versions[manifest_index];\n            manifest_index += 1;\n            let changed_version = before.version != after.version;\n            match claimed.get(&id) {\n                Some(target_version) => {\n                    if !changed_paths.contains(after.authority.to_string_lossy().as_ref()) {\n                        return Err(GraphError::ReleaseCommitVerificationFailed {\n                            commit: release_commit.clone(),\n                            reason: CommitVerificationFailure::ManifestNotInDiff,\n                        });\n                    }\n                    if !changed_version || &after.version != target_version {\n                        return Err(GraphError::ReleaseCommitVerificationFailed {\n                            commit: release_commit.clone(),\n                            reason: CommitVerificationFailure::ManifestVersionMismatch,\n                        });\n                    }\n                    observed.insert(id);\n                }\n                None => {\n                    if changed_version {\n                        // A changed version the committed decision never\n                        // claimed is not this commit's authority -- fail\n                        // closed rather than trust a partial match.\n                        return Err(GraphError::ReleaseCommitVerificationFailed {\n                            commit: release_commit.clone(),\n                            reason: CommitVerificationFailure::UnclaimedVersionChange,\n                        });\n                    }\n                }\n            }\n        }\n    }\n    if observed.len() != claimed.len() {\n        return Err(GraphError::ReleaseCommitVerificationFailed {\n            commit: release_commit.clone(),\n            reason: CommitVerificationFailure::ClaimedPackageNotObserved,\n        });\n    }\n\n    Ok(decision)\n}\n\nfn is_changeset_path(path: &str, changeset_dir: &str) -> bool {\n    let Some(file_name) = path.strip_prefix(changeset_dir).and_then(|path| {\n        if changeset_dir.is_empty() {\n            Some(path)\n        } else {\n            path.strip_prefix('/')\n        }\n    }) else {\n        return false;\n    };\n\n    !file_name.contains('/') && file_name.ends_with(\".md\") && file_name != \"README.md\"\n}\n\n/// Builds a [`GraphError::ReleaseCommand`] (E164) for a git invocation that\n/// exited non-zero, carrying its real exit status and stderr instead of\n/// discarding them.\npub(super) fn command_non_zero_exit(\n    program: &str,","numLines":190,"startLine":410,"totalLines":1633}},"sourceToolAssistantUUID":"2fc86d78-3e61-45c8-881e-ec53c6b0a203","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"fix/release-commit-allowlist","slug":"lexical-jingling-puppy"}
