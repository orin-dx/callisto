{"parentUuid":"cb0687f8-4570-45fa-a3f2-559d4161606e","isSidechain":false,"promptId":"292a1ddc-3040-4aad-8fec-ec43ab952564","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LR7MYtsZ7RPszBxqTCqqwZ","type":"tool_result","content":"400\t    assert!(error.to_string().contains(\"`x86_64-unknown-linux-gnu`\"), \"{error}\");\n401\t    assert!(nothing_written(dir.path()));\n402\t}\n403\t\n404\t#[test]\n405\tfn declining_the_preview_writes_nothing() {\n406\t    let dir = workspace(0);\n407\t    let run = run_init(\n408\t        dir.path(),\n409\t        InitArgs::default(),\n410\t        true,\n411\t        vec![Answer::Select(0), Answer::Confirm(false), Answer::Confirm(false)],\n412\t        false,\n413\t    );\n414\t    assert_eq!(run.result.unwrap(), ExitCode::SUCCESS);\n415\t    assert!(run.out.contains(\"nothing was written\"));\n416\t    assert!(nothing_written(dir.path()));\n417\t}\n418\t\n419\t#[test]\n420\tfn an_existing_config_errors() {\n421\t    let dir = workspace(0);\n422\t    std::fs::write(dir.path().join(\"callisto.toml\"), \"[init]\\necosystems = []\\n\").unwrap();\n423\t    let error = run_init(dir.path(), yes(InitVersioning::Fixed), false, vec![], false)\n424\t        .result\n425\t        .unwrap_err();\n426\t    assert!(error.to_string().contains(\"already initialized\"), \"{error}\");\n427\t    assert!(!dir.path().join(\".changeset\").exists());\n428\t}\n429\t\n430\t#[test]\n431\tfn non_tty_without_yes_names_yes_and_missing_flags() {\n432\t    let dir = workspace(0);\n433\t    let error = run_init(dir.path(), InitArgs::default(), false, vec![], false)\n434\t        .result\n435\t        .unwrap_err();\n436\t    assert!(matches!(&error, CliError::InitRequiresYes { missing } if missing == &[\"--yes\", \"--versioning\"]));\n437\t    assert!(error.to_string().contains(\"--yes, --versioning\"), \"{error}\");\n438\t    assert!(nothing_written(dir.path()));\n439\t}\n440\t\n441\t#[test]\n442\tfn yes_requires_versioning_forge_and_product