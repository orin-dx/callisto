{"parentUuid":"89843228-77e4-496d-844f-e27a34ba6baf","isSidechain":false,"promptId":"949bc951-5bef-4b5d-830c-9fdf26037a79","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HGR9aqM1zJnYS3QEpp7oYu","type":"tool_result","content":"10\t# deterministic staging branch rooted at the current base commit -- which\n11\t# never needs to touch `.github/workflows/*`, since that path is inherited\n12\t# unchanged from the base -- and only then is the managed branch's ref moved\n13\t# onto that commit. A ref move is not itself a write to that path.\n14\tset -euo pipefail\n15\t\n16\tcd \"$INPUT_CWD\"\n17\t\n18\t# This checkout starts on the configured base. Preserve its exact commit for\n19\t# both observations; the working tree changes below (git add -A) never\n20\t# create a local commit -- the real commit is made remotely, via the forge\n21\t# commit API, on the staging branch.\n22\tbase_commit=$(git rev-parse HEAD)\n23\t\n24\trelease_pr_snapshot() {\n25\t  local raw_prs\n26\t  raw_prs=$(gh pr list --state open --base \"$INPUT_BRANCH\" --limit 1000 --json number,headRefName,headRepository,headRefOid)\n27\t  jq -cn \\\n28\t    --arg repository \"$GITHUB_REPOSITORY\" \\\n29\t    --arg base_branch \"$INPUT_BRANCH\" \\\n30\t    --arg base_commit \"$base_commit\" \\\n31\t    --argjson raw_prs \"$raw_prs\" \\\n32\t    '{\n33\t      schemaVersion: 2,\n34\t      repository: $repository,\n35\t      baseBranch: $base_branch,\n36\t      baseCommit: $base_commit,\n37\t      openPullRequests: [$raw_prs[] | {\n38\t        number,\n39\t        headRepository: (.headRepository.nameWithOwner // \"\"),\n40\t        headBranch: .headRefName,\n41\t        headCommit: .headRefOid\n42\t      }]\n43\t    }'\n44\t}\n45\t\n46\tsnapshot=$(release_pr_snapshot)\n47\tdecision=$(callisto --format json release-pr decide \\\n48\t  --snapshot \"$snapshot\" \\\n49\t  --repository \"$GITHUB_REPOSITORY\" \\\n50\t  --base-branch \"$INPUT_BRANCH\" \\\n51\t  --release-branch \"$INPUT_RELEASE_BRANCH\")\n52\tdecision_kind=$(jq -r '.action.kind' <<< \"$decision\")\n53\t\n54\tcase \"$decision_kind\" in\n55\t  noop)\n56\t    echo 'hasChangesets=false' >> \"$GITHUB_OUTPUT\"\n57\t    echo '::notice::No changesets. This action does not publish, tag, download artifacts, or create releases; use the durable repository workflow.'\n58\t    exit 0\n59\t    ;;\n60\t  create)\n61\t    release_branch=$(jq -r '.action.branch' <<< \"$decision\")\n62\t    staging_branch=$(jq -r '.action.stagingBranch' <<< \"$decision\")\n63\t    existing_pr=''\n64\t    ;;\n65\t  update)\n66\t    existing_pr=$(jq -r '.action.pullRequestNumber' <<< \"$decision\")\n67\t    release_branch=$(jq -r '.action.branch' <<< \"$decision\")\n68\t    staging_branch=$(jq -r '.action.stagingBranch' <<< \"$decision\")\n69\t    ;;\n70\t  *) echo \"::error::Callisto returned unsupported release PR decision kind: $decision_kind\"; exit 1 ;;\n71\tesac\n72\t\n73\techo 'hasChangesets=true' >> \"$GITHUB_OUTPUT\"\n74\tif [[ -n \"$existing_pr\" ]]; then\n75\t  existing_body=$(gh pr view \"$existing_pr\" --json body --jq '.body')\n76\t  body=$(printf '%s' \"$existing_body\" | callisto compose-pr-body --existing-body - --branch \"$INPUT_BRANCH\" --format text)\n77\telse\n78\t  body=$(callisto compose-pr-body --branch \"$INPUT_BRANCH\" --format text)\n79\tfi\n80\t\n81\tread -ra command <<< \"$INPUT_VERSION_COMMAND\"\n82\tcommand+=(--emit-decision \"$INPUT_DECISION_PATH\")\n83\t\"${command[@]}\"\n84\tgit add -A\n85\ttest -n \"$(git status --porcelain)\" || { echo '::error::pending changesets produced no release-PR delta'; exit 1; }\n86\t\n87\tplan_file=$(mktemp)\n88\tcallisto --format json release-pr commit-plan --base-commit \"$base_commit\" --message \"$INPUT_COMMIT_MESSAGE\" --out \"$plan_file\"\n89\tlocal_tree=$(git write-tree)\n90\t\n91\tstaging_created=false\n92\tcleanup_staging() {\n93\t  if [[ \"$staging_created\" == true ]]; then\n94\t    gh api -X DELETE \"repos/$GITHUB_REPOSITORY/git/refs/heads/$staging_branch\" > /dev/null 2>&1 \\\n95\t      || echo \"::warning::could not delete staging branch $staging_branch; the next run reclaims this deterministic name\"\n96\t  fi\n97\t  rm -f \"$plan_file\" body.json\n98\t}\n99\ttrap cleanup_staging EXIT\n100\t\n101\t# A local diff does not authorize a stale forge write. Re-observe immediately\n102\t# before mutating the remote branch, then again before moving the managed\n103\t# ref, then again before GitHub label/PR writes.\n104\tcallisto release-pr verify --decision \"$decision\" --snapshot \"$(release_pr_snapshot)\" > /dev/null\n105\t\n106\tif gh api -X PATCH \"repos/$GITHUB_REPOSITORY/git/refs/heads/$staging_branch\" -f sha=\"$base_commit\" -F force=true > /dev/null 2>&1; then\n107\t  :\n108\telse\n109\t  gh api -X POST \"repos/$GITHUB_REPOSITORY/git/refs\" -f ref=\"refs/heads/$staging_branch\" -f sha=\"$base_commit\" > /dev/null"}]},"uuid":"3d21b3e8-afb6-4a7a-a5bf-15c28e7ae6d3","timestamp":"2026-10-24T22:58:43.882Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main/.github/actions/callisto-action/scripts/create-or-update-release-pr.sh","content":"# deterministic staging branch rooted at the current base commit -- which\n# never needs to touch `.github/workflows/*`, since that path is inherited\n# unchanged from the base -- and only then is the managed branch's ref moved\n# onto that commit. A ref move is not itself a write to that path.\nset -euo pipefail\n\ncd \"$INPUT_CWD\"\n\n# This checkout starts on the configured base. Preserve its exact commit for\n# both observations; the working tree changes below (git add -A) never\n# create a local commit -- the real commit is made remotely, via the forge\n# commit API, on the staging branch.\nbase_commit=$(git rev-parse HEAD)\n\nrelease_pr_snapshot() {\n  local raw_prs\n  raw_prs=$(gh pr list --state open --base \"$INPUT_BRANCH\" --limit 1000 --json number,headRefName,headRepository,headRefOid)\n  jq -cn \\\n    --arg repository \"$GITHUB_REPOSITORY\" \\\n    --arg base_branch \"$INPUT_BRANCH\" \\\n    --arg base_commit \"$base_commit\" \\\n    --argjson raw_prs \"$raw_prs\" \\\n    '{\n      schemaVersion: 2,\n      repository: $repository,\n      baseBranch: $base_branch,\n      baseCommit: $base_commit,\n      openPullRequests: [$raw_prs[] | {\n        number,\n        headRepository: (.headRepository.nameWithOwner // \"\"),\n        headBranch: .headRefName,\n        headCommit: .headRefOid\n      }]\n    }'\n}\n\nsnapshot=$(release_pr_snapshot)\ndecision=$(callisto --format json release-pr decide \\\n  --snapshot \"$snapshot\" \\\n  --repository \"$GITHUB_REPOSITORY\" \\\n  --base-branch \"$INPUT_BRANCH\" \\\n  --release-branch \"$INPUT_RELEASE_BRANCH\")\ndecision_kind=$(jq -r '.action.kind' <<< \"$decision\")\n\ncase \"$decision_kind\" in\n  noop)\n    echo 'hasChangesets=false' >> \"$GITHUB_OUTPUT\"\n    echo '::notice::No changesets. This action does not publish, tag, download artifacts, or create releases; use the durable repository workflow.'\n    exit 0\n    ;;\n  create)\n    release_branch=$(jq -r '.action.branch' <<< \"$decision\")\n    staging_branch=$(jq -r '.action.stagingBranch' <<< \"$decision\")\n    existing_pr=''\n    ;;\n  update)\n    existing_pr=$(jq -r '.action.pullRequestNumber' <<< \"$decision\")\n    release_branch=$(jq -r '.action.branch' <<< \"$decision\")\n    staging_branch=$(jq -r '.action.stagingBranch' <<< \"$decision\")\n    ;;\n  *) echo \"::error::Callisto returned unsupported release PR decision kind: $decision_kind\"; exit 1 ;;\nesac\n\necho 'hasChangesets=true' >> \"$GITHUB_OUTPUT\"\nif [[ -n \"$existing_pr\" ]]; then\n  existing_body=$(gh pr view \"$existing_pr\" --json body --jq '.body')\n  body=$(printf '%s' \"$existing_body\" | callisto compose-pr-body --existing-body - --branch \"$INPUT_BRANCH\" --format text)\nelse\n  body=$(callisto compose-pr-body --branch \"$INPUT_BRANCH\" --format text)\nfi\n\nread -ra command <<< \"$INPUT_VERSION_COMMAND\"\ncommand+=(--emit-decision \"$INPUT_DECISION_PATH\")\n\"${command[@]}\"\ngit add -A\ntest -n \"$(git status --porcelain)\" || { echo '::error::pending changesets produced no release-PR delta'; exit 1; }\n\nplan_file=$(mktemp)\ncallisto --format json release-pr commit-plan --base-commit \"$base_commit\" --message \"$INPUT_COMMIT_MESSAGE\" --out \"$plan_file\"\nlocal_tree=$(git write-tree)\n\nstaging_created=false\ncleanup_staging() {\n  if [[ \"$staging_created\" == true ]]; then\n    gh api -X DELETE \"repos/$GITHUB_REPOSITORY/git/refs/heads/$staging_branch\" > /dev/null 2>&1 \\\n      || echo \"::warning::could not delete staging branch $staging_branch; the next run reclaims this deterministic name\"\n  fi\n  rm -f \"$plan_file\" body.json\n}\ntrap cleanup_staging EXIT\n\n# A local diff does not authorize a stale forge write. Re-observe immediately\n# before mutating the remote branch, then again before moving the managed\n# ref, then again before GitHub label/PR writes.\ncallisto release-pr verify --decision \"$decision\" --snapshot \"$(release_pr_snapshot)\" > /dev/null\n\nif gh api -X PATCH \"repos/$GITHUB_REPOSITORY/git/refs/heads/$staging_branch\" -f sha=\"$base_commit\" -F force=true > /dev/null 2>&1; then\n  :\nelse\n  gh api -X POST \"repos/$GITHUB_REPOSITORY/git/refs\" -f ref=\"refs/heads/$staging_branch\" -f sha=\"$base_commit\" > /dev/null","numLines":100,"startLine":10,"totalLines":188}},"sourceToolAssistantUUID":"89843228-77e4-496d-844f-e27a34ba6baf","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/smoke-main","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.308","gitBranch":"fix/release-pr-stage-only","slug":"lexical-jingling-puppy"}
