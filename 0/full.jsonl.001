result: Script completed\nWall time 2.9 seconds\nOutput:\n\ncargo test: 188 passed (2 suites, 0.42s)\n\nexit=0\n","type":"input_text"},{"text":"\n[92] tool send_message call: {\"target\":\"/root\",\"message\":\"REDACTED\"}\n","type":"input_text"},{"text":"\n[93] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '1,760p' crates/callisto-graph/src/commands/release.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":40000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[94] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\n//! Fresh, graph-owned authorization for durable release intents.\n//!\n//! This module intentionally takes a root, locator, and runner rather than a\n//! [`Workspace`]. A workspace caches parsed manifests and config for a normal\n//! command invocation; accepting one here would make a previously observed\n//! graph look current after the filesystem changed.\n\nuse std::collections::{BTreeMap, BTreeSet};\nuse std::path::Path;\n\nuse callisto_model::{\n    ApplyPermit, ApprovedRegistryArtifact, CanonicalTranscript, CommandRunner, CommitSha, Ecosystem, GitHubRepository,\n    GitHubRepositoryParseError, NpmAccess, OperationOutcome, ProductName, ProductReleaseId, ProductTarget,\n    RegistryArtifactFormat, RegistryBindingDigest, RegistryBindingId, RegistryKey, RegistryPublicationPolicy,\n    ReleaseArtifactSlot, ReleaseDecisionV1, ReleaseDestinationBinding, ReleaseDestinationKind, ReleaseIntent,\n    ReleaseOperation, ReleaseOperationId, ReleasePackageId, TagName, Version,\n};\nuse callisto_vcs::{\n    access::{GitCommitTrustEvidence, GitHeadDisposition},\n    release_lock::ReleaseWorkspaceLock,\n    GitDataSource, TagSignPolicy,\n};\n\nuse crate::error::{\n    CommandFailure, ReleasePreconditionRequirement, ReleaseSelectionInvalidReason, UnsupportedReleaseFeature,\n};\nuse crate::{commands::registry_argv, DependencyResolver, GraphError, ProjectLocator, Workspace};\n\nuse super::{\n    registry_artifacts::{cargo_upload_body, CargoAuthorizationHeader, PrivateArtifactFile},\n    release_artifacts::ValidatedArtifactManifest,\n    release_observation::{observe_prepared, MissingWork, ObservationSession, OperationObservation},\n};\n\nconst PROVIDER_EFFECT_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(300);\n\n/// Reason carried by [`GraphError::ReleaseIntentStale`] (E124); real reasons are constructible only from this module.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct StaleReason {\n    kind: StaleKind,\n}\n\n#[derive(Clone,\u003ctruncated omitted_approx_tokens=\"6101\" /\u003etory.as_slug();\n        let title = tag.as_str();\n        let args = [\n            \"release\",\n            \"create\",\n            tag.as_str(),\n            \"--repo\",\n            repository.as_str(),\n            \"--verify-tag\",\n            \"--draft\",\n            \"--title\",\n            title,\n            \"--notes\",\n            \"\",\n        ];\n        let output = self\n            .runner\n            .run_with_timeout(\"gh\", \u0026args, \u0026self.prepared.root, PROVIDER_EFFECT_TIMEOUT)?;\n        require_command_success(\"gh\", \u0026args, output)\n    }\n\n    fn dispatch_forge_asset(\n        \u0026self,\n        artifacts: \u0026ValidatedArtifactManifest\u003c'_, '_\u003e,\n        slot: \u0026ReleaseArtifactSlot,\n    ) -\u003e Result\u003c(), GraphError\u003e {\n        let snapshot = artifacts.snapshot(slot)?;\n        let private = PrivateArtifactFile::new(slot.file_name(), snapshot.bytes())?;\n        let tag = self.intent.product_release().tag();\n        let repository = self.intent.destination().forge_repository().as_slug();\n        let path = private.path().to_string_lossy();\n        let args = [\n            \"release\",\n            \"upload\",\n            tag.as_str(),\n            path.as_ref(),\n            \"--repo\",\n            repository.as_str(),\n        ];\n        let output = self\n            .runner\n            .run_with_timeout(\"gh\", \u0026args, private.directory(), PROVIDER_EFFECT_TIMEOUT)?;\n        require_command_success(\"gh\", \u0026args, output)\n    }\n\n    fn dispatch_forge_publish(\u0026self, repository: \u0026GitHubRepository, tag: \u0026TagName) -\u003e Result\u003c(), GraphError\u003e {\n        let repository = repository.as_slug();\n        let args = [\n            \"release\",\n            \"edit\",\n            tag.as_str(),\n            \"--repo\",\n            repository.as_str(),\n            \"--verify-tag\",\n            \"--draft=false\",\n        ];\n        let output = self\n            .runner\n            .run_with_timeout(\"gh\", \u0026args, \u0026self.prepared.root, PROVIDER_EFFECT_TIMEOUT)?;\n        require_command_success(\"gh\", \u0026args, output)\n    }\n\n","type":"input_text"},{"text":"\n[95] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '760,1050p' crates/callisto-graph/src/commands/release.rs \u0026\u0026 rtk sed -n '450,550p' crates/callisto-graph/src/error.rs \u0026\u0026 rtk sed -n '1,340p' crates/callisto-model/src/exec.rs \u0026\u0026 rtk sed -n '1,380p' crates/callisto-cli/src/runner.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":50000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[96] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\nWarning: truncated output (original token count: 11241)\nTotal output lines: 1100\n\n    }\n}\n\nfn operation_is_satisfied(id: \u0026ReleaseOperationId, observed: \u0026OperationObservation) -\u003e bool {\n    match observed {\n        OperationObservation::Exact(_) =\u003e true,\n        OperationObservation::Incomplete(partial) =\u003e match id {\n            ReleaseOperationId::RegistryArtifactPublish { slot, .. } =\u003e {\n                !partial.missing().contains(\u0026MissingWork::RegistryArtifact(slot.clone()))\n            }\n            _ =\u003e false,\n        },\n        _ =\u003e false,\n    }\n}\n\nfn ensure_operation_is_missing(id: \u0026ReleaseOperationId, observed: \u0026OperationObservation) -\u003e Result\u003c(), GraphError\u003e {\n    match observed {\n        OperationObservation::Absent\n            if matches!(\n                id,\n                ReleaseOperationId::RegistryArtifactPublish { .. }\n                    | ReleaseOperationId::ProductTag { .. }\n                    | ReleaseOperationId::ForgePrepare { .. }\n                    | ReleaseOperationId::ArtifactUpload { .. }\n            ) =\u003e\n        {\n            Ok(())\n        }\n        OperationObservation::Incomplete(partial) =\u003e match id {\n            ReleaseOperationId::RegistryArtifactPublish { slot, .. }\n                if partial.missing().contains(\u0026MissingWork::RegistryArtifact(slot.clone())) =\u003e\n            {\n                Ok(())\n            }\n            ReleaseOperationId::ForgePublish { release, .. }\n                if partial.missing().len() == 1\n                    \u0026\u0026 partial\n                        .missing()\n                        .contains(\u0026MissingWork::PublishForgeRelease(release.clone())) =\u003e\n            {\n                Ok(())\n            }\n            _ =\u003e Err(GraphError::ReleaseOperationNotMissing { operation: id.clone() }),\n        },\n        OperationObservation::Conflict(_) =\u003e Err(GraphError::ReleaseObservationConflict { operation: id.clone() }),\n        OperationObservation::Unv\u003ctruncated omitted_approx_tokens=\"9040\" /\u003e                 }\n                            if stderr_mode == StderrMode::Live {\n                                let line = redact_known_secrets(\u0026String::from_utf8_lossy(\u0026pending_line), \u0026live_secrets);\n                                eprintln!(\"{line}\");\n                            }\n                            pending_line.clear();\n               