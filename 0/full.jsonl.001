   Ok(())\n        }\n        OperationObservation::Incomplete(partial) =\u003e match id {\n            ReleaseOperationId::RegistryArtifactPublish { slot, .. }\n                if partial.missing().contains(\u0026MissingWork::RegistryArtifact(slot.clone())) =\u003e\n            {\n                Ok(())\n            }\n            ReleaseOperationId::ForgePublish { release, .. }\n                if partial.missing().len() == 1\n                    \u0026\u0026 partial\n                        .missing()\n                        .contains(\u0026MissingWork::PublishForgeRelease(release.clone())) =\u003e\n            {\n                Ok(())\n            }\n            _ =\u003e Err(GraphError::ReleaseOperationNotMissing { operation: id.clone() }),\n        },\n        OperationObservation::Conflict(_) =\u003e Err(GraphError::ReleaseObservationConflict { operation: id.clone() }),\n        OperationObservation::Unv\u003ctruncated omitted_approx_tokens=\"9040\" /\u003e                 }\n                            if stderr_mode == StderrMode::Live {\n                                let line = redact_known_secrets(\u0026String::from_utf8_lossy(\u0026pending_line), \u0026live_secrets);\n                                eprintln!(\"{line}\");\n                            }\n                            pending_line.clear();\n                        } else if pending_line.len() \u003c MAX_CAPTURED_OUTPUT_BYTES {\n                            pending_line.push(b);\n                        }\n                    }\n                    if !truncated {\n                        let remaining = MAX_CAPTURED_OUTPUT_BYTES - captured.len();\n                        let take = data.len().min(remaining);\n                        captured.extend_from_slice(\u0026data[..take]);\n                        if take \u003c data.len() {\n                            truncated = true;\n                        }\n                    }\n                }\n                Err(_) =\u003e break,\n   