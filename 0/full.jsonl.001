n                            pending_line.clear();\n                        } else if pending_line.len() \u003c MAX_CAPTURED_OUTPUT_BYTES {\n                            pending_line.push(b);\n                        }\n                    }\n                    if !truncated {\n                        let remaining = MAX_CAPTURED_OUTPUT_BYTES - captured.len();\n                        let take = data.len().min(remaining);\n                        captured.extend_from_slice(\u0026data[..take]);\n                        if take \u003c data.len() {\n                            truncated = true;\n                        }\n                    }\n                }\n                Err(_) =\u003e break,\n            }\n        }\n        if !pending_line.is_empty() {\n            if pending_line.last() == Some(\u0026b'\\r') {\n                pending_line.pop();\n            }\n            if stderr_mode == StderrMode::Live {\n                let line = redact_known_secrets(\u0026String::from_utf8_lossy(\u0026pending_line), \u0026live_secrets);\n                eprintln!(\"{line}\");\n            }\n        }\n        let mut text = String::from_utf8_lossy(\u0026captured).into_owned();\n        if truncated {\n            text.push_str(\"\\n...[output truncated]\\n\");\n        }\n        drop(stderr_tx.send(text));\n    });\n\n    // Grace period to wait for the reader threads after the direct\n    // child has exited (or been killed). Bounded so a lingering\n    // descendant holding the pipe open can never hang the caller.\n    const READER_GRACE: Duration = Duration::from_secs(3);\n\n    let deadline = Instant::now() + timeout;\n    let status = loop {\n        match child.try_wait().map_err(|e| CommandError::Io {\n            program: program.to_string(),\n\n","type":"input_text"},{"text":"\n[82] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '600,710p' crates/callisto-graph/src/error.rs \u0026\u0026 rtk rg -n \\\"PreparedCredentialEnvPolicy|credential_env|NPM_TOKEN|CARGO_REGISTR\\\" crates/callisto-graph/src/commands/release.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":12000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[83] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\n    #[error(\"bump reason\")]\n    BumpReason,\n    #[error(\"publish target\")]\n    PublishTarget,\n}\n\n/// Why a `--package` release selection is invalid, carried by\n/// [`GraphError::ReleaseSelectionInvalid`] (E169).\n#[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]\npub enum ReleaseSelectionInvalidReason {\n    #[error(\"the package is selected more than once\")]\n    Duplicate,\n    #[error(\"the package is not part of this release plan\")]\n    NotInPlan,\n    #[error(\"the package has a duplicate registry target\")]\n    DuplicateRegistryTarget,\n}\n\n/// An unmet precondition for a release operation, carried by\n/// [`GraphError::ReleasePreconditionUnmet`] (E170).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]\npub enum ReleasePreconditionRequirement {\n    #[error(\"a detached HEAD\")]\n    DetachedHead,\n    #[error(\"the canonical root to match the workspace root\")]\n    CanonicalRootMatchesWorkspace,\n    #[error(\"a git remote prepared during validation\")]\n    GitRemotePrepared,\n    #[error(\"a GitHub remote\")]\n    GitHubRemote,\n    #[error(\"a configured changelog\")]\n    ChangelogConfigured,\n    #[error(\"a provided artifact manifest\")]\n    ArtifactManifestProvided,\n    #[error(\"the prepared registry credential environment variable\")]\n    RegistryCredential,\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use callisto_vcs::VcsError;\n\n    /// Spec: GraphError::Vcs must be transparent — wrapping a VcsError must\n    /// not add any prefix (e.g. \"vcs error: \") to the display message.\n    /// Before the fix, format!(\"{err}\") produces \"vcs error: \u003cinner\u003e\".\n    #[test]\n    fn graph_error_vcs_is_transparent_no_prefix() {\n        let inner = VcsError::Git(\"some git error\".to_string());\n        let expected_msg = format!(\"{inner}\");\n        let graph_err = GraphError::Vcs(inner);\n        assert_eq!(\n            format!(\"{graph_err}\"),\n            expected_msg,\n            \"GraphError::Vcs must be transpar\u003ctruncated omitted_approx_tokens=\"410\" /\u003e` is claimed by more than one [[package-set]]: {}\", .patterns.join(\", \"))]\n    OverlappingPackageSets { package: String, patterns: Vec\u003cString\u003e },\n\n    #[error(\"group `{group}` and group `{other}` both list `{member}`\")]\n    ConflictingGroupNames {\n        group: GroupName,\n        other: GroupName,\n        member: String,\n    },\n\n    #[error(\"group `{group}` has no members\")]\n    EmptyGroup { group: GroupName },\n\n    #[error(\"duplicate group name `{group}`\")]\n26 matches in 1 files:\n\n126:credential: PreparedCredentialEnvPolicy,\n130:enum PreparedCredentialEnvPolicy {\n178:pub(super) enum PreparedCredentialEnvPolicyView\u003c'a\u003e {\n202:credential: PreparedCredentialEnvPolicyView\u003c'a\u003e,\n314:PreparedCredentialEnvPolicy::CargoToken { env_name } =\u003e {\n315:PreparedCredentialEnvPolicyView::CargoToken { env_name }\n317:PreparedCredentialEnvPolicy::NpmToken { env_name } =\u003e {\n318:PreparedCredentialEnvPolicyView::NpmToken { env_name }\n320:PreparedCredentialEnvPolicy::PypiToken {\n323:} =\u003e PreparedCredentialEnvPolicyView::PypiToken {\n581:PreparedCredentialEnvPolicy::CargoToken { env_name },\n617:PreparedCredentialEnvPolicy::NpmToken { env_name },\n641:PreparedCredentialEnvPolicy::PypiToken {\n1222:) -\u003e Result\u003cPreparedCredentialEnvPolicy, GraphError\u003e {\n1239:Ecosystem::Cargo =\u003e Ok(PreparedCredentialEnvPolicy::CargoToken {\n1241:\"CARGO_REGISTRY_TOKEN\".to_string()\n1243:format!(\"CARGO_REGISTRIES_{normalized_key}_TOKEN\")\n1246:Ecosystem::Npm =\u003e Ok(PreparedCredentialEnvPolicy::NpmToken { env_name: \"NPM_T...\n1247:Ecosystem::Pypi =\u003e Ok(PreparedCredentialEnvPolicy::PypiToken {\n1941:fn registry_credential_environment_policy_is_closed_and_key_derived() {\n1944:PreparedCredentialEnvPolicy::CargoToken {\n1945:env_name: \"CARGO_REGISTRY_TOKEN\".to_string()\n1950:PreparedCredentialEnvPolicy::CargoToken {\n1951:env_name: \"CARGO_REGISTRIES_REHEARSAL_CARGO_TOKEN\".to_string()\n1956:PreparedCredentialEnvPolicy::NpmToken { env_name: \"NPM_TOKEN\" }\n  +1 more in crates/callisto-graph/src/commands/release.rs\n\n","type":"input_text"},{"text":"\n[84] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/commands/release.rs\\n@@\\n             (\\n                 RegistryArtifactFormat::NpmTarball,\\n                 RegistryPublicationPolicy::Npm { access, dist_tag },\\n                 PreparedRegistryEndpoints::Npm { registry: endpoint },\\n                 PreparedCredentialEnvPolicy::NpmToken { env_name },\\n             ) =\u003e {\\n+                if std::env::var(env_name).is_err() {\\n+                    return Err(GraphError::ReleasePreconditionUnmet {\\n+                        requirement: ReleasePreconditionRequirement::RegistryCredential,\\n+                    });\\n+                }\\n                 let private = PrivateArtifactFile::new(slot.file_name(), snapshot.bytes())?;\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n","type":"input_text"},{"text":"\n[85] tool exec result: Script completed\nWall time 3.3 seconds\nOutput:\n\n{}\n","type":"input_text"},{"text":"\n[86] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '1,500p' crates/callisto-graph/src/commands/registry_artifacts.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":30000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[87] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\n//! Exact-byte registry upload preparation.\n//!\n//! These helpers never inspect a source checkout. Their sole payload input is\n//! the byte snapshot revalidated by `ValidatedArtifactManifest` immediately\n//! before dispatch.\n\nuse std::{collections::BTreeMap, io::Read, io::Write, path::PathBuf};\n\nuse callisto_model::{ReleasePackageId, Version};\n\nuse crate::GraphError;\n\nconst MAX_CRATE_BYTES: usize = 100 * 1024 * 1024;\nconst MAX_ARCHIVE_ENTRIES: usize = 100_000;\nconst MAX_ARCHIVE_ENTRY_BYTES: u64 = 128 * 1024 * 1024;\nconst MAX_ARCHIVE_TOTAL_BYTES: u64 = 512 * 1024 * 1024;\nconst MAX_MANIFEST_BYTES: u64 = 2 * 1024 * 1024;\nconst MAX_README_BYTES: u64 = 2 * 1024 * 1024;\nconst MAX_METADATA_BYTES: usize = 4 * 1024 * 1024;\n\n/// A private temporary copy of one already-validated artifact.\npub(super) struct PrivateArtifactFile {\n    _directory: tempfile::TempDir,\n    path: PathBuf,\n}\n\nimpl PrivateArtifactFile {\n    pub(super) fn new(file_name: \u0026str, bytes: \u0026[u8]) -\u003e Result\u003cSelf, GraphError\u003e {\n        if std::path::Path::new(file_name).components().count() != 1 {\n            return Err(invalid_artifact(\"artifact name is not one basename\"));\n        }\n        let directory = tempfile::tempdir().map_err(|error| invalid_artifact(error.to_string()))?;\n        let path = directory.path().join(file_name);\n        std::fs::write(\u0026path, bytes).map_err(|error| invalid_artifact(error.to_string()))?;\n        Ok(Self {\n            _directory: directory,\n            path,\n        })\n    }\n\n    pub(super) fn path(\u0026self) -\u003e \u0026std::path::Path {\n        \u0026self.path\n    }\n\n    /// Writes credential-free npm configuration which refers to the fixed\n    /// credential environment variable by name. The token itself never enters\n    /// a file or argv.\n    pub(super) fn write_npm_config(\u0026self, registry: \u0026str, token_env: \u0026str) -\u003e Result\u003c(), GraphError\u003e {\n        if !token_env\n            .bytes()\n            .all(|byte| byte.is_ascii_up\u003ctruncated omitted_approx_tokens=\"4064\" /\u003edemo() {}\\n\"),\n        ]);\n        let package = ReleasePackageId::new(Ecosystem::Cargo, \"demo\").unwrap();\n        let body = cargo_upload_body(\u0026bytes, \u0026package, \u0026Version::semver(1, 2, 3)).unwrap();\n        let metadata_length = u32::from_le_bytes(body[..4].try_into().unwrap()) as usize;\n        let metadata: serde_json::Value = serde_json::from_slice(\u0026body[4..4 + metadata_length]).unwrap();\n        let crate_length_offset = 4 + metadata_length;\n        let crate_length = u32::from_le_bytes(body[crate_length_offset..crate_length_offset + 4].try_into().unwrap());\n        assert_eq!(metadata[\"name\"], \"demo\");\n        assert_eq!(metadata[\"vers\"], \"1.2.3\");\n        assert_eq!(metadata[\"readme\"], \"# Demo\\n\");\n        assert_eq!(metadata[\"deps\"][0][\"name\"], \"serde\");\n        assert_eq!(crate_length as usize, bytes.len());\n        assert_eq!(\u0026body[crate_length_offset + 4..], bytes);\n    }\n\n    #[test]\n    fn cargo_body_rejects_archive_escape_and_identity_drift() {\n        let escaped = crate_bytes(\u0026[(\"other/Cargo.toml\", b\"[package]\\nname='demo'\\nversion='1.2.3'\\n\")]);\n        let package = ReleasePackageId::new(Ecosystem::Cargo, \"demo\").unwrap();\n        assert!(cargo_upload_body(\u0026escaped, \u0026package, \u0026Version::semver(1, 2, 3)).is_err());\n\n        let drifted = crate_bytes(\u0026[(\"demo-1.2.3/Cargo.toml\", b\"[package]\\nname='demo'\\nversion='9.9.9'\\n\")]);\n        assert!(cargo_upload_body(\u0026drifted, \u0026package, \u0026Version::semver(1, 2, 3)).is_err());\n    }\n\n    #[test]\n    fn npm_config_references_env_name_without_materializing_secret() {\n        let artifact = PrivateArtifactFile::new(\"demo.tgz\", b\"exact\").unwrap();\n        artifact\n            .write_npm_config(\"https://registry.example.test/npm/\", \"NPM_TOKEN\")\n            .unwrap();\n        let config = std::fs::read_to_string(artifact.directory().join(\".npmrc\")).unwrap();\n        assert!(config.contains(\"//registry.example.test/npm/:_authToken=${NPM_TOKEN}\"));\n        assert!(!config.contains(\"exact\"));\n    }\n}\n\n","type":"input_text"},{"text":"\n[88] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"push.*tag|push_tag|create_tag|remote.*tag|readback|TagPush\\\" crates/callisto-vcs crates/callisto-graph/src/commands | head -200\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":20000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[89] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\n139 matches in 8 files:\n\ncrates/callisto-graph/src/commands/mod.rs:36:pub use tag::{create_tags, create_tags_with_options, TagOptions};\ncrates/callisto-graph/src/commands/release.rs:691:callisto_vcs::GitAccess::discover(\u0026self.prepared.root, self.runner).create_tag(\ncrates/.../commands/release_observation.rs:273:match GitAccess::discover(validated.root(), validated.runner()).observe_remot...\ncrates/.../commands/release_observation.rs:285:OperationObservation::Exact(ReleaseObservationEvidence::remote_tag(\ncrates/.../commands/release_observation.rs:535:if let Some(failure) = require_exact_remote_tag(artifacts, validated) {\ncrates/.../commands/release_observation.rs:562:if let Some(failure) = require_exact_remote_tag(artifacts, validated) {\ncrates/.../commands/release_observation.rs:592:if let Some(failure) = require_exact_remote_tag(artifacts, validated) {\ncrates/.../commands/release_observation.rs:682:fn require_exact_remote_tag(\ncrates/.../commands/release_observation.rs:1129:remote_tag: Arc\u003cMutex\u003cRemoteTagPlan\u003e\u003e,\ncrates/.../commands/release_observation.rs:1149:fn set_exact_remote_tag(\u0026self, name: \u0026TagName, target: \u0026callisto_model::Commi...\ncrates/.../commands/release_observation.rs:1150