ad_before = git(root, \u0026[\"rev-parse\", \"HEAD\"]);\n+    let external = tempfile::tempdir().unwrap();\n+    let out = external.path().join(\"must-not-exist.json\");\n+\n+    // Preserve the root marker while making the membership field malformed.\n+    // `crates/core` remains an otherwise discoverable package below it.\n+    fs::write(root.join(\"Cargo.toml\"), \"[workspace]\\nmembers = [\\\"\").unwrap();\n+\n+    let result = callisto(\n+        root,\n+        \u0026[\n+            \"release\",\n+            \"plan\",\n+            \"--from-release-commit\",\n+            \u0026release_commit,\n+            \"--decision\",\n+            DECISION_PATH,\n+            \"--out\",\n+            out.to_str().unwrap(),\n+        ],\n+    );\n+\n+    assert!(\n+        !result.status.success(),\n+        \"malformed root authority must rej\u003ctruncated omitted_approx_tokens=\"1786\" /\u003eude_str!(\"../locate/ignore_walk.rs\");\n+\n+        for reader in [\n+            \"read_membership(\",\n+            \"read_cargo_membership(\",\n+            \"read_python_membership(\",\n+            \"read_package_json_membership(\",\n+            \"read_pnpm_membership(\",\n+            \"read_npm_membership(\",\n+        ] {\n+            let signature = membership\n+                .find(\u0026format!(\"fn {reader}\"))\n+                .unwrap_or_else(|| panic!(\"membership reader `{reader}` must remain inventoried\"));\n+            let source_after_signature = \u0026membership[signature..];\n+            let signature_end = source_after_signature\n+                .find('{')\n+                .unwrap_or_else(|| panic!(\"membership reader `{reader}` must have a body\"));\n+            assert!(\n+                source_after_signature[..signature_end].contains(\"Result\u003cMembershipAuthority\"),\n+                \"membership reader `{reader}` must not encode invalid authority as bool or Option\"\n+            );\n+        }\n+\n+        for fallback in [\n+            \"Err(_) =\u003e Ok(MembershipAuthority::Absent)\",\n+            \"Err(_) =\u003e MembershipAuthority::Absent\",\n+            \".ok().map(|_| MembershipAuthority::Absent)\",\n+            \"Err(_) =\u003e NegatableGlobSet::empty()\",\n+        ] {\n+            assert!(\n+                !membership.contains(fallback),\n+                \"membership parser must not add the fail-open fallback `{fallback}`\"\n+            );\n+        }\n+\n+        let projects = \u0026locator[locator\n+            .find(\"fn projects(\u0026self)\")\n+            .expect(\"IgnoreWalkLocator::projects must remain the immediate authority consumer\")..];\n+        let prewalk = \u0026projects[..projects\n+            .find(\"let walker = WalkBuilder::new\")\n+            .expect(\"membership authority must be resolved before WalkBuilder construction\")];\n+        for propagation in [\n+            \"read_cargo_membership(\u0026self.root)?\",\n  ... (17 additions truncated)\n  +117 -0\n[full diff: rtk git diff --no-compact]\n\n","type":"input_text"},{"text":"\n[68] tool wait_agent call: {\"timeout_ms\":60000}\n","type":"input_text"},{"text":"\n[69] tool wait_agent result: {\"message\":\"Wait timed out.\",\"timed_out\":true}\n","type":"input_text"},{"text":"\n[70] tool list_agents call: {}\n","type":"input_text"},{"text":"\n[71] tool list_agents result: {\"agents\":[{\"agent_name\":\"/root\",\"agent_status\":\"running\"},{\"agent_name\":\"/root/implement_convergence_t2\",\"agent_status\":\"running\"},{\"agent_name\":\"/root/review_membership_m2\",\"agent_status\":\"running\"},{\"agent_name\":\"/root/review_orch_o1\",\"agent_status\":\"running\"}]}\n","type":"input_text"},{"text":"\n[72] tool wait_agent call: {\"timeout_ms\":60000}\n","type":"input_text"},{"text":"\n[73] tool wait_agent result: {\"message\":\"Wait completed.\",\"timed_out\":false}\n","type":"input_text"},{"text":"\n[74] assistant: Agent message from /root/review_orch_o1:\nMessage Type: FINAL_ANSWER\nTask name: /root\nSender: /root/review_orch_o1\nPayload:\nRe-review: functional pass, with two remaining mutation-test gaps.\n\n### [High] Activation job permits effectful `uses:` steps before the fail-closed script\n\n- **Status**: CONFIRMED\n- **Location**: `.github/tests/verify-release-workflow-contract.sh:38-52`\n- **Root Cause**: The verifier extracts and exact-matches the first `run: |` body, but does not require `production-activation.steps` to contain only that failing step.\n- **Unsafe Mutation**: Insert a credentialed composite/action `uses:` step before the existing fail step. The exact activation script and absence of `if`/`continue-on-error` remain true, so the contract passes, but effects can occur before the job fails.\n- **Required hardening**: Structurally require exactly one activation step, with only `name`, `shell`, and the exact `run` body—or add a mutation fixture inserting a `uses:` step before it.\n\n### [Medium] Just invocations may be skipped or tolerated while the task-runner contract passes\n\n- **Status**: CONFIRMED\n- **Location**: `.github/tests/test_release_workflow_task_runner.sh:21-39`\n- **Root Cause**: The test proves exact `run: just …` lines exist, but does not reject step-level `if` or `continue-on-error`.\n- **Unsafe Mutation**:\n  ```yaml\n  if: ${{ false }}\n  run: just test-release-workflow-contract\n  ```\n  or:\n  ```yaml\n  continue-on-error: true\n  run: just test-release-workflow-contract\n  ```\n  Both preserve the asserted line while CI skips or ignores the contract.\n- **Required hardening**: Validate each named contract step is unconditional and not `continue-on-error`; add corresponding mutation fixtures.\n\nSecondary parsing defect: `.github/tests/test_release_workflow_task_runner.sh:35` terminates the test-job block at `audit:`, but no such job exists—the next job is `coverage:`. Consequently, the binary recipe line may appear anywhere from `test` through EOF and still satisfy the “test job” assertion.\n\nVerified:\n\n- All five new unsafe workflow fixtures are rejected.\n- Previous `always()`, activation condition/continue, early success, and mapped Environment gaps are closed.\n- `just test-release-workflow-contract` passed.\n- `just test-release-workflow-task-runner` passed.\n- ShellCheck passed.\n- The live workflow itself remains safely fail-closed; these are regression-contract gaps only.\n","type":"input_text"},{"text":"\n[75] tool exec call: const patch=\"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/.github/tests/verify-release-workflow-contract.sh\\n@@\\n production_activation=\\\"$(job_block production-activation execute)\\\"\\n+production_activation_job=\\\"$(sed '$d' \u003c\u003c\u003c \\\"$production_activation\\\")\\\"\\n+expected_activation_job=\\\"$(printf '%s\\\\n' \\\\\\n+  '  production-activation:' \\\\\\n+  '    name: Production activation is disabled pending rehearsal evidence' \\\\\\n+  '    needs: build' \\\\\\n+  '    runs-on: ubuntu-latest' \\\\\\n+  '    permissions:' \\\\\\n+  '      contents: read' \\\\\\n+  '    steps:' \\\\\\n+  '      - name: Fail closed until ORCH-008 validates exact-candidate rehearsal evidence' \\\\\\n+  '        shell: bash' \\\\\\n+  '        run: |' \\\\\\n+  '          set -euo pipefail' \\\\\\n+  \\\"          echo '::error::Production release is disabled until ORCH-008 validates exact-candidate rehearsal evidence.'\\\" \\\\\\n+  '          exit 1')\\\"\\n expected_activation_script=\\\"$(printf '%s\\\\n' \\\\\\n@@\\n-if [[ \\\"$activation_script\\\" != \\\"$expected_activation_script\\\" ]] \\\\\\n+if [[ \\\"$production_activation_job\\\" != \\\"$expected_activation_job\\\" ]] \\\\\\n+  || [[ \\\"$activation_script\\\" != \\\"$expected_activation_script\\\" ]] \\\\\\n@@\\n       activation-success)\\n         awk '{ if ($0 == \\\"          exit 1\\\") print \\\"          exit 0\\\"; print }' \\\"$workflow\\\" \u003e \\\"$mutated\\\"\\n         ;;\\n+      activation-extra-step)\\n+        awk '{ if ($0 == \\\"      - name: Fail closed until ORCH-008 validates exact-candidate rehearsal evidence\\\") print \\\"      - uses: dangerous/example@0123456789012345678901234567890123456789\\\"; print }' \\\"$workflow\\\" \u003e \\\"$mutated\\\"\\n+        ;;\\n@@\\n   expect_mutation_rejected activation-success\\n+  expect_mutation_rejected activation-extra-step\\n   expect_mutation_rejected execute-environment-mapping\\n fi\\n*** Update File: /private/tmp/callisto-release-recovery/.github/tests/test_release_workflow_task_runner.sh\\n@@\\n-ci_workflow=.github/workflows/callisto-ci.yml\\n+ci_wo\u003ctruncated omitted_approx_tokens=\"95\" /\u003errent }\\n+    END { printf \\\"%s\\\", found }\\n+  ' \u003c\u003c\u003c \\\"$workflow_block\\\"\\n+}\\n+\\n+require_unconditional_recipe_step() {\\n+  local workflow_block=\\\"$1\\\" recipe=\\\"$2\\\"\\n+  local step\\n+  step=\\\"$(step_for_recipe \\\"$workflow_block\\\" \\\"$recipe\\\")\\\"\\n+  if [[ -z \\\"$step\\\" ]] || rg -n '^[[:space:]]+(if|continue-on-error):' \u003c\u003c\u003c \\\"$step\\\" \u003e /dev/null; then\\n+    printf 'release workflow task-runner contract failed: just %s must run unconditionally and fail CI on error\\\\n' \\\"$recipe\\\" \u003e\u00262\\n+    exit 1\\n+  fi\\n+}\\n@@\\n for recipe in test-release-workflow-contract test-release-action test-release-workflow-task-runner; do\\n@@\\n   fi\\n+  require_unconditional_recipe_step \\\"$workflow_contracts\\\" \\\"$recipe\\\"\\n done\\n \\n-test_job=\\\"$(sed -n '/^  test:$/,/^  audit:$/p' \\\"$ci_workflow\\\")\\\"\\n+test_job=\\\"$(sed -n '/^  test:$/,/^  coverage:$/p' \\\"$ci_workflow\\\")\\\"\\n if ! rg -Fqx '        run: just test-release-action-binary' \u003c\u003c\u003c \\\"$test_job\\\"; then\\n@@\\n fi\\n+require_unconditional_recipe_step \\\"$test_job\\\" test-release-action-binary\\n@@\\n done\\n+\\n+if [[ \\\"${CALLISTO_SKIP_TASK_RUNNER_MUTATIONS:-0}\\\" != 1 ]]; then\\n+  mutation_dir=\\\"$(mktemp -d)\\\"\\n+  trap 'rm -rf \\\"$mutation_dir\\\"' EXIT\\n+\\n+  expect_ci_mutation_rejected() {\\n+    local name=\\\"$1\\\" property=\\\"$2\\\"\\n+    local mutated=\\\"$mutation_dir/$name.yml\\\"\\n+    awk -v property=\\\"$property\\\" '\\n+      $0 == \\\"        run: just test-release-workflow-contract\\\" { print \\\"        \\\" property }\\n+      { print }\\n+    ' \\\"$ci_workflow\\\" \u003e \\\"$mutated\\\"\\n+    if CALLISTO_CI_WORKFLOW=\\\"$mutated\\\" CALLISTO_SKIP_TASK_RUNNER_MUTATIONS=1 bash \\\"$0\\\" \u003e /dev/null 2\u003e\u00261; then\\n+      printf 'release workflow task-runner contract failed: unsafe CI mutation %s was not rejected\\\\n' \\\"$name\\\" \u003e\u00262\\n+      exit 1\\n+    fi\\n+  }\\n+\\n+  expect_ci_mutation_rejected skipped-contract 'if: ${{ false }}'\\n+  expect_ci_mutation_rejected tolerated-contract 'continue-on-error: true'\\n+fi\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n","type":"input_text"},{"text":"\n[76] tool exec result: Script completed\nWall time 5.2 seconds\nOutput:\n\n{}\n","type":"input_text"},{"text":"\n[77] tool exec call: const cmds=[\n\"rtk bash -n .github/tests/verify-release-workflow-contract.sh .github/tests/test_release_workflow_task_runner.sh\",\n\"rtk just test-release-workflow-contract\",\n\"rtk just test-release-workflow-task-runner\",\n\"rtk shellcheck .github/tests/verify-release-workflow-contract.sh .github/tests/test_release_workflow_task_runner.sh\",\n\"rtk git diff --check\"\n];\nfor (const cmd of cmds){\n const r=await tools.exec_command({cmd,workdir:\"/private/tmp/callisto-release-recovery\",yield_time_ms:30000,max_output_tokens:5000});\n text(`$ ${cmd}\\nexit=${r.exit_code}\\n${r.output}`);\n if(r.exit_code!==0) break;\n}\n\n","type":"input_text"},{"text":"\n[78] tool exec result: Script completed\nWall time 2.3 seconds\nOutput:\n\n$ rtk bash -n .github/tests/verify-release-workflow-contract.sh .github/tests/test_release_workflow_task_runner.sh\nexit=0\n\n$ rtk just test-release-workflow-contract\nexit=0\nbash .github/t