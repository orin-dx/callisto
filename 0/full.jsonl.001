istryArtifactFormat::PythonSdist =\u003e file_name.ends_with(\".tar.gz\"),\n        }\n    }\n\n    #[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, JsonSchema)]\n    #[serde(rename_all = \"camelCase\")]\n    pub enum ReleaseDestinationKind {\n        Production,\n        Rehearsal,\n    }\n\n    /// The complete credential-free destination selected for one release.\n    ///\n    /// Registry endpoints and credentials remain graph/provider concerns. The\n    /// durable model commits only to one normalized binding identity for each\n    /// supported package ecosystem and to the forge repository that receives\n    /// the coordinated tag and release.\n    #[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, JsonSchema)]\n    #[serde(rename_all = \"camelCase\", deny_unknown_fields)]\n    pub struct ReleaseDestinationBinding {\n        profile_name: String,\n        kind: ReleaseDestinationKind,\n        forge_repository: GitHubRepository,\n        cargo_registry: RegistryBindingId,\n        npm_registry: RegistryBindingId,\n        pypi_registry: RegistryBindingId,\n    }\n\n    #[derive(Deserialize)]\n    #[serde(rename_all = \"camelCase\", deny_unknown_fields)]\n    struct ReleaseDestinationBindingWire {\n        profile_name: String,\n        kind: ReleaseDestinationKind,\n        forge_repository: GitHubRepository,\n        cargo_registry: RegistryBindingId,\n        npm_registry: RegistryBindingId,\n        pypi_registry: RegistryBindingId,\n        where\n            D: Deserializer\u003c'de\u003e,\n        {\n            let wire = ReleaseDestinationBindingWire::deserialize(deserializer)?;\n            Self::new(\n                wire.profile_name,\n                wire.kind,\n                wire.forge_repository,\n                wire.cargo_registry,\n                wire.npm_registry,\n                wire.pypi_registry,\n            )\n            .map_err(serde::de::Error::custom)\n        }\n    }\n\n    #[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, JsonSchema)]\n    #[serde(rename_all = \"camelCase\", deny_unknown_fields)]\n    pub struct ProvenancePolicy {\n        repository: GitHubRepository,\n        workflow_path: String,\n        workflow_commit: CommitSha,\n        github_attestation_required: bool,\n    }\n\n    #[derive(Deserialize)]\n    #[serde(rename_all = \"camelCase\", deny_unknown_fields)]\n    struct ProvenancePolicyWire {\n        repository: GitHubRepository,\n        workflow_path: String,\n        workflow_commit: CommitSha,\n\n","type":"input_text"},{"text":"\n[92] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-model/src/release.rs\\n@@\\n-    #[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, JsonSchema)]\\n+    #[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, JsonSchema)]\\n@@\\n-    #[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, JsonSchema)]\\n+    #[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, JsonSchema)]\\n@@\\n-            version: String,\\n+            version: Version,\\n@@\\n-            version: Version,\\n+            version: String,\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n","type":"input_text"},{"text":"\u003e\u003e\u003e TRANSCRIPT END\n","type":"input_text"},{"text":"Reviewed Codex session id: 01a0acd3-01d3-7d63-92ca-cf9cd121858f\n","type":"input_text"},{"text":"\nSome conversation entries were omitted.\n","type":"input_text"},{"text":"The Codex agent has requested the following action:\n","type":"input_text"},{"text":"\u003e\u003e\u003e APPROVAL REQUEST START\n","type":"input_text"},{"text":"Assess the exact planned action below. Use read-only tool checks when local state matters.\n","type":"input_text"},{"text":"Planned action JSON:\n","type":"input_text"},{"text":"{\n  \"cwd\": \"/Users/gabe/Projects/callisto\",\n  \"files\": [\n    \"/private/tmp/callisto-release-recovery/crates/callisto-mode