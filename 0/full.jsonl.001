ialEnvPolicy::Cargo {\\n@@\\n-        Ecosystem::Npm => Ok(PreparedCredentialEnvPolicy::NpmToken { env_name: \\\"NPM_TOKEN\\\" }),\\n-        Ecosystem::Pypi => Ok(PreparedCredentialEnvPolicy::PypiToken {\\n+        Ecosystem::Npm => Ok(PreparedCredentialEnvPolicy::Npm { env_name: \\\"NPM_TOKEN\\\" }),\\n+        Ecosystem::Pypi => Ok(PreparedCredentialEnvPolicy::Pypi {\\n@@\\n-            PreparedCredentialEnvPolicy::CargoToken {\\n+            PreparedCredentialEnvPolicy::Cargo {\\n@@\\n-            PreparedCredentialEnvPolicy::CargoToken {\\n+            PreparedCredentialEnvPolicy::Cargo {\\n@@\\n-            PreparedCredentialEnvPolicy::CargoToken {\\n+            PreparedCredentialEnvPolicy::Cargo {\\n@@\\n-            PreparedCredentialEnvPolicy::NpmToken { env_name: \\\"NPM_TOKEN\\\" }\\n+            PreparedCredentialEnvPolicy::Npm { env_name: \\\"NPM_TOKEN\\\" }\\n@@\\n-            PreparedCredentialEnvPolicy::PypiToken {\\n+            PreparedCredentialEnvPolicy::Pypi {\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-model/src/release.rs\\n@@\\n-/// A terminal outcome safe to persist in a local execution journal.\\n+/// A provider effect outcome used only during one in-memory convergence pass.\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n"},{"type":"input_text","text":"\n[86] tool exec result: Script completed\nWall time 4.4 seconds\nOutput:\n\n{}\n"},{"type":"input_text","text":"\n[87] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '1,120p' crates/callisto-vcs/src/release_lock.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":12000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[88] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\n//! Process-scoped advisory locks for durable release execution.\n//!\n//! The lock is operational evidence, never part of a serialized intent. It\n//! prevents cooperating Callisto processes from validating and executing the\n//! same checkout concurrently; Git trust is still re-observed before effects.\n\n#[cfg(not(target_arch = \"wasm32\"))]\nuse std::fs::{self, File, OpenOptions};\nuse std::path::{Path, PathBuf};\n\n#[cfg(not(target_arch = \"wasm32\"))]\nuse fs2::FileExt;\n#[cfg(not(target_arch = \"wasm32\"))]\nuse sha2::{Digest, Sha256};\n\nuse crate::VcsError;\n\n/// An exclusive OS-backed advisory lock held for one canonical workspace.\n#[derive(Debug)]\npub struct ReleaseWorkspaceLock {\n    #[cfg(not(target_arch = \"wasm32\"))]\n    file: File,\n    path: PathBuf,\n}\n\nimpl ReleaseWorkspaceLock {\n    /// Acquires the workspace lock outside the checkout.\n    ///\n    /// `state_directory` exists for CI and tests. Without it, the lock lives\n    /// under the platform's application-state location.\n    pub fn acquire(canonical_root: &Path, state_directory: Option<&Path>) -> Result<Self, VcsError> {\n        #[cfg(target_arch = \"wasm32\")]\n        {\n            let _ = (canonical_root, state_directory);\n            return Err(VcsError::Git(\n                \"durable release execution is unavailable on wasm32\".to_string(),\n            ));\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        {\n            let path = lock_path(canonical_root, state_directory)?;\n            let parent = path.parent().expect(\"lock path always has a parent\");\n            fs::create_dir_all(parent)\n                .map_err(|_error| VcsError::Git(\"could not create release state directory\".to_string()))?;\n            let file = OpenOptions::new()\n                .create(true)\n                .read(true)\n                .write(true)\n                .truncate(false)\n                .open(&path)\n                .map_err(|_error| VcsError::Git(\"could<truncated omitted_approx_tokens=\"213\" />, etc.),\n/// which is reported with its real cause instead of being misattributed to\n/// a held lock.\n#[cfg(not(target_arch = \"wasm32\"))]\nfn classify_lock_acquire_error(error: std::io::Error) -> VcsError {\n    if error.kind() == fs2::lock_contended_error().kind() {\n        VcsError::Git(\"another Callisto release already holds this workspace lock\".to_string())\n    } else {\n        VcsError::Git(format!(\"could not acquire release workspace lock: {error}\"))\n    }\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nfn lock_path(canonical_root: &Path, state_directory: Option<&Path>) -> Result<PathBuf, VcsError> {\n    let base = match state_directory {\n        Some(path) => path.to_path_buf(),\n        None => platform_state_directory()?,\n    };\n    let digest = Sha256::digest(canonical_root.to_string_lossy().as_bytes());\n    let key = format!(\"{:x}\", digest);\n    Ok(base.join(\"callisto\").join(\"release-locks\").join(format!(\"{key}.lock\")))\n}\n\n/// Resolves Callisto's platform application-state base directory.\n///\n/// This is operational routing only; callers must still key state by a\n/// canonical workspace and durable intent rather than treating the location\n/// as release authority.\npub fn platform_state_directory() -> Result<PathBuf, VcsError> {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        return Err(VcsError::Git(\n            \"durable release execution is unavailable on wasm32\".to_string(),\n        ));\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    {\n        #[cfg(target_os = \"macos\")]\n        let candidate = std::env::var_os(\"HOME\").map(|home| PathBuf::from(home).join(\"Library/Application Support\"));\n        #[cfg(target_os = \"windows\")]\n        let candidate = std::env::var_os(\"LOCALAPPDATA\").map(PathBuf::from);\n        #[cfg(all(unix, not(target_os = \"macos\")))]\n        let candidate = std::env::var_os(\"XDG_STATE_HOME\")\n            .map(PathBuf::from)\n            .or_else(|| std::env::var_os(\"HOME\").map(|home| PathBuf::from(home).join(\".local/state\")));\n\n"},{"type":"input_text","text":"\n[89] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-vcs/src/release_lock.rs\\n@@\\n-    /// `state_directory` exists for CI and tests. Without it, the lock lives\\n-    /// under the platform's application-state location.\\n-    pub fn acquire(canonical_root: &Path, state_directory: Option<&Path>) -> Result<Self, VcsError> {\\n+    /// `lock_directory` exists for CI and tests. Without it, the lock lives\\n+    /// under the platform's application-data location.\\n+    pub fn acquire(canonical_root: &Path, lock_directory: Option<&Path>) -> Result<Self, VcsError> {\\n@@\\n-            let _ = (canonical_root, state_directory);\\n+            let _ = (canonical_root, lock_directory);\\n@@\\n-            let path = lock_path(canonical_root, state_directory)?;\\n+            let path = lock_path(canonical_root, lock_directory)?;\\n@@\\n-                .map_err(|_error| VcsError::Git(\\\"could not create release state directory\\\".to_string()))?;\\n+                .map_err(|_error| VcsError::Git(\\\"could not create release lock directory\\\".to_string()))?;\\n@@\\n-fn lock_path(canonical_root: &Path, state_directory: Option<&Path>) -> Result<PathBuf, VcsError> {\\n-    let base = match state_directory {\\n+fn lock_path(canonical_root: &Path, lock_directory: Option<&Path>) -> Result<PathBuf, VcsError> {\\n+    let base = match lock_directory {\\n@@\\n-/// Resolves Callisto's platform application-state base directory.\\n+/// Resolves Callisto's platform application-data base directory.\\n@@\\n-/// canonical workspace and durable intent rather than treating the location\\n-/// as release authority.\\n+/// canonical workspace rather than treating the location as release authority.\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n"},{"type":"input_text","text":"\n[90] tool exec result: Script completed\nWall time 3.3 seconds\nOutput:\n\n{}\n"},{"type":"input_text","text":"\n[91] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"CargoToken|NpmToken|PypiToken|PreparedCredentialEnvPolicyView\\\" crates/callisto-graph/src/commands/release.rs && rtk cargo check -p callisto-graph\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":30000,\"max_output_tokens\":30000});\ntext(r.output);\nif (r.session_id) text(`SESSION_ID=${r.session_id}`);\n\n"},{"type":"input_text","text":"\n[92] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\n"},{"type":"input_text","text":"\n[93] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk cargo check -p callisto-graph\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":30000,\"max_output_tokens\":30000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[94] tool exec result: Script completed\nWall time 6.3 seconds\nOutput:\n\ncargo check (6 crates compiled)\nFinished `dev` profile [unoptimized + debuginfo] target(s) in 5.95s\n\n"},{"type":"input_text","text":"\n[95] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"OperationBlockReason|OperationOutcome::(Failed|Blocked)|Blocked \\\\{ reason\\\" crates --glob '*.rs'\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":12000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[96] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\ncrates/callisto-model/src/release.rs:772:pub enum OperationBlockReason {\ncrates/callisto-model/src/release.rs:787:    Blocked { reason: OperationBlockReason },\ncrates/callisto-graph/src/commands/release_execution.rs:254:                OperationOutcome::Failed | OperationOutcome::Blocked { .. } => {\ncrates/callisto-model/src/lib.rs:64:    GitHubRepositoryParseError, IntentDigest, OperationBlockReason, OperationOutcome, RegistryBindingDigest,\n\n"},{"type":"input_text","text":"\n[97] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callist