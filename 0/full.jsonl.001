            Ok(Some(value)) =\u003e {\n                    let Some(raw_digest) = value\n                        .get(\"version\")\n                        .and_then(|version| version.get(\"checksum\"))\n                        \u003ctruncated omitted_approx_tokens=\"1124\" /\u003ekage: \u0026str,\n    version: \u0026Version,\n) -\u003e CachedObservation\u003cBTreeMap\u003cString, PypiDistribution\u003e\u003e {\n    let url = append_url_segments(metadata_endpoint, \u0026[package, \u0026version.render(), \"json\"]).ok_or(\n        ObservationFailure::MalformedResponse {\n            provider: ObservationProvider::Pypi,\n        },\n    )?;\n    let Some(value) = observe_json_http(validated.runner(), validated.root(), \u0026url, ObservationProvider::Pypi)? else {\n        return Ok(None);\n    };\n    let urls =\n        value\n            .get(\"urls\")\n            .and_then(serde_json::Value::as_array)\n            .ok_or(ObservationFailure::MalformedResponse {\n                provider: ObservationProvider::Pypi,\n            })?;\n    let mut distributions = BTreeMap::new();\n    for file in urls {\n        let file_name = file\n            .get(\"filename\")\n            .and_then(serde_json::Value::as_str)\n            .ok_or(ObservationFailure::MalformedResponse {\n                provider: ObservationProvider::Pypi,\n            })?\n            .to_string();\n        let byte_length =\n            file.get(\"size\")\n                .and_then(serde_json::Value::as_u64)\n                .ok_or(ObservationFailure::MalformedResponse {\n                    provider: ObservationProvider::Pypi,\n                })?;\n        let digest = file\n            .get(\"digests\")\n            .and_then(|digests| digests.get(\"sha256\"))\n            .and_then(serde_json::Value::as_str)\n            .and_then(|raw| ArtifactDigest::parse(raw).ok())\n            .ok_or_else(|| ObservationFailure::MissingDigest {\n                provider: ObservationProvider::Pypi,\n       