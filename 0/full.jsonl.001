{"parentUuid":"57c1f883-b907-4d3e-b00e-02838303311f","isSidechain":false,"promptId":"0bfe04c9-09b3-4ec0-9f94-3136f99e36ca","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HeJfmTdpJUuX7rzGNyxa4a","type":"tool_result","content":"1576\t\n1577\t/// A package with a pending changeset AND a\n1578\t/// genuine Cascade reason this run must get its changeset entries\n1579\t/// followed by exactly one additional DependencyUpdate entry.\n1580\t#[test]\n1581\tfn plan_version_unions_changeset_with_cascade_reason() {\n1582\t    let tmp = tempfile::tempdir().unwrap();\n1583\t    let root = tmp.path();\n1584\t    git_init_with_commit(root);\n1585\t\n1586\t    std::fs::create_dir_all(root.join(\"pkg-core\")).unwrap();\n1587\t    std::fs::write(\n1588\t        root.join(\"pkg-core/Cargo.toml\"),\n1589\t        \"[package]\\nname = \\\"pkg-core\\\"\\nversion = \\\"1.0.0\\\"\\n\",\n1590\t    )\n1591\t    .unwrap();\n1592\t\n1593\t    std::fs::create_dir_all(root.join(\"pkg-app\")).unwrap();\n1594\t    std::fs::write(\n1595\t        root.join(\"pkg-app/Cargo.toml\"),\n1596\t        \"[package]\\nname = \\\"pkg-app\\\"\\nversion = \\\"1.0.0\\\"\\n\\n[dependencies]\\npkg-core = \\\"1.0.0\\\"\\n\",\n1597\t    )\n1598\t    .unwrap();\n1599\t\n1600\t    std::fs::write(root.join(\"callisto.toml\"), \"[cascade]\\nbump-severity = \\\"minor\\\"\\n\").unwrap();\n1601\t\n1602\t    std::fs::create_dir_all(root.join(\".changeset\")).unwrap();\n1603\t    std::fs::write(\n1604\t        root.join(\".changeset/core-break.md\"),\n1605\t        \"---\\n\\\"pkg-core\\\": major\\n---\\n\\nBreaking API change.\\n\",\n1606\t    )\n1607\t    .unwrap();\n1608\t    std::fs::write(\n1609\t        root.join(\".changeset/app-patch.md\"),\n1610\t        \"---\\n\\\"pkg-app\\\": patch\\n---\\n\\nUnrelated small fix.\\n\",\n1611\t    )\n1612\t    .unwrap();\n1613\t    commit_all(root, \"add packages and changesets\");\n1614\t\n1615\t    let locator = IgnoreWalkLocator::new(root);\n1616\t    let runner = GitRunner;\n1617\t    let ws = Workspace::load(root.to_path_buf(), &locator, &runner).expect(\"workspace must load\");\n1618\t    let inference = crate::infer::NoInference;\n1619\t    let opts = VersionOptions {\n1620\t        strict: false,\n1621\t        allow_empty_changesets: true,\n1622\t    };\n1623\t\n1624\t    let plan = plan_version(&ws, &inference, &opts).expect(\"plan_version must succeed\");\n1625\t\n1626\t    let pkg_app = callisto_model::PackageId::parse(\"pkg-app\").unwrap();\n1627\t    let write = plan\n1628\t        .changelog_writes\n1629\t        .iter()\n1630\t        .find(|w| w.input.package == pkg_app)\n1631\t        .expect(\"pkg-app must have a ChangelogWrite\");\n1632\t\n1633\t    assert_eq!(write.input.entries.len(), 2, \"got: {:?}\", write.input.entries);\n1634\t    assert!(matches!(\n1635\t        write.input.entries[0].source,\n1636\t        crate::changelog::ChangeSource::Changeset { .. }\n1637\t    ));\n1638\t    assert!(matches!(\n1639\t        write.input.entries[1].source,\n1640\t        crate::changelog::ChangeSource::DependencyUpdate { .. }\n1641\t    ));\n1642\t}\n1643\t\n1644\t/// A package with\n1645\t/// both a pending changeset and outcome.reasons == Some(Inference{..})\n1646\t/// must get its changeset entries followed by one Inference-mapped\n1647\t/// entry (Commit-or-fallback logic).\n1648\t#[test]\n1649\tfn plan_version_unions_changeset_with_inference_reason() {\n1650\t    let tmp = tempfile::tempdir().unwrap();"}]},"uuid":"83484d30-9ada-4324-80d9-c0fe275ef064","timestamp":"2026-11-13T02:55:40.835Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/small-batch-limit-and-preview/crates/callisto-graph/src/commands/version/tests.rs","content":"\n/// A package with a pending changeset AND a\n/// genuine Cascade reason this run must get its changeset entries\n/// followed by exactly one additional DependencyUpdate entry.\n#[test]\nfn plan_version_unions_changeset_with_cascade_reason() {\n    let tmp = tempfile::tempdir().unwrap();\n    let root = tmp.path();\n    git_init_with_commit(root);\n\n    std::fs::create_dir_all(root.join(\"pkg-core\")).unwrap();\n    std::fs::write(\n        root.join(\"pkg-core/Cargo.toml\"),\n        \"[package]\\nname = \\\"pkg-core\\\"\\nversion = \\\"1.0.0\\\"\\n\",\n    )\n    .unwrap();\n\n    std::fs::create_dir_all(root.join(\"pkg-app\")).unwrap();\n    std::fs::write(\n        root.join(\"pkg-app/Cargo.toml\"),\n        \"[package]\\nname = \\\"pkg-app\\\"\\nversion = \\\"1.0.0\\\"\\n\\n[dependencies]\\npkg-core = \\\"1.0.0\\\"\\n\",\n    )\n    .unwrap();\n\n    std::fs::write(root.join(\"callisto.toml\"), \"[cascade]\\nbump-severity = \\\"minor\\\"\\n\").unwrap();\n\n    std::fs::create_dir_all(root.join(\".changeset\")).unwrap();\n    std::fs::write(\n        root.join(\".changeset/core-break.md\"),\n        \"---\\n\\\"pkg-core\\\": major\\n---\\n\\nBreaking API change.\\n\",\n    )\n    .unwrap();\n    std::fs::write(\n        root.join(\".changeset/app-patch.md\"),\n        \"---\\n\\\"pkg-app\\\": patch\\n---\\n\\nUnrelated small fix.\\n\",\n    )\n    .unwrap();\n    commit_all(root, \"add packages and changesets\");\n\n    let locator = IgnoreWalkLocator::new(root);\n    let runner = GitRunner;\n    let ws = Workspace::load(root.to_path_buf(), &locator, &runner).expect(\"workspace must load\");\n    let inference = crate::infer::NoInference;\n    let opts = VersionOptions {\n        strict: false,\n        allow_empty_changesets: true,\n    };\n\n    let plan = plan_version(&ws, &inference, &opts).expect(\"plan_version must succeed\");\n\n    let pkg_app = callisto_model::PackageId::parse(\"pkg-app\").unwrap();\n    let write = plan\n        .changelog_writes\n        .iter()\n        .find(|w| w.input.package == pkg_app)\n        .expect(\"pkg-app must have a ChangelogWrite\");\n\n    assert_eq!(write.input.entries.len(), 2, \"got: {:?}\", write.input.entries);\n    assert!(matches!(\n        write.input.entries[0].source,\n        crate::changelog::ChangeSource::Changeset { .. }\n    ));\n    assert!(matches!(\n        write.input.entries[1].source,\n        crate::changelog::ChangeSource::DependencyUpdate { .. }\n    ));\n}\n\n/// A package with\n/// both a pending changeset and outcome.reasons == Some(Inference{..})\n/// must get its changeset entries followed by one Inference-mapped\n/// entry (Commit-or-fallback logic).\n#[test]\nfn plan_version_unions_changeset_with_inference_reason() {\n    let tmp = tempfile::tempdir().unwrap();","numLines":75,"startLine":1576,"totalLines":2079}},"sourceToolAssistantUUID":"57c1f883-b907-4d3e-b00e-02838303311f","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/small-batch-limit-and-preview","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/changelog-dependency-updates","slug":"mossy-snacking-stream"}
