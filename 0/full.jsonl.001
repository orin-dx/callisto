         break\n        }\n        'callisto;filter-plan' {\n            [CompletionResult]::new('--plan', '--plan', [CompletionResultType]::ParameterName, 'Path to a publish plan JSON file, inline JSON, or `-` to read it from stdin')\n            [CompletionResult]::new('--report', '--report', [CompletionResultType]::ParameterName, 'Path to a publish report JSON file, inline JSON, or `-` to read it from stdin')\n            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format for command results')\n            [CompletionResult]::new('--cwd', '--cwd', [CompletionResultType]::ParameterName, 'Workspace directory to operate in (defaults to the current directory)')\n            [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Preview manifest and file changes without writing to disk')\n            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')\n            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')\n            break\n        }\n        'callisto;release' {\n            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format for command results')\n            [CompletionResult]::new('--cwd', '--cwd', [CompletionResultType]::ParameterName, 'Workspace directory to operate in (defaults to the current directory)')\n            [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Preview manifest and file changes without writing to disk')\n            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')\n            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')\n            [CompletionResult]::new('plan', 'plan', [CompletionResultType]::ParameterValue, 'Create a read-only durable release intent from exact package selections'