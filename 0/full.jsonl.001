tag = \"kind\", deny_unknown_fields)]\n    pub enum ReleaseArtifactSlot {\n        RegistryPackage {\n            package: ReleasePackageId,\n            version: Version,\n            #[serde(flatten)]\n            registry: RegistryBindingId,\n            format: RegistryArtifactFormat,\n            #[serde(rename = \"publicationPolicy\")]\n            publication_policy: RegistryPublicationPolicy,\n            #[serde(rename = \"fileName\")]\n            file_name: String,\n            #[serde(rename = \"provenancePolicy\")]\n            provenance_policy: ProvenancePolicy,\n        },\n        ProductAsset {\n            release: ProductReleaseId,\n            target: ProductTarget,\n            #[serde(rename = \"artifactKind\")]\n            artifact_kind: ProductArtifactKind,\n            #[serde(rename = \"fileName\")]\n            file_name: String,\n            #[serde(rename = \"provenancePolicy\")]\n            provenance_policy: ProvenancePolicy,\n        },\n        ChecksumManifest {\n            release: ProductReleaseId,\n            #[serde(rename = \"fileName\")]\n            file_name: String,\n            #[serde(rename = \"provenancePolicy\")]\n            provenance_policy: ProvenancePolicy,\n        },\n        ReleaseMetadata {\n            release: ProductReleaseId,\n            #[serde(rename = \"fileName\")]\n            fil\u003ctruncated omitted_approx_tokens=\"406\" /\u003e  #[non_exhaustive]\n    pub enum ReleaseExecutionStateError {\n        #[error(\"unsupported release execution state schema version {found}\")]\n        UnsupportedSchema { found: u8 },\n        #[error(\"release state is bound to a different intent\")]\n        MismatchedIntent,\n        #[error(\"release state operation roster differs from the bound intent\")]\n        MismatchedOperationRoster,\n        #[error(\"release state contains duplicate operation `{id:?}`\")]\n        DuplicateOperation { id: Box\u003cReleaseOperationId\u003e },\n        #[error(\"release state does not contain operation `{id:?}`\")]\n        UnknownOperation { id: Box\u003cReleaseOperationId\u003e },\n        #[error(\"operation `{id:?}` cannot transition from {from:?}\")]\n        InvalidTransition {\n            id: Box\u003cReleaseOperationId\u003e,\n            from: ReleaseOperationState,\n        },\n    }\n\n    fn validate_decision(\n        decision: \u0026ReleaseDecisionV1,\n        release: \u0026ProductReleaseId,\n        approved: \u0026[ApprovedRegistryArtifact],\n    ) -\u003e Result\u003c(), SuccessorError\u003e {\n        let derived = ProductReleaseId::from_coordinated_versions(\n            release.product.clone(),\n            decision.entries.iter().map(|entry| entry.target_version.clone()),\n        )?;\n        if \u0026derived != release {\n            return Err(SuccessorError::DecisionProductMismatch);\n        }\n        let decision_versions = decision\n            .entries\n            .iter()\n            .map(|entry| (\u0026entry.package, \u0026entry.target_version))\n            .collect::\u003cBTreeMap\u003c_, _\u003e\u003e();\n        if approved\n            .iter()\n            .any(|entry| decision_versions.get(\u0026entry.package).copied() != Some(\u0026release.version))\n        {\n            return Err(SuccessorError::RegistryArtifactOutsideDecision);\n        }\n        Ok(())\n    }\n\n    fn validate_slot_roster(\n        release: \u0026ProductReleaseId,\n        destination: \u0026ReleaseDestinationBinding,\n        approved: \u0026[ApprovedRegistryArtifact],\n        slots: \u0026[ReleaseArtifactSlot],\n\n","type":"input_text"},{"text":"\n[76] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"version: Version|version: Box\u003cVersion\u003e|Version,\\\" crates/callisto-model/src/release.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":20000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[77] tool exec result: S