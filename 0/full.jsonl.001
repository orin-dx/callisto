elease clause keeps the number of","     // components it was written with."]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"148b5b42-312c-4ab4-a2cd-6aa1f15d9c7f","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/verify-manifest-findings","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"worktree-agent-a24db56a03fed8e76","slug":"mossy-snacking-stream"}
