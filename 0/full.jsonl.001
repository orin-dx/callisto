      publication_policy,\\n+                        file_name,\\n+                        provenance_policy,\\n+                    }\\n+                }\\n+                ReleaseArtifactSlotWire::ProductAsset {\\n+                    release,\\n+                    target,\\n+                    artifact_kind,\\n+                    file_name,\\n+                    provenance_policy,\\n+                } =\u003e Self::ProductAsset {\\n+                    release,\\n+                    target,\\n+                    artifact_kind,\\n+                    file_name,\\n+                    provenance_policy,\\n+                },\\n+                ReleaseArtifactSlotWire::ChecksumManifest {\\n+                    release,\\n+                    file_name,\\n+                    provenance_policy,\\n+                } =\u003e Self::ChecksumManifest {\\n+                    release,\\n+                    file_name,\\n+                    provenance_policy,\\n+                },\\n+                ReleaseArtifactSlotWire::ReleaseMetadata {\\n+                    release,\\n+                    file_name,\\n+                    provenance_policy,\\n+                } =\u003e Self::ReleaseMetadata {\\n+                    release,\\n+                    file_name,\\n+                    provenance_policy,\\n+                },\\n+            })\\n+        }\\n+    }\\n@@\\n-                Self::RegistryPackage { version, .. } if version.grammar() != VersionGrammar::SemVer =\u003e {\\n-                    Err(SuccessorError::NonSemverProductVersion {\\n-                        version: Box::new(version.clone()),\\n-                    })\\n+                Self::RegistryPackage { package, version, .. }\\n+                    if version.grammar() != package.ecosystem().version_grammar() =\u003e\\n+                {\\n+                    Err(SuccessorError::RegistryVersionGrammarMismatch)\\n                 }\\n@@\\n-    #[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, JsonSchema)]\\n+    #[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, JsonSchema)]\\n@@\\n     pub enum ReleaseOperationId {\\n@@\\n     }\\n+\\n+    #[derive(Deserialize)]\\n+    #[serde(rename_all = \\\"camelCase\\\", tag = \\\"kind\\\", deny_unknown_fields)]\\n+    enum ReleaseOperationIdWire {\\n+        RegistryArtifactPublish {\\n+            package: ReleasePackageId,\\n+            version: String,\\n+            #[serde(flatten)]\\n+            registry: RegistryBindingId,\\n+            slot: ReleaseArtifactSlot,\\n+        },\\n+        ProductTag {\\n+            release: ProductReleaseId,\\n+            tag: String,\\n+        },\\n+        ForgePrepare {\\n+            release: ProductReleaseId,\\n+            repository: GitHubRepository,\\n+        },\\n+        ArtifactUpload {\\n+            release: ProductReleaseId,\\n+            slot: ReleaseArtifactSlot,\\n+        },\\n+        ForgePublish {\\n+            release: ProductReleaseId,\\n+            repository: GitHubRepository,\\n+        },\\n+    }\\n+\\n+    impl\u003c'de\u003e Deserialize\u003c'de\u003e for ReleaseOperationId {\\n+        fn deserialize\u003cD\u003e(deserializer: D) -\u003e Result\u003cSelf, D::Error\u003e\\n+        where\\n+            D: Deserializer\u003c'de\u003e,\\n+        {\\n+            Ok(match ReleaseOperationIdWire::deserialize(deserializer)? {\\n+                ReleaseOperationIdWire::RegistryArtifactPublish {\\n+                    package,\\n+                    version,\\n+                    registry,\\n+                    slot,\\n+                } =\u003e {\\n+                    let version = Version::parse(\u0026version, package.ecosystem().version_grammar())\\n+                        .map_err(serde::de::Error::custom)?;\\n+                    Self::RegistryArtifactPublish {\\n+                        package,\\n+                        version,\\n+                        registry,\\n+                        slot,\\n+   