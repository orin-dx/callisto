]::new('pre', 'pre', [CompletionResultType]::ParameterValue, 'Manage prerelease mode for the workspace')\n            [CompletionResult]::new('validate', 'validate', [CompletionResultType]::ParameterValue, 'Check that changesets and the dependency graph are well-formed')\n            [CompletionResult]::new('snapshot', 'snapshot', [CompletionResultType]::ParameterValue, 'Apply a temporary, non-persistent version bump for a snapshot release')\n            [CompletionResult]::new('init', 'init', [CompletionResultType]::ParameterValue, 'Scaffold Callisto configuration in the current workspace')\n            [CompletionResult]::new('plan-publish', 'plan-publish', [CompletionResultType]::ParameterValue, 'Compute which packages are ready to publish and print the publish plan')\n            [CompletionResult]::new('publish', 'publish', [CompletionResultType]::ParameterValue, 'Publish ready packages to their ecosystem registries via native CLI tools')\n            [CompletionResult]::new('compose-pr-body', 'compose-pr-body', [CompletionResultType]::ParameterValue, 'Generate a pull request body summarizing pending release changes')\n            [CompletionResult]::new('tag', 'tag', [CompletionResultType]::ParameterValue, 'Create git tags for packages in a publish plan')\n            [CompletionResult]::new('filter-plan', 'filter-plan', [CompletionResultType]::ParameterValue, 'Filter a publish plan down to what a publish report confirms actually succeeded, dropping anything that failed')\n            [CompletionResult]::new('release', 'release', [CompletionResultType]::ParameterValue, 'Create, inspect, reconcile, or execute durable release intents')\n            [CompletionResult]::new('completions', 'completions', [CompletionResultType]::ParameterValue, 'Generate shell completion scripts')\n            [CompletionResult]::new('schema', 'schema', [CompletionResultType]::ParameterValue, 'Print the JSON schema for a report type')\n            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')\n            break\n        }\n        'callisto;help;add' {\n            break\n        }\n        'callisto;help;status' {\n            break\n        }\n        'callisto;help;matrix' {\n            break\n        }\n        'callisto;help;version' {\n            break\n        }\n        'callisto;help;pre' {\n            [CompletionResult]::new('enter', 'enter', [CompletionResultType]::ParameterValue, 'Enter prerelease mode, tagging subsequent version bumps with the given prerelease tag')\n            [CompletionResult]::new('exit', 'exit', [CompletionResultType]::ParameterValue, 'Exit prerelease mode, returning to normal versioning')\n            break\n        }\n        'callisto;help;pre;enter' {\n            break\n        }\n        'callisto;help;pre;exit' {\n            break\n        }\n        'callisto;help;validate' {\n            break\n        }\n        'callisto;help;snapshot' {\n            break\n        }\n        'callisto;help;init' {\n            break\n        }\n        'callisto;help;plan-publish' {\n            break\n        }\n        'callisto;help;publish' {\n            break\n        }\n        'callisto;help;compose-pr-body' {\n            break\n        }\n        'callisto;help;tag' {\n            break\n        }\n        'callisto;help;filter-plan' {\n            break\n        }\n        'callisto;help;release' {\n            [CompletionResult]::new('plan', 'plan', [CompletionResultType]::ParameterValue, 'Create a read-only durable release intent from exact package selections')\n            [CompletionResult]::new('inspect', 'inspect', [CompletionResultType]::ParameterValue, 'Display a durable intent, manifest, state, or receipt without recomputing it')\n            [CompletionResult]::new('reconcile', 'reconcile', [CompletionResultType]::ParameterValue, 'Report which pending operations are eligible without changing release state')\n            [CompletionResult]::new('execute', 'execute', [CompletionResultType]::ParameterValue, 'Execute a previously approved intent. This is the only durable mutation route')\n            break\n        }\n        'callisto;help;release;plan' {\n            break\n        }\n        'callisto;help;release;inspect' {\n            break\n        }\n        'callisto;help;release;reconcile' {\n            break\n        }\n        'callisto;help;release;execute' {\n            break\n        }\n        'callisto;help;completions' {\n            break\n        }\n        'callisto;help;schema' {\n            break\n        }\n        'callisto;help;help' {\n            break\n        }\n    })\n\n    $completions.Where{ $_.CompletionText -like \"$wordToComplete*\" } |\n        Sort-Object -Property ListItemText\n}\ntest commands::init::tests::handle_dry_run_text_output_carries_the_dry_run_marker ... ok\ntest commands::pre::tests::handle_enter_dry_run_text_format_previews_without_writing ... ok\n#compdef callisto\n\nautoload -U is-at-least\n\n_callisto() {\n    typeset -A opt_args\n    typeset -a _arguments_options\n    local ret=1\n\n    if is-at-least 5.2; then\n        _arguments_options=(-s -S -C)\n    else\n        _arguments_options=(-s -C)\n    fi\n\n    local context curcontext=\"$curcontext\" state line\n    _arguments \"${_arguments_options[@]}\" : \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n'-V[Print version]' \\\n'--version[Print version]' \\\n\":: :_callisto_commands\" \\\n\"*::: :->callisto\" \\\n&& ret=0\n    case $state in\n    (callisto)\n        words=($line[1] \"${words[@]}\")\n        (( CURRENT += 1 ))\n        curcontext=\"${curcontext%:*:*}:callisto-command-$line[1]:\"\n        case $line[1] in\n            (add)\n_arguments \"${_arguments_options[@]}\" : \\\n'*--package=[Package and severity to include, as \\`name\\:severity\\` (patch, minor, or major); repeatable. Omit to enter the interactive wizard]:NAME:SEVERITY:_default' \\\n'--summary=[Human-readable summary of the change to record in the changeset]:SUMMARY:_default' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(status)\n_arguments \"${_arguments_options[@]}\" : \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--strict[Enable strict mode\\: promote warning-level diagnostics to errors, causing a non-zero exit]' \\\n'--strict-graph[Treat dependency-graph warnings as errors]' \\\n'--check[Exit with a distinct status code indicating whether any changesets are pending]' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(matrix)\n_arguments \"${_arguments_options[@]}\" : \\\n'--package=[Restrict output to one registered package'\\''s name (PackageId\\:\\:name())]:PACKAGE:_default' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(version)\n_arguments \"${_arguments_options[@]}\" : \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--refresh-lockfiles[Regenerate lockfiles after applying the version bumps]' \\\n'--strict[Treat warning-level diagnostics as errors]' \\\n'--strict-graph[Treat dependency-graph warnings as errors]' \\\n'--allow-empty-changesets[Allow versioning to proceed even if no changesets are pending]' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(pre)\n_arguments \"${_arguments_options[@]}\" : \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n\":: :_callisto__subcmd__pre_commands\" \\\n\"*::: :->pre\" \\\n&& ret=0\n\n    case $state in\n    (pre)\n        words=($line[1] \"${words[@]}\")\n        (( CURRENT += 1 ))\n        curcontext=\"${curcontext%:*:*}:callisto-pre-command-$line[1]:\"\n        case $line[1] in\n            (enter)\n_arguments \"${_arguments_options[@]}\" : \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n':tag:_default' \\\n&& ret=0\n;;\n(exit)\n_arguments \"${_arguments_options[@]}\" : \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(help)\n_arguments \"${_arguments_options[@]}\" : \\\n\":: :_callisto__subcmd__pre__subcmd__help_commands\" \\\n\"*::: :->help\" \\\n&& ret=0\n\n    case $state in\n    (help)\n        words=($line[1] \"${words[@]}\")\n        (( CURRENT += 1 ))\n        curcontext=\"${curcontext%:*:*}:callisto-pre-help-command-$line[1]:\"\n        case $line[1] in\n            (enter)\n_arguments \"${_arguments_options[@]}\" : \\\n&& ret=0\n;;\n(exit)\n_arguments \"${_arguments_options[@]}\" : \\\n&& ret=0\n;;\n(help)\n_arguments \"${_arguments_options[@]}\" : \\\n&& ret=0\n;;\n        esac\n    ;;\nesac\n;;\n        esac\n    ;;\nesac\n;;\n(validate)\n_arguments \"${_arguments_options[@]}\" : \\\n'(--staged)--since=[Validate only changesets added since the given git ref]:REF:_default' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--staged[Validate only changesets staged in git]' \\\n'--strict[Treat warning-level diagnostics as errors]' \\\n'--strict-graph[Treat dependency-graph warnings as errors]' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(snapshot)\n_arguments \"${_arguments_options[@]}\" : \\\n'--tag=[Tag to append to the snapshot version (e.g. a commit SHA or branch name)]:TAG:_default' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--strict[Abort if the workspace graph contains crosscheck failures or other error-severity diagnostics]' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(init)\n_arguments \"${_arguments_options[@]}\" : \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--yes[Skip the interactive confirmation prompt]' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(plan-publish)\n_arguments \"${_arguments_options[@]}\" : \\\n'*--package=[Plan only the named package(s). Repeatable\\: \\`--package foo --package bar\\`]:NAME:_default' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(publish)\n_arguments \"${_arguments_options[@]}\" : \\\n'*--package=[Publish only the named package(s). Repeatable\\: \\`--package foo --package bar\\`. When omitted, all packages in the plan are published]:NAME:_default' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--skip-publish-precheck[Skip the pre-publish \"already published?\" registry check and publish directly, relying on the registry'\\''s own already-published response. Saves one round-trip per package, at the cost of re-running local publish lifecycle scripts (e.g. npm'\\''s prepublishOnly) on a retried publish of an already-published version]' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(compose-pr-body)\n_arguments \"${_arguments_options[@]}\" : \\\n'--existing-body=[Existing PR body text to merge with, or \\`-\\` to read it from stdin]:TEXT|-:_default' \\\n'*--label=[Label to attach to the PR body; repeatable]:LABELS:_default' \\\n'--branch=[Branch name to reference in the generated PR body]:BRANCH:_default' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(tag)\n_arguments \"${_arguments_options[@]}\" : \\\n'--plan=[Path to a publish plan JSON file, inline JSON, or \\`-\\` to read it from stdin]:FILE|-:_default' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--floating-major[Also move a floating major-version tag (e.g. \\`v1\\`) to point at the new tag]' \\\n'--strict[Abort if the workspace graph contains crosscheck failures or other error-severity diagnostics]' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(filter-plan)\n_arguments \"${_arguments_options[@]}\" : \\\n'--plan=[Path to a publish plan JSON file, inline JSON, or \\`-\\` to read it from stdin]:FILE|-:_default' \\\n'--report=[Path to a publish report JSON file, inline JSON, or \\`-\\` to read it from stdin]:FILE|-:_default' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(release)\n_arguments \"${_arguments_options[@]}\" : \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n\":: :_callisto__subcmd__release_commands\" \\\n\"*::: :->release\" \\\n&& ret=0\n\n    case $state in\n    (release)\n        words=($line[1] \"${words[@]}\")\n        (( CURRENT += 1 ))\n        curcontext=\"${curcontext%:*:*}:callisto-release-command-$line[1]:\"\n        case $line[1] in\n            (plan)\n_arguments \"${_arguments_options[@]}\" : \\\n'(--from-release-commit)*--package=[Exact qualified package identity, for example \\`cargo/callisto-cli\\`. Repeat this flag to select multiple packages. This local/manual mode cannot be combined with --from-release-commit]:ECOSYSTEM/NAME:_default' \\\n'(--package)--from-release-commit=[Exact merged release-PR commit checked out in this workspace. CI derives the roster from its versioned manifest delta and never reruns changeset planning]:SHA:_default' \\\n'--out=[Explicit path where the immutable intent JSON will be atomically written]:FILE:_files' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(inspect)\n_arguments \"${_arguments_options[@]}\" : \\\n'--input=[Explicit path to an intent, artifact manifest, state, or receipt JSON document]:FILE:_files' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(reconcile)\n_arguments \"${_arguments_options[@]}\" : \\\n'--intent=[Explicit path to the durable release intent JSON document]:FILE:_files' \\\n'--state=[Explicit state path. If omitted, reconciliation reports the initialized state]:FILE:_files' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(execute)\n_arguments \"${_arguments_options[@]}\" : \\\n'--intent=[Explicit path to the durable release intent JSON document]:FILE:_files' \\\n'--artifact-manifest=[Explicit artifact man