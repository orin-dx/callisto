release\" -f -a \"execute\" -d 'Execute a previously approved intent. This is the only durable mutation route'\n         callisto-cli:test | Matrix (schema v1):\n         callisto-cli:test |   (no platform targets or runtime-version constraints declared)\n         callisto-cli:test | \n         callisto-cli:test | using namespace System.Management.Automation\n         callisto-cli:test | using namespace System.Management.Automation.Language\n         callisto-cli:test | \n         callisto-cli:test | Register-ArgumentCompleter -Native -CommandName 'callisto' -ScriptBlock {\n         callisto-cli:test |     param($wordToComplete, $commandAst, $cursorPosition)\n         callisto-cli:test | \n         callisto-cli:test |     $commandElements = $commandAst.CommandElements\n         callisto-cli:test |     $command = @(\n         callisto-cli:test |         'callisto'\n         callisto-cli:test |         for ($i = 1; $i -lt $commandElements.Count; $i++) {\n         callisto-cli:test |             $element = $commandElements[$i]\n         callisto-cli:test |             if ($element -isnot [StringConstantExpressionAst] -or\n         callisto-cli:test |                 $element.StringConstantType -ne [StringConstantType]::BareWord -or\n         callisto-cli:test |                 $element.Value.StartsWith('-') -or\n         callisto-cli:test |                 $element.Value -eq $wordToComplete) {\n         callisto-cli:test |                 break\n         callisto-cli:test |         }\n         callisto-cli:test |         $element.Value\n         callisto-cli:test |     }) -join ';'\n         callisto-cli:test | \n         callisto-cli:test |     $completions = @(switch ($command) {\n         callisto-cli:test |         'callisto' {\n         callisto-cli:test |             [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format for command results')\n         callisto-cli:test |             [CompletionResult]::new('--cwd', 