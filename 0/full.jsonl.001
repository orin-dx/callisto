{"parentUuid":"85dd36cb-ea01-4252-a12b-15aa9b6477f8","isSidechain":false,"promptId":"3f6d3ffe-8d7a-40a5-97d2-978434159727","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SNmfvUD8veNTMVt2LHskd1","type":"tool_result","content":"1355\tpreserve-npm-ranges = true   # §7.3/§13 inv. 15 — if a bump can't be confidently\n1356\t                              # round-tripped, leave the original range string untouched and\n1357\t                              # warn rather than overwriting it; this key gates whether\n1358\t                              # range-preserving rewrite is attempted at all (true is the\n1359\t                              # only sane default — false would mean always overwriting to\n1360\t                              # an exact version, knope-style, which this design rejects)\n1361\t\n1362\t[validation]\n1363\tallow-empty-changesets = false   # §6.3 — misfiled under [cascade] in earlier drafts; this is\n1364\t                                  # a validation setting, not a cascade one\n1365\t\n1366\t[[package-set]]\n1367\tmatch = \"crates/*\"\n1368\trelease-trigger = \"auto\"\n1369\tpublish-to = [\"cratesIo\"]\n1370\tpre-major-inference = \"conservative\"   # §7.1 — opt-in remap of inferred (not explicit)\n1371\t                                        # severities for Auto-trigger packages at 0.y.z,\n1372\t                                        # y > 0; omit/false to leave inference unremapped.\n1373\t                                        # Available on [[package-set]]/[[package]]/\n1374\t                                        # [[fixed-group]]/[[linked-group]] blocks alike —\n1375\t                                        # shown here since Rust/0.x crates are the case P1's\n1376\t                                        # §4 scope note and this key exist for\n1377\t\n1378\t[[package-set]]\n1379\tmatch = \"packages/*\"\n1380\trelease-trigger = \"changeset\"\n1381\tpublish-to = [\"npm\"]\n1382\t\n1383\t[[package]]\n1384\tmatch = \"packages/special-case\"\n1385\trelease-trigger = \"changeset\"   # explicit [[package]] entries always win over set matches\n1386\tpublish-to = [\"npm\"]\n1387\t\n1388\t[[fixed-group]]\n1389\tname = \"napi-foo\"\n1390\tmembers = [\"foo\", \"foo-cli\"]   # or auto-derived, see §5.3\n1391\t\n1392\t[[linked-group]]\n1393\tname = \"foo-and-its-cli-docs\"\n1394\tmembers = [\"foo\", \"foo-docs\"]   # share a version only when jointly touched (§7.5) —"}]},"uuid":"91f9b2f0-0710-4445-93b3-4b7e9cce4780","timestamp":"2026-08-18T08:13:09.100Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/docs/00-design.md","content":"preserve-npm-ranges = true   # §7.3/§13 inv. 15 — if a bump can't be confidently\n                              # round-tripped, leave the original range string untouched and\n                              # warn rather than overwriting it; this key gates whether\n                              # range-preserving rewrite is attempted at all (true is the\n                              # only sane default — false would mean always overwriting to\n                              # an exact version, knope-style, which this design rejects)\n\n[validation]\nallow-empty-changesets = false   # §6.3 — misfiled under [cascade] in earlier drafts; this is\n                                  # a validation setting, not a cascade one\n\n[[package-set]]\nmatch = \"crates/*\"\nrelease-trigger = \"auto\"\npublish-to = [\"cratesIo\"]\npre-major-inference = \"conservative\"   # §7.1 — opt-in remap of inferred (not explicit)\n                                        # severities for Auto-trigger packages at 0.y.z,\n                                        # y > 0; omit/false to leave inference unremapped.\n                                        # Available on [[package-set]]/[[package]]/\n                                        # [[fixed-group]]/[[linked-group]] blocks alike —\n                                        # shown here since Rust/0.x crates are the case P1's\n                                        # §4 scope note and this key exist for\n\n[[package-set]]\nmatch = \"packages/*\"\nrelease-trigger = \"changeset\"\npublish-to = [\"npm\"]\n\n[[package]]\nmatch = \"packages/special-case\"\nrelease-trigger = \"changeset\"   # explicit [[package]] entries always win over set matches\npublish-to = [\"npm\"]\n\n[[fixed-group]]\nname = \"napi-foo\"\nmembers = [\"foo\", \"foo-cli\"]   # or auto-derived, see §5.3\n\n[[linked-group]]\nname = \"foo-and-its-cli-docs\"\nmembers = [\"foo\", \"foo-docs\"]   # share a version only when jointly touched (§7.5) —","numLines":40,"startLine":1355,"totalLines":2185}},"sourceToolAssistantUUID":"85dd36cb-ea01-4252-a12b-15aa9b6477f8","session_id":"bb531e8d-c394-4e47-a8ae-e4a9ceeca6d2","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.233","gitBranch":"main","slug":"shimmying-giggling-hickey"}
