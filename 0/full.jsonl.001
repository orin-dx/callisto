rgs, output);\n    }\n    let response: serde_json::Value = serde_json::from_str(&output.stdout).map_err(|_| GraphError::ReleaseCommand {\n        program: \"curl\".to_string(),\n        args: args.iter().map(ToString::to_string).collect(),\n        failure: CommandFailure::MalformedOutput {\n            detail: \"Cargo registry returned a successful HTTP status with a non-JSON body\".to_string(),\n        },\n    })?;\n    let object = response.as_object().ok_or_else(|| GraphError::ReleaseCommand {\n        program: \"curl\".to_string(),\n        args: args.iter().map(ToString::to_string).collect(),\n        failure: CommandFailure::MalformedOutput {\n            detail: \"Cargo registry response is not a JSON object\".to_string(),\n        },\n    })?;\n    match object.get(\"errors\") {\n        None => Ok(()),\n558:    ProviderRejected { detail: String },\n\n"},{"type":"input_text","text":"\n[95] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/commands/release.rs\\n@@\\n-    let response: serde_json::Value = serde_json::from_str(&output.stdout).map_err(|_| GraphError::ReleaseCommand {\\n-        program: \\\"curl\\\".to_string(),\\n-        args: args.iter().map(ToString::to_string).collect(),\\n-        failure: CommandFailure::MalformedOutput {\\n-            detail: \\\"Cargo registry returned a successful HTTP status with a non-JSON body\\\".to_string(),\\n-        },\\n-    })?;\\n+    let response: serde_json::Value =\\n+        serde_json::from_str(&output.stdout).map_err(|source| GraphError::ReleaseCommand {\\n+            program: \\\"curl\\\".to_string(),\\n+            args: args.iter().map(ToString::to_string).collect(),\\n+            failure: CommandFailure::MalformedOutput {\\n+                detail: format!(\\n+                    \\\"Cargo registry returned a successful HTTP status with malformed JSON ({:?} at line {}, column {})\\\",\\n+                    sour