orktrees/verify-manifest-findings","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/version-lock-refresh-rollback","slug":"mossy-snacking-stream"}
{"parentUuid":"6bf0f85f-917e-45b2-8d56-30a1c4a9d7d7","isSidechain":false,"promptId":"3de37e0d-1775-44fa-86e9-cd5b184c34fe","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MQJxRZyZUpvTDFy7F9GkAM","type":"tool_result","content":"1\t//! Proves, before the first write, that every file a version plan touches can be written and committed, so a bad\n2\t//! target stops the run with nothing changed instead of leaving earlier manifests rewritten.\n3\t\n4\tuse std::collections::BTreeSet;\n5\tuse std::path::{Component, Path, PathBuf};\n6\t\n7\tuse callisto_model::{ApplyPermit, CommandError, CommandRunner};\n8\t\n9\tuse super::ApplyOptions;\n10\tuse crate::cascade::DepWriteTarget;\n11\tuse crate::error::GraphError;\n12\tuse crate::plan::{VersionPlan, VersionWriteTarget};\n13\t\n14\t/// What a plan does to a path, which decides what must hold for it.\n15\t#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]\n16\tenum Target {\n17\t    /// A manifest the plan edits: it must exist as a readable regular file and its directory must take a new file.\n18\t    Existing,\n19\t    /// A file the plan may create or replace, such as a changelog or `pre.json`.\n20\t    Creatable,\n21\t    /// A file the plan deletes: only the path itself is checked.\n22\t    Removed,\n23\t}\n24\t\n25\t/// Every path `plan` writes or deletes under `opts`, once each.\n26\tfn targets(plan: &VersionPlan, opts: &ApplyOptions) -> BTreeSet<(PathBuf, Target)> {\n27\t    let mut targets = BTreeSet::new();\n28\t    for bump in &plan.bumps {\n29\t        for write in &bump.writes {\n30\t            let path = match write {\n31\t                VersionWriteTarget::Manifest(path) => path,\n32\t                VersionWriteTarget::CargoWorkspacePackage { root_manifest } => root_manifest,\n33\t            };\n34\t            targets.insert((path.clone(), Target::Existing));\n35\t        }\n36\t    }\n37\t    for rewrite in &plan.rewrites {\n38\t        let path = match &rewrite.key.target {\n39\t            DepWriteTarget::Manifest(path) => path,\n40\t            DepWriteTarget::CargoWorkspaceDependency { root_manifest } => root_manifest,\n41\t        };\n42\t        targets.insert((path.clone(), Target::Existing));\n43\t    }\n44\t    targets.extend(\n45\t        plan.platform_writes\n46\t            .iter()\n47\t            .map(|write| (write.manifest.clone(), Target::Existing)),\n48\t    );\n49\t    targets.extend(\n50\t        plan.optional_dep_updates\n51\t            .iter()\n52\t            .map(|update| (update.manifest.clone(), Target::Existing)),\n53\t    );\n54\t    if !opts.transient {\n55\t        targets.extend(\n56\t            plan.changelog_writes\n57\t                .iter()\n58\t                .map(|write| (write.changelog_path.clone(), Target::Creatable)),\n59\t        );\n60\t        targets.extend(\n61\t            plan.consumed_changesets\n62\t                .iter()\n63\t                .map(|path| (path.clone(), Target::Removed)),\n64\t        );\n65\t        if plan.pre_state_update.is_some() {\n66\t            targets.insert((plan.pre_json_path.clone(), Target::Creatable));\n67\t        } else if let Some(path) = &plan.delete_pre_json {\n68\t            targets.insert((path.clone(), Target::Removed));\n69\t        }\n70\t    }\n71\t    targets\n72\t}\n73\t\n74\t/// Fails with every target that cannot be written, before anything is.\n75\t///\n76\t/// # Errors\n77\t///\n78\t/// [`GraphError::ApplyPreflight`] naming each unwritable path and why.\n79\tpub(super) fn check<R: CommandRunner>(\n80\t    root: &Path,\n81\t    plan: &VersionPlan,\n82\t    opts: &ApplyOptions,\n83\t    permit: &ApplyPermit,\n84\t    runner: &R,\n85\t) -> Result<(), GraphError> {\n86\t    let targets = targets(plan, opts);\n87\t    let mut problems: Vec<String> = targets\n88\t        .iter()\n89\t        .filter_map(|(path, target)| {\n90\t            problem(root, path, *target, permit).map(|reason| format!(\"`{}`: {reason}\", path.display()))\n91\t        })\n92\t        .collect();\n93\t    if !opts.transient {\n94\t        let staged: Vec<PathBuf> = targets\n95\t            .iter()\n96\t            .filter(|(_, target)| *target != Target::Removed)\n97\t            .map(|(path, _)| path.clone())\n98\t            .collect();\n99\t        problems.extend(ignored_paths(runner, root, &staged)?.into_iter().map(|path| {\n100\t            format!(\n101\t                \"`{}`: is ignored by a .gitignore, so Git would not stage it\",\n102\t                path.display()\n103\t            )\n104\t        }));\n105\t    }\n106\t    if problems.is_empty() {\n107\t        Ok(())\n108\t    } else {\n109\t        Err(GraphError::ApplyPreflight { problems })\n110\t    }\n111\t}\n112\t"}]},"uuid":"41b3fbbe-1b1a-4557-a569-ef053bee7393","timestamp":"2026-11-14T02:42:38.561Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/verify-manifest-findings/crates/callisto-graph/src/apply/preflight.rs","content":"//! Proves, before the first write, that every file a version plan touches can be written and committed, so a bad\n//! target stops the run with nothing changed instead of leaving earlier manifests rewritten.\n\nuse std::collections::BTreeSet;\nuse std::path::{Component, Path, PathBuf};\n\nuse callisto_model::{ApplyPermit, CommandError, CommandRunner};\n\nuse super::ApplyOptions;\nuse crate::cascade::DepWriteTarget;\nuse crate::error::GraphError;\nuse crate::plan::{VersionPlan, VersionWriteTarget};\n\n/// What a plan does to a path, which decides what must hold for it.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]\nenum Target {\n    /// A manifest the plan edits: it must exist as a readable regular file and its directory must take a new file.\n    Existing,\n    /// A file the plan may create or replace, such as a changelog or `pre.json`.\n    Creatable,\n    /// A file the plan deletes: only the path itself is checked.\n    Removed,\n}\n\n/// Every path `plan` writes or deletes under `opts`, once each.\nfn targets(plan: &VersionPlan, opts: &ApplyOptions) -> BTreeSet<(PathBuf, Target)> {\n    let mut targets = BTreeSet::new();\n    for bump in &plan.bumps {\n        for write in &bump.writes {\n            let path = match write {\n                VersionWriteTarget::Manifest(path) => path,\n                VersionWriteTarget::CargoWorkspacePackage { root_manifest } => root_manifest,\n            };\n            targets.insert((path.clone(), Target::Existing));\n        }\n    }\n    for rewrite in &plan.rewrites {\n        let path = match &rewrite.key.target {\n            DepWriteTarget::Manifest(path) => path,\n            DepWriteTarget::CargoWorkspaceDependency { root_manifest } => root_manifest,\n        };\n        targets.insert((path.clone(), Target::Existing));\n    }\n    targets.extend(\n        plan.platform_writes\n            .iter()\n            .map(|write| (write.manifest.clone(), Target::Existing)),\n    );\n    targets.extend(\n        plan.optional_dep_updates\n            .iter()\n            .map(|update| (update.manifest.clone(), Target::Existing)),\n    );\n    if !opts.transient {\n        targets.extend(\n            plan.changelog_writes\n                .iter()\n                .map(|write| (write.changelog_path.clone(), Target::Creatable)),\n        );\n        targets.extend(\n            plan.consumed_changesets\n                .iter()\n                .map(|path| (path.clone(), Target::Removed)),\n        );\n        if plan.pre_state_update.is_some() {\n            targets.insert((plan.pre_json_path.clone(), Target::Creatable));\n        } else if let Some(path) = &plan.delete_pre_json {\n            targets.insert((path.clone(), Target::Removed));\n        }\n    }\n    targets\n}\n\n/// Fails with every target that cannot be written, before anything is.\n///\n/// # Errors\n///\n/// [`GraphError::ApplyPreflight`] naming each unwritable path and why.\npub(super) fn check<R: CommandRunner>(\n    root: &Path,\n    plan: &VersionPlan,\n    opts: &ApplyOptions,\n    permit: &ApplyPermit,\n    runner: &R,\n) -> Result<(), GraphError> {\n    let targets = targets(plan, opts);\n    let mut problems: Vec<String> = targets\n        .iter()\n        .filter_map(|(path, target)| {\n            problem(root, path, *target, permit).map(|reason| format!(\"`{}`: {reason}\", path.display()))\n        })\n        .collect();\n    if !opts.transient {\n        let staged: Vec<PathBuf> = targets\n            .iter()\n            .filter(|(_, target)| *target != Target::Removed)\n            .map(|(path, _)| path.clone())\n            .collect();\n        problems.extend(ignored_paths(runner, root, &staged)?.into_iter().map(|path| {\n            format!(\n                \"`{}`: is ignored by a .gitignore, so Git would not stage it\",\n                path.display()\n            )\n        }));\n    }\n    if problems.is_empty() {\n        Ok(())\n    } else {\n        Err(GraphError::ApplyPreflight { problems })\n    }\n}\n","numLines":112,"startLine":1,"totalLines":204}},"sourceToolAssistantUUID":"6bf0f85f-917e-45b2-8d56-30a1c4a9d7d7","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/verify-manifest-findings","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/version-lock-refresh-rollback","slug":"mossy-snacking-stream"}
