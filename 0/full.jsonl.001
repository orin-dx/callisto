{"parentUuid":"b9d41726-3d77-486a-9ab4-ea791900c783","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011Cgun7v2L3DMpgDgfPHTtd","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018A8M9LvzHKh9WCe9FKAScn","name":"Write","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a6e0ff37abadc9fe2/.changeset/error-codes-one-condition.md","content":"---\ncallisto-cli: minor\n---\n\nError codes now each name one condition, so a script can tell problems apart from the code.\n\n- `callisto.toml`: E111 is only a TOML syntax error. An unknown key is E325, and a value of the wrong type or a missing required key is E326.\n- `release pending --from`: a value that is not a full 40-character SHA is E327, and a valid SHA that is not a release commit on this branch is E328. Before, both showed E171, which means an internal defect.\n\nBreaking: scripts that match E111 to detect an unknown key or a wrong-type value, or E171 to detect a bad `--from`, must match E325, E326, E327 or E328 instead.\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4285,"cache_read_input_tokens":718619,"output_tokens":923,"output_tokens_details":{"thinking_tokens":374},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":4285,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":923,"cache_read_input_tokens":718619,"cache_creation_input_tokens":4285,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4285},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_018A8M9LvzHKh9WCe9FKAScn":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a6e0ff37abadc9fe2/.changeset/error-codes-one-condition.md","content":"---\ncallisto-cli: minor\n---\n\nError codes now each name one condition, so a script can tell problems apart from the code.\n\n- `callisto.toml`: E111 is only a TOML syntax error. An unknown key is E325, and a value of the wrong type or a missing required key is E326.\n- `release pending --from`: a value that is not a full 40-character SHA is E327, and a valid SHA that is not a release commit on this branch is E328. Before, both showed E171, which means an internal defect.\n\nBreaking: scripts that match E111 to detect an unknown key or a wrong-type value, or E171 to detect a bad `--from`, must match E325, E326, E327 or E328 instead.\n"}},"serverClassifierRequest":"93dfd18c-e689-4ada-ba6a-9327057e4cdb","apiBlockIndex":1,"requestId":"req_011Cgun7ucXi2WBUDVZwD1Sz","requestRef":"24bf91ee-b14b-47a0-bd5a-4e70b854d491","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"104ee00f-438d-4fa8-b50a-23727b9fd8f5","timestamp":"2026-11-10T19:12:32.833Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a6e0ff37abadc9fe2","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/error-code-hygiene","slug":"mossy-snacking-stream"}
