_>,\n        observations: &mut ObservationSession,\n        permit: &ApplyPermit,\n        id: &ReleaseOperationId,\n    ) -> Result<OperationOutcome, GraphError> {\n        let operation = self\n            .prepared\n            .operations\n            .get(id)\n            .ok_or_else(|| GraphError::ReleaseInvariant {\n                detail: format!(\"dispatch_prepared: no prepared operation for `{id:?}`\"),\n            })?;\n        let observed = observe_prepared(observations, artifacts, id);\n        if operation_is_satisfied(id, &observed) {\n            return Ok(OperationOutcome::AlreadySatisfied);\n        }\n        ensure_operation_is_missing(id, &observed)?;\n      <truncated omitted_approx_tokens=\"1286\" />ERSION,\n                intent_digest: intent.digest.clone(),\n                operations: intent\n                    .operations\n                    .iter()\n                    .map(|operation| (operation.id.clone(), ReleaseOperationState::Pending))\n                    .collect(),\n            }\n        }\n\n        pub fn intent_digest(&self) -> &IntentDigest {\n            &self.intent_digest\n        }\n\n        pub fn operation_state(&self, id: &ReleaseOperationId) -> Option<ReleaseOperationState> {\n            self.operations.get(id).copied()\n        }\n\n        pub fn validate_for_intent(&self, intent: &ReleaseIntent) -> Result<(), ReleaseExecutionStateError> {\n            if self.schema_version != Self::SCHEMA_VERSION {\n                return Err(ReleaseExecutionStateError::UnsupportedSchema {\n                    found: self.schema_version,\n                });\n            }\n            if self.intent_digest != intent.digest {\n                return Err(ReleaseExecutionStateError::MismatchedIntent);\n            }\n            let expected = intent\n                .operations\n                .iter()\n                .map(|operation| operation.id.clone())\n                .collect::<BTreeSet<_>>();\n            let actual = self.operations.keys().cloned().collect::<BTreeSet<_>>();\n            if actual != expected {\n                return Err(ReleaseExecutionStateError::MismatchedOperationRoster);\n            }\n            Ok(())\n        }\n\n        pub fn mark_attempting(&mut self, id: &ReleaseOperationId) -> Result<(), ReleaseExecutionStateError> {\n            let state = self\n                .operations\n                .get_mut(id)\n                .ok_or_else(|| ReleaseExecutionStateError::UnknownOperation {\n                    id: Box::new(id.clone()),\n                })?;\n            if *state != ReleaseOperationState::Pending {\n                return Err(ReleaseExecutionStateError::InvalidTransition {\n                    id: Box::new(id.clone()),\n\n"},{"type":"input_text","text":"\n[81] tool exec call: const r = await tools.exec_command({cmd:\"rtk rg -n \\\"fn operation_is_satisfied|fn ensure_operation_is_missing|pub\\\\(super\\\\).*evidence|OperationObservation::Exact\\\" crates/callisto-graph/src/commands/release.rs crates/callisto-graph/src/commands/release_observation.rs\",workdir:\"/private/tmp/callisto-release-recovery\",yield_time_ms:10000,max_output_tokens:18000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[82] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\ncrates/callisto-graph/src/commands/release.rs:772:fn operation_is_satisfied(id: &ReleaseOperationId, observed: &OperationObservation) -> bool {\ncrates/callisto-graph/src/commands/release.rs:774:        OperationObservation::Exact(_) => true,\ncrates/callisto-graph/src/commands/release.rs:785:fn ensure_operation_is_missing(id: &ReleaseOperationId, observed: &OperationObservation) -> Result<(), GraphError> {\ncrates/callisto-graph/src/commands/release_observation.rs:285:            OperationObservation::Exact(ReleaseObservationEvidence::remote_tag(\ncrates/callisto-graph/src/commands/release_observation.rs:319:        OperationObservation::Exact(ReleaseObservationEv