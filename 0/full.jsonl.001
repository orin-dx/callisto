c in case that invariant ever changes upstream.\ncrates/callisto-model/src/path.rs-36-    let slash_str = utf8.as_std_path().to_slash().ok_or_else(|| ModelError::NonUtf8Path {\ncrates/callisto-model/src/path.rs-37-        path: utf8.as_std_path().to_path_buf(),\ncrates/callisto-model/src/path.rs-38-    })?;\ncrates/callisto-model/src/path.rs-39-    let normalized_path = Path::new(slash_str.as_ref());","is_error":false}]},"uuid":"311789cd-be82-4be7-97f2-749327efa5b1","timestamp":"2026-11-11T20:26:17.132Z","toolUseResult":{"stdout":"    let path = callisto_model::workspace_relative(path)?;\n    let path = path.to_string_lossy().into_owned();\n    if path.contains(['\\0', '\\n', '\\r']) {\n        return Err(command_malformed_output(\n            \"git\",\n            &[\"cat-file\", \"--batch\"],\n            \"workspace path contains a forbidden control character\",\n        ));\n    }\n    Ok(path)\n}\n\nfn historical_manifest_error(error: callisto_model::ManifestError) -> GraphError {\n    match error {\n        callisto_model::ManifestError::InvalidVersion { source, .. } => GraphError::from(source),\n        other => command_malformed_output(\"git\", &[\"cat-file\", \"--batch\"], other.to_string()),\n    }\n}\n\n#[cfg(test)]\nfn parse_manifest_version(source: &str, path: &str, ecosystem: Ecosystem) -> Result<Version, GraphError> {\ncrates/callisto-model/src/path.rs:25:pub fn workspace_relative(path: impl AsRef<Path>) -> Result<PathBuf, ModelError> {\ncrates/callisto-model/src/path.rs-26-    let p = path.as_ref();\ncrates/callisto-model/src/path.rs-27-    if p.is_absolute() {\ncrates/callisto-model/src/path.rs-28-        return Err(ModelError::AbsolutePath { path: p.to_path_buf() });\ncrates/callisto-model/src/path.rs-29-    }\ncrates/callisto-model/src/path.rs-30-\ncrates/callisto-model/src/path.rs-31-    let utf8 = Utf8PathBuf::from_path_buf(p.to_path_buf()).map_err(|path| ModelError::NonUtf8Path { path })?;\ncrates/callisto-model/src/path.rs-32-\ncrates/callisto