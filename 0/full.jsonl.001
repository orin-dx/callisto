{"parentUuid":"06442e0e-3444-45f9-bd9e-756e61fa59b1","isSidechain":false,"promptId":"7aa590e2-63aa-4f6f-9e48-42c3a3be0a7e","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013nQaLTcN8E2empHiemxHeW","type":"tool_result","content":"1480:        assert!(\n1481:            outcome.severities.contains_key(&pkg_b),\n1482:            \"B must be cascaded when D's pre-release version is out of range for ^1.0.0\"\n1483:        );\n1484:        let b_target = outcome.targets.get(&pkg_b).expect(\"B must have a target\");\n1485:        assert!(\n1486:            b_target.is_prerelease(),\n1487:            \"B's cascade target in PreMode::Pre must also be a pre-release; got {}\",\n1488:            b_target.render()\n1489:        );\n1490:    }\n1491:\n1492:    #[test]\n1493:    fn test_bump_target_uses_pinned_pre_baseline_not_current_prerelease() {\n1494:        let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n1495:\n1496:        let graph = TwoPackageGraph {\n1497:            packages: vec![bare_package(&pkg_a)],\n1498:        };\n1499:\n1500:        // On-disk is already one prerelease bump into a MAJOR cycle\n1501:        // (2.0.0-next.0), while the pinned baseline from `pre enter` is\n1502:        // still 1.0.0. Requesting a Minor bump now must be computed from\n1503:        // the pinned baseline (-> release 1.1.0), not by re-deriving from\n1504:        // the already-major-bumped on-disk value (which would incorrectly\n1505:        // treat 2.0.0-next.0 as still-in-progress and yield 2.0.0-next.1).\n1506:        let mut base = BTreeMap::new();\n1507:        base.insert(\n1508:            pkg_a.clone(),\n1509:            Version::parse(\"2.0.0-next.0\", callisto_model::VersionGrammar::SemVer).unwrap(),\n1510:        );","is_error":false}]},"uuid":"51fce8a1-5388-4252-814b-eeb424ab840c","timestamp":"2026-08-22T22:18:13.729Z","toolUseResult":{"stdout":"1480:        assert!(\n1481:            outcome.severities.contains_key(&pkg_b),\n1482:            \"B must be cascaded when D's pre-release version is out of range for ^1.0.0\"\n1483:        );\n1484:        let b_target = outcome.targets.get(&pkg_b).expect(\"B must have a target\");\n1485:        assert!(\n1486:            b_target.is_prerelease(),\n1487:            \"B's cascade target in PreMode::Pre must also be a pre-release; got {}\",\n1488:            b_target.render()\n1489:        );\n1490:    }\n1491:\n1492:    #[test]\n1493:    fn test_bump_target_uses_pinned_pre_baseline_not_current_prerelease() {\n1494:        let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n1495:\n1496:        let graph = TwoPackageGraph {\n1497:            packages: vec![bare_package(&pkg_a)],\n1498:        };\n1499:\n1500:        // On-disk is already one prerelease bump into a MAJOR cycle\n1501:        // (2.0.0-next.0), while the pinned baseline from `pre enter` is\n1502:        // still 1.0.0. Requesting a Minor bump now must be computed from\n1503:        // the pinned baseline (-> release 1.1.0), not by re-deriving from\n1504:        // the already-major-bumped on-disk value (which would incorrectly\n1505:        // treat 2.0.0-next.0 as still-in-progress and yield 2.0.0-next.1).\n1506:        let mut base = BTreeMap::new();\n1507:        base.insert(\n1508:            pkg_a.clone(),\n1509:            Version::parse(\"2.0.0-next.0\", callisto_model::VersionGrammar::SemVer).unwrap(),\n1510:        );","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"06442e0e-3444-45f9-bd9e-756e61fa59b1","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"docs-cleanup-rust-comments","slug":"shimmying-giggling-hickey"}
