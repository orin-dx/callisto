/callisto-graph/src/config/resolve.rs-1087-\ncrates/callisto-graph/src/config/resolve.rs-1088-        let result = load(root);\ncrates/callisto-graph/src/config/resolve.rs-1089-        assert!(\ncrates/callisto-graph/src/config/resolve.rs-1090-            result.is_err(),\ncrates/callisto-graph/src/config/resolve.rs:1091:            \"expected load() to reject unknown publish-to value in [[package]] block, got Ok\"\ncrates/callisto-graph/src/config/resolve.rs-1092-        );\ncrates/callisto-graph/src/config/resolve.rs-1093-        let err = result.unwrap_err();\ncrates/callisto-graph/src/config/resolve.rs-1094-        assert!(\ncrates/callisto-graph/src/config/resolve.rs:1095:            matches!(&err, ConfigError::UnknownKey { key, .. } if key.contains(\"[[package]] publish-to\")),\ncrates/callisto-graph/src/config/resolve.rs:1096:            \"expected UnknownKey error mentioning '[[package]] publish-to', got: {err:?}\"\ncrates/callisto-graph/src/config/resolve.rs-1097-        );\ncrates/callisto-graph/src/config/resolve.rs-1098-    }\ncrates/callisto-graph/src/config/resolve.rs-1099-\n--\ndocs/01-spec.md-466-    /// action, and callisto has no HTTP client. Retained only so a calling workflow's own\ndocs/01-spec.md-467-    /// `gh release create` step can be named as a *planning* target; callisto never creates\ndocs/01-spec.md-468-    /// one.\ndocs/01-spec.md:469:    GitHubRelease,\ndocs/01-spec.md-470-    /// Internal-only, never published. `privatePackages.version = true` in a migrated\ndocs/01-spec.md-471-    /// `.changeset/config.json` maps here (§18 Q4).\ndocs/01-spec.md-472-    None,\ndocs/01-spec.md-473-}\ndocs/01-spec.md-474-\ndocs/01-spec.md-475-impl PublishTarget {\ndocs/01-spec.md:476:    /// The `[registries.*]` key this target resolves to, or `None` for `GitHubRelease`/\ndocs/01-spec.md-477-    /// `None`. `CratesIo` → `RegistryKey::CRATES_IO`; `Npm { registry: None }` →\ndocs/01-spec.md-478-    /// `RegistryKey::NPM`; `Npm { registry: Some(url) }` → whichever `[registries.*]` block\ndocs/01-spec.md-479-    /// declares that URL, resolved by `callisto-graph::config` (§G.5.4). Plan entries carry\n--\ndocs/01-spec.md-1780-> registry is configured, changing `.rustCrates[].publishTo`'s JSON type based on config. That\ndocs/01-spec.md-1781-> would break every `jq -r` consumer §9.3 demonstrates, on exactly the workspaces most likely\ndocs/01-spec.md-1782-> to have a custom registry. A key string plus an optional URL keeps §9.2's literal shape\ndocs/01-spec.md:1783:> stable in all cases and matches §14, where `publish-to = [\"cratesIo\"]` already refers to\ndocs/01-spec.md-1784-> registry keys.\ndocs/01-spec.md-1785-\ndocs/01-spec.md-1786-#### M.12.3 `VersionReport` — §12.5\n--\ndocs/01-spec.md-2508-        maturin_source: &'static str,\ndocs/01-spec.md-2509-    },\ndocs/01-spec.md-2510-\ndocs/01-spec.md:2511:    /// A resolved `[[package]]`/`[[package-set]]` `publish-to` override names a target whose\ndocs/01-spec.md-2512-    /// `.ecosystem()` (e.g. `nuget`) is not one of `package`'s own detected ecosystems (e.g. a\ndocs/01-spec.md-2513-    /// Cargo-only crate) — caught in `walk.rs`'s identity-building loop, the only place both\ndocs/01-spec.md-2514-    /// the resolved override and the package's real, detected ecosystems are known at once.\ndocs/01-spec.md-2515-    /// Rejected rather than silently accepted, since a silently-accepted mismatch makes the\ndocs/01-spec.md-2516-    /// package vanish from every real publish downstream with zero diagnostic.\ndocs/01-spec.md-2517-    #[error(\ndocs/01-spec.md:2518:        \"package `{package}` configures publish-to target `{target}` (ecosystem `{}`), but \\\ndocs/01-spec.md-2519-         its detected ecosystem is `{}`\",\ndocs/01-spec.md-2520-        .target_ecosystem.prefix(),\ndocs/01-spec.md-2521-        .package_ecosystems.iter().map(|e| e.prefix()).collect::<Vec<_>>().join(\", \")\n--\ndocs/01-spec.md-6381-> The fixed and linked layers cannot conflict with each other, because §14's parse-time\ndocs/01-spec.md-6382-> disjointness check (§G.5.5) already rejects a package belonging to both. Only per-package\ndocs/01-spec.md-6383-> keys are resolvable from a group block — at v0.1–v0.4 that is `pre-major-inference` alone;\ndocs/01-spec.md:6384:> `publish-to`, `release-trigger`, `tag-template`, and `changelog` are per-package facts a\ndocs/01-spec.md-6385-> group has no business asserting for its whole membership, and setting one there is\ndocs/01-spec.md-6386-> `ConfigError::UnknownKey`.\n) -> Result<DerivedReleaseInputs, GraphError> {\n    let mut package_inputs = Vec::new();\n\n    let mut selected = BTreeMap::new();\n    let mut package_ids = BTreeMap::<callisto_model::PackageId, Vec<ReleasePackageId>>::new();\n    for package in workspace.graph.packages() {\n        for ecosystem in package\n            .canonical_manifests()\n            .map(|manifest| manifest.ecosystem())\n            .collect::<BTreeSet<_>>()\n        {\n            let id =\n                ReleasePackageId::new(ecosystem, package.id.name()).map_err(|_error| GraphError::ReleaseIntentStale)?;\n            if let Some(entry) = decision.entries.iter().find(|entry| entry.package == id) {\n                selected.insert(id.clone(), (package, entry.target_version.clone()));\n                package_ids.entry(package.id.clone()).or_default().push(id);\n            }\n        }\n    }\n    for entry in &decision.entries {\n        let id = &entry.package;\n        if !selected.contains_key(id) {\n            return Err(GraphError::ReleasePackageNotSelected { package: id.clone() });\n        }\n    }\n\n    let requires_git_remote = selected.values().any(|(package, _)| {\n        package\n            .publish_to\n            .iter()\n            .any(|target| !matches!(target, PublishTarget::None))\n    });\n    let git_remote = requires_git_remote\n        .then(|| prepared_git_remote(&workspace.root, workspace.runner))\n        .transpose()?;\n\n    let mut operations = BTreeMap::<ReleaseOperationId, ReleaseOperation>::new();\n    let mut prepared = BTreeMap::<ReleaseOperationId, PreparedOperation>::new();\n    let mut publishes_by_package = BTreeMap::<ReleasePackageId, Vec<ReleaseOperationId>>::new();\n    let mut tag_by_package = BTreeMap::<ReleasePackageId, ReleaseOperationId>::new();\n\n    // First construct leaves so dependency prerequisites can refer only to\n    // exact selected release identities, never PackageId's wildcard matcher.\n    for (id, (package, version)) in &selected {\n        let produces_tag = package\n            .publish_to\n            .iter()\n            .any(|target| !matches!(target, PublishTarget::None));\n        let fingerprint = package_fingerprint(\n            workspace,\n            id,\n            package,\n            version,\n            produces_tag.then_some(git_remote.as_ref()).flatten(),\n        )?;\n        package_inputs.push(ReleasePackageInputV1 {\n            package: id.clone(),\n            fingerprint,\n        });\n\n        let mut publishes = Vec::new();\n        for target in &package.publish_to {\n            if target.ecosystem() == Some(id.ecosystem()) {\n                let registry_key = target.registry_key().expect(\"registry target has registry key\");\n                let binding = prepared_registry_binding(workspace, target)?;\n                let operation = ReleaseOperation::registry_publish(\n                    id.clone(),\n                    version.clone(),\n                    RegistryBindingId::new(registry_key.as_str(), binding.identity.clone())\n                        .map_err(|_error| GraphError::ReleaseIntentStale)?,\n                    Vec::new(),\n                )\n                .map_err(|_error| GraphError::ReleaseIntentStale)?;\n                // A durable registry operation must have one exact endpoint\n                // binding. The model-level operation identity currently has\n                // only a registry key, so reject a second target that would\n                // collapse to the same operation until the typed binding\n                // identity is added there.\n                if prepared.contains_key(operation.id()) {\n                    return Err(GraphError::ReleaseIntentStale);\n                }\n                prepared.insert(\n                    operation.id().clone(),\n                    PreparedOperation::RegistryPublish {\n                        package_dir: package_dir(package)?,\n                        package_name: id.name().to_string(),\n                        version: version.clone(),\n                        registry: binding,\n                        npm_access: match target {\n                            PublishTarget::Npm { access, .. } => *access,\n                            _ => None,\n"},"started_at_ms":1788302918320,"completed_at_ms":1788302918320}}
