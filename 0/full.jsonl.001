{"parentUuid":"a6eddfc1-a57b-4782-a55f-7f67234e1be9","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/resolver.rs","snippet":"1\tuse std::collections::{BTreeMap, HashSet};\n2\t\n3\tuse callisto_model::{DepEdge, Diagnostic, Package, PackageId};\n4\t\n5\tuse crate::error::GraphError;\n6\tuse crate::identity::IdentityIndex;\n7\tuse crate::toposort::toposort_impl;\n8\t\n9\tpub use callisto_model::DependencyResolver;\n10\t\n11\tpub trait DependencyResolverExt: DependencyResolver {\n12\t    fn toposort(&self, subset: &HashSet<PackageId>) -> Result<Vec<PackageId>, GraphError> {\n13\t        // The DependencyResolver::packages() trait method yields &Package, not PackageId, so\n14\t        // we must clone each id. The Vec is required to produce a &[PackageId] slice for\n15\t        // toposort_impl; it cannot be eliminated without changing the function signature.\n16\t        let all_pkg_ids: Vec<PackageId> = self.packages().map(|p| p.id.clone()).collect();\n17\t        toposort_impl(subset, &all_pkg_ids, |id| {\n18\t            self.dependencies_of(id)\n19\t                .map(|e| (e.to.clone(), e.kind))\n20\t                .collect()\n21\t        })\n22\t    }\n23\t}\n24\t\n25\timpl<T: DependencyResolver + ?Sized> DependencyResolverExt for T {}\n26\t\n27\tpub struct ManifestWalkResolver {\n28\t    pub(crate) packages: BTreeMap<PackageId, Package>,\n29\t    pub(crate) edges: Vec<DepEdge>,\n30\t    pub(crate) out_index: BTreeMap<PackageId, Vec<usize>>,\n31\t    pub(crate) in_index: BTreeMap<PackageId, Vec<usize>>,\n32\t    pub(crate) index: IdentityIndex,\n33\t    pub(crate) diagnostics: Vec<Diagnostic>,\n34\t}"},"type":"attachment","uuid":"28b77cb9-6ab1-4301-a5d4-ebe8a4b998ba","timestamp":"2026-08-22T17:43:39.805Z","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"main","slug":"shimmying-giggling-hickey"}
{"parentUuid":"28b77cb9-6ab1-4301-a5d4-ebe8a4b998ba","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/commands/publish.rs","snippet":"1\tuse callisto_model::{\n2\t    CommandRunner, CratePublish, NpmMainPublish, PublishPlan, PublishTarget, PypiPublish,\n3\t    RegistryKey, ReleaseEntry, SCHEMA_VERSION,\n4\t};\n5\tuse callisto_vcs::GitDataSource;\n6\t\n7\tuse crate::error::GraphError;\n8\tuse crate::resolver::{DependencyResolver, DependencyResolverExt};\n9\tuse crate::Workspace;\n10\t\n11\t#[derive(Clone, Debug, Default)]\n12\tpub struct PublishOptions {\n13\t    /// When non-empty, only packages whose bare name (without ecosystem prefix)\n14\t    /// appears in this list are included in the plan. An empty `only` list\n15\t    /// means \"include all packages\" (the default).\n16\t    pub only: Vec<String>,\n17\t}\n18\t\n19\t/// Validates a `publishConfig.registry` URL read from a package's own\n20\t/// `package.json` before it is threaded into the publish plan (and\n21\t/// eventually into `npm publish --registry <url>` / `npm view --registry\n22\t/// <url>`, both run with `NPM_TOKEN` live in the process environment in CI).\n23\t///\n24\t/// `publishConfig.registry` is manifest-controlled data -- something a PR\n25\t/// author can set in their own package.json -- not operator-controlled\n26\t/// config, so it must never be trusted verbatim as a publish destination.\n27\t/// Two checks are enforced, mirroring the leading-`-` flag-injection guard\n28\t/// already applied to package names before they reach these same CLI\n29\t/// invocations (see `SubprocessRegistryClient::npm_publish`):\n30\t///\n31\t/// 1. The URL must use the `https` scheme. A scheme downgrade (e.g. `http`)\n32\t///    is rejected even if the host would otherwise be approved, since scheme\n33\t///    downgrade is itself part of the attack this guard defends against.\n34\t/// 2. The URL must exactly match a `url` configured on an `npm`-kind entry\n35\t///    in the operator's `[registries]` table in `callisto.toml`.\n36\t///\n37\t/// If the operator has configured no custom npm registries at all (no\n38\t/// `[registries.*]` block with `kind = \"npm\"` and a `url`), any override is\n39\t/// rejected. This is the conservative choice: `callisto.toml`, not an\n40\t/// attacker-influenced `package.json`, must always be the source of truth\n41\t/// for where credentials-bearing publish requests are allowed to go, so\n42\t/// operators who need a private npm registry must opt in explicitly by\n43\t/// declaring it in `[registries]`.\n44\tfn validate_npm_registry_url(\n45\t    url: &str,\n46\t    package: &PackageId,\n47\t    registries: &std::collections::BTreeMap<RegistryKey, crate::config::RegistryConfig>,\n48\t) -> Result<(), GraphError> {\n49\t    let is_approved = url.starts_with(\"https://\")\n50\t        && registries\n51\t            .values()\n52\t            .any(|cfg| cfg.kind == Ecosystem::Npm && cfg.url.as_deref() == Some(url));\n53\t\n54\t    if is_approved {\n55\t        Ok(())\n56\t    } else {\n57\t        Err(GraphError::UntrustedNpmRegistry {\n58\t            package: package.clone(),\n59\t            url: url.to_string(),\n60\t        })\n61\t    }\n62\t}\n63\t\n64\t/// Resolves a package's `changelog_section` for `plan_publish`: reads the file at\n65\t/// `ws_root.join(changelog_rel_path)` and extracts the `## {ver}` section via\n66\t/// `callisto_changelog::extract_section`. Every non-fatal outcome (file not found, no\n67\t/// matching heading, empty matched section, or an unreadable file) leaves the return value\n68\t/// `None` and pushes exactly one Warning diagnostic into `diagnostics` rather than aborting\n69\t/// the plan -- `ChangelogSectionNotFound` for the first three (AC-10b, AC-11, AC-12),\n70\t/// `ChangelogReadError` for a read failure that is not \"file does not exist\" (AC-12c).\n71\tfn resolve_changelog_section(\n72\t    ws_root: &std::path::Path,\n73\t    changelog_rel_path: &std::path::Path,\n74\t    pkg_id: &callisto_model::PackageId,\n75\t    ver: &callisto_model::Version,\n76\t    diagnostics: &mut Vec<callisto_model::Diagnostic>,\n77\t) -> Option<String> {\n78\t    let full_path = ws_root.join(changelog_rel_path);\n79\t    let content = match std::fs::read_to_string(&full_path) {\n80\t        Ok(c) => c,\n81\t        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {\n82\t            diagnostics.push(callisto_model::Diagnostic {\n83\t                code: callisto_model::DiagnosticCode::ChangelogSectionNotFound,\n84\t                severity: callisto_model::DiagnosticSeverity::Warning,\n85\t                message: format!(\n86\t                    \"no changelog file found at `{}` for package `{}`\",\n87\t                    changelog_rel_path.display(),\n88\t                    pkg_id.display_name()\n89\t                ),\n90\t                package: Some(pkg_id.clone()),\n91\t                path: Some(changelog_rel_path.to_path_buf()),\n92\t                escalated_by: None,\n93\t                governed_by: None,\n94\t            });\n95\t            return None;\n96\t        }\n97\t        Err(e) => {\n98\t            diagnostics.push(callisto_model::Diagnostic {\n99\t                code: callisto_model::DiagnosticCode::ChangelogReadError,\n100\t                severity: callisto_model::DiagnosticSeverity::Warning,\n101\t                message: format!(\n102\t                    \"could not read changelog at `{}` for package `{}`: {e}\",\n103\t                    changelog_rel_path.display(),\n104\t                    pkg_id.display_name()\n105\t                ),\n106\t                package: Some(pkg_id.clone()),\n107\t                path: Some(changelog_rel_path.to_path_buf()),\n108\t                escalated_by: None,\n109\t                governed_by: None,\n110\t            });\n111\t            return None;\n112\t        }\n113\t    };\n114\t\n115\t    match callisto_changelog::extract_section(&content, ver) {\n116\t        Some(section) => Some(section.to_string()),\n117\t        None => {\n118\t            diagnostics.push(callisto_model::Diagnostic {\n119\t                code: callisto_model::DiagnosticCode::ChangelogSectionNotFound,\n120\t                severity: callisto_model::DiagnosticSeverity::Warning,\n121\t                message: format!(\n122\t                    \"no `## {}` section found in `{}` for package `{}`\",\n123\t                    ver.render(),\n124\t                    changelog_rel_path.display(),\n125\t                    pkg_id.display_name()\n126\t                ),\n127\t                package: Some(pkg_id.clone()),\n128\t                path: Some(changelog_rel_path.to_path_buf()),\n129\t                escalated_by: None,\n130\t                governed_by: None,\n131\t            });\n132\t            None\n133\t        }\n134\t    }\n135\t}\n136\t\n137\tpub fn plan_publish<R: CommandRunner, D: DependencyResolver>(\n138\t    ws: &Workspace<'_, R, D>,\n139\t    opts: &PublishOptions,\n140\t) -> Result<PublishPlan, GraphError> {\n141\t    let mut rust_crates = Vec::new();\n142\t    let mut npm_main_packages = Vec::new();\n143\t    let mut npm_platform_packages = Vec::new();\n144\t    let mut pypi_packages = Vec::new();\n145\t    let mut releases = Vec::new();\n146\t\n147\t    let base_versions = ws.base_versions()?;\n148\t    let inference = crate::infer::NoInference;\n149\t    let mut diagnostics: Vec<callisto_model::Diagnostic> = Vec::new();\n150\t    let version_plan = match crate::commands::version::plan_version(\n151\t        ws,\n152\t        &inference,\n153\t        &crate::commands::version::VersionOptions::default(),\n154\t    ) {\n155\t        Ok(plan) => Some(plan),\n156\t        Err(e) => {\n157\t            diagnostics.push(callisto_model::Diagnostic {\n158\t                code: callisto_model::DiagnosticCode::ChangesetReadError,\n159\t                severity: callisto_model::DiagnosticSeverity::Warning,\n160\t                message: format!(\"Could not read changesets: {e}\"),\n161\t                package: None,\n162\t                path: None,\n163\t                escalated_by: None,\n164\t                governed_by: None,\n165\t            });\n166\t            None\n167\t        }\n168\t    };\n169\t\n170\t    // Build a single lookup map once — eliminates O(N) scans inside the topo loop\n171\t    // (PERF-003/004/005). Keys and values are borrowed from the graph for the\n172\t    // lifetime of this function, so no extra clones are needed for the lookups.\n173\t    let pkg_map: std::collections::HashMap<&callisto_model::PackageId, &callisto_model::Package> =\n174\t        ws.graph.packages().map(|p| (&p.id, p)).collect();\n\n... [1253 lines truncated] ..."},"type":"attachment","uuid":"05662555-919f-48fe-9235-c522ca0a009c","timestamp":"2026-08-22T17:43:39.807Z","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"main","slug":"shimmying-giggling-hickey"}
