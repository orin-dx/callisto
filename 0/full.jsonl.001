d)\n    }\n\n    /// Like [`Self::run_with_timeout`], but for an internal existence/probe\n    /// check whose stderr looks like a failure on the common path (e.g.\n    /// `npm view` against an unpublished package prints a 404-shaped \"not\n    /// found\" to stderr normally) -- unlike a real, user-facing mutating\n    /// command, this must not stream that noise live to the terminal, only\n    /// capture it into [`CommandOutput`] for the caller to classify.\n    ///\n    /// Default implementation just delegates to [`Self::run_with_timeout`]\n    /// (streams live); implementors doing their own live-streaming should\n    /// override this to suppre\u003ctruncated omitted_approx_tokens=\"364\" /\u003e     let mut entries = Vec::new();\n        for slot in validated.intent().slots().iter().filter(|slot| {\n            matches!(\n                slot,\n                ReleaseArtifactSlot::RegistryPackage { .. } | ReleaseArtifactSlot::ProductAsset { .. }\n            )\n        }) {\n            let bytes = slot_bytes(slot);\n            std::fs::write(directory.path().join(slot.file_name()), \u0026bytes).unwrap();\n            entries.push(\n                ReleaseArtifactEntry::new(\n                    slot.clone(),\n                    ArtifactDigest::from_bytes(\u0026bytes),\n                    bytes.len() as u64,\n                    validated.intent().source_commit().clone(),\n                    slot.policy().clone(),\n                )\n                .unwrap(),\n            );\n        }\n        let payloads = ValidatedPayloadEntries::new(validated.intent(), entries).unwrap();\n        let bundle =\n            callisto_model::ReleaseArtifactManifest::complete_with_generated_files(validated.intent(), \u0026payloads)\n                .unwrap();\n        for slot in validated.intent().slots() {\n            match slot {\n                ReleaseArtifactSlot::ReleaseMetadata { .. } =\u003e {\n                    std::fs::write(directory.path().join(slot.file