: tests and one doc sentence only.\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"7a7fd361-9ef8-4681-a07f-12c093ce8b9a","permissionDecision":{"decision":"accept","source":"config","reasonType":"other"},"session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a5e465e9b44611fbd","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"perf/scale-hotspots","slug":"mossy-snacking-stream"}
{"attachment":{"command":"","content":"","durationMs":45,"exitCode":0,"hookEvent":"","hookName":"","stderr":"","stdout":"","toolUseID":"","type":"hook_success"},"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a5e465e9b44611fbd","entrypoint":"cli","gitBranch":"perf/scale-hotspots","isSidechain":false,"parentUuid":"e5aa1f80-dd1c-4e3b-85ad-f4c0eeedd5f3","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","slug":"mossy-snacking-stream","timestamp":"2026-11-11T16:40:34.060Z","type":"attachment","userType":"external","uuid":"6b11324f-42f9-4a28-bd70-6598feeacbe9","version":"2.1.311"}
{"parentUuid":"6b11324f-42f9-4a28-bd70-6598feeacbe9","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011CgwULkqTw2fftc4b3EgEn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ugb1GwGSMEwCrf94mHFMxj","name":"Write","input":{"file_path":"/Users/gabe/.claude/jobs/6cc3e47b/tmp/pr504_final.md","content":"## Summary\n\n`docs/stability.md` promises tag names, GitHub Actions inputs, exit codes and strict `callisto.toml` parsing, and none of it had a test. Changing any of these would break users silently, so this pins each one. Test-only, no production or action code changes.\n\n- Tag names: the real binary runs `version`, `release plan` and `release execute` with fake publishers. A unique package is tagged `foo@1.1.0`, a name shared by two ecosystems `cargo/foo@1.1.0`, and `tag-template` overrides both.\n- Action inputs: `.github/tests/verify-action-inputs.sh` pins each input's name, `required` and default for `callisto-action` (12) and `setup-callisto` (3) against checked-in lists, run by `workflow-contracts`. Adding, removing or renaming an input fails CI until the list is updated.\n- Exit codes: clap parse errors exit 2 in text and JSON mode, and `--help`, `status --help` and `--version` exit 0.\n- Config: a guard test fails if a config struct derives `Deserialize` without `deny_unknown_fields`.\n\n`{name}` is not a `tag-template` placeholder, only `{version}`, as documented.\n\n## Verify\n\nA mutation per area fails its test: qualified-prefix join, ignoring `tag-template`, changing a `setup-callisto` default, renaming or adding an input, `Cli::parse` swapped for a `try_parse` that exits 1, and dropping `deny_unknown_fields`. `just pre-push`, `just lint`, `just doc-check`, `just test` and `just workflow-contracts` exit 0.\n\nNot run: CI. The unknown-field guard is a text scan, so it cannot see a config struct defined outside `src/config`.\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":1644,"cache_read_input_tokens":908143,"output_tokens":1499,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1644,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":4,"output_tokens":1499,"cache_read_input_tokens":908143,"cache_creation_input_tokens":1644,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1644},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Ugb1GwGSMEwCrf94mHFMxj":{"file_path":"/Users/gabe/.claude/jobs/6cc3e47b/tmp/pr504_final.md","content":"## Summary\n\n`docs/stability.md` promises tag names, GitHub Actions inputs, exit codes and strict `callisto.toml` parsing, and none of it had a test. Changing any of these would break users silently, so this pins each one. Test-only, no production or action code changes.\n\n- Tag names: the real binary runs `version`, `release plan` and `release execute` with fake publishers. A unique package is tagged `foo@1.1.0`, a name shared by two ecosystems `cargo/foo@1.1.0`, and `tag-template` overrides both.\n- Action inputs: `.github/tests/verify-action-inputs.sh` pins each input's name, `required` and default for `callisto-action` (12) and `setup-callisto` (3) against checked-in lists, run by `workflow-contracts`. Adding, removing or renaming an input fails CI until the list is updated.\n- Exit codes: clap parse errors exit 2 in text and JSON mode, and `--help`, `status --help` and `--version` exit 0.\n- Config: a guard test fails if a config struct derives `Deserialize` without `deny_unknown_fields`.\n\n`{name}` is not a `tag-template` placeholder, only `{version}`, as documented.\n\n## Verify\n\nA mutation per area fails its test: qualified-prefix join, ignoring `tag-template`, changing a `setup-callisto` default, renaming or adding an input, `Cli::parse` swapped for a `try_parse` that exits 1, and dropping `deny_unknown_fields`. `just pre-push`, `just lint`, `just doc-check`, `just test` and `just workflow-contracts` exit 0.\n\nNot run: CI. The unknown-field guard is a text scan, so it cannot see a config struct defined outside `src/config`.\n"}},"serverClassifierRequest":"b6518c1f-a125-4905-822f-033da3beb218","apiBlockIndex":1,"requestId":"req_011CgwULkKx8qC9s6w47xxxr","requestRef":"b0fd8359-6531-4726-a88b-b1d688e35f14","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"8db62ccc-00fd-4d95-917a-40376c73ec2e","timestamp":"2026-11-11T16:40:37.036Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a5e465e9b44611fbd","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"perf/scale-hotspots","slug":"mossy-snacking-stream"}
