{"parentUuid":"cfcf44f0-7136-4c8c-9163-23ce97c9d5a2","isSidechain":false,"promptId":"77a33b11-58ae-4ff8-bdb6-92604a89e081","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JH8YMfHK2vZLH2yvEfLq2e","type":"tool_result","content":"1936\t#### M.12.5 `SnapshotReport`, `ComposePrBodyReport` — §12.5\n1937\t\n1938\t```rust\n1939\t/// `callisto snapshot --format json`. §8, §12.5.\n1940\t///\n1941\t/// Carries the computed version and the affected packages — **not** a\n1942\t/// `published`/`publishedPackages` pair. `snapshot` computes and writes a transient version\n1943\t/// to manifests, uncommitted and untagged; it does not publish (§8, §9).\n1944\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n1945\t#[serde(rename_all = \"camelCase\")]\n1946\tpub struct SnapshotReport {\n1947\t    pub schema_version: u32,\n1948\t    /// Mandatory. The transient version, exactly `0.0.0-{tag}-{sha7}` — one value for the\n1949\t    /// whole workspace, composition rule pinned in §G.11's `plan_snapshot`. §8's example\n1950\t    /// `0.0.0-snapshot-<sha>` is what `--tag snapshot` produces.\n1951\t    pub version: Version,\n1952\t    /// Mandatory, possibly empty. `name` is the ecosystem-native package name, paired with\n1953\t    /// its `ecosystem` — which is what makes this shape usable by a publish script that must\n1954\t    /// route Rust and npm packages to different commands.\n1955\t    pub packages: Vec<SnapshotPackage>,\n1956\t    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n1957\t    pub diagnostics: Vec<Diagnostic>,\n1958\t}\n1959\t\n1960\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n1961\t#[serde(rename_all = \"camelCase\")]\n1962\tpub struct SnapshotPackage { pub name: String, pub ecosystem: Ecosystem }\n1963\t\n1964\timpl Report for SnapshotReport { const COMMAND: &'static str = \"snapshot\"; /* … */ }\n1965\t"}]},"uuid":"5a2aa934-7ff0-43b2-9de6-20686655a6d8","timestamp":"2026-08-19T16:31:46.794Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/docs/01-spec.md","content":"#### M.12.5 `SnapshotReport`, `ComposePrBodyReport` — §12.5\n\n```rust\n/// `callisto snapshot --format json`. §8, §12.5.\n///\n/// Carries the computed version and the affected packages — **not** a\n/// `published`/`publishedPackages` pair. `snapshot` computes and writes a transient version\n/// to manifests, uncommitted and untagged; it does not publish (§8, §9).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"camelCase\")]\npub struct SnapshotReport {\n    pub schema_version: u32,\n    /// Mandatory. The transient version, exactly `0.0.0-{tag}-{sha7}` — one value for the\n    /// whole workspace, composition rule pinned in §G.11's `plan_snapshot`. §8's example\n    /// `0.0.0-snapshot-<sha>` is what `--tag snapshot` produces.\n    pub version: Version,\n    /// Mandatory, possibly empty. `name` is the ecosystem-native package name, paired with\n    /// its `ecosystem` — which is what makes this shape usable by a publish script that must\n    /// route Rust and npm packages to different commands.\n    pub packages: Vec<SnapshotPackage>,\n    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n    pub diagnostics: Vec<Diagnostic>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"camelCase\")]\npub struct SnapshotPackage { pub name: String, pub ecosystem: Ecosystem }\n\nimpl Report for SnapshotReport { const COMMAND: &'static str = \"snapshot\"; /* … */ }\n","numLines":30,"startLine":1936,"totalLines":11439}},"sourceToolAssistantUUID":"cfcf44f0-7136-4c8c-9163-23ce97c9d5a2","session_id":"bb531e8d-c394-4e47-a8ae-e4a9ceeca6d2","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.233","gitBranch":"main","slug":"shimmying-giggling-hickey"}
