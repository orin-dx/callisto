{"parentUuid":"42ad3402-8601-4e9e-b8df-d9254bb0f5cb","isSidechain":false,"promptId":"362ea6a9-7a3f-454a-8500-1074a7cdd9e1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HgyyNdu36qPoPc72ZiMBbF","type":"tool_result","content":"1\tuse crate::extension_wrapper::*;\n2\tuse crate::host_func_mocker::*;\n3\tuse crate::toolchain_wrapper::*;\n4\tuse extism::{Function, UserData, ValType};\n5\tuse moon_pdk_api::{\n6\t    Id, RegisterExtensionInput, RegisterExtensionOutput, RegisterToolchainInput,\n7\t    RegisterToolchainOutput,\n8\t};\n9\tuse proto_core::{ProtoEnvironment, Tool, ToolContext, inject_proto_manifest_config};\n10\tuse proto_pdk_test_utils::WasmTestWrapper as ToolTestWrapper;\n11\tuse starbase_sandbox::{Sandbox, create_empty_sandbox, create_sandbox};\n12\tuse std::fmt;\n13\tuse std::fs;\n14\tuse std::ops::Deref;\n15\tuse std::path::PathBuf;\n16\tuse std::sync::Arc;\n17\tuse warpgate::{\n18\t    PluginContainer, PluginLoader, PluginManifest, Wasm, host::*, inject_default_manifest_config,\n19\t    test_utils::*,\n20\t};\n21\t\n22\tpub struct MoonWasmSandbox {\n23\t    pub sandbox: Sandbox,\n24\t    pub home_dir: PathBuf,\n25\t    pub host_funcs: MockedHostFuncs,\n26\t    pub moon_dir: PathBuf,\n27\t    pub proto: Arc<ProtoEnvironment>,\n28\t    pub proto_dir: PathBuf,\n29\t    pub root: PathBuf,\n30\t    pub wasm_file: PathBuf,\n31\t}\n32\t\n33\timpl MoonWasmSandbox {\n34\t    pub fn new(sandbox: Sandbox) -> Self {\n35\t        let root = sandbox.path().to_path_buf();\n36\t        let home_dir = root.join(\".home\");\n37\t        let moon_dir = root.join(\".moon\");\n38\t        let proto_dir = root.join(\".proto\");\n39\t        let wasm_file = find_wasm_file();\n40\t\n41\t        // Folders must exist for WASM to compile correctly!\n42\t        fs::create_dir_all(&home_dir).unwrap();\n43\t        fs::create_dir_all(&moon_dir).unwrap();\n44\t        fs::create_dir_all(&proto_dir).unwrap();\n45\t\n46\t        // Required for toolchains\n47\t        let mut proto = ProtoEnvironment::new_testing(&root).unwrap();\n48\t        proto.working_dir = root.clone();\n49\t\n50\t        Self {\n51\t            home_dir,\n52\t            moon_dir,\n53\t            proto: Arc::new(proto),\n54\t            proto_dir,\n55\t            root,\n56\t            sandbox,\n57\t            wasm_file,\n58\t            host_funcs: MockedHostFuncs::default(),\n59\t        }\n60\t    }\n61\t\n62\t    pub fn create_config(&self) -> ConfigBuilder {\n63\t        ConfigBuilder::new(&self.root, &self.home_dir)\n64\t    }\n65\t\n66\t    pub async fn create_extension(&self, id: &str) -> ExtensionTestWrapper {\n67\t        self.create_extension_with_config(id, |_| {}).await\n68\t    }\n69\t\n70\t    pub async fn create_extension_with_config(\n71\t        &self,\n72\t        id: &str,\n73\t        mut op: impl FnMut(&mut ConfigBuilder),\n74\t    ) -> ExtensionTestWrapper {\n75\t        let id = Id::raw(id);\n76\t\n77\t        // Create manifest\n78\t        let mut manifest = PluginManifest::new([Wasm::file(self.wasm_file.clone())]);\n79\t\n80\t        // Create config\n81\t        let mut config = self.create_config();\n82\t        config.plugin_id(&id);\n83\t\n84\t        op(&mut config);\n85\t\n86\t        manifest.config.extend(config.build());\n87\t\n88\t        // Create plugin\n89\t        let plugin = self.create_plugin_container(id, manifest, false);\n90\t        let metadata: RegisterExtensionOutput = plugin\n91\t            .cache_func_with(\n92\t                \"register_extension\",\n93\t                RegisterExtensionInput {\n94\t                    id: plugin.id.clone(),\n95\t                },\n96\t            )\n97\t            .await\n98\t            .unwrap();\n99\t\n100\t        ExtensionTestWrapper {\n101\t            metadata,\n102\t            plugin,\n103\t            root: self.root.clone(),\n104\t        }\n105\t    }\n106\t\n107\t    pub async fn create_toolchain(&self, id: &str) -> ToolchainTestWrapper {\n108\t        self.create_toolchain_with_config(id, |_| {}).await\n109\t    }\n110\t\n111\t    pub async fn create_toolchain_with_config(\n112\t        &self,\n113\t        id: &str,\n114\t        mut op: impl FnMut(&mut ConfigBuilder),\n115\t    ) -> ToolchainTestWrapper {\n116\t        let id = Id::raw(id);\n117\t\n118\t        // Create manifest\n119\t        let mut manifest = PluginManifest::new([Wasm::file(self.wasm_file.clone())]);\n120\t\n121\t        // Create config\n122\t        let mut config = self.create_config();\n123\t        config.plugin_id(&id);\n124\t\n125\t        op(&mut config);\n126\t\n127\t        manifest.config.extend(config.build());\n128\t\n129\t        // Create plugin\n130\t        let plugin = Arc::new(self.create_plugin_container(id, manifest, true));\n131\t        let metadata: RegisterToolchainOutput = plugin\n132\t            .cache_func_with(\n133\t                \"register_toolchain\",\n134\t                RegisterToolchainInput {\n135\t                    id: plugin.id.clone(),\n136\t                },\n137\t            )\n138\t            .await\n139\t            .unwrap();\n140\t\n141\t        ToolchainTestWrapper {\n142\t            metadata,\n143\t            plugin: plugin.clone(),\n144\t            root: self.root.clone(),\n145\t            tool: if plugin.has_func(\"register_tool\").await {\n146\t                Some(ToolTestWrapper {\n147\t                    tool: Tool::new(\n148\t                        ToolContext::new(plugin.id.clone()),\n149\t                        self.proto.clone(),\n150\t                        plugin,\n151\t                    )\n152\t                    .await\n153\t                    .unwrap(),\n154\t                })\n155\t            } else {\n156\t                None\n157\t            },\n158\t        }\n159\t    }\n160\t\n161\t    pub fn enable_logging(&self) {\n162\t        enable_wasm_logging(&self.wasm_file);\n163\t    }\n164\t\n165\t    fn create_plugin_container(\n166\t        &self,\n167\t        id: Id,\n168\t        mut manifest: PluginManifest,\n169\t        with_proto: bool,\n170\t    ) -> PluginContainer {\n171\t        let virtual_paths = vec![\n172\t            (self.root.clone(), \"/workspace\".into()),\n173\t            (self.home_dir.clone(), \"/userhome\".into()),\n174\t            (self.moon_dir.clone(), \"/moon\".into()),\n175\t            (self.proto_dir.clone(), \"/proto\".into()),\n176\t        ];\n177\t\n178\t        manifest.timeout_ms = None;\n179\t        manifest = manifest.with_allowed_host(\"*\");\n180\t        manifest = manifest.with_allowed_paths(virtual_paths.iter().map(\n181\t            |(key, value): &(PathBuf, PathBuf)| {\n182\t                (key.to_string_lossy().to_string(), value.to_owned())\n183\t            },\n184\t        ));\n185\t\n186\t        inject_default_manifest_config(&id, &self.home_dir, &mut manifest).unwrap();\n187\t\n188\t        if with_proto {\n189\t            let context = ToolContext::new(id.clone());\n190\t\n191\t            inject_proto_manifest_config(&context, &self.proto, &mut manifest).unwrap();\n192\t        }\n193\t\n194\t        PluginContainer::new(id, manifest, self.create_host_funcs(virtual_paths)).unwrap()\n195\t    }\n196\t\n197\t    fn create_host_funcs(&self, virtual_paths: Vec<(PathBuf, PathBuf)>) -> Vec<Function> {\n198\t        let loader = PluginLoader::new(self.moon_dir.join(\"plugins\"), self.moon_dir.join(\"temp\"));\n199\t\n200\t        let host_data = HostData {\n201\t            cache_dir: self.moon_dir.join(\"cache\"),\n202\t            http_client: loader.get_http_client().unwrap().clone(),\n203\t            virtual_paths,\n204\t            working_dir: self.root.clone(),\n205\t        };\n206\t\n207\t        let mut funcs = create_host_functions(host_data.clone());\n208\t\n209\t        for func_type in [\n210\t            MoonHostFunction::LoadExtensionConfig,\n211\t            MoonHostFunction::LoadProject,\n212\t            MoonHostFunction::LoadProjects,\n213\t            MoonHostFunction::LoadTask,\n214\t            MoonHostFunction::LoadTasks,\n215\t            MoonHostFunction::LoadToolchainConfig,\n216\t        ] {\n217\t            funcs.push(Function::new(\n218\t                func_type.as_str().to_string(),\n219\t                if func_type == MoonHostFunction::LoadToolchainConfig {\n220\t                    vec![ValType::I64, ValType::I64]\n221\t                } else {\n222\t                    vec![ValType::I64]\n223\t                },\n224\t                [ValType::I64],\n225\t                UserData::new((func_type, self.host_funcs.clone())),\n226\t                mocked_host_func_impl,\n227\t            ));\n228\t        }\n229\t\n230\t        funcs\n231\t    }\n232\t}\n233\t\n234\timpl Deref for MoonWasmSandbox {\n235\t    type Target = Sandbox;\n236\t\n237\t    fn deref(&self) -> &Self::Target {\n238\t        &self.sandbox\n239\t    }\n240\t}\n241\t\n242\timpl fmt::Debug for MoonWasmSandbox {\n243\t    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n244\t        f.debug_struct(\"MoonWasmSandbox\")\n245\t            .field(\"home_dir\", &self.home_dir)\n246\t            .field(\"moon_dir\", &self.moon_dir)\n247\t            .field(\"proto_dir\", &self.proto_dir)\n248\t            .field(\"root\", &self.root)\n249\t            .field(\"wasm_file\", &self.wasm_file)\n250\t            .finish()\n251\t    }\n252\t}\n253\t\n254\tpub fn create_moon_sandbox(fixture: &str) -> MoonWasmSandbox {\n255\t    MoonWasmSandbox::new(create_sandbox(fixture))\n256\t}\n257\t\n258\tpub fn create_empty_moon_sandbox() -> MoonWasmSandbox {\n259\t    MoonWasmSandbox::new(create_empty_sandbox())\n260\t}\n261\t"}]},"uuid":"2299b6c4-72f5-4d5c-bd00-e54084a54e10","timestamp":"2026-08-22T00:49:07.777Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/moon_pdk_test_utils-2.0.4/src/sandbox.rs","content":"use crate::extension_wrapper::*;\nuse crate::host_func_mocker::*;\nuse crate::toolchain_wrapper::*;\nuse extism::{Function, UserData, ValType};\nuse moon_pdk_api::{\n    Id, RegisterExtensionInput, RegisterExtensionOutput, RegisterToolchainInput,\n    RegisterToolchainOutput,\n};\nuse proto_core::{ProtoEnvironment, Tool, ToolContext, inject_proto_manifest_config};\nuse proto_pdk_test_utils::WasmTestWrapper as ToolTestWrapper;\nuse starbase_sandbox::{Sandbox, create_empty_sandbox, create_sandbox};\nuse std::fmt;\nuse std::fs;\nuse std::ops::Deref;\nuse std::path::PathBuf;\nuse std::sync::Arc;\nuse warpgate::{\n    PluginContainer, PluginLoader, PluginManifest, Wasm, host::*, inject_default_manifest_config,\n    test_utils::*,\n};\n\npub struct MoonWasmSandbox {\n    pub sandbox: Sandbox,\n    pub home_dir: PathBuf,\n    pub host_funcs: MockedHostFuncs,\n    pub moon_dir: PathBuf,\n    pub proto: Arc<ProtoEnvironment>,\n    pub proto_dir: PathBuf,\n    pub root: PathBuf,\n    pub wasm_file: PathBuf,\n}\n\nimpl MoonWasmSandbox {\n    pub fn new(sandbox: Sandbox) -> Self {\n        let root = sandbox.path().to_path_buf();\n        let home_dir = root.join(\".home\");\n        let moon_dir = root.join(\".moon\");\n        let proto_dir = root.join(\".proto\");\n        let wasm_file = find_wasm_file();\n\n        // Folders must exist for WASM to compile correctly!\n        fs::create_dir_all(&home_dir).unwrap();\n        fs::create_dir_all(&moon_dir).unwrap();\n        fs::create_dir_all(&proto_dir).unwrap();\n\n        // Required for toolchains\n        let mut proto = ProtoEnvironment::new_testing(&root).unwrap();\n        proto.working_dir = root.clone();\n\n        Self {\n            home_dir,\n            moon_dir,\n            proto: Arc::new(proto),\n            proto_dir,\n            root,\n            sandbox,\n            wasm_file,\n            host_funcs: MockedHostFuncs::default(),\n        }\n    }\n\n    pub fn create_config(&self) -> ConfigBuilder {\n        ConfigBuilder::new(&self.root, &self.home_dir)\n    }\n\n    pub async fn create_extension(&self, id: &str) -> ExtensionTestWrapper {\n        self.create_extension_with_config(id, |_| {}).await\n    }\n\n    pub async fn create_extension_with_config(\n        &self,\n        id: &str,\n        mut op: impl FnMut(&mut ConfigBuilder),\n    ) -> ExtensionTestWrapper {\n        let id = Id::raw(id);\n\n        // Create manifest\n        let mut manifest = PluginManifest::new([Wasm::file(self.wasm_file.clone())]);\n\n        // Create config\n        let mut config = self.create_config();\n        config.plugin_id(&id);\n\n        op(&mut config);\n\n        manifest.config.extend(config.build());\n\n        // Create plugin\n        let plugin = self.create_plugin_container(id, manifest, false);\n        let metadata: RegisterExtensionOutput = plugin\n            .cache_func_with(\n                \"register_extension\",\n                RegisterExtensionInput {\n                    id: plugin.id.clone(),\n                },\n            )\n            .await\n            .unwrap();\n\n        ExtensionTestWrapper {\n            metadata,\n            plugin,\n            root: self.root.clone(),\n        }\n    }\n\n    pub async fn create_toolchain(&self, id: &str) -> ToolchainTestWrapper {\n        self.create_toolchain_with_config(id, |_| {}).await\n    }\n\n    pub async fn create_toolchain_with_config(\n        &self,\n        id: &str,\n        mut op: impl FnMut(&mut ConfigBuilder),\n    ) -> ToolchainTestWrapper {\n        let id = Id::raw(id);\n\n        // Create manifest\n        let mut manifest = PluginManifest::new([Wasm::file(self.wasm_file.clone())]);\n\n        // Create config\n        let mut config = self.create_config();\n        config.plugin_id(&id);\n\n        op(&mut config);\n\n        manifest.config.extend(config.build());\n\n        // Create plugin\n        let plugin = Arc::new(self.create_plugin_container(id, manifest, true));\n        let metadata: RegisterToolchainOutput = plugin\n            .cache_func_with(\n                \"register_toolchain\",\n                RegisterToolchainInput {\n                    id: plugin.id.clone(),\n                },\n            )\n            .await\n            .unwrap();\n\n        ToolchainTestWrapper {\n            metadata,\n            plugin: plugin.clone(),\n            root: self.root.clone(),\n            tool: if plugin.has_func(\"register_tool\").await {\n                Some(ToolTestWrapper {\n                    tool: Tool::new(\n                        ToolContext::new(plugin.id.clone()),\n                        self.proto.clone(),\n                        plugin,\n                    )\n                    .await\n                    .unwrap(),\n                })\n            } else {\n                None\n            },\n        }\n    }\n\n    pub fn enable_logging(&self) {\n        enable_wasm_logging(&self.wasm_file);\n    }\n\n    fn create_plugin_container(\n        &self,\n        id: Id,\n        mut manifest: PluginManifest,\n        with_proto: bool,\n    ) -> PluginContainer {\n        let virtual_paths = vec![\n            (self.root.clone(), \"/workspace\".into()),\n            (self.home_dir.clone(), \"/userhome\".into()),\n            (self.moon_dir.clone(), \"/moon\".into()),\n            (self.proto_dir.clone(), \"/proto\".into()),\n        ];\n\n        manifest.timeout_ms = None;\n        manifest = manifest.with_allowed_host(\"*\");\n        manifest = manifest.with_allowed_paths(virtual_paths.iter().map(\n            |(key, value): &(PathBuf, PathBuf)| {\n                (key.to_string_lossy().to_string(), value.to_owned())\n            },\n        ));\n\n        inject_default_manifest_config(&id, &self.home_dir, &mut manifest).unwrap();\n\n        if with_proto {\n            let context = ToolContext::new(id.clone());\n\n            inject_proto_manifest_config(&context, &self.proto, &mut manifest).unwrap();\n        }\n\n        PluginContainer::new(id, manifest, self.create_host_funcs(virtual_paths)).unwrap()\n    }\n\n    fn create_host_funcs(&self, virtual_paths: Vec<(PathBuf, PathBuf)>) -> Vec<Function> {\n        let loader = PluginLoader::new(self.moon_dir.join(\"plugins\"), self.moon_dir.join(\"temp\"));\n\n        let host_data = HostData {\n            cache_dir: self.moon_dir.join(\"cache\"),\n            http_client: loader.get_http_client().unwrap().clone(),\n            virtual_paths,\n            working_dir: self.root.clone(),\n        };\n\n        let mut funcs = create_host_functions(host_data.clone());\n\n        for func_type in [\n            MoonHostFunction::LoadExtensionConfig,\n            MoonHostFunction::LoadProject,\n            MoonHostFunction::LoadProjects,\n            MoonHostFunction::LoadTask,\n            MoonHostFunction::LoadTasks,\n            MoonHostFunction::LoadToolchainConfig,\n        ] {\n            funcs.push(Function::new(\n                func_type.as_str().to_string(),\n                if func_type == MoonHostFunction::LoadToolchainConfig {\n                    vec![ValType::I64, ValType::I64]\n                } else {\n                    vec![ValType::I64]\n                },\n                [ValType::I64],\n                UserData::new((func_type, self.host_funcs.clone())),\n                mocked_host_func_impl,\n            ));\n        }\n\n        funcs\n    }\n}\n\nimpl Deref for MoonWasmSandbox {\n    type Target = Sandbox;\n\n    fn deref(&self) -> &Self::Target {\n        &self.sandbox\n    }\n}\n\nimpl fmt::Debug for MoonWasmSandbox {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        f.debug_struct(\"MoonWasmSandbox\")\n            .field(\"home_dir\", &self.home_dir)\n            .field(\"moon_dir\", &self.moon_dir)\n            .field(\"proto_dir\", &self.proto_dir)\n            .field(\"root\", &self.root)\n            .field(\"wasm_file\", &self.wasm_file)\n            .finish()\n    }\n}\n\npub fn create_moon_sandbox(fixture: &str) -> MoonWasmSandbox {\n    MoonWasmSandbox::new(create_sandbox(fixture))\n}\n\npub fn create_empty_moon_sandbox() -> MoonWasmSandbox {\n    MoonWasmSandbox::new(create_empty_sandbox())\n}\n","numLines":261,"startLine":1,"totalLines":261}},"sourceToolAssistantUUID":"42ad3402-8601-4e9e-b8df-d9254bb0f5cb","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
