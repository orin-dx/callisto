previously approved intent. This is the only durable mutation route'\n         callisto-cli:test |             cand help 'Print this message or the help of the given subcommand(s)'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;help;plan'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;help;inspect'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;help;reconcile'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;help;execute'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;help;help'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;completions'= {\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;schema'= {\n         callisto-cli:test |             cand --type 'Report type to print the schema for (status, version, snapshot, validate, tag, init, plan-publish, changeset, pre, matrix); defaults to status'\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h '