ns().len());\n            assert!(wire[\"operations\"].as_array().unwrap().iter().any(|entry| {\n                entry[\"operation\"][\"kind\"] == \"productTag\" && entry[\"operation\"][\"release\"][\"product\"] == \"callisto\"\n            }));\n            assert_eq!(serde_json::from_value::<ReleaseExecutionState>(wire).unwrap(), state);\n        }\n    }\n}\n\n"},{"type":"input_text","text":"\n[76] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"pub use .*successor|successor::\\\" crates/callisto-model/src/lib.rs && rtk sed -n '15,65p' crates/callisto-model/src/lib.rs && rtk rg -n \\\"enum OperationOutcome|enum OperationBlockReason\\\" crates/callisto-model/src/release.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":10000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[77] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\n61:pub use release::successor::*;\npub mod path;\npub use path::*;\n\npub mod identity;\npub use identity::*;\n\npub mod ecosystem;\npub use ecosystem::*;\n\npub mod version;\npub use version::*;\n\npub mod severity;\npub use severity::*;\n\npub mod package;\npub use package::*;\n\npub mod dependency;\npub use dependency::*;\n\npub mod discovery;\npub use discovery::*;\n\npub mod exec;\npub use exec::*;\n\npub mod commit;\npub use commit::*;\n\npub mod diagnostic;\npub use diagnostic::*;\n\npub mod plan;\npub use plan::*;\n\npub mod report;\npub use report::*;\n\npub mod matrix;\npub use matrix::*;\n\npub mod registry;\npub use registry::*;\n\nmod release;\npub use release::successor::*;\npub use release::{\n    ArtifactDigest, CanonicalTranscript, DecisionDigest, DigestParseError, GitHubRepository,\n    GitHubRepositoryParseError, IntentDigest, OperationBlockReason, OperationOutcome, RegistryBindingDigest,\n    RegistryBindingId, ReleaseDecisionEntry, ReleaseDecisionError, ReleaseDecisionV1, ReleaseInclusionReason,\n772:pub enum OperationBlockReason {\n783:pub enum OperationOutcome {\n\n"},{"type":"input_text","text":"\n[78] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-model/src/release.rs\\n@@\\n-    /// Crash-safe local progress for one exact product release intent.\\n-    ///\\n-    /// This deliberately retains the existing pending/attempting/terminal\\n-    /// semantics while keying state by the promoted product operation\\n-    /// identity. Observation-backed receipts replace this state in the\\n-    /// convergence cutover; this type is only the durable resume journal.\\n-    #[derive(Clone, Debug, PartialEq, Eq, JsonSchema)]\\n-    #[schemars(with = \\\"ReleaseExecutionStateWire\\\")]\\n-    pub struct ReleaseExecutionState {\\n-        schema_version: u8,\\n-        intent_digest: IntentDigest,\\n-        operations: BTreeMap<ReleaseOperationId, ReleaseOperationState>,\\n-    }\\n-\\n-    #[derive(Serialize, Deserialize, JsonSchema)]\\n-    #[serde(rename_all = \\\"camelCase\\\", deny_unknown_fields)]\\n-    struct ReleaseExecutionStateWire {\\n-        schema_version: u8,\\n-        intent_digest: IntentDigest,\\n-        operations: Vec<ReleaseOperationStateEntry>,\\n-    }\\n-\\n-    #[derive(Serialize, Deserialize, JsonSchema)]\\n-    #[serde(rename_all = \\\"camelCase\\\", deny_unknown_fields)]\\n-    struct ReleaseOperationStateEntry {\\n-        operation: ReleaseOperationId,\\n-        state: ReleaseOperationState,\\n-    }\\n-\\n-    #[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]\\n-    #[serde(rename_all = \\\"camelCase\\\")]\\n-    pub enum ReleaseOperationState {\\n-        Pending,\\n-        Attempting,\\n-        Published,\\n-        AlreadySatisfied,\\n-        Failed,\\n-        Blocked { reason: OperationBlockReason },\\n-    }\\n-\\n-    impl Serialize for ReleaseExecutionState {\\n-        fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Erro