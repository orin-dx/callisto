eBody\":\"\",\"messageHeadline\":\"feat(model): bind artifact uploads to immutable attestation\",\"oid\":\"8a41b8d39855fc5ece2b412526ca9f4a2b2db1e2\"},{\"authoredDate\":\"2026-09-01T03:55:38Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T03:55:38Z\",\"messageBody\":\"Entire-Checkpoint: 01M1DHQFF8AEYCPP22SJWWCCT3\",\"messageHeadline\":\"feat(graph): derive exact selected release decisions\",\"oid\":\"086ec74f2d4dfa05f75fb1a9b1301471efff4883\"},{\"authoredDate\":\"2026-09-01T03:59:26Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T03:59:26Z\",\"messageBody\":\"Entire-Checkpoint: 01M1DHYD6PTT93TAFJXZ3N2CWX\",\"messageHeadline\":\"feat(cli): add durable release command boundary\",\"oid\":\"edc9659b5624ba209862811355ffdede9c6387f1\"},{\"authoredDate\":\"2026-09-01T04:03:52Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T04:03:52Z\",\"messageBody\":\"\",\"messageHeadline\":\"fix(ci): disable legacy release mutation route\",\"oid\":\"76c76bba18f0f22072804fd4998a0caf1b8d8c2a\"},{\"authoredDate\":\"2026-09-01T14:21:55Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T14:21:55Z\",\"messageBody\":\"Entire-Checkpoint: 01M1ENJ79WBRW9GHTNMRV0A8JP\",\"messageHeadline\":\"feat(release): execute validated prepared operations\",\"oid\":\"c470e192901e3f732257c595fecccc13f25906d9\"},{\"authoredDate\":\"2026-09-01T14:37:58Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T14:37:58Z\",\"messageBody\":\"\",\"messageHeadline\":\"fix(release): verify forge identity and isolate pypi builds\",\"oid\":\"4c94c657712e3d2cfbf26ce919d64073d31f9e6d\"},{\"authoredDate\":\"2026-09-01T14:38:16Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T14:38:16Z\",\"messageBody\":\"\",\"messageHeadline\":\"ci: automate github action pin updates\",\"oid\":\"aac6dcc7088a4411f912cb5333a981cafe834ea0\"},{\"authoredDate\":\"2026-09-01T15:42:47Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T15:42:47Z\",\"messageBody\":\"\",\"messageHeadline\":\"fix(release): verify exact prepared tag annotations\",\"oid\":\"178ad47123ed01016f81d2b5d72773af35a40567\"},{\"authoredDate\":\"2026-09-01T15:48:31Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T15:48:31Z\",\"messageBody\":\"\",\"messageHeadline\":\"fix(release): bind Git effects to validated remote\",\"oid\":\"a2cdfa5b5166228ffbc3aaa25d7819c684a5ee35\"},{\"authoredDate\":\"2026-09-01T15:51:10Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T15:51:10Z\",\"messageBody\":\"\",\"messageHeadline\":\"fix(release): verify npm registry publish outcomes\",\"oid\":\"f201be9efd624f23ba66aa78a9b0d9079f980d8a\"},{\"authoredDate\":\"2026-09-01T15:52:35Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T15:52:35Z\",\"messageBody\":\"\",\"messageHeadline\":\"fix(release): preserve npm prerelease channel\",\"oid\":\"296a69364eb5f71e0dd7bd085dd20034fba12e4c\"},{\"authoredDate\":\"2026-09-01T15:53:43Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\