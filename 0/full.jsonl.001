rsion.rs\\'s PreRelease-exit handling '\n            'then injects `Severity::Patch` and `BumpReason::PreRelease { tag }`, `agg.changelog_inputs.get(id)` '\n            'is `None`, and the catch-all at version.rs:188-199 is reached (PreRelease has no direct ChangeSource '\n            'mapping under AC-003/AC-005). Call `plan_version` with `VersionOptions::default()`, assert it '\n            'returns `Ok`, and assert the package\\'s `ChangelogWrite.input.entries` has exactly 1 entry matching '\n            '`ChangeSource::Changeset { filename: \"\", summary }` where `summary == \"Version bump (patch)\"`.'\n        )\n        assert old_test in ac['criterion'], \"old test text not found verbatim\"\n        ac['criterion'] = ac['criterion'].replace(old_test, new_test)\n        print(\"AC-006 test method replaced\")\n\nwith open('spec-track5-draft.json', 'w') as f:\n    json.dump(spec, f, indent=2)\nprint(\"done\")\nPYEOF","description":"Replace AC-006's unreachable test fixture with the gate's exact reachable alternative"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1567,"cache_read_input_tokens":766449,"output_tokens":1097,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1567,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1097,"cache_read_input_tokens":766449,"cache_creation_input_tokens":1567,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1567},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CeEhEhvLZAd6CXtWHxoNt","type":"assistant","uuid":"915b330d-0e1b-4339-beac-1f539e00017e","timestamp":"2026-08-20T21:16:31.189Z","effort":"high","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external",