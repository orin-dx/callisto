{"parentUuid":"063af29a-c70c-4c85-a80d-4af5bdbfcbab","isSidechain":false,"promptId":"24e10f4b-5703-40ff-9836-a44041fe3a4c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DEwusZsXzysfWvAQabMUCB","type":"tool_result","content":" crates/callisto-cli/src/error.rs                   | 73 +++++++++++++---------\n crates/callisto-cli/src/main.rs                    | 10 +--\n crates/callisto-cli/tests/error_envelope_tests.rs  |  9 +--\n .../callisto-cli/tests/usage_exit_codes_tests.rs   | 47 --------------\n crates/callisto-graph/src/error.rs                 | 56 +++++++++++++++++\n crates/callisto-graph/src/lib.rs                   |  2 +-\n 6 files changed, 106 insertions(+), 91 deletions(-)\n-use callisto_graph::{ConfigError, GraphError};\n+use callisto_graph::{ConfigError, ExitKind, GraphError};\n-/// Codes for a bad or missing flag or argument value, or a bad flag combination, caught after parsing. These exit 2.\n-/// Every other code exits 1. `tests/usage_exit_codes_tests.rs` fails when a code in docs/errors.md is in neither list.\n-pub const USAGE_CODES: &[&str] = &[\n-    \"E195\", \"E196\", \"E214\", \"E216\", \"E217\", \"E218\", \"E224\", \"E225\", \"E226\", \"E227\", \"E228\", \"E229\", \"E231\", \"E240\",\n-    \"E241\", \"E242\", \"E270\", \"E271\", \"E274\", \"E275\", \"E276\", \"E279\", \"E282\", \"E283\", \"E298\", \"E309\", \"E324\", \"E327\",\n-    \"E329\",\n-];\n-\n-/// Codes that are usage errors only when the offending reference came from a flag (context `--package`).\n-/// The same codes from `callisto.toml` content are runtime errors.\n-pub const USAGE_WHEN_FROM_FLAG_CODES: &[&str] = &[\"E316\", \"E317\"];\n-\n-    /// True when the command line input was wrong or incomplete, as opposed to workspace, config, git or registry state.\n-    pub fn is_usage_error(&self) -> bool {\n-        let Some(code) = self.code().map(|c| c.to_string()) else {\n-            return false;\n-        };\n-        if USAGE_CODES.contains(&code.as_str()) {\n-            return true;\n-        }\n-        let config = match self {\n-            Self::Config(config) | Self::Graph(GraphError::Config(config)) => config,\n-            _ => return false,\n-        };\n-        match config {\n-            ConfigError::BareReference { context, .. } | ConfigError::ColonReference { context, .. } => {\n-                context.starts_with(\"--\")\n-            }\n-            _ => false,\n+    pub fn exit_kind(&self) -> ExitKind {\n+        match self {\n+            Self::Graph(error) => error.exit_kind(),\n+            Self::Config(error) => error.exit_kind(),\n+            Self::NotATty\n+            | Self::ReleaseArtifactManifestDryRun\n+            | Self::ReleasePlanDryRun\n+            | Self::ReleaseExecuteDryRun\n+            | Self::ReleasePendingFromInvalid { .. }\n+            | Self::ReleaseBuildPythonDryRun\n+            | Self::ReleaseCommitInvalid { .. }\n+            | Self::ReleaseDecisionOutsideSource { .. }\n+            | Self::ReleaseDecisionPathInvalid { .. }\n+            | Self::ReleasePackageInvalid { .. }\n+            | Self::ReleaseOrchestrationRevisionInvalid { .. }\n+            | Self::ReleaseArtifactRepositoryInvalid { .. }\n+            | Self::ReleaseOrchestrationFlagsRequired\n+            | Self::InitRequiresYes { .. }\n+            | Self::InitMissingFlags { .. }\n+            | Self::InitWorkflowFlagsConflict\n+            | Self::InitFlagRequiresArtifactTarget { .. }\n+            | Self::AddInvalidPackageSpec { .. }\n+            | Self::InvalidSeverity { .. }\n+            | Self::AddSummaryRequired\n+            | Self::AddDuplicatePackage { .. }\n+            | Self::AddSummaryEmpty\n+            | Self::VersionEmitDryRun { .. }\n+            | Self::PreTagEmpty\n+            | Self::ReleasePrCommitPlanDryRun\n+            | Self::HelpUnknownCommand { .. } => ExitKind::Usage,\n+            _ => ExitKind::Runtime,\n+    #[test]\n+    fn exit_kind_is_usage_only_for_flag_input_errors() {\n+        assert_eq!(CliError::AddSummaryEmpty.exit_kind(), ExitKind::Usage);\n+        assert_eq!(CliError::PreNotActive.exit_kind(), ExitKind::Runtime);\n+        let bare = ConfigError::BareReference {\n+            context: \"--package\".to_owned(),\n+            given: \"a\".to_owned(),\n+        };\n+        assert_eq!(CliError::Graph(GraphError::Config(bare)).exit_kind(), ExitKind::Usage);\n+    }\n+\n+use callisto_graph::ExitKind;\n-// Exit codes: 0 success, 1 failure, 2 usage error: from clap, or a handler error `CliError::is_usage_error` classifies (docs/stability.md). A handle\n+// Exit codes: 0 success, 1 failure, 2 usage error: from clap, or a handler error whose `exit_kind` is usage (docs/stability.md). A handler's `Ok(cod\n-            let exit = if err.is_usage_error() {\n-                ExitCode::from(2)\n-            } else {\n-                ExitCode::FAILURE\n+            let exit = match err.exit_kind() {\n+                ExitKind::Usage => ExitCode::from(2),\n+                ExitKind::Runtime => ExitCode::FAILURE,\n+    #[test]\n+    fn exit_kind_is_usage_only_for_flag_input_errors() {\n+        let tag = GraphError::TagInvalid { tag: \"a b\".to_owned() };\n+        assert_eq!(tag.exit_kind(), ExitKind::Usage);\n+        let exists = GraphError::InitAlreadyInitialized {\n+            path: PathBuf::from(\"callisto.toml\"),\n+        };\n+        assert_eq!(exists.exit_kind(), ExitKind::Runtime);\n+    }\n+\n+    #[test]\n+    fn a_package_reference_is_usage_only_when_it_came_from_a_flag() {\n+        let bare = |context: &str| ConfigError::BareReference {\n+            context: context.to_owned(),\n+            given: \"a\".to_owned(),\n+        };\n+        let colon = |context: &str| ConfigError::ColonReference {\n+            context: context.to_owned(),\n+            given: \"cargo:a\".to_owned(),\n+            canonical: \"cargo/a\".to_owned(),\n+        };\n+        assert_eq!(bare(\"--package\").exit_kind(), ExitKind::Usage);\n+        assert_eq!(colon(\"--package\").exit_kind(), ExitKind::Usage);\n+        assert_eq!(bare(\"callisto.toml [[package]]\").exit_kind(), ExitKind::Runtime);\n+        assert_eq!(colon(\"callisto.toml [[package]]\").exit_kind(), ExitKind::Runtime);\n+    }\n+\n+/// Whether a failure is bad command-line input (exit 2) or anything else (exit 1).\n+#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n+pub enum ExitKind {\n+    /// A bad or missing flag or argument value, or a bad flag combination, caught after parsing.\n+    Usage,\n+    /// Workspace, config, git, registry or release state.\n+    Runtime,\n+}\n+\n+    pub fn exit_kind(&self) -> ExitKind {\n+        match self {\n+            Self::Config(error) => error.exit_kind(),\n+            Self::InitInvalidForgeRepository { .. }\n+            | Self::InitInvalidTargetTriple { .. }\n+            | Self::TagInvalid { .. } => ExitKind::Usage,\n+            _ => ExitKind::Runtime,\n+        }\n+    }\n+\n+    pub fn exit_kind(&self) -> ExitKind {\n+        match self {\n+            // The same reference read from callisto.toml is a config error, not usage.\n+            Self::ColonReference { context, .. } | Self::BareReference { context, .. } if context.starts_with(\"--\") => {\n+                ExitKind::Usage\n+            }\n+            _ => ExitKind::Runtime,\n+        }\n+    }\n+\n-pub use error::{ConfigError, GraphError};\n+pub use error::{ConfigError, ExitKind, GraphError};","is_error":false}]},"uuid":"64805dbc-cfc7-451f-a0ae-c9db828d7171","timestamp":"2026-11-11T20:30:13.066Z","toolUseResult":{"stdout":" crates/callisto-cli/src/error.rs                   | 73 +++++++++++++---------\n crates/callisto-cli/src/main.rs                    | 10 +--\n crates/callisto-cli/tests/error_envelope_tests.rs  |  9 +--\n .../callisto-cli/tests/usage_exit_codes_tests.rs   | 47 --------------\n crates/callisto-graph/src/error.rs                 | 56 +++++++++++++++++\n crates/callisto-graph/src/lib.rs                   |  2 +-\n 6 files changed, 106 insertions(+), 91 deletions(-)\n-use callisto_graph::{ConfigError, GraphError};\n+use callisto_graph::{ConfigError, ExitKind, GraphError};\n-/// Codes for a bad or missing flag or argument value, or a bad flag combination, caught after parsing. These exit 2.\n-/// Every other code exits 1. `tests/usage_exit_codes_tests.rs` fails when a code in docs/errors.md is in neither list.\n-pub const USAGE_CODES: &[&str] = &[\n-    \"E195\", \"E196\", \"E214\", \"E216\", \"E217\", \"E218\", \"E224\", \"E225\", \"E226\", \"E227\", \"E228\", \"E229\", \"E231\", \"E240\",\n-    \"E241\", \"E242\", \"E270\", \"E271\", \"E274\", \"E275\", \"E276\", \"E279\", \"E282\", \"E283\", \"E298\", \"E309\", \"E324\", \"E327\",\n-    \"E329\",\n-];\n-\n-/// Codes that are usage errors only when the offending reference came from a flag (context `--package`).\n-/// The same codes from `callisto.toml` content are runtime errors.\n-pub const USAGE_WHEN_FROM_FLAG_CODES: &[&str] = &[\"E316\", \"E317\"];\n-\n-    /// True when the command line input was wrong or incomplete, as opposed to workspace, config, git or registry state.\n-    pub fn is_usage_error(&self) -> bool {\n-        let Some(code) = self.code().map(|c| c.to_string()) else {\n-            return false;\n-        };\n-        if USAGE_CODES.contains(&code.as_str()) {\n-            return true;\n-        }\n-        let config = match self {\n-            Self::Config(config) | Self::Graph(GraphError::Config(config)) => config,\n-            _ => return false,\n-        };\n-        match config {\n-            ConfigError::BareReference { context, .. } | ConfigError::ColonReference { context, .. } => {\n-                context.starts_with(\"--\")\n-            }\n-            _ => false,\n+    pub fn exit_kind(&self) -> ExitKind {\n+        match self {\n+            Self::Graph(error) => error.exit_kind(),\n+            Self::Config(error) => error.exit_kind(),\n+            Self::NotATty\n+            | Self::ReleaseArtifactManifestDryRun\n+            | Self::ReleasePlanDryRun\n+            | Self::ReleaseExecuteDryRun\n+            | Self::ReleasePendingFromInvalid { .. }\n+            | Self::ReleaseBuildPythonDryRun\n+            | Self::ReleaseCommitInvalid { .. }\n+            | Self::ReleaseDecisionOutsideSource { .. }\n+            | Self::ReleaseDecisionPathInvalid { .. }\n+            | Self::ReleasePackageInvalid { .. }\n+            | Self::ReleaseOrchestrationRevisionInvalid { .. }\n+            | Self::ReleaseArtifactRepositoryInvalid { .. }\n+            | Self::ReleaseOrchestrationFlagsRequired\n+            | Self::InitRequiresYes { .. }\n+            | Self::InitMissingFlags { .. }\n+            | Self::InitWorkflowFlagsConflict\n+            | Self::InitFlagRequiresArtifactTarget { .. }\n+            | Self::AddInvalidPackageSpec { .. }\n+            | Self::InvalidSeverity { .. }\n+            | Self::AddSummaryRequired\n+            | Self::AddDuplicatePackage { .. }\n+            | Self::AddSummaryEmpty\n+            | Self::VersionEmitDryRun { .. }\n+            | Self::PreTagEmpty\n+            | Self::ReleasePrCommitPlanDryRun\n+            | Self::HelpUnknownCommand { .. } => ExitKind::Usage,\n+            _ => ExitKind::Runtime,\n+    #[test]\n+    fn exit_kind_is_usage_only_for_flag_input_errors() {\n+        assert_eq!(CliError::AddSummaryEmpty.exit_kind(), ExitKind::Usage);\n+        assert_eq!(CliError::PreNotActive.exit_kind(), ExitKind::Runtime);\n+        let bare = ConfigError::BareReference {\n+            context: \"--package\".to_owned(),\n+            given: \"a\".to_owned(),\n+        };\n+        assert_eq!(CliError::Graph(GraphError::Config(bare)).exit_kind(), ExitKind::Usage);\n+    }\n+\n+use callisto_graph::ExitKind;\n-// Exit codes: 0 success, 1 failure, 2 usage error: from clap, or a handler error `CliError::is_usage_error` classifies (docs/stability.md). A handle\n+// Exit codes: 0 success, 1 failure, 2 usage error: from clap, or a handler error whose `exit_kind` is usage (docs/stability.md). A handler's `Ok(cod\n-            let exit = if err.is_usage_error() {\n-                ExitCode::from(2)\n-            } else {\n-                ExitCode::FAILURE\n+            let exit = match err.exit_kind() {\n+                ExitKind::Usage => ExitCode::from(2),\n+                ExitKind::Runtime => ExitCode::FAILURE,\n+    #[test]\n+    fn exit_kind_is_usage_only_for_flag_input_errors() {\n+        let tag = GraphError::TagInvalid { tag: \"a b\".to_owned() };\n+        assert_eq!(tag.exit_kind(), ExitKind::Usage);\n+        let exists = GraphError::InitAlreadyInitialized {\n+            path: PathBuf::from(\"callisto.toml\"),\n+        };\n+        assert_eq!(exists.exit_kind(), ExitKind::Runtime);\n+    }\n+\n+    #[test]\n+    fn a_package_reference_is_usage_only_when_it_came_from_a_flag() {\n+        let bare = |context: &str| ConfigError::BareReference {\n+            context: context.to_owned(),\n+            given: \"a\".to_owned(),\n+        };\n+        let colon = |context: &str| ConfigError::ColonReference {\n+            context: context.to_owned(),\n+            given: \"cargo:a\".to_owned(),\n+            canonical: \"cargo/a\".to_owned(),\n+        };\n+        assert_eq!(bare(\"--package\").exit_kind(), ExitKind::Usage);\n+        assert_eq!(colon(\"--package\").exit_kind(), ExitKind::Usage);\n+        assert_eq!(bare(\"callisto.toml [[package]]\").exit_kind(), ExitKind::Runtime);\n+        assert_eq!(colon(\"callisto.toml [[package]]\").exit_kind(), ExitKind::Runtime);\n+    }\n+\n+/// Whether a failure is bad command-line input (exit 2) or anything else (exit 1).\n+#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n+pub enum ExitKind {\n+    /// A bad or missing flag or argument value, or a bad flag combination, caught after parsing.\n+    Usage,\n+    /// Workspace, config, git, registry or release state.\n+    Runtime,\n+}\n+\n+    pub fn exit_kind(&self) -> ExitKind {\n+        match self {\n+            Self::Config(error) => error.exit_kind(),\n+            Self::InitInvalidForgeRepository { .. }\n+            | Self::InitInvalidTargetTriple { .. }\n+            | Self::TagInvalid { .. } => ExitKind::Usage,\n+            _ => ExitKind::Runtime,\n+        }\n+    }\n+\n+    pub fn exit_kind(&self) -> ExitKind {\n+        match self {\n+            // The same reference read from callisto.toml is a config error, not usage.\n+            Self::ColonReference { context, .. } | Self::BareReference { context, .. } if context.starts_with(\"--\") => {\n+                ExitKind::Usage\n+            }\n+            _ => ExitKind::Runtime,\n+        }\n+    }\n+\n-pub use error::{ConfigError, GraphError};\n+pub use error::{ConfigError, ExitKind, GraphError};","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"3f7f51d0-7189-44f7-ba8d-0b886af20a83","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a3658a1f85bca2d75","root":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a3658a1f85bca2d75","branch":"perf/scale-hotspots","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callisto","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a3658a1f85bca2d75","platform":"macos"}},"sandboxViolations":[],"sandboxed":true,"sourceToolAssistantUUID":"063af29a-c70c-4c85-a80d-4af5bdbfcbab","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKi