{"parentUuid":"aec46981-994f-4720-8a07-2aca5dfca59e","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/commands/init.rs","snippet":"1\tuse std::collections::BTreeSet;\n2\t\n3\tuse callisto_model::{ApplyPermit, CommandRunner, Ecosystem, InitDiff, InitReport, SCHEMA_VERSION};\n4\t\n5\tuse crate::config::raw::RawConfig;\n6\tuse crate::error::{ConfigError, GraphError};\n7\tuse crate::resolver::DependencyResolver;\n8\tuse crate::Workspace;\n9\t\n10\t/// Options for the `init` command; controls whether detected ecosystem drift is written back to `callisto.toml`.\n11\t#[derive(Clone, Debug, Default)]\n12\tpub struct InitOptions {\n13\t    /// Non-interactive confirmation. On a first run this has no effect\n14\t    /// (scaffolding an absent `callisto.toml` is always a direct write; the\n15\t    /// CLI's own interactive confirm-or-abort prompt gates *that* decision\n16\t    /// before this function is ever called). On a re-run where drift is\n17\t    /// detected against the already-recorded workspace state, `yes` is what\n18\t    /// gates applying it: `false` reports the diff without touching any\n19\t    /// file (dry-preview), `true` writes it (docs/00-design.md §18 Q5.4\n20\t    /// mechanism 1 — \"re-detects, prints a diff, and applies only with\n21\t    /// confirmation\").\n22\t    ///\n23\t    /// Orthogonal to the `ApplyPermit` [`init`] takes: `yes: true` with no\n24\t    /// permit means \"the user consented to applying the drift, but this is a\n25\t    /// dry run\" -- the apply outcome is reported and nothing is written.\n26\t    pub yes: bool,\n27\t}\n28\t\n29\tfn io_err(e: std::io::Error) -> GraphError {\n30\t    GraphError::Command(callisto_model::CommandError::Io {\n31\t        program: \"fs\".to_string(),\n32\t        message: e.to_string(),\n33\t    })\n34\t}\n35\t\n36\t/// Ecosystems the discovered workspace currently contains, deduplicated and\n37\t/// ordered by `Ecosystem`'s own `Ord` (stable regardless of manifest-walk\n38\t/// order).\n39\tfn discovered_ecosystems<D: DependencyResolver>(graph: &D) -> BTreeSet<Ecosystem> {\n40\t    graph\n41\t        .packages()\n42\t        .flat_map(|p| p.canonical_manifests())\n43\t        .map(|m| m.ecosystem())\n44\t        .collect()\n45\t}\n46\t\n47\t/// Ecosystems recorded in an existing `callisto.toml`'s `[init]` bookkeeping\n48\t/// section (§18 Q5.4 mechanism 1's reconcile baseline). Unrecognized prefix\n49\t/// strings are ignored rather than treated as a hard parse error — bookkeeping\n50\t/// drift here should never block a command whose entire job is \"helpfully\n51\t/// tell the user what changed.\"\n52\tfn recorded_ecosystems(content: &str) -> BTreeSet<Ecosystem> {\n53\t    toml::from_str::<RawConfig>(content)\n54\t        .ok()\n55\t        .and_then(|raw| raw.init)\n56\t        .and_then(|init| init.ecosystems)\n57\t        .unwrap_or_default()\n58\t        .iter()\n59\t        .filter_map(|s| Ecosystem::from_prefix(s))\n60\t        .collect()\n61\t}\n62\t\n63\t/// Renders the sorted `[init]` ecosystems array as TOML source, e.g.\n64\t/// `[\"cargo\", \"npm\"]`.\n65\tfn render_ecosystems_array(ecosystems: &BTreeSet<Ecosystem>) -> String {\n66\t    let items: Vec<String> = ecosystems\n67\t        .iter()\n68\t        .map(|e| format!(\"\\\"{}\\\"\", e.prefix()))\n69\t        .collect();\n70\t    format!(\"[{}]\", items.join(\", \"))\n71\t}\n72\t\n73\t/// Writes (or rewrites) the `[init]` table's `ecosystems` key in an existing\n74\t/// `callisto.toml` document via a CST edit, so every other key — including\n75\t/// ones the user hand-edited — survives byte-for-byte (§13 invariant 21's\n76\t/// \"membership changes are only ever written via an explicit, reviewable\n77\t/// flow\" reasoning applies equally to this bookkeeping key).\n78\tfn set_recorded_ecosystems(\n79\t    content: &str,\n80\t    ecosystems: &BTreeSet<Ecosystem>,\n81\t) -> Result<String, GraphError> {\n82\t    let mut doc: toml_edit::DocumentMut = content.parse().map_err(|e: toml_edit::TomlError| {\n83\t        GraphError::Config(ConfigError::ParseToml {\n84\t            path: \"callisto.toml\".into(),\n85\t            message: e.to_string(),\n86\t        })\n87\t    })?;\n88\t\n89\t    if doc.get(\"init\").and_then(|i| i.as_table()).is_none() {\n90\t        doc[\"init\"] = toml_edit::Item::Table(toml_edit::Table::new());\n91\t    }\n92\t    let mut array = toml_edit::Array::new();\n93\t    for e in ecosystems {\n94\t        array.push(e.prefix());\n95\t    }\n96\t    doc[\"init\"][\"ecosystems\"] = toml_edit::value(array);\n97\t\n98\t    Ok(doc.to_string())\n99\t}\n100\t\n101\t/// Scaffolds `callisto.toml` and `.changeset/`, or reconciles an existing\n102\t/// config against the workspace's currently-discovered ecosystems.\n103\t///\n104\t/// `permit` and [`InitOptions::yes`] are independent gates and neither\n105\t/// subsumes the other. `yes` answers \"should detected drift be applied?\";\n106\t/// `permit` answers \"may anything be written at all?\". `--yes --dry-run`\n107\t/// therefore takes the apply *branch* while performing no write -- the\n108\t/// returned [`InitReport`] describes what would happen, exactly as\n109\t/// `version --dry-run` reports the plan it did not apply.\n110\t///\n111\t/// Every computation still runs under a dry run, including the TOML re-render\n112\t/// in `set_recorded_ecosystems`, so a config that would fail to parse on a\n113\t/// real run fails the dry run too rather than reporting a false preview.\n114\t///\n115\t/// # Errors\n116\t///\n117\t/// Returns `Err(GraphError::Config(...))` if `callisto.toml` cannot be read or parsed,\n118\t/// or if the TOML edit for the reconciled ecosystem list fails.\n119\t/// Returns `Err` wrapping an I/O error on filesystem write failures.\n120\tpub fn init<R: CommandRunner, D: DependencyResolver>(\n121\t    ws: &Workspace<'_, R, D>,\n122\t    opts: &InitOptions,\n123\t    permit: Option<&ApplyPermit>,\n124\t) -> Result<InitReport, GraphError> {\n125\t    let config_path = ws.root.join(\"callisto.toml\");\n126\t    let discovered = discovered_ecosystems(&ws.graph);\n127\t    let mut initialized = false;\n128\t    let mut diff = InitDiff::default();\n129\t\n130\t    if !config_path.exists() {\n131\t        // First run: nothing recorded yet to diff against, so this is a\n132\t        // direct write, not a reconcile-apply.\n133\t        let content = format!(\n134\t            \"# callisto configuration\\n\\n[changesets]\\ndir = \\\".changeset\\\"\\n\\n\\\n135\t[cascade]\\nmode = \\\"out-of-range\\\"\\nbump-severity = \\\"patch\\\"\\npeer-escalation = true\\npreserve-npm-ranges = true\\n\\n\\\n136\t[init]\\necosystems = {}\\n\",\n137\t            render_ecosystems_array(&discovered)\n138\t        );\n139\t        if let Some(permit) = permit {\n140\t            callisto_manifests::atomic::atomic_write(&config_path, &content, permit)\n141\t                .map_err(io_err)?;\n142\t        }\n143\t        initialized = true;\n144\t    } else {\n145\t        let existing = std::fs::read_to_string(&config_path).map_err(|e| {\n146\t            GraphError::Config(ConfigError::Read {\n147\t                path: config_path.clone(),\n148\t                message: e.to_string(),\n149\t            })\n150\t        })?;\n151\t        let recorded = recorded_ecosystems(&existing);\n152\t        let new_ecosystems: Vec<Ecosystem> = discovered.difference(&recorded).copied().collect();\n153\t\n154\t        if !new_ecosystems.is_empty() {\n155\t            diff.new_ecosystems = new_ecosystems;\n156\t\n157\t            if opts.yes {\n158\t                let reconciled: BTreeSet<Ecosystem> =\n159\t                    recorded.union(&discovered).copied().collect();\n160\t                let updated = set_recorded_ecosystems(&existing, &reconciled)?;\n161\t                if let Some(permit) = permit {\n162\t                    callisto_manifests::atomic::atomic_write(&config_path, &updated, permit)\n163\t                        .map_err(io_err)?;\n164\t                }\n165\t                diff.applied = true;\n166\t            }\n167\t            // else: the diff is reported above without applying it. Note this\n168\t            // is a *separate* no-write path from `permit: None`; `init`\n169\t            // without `--yes` reports drift on a real run too.\n170\t        }\n171\t    }\n172\t\n173\t    let cs_dir = ws.root.join(\".changeset\");\n174\t    if let Some(permit) = permit {\n175\t        if !cs_dir.exists() {\n176\t            std::fs::create_dir_all(&cs_dir).map_err(io_err)?;\n177\t        }\n178\t        let readme_path = cs_dir.join(\"README.md\");\n179\t        if !readme_path.exists() {\n180\t            let readme_content = r#\"# Changesets\n181\t\n\n... [16 lines truncated] ..."},"type":"attachment","uuid":"d37dd058-fa8e-4999-b5e9-51ce5eda5733","timestamp":"2026-08-23T03:29:44.863Z","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"fix-publish-order-dev-deps","slug":"shimmying-giggling-hickey"}
{"parentUuid":"d37dd058-fa8e-4999-b5e9-51ce5eda5733","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/crates/callisto-vcs/src/shell.rs","snippet":"1\t//! `CommandRunner`-shelled implementation of [`GitDataSource`], consolidated\n2\t//! from five independently hand-rolled `git`-subprocess fallbacks that used\n3\t//! to live at each call site (`callisto-graph`'s `changed.rs`, `tags.rs`,\n4\t//! `commands/tag.rs`, `aggregate.rs`, and `callisto-conventional`'s\n5\t//! `window.rs`). Every operation here is reachable purely via\n6\t//! [`callisto_model::CommandRunner`], so it works on every target,\n7\t//! including `wasm32`, where native `gix` (`GitRepository`) is entirely\n8\t//! unavailable.\n9\t//!\n10\t//! Callers should not construct [`ShellGit`] directly except in tests that\n11\t//! specifically want to exercise the shell backend in isolation; use\n12\t//! [`crate::GitAccess::discover`] instead, which selects between this and\n13\t//! the native backend automatically.\n14\t\n15\tuse std::path::{Path, PathBuf};\n16\t\n17\tuse callisto_model::{ApplyPermit, CommandRunner, CommitSha, TagName};\n18\t\n19\tuse crate::{GitCommit, GitDataSource, VcsError};\n20\t\n21\t/// Record separator placed immediately before each commit's fields in\n22\t/// `git log --format=` output, so a commit message containing `\\n` can\n23\t/// never be mistaken for a record boundary.\n24\tconst RECORD_SEP: char = '\\u{1e}';\n25\t\n26\t/// Unit separator between a commit's sha and its raw message body in\n27\t/// `git log --format=` output.\n28\tconst FIELD_SEP: char = '\\u{1f}';\n29\t\n30\t/// Redacts known registry/VCS credential env-var values and any URL\n31\t/// userinfo component from raw `git` subprocess stderr before it is\n32\t/// embedded in a [`VcsError`] -- a failing `git` invocation can surface an\n33\t/// authenticated remote URL (e.g. GitHub Actions'\n34\t/// `REDACTED`) verbatim in its own\n35\t/// error output, and that text flows into `--format json` and miette\n36\t/// diagnostic output downstream.\n37\tfn redact_git_stderr(text: &str) -> String {\n38\t    callisto_model::redact_known_secrets(\n39\t        text,\n40\t        &callisto_model::known_credential_env_values(std::env::vars()),\n41\t    )\n42\t}\n43\t\n44\t/// Shells `git` subcommands via a [`CommandRunner`] to implement\n45\t/// [`GitDataSource`]. See the module docs for the consolidation this\n46\t/// replaces.\n47\tpub struct ShellGit<'r> {\n48\t    runner: &'r dyn CommandRunner,\n49\t    root: PathBuf,\n50\t}\n51\t\n52\timpl<'r> ShellGit<'r> {\n53\t    pub fn new(runner: &'r dyn CommandRunner, root: impl Into<PathBuf>) -> Self {\n54\t        ShellGit {\n55\t            runner,\n56\t            root: root.into(),\n57\t        }\n58\t    }\n59\t}\n60\t\n61\t/// Compiles `glob` into a [`globset::GlobMatcher`], surfacing a malformed\n62\t/// pattern as [`VcsError::InvalidGlob`] rather than letting it silently\n63\t/// disable filtering (which would match every tag -- see\n64\t/// `GitRepository::list_tags`'s own doc comment for why that's a real\n65\t/// correctness risk for release tagging).\n66\tfn compile_glob(glob: &str) -> Result<globset::GlobMatcher, VcsError> {\n67\t    globset::Glob::new(glob)\n68\t        .map(|g| g.compile_matcher())\n69\t        .map_err(|e| VcsError::InvalidGlob {\n70\t            pattern: glob.to_string(),\n71\t            message: e.to_string(),\n72\t        })\n73\t}\n74\t\n75\timpl GitDataSource for ShellGit<'_> {\n76\t    fn head_sha(&self) -> Result<CommitSha, VcsError> {\n77\t        let output = self.runner.run(\"git\", &[\"rev-parse\", \"HEAD\"], &self.root)?;\n78\t        if !output.success() {\n79\t            return Err(VcsError::Git(format!(\n80\t                \"`git rev-parse HEAD` failed in `{}`: {}\",\n81\t                self.root.display(),\n82\t                redact_git_stderr(&output.stderr)\n83\t            )));\n84\t        }\n85\t        let sha_str = output.stdout_trimmed();\n86\t        CommitSha::parse(sha_str)\n87\t            .map_err(|e| VcsError::Git(format!(\"could not parse HEAD SHA `{sha_str}`: {e}\")))\n88\t    }\n89\t\n90\t    /// Always fetches the *full, unfiltered* tag list via `git tag --list`\n91\t    /// and applies `glob` (if any) locally with `globset` -- deliberately\n92\t    /// never delegates filtering to `git tag --list <pattern>`'s own\n93\t    /// (different) glob dialect. This is what guarantees byte-identical\n94\t    /// tag selection between this backend and the native `gix` path\n95\t    /// (`GitRepository::list_tags`, which also filters with `globset`)\n96\t    /// regardless of which one a caller ends up using.\n97\t    fn list_tags(&self, glob: Option<&str>) -> Result<Vec<TagName>, VcsError> {\n98\t        let output = self.runner.run(\"git\", &[\"tag\", \"--list\"], &self.root)?;\n99\t        if !output.success() {\n100\t            // A directory with no `.git` anywhere in its ancestry is not a\n101\t            // hard failure -- it's the normal shape of a brand-new/pre-git\n102\t            // package, and callers (e.g. `status`) treat \"no tags\" as\n103\t            // \"unreleased\" rather than aborting. Any OTHER failure (a\n104\t            // corrupted or locked repository, a permissions error, ...)\n105\t            // must still surface as a real error rather than silently\n106\t            // becoming \"zero tags\".\n107\t            if !output.stderr.contains(\"not a git repository\") {\n108\t                return Err(VcsError::Git(format!(\n109\t                    \"`git tag --list` failed in `{}`: {}\",\n110\t                    self.root.display(),\n111\t                    redact_git_stderr(&output.stderr)\n112\t                )));\n113\t            }\n114\t        }\n115\t        let all = output.stdout_lines().map(|s| s.to_string());\n116\t\n117\t        let matcher = glob.map(compile_glob).transpose()?;\n118\t\n119\t        Ok(all\n120\t            .filter(|t| matcher.as_ref().is_none_or(|m| m.is_match(t)))\n121\t            .map(TagName)\n122\t            .collect())\n123\t    }\n124\t\n125\t    fn resolve_commit(&self, refname: &str) -> Result<Option<CommitSha>, VcsError> {\n126\t        let rev = format!(\"{refname}^{{commit}}\");\n127\t        let output = self.runner.run(\n128\t            \"git\",\n129\t            &[\"rev-parse\", \"--verify\", \"--quiet\", &rev],\n130\t            &self.root,\n131\t        )?;\n132\t\n133\t        if !output.success() {\n134\t            return Ok(None);\n135\t        }\n136\t        let sha_str = output.stdout_trimmed();\n137\t        if sha_str.is_empty() {\n138\t            return Ok(None);\n139\t        }\n140\t        Ok(CommitSha::parse(sha_str).ok())\n141\t    }\n142\t\n143\t    /// Shells `git log --no-merges --format=<RECORD_SEP>%H<FIELD_SEP>%B\n144\t    /// <range> [-- <pathspecs>]`, matching the native path's shape\n145\t    /// field-for-field: `--no-merges` excludes merge commits exactly like\n146\t    /// `GitRepository::commits_since_with_pathspec`'s parent-count skip;\n147\t    /// `<since>..HEAD` (or bare `HEAD` for no bound) gives the same\n148\t    /// exclusive-lower-bound revision range as the revwalk's stop-at-\n149\t    /// `since` logic; and the trailing `-- <pathspecs>` reproduces `git\n150\t    /// log`'s own pathspec-prefix filtering.\n151\t    ///\n152\t    /// Deliberately does *not* pre-resolve `since_ref` via a separate\n153\t    /// `rev-parse` round-trip: an unresolvable `since_ref` already makes\n154\t    /// `git log <since_ref>..HEAD` itself fail (non-zero exit), which is\n155\t    /// surfaced below as `Err` exactly like any other `git log` failure --\n156\t    /// one shell call either way.\n157\t    fn commits_since(\n158\t        &self,\n159\t        since_ref: Option<&str>,\n160\t        pathspecs: &[PathBuf],\n161\t    ) -> Result<Vec<GitCommit>, VcsError> {\n162\t        let mut args: Vec<String> = vec![\n163\t            \"log\".to_string(),\n164\t            \"--no-merges\".to_string(),\n165\t            format!(\"--format={RECORD_SEP}%H{FIELD_SEP}%B\"),\n166\t        ];\n167\t\n168\t        match since_ref {\n169\t            Some(r) => args.push(format!(\"{r}..HEAD\")),\n170\t            None => args.push(\"HEAD\".to_string()),\n171\t        }\n172\t\n173\t        if !pathspecs.is_empty() {\n174\t            args.push(\"--\".to_string());\n175\t            args.extend(pathspecs.iter().map(|p| p.display().to_string()));\n176\t        }\n177\t\n178\t        let arg_refs: Vec<&str> = args.iter().map(String::as_str).collect();\n179\t        let output = self.runner.run(\"git\", &arg_refs, &self.root)?;\n180\t\n181\t        if !output.success() {\n182\t            return Err(VcsError::Git(format!(\n\n... [507 lines truncated] ..."},"type":"attachment","uuid":"c20e825a-28e7-4405-857e-73144e4d4e9f","timestamp":"2026-08-23T03:29:44.865Z","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"fix-publish-order-dev-deps","slug":"shimmying-giggling-hickey"}
