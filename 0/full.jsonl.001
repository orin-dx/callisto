gemini/settings.json\n\nRecent commits:\n80249fa6b docs: document native resolution, release recovery and v1 plan status\n660bae688 fix(cli): release runner recovery, native auth and JSON schema tests\n8b1b3f00d fix: resolve native versions, dependency names and ranges across ecosystems\nabc05299d docs(architecture): record proposed polyglot v1 model\nee230a89d fix(release): reject unchanged release PR heads\n\nClaude Code attached this context automatically; it isn't part of the user's message. It describes the user's own account and workspace, so they don't need it reported back.\n</system-reminder>"}],"renderedRole":"user","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"stack/docs-v1","slug":"lexical-jingling-puppy"}
