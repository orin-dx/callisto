ish_callisto_needs_command\n         callisto-cli:test |     # Figure out if the current invocation already has a command.\n         callisto-cli:test |     set -l cmd (commandline -opc)\n         callisto-cli:test |     set -e cmd[1]\n         callisto-cli:test |     argparse -s (__fish_callisto_global_optspecs) -- $cmd 2>/dev/null\n         callisto-cli:test |     or return\n         callisto-cli:test |     if set -q argv[1]\n         callisto-cli:test |         # Also print the command, so this can be used to figure out what it is.\n         callisto-cli:test |         echo $argv[1]\n         callisto-cli:test |         return 1\n         callisto-cli:test |     end\n         callisto-cli:test |     return 0\n         callisto-cli:test | end\n         callisto-cli:test | \n         callisto-cli:test | function __fish_callisto_using_subcommand\n         callisto-cli:test |     set -l cmd (__fish_callisto_needs_command)\n         callisto-cli:test |     test -z \"$cmd\"\n         callisto-cli:test |     and return 1\n         callisto-cli:test |     contains -- $cmd[1] $argv\n         callisto-cli:test | end\n         callisto-cli:test | \n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -l format -d 'Output format for command results' -r -f -a \"text\\t''\n         callisto-cli:test | json\\t''\"\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -l cwd -d 'Workspace directory to operate in (defaults to the current directory)' -r -F\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -l dry-run -d 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -s h -l help -d 'Print help'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -s V -l version -d 'Print version'\n         callisto-cli:test | complete -c callisto -n \"__fish_c