{"parentUuid":"3e65883f-12be-4b77-903a-98c9003d70be","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/commands/pr_body.rs","snippet":"1\tuse callisto_model::{CommandRunner, ComposePrBodyReport, SCHEMA_VERSION};\n2\t\n3\tuse crate::commands::version::plan_version;\n4\tuse crate::error::GraphError;\n5\tuse crate::infer::SeverityInference;\n6\tuse crate::resolver::DependencyResolver;\n7\tuse crate::Workspace;\n8\t\n9\t#[derive(Clone, Debug, Default)]\n10\tpub struct PrBodyOptions {\n11\t    pub existing_body: Option<String>,\n12\t    pub labels: Vec<String>,\n13\t    pub branch: Option<String>,\n14\t}\n15\t\n16\tpub fn compose_pr_body<R: CommandRunner, D: DependencyResolver, I: SeverityInference>(\n17\t    ws: &Workspace<'_, R, D>,\n18\t    inference: &I,\n19\t    opts: &PrBodyOptions,\n20\t) -> Result<ComposePrBodyReport, GraphError> {\n21\t    let plan = plan_version(\n22\t        ws,\n23\t        inference,\n24\t        &crate::commands::version::VersionOptions::default(),\n25\t    )?;\n26\t    render_pr_body_from_plan(&plan, opts)\n27\t}\n28\t\n29\tpub fn render_pr_body_from_plan(\n30\t    plan: &crate::plan::VersionPlan,\n31\t    opts: &PrBodyOptions,\n32\t) -> Result<ComposePrBodyReport, GraphError> {\n33\t    let mut body = String::new();\n34\t\n35\t    // Preserve custom user notes above ## Release Preview if an existing body was passed\n36\t    if let Some(ref existing) = opts.existing_body {\n37\t        if let Some((prefix, _)) = existing.split_once(\"## Release Preview\") {\n38\t            if !prefix.trim().is_empty() {\n39\t                body.push_str(prefix);\n40\t                if !prefix.ends_with('\\n') {\n41\t                    body.push('\\n');\n42\t                }\n43\t            }\n44\t        }\n45\t    }\n46\t\n47\t    body.push_str(\"## Release Preview\\n\\n\");\n48\t    body.push_str(\"This automated PR was generated by [Callisto](https://github.com/orin-dx/callisto). Merging this PR will publish the updated packages to their release targets.\\n\\n\");\n49\t\n50\t    if !opts.labels.is_empty() {\n51\t        body.push_str(&format!(\n52\t            \"**Suggested PR Labels**: `{}`\\n\\n\",\n53\t            opts.labels.join(\"`, `\")\n54\t        ));\n55\t    }\n56\t\n57\t    if plan.bumps.is_empty() {\n58\t        body.push_str(\"> [!NOTE]\\n\");\n59\t        body.push_str(\n60\t            \"> **No pending changesets found.** Workspace packages are currently up to date.\\n\\n\",\n61\t        );\n62\t        let branch = opts\n63\t            .branch\n64\t            .as_deref()\n65\t            .unwrap_or(\"callisto/version-packages\");\n66\t        body.push_str(\"<details>\\n<summary><b>Release Workflow Instructions</b></summary>\\n\\n\");\n67\t        body.push_str(\"- **Merging this PR**: Merging into `main` will automatically publish all updated packages to their release registries.\\n\");\n68\t        body.push_str(\"- **Adding more changesets**: If additional changesets are pushed to `main`, Callisto will automatically re-calculate and update this PR.\\n\");\n69\t        body.push_str(&format!(\n70\t            \"- **Manual edits**: You can make manual adjustments directly on the `{}` branch if needed.\\n\\n\",\n71\t            branch\n72\t        ));\n73\t        body.push_str(\"</details>\\n\");\n74\t        return Ok(ComposePrBodyReport {\n75\t            schema_version: SCHEMA_VERSION,\n76\t            body,\n77\t            diagnostics: Vec::new(),\n78\t        });\n79\t    }\n80\t\n81\t    // 1. Executive Summary Table\n82\t    body.push_str(\"### 📊 Release Summary\\n\\n\");\n83\t    body.push_str(\"| Package | Ecosystem | Current | Target | Bump | Reason |\\n\");\n84\t    body.push_str(\"| :--- | :--- | :--- | :--- | :--- | :--- |\\n\");\n85\t\n86\t    let mut has_major = false;\n87\t\n88\t    for bump in &plan.bumps {\n89\t        if bump.severity == callisto_model::Severity::Major {\n90\t            has_major = true;\n91\t        }\n92\t\n93\t        let eco = bump\n94\t            .package\n95\t            .ecosystem()\n96\t            .map(|e| e.prefix())\n97\t            .unwrap_or(\"core\");\n98\t\n99\t        let reason_str = match &bump.reason {\n100\t            Some(callisto_model::BumpReason::Changeset { changesets }) => {\n101\t                format!(\"Changeset (`{}`)\", changesets.join(\"`, `\"))\n102\t            }\n103\t            Some(callisto_model::BumpReason::Cascade { via, .. }) => {\n104\t                format!(\"Cascade from `{}`\", via.display_name())\n105\t            }\n106\t            Some(callisto_model::BumpReason::PeerEscalation { via, .. }) => {\n107\t                format!(\"Peer escalation from `{}`\", via.display_name())\n108\t            }\n109\t            Some(callisto_model::BumpReason::FixedGroupUnion { group }) => {\n110\t                format!(\"Fixed group `{}`\", group.as_str())\n111\t            }\n112\t            Some(callisto_model::BumpReason::LinkedGroupUnion { group }) => {\n113\t                format!(\"Linked group `{}`\", group.as_str())\n114\t            }\n115\t            Some(callisto_model::BumpReason::Inference { commits, .. }) => {\n116\t                format!(\"Inferred ({commits} commits)\")\n117\t            }\n118\t            Some(callisto_model::BumpReason::PreRelease { tag }) => {\n119\t                format!(\"Prerelease (`{tag}`)\")\n120\t            }\n121\t            Some(callisto_model::BumpReason::NewGroupMember { group }) => {\n122\t                format!(\"New member (`{}`)\", group.as_str())\n123\t            }\n124\t            _ => \"Package bump\".to_string(),\n125\t        };\n126\t\n127\t        body.push_str(&format!(\n128\t            \"| `{}` | `{}` | `{}` | **`{}`** | `{}` | {} |\\n\",\n129\t            bump.package.display_name(),\n130\t            eco,\n131\t            bump.from.render(),\n132\t            bump.to.render(),\n133\t            bump.severity,\n134\t            reason_str\n135\t        ));\n136\t    }\n137\t\n138\t    body.push('\\n');\n139\t\n140\t    // 2. Alert Callouts\n141\t    if has_major {\n142\t        body.push_str(\"> [!IMPORTANT]\\n\");\n143\t        body.push_str(\"> **Major Version Bumps Detected**: This release contains major breaking changes. Review full changelogs below before merging.\\n\\n\");\n144\t    } else {\n145\t        body.push_str(\"> [!NOTE]\\n\");\n146\t        body.push_str(&format!(\n147\t            \"> **{} package(s)** queued for versioning. All changes are backward compatible.\\n\\n\",\n148\t            plan.bumps.len()\n149\t        ));\n150\t    }\n151\t\n152\t    // 3. Collapsible Package Details\n153\t    body.push_str(\"### 📦 Package Release Details\\n\\n\");\n154\t\n155\t    for bump in &plan.bumps {\n156\t        let is_open = bump.severity == callisto_model::Severity::Major\n157\t            || bump.severity == callisto_model::Severity::Minor;\n158\t        let open_attr = if is_open { \" open\" } else { \"\" };\n159\t\n160\t        body.push_str(&format!(\n161\t            \"<details{}>\\n<summary><b>{}</b> <code>{}</code> → <code>{}</code> ({})</summary>\\n\\n\",\n162\t            open_attr,\n163\t            bump.package.display_name(),\n164\t            bump.from.render(),\n165\t            bump.to.render(),\n166\t            bump.severity\n167\t        ));\n168\t\n169\t        body.push_str(&format!(\n170\t            \"#### Version Change\\n`{}` ➔ `{}`\\n\\n\",\n171\t            bump.from.render(),\n172\t            bump.to.render()\n173\t        ));\n174\t\n175\t        let matching_write = plan\n176\t            .changelog_writes\n177\t            .iter()\n178\t            .find(|w| w.input.package == bump.package);\n179\t\n180\t        let mut rendered = false;\n181\t        if let Some(w) = matching_write {\n182\t            if let Ok(section) = callisto_changelog::render_section(&w.input) {\n183\t                body.push_str(\"#### Release Reason\\n\");\n184\t                body.push_str(&section);\n185\t                body.push('\\n');\n186\t                rendered = true;\n187\t            }\n188\t        }\n189\t\n190\t        if !rendered {\n191\t            if let Some(ref reason) = bump.reason {\n192\t                body.push_str(\"#### Release Reason\\n\");\n193\t                match reason {\n194\t                    callisto_model::BumpReason::Changeset { changesets } => {\n195\t                        body.push_str(&format!(\n196\t                            \"- Associated changesets: `{}`\\n\\n\",\n197\t                            changesets.join(\"`, `\")\n198\t                        ));\n199\t                    }\n200\t                    callisto_model::BumpReason::Cascade {\n201\t                        via,\n202\t                        spec,\n203\t                        dependency_to,\n204\t                        ..\n205\t                    } => {\n\n... [275 lines truncated] ..."},"type":"attachment","uuid":"466126b2-0fde-45d8-9ae4-d63a25049ea8","timestamp":"2026-08-20T23:58:40.049Z","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"main","slug":"shimmying-giggling-hickey"}
