{"parentUuid":"9ad67d0d-0c16-43eb-b853-f27edef11ea0","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011CguoyXcCvB6XNWHMVe1P9","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"The exit-code reclassification holds: every code moved to exit 2 is a bad flag value or combination, while E232, E233 and E281 stay at exit 1 because they concern intent-file or workspace content. I'm running the full checks, then the changeset.\n\n","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1191,"cache_read_input_tokens":766439,"output_tokens":1048,"output_tokens_details":{"thinking_tokens":459},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1191,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1048,"cache_read_input_tokens":766439,"cache_creation_input_tokens":1191,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1191},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":2,"thinkingDisplay":"updates","serverClassifierRequest":"90163401-e03e-4abc-bb80-731f91278aa6","apiBlockIndex":1,"requestId":"req_011CguoyXFdLbQAezLJK79kE","requestRef":"e6c9577a-74a7-416e-926d-497369342cbb","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"09cfbdfb-1e46-4436-9bc7-ee1f3fb32035","timestamp":"2026-11-10T19:36:53.042Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a24178b2c45873db7","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/usage-exit-code","slug":"mossy-snacking-stream"}
{"parentUuid":"09cfbdfb-1e46-4436-9bc7-ee1f3fb32035","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011CguoyXcCvB6XNWHMVe1P9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ABoRccAT78UudhnZfHSS2Z","name":"Write","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a24178b2c45873db7/.changeset/usage-errors-exit-2.md","content":"---\ncallisto-cli: minor\n---\n\nUsage errors now exit 2, as the stability promise says, so a script can tell a mistake in the command from a failure in the workspace.\n\n- A bad or missing flag value that Callisto checks after parsing now exits 2, like a clap-level mistake always did. Examples: `add --package a:patch`, `add --package cargo/a:bogus`, `add` without `--summary`, `init` without `--yes` and without a terminal, `snapshot --tag` with a space, and `--dry-run` on commands that need an output file.\n- Failures about your workspace, config, git or registries still exit 1.\n- The JSON error envelope is unchanged.\n\nAction: a script that checks for exit code 1 after a bad argument must also accept 2. Checking for any non-zero code is unaffected.\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1191,"cache_read_input_tokens":766439,"output_tokens":1048,"output_tokens_details":{"thinking_tokens":459},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1191,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1048,"cache_read_input_tokens":766439,"cache_creation_input_tokens":1191,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1191},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01ABoRccAT78UudhnZfHSS2Z":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a24178b2c45873db7/.changeset/usage-errors-exit-2.md","content":"---\ncallisto-cli: minor\n---\n\nUsage errors now exit 2, as the stability promise says, so a script can tell a mistake in the command from a failure in the workspace.\n\n- A bad or missing flag value that Callisto checks after parsing now exits 2, like a clap-level mistake always did. Examples: `add --package a:patch`, `add --package cargo/a:bogus`, `add` without `--summary`, `init` without `--yes` and without a terminal, `snapshot --tag` with a space, and `--dry-run` on commands that need an output file.\n- Failures about your workspace, config, git or registries still exit 1.\n- The JSON error envelope is unchanged.\n\nAction: a script that checks for exit code 1 after a bad argument must also accept 2. Checking for any non-zero code is unaffected.\n"}},"serverClassifierRequest":"90163401-e03e-4abc-bb80-731f91278aa6","apiBlockIndex":2,"requestId":"req_011CguoyXFdLbQAezLJK79kE","requestRef":"e6c9577a-74a7-416e-926d-497369342cbb","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"4eadb93c-3322-4cbc-871a-4ee726dbb1ff","timestamp":"2026-11-10T19:36:53.462Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a24178b2c45873db7","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/usage-exit-code","slug":"mossy-snacking-stream"}
