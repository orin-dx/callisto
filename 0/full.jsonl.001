alEnvPolicy::NpmToken { env_name },\n634:                PreparedCredentialEnvPolicy::PypiToken {\n1277:        Ecosystem::Npm => Ok(PreparedCredentialEnvPolicy::NpmToken { env_name: \"NPM_TOKEN\" }),\n1278:        Ecosystem::Pypi => Ok(PreparedCredentialEnvPolicy::PypiToken {\n1279:            password_env_name: \"TWINE_PASSWORD\",\n2169:            PreparedCredentialEnvPolicy::NpmToken { env_name: \"NPM_TOKEN\" }\n2173:            PreparedCredentialEnvPolicy::PypiToken {\n2174:                password_env_name: \"TWINE_PASSWORD\",\n                            \"b\".repeat(40)\n                        ),\n                        \"\",\n                    ),\n                },\n                (\"git\", Some(\"fetch\")) => output(0, \"\", \"\"),\n                (\"git\", Some(\"push\")) => {\n                    if let Some(promoted) = self.promote_remote_on_push.lock().unwrap().take() {\n                        *self.remote_tag.lock().unwrap() = promoted;\n                    }\n                    output(0, \"\", \"\")\n                }\n                (\"git\", Some(\"--no-replace-objects\")) => match self.remote_tag.lock().unwrap().clone() {\n                    RemoteTagPlan::Exact {\n                        name,\n                        target,\n                        annotation,\n                    } => output(\n                        0,\n                        &format!(\n                            \"object {target}\\ntype commit\\ntag {name}\\ntagger Test <test@example.com> 0 +0000\\n\\n{annotation}\\n\"\n                        ),\n                        \"\",\n                    ),\n                    RemoteTagPlan::Absent => panic!(\"cat-file is unreachable for an absent tag\"),\n                },\n                _ => Self::command_output(program, args, cwd),\n            }\n        }\n\n        fn run_with_stdin(\n            &self,\n            program: &str,\n            args: &[&str],\n            cwd: &Path,\n            stdin: &[u8],