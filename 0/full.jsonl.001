|             [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;filter-plan' {\n         callisto-cli:test |             [CompletionResult]::new('--plan', '--plan', [CompletionResultType]::ParameterName, 'Path to a publish plan JSON file, inline JSON, or `-` to read it from stdin')\n         callisto-cli:test |             [CompletionResult]::new('--report', '--report', [CompletionResultType]::ParameterName, 'Path to a publish report JSON file, inline JSON, or `-` to read it from stdin')\n         callisto-cli:test |             [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format for command results')\n         callisto-cli:test |             [CompletionResult]::new('--cwd', '--cwd', [CompletionResultType]::ParameterName, 'Workspace directory to operate in (defaults to the current directory)')\n         callisto-cli:test |             [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Preview manifest and file changes without writing to disk')\n         callisto-cli:test |             [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;release' {\n         callisto-cli:test |             [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format for command results')\n         callisto-cli:test |             [CompletionResult]::new('--cwd', '--cwd', [CompletionResultType]::ParameterName, 'Workspace directory to operate in (defaults to the current directory)')\n         callisto-cli:test |             [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Preview manifest and file changes without writing to disk')\n         callisto-cli:test |             [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             [CompletionResult]::new('plan', 'plan', [CompletionResultType]::ParameterValue, 'Create a read-only durable release intent from exact package selections')\n         callisto-cli:test |             [CompletionResult]::new('inspect', 'inspect', [CompletionResultType]::ParameterValue, 'Display a durable intent, manifest, state, or receipt without recomputing it')\n         callisto-cli:test |             [CompletionResult]::new('reconcile', 'reconcile', [CompletionResultType]::ParameterValue, 'Report which pending operations are eligible without changing release state')\n         callisto-cli:test |             [CompletionResult]::new('execute', 'execute', [CompletionResultType]::ParameterValue, 'Execute a previously approved intent. This is the only durable mutation route')\n         callisto-cli:test |             [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;release;plan' {\n         callisto-cli:test |             [CompletionResult]::new('--package', '--package', [CompletionResultType]::ParameterName, 'Exact qualified package identity, for example `cargo/callisto-cli`. Repeat this flag to select multiple pa