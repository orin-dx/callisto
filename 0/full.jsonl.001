@]}\" : \\\n&& ret=0\n;;\n(exit)\n_arguments \"${_arguments_options[@]}\" : \\\n&& ret=0\n;;\n(help)\n_arguments \"${_arguments_options[@]}\" : \\\n&& ret=0\n;;\n        esac\n    ;;\nesac\n;;\n        esac\n    ;;\nesac\n;;\n(validate)\n_arguments \"${_arguments_options[@]}\" : \\\n'(--staged)--since=[Validate only changesets added since the given git ref]:REF:_default' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--staged[Validate only changesets staged in git]' \\\n'--strict[Treat warning-level diagnostics as errors]' \\\n'--strict-graph[Treat dependency-graph warnings as errors]' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(snapshot)\n_arguments \"${_arguments_options[@]}\" : \\\n'--tag=[Tag to append to the snapshot version (e.g. a commit SHA or branch name)]:TAG:_default' \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--strict[Abort if the workspace graph contains crosscheck failures or other error-severity diagnostics]' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(init)\n_arguments \"${_arguments_options[@]}\" : \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--yes[Skip the interactive confirmation prompt]' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(plan-publish)\n_arguments \"${_arguments_options[@]}\" : \\\n'*--package=[Plan only the named package(s). Repeatable\\: \\`--package foo --package bar\\`]:NAME:_default