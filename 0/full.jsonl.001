{"parentUuid":"0fb752b7-9ab3-41cd-b51e-67e4ea74614b","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:ToolSearch","toolUseID":"toolu_01DqpEdzB9DsrW5muesNjfxp","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"6cc3e47b-8406-4c17-94fb-22313682fad8\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/callisto/.claude/worktrees/agent-ae5865da7dc4349e3\\\",\\\"project\\\":\\\"agent-ae5865da7dc4349e3\\\",\\\"tool_name\\\":\\\"ToolSearch\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":67},"type":"attachment","uuid":"8a99a18b-f1b7-4fe2-8b9c-cb9f8cf93432","timestamp":"2026-11-10T18:58:59.088Z","session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-ae5865da7dc4349e3","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/note-once","slug":"mossy-snacking-stream"}
