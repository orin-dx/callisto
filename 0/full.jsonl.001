atches!(error, GraphError::UnrewritableRange { .. }), \"{error:?}\");\n''')\ndev = variant(\n    'an_unrewritable_dev_range_warns_once',\n    'A dev dependency is never installed by consumers, so an unrewritable range only warns, once, though both passes visit it.',\n    'Dev',\n    '''    let outcome = run_cascade(input).expect(\"cascade must converge\");\n    let warnings: Vec<&Diagnostic> = outcome\n        .diagnostics\n        .iter()\n        .filter(|d| d.code == DiagnosticCode::RangeNotRoundTrippable)\n        .collect();\n    assert_eq!(\n        warnings.len(),\n        1,\n        \"the same unrewritable edge must warn once even though both the convergence \\\\\n             loop and the floor-raise pass visit it: {warnings:?}\"\n    );\n''')\ns = s[:start] + runtime + '\\n' + dev + s[end:]\nopen(p, 'w').write(s)\nprint('ok')\n"}},"serverClassifierRequest":"4e87e758-69a0-4e26-b9d3-8a90d063e660","apiBlockIndex":1,"requestId":"req_011CgFwczAapuXUEduyK7wqU","requestRef":"b6e262fb-ef16-48b7-b142-06a3b3fde77d","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"c26ac416-c237-4021-8a06-808c7dbb1e77","timestamp":"2026-10-21T19:34:36.477Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/range-hard-stop","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"worktree-range-hard-stop","slug":"lexical-jingling-puppy"}
