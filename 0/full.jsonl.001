allisto_needs_command\" -l format -d 'Output format for command results' -r -f -a \"text\\t''\n         callisto-cli:test | json\\t''\"\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -l cwd -d 'Workspace directory to operate in (defaults to the current directory)' -r -F\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -l dry-run -d 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -s h -l help -d 'Print help'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -s V -l version -d 'Print version'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"add\" -d 'Create a new changeset describing pending package changes'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"status\" -d 'Show the workspace\\'s pending changesets and diagnostics'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"matrix\" -d 'Print the workspace\\'s native-build target matrix as JSON or a table'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"version\" -d 'Consume pending changesets and bump package versions accordingly'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"pre\" -d 'Manage prerelease mode for the workspace'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"validate\" -d 'Check that changesets and the dependency graph are well-formed'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"snapshot\" -d 'Apply a temporary, non-persistent version bump for a snapshot release'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -f -