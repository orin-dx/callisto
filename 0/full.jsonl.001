tionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help' {\n         callisto-cli:test |             [CompletionResult]::new('add', 'add', [CompletionResultType]::ParameterValue, 'Create a new changeset describing pending package changes')\n         callisto-cli:test |             [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'Show the workspace''s pending changesets and diagnostics')\n         callisto-cli:test |             [CompletionResult]::new('matrix', 'matrix', [CompletionResultType]::ParameterValue, 'Print the workspace''s native-build target matrix as JSON or a table')\n         callisto-cli:test |             [CompletionResult]::new('version', 'version', [CompletionResultType]::ParameterValue, 'Consume pending changesets and bump package versions accordingly')\n         callisto-cli:test |             [CompletionResult]::new('pre', 'pre', [CompletionResultType]::ParameterValue, 'Manage prerelease mode for the workspace')\n         callisto-cli:test |             [CompletionResult]::new('validate', 'validate', [CompletionResultType]::ParameterValue, 'Check that changesets and the dependency graph are well-formed')\n         callisto-cli:test |             [CompletionResult]::new('snapshot', 'snapshot', [CompletionResultType]::ParameterValue, 'Apply a temporary, non-persistent version bump for a snapshot release')\n         callisto-cli:test |             [CompletionResult]::new('init', 'init', [CompletionResultType]::ParameterValue, 'Scaffold Callisto configuration in the current workspace')\n         callisto-cli:test |             [CompletionResult]::new('plan-publish', 'plan-publish', [CompletionResultType]::ParameterValue, 'Compute which packages are ready to publish and print the publish plan')\n         callisto-cli:test |             [CompletionResult]::new('publish', 'publish', [CompletionResultType]::ParameterValue, 'Publish ready packages to their ecosystem registries via native CLI tools')\n         callisto-cli:test |             [CompletionResult]::new('compose-pr-body', 'compose-pr-body', [CompletionResultType]::ParameterValue, 'Generate a pull request body summarizing pending release changes')\n         callisto-cli:test |             [CompletionResult]::new('tag', 'tag', [CompletionResultType]::ParameterValue, 'Create git tags for packages in a publish plan')\n         callisto-cli:test |             [CompletionResult]::new('filter-plan', 'filter-plan', [CompletionResultType]::ParameterValue, 'Filter a publish plan down to what a publish report confirms actually succeeded, dropping anything that failed')\n         callisto-cli:test |             [CompletionResult]::new('release', 'release', [CompletionResultType]::ParameterValue, 'Create, inspect, reconcile, or execute durable release intents')\n         callisto-cli:test |             [CompletionResult]::new('completions', 'completions', [CompletionResultType]::ParameterValue, 'Generate shell completion scripts')\n         callisto-cli:test |             [CompletionResult]::new('schema', 'schema', [CompletionResultType]::ParameterValue, 'Print the JSON schema for a report type')\n         callisto-cli:test |             [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;add' {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;status' {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;matrix' {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;version' {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;pre' {\n         callisto-cli:test |             [CompletionResult]::new('enter', 'enter', [CompletionResultType]::ParameterValue, 'Enter prerelease mode, tagging subsequent version bumps with the given prerelease tag')\n         callisto-cli:test |             [CompletionResult]::new('exit', 'exit', [CompletionResultType]::ParameterValue, 'Exit prerelease mode, returning to normal versioning')\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;pre;enter' {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;pre;exit' {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;validate' {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;snapshot' {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;init' {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;plan-publish' {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;publish' {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help;compose-pr-body' {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |   