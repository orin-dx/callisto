{"parentUuid":"2d50d42d-ae36-4c9a-9e69-864bd8319476","isSidechain":false,"promptId":"b2617fe0-b82c-435a-b64a-ff0f8ae28445","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EXvXymV2vfv5bh5r5bNXhp","type":"tool_result","content":"1\tuse std::collections::{BTreeMap, BTreeSet, HashSet};\n2\t\n3\tuse callisto_model::{DepKind, PackageId};\n4\t\n5\tuse crate::error::GraphError;\n6\t\n7\t/// Topologically sorts `subset` by the edges `outgoing_edges` reports, counting only edges\n8\t/// whose [`DepKind`] appears in `ordering_kinds` as ordering constraints. Different callers\n9\t/// need different kinds to count: cascade/version-bump propagation only cares about\n10\t/// `Runtime`/`Build`/`Optional` (a `Dev`-only change correctly shouldn't force a consumer's\n11\t/// version to bump), while publish ordering (`commands::publish::publish_order`) also needs\n12\t/// `Dev`, since `cargo publish`'s own local verification build needs every declared\n13\t/// dependency — dev included — resolvable. This function has no opinion on which kinds\n14\t/// matter; the caller states it explicitly via `ordering_kinds`.\n15\tpub fn toposort_impl<F>(\n16\t    subset: &HashSet<PackageId>,\n17\t    all_packages: &[PackageId],\n18\t    ordering_kinds: &[DepKind],\n19\t    outgoing_edges: F,\n20\t) -> Result<Vec<PackageId>, GraphError>\n21\twhere\n22\t    F: Fn(&PackageId) -> Vec<(PackageId, DepKind)>,\n23\t{\n24\t    let members: BTreeSet<PackageId> = subset.iter().cloned().collect();\n25\t    // Build a HashSet once so validation is O(N) rather than O(N²) slice scans.\n26\t    let all_set: std::collections::HashSet<&PackageId> = all_packages.iter().collect();\n27\t    for id in &members {\n28\t        if !all_set.contains(id) {\n29\t            return Err(GraphError::UnknownPackage { id: id.clone() });\n30\t        }\n31\t    }\n32\t\n33\t    let mut in_degree: BTreeMap<PackageId, usize> = BTreeMap::new();\n34\t    let mut adj: BTreeMap<PackageId, Vec<PackageId>> = BTreeMap::new();\n35\t\n36\t    for u in &members {\n37\t        in_degree.insert(u.clone(), 0);\n38\t        adj.insert(u.clone(), Vec::new());\n39\t    }\n40\t\n41\t    for u in &members {\n42\t        for (v, kind) in outgoing_edges(u) {\n43\t<<<<<<< HEAD\n44\t            if members.contains(&v) && matches!(kind, DepKind::Runtime | DepKind::Build | DepKind::Optional) {\n45\t=======\n46\t            if members.contains(&v) && ordering_kinds.contains(&kind) {\n47\t>>>>>>> 3b493440 (refactor(graph): extract publish_order from the generic toposort trait)\n48\t                adj.get_mut(&v).unwrap().push(u.clone());\n49\t                *in_degree.get_mut(u).unwrap() += 1;\n50\t            }\n51\t        }\n52\t    }\n53\t\n54\t    let mut queue: BTreeSet<PackageId> = BTreeSet::new();\n55\t    for (u, &deg) in &in_degree {\n56\t        if deg == 0 {\n57\t            queue.insert(u.clone());\n58\t        }\n59\t    }\n60\t\n61\t    let mut sorted = Vec::new();\n62\t    while let Some(u) = queue.pop_first() {\n63\t        sorted.push(u.clone());\n64\t        if let Some(neighbors) = adj.get(&u) {\n65\t            for v in neighbors {\n66\t                let deg = in_degree.get_mut(v).unwrap();\n67\t                *deg -= 1;\n68\t                if *deg == 0 {\n69\t                    queue.insert(v.clone());\n70\t                }\n71\t            }\n72\t        }\n73\t    }\n74\t\n75\t    if sorted.len() < members.len() {\n76\t        let set: HashSet<PackageId> = sorted.iter().cloned().collect();\n77\t        let remaining: Vec<PackageId> = members.into_iter().filter(|m| !set.contains(m)).collect();\n78\t        let cycle = extract_cycle(&remaining, &adj);\n79\t        return Err(GraphError::Cycle { cycle });\n80\t    }\n81\t\n82\t    Ok(sorted)\n83\t}\n84\t\n85\tfn extract_cycle(remaining: &[PackageId], adj: &BTreeMap<PackageId, Vec<PackageId>>) -> Vec<PackageId> {\n86\t    use petgraph::algo::tarjan_scc;\n87\t    use petgraph::graph::DiGraph;\n88\t\n89\t    let mut graph = DiGraph::<PackageId, ()>::new();\n90\t    let mut node_map = BTreeMap::new();"}]},"uuid":"1d761875-8cb0-4817-87d1-6b7ddfdfed7b","timestamp":"2026-08-23T20:07:30.443Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/toposort.rs","content":"use std::collections::{BTreeMap, BTreeSet, HashSet};\n\nuse callisto_model::{DepKind, PackageId};\n\nuse crate::error::GraphError;\n\n/// Topologically sorts `subset` by the edges `outgoing_edges` reports, counting only edges\n/// whose [`DepKind`] appears in `ordering_kinds` as ordering constraints. Different callers\n/// need different kinds to count: cascade/version-bump propagation only cares about\n/// `Runtime`/`Build`/`Optional` (a `Dev`-only change correctly shouldn't force a consumer's\n/// version to bump), while publish ordering (`commands::publish::publish_order`) also needs\n/// `Dev`, since `cargo publish`'s own local verification build needs every declared\n/// dependency — dev included — resolvable. This function has no opinion on which kinds\n/// matter; the caller states it explicitly via `ordering_kinds`.\npub fn toposort_impl<F>(\n    subset: &HashSet<PackageId>,\n    all_packages: &[PackageId],\n    ordering_kinds: &[DepKind],\n    outgoing_edges: F,\n) -> Result<Vec<PackageId>, GraphError>\nwhere\n    F: Fn(&PackageId) -> Vec<(PackageId, DepKind)>,\n{\n    let members: BTreeSet<PackageId> = subset.iter().cloned().collect();\n    // Build a HashSet once so validation is O(N) rather than O(N²) slice scans.\n    let all_set: std::collections::HashSet<&PackageId> = all_packages.iter().collect();\n    for id in &members {\n        if !all_set.contains(id) {\n            return Err(GraphError::UnknownPackage { id: id.clone() });\n        }\n    }\n\n    let mut in_degree: BTreeMap<PackageId, usize> = BTreeMap::new();\n    let mut adj: BTreeMap<PackageId, Vec<PackageId>> = BTreeMap::new();\n\n    for u in &members {\n        in_degree.insert(u.clone(), 0);\n        adj.insert(u.clone(), Vec::new());\n    }\n\n    for u in &members {\n        for (v, kind) in outgoing_edges(u) {\n<<<<<<< HEAD\n            if members.contains(&v) && matches!(kind, DepKind::Runtime | DepKind::Build | DepKind::Optional) {\n=======\n            if members.contains(&v) && ordering_kinds.contains(&kind) {\n>>>>>>> 3b493440 (refactor(graph): extract publish_order from the generic toposort trait)\n                adj.get_mut(&v).unwrap().push(u.clone());\n                *in_degree.get_mut(u).unwrap() += 1;\n            }\n        }\n    }\n\n    let mut queue: BTreeSet<PackageId> = BTreeSet::new();\n    for (u, &deg) in &in_degree {\n        if deg == 0 {\n            queue.insert(u.clone());\n        }\n    }\n\n    let mut sorted = Vec::new();\n    while let Some(u) = queue.pop_first() {\n        sorted.push(u.clone());\n        if let Some(neighbors) = adj.get(&u) {\n            for v in neighbors {\n                let deg = in_degree.get_mut(v).unwrap();\n                *deg -= 1;\n                if *deg == 0 {\n                    queue.insert(v.clone());\n                }\n            }\n        }\n    }\n\n    if sorted.len() < members.len() {\n        let set: HashSet<PackageId> = sorted.iter().cloned().collect();\n        let remaining: Vec<PackageId> = members.into_iter().filter(|m| !set.contains(m)).collect();\n        let cycle = extract_cycle(&remaining, &adj);\n        return Err(GraphError::Cycle { cycle });\n    }\n\n    Ok(sorted)\n}\n\nfn extract_cycle(remaining: &[PackageId], adj: &BTreeMap<PackageId, Vec<PackageId>>) -> Vec<PackageId> {\n    use petgraph::algo::tarjan_scc;\n    use petgraph::graph::DiGraph;\n\n    let mut graph = DiGraph::<PackageId, ()>::new();\n    let mut node_map = BTreeMap::new();","numLines":90,"startLine":1,"totalLines":222}},"sourceToolAssistantUUID":"2d50d42d-ae36-4c9a-9e69-864bd8319476","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Us