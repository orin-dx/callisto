"[package]\\nname='dual'\\nversion='1.0.0'\\nedition='2021'\\n\",\n    )\n    .unwrap();\n    std::fs::write(\n        root.join(\"package.json\"),\n        r#\"{\"name\":\"dual\",\"version\":\"1.0.0\",\"dependencies\":{\"dual-dep\":\"1.0.0\"}}\"#,\n    )\n    .unwrap();\n    for lockfile in [\n        \"Cargo.lock\",\n        \"package-lock.json\",\n        \"pnpm-lock.yaml\",\n        \"yarn.lock\",\n        \"bun.lock\",\n    ] {\n        std::fs::write(root.join(lockfile), \"lock\").unwrap();\n    }\n    let package_json = PathBuf::from(\"package.json\");\n    let plan = VersionPlan {\n        bumps: vec![PlannedBump {\n            package: PackageId::parse(\"cargo:dual\").unwrap(),\n            from: cargo_version(\"1.0.0\"),\n            to: cargo_version(\"1.1.0\"),\n            severity: Severity::Minor,\n            governed_by: None,\n            reason: None,\n            writes: vec![\n                VersionWriteTarget::Manifest(PathBuf::from(\"Cargo.toml\")),\n                VersionWriteTarget::Manifest(package_json.clone()),\n            ],\n        }],\n        rewrites: vec![crate::cascade::SpecRewrite {\n            key: crate::cascade::RewriteKey {\n                locator: Default::default(),\n                target: DepWriteTarget::Manifest(package_json),\n                name: \"dual-dep\".to_string(),\n                kind: Some(callisto_model::DepKind::Runtime),\n            },\n            dependency: PackageId::parse(\"npm:dual-dep\").unwrap(),\n            from: callisto_model::DepSpec::Exact(cargo_version(\"1.0.0\")),\n            to: callisto_model::DepSpec::Exact(cargo_version(\"1.1.0\")),\n        }],\n        ..Default::default()\n    };\n    let calls = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));\n    let runner = RecordingRunner {\n        calls: std::sync::Arc::clone(&calls),\n    };\n    let outcome = apply_version_plan(\n        root,\n        &plan,\n        &runner,\n        &ApplyOptions {\n            refresh_lockfiles: true,\n            transient: false,\n        },","is_error":false}]},"uuid":"ccfb820f-3561-4805-9a7d-390022a1dbbc","timestamp":"2026-11-14T02:43:20.772Z","toolUseResult":{"stdout":"25-\n26-/// Records every (program, args) pair that CommandRunner::run is called with.\n27:struct RecordingRunner {\n28-    #[allow(clippy::type_complexity)]\n29-    calls: CallLog,\n30-}\n31-\n32-impl CommandRunner for RecordingRunner {\n33-    fn run(&self, program: &str, args: &[&str], _cwd: &Path) -> Result<CommandOutput, CommandError> {\n34-        self.calls\n35-            .lock()\n36-            .unwrap()\n37-            .push((program.to_string(), args.iter().map(|s| s.to_string()).collect()));\n38-        Ok(CommandOutput {\n39-            exit_code: Some(0),\n40-            stdout: String::new(),\n41-            stderr: String::new(),\n42-        })\n43-    }\n44-}\n45-\n46-fn cargo_version(v: &str) -> Version {\n47-    Version::parse(v, VersionGrammar::SemVer).expect(\"valid semver\")\n48-}\n49-\n50-/// A bump-precondition failure inside a batched group must block\n51-/// every rewrite in that group and leave the manifest byte-for-byte\n52-/// unchanged (no rewrite is ever attempted, persist is never called).\n53-#[test]\n54-fn batched_group_bump_precondition_failure_skips_all_rewrites_in_group() {\n55-    let dir = tempfile::tempdir().unwrap();\n56-    let root = dir.path();\n57-    let cargo_toml_path = root.join(\"Cargo.toml\");\n58-    let original = \"[package]\\nname = \\\"my-crate\\\"\\nversion = \\\"2.0.0\\\"\\nedition = \\\"2021\\\"\\n\\n[dependencies]\\nhelper = \\\"1.0.0\\\"\\nother = \\\"1.0.0\\\"\\n\";\n59-    std::fs::write(&cargo_toml_path, original).unwrap();\nfn refresh_lockfiles_includes_every_bump_and_dependency_write_ecosystem() {\n    let dir = tempfile::tempdir().expect(\"create tempdir\");\n    let root = dir.path();\n    std::fs::write(\n        root.join(\"Cargo.toml\"),\n        \"[package]\\nname='dual'\\nversion='1.0.0'\\nedition='2021'\\n\