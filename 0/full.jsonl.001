insertions(+), 3 deletions(-)\n\nChanges:\n\ncrates/callisto-vcs/src/lib.rs\n@@ -1,6 +1,8 @@\n+use std::fmt;\n use std::path::{Path, PathBuf};\n \n use callisto_model::{ApplyPermit, CommandError, CommitRecord, CommitSha, CommitWalkError, CommitWalker, TagName};\n+use sha2::{Digest, Sha256};\n use thiserror::Error;\n \n pub mod access;\n@@ -10,6 +12,97 @@ pub mod shell;\n pub use access::GitAccess;\n pub use shell::ShellGit;\n \n+/// SHA-256 of the canonical message bytes in an annotated Git tag.\n+///\n+/// Callisto stores exactly one final newline after its normalized message.\n+/// Release callers construct this value from the logical annotation they pass to\n+/// [`GitDataSource::create_tag`], while remote observation hashes the raw\n+/// message bytes in the fetched tag object. Keeping that conversion here\n+/// prevents the graph layer from having a second, subtly different notion of\n+/// annotated-tag equality.\n+#[derive(Clone, Debug, PartialEq, Eq, Hash)]\n+pub struct TagAnnotationDigest(String);\n+\n+impl TagAnnotationDigest {\n+    /// Hashes an annotation using Callisto's canonical tag-message encoding.\n+    pub fn from_annotation(annotation: &str) -> Self {\n+        Self::from_tag_object_message(canonical_tag_annotation_message(annotation).as_bytes())\n+    }\n+\n+    /// Hashes raw annotation bytes from a parsed annotated tag object.\n+    pub fn from_tag_object_message(message: &[u8]) -> Self {\n+        Self(format!(\"{:x}\", Sha256::digest(message)))\n+    }\n+\n+    /// Returns the canonical lowercase SHA-256 rendering.\n+    pub fn as_str(&self) -> &str {\n+        &self.0\n+    }\n+}\n+\n+/// Produces the one annotation serialization every release tag backend must\n+/// write and every expected digest must represent. Git's `-m` interface\n+/// other<truncated omitted_approx_tokens=\"2039\" />/ remote calls. Production code should use [`GitAccess`], which passes the\n+/// caller's own command runner to [`ShellGit`] instead.\n+#[cfg(not(target_arch = \"wasm32\"))]\n+struct NativeCommandRunner;\n+\n+#[cfg(not(target_arch = \"wasm32\"))]\n+impl callisto_model::CommandRunner for NativeCommandRunner {\n+    fn run(&self, program: &str, args: &[&str], cwd: &Path) -> Result<callisto_model::CommandOutput, CommandError> {\n+        let output = std::process::Command::new(program)\n+            .args(args)\n+            .current_dir(cwd)\n+            .output()\n+            .map_err(|error| CommandError::Io {\n+                program: program.to_string(),\n+                message: error.to_string(),\n+            })?;\n+        Ok(callisto_model::CommandOutput {\n+            exit_code: output.status.code(),\n+            stdout: String::from_utf8_lossy(&output.stdout).into_owned(),\n+            stderr: String::from_utf8_lossy(&output.stderr).into_owned(),\n+        })\n+    }\n }\n \n /// Diffs `commit_obj`'s tree against its first parent's tree (or the empty\n@@ -677,6 +889,27 @@ impl GitDataSource for GitRepository {\n     ) -> Result<(), VcsError> {\n         self.create_floating_major(major_name, target_sha, permit)\n     }\n+\n+    fn observe_remote_annotated_tag(\n+        &self,\n+        remote: &str,\n+        name: &TagName,\n+        target_sha: &CommitSha,\n+        annotation_digest: &TagAnnotationDigest,\n+    ) -> Result<RemoteAnnotatedTagObservation, VcsError> {\n+        self.observe_remote_annotated_tag(remote, name, target_sha, annotation_digest)\n+    }\n+\n+    fn push_annotated_tag_and_confirm(\n+        &self,\n+        remote: &str,\n+        name: &TagName,\n+        target_sha: &CommitSha,\n+        annotation_digest: &TagAnnotationDigest,\n+        permit: &ApplyPermit,\n+    ) -> Result<RemoteAnnotatedTagObservation, VcsError> {\n+        self.push_annotated_tag_and_confirm(remote, name, target_sha, annotation_digest, permit)\n+    }\n }\n \n #[cfg(test)]\n  +236 -3\n\n"},{"type":"input_text","text":"\n[99] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/t