st.CommandElements\n         callisto-cli:test |     $command = @(\n         callisto-cli:test |         'callisto'\n         callisto-cli:test |         for ($i = 1; $i -lt $commandElements.Count; $i++) {\n         callisto-cli:test |             $element = $commandElements[$i]\n         callisto-cli:test |             if ($element -isnot [StringConstantExpressionAst] -or\n         callisto-cli:test |                 $element.StringConstantType -ne [StringConstantType]::BareWord -or\n         callisto-cli:test |                 $element.Value.StartsWith('-') -or\n         callisto-cli:test |                 $element.Value -eq $wordToComplete) {\n         callisto-cli:test |                 break\n         callisto-cli:test |         }\n         callisto-cli:test |         $element.Value\n         callisto-cli:test |     }) -join ';'\n         callisto-cli:test | \n         callisto-cli:test |     $completions = @(switch ($command) {\n         callisto-cli:test |         'callisto' {\n         callisto-cli:test |             [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format for command results')\n         callisto-cli:test |             [CompletionResult]::new('--cwd', '--cwd', [CompletionResultType]::ParameterName, 'Workspace directory to operate in (defaults to the current directory)')\n         callisto-cli:test |             [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Preview manifest and file changes without writing to disk')\n         callisto-cli:test |             [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             [CompletionResult]::new('-V', '-V ', [CompletionResultType]::ParameterName, 'Print version')\n         callisto-cli:test |             