re },\n\n    #[error(\"release selection for package `{package}` is invalid: {reason}\")]\n    #[diagnostic(\n        code(E169),\n        help(\"Adjust the release selection so each package appears at most once and matches an entry in the release plan.\")\n    )]\n    ReleaseSelectionInvalid {\n        package: callisto_model::ReleasePackageId,\n        reason: ReleaseSelectionInvalidReason,\n    },\n\n    #[error(\"release precondition unmet: requires {requirement}\")]\n    #[diagnostic(\n        code(E170),\n        help(\"Satisfy the reported precondition (for example a detached HEAD or a configured GitHub remote) before retrying.\")\n    )]\n    ReleasePreconditionUnmet {\n        requirement: ReleasePreconditionRequirement,\n    },\n\n    #[error(\"internal release invariant violated: {detail}\")]\n    #[diagnostic(\n        code(E171),\n        help(\n            \"This is an internal callisto defect, not an operator action; report it along with the full error detail.\"\n        )\n    )]\n    ReleaseInvariant { detail: String },\n}\n\n/// Why a workspace package that a `--package` filter named is nonetheless\n/// absent from the computed [`crate::commands::plan_publish`] plan, distinct\n/// from [`GraphError::UnknownPackage`] (which means the name matched no\n/// workspace package at all).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]\npub enum NotInPlanReason {\n    #[error(\"its on-disk version already matches its last release tag; there is nothing pending to publish\")]\n    NotARelease,\n    #[error(\"it configures no publish target with an implemented dispatch (e.g. only NuGet or GitHub Release)\")]\n    NoDispatchableTarget,\n}\n\n/// Source of a [`GraphError::ReleaseCommand`] (E164) failure: either the\n/// subprocess exited non-zero, or it exited zero but produced output this\n/// crate could not parse.\n#[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]\npub enum CommandFailure {\n    #[error(\"exited with status {exit_code:?}: {stderr}\")]\n    NonZeroExit { exit_code: Option\u003ci32\u003e, stderr: String },\n    #[error(\"produced malformed output: {detail}\")]\n    MalformedOutput { detail: String },\n}\n\n/// One distinct disagreement between a merged release commit and the release\n/// decision it claims to satisfy, carried by\n/// [`GraphError::ReleaseCommitVerificationFailed`] (E165).\n#[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]\npub enum CommitVerificationFailure {\n    #[error(\"commit does not match the expected HEAD\")]\n    HeadMismatch,\n    #[error(\"the release-decision file was not written by this commit\")]\n    DecisionNotWrittenByCommit,\n    #[error(\"no changeset was consumed by this commit\")]\n    NoChangesetConsumed,\n    #[error(\"the changelog was not touched by this commit\")]\n    ChangelogNotTouched,\n\n","type":"input_text"},{"text":"\n[80] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/error.rs\\n@@\\n     ReleaseInvariant { detail: String },\\n+\\n+    #[error(\\\"external state conflicts with release operation `{operation:?}`\\\")]\\n+    #[diagnostic(\\n+        code(E172),\\n+        help(\\\"Reconcile the conflicting provider object manually; Callisto did not overwrite it.\\\")\\n+    )]\\n+    ReleaseObservationConflict {\\n+        operation: callisto_model::ReleaseOperationId,\\n+    },\\n+\\n+    #[error(\\\"external state for release operation `{operation:?}` could not be verified\\\")]\\n+    #[diagnostic(\\n+        code(E173),\\n+        help(\\\"Restore provider connectivity and credentials, then retry observation before applying any effect.\\\")\\n+    )]\\n+    ReleaseObservationUnverifiable {\\n+        operation: callisto_model::ReleaseOperationId,\\n+    },\\n+\\n+    #[error(\\\"release operation `{operation:?}` is not the exact missing work authorized by provider observation\\\")]\\n+    #[diagnostic(\\n+        code(E174),\\n+        help(\\\"Run reconciliation in dependency order; Callisto did not apply work whose prerequisites remain missing.\\\")\\n+    )]\\n+    ReleaseOperationNotMissing {\\n+        operation: callisto_model::ReleaseOperationId,\\n+    },\\n }\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n","type":"input_text"},{"text":"\n[81] tool exec result: Script completed\nWall time 3.3 seconds\nOutput:\n\n{}\n","type":"input_text"},{"text":"\n[82] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/commands/release.rs\\n@@\\n use callisto_model::{\\n-    ApplyPermit, ApprovedRegistryArtifact, CanonicalTranscript, CommandOutput, CommandRunner, CommitSha, Ecosystem,\\n+    ApplyPermit, ApprovedRegistryArtifact, CanonicalTranscript, CommandRunner, CommitSha, Ecosystem,\\n@@\\n use callisto_vcs::{\\n     access::{GitCommitTrustEvidence, GitHeadDisposition},\\n     release_lock::ReleaseWorkspaceLock,\\n-    GitAccess, GitDataSource, TagSignPolicy,\\n+    GitDataSource, TagSignPolicy,\\n };\\n \\n use crate::error::{\\n-    CommandFailure, ReleasePreconditionRequirement, ReleaseSelectionInvalidReason, RemoteConflict,\\n-    UnsupportedReleaseFeature,\\n+    CommandFailure, ReleasePreconditionRequirement, ReleaseSelectionInvalidReason, UnsupportedReleaseFeature,\\n };\\n use crate::{commands::registry_argv, DependencyResolver, GraphError, ProjectLocator, Workspace};\\n+\\n+use super::{\\n+    registry_artifacts::{cargo_upload_body, CargoAuthorizationHeader, PrivateArtifactFile},\\n+    release_artifacts::ValidatedArtifactManifest,\\n+    release_observation::{observe_prepared, MissingWork, ObservationSession, OperationObservation},\\n+};\\n+\\n+const PROVIDER_EFFECT_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(300);\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n","type":"input_text"},{"text":"\n[83] tool exec result: Script completed\nWall time 3.3 seconds\nOutput:\n\n{}\n","type":"input_text"},{"text":"\n[84] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/commands/release.rs\\n@@\\n impl ValidatedReleaseIntent\u003c'_\u003e {\\n@@\\n     pub(crate) fn dispatch_prepared(\\n         \u0026self,\\n+        artifacts: \u0026ValidatedArtifactManifest\u003c'_, '_\u003e,\\n+        observations: \u0026mut ObservationSession,\\n         permit: \u0026ApplyPermit,\\n         id: \u0026ReleaseOperationId,\\n     ) -\u003e Result\u003cOperationOutcome, GraphError\u003e {\\n         let operation = self\\n@@\\n                 detail: format!(\\\"dispatch_prepared: no prepared operation for `{id:?}`\\\"),\\n             })?;\\n-        match operation {\\n-            PreparedOperation::ProductTag {\\n-                name,\\n-                target,\\n-                annotation,\\n-                ..\\n-            } =\u003e self.dispatch_tag(permit, name, target, annotation),\\n-            PreparedOperation::RegistryArtifactPublish { .. }\\n-            | PreparedOperation::ForgePrepare { .. }\\n-            | PreparedOperation::ArtifactUpload { .. }\\n-            | PreparedOperation::ForgePublish { .. } =\u003e Err(GraphError::ReleaseInvariant {\\n-                detail: format!(\\n-                    \\\"dispatch for promoted product operation `{id:?}` is owned by the coordinated PM-005/T3 cutover\\\"\\n-                ),\\n-            }),\\n+        let observed = observe_prepared(observations, artifacts, id);\\n+        if operation_is_satisfied(id, \u0026observed) {\\n+            return Ok(OperationOutcome::AlreadySatisfied);\\n+        }\\n+        ensure_operation_is_missing(id, \u0026observed)?;\\n+        self.recheck_trust()?;\\n+        match operation {\\n+            PreparedOperation::RegistryArtifactPublish {\\n+                artifact,\\n+                registry,\\n+                npm_client,\\n+            } =\u003e self.dispatch_registry_artifact(artifacts, id, artifact, registry, *npm_client)?,\\n+            PreparedOperation::ProductTag {\\n+                name,\\n+                target,\\n+                annotation,\\n+                remote,\\n+            } =\u003e self.dispatch_product_tag(permit, name, target, annotation, remote)?,\\n+            PreparedOperation::ForgePrepare { repository, tag } =\u003e self.dispatch_forge_prepare(repository, tag)?,\\n+            PreparedOperation::ArtifactUpload { slot } =\u003e self.dispatch_forge_asset(artifacts, slot)?,\\n+            PreparedOperation::ForgePublish { repository, tag } =\u003e self.dispatch_forge_publish(repository, tag)?,\\n         }\\n+        observations.invalidate_after_effect();\\n+        self.recheck_trust()?;\\n+        let after = observe_prepared(observations, artifacts, id);\\n+        if operation_is_satisfied(id, \u0026after) {\\n+            Ok(OperationOutcome::Published)\\n+        } else {\\n+            Err(observation_error(id, \u0026after))\\n+        }\\n     }\\n }\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n","type":"input_text"},{"text":"\n[85] tool exec result: Script completed\nWall time 8.8 seconds\nOutput:\n\n{}\n","type":"input_text"},{"text":"\n[86] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/commands/release.rs\\n@@\\n-/// Ecosystems whose publish gets confirmed against the registry before the\\n-/// operation is marked done. Npm and Cargo are checked; PyPI has the\\n-/// identical propagation-lag gap, deliberately deferred -- no PyPI package\\n-/// or credentials in this workspace to test a fix against. The single\\n-/// source of truth `dispatch_registry` actually consults, so a test on this\\n-/// function directly proves the runtime gate, not a copy of it.\\n-fn ecosystem_requires_registry_confirmation(ecosystem: Ecosystem) -\u003e bool {\\n-    matches!(ecosystem, Ecosystem::Npm | Ecosystem::Cargo)\\n-}\\n-\\n-/// A successful publish-client exit isn't a receipt: confirms the registry\\n-/// itself has caught up before treating the operation as done. If not, it\\n-/// stays `Attempting` for reconciliation, reported via its own variant\\n-/// rather than `ReleaseIntentStale`'s false \\\"no operation was authorized\\\".\\n-fn require_registry_confirmation(is_published: bool, package: \u0026str, version: \u0026Version) -\u003e Result\u003c(), GraphError\u003e {\\n-    if is_published {\\n-        return Ok(());\\n-    }\\n-    Err(GraphError::RegistryPublishUnconfirmed {\\n-        package: package.to_string(),\\n-        version: version.clone(),\\n-    })\\n-}\\n-\\n-/// Retries after this many unconfirmed checks: 3 retries (4 checks total).\\n-const REGISTRY_CONFIRMATION_MAX_RETRIES: u32 = 3;\\n-\\n-/// Exponential backoff between confirmation checks: 2s, 4s, 8s (14s worst\\n-/// case) -- registry index propagation is normally sub-second, so this only\\n-/// costs time on the rare lagging case, not the common one.\\n-fn registry_confirmation_backoff(retry: u32) -\u003e std::time::Duration {\\n-    std::time::Duration::from_secs(2u64.pow(retry + 1))\\n-}\\n-\\n-/// Retries `check` up to `max_retries` more times, sleeping `backoff(retry)`\\n-/// between attempts, and returns as soon as it reports published. Returns\\n-/// `Ok(false)` if it never does. `sleep` is injected so tests can verify the\\n-/// retry count and schedule without a real wall-clock wait.\\n-fn poll_until_published(\\n-    mut check: impl FnMut() -\u003e Result\u003cbool, GraphError\u003e,\\n-    max_retries: u32,\\n-    backoff: impl Fn(u32) -\u003e std::time::Duration,\\n-    sleep: impl Fn(std::time::Duration),\\n-) -\u003e Result\u003cbool, GraphError\u003e {\\n-    for retry in 0..=max_retries {\\n-        if check()? {\\n-            return Ok(true);\\n-        }\\n-        if retry \u003c max_retries {\\n-            sleep(backoff(retry));\\n-        }\\n-    }\\n-    Ok(false)\\n-}\\n-\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n","type":"input_text"},{"text":"\n[87] tool exec result: Script completed\nWall time 5.0 seconds\nOutput:\n\n{}\n","type":"input_text"},{"text":"\n[88] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/commands/release.rs\\n@@\\n impl ValidatedReleaseIntent\u003c'_\u003e {\\n-    /// Runs a [`registry_argv::Argv`] built by the pure argv layer. This is\\n-    /// the only place `dispatch_registry` touches [`CommandRunner`] --\\n-    /// everything about *what* to run (program, args, cwd) was already\\n-    /// decided by `registry_argv`.\\n-    fn run_argv(\u0026self, argv: \u0026registry_argv::Argv) -\u003e Result\u003cCommandOutput, GraphError\u003e {\\n-        let args: Vec\u003c\u0026str\u003e = argv.args.iter().map(String::as_str).collect();\\n-        Ok(self.runner.run(\u0026argv.program, \u0026args, \u0026argv.cwd)?)\\n-    }\\n-\\n-    fn npm_version_is_published(\\n-        \u0026self,\\n-        package_name: \u0026str,\\n-        version: \u0026Version,\\n-        registry: Option\u003c\u0026str\u003e,\\n-    ) -\u003e Result\u003cbool, GraphError\u003e {\\n-        let spec = format!(\\\"{package_name}@{}\\\", version.render());\\n-        let mut args = vec![\\\"view\\\", spec.as_str(), \\\"--json\\\"];\\n-        if let Some(registry) = registry {\\n-            args.extend([\\\"--registry\\\", registry]);\\n-        }\\n-        let output = self\\n-            .runner\\n-            .run_quiet(\\\"npm\\\", \u0026args, \u0026self.prepared.root, std::time::Duration::from_secs(300))?;\\n-        if output.success() {\\n-            return Ok(!output.stdout_trimmed().is_empty());\\n-        }\\n-        let details = format!(\\\"{}\\\\n{}\\\", output.stdout, output.stderr).to_ascii_lowercase();\\n-        if details.contains(\\\"e404\\\")\\n-            || details.contains(\\\"etarget\\\")\\