plan-publish'= {\n         callisto-cli:test |             cand --package 'Plan only the named package(s). Repeatable: `--package foo --package bar`'\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;publish'= {\n         callisto-cli:test |             cand --package 'Publish only the named package(s). Repeatable: `--package foo --package bar`. When omitted, all packages in the plan are published'\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --skip-publish-precheck 'Skip the pre-publish \"already published?\" registry check and publish directly, relying on the registry''s own already-published response. Saves one round-trip per package, at the cost of re-running local publish lifecycle scripts (e.g. npm''s prepublishOnly) on a retried publish of an already-published version'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;compose-pr-body'= {\n         callisto-cli:test |             cand --existing-body 'Existing PR body text to merge with, or `-` to read it from stdin'\n   