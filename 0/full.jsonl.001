the glob. `twine` expands the glob\n    /// internally -- no shell expansion, so the literal `*` is safe.\n    ///\n    /// `index: Some` inserts `--repository-url <url>` before the glob, to\n    /// target a private index (Nexus/Artifactory PyPI proxy) instead of\n    /// public PyPI.\n    ///\n    /// Output classification via [`classify_twine_output`]: `--skip-existing`'s\n    /// \"already exists\" message -> [`PublishOutcome::AlreadyPublished`]; clean\n    /// zero-exit with no skip message -> [`PublishOutcome::Published`];\n    /// rate-limit/auth signals -> matching [`RegistryError`] variants;\n    /// everything else -> [`RegistryError::Other`]."},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1765,"cache_read_input_tokens":639748,"output_tokens":1428,"output_tokens_details":{"thinking_tokens":421},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1765,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1428,"cache_read_input_tokens":639748,"cache_creation_input_tokens":1765,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1765},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CeJYygF3xgTU7rmfNoogN","type":"assistant","uuid":"25188413-56f1-4ac4-8549-08684dc0cc59","timestamp":"2026-08-22T22:10:34.812Z","effort":"high","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"docs-cleanup-rust-comments","slug":"shimmying-giggling-hickey"}
