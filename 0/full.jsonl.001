 and range hard stop (A4), foreign published version (A5), snapshots (A6), OIDC, library crates at 1.0, E176 detail carry, schemaVersion bump.\n\"\"\"\ns=re.sub(r\"## Open PRs from the 2026-10-20 review.*?\\n\\n## Rules\",\"%s\\n## Rules\"%new.rstrip(\"\\n\")+\"\\n\",s,flags=re.S)\nopen(p,'w').write(s)\nEOF\ngrep -n '^## ' NEXT-WORK.md","description":"Update local plan file for merged PRs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1152,"cache_read_input_tokens":85084,"output_tokens":1071,"output_tokens_details":{"thinking_tokens":90},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1152,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1071,"cache_read_input_tokens":85084,"cache_creation_input_tokens":1152,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1152},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_017ZavPcQWvXpd4q3X6tg1sY":{"command":"cd /Users/gabe/Projects/callisto/.claude/plans && python3 - <<'EOF'\nimport re\np='NEXT-WORK.md'\ns=open(p).read()\ns=s.replace(\"Baseline: main `308d35a91` (#247).\",\"Baseline: main `44ab50f93` (#270, 2026-10-21).\")\ns=re.sub(r\"## In flight\\n.*?\\n\\n## Still open\",\"## In flight\\n\\n- Nothing open except the automated release PR (#248).\\n\\n## Still open\",s,flags=re.S)\nnew=\"\"\"## Shipped from the 2026-10-20 review (#249 to #270, all merged)\n\n- Python publish-url (#249), maturin after v1 (#251), D01 recorded in ADR 12 (#268).\n- Tag ownership by declared name (#252, #253, #255, #256, #257); token and stderr redaction (#258, #259); real-registry tests fail under CI (#261).\n- Spec and doc corrections (#262), cr