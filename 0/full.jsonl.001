{"parentUuid":"b2214648-42e6-4351-affd-65e434578b15","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011CgumyVsYU9nSiw42qvfaq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019rozzDy556xm9QDetxQURa","name":"Write","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-adf61e5ae83f5eca7/.changeset/release-pending-envelope.md","content":"---\ncallisto-cli: patch\n---\n\n`callisto release pending --format json` now carries the same envelope as every other JSON report.\n\n- The output gains `schemaVersion`, `command` and `dryRun`; the `pending` list and its fields are unchanged, so anything that reads `.pending[0].source` keeps working.\n- A failing `release pending` reports `command: \"release pending\"` instead of `\"release\"`, so a script can tell which subcommand failed.\n\nAction: if a script checks for `command == \"release\"` on a failing `release pending`, match `release pending` instead.\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1245,"cache_read_input_tokens":711343,"output_tokens":825,"output_tokens_details":{"thinking_tokens":321},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1245,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":825,"cache_read_input_tokens":711343,"cache_creation_input_tokens":1245,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1245},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_019rozzDy556xm9QDetxQURa":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-adf61e5ae83f5eca7/.changeset/release-pending-envelope.md","content":"---\ncallisto-cli: patch\n---\n\n`callisto release pending --format json` now carries the same envelope as every other JSON report.\n\n- The output gains `schemaVersion`, `command` and `dryRun`; the `pending` list and its fields are unchanged, so anything that reads `.pending[0].source` keeps working.\n- A failing `release pending` reports `command: \"release pending\"` instead of `\"release\"`, so a script can tell which subcommand failed.\n\nAction: if a script checks for `command == \"release\"` on a failing `release pending`, match `release pending` instead.\n"}},"serverClassifierRequest":"69db3085-1196-4ab4-b8a5-9351fb0903c5","apiBlockIndex":2,"requestId":"req_011CgumyVUV8oBu23BCMLcL4","requestRef":"66c74ed8-153e-47ca-8e99-35adee7a24df","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"e7cb1f4f-f109-4e11-a9fb-d07882af915c","timestamp":"2026-11-10T19:10:38.675Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-adf61e5ae83f5eca7","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/error-envelope","slug":"mossy-snacking-stream"}
