{"parentUuid":"2751fec4-c5cc-4f0d-940b-f10862ce2510","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011CgFxbdzyPeg21eTcgxkuE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GHhSfraBw8wS9prDcf7hRJ","name":"Bash","input":{"command":"/usr/bin/git push -u origin worktree-dist-tag-snapshot:feat/prerelease-dist-tag-snapshot-refusal 2>&1 | tail -1; gh pr create --base main --head feat/prerelease-dist-tag-snapshot-refusal --title \"feat(release): publish prereleases under their own npm tag and refuse snapshot versions\" --body \"Two decisions that are cheapest to settle before 1.0.\n\nDist-tag: every npm prerelease published under \\`next\\`, so a \\`beta\\` or \\`rc\\` cycle misled installers about the channel. The tag now comes from the first prerelease identifier: \\`1.0.0-beta.2\\` publishes under \\`beta\\`, \\`2.0.0-rc.1\\` under \\`rc\\`. \\`next\\` stays the fallback when the identifier is not a plain word, and the word \\`latest\\` also falls back, so a prerelease never takes the default tag. A stable version still takes the registry default. The tag is part of the release intent, so intent digests for npm prereleases change.\n\nSnapshots: \\`release --dry-run\\` after \\`snapshot\\` planned a real tag and npm publish of \\`0.0.0-<tag>-<sha>\\`. \\`release\\` now refuses a snapshot version with E169, so a snapshot is never tagged or published. The detection shares its prefixes with the code that writes snapshot versions.\n\nTests: dist-tag derivation cases, the snapshot refusal, and the one pinned intent snapshot that changes from \\`next\\` to \\`beta\\`. The release and versioning specs and \\`docs/errors.md\\` are updated.\n\nVerified: \\`just ci\\` passes locally (coverage 92.7%).\" 2>&1 | tail -1","description":"Push and open the dist-tag PR"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":924,"cache_read_input_tokens":444550,"output_tokens":731,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":924,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":731,"cache_read_input_tokens":444550,"cache_creation_input_tokens":924,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":924},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01GHhSfraBw8wS9prDcf7hRJ":{"command":"/usr/bin/git push -u origin worktree-dist-tag-snapshot:feat/prerelease-dist-tag-snapshot-refusal 2>&1 | tail -1; gh pr create --base main --head feat/prerelease-dist-tag-snapshot-refusal --title \"feat(release): publish prereleases under their own npm tag and refuse snapshot versions\" --body \"Two decisions that are cheapest to settle before 1.0.\n\nDist-tag: every npm prerelease published under \\`next\\`, so a \\`beta\\` or \\`rc\\` cycle misled installers about the channel. The tag now comes from the first prerelease identifier: \\`1.0.0-beta.2\\` publishes under \\`beta\\`, \\`2.0.0-rc.1\\` under \\`rc\\`. \\`next\\` stays the fallback when the identifier is not a plain word, and the word \\`latest\\` also falls back, so a prerelease never takes the default tag. A stable version still takes the registry default. The tag is part of the release intent, so intent digests for npm prereleases change.\n\nSnapshots: \\`release --dry-run\\` after \\`snapshot\\` planned a real tag and npm publish of \\`0.0.0-<tag>-<sha>\\`. \\`release\\` now refuses a snapshot version with E169, so a snapshot is never tagged or published. The detection shares its prefixes with the code that writes snapshot versions.\n\nTests: dist-tag derivation cases, the snapshot refusal, and the one pinned intent snapshot that changes from \\`next\\` to \\`beta\\`. The release and versioning specs and \\`docs/errors.md\\` are updated.\n\nVerified: \\`just ci\\` passes locally (coverage 92.7%).\" 2>&1 | tail -1","description":"Push and open the dist-tag PR"}},"serverClassifierRequest":"2b0012cb-8f63-495c-8a6a-e00c00e6dfe5","apiBlockIndex":0,"requestId":"req_011CgFxbdXCCu1SVWGFi8hEj","requestRef":"6e8a3c35-b84e-471f-a234-c97cb742128e","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"45979b6f-2c41-40b0-9b16-48c4dd3f5ddb","timestamp":"2026-10-21T19:47:21.512Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/dist-tag-snapshot","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"worktree-dist-tag-snapshot","slug":"lexical-jingling-puppy"}
