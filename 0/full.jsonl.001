   let out = OutputFile::new(global.resolve_file_arg(&args.out), global.dry_run, OutputKind::Intent)?;\n514-    let runner = CliCommandRunner;\n515-    let source_global = source_global(global, args.source_root.as_deref());\n516-    let workspace = load_workspace(&source_global, &runner)?;\n517-    // Before any commit is read: a shallow or SHA-256 repository must report E266 or E265, not a lower-level git error.\n518-    workspace\n519-        .git_access()\n520-        .require_trustable_repository()\n521-        .map_err(callisto_graph::GraphError::from)?;\n522-    let decision = match args.from_release_commit.as_deref() {\n523-        Some(raw) => {\n524-            let commit = callisto_model::CommitSha::parse(raw).map_err(|error| CliError::ReleaseCommitInvalid {\n525-                raw: raw.to_owned(),\n526-                detail: error.to_string(),\n527-            })?;\n528-            let decision_path = args\n529-                .decision\n530-                .as_deref()\n531-                .expect(\"clap requires --decision alongside --from-release-commit\");\n532-            let decision_path = workspace_decision_path(decision_path, &workspace.root)?;\n533-            derive_release_commit_decision(&workspace, &commit, &decision_path)?\n534-        }\n535-        None => {","is_error":false}]},"uuid":"4f989a15-e0c6-4f79-90be-d142a98f7b5d","timestamp":"2026-11-12T01:22:17.823Z","toolUseResult":{"stdout":"477-\n478-/// Decision paths are repository-relative for the diff and show commands, but callers may pass an absolute one; contain it\n479-/// in `root` once here. The file itself may not exist yet, so only its parent must resolve.\n480:pub(crate) fn workspace_decision_path(path: &Path, root: &Path) -> Result<PathBuf, CliError> {\n481-    let io_error = |source| CliError::Io {\n482-        source,\n483-        path: Some(path.to_path_buf()),\n484-    };\n485-    let relative = if path.is_absolute() {\n486-        let canonical = match dunce::canonicaliz