ll,"structuredPatch":[{"oldStart":301,"oldLines":6,"newStart":301,"newLines":35,"lines":["     }"," }"," ","+/// A package that has never been released has no last release to differ from, so a new project's first release PR does","+/// not say its packages \"changed since the last release\".","+#[test]","+fn a_never_released_package_is_not_reported_as_changed_since_its_release() {","+    let dir = setup_polyglot_git_repo();","+    let global = GlobalArgs {","+        format: OutputFormat::Json,","+        cwd: dir.path().to_path_buf(),","+        dry_run: false,","+    };","+    init_repo(&global);","+    commands::add::handle(","+        AddArgs {","+            packages: vec![\"cargo/core-crate:minor\".to_string()],","+            summary: Some(\"First feature.\".to_string()),","+        },","+        &global,","+    )","+    .unwrap();","+","+    commands::version::handle(version_args(Some(\"preview.json\".into())), &global).unwrap();","+","+    let preview = callisto_graph::release_preview::ReleasePreview::from_json(","+        &std::fs::read_to_string(dir.path().join(\"preview.json\")).unwrap(),","+    )","+    .unwrap();","+    assert!(preview.unreleased.is_empty(), \"{:?}\", preview.unreleased);","+}","+"," /// `version --emit-preview` records the publishable packages whose source changed and that the plan leaves out, and the"," /// body leads with them; the package the changeset bumps is not among them."," #[test]"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"51b19f6c-cb9f-421d-9242-169a99c0066a","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/unreleased-needs-tag","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/unreleased-needs-a-tag","slug":"mossy-snacking-stream"