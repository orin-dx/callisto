n, performs each proven-missing\n//! effect at most once, and persists a receipt only after a separate final\n//! pass proves the complete canonical operation roster exact.\n\nuse std::{collections::BTreeMap, path::Path};\n\nuse callisto_model::{\n    ApplyPermit, CommandRunner, CompleteObservationReceipt, ObservationProvenance, ObservedOperation, OperationOutcome,\n    ProductReleaseId, ReleaseArtifactManifest, ReleaseArtifactSlot, ReleaseIntent, ReleaseObservationEvidence,\n    ReleaseOperationId,\n};\nuse serde::{Deserialize, Serialize};\n\nuse crate::{locate::ProjectLocator, GraphError};\n\nuse super::{\n    release::{validate_release_intent_with_state_directory, ValidatedReleaseIntent},\n    release_artifacts::{verify_artifact_manifest, ValidatedArtifactManifest},\n    release_observation::{\n        observe_prepared, ExternalConflict, MissingWork, ObservationFailure, ObservationProvider, ObservationSession,\n        OperationObservation, VerifiedPartialEvidence,\n    },\n    release_receipt_store::{ReleaseReceiptStore, ReleaseReceiptWriter},\n};\n\n/// Executes one release through the sealed validation, artifact-verification,\n/// observation, dispatch, and final-receipt pipeline.\n///\n/// Callers provide only serialized model inputs and explicit filesystem\n/// locations. The capabilities that authorize provider effects remain private\n/// to the graph crate and cannot be retained or fabricated by a caller.\n#[allow(clippy::too_many_arguments)]\npub fn execute_release_from_artifacts<L: ProjectLocator, R: CommandRunner>(\n    root: &Path,\n    locator: &L,\n    runner: &R,\n    explicit_state_directory: Option<&Path>,\n    intent: ReleaseIntent,\n    artifact_manifest: ReleaseArtifactManifest,\n    artifact_directory: &Path,\n    receipt_path<truncated omitted_approx_tokens=\"3179\" />          ObservationProvider::Git => Self::Git,\n            ObservationProvider::GitHub => Self::GitHub,\n            ObservationProvider::Cargo => Self::Cargo,\n            ObservationProvider::Npm => Self::Npm,\n            ObservationProvider::Pypi => Self::Pypi,\n            ObservationProvider::ArtifactCapability => Self::ArtifactCapability,\n            ObservationProvider::PreparedCapability => Self::PreparedCapability,\n        }\n        }\n    }\n}\n\nimpl From<ObservationFailure> for ReleaseObservationFailure {\n    fn from(failure: ObservationFailure) -> Self {\n        match failure {\n            ObservationFailure::TrustChanged { provider } => Self::TrustChanged {\n                provider: provider.into(),\n            },\n            ObservationFailure::Command { provider } => Self::Command {\n                provider: provider.into(),\n            },\n            ObservationFailure::HttpStatus { provider, status } => Self::HttpStatus {\n                provider: provider.into(),\n                status,\n            },\n            ObservationFailure::MalformedResponse { provider } => Self::MalformedResponse {\n                provider: provider.into(),\n            },\n            ObservationFailure::MissingDigest { provider, file_name } => Self::MissingDigest {\n                provider: provider.into(),\n                file_name,\n            },\n            ObservationFailure::Capability { provider } => Self::Capability {\n                provider: provider.into(),\n            },\n            ObservationFailure::CommandSource { provider, cause: _ } => Self::Command {\n                provider: provider.into(),\n            },\n            ObservationFailure::MalformedResponseSource { provider, cause: _ } => Self::MalformedResponse {\n                provider: provider.into(),\n            },\n            ObservationFailure::CapabilitySource { provider, cause: _ } => Self::Capability {\n                provider: provider.into(),\n            },\n        }\n    }\n}\n\n"},{"type":"input_text","text":"\n[70] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk nl -ba crates/callisto-graph/src/commands/release_execution.rs | sed -n '155,180p;405,430p'\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":6000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[71] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\n   155\t}\n   156\t\n   157\timpl ReleaseReadinessReport {\n   158\t    pub fn operations(&self) -> &[ReleaseReadinessOperation] {\n   159\t        &self.operations\n   160\t    }\n   161\t\n   162\t    pub fn is_ready(&self) -> bool {\n   163\t        self.operations\n   164\t            .iter()\n   165\t            .all(|operation| matches!(operation.observation, ReleaseReadinessState::Exact(_)))\n   166\t    }\n   167\t}\n   168\t\n   169\t/// Revalidates the intent and artifact bytes, then observes every canonical\n   170\t/// operation without constructing an effect permit or persisting a receipt.\n   171\t#[allow(clippy::too_many_arguments)]\n   172\tpub fn reconcile_release_from_artifacts<L: ProjectLocator, R: CommandRunner>(\n   173\t    root: &Path,\n   174\t    locator: &L,\n   175\t    runner: &R,\n   176\t    explicit_state_directory: Option<&Path>,\n   177\t    intent: ReleaseIntent,\n   178\t    artifact_manifest: ReleaseArtifactManifest,\n   179\t    artifact_directory: &Path,\n   180\t) -> Result<ReleaseReadinessReport, GraphError> {\n   405\t                provider: provider.into(),\n   406\t            },\n   407\t            ObservationFailure::CommandSource { provider, cause: _ } => Self::Command {\n   408\t                provider: provider.into(),\n   409\t            },\n   410\t            ObservationFailure::MalformedResponseSource { provider, cause: _ } => Self::MalformedResponse {\n   411\t                provider: provider.into(),\n   412\t            },\n   413\t            ObservationFailure::CapabilitySource { provider, cause: _ } => Self::Capability {\n   414\t                provider: provider.into(),\n   415\t            },\n   416\t        }\n   41