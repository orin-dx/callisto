Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-canonical-emission","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"worktree-t06-canonical-emission","slug":"lexical-jingling-puppy"}
