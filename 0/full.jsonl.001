{"parentUuid":"ff13a03f-9828-4964-929f-f99cd9affe3b","isSidechain":false,"promptId":"cd228b46-c510-4a96-9f7c-9ca48c777b22","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011DDvNfFYYC2ohUNmdUR79G","type":"tool_result","content":"        CARGO_REGISTRY_TOKEN: ${{ env.CARGO_REGISTRY_TOKEN }}\n        TWINE_PASSWORD: ${{ env.TWINE_PASSWORD }}\n        FORCE_COLOR: \"1\"\n        CLICOLOR_FORCE: \"1\"\n      run: |\n        set -e\n        if [[ \"$INPUT_CWD\" != \".\" ]]; then\n          cd \"$INPUT_CWD\"\n        fi\n\n        echo \"::group::1. Inspecting Workspace Status\"\n        set +e\n        callisto status --check\n        STATUS_EXIT=$?\n        set -e\n        if [[ $STATUS_EXIT -eq 0 ]]; then\n          HAS_CHANGESETS=true\n        elif [[ $STATUS_EXIT -eq 2 ]]; then\n          HAS_CHANGESETS=false\n        else\n          echo \"::error::callisto status --check failed with exit code $STATUS_EXIT\"\n          exit $STATUS_EXIT\n        fi\n        echo \"::endgroup::\"\n\n        if [[ \"$HAS_CHANGESETS\" == \"true\" ]]; then\n          echo \"hasChangesets=true\" >> $GITHUB_OUTPUT\n          echo \"published=false\" >> $GITHUB_OUTPUT\n\n          EXISTING_PR_BODY=$(gh pr list --head callisto/version-packages --json body --jq '.[0].body // empty' 2>/dev/null || true)\n\n          echo \"::group::2. Composing Version PR Body\"\n          if [[ -n \"$EXISTING_PR_BODY\" ]]; then\n            PR_BODY=$(echo \"$EXISTING_PR_BODY\" | callisto compose-pr-body --existing-body - --label \"$INPUT_PR_LABEL\" --branch \"$INPUT_BRANCH\" --format text)\n          else\n            PR_BODY=$(callisto compose-pr-body --label \"$INPUT_PR_LABEL\" --branch \"$INPUT_BRANCH\" --format text)\n          fi\n          echo \"$PR_BODY\"\n          echo \"::endgroup::\"\n\n          echo \"::group::3. Bumping Package Versions ($INPUT_VERSION_COMMAND)\"\n          read -ra _version_cmd <<< \"$INPUT_VERSION_COMMAND\"\n          \"${_version_cmd[@]}\"\n          echo \"::endgroup::\"\n\n          echo \"::group::4. Creating / Updating Version Packages Pull Request\"\n          if [[ -n $(git status --porcelain) ]]; then\n            if [[ \"$INPUT_SETUP_GIT_USER\" == \"true\" ]]; then\n              git config user.name \"github-actions[bot]\"\n              git config user.email \"github-actions[bot]@users.noreply.github.com\"\n            fi","is_error":false}]},"uuid":"318ee5e4-5b6c-4f0e-9039-34c38249e3de","timestamp":"2026-08-19T15:37:52.131Z","toolUseResult":{"stdout":"        CARGO_REGISTRY_TOKEN: ${{ env.CARGO_REGISTRY_TOKEN }}\n        TWINE_PASSWORD: ${{ env.TWINE_PASSWORD }}\n        FORCE_COLOR: \"1\"\n        CLICOLOR_FORCE: \"1\"\n      run: |\n        set -e\n        if [[ \"$INPUT_CWD\" != \".\" ]]; then\n          cd \"$INPUT_CWD\"\n        fi\n\n        echo \"::group::1. Inspecting Workspace Status\"\n        set +e\n        callisto status --check\n        STATUS_EXIT=$?\n        set -e\n        if [[ $STATUS_EXIT -eq 0 ]]; then\n          HAS_CHANGESETS=true\n        elif [[ $STATUS_EXIT -eq 2 ]]; then\n          HAS_CHANGESETS=false\n        else\n          echo \"::error::callisto status --check failed with exit code $STATUS_EXIT\"\n          exit $STATUS_EXIT\n        fi\n        echo \"::endgroup::\"\n\n        if [[ \"$HAS_CHANGESETS\" == \"true\" ]]; then\n          echo \"hasChangesets=true\" >> $GITHUB_OUTPUT\n          echo \"published=false\" >> $GITHUB_OUTPUT\n\n          EXISTING_PR_BODY=$(gh pr list --head callisto/version-packages --json body --jq '.[0].body // empty' 2>/dev/null || true)\n\n          echo \"::group::2. Composing Version PR Body\"\n          if [[ -n \"$EXISTING_PR_BODY\" ]]; then\n            PR_BODY=$(echo \"$EXISTING_PR_BODY\" | callisto compose-pr-body --existing-body - --label \"$INPUT_PR_LABEL\" --branch \"$INPUT_BRANCH\" --format text)\n          else\n            PR_BODY=$(callisto compose-pr-body --label \"$INPUT_PR_LABEL\" --branch \"$INPUT_BRANCH\" --format text