${{ always() }}\n        with:\n          name: code-coverage-report\n          path: lcov.info\n          if-no-files-found: warn\n          retention-days: 14\n\n  security:\n    name: Security & Advisory Audit (Moon & Just)\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n        with:\n          fetch-depth: 0\n      - uses: extractions/setup-just@dd310ad5a97d8e7b41793f8ef055398d51ad4de6 # v2\n      - uses: moonrepo/setup-toolchain@261c62cb5b0f580c7be7c8cd0f023a2e96756095 # v0\n      - uses: orin-dx/actions/setup-rust@2521888266780dabc7f5fd4c32b02d6ab82849db # v1.1\n        with:\n          targets: wasm32-wasip1\n      - uses: taiki-e/install-action@0758d235715de2f3551eacc980d9ae8fce9342c3 # v2\n        with:\n          tool: cargo-deny\n      - run: just audit\n\n  validate:\n    name: Validate Changesets & Workspace Status\n    needs: [fmt, clippy, test, coverage, security]\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n        with:\n          fetch-depth: 0\n      - uses: ./.github/actions/callisto-validate\n## codex/release-execution-foundation...origin/codex/release-execution-foundation\n\n738aa151 test(release): add durable execution acceptance coverage\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0600e-0262-7e41-937d-39490f5db101","create_time":1788317966.390696}}}
