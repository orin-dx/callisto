g a not-yet-built behavior -- they are pinning that T3's fix left the no-registration fallback path byte-identical to the pre-fix behavior. Do NOT treat a passing test before any code change as a broken test for this task specifically (the standard 'test must fail before implementation' rule does not apply here since there is no implementation step in this task). As an optional double-check only, you may temporarily revert T3's fix (replace `name: input.identity.native_name(&edge.to, eco).map(str::to_string).unwrap_or_else(|| edge.to.name().to_string()),` back to `name: edge.to.name().to_string(),` in an uncommitted working-tree edit) and confirm both tests still pass identically -- both expressions are mathematically equivalent when no native_name registration exists, so this reversion check should show no difference. Then restore T3's fix before committing.\",\n        \"Add these two test functions to crates/callisto-graph/src/cascade.rs's `#[cfg(test)] mod tests` block, immediately after `test_dual_identity_rewrite_key_uses_dependents_ecosystem_native_name` (added in T3):","originalFile":null,"structuredPatch":[{"oldStart":91,"oldLines":8,"newStart":91,"newLines":8,"lines":["       },","       \"depends_on\": [\"T3\"],","       \"steps\": [","-        \"NOTE: this task adds no further implementation change -- the fallback behavior (`unwrap_or_else(|| edge.to.name().to_string())`) was already implemented in T3. To demonstrate genuine RED-before-GREEN for this task's own tests (not merely tests that pass on arrival), temporarily revert T3's fix by replacing the current `name: input.identity.native_name(&edge.to, eco).map(str::to_string).unwrap_or_else(|| edge.to.name().to_string()),` expression back to `name: edge.to.name().to_string(),` in a local, uncommitted working-tree edit before adding the tests below -- this reversion is not itself a real behavior change since both expressions produce the identical result when no native_name registration exists, so it is safe to use purely as a RED-phase probe.\",","-        \"RED (probe): add these two test functions to crates/callisto-graph/src/cascade.rs's `#[cfg(test)] mod tests` block, immediately after `test_dual_identity_rewrite_key_uses_dependents_ecosystem_native_name` (added in T3):\\n```rust\\n/// AC-003: when IdentityIndex::native_name(&target, dependent_eco) returns\\n/// None (the common, non-dual-identity case), RewriteKey.name must equal\\n/// PackageId::name() exactly as it did before this fix, for a Prefixed\\n/// target with no registration.\\n#[test]\\nfn test_none_registration_fallback_uses_package_id_name_ac003() {\\n    let dep_target = PackageId::parse(\\\"pkg-core\\\").unwrap();\\n    let dependent = PackageId::parse(\\\"pkg-app\\\").unwrap();\\n    let edge = make_dep_edge(&dependent, &dep_target, \\\"^1.0.0\\\", Ecosystem::Cargo);\\n\\n    let graph = TestGraph {\\n        packages: vec![bare_package(&dep_target), bare_package(&dependent)],\\n        edges: vec![edge],\\n    };\\n\\n    let mut base = BTreeMap::new();\\n    base.insert(dep_target.clone(), Version::semver(1, 0, 0));\\n    base.insert(dependent.clone(), Version::semver(1, 0, 0));\\n\\n    let mut seed = BTreeMap::new();\\n    seed.insert(dep_target.clone(), Severity::Major);\\n\\n    let groups = GroupTable::default();\\n    let cfg = CascadeConfig {\\n        mode: CascadeMode::OutOfRange,\\n        bump_severity: CascadeBumpSeverity::Patch,\\n        peer_escalation: true,\\n        preserve_npm_ranges: false,\\n    };\\n    let reasons = BTreeMap::new();\\n    let named_by = BTreeMap::new();\\n    let identity = IdentityIndex::default();\\n\\n    let input = CascadeInput {\\n        graph: &graph,\\n        groups: &groups,\\n        cfg: &cfg,\\n        seed: &seed,\\n        reasons: &reasons,\\n        named_by: &named_by,\\n        base: &base,\\n        pre: None,\\n        tags: &TagIndex::empty(),\\n        identity: &identity,\\n    };\\n\\n    let outcome = run_cascade(input).unwrap();\\n    let rewrite = outcome\\n        .rewrites\\n        .values()\\n        .find(|r| r.dependency == dep_target)\\n        .expect(\\\"rewrite for dep_target must be produced\\\");\\n\\n    assert_eq!(\\n        rewrite.key.name,\\n        dep_target.name(),\\n        \\\"with no IdentityIndex.native registration, RewriteKey.name must fall back to PackageId::name()\\\"\\n    );\\n}\\n\\n/// AC-007: same fallback, exercised for a PackageId::Bare target with no\\n/// registration, confirming the Bare variant is handled identically to the\\n/// Prefixed None-registration case in AC-003.\\n#[test]\\nfn test_bare_target_with_no_registration_falls_back_to_name_ac007() {\\n    let dep_target = PackageId::Bare(\\\"foo\\\".to_string());\\n    let dependent = PackageId::parse(\\\"pkg-app\\\").unwrap();\\n    let edge = make_dep_edge(&dependent, &dep_target, \\\"^1.0.0\\\", Ecosystem::Cargo);\\n\\n    let graph = TestGraph {\\n        packages: vec![bare_package(&dep_target), bare_package(&dependent)],\\n        edges: vec![edge],\\n    };\\n\\n    let mut base = BTreeMap::new();\\n    base.insert(dep_target.clone(), Version::semver(1, 0, 0));\\n    base.insert(dependent.clone(), Version::semver(1, 0, 0));\\n\\n    let mut seed = BTreeMap::new();\\n    seed.insert(dep_target.clone(), Severity::Major);\\n\\n    let groups = GroupTable::default();\\n    let cfg = CascadeConfig {\\n        mode: CascadeMode::OutOfRange,\\n        bump_severity: CascadeBumpSeverity::Patch,\\n        peer_escalation: true,\\n        preserve_npm_ranges: false,\\n    };\\n    let reasons = BTreeMap::new();\\n    let named_by = BTreeMap::new();\\n    let identity = IdentityIndex::default();\\n\\n    let input = CascadeInput {\\n        graph: &graph,\\n        groups: &groups,\\n        cfg: &cfg,\\n        seed: &seed,\\n        reasons: &reasons,\\n        named_by: &named_by,\\n        base: &base,\\n        pre: None,\\n        tags: &TagIndex::empty(),\\n        identity: &identity,\\n    };\\n\\n    let outcome = run_cascade(input).unwrap();\\n    let rewrite = outcome\\n        .rewrites\\n        .values()\\n        .find(|r| r.dependency == dep_target)\\n        .expect(\\\"rewrite for dep_target must be produced\\\");\\n\\n    assert_eq!(\\n        rewrite.key.name, \\\"foo\\\",\\n        \\\"Bare target with no IdentityIndex.native registration must fall back to edge.to.name()\\\"\\n    );\\n}\\n```\",","+        \"REGRESSION-INVARIANCE PROOF -- NO RED PHASE FOR THIS TASK, EXPECTED GREEN ON BOTH SIDES: the fallback behavior (`unwrap_or_else(|| edge.to.name().to_string())`) was already implemented in T3, so these two new tests are not proving a not-yet-built behavior -- they are pinning that T3's fix left the no-registration fallback path byte-identical to the pre-fix behavior. Do NOT treat a passing test before any code change as a broken test for this task specifically (the standard 'test must fail before implementation' rule does not apply here since there is no implementation step in this task). As an optional double-check only, you may temporarily revert T3's fix (replace `name: input.identity.native_name(&edge.to, eco).map(str::to_string).unwrap_or_else(|| edge.to.name().to_string()),` back to `name: edge.to.name().to_string(),` in an uncommitted working-tree edit) and confirm both tests still pass identically -- both expressions are mathematically equivalent when no native_name registration exists, so this reversion check should show no difference. Then restore T3's fix before committing.\",","+        \"Add these two test functions to crates/callisto-graph/src/cascade.rs's `#[cfg(test)] mod tests` block, immediately after `test_dual_identity_rewrite_key_uses_dependents_ecosystem_native_name` (added in T3):\\n```rust\\n/// AC-003: when IdentityIndex::native_name(&target, dependent_eco) returns\\n/// None (the common, non-dual-identity case), RewriteKey.name must equal\\n/// PackageId::name() exactly as it did before this fix, for a Prefixed\\n/// target with no registration.\\n#[test]\\nfn test_none_registration_fallback_uses_package_id_name_ac003() {\\n    let dep_target = PackageId::parse(\\\"pkg-core\\\").unwrap();\\n    let dependent = PackageId::parse(\\\"pkg-app\\\").unwrap();\\n    let edge = make_dep_edge(&dependent, &dep_target, \\\"^1.0.0\\\", Ecosystem::Cargo);\\n\\n    let graph = TestGraph {\\n        packages: vec![bare_package(&dep_target), bare_package(&dependent)],\\n        edges: vec![edge],\\n    };\\n\\n    let mut base = BTreeMap::new();\\n    base.insert(dep_target.clone(), Version::semver(1, 0, 0));\\n    base.insert(dependent.clone(), Version::semver(1, 0, 0));\\n\\n    let mut seed = BTreeMap::new();\\n    seed.insert(dep_target.clone(), Severity::Major);\\n\\n    let groups = GroupTable::default();\\n    let cfg = CascadeConfig {\\n        mode: CascadeMode::OutOfRange,\\n        bump_severity: CascadeBumpSeverity::Patch,\\n        peer_escalation: true,\\n        preserve_npm_ranges: false,\\n    };\\n    let reasons = BTreeMap::new();\\n    let named_by = BTreeMap::new();\\n    let identity = IdentityIndex::default();\\n\\n    let input = CascadeInput {\\n        graph: &graph,\\n        groups: &groups,\\n        cfg: &cfg,\\n        seed: &seed,\\n        reasons: &reasons,\\n        named_by: &named_by,\\n        base: &base,\\n        pre: None,\\n        tags: &TagIndex::empty(),\\n        identity: &identity,\\n    };\\n\\n    let outcome = run_cascade(input).unwrap();\\n    let rewrite = outcome\\n        .rewrites\\n        .values()\\n        .find(|r| r.dependency == dep_target)\\n        .expect(\\\"rewrite for dep_target must be produced\\\");\\n\\n    assert_eq!(\\n        rewrite.key.name,\\n        dep_target.name(),\\n        \\\"with no IdentityIndex.native registration, RewriteKey.name must fall back to PackageId::name()\\\"\\n    );\\n}\\n\\n/// AC-007: same fallback, exercised for a PackageId::Bare target with no\\n/// registration, confirming the Bare variant is handled identically to the\\n/// Prefixed None-registration case in AC-003.\\n#[test]\\nfn test_bare_target_with_no_registration_falls_back_to_name_ac007() {\\n    let dep_target = PackageId::Bare(\\\"foo\\\".to_string());\\n    let dependent = PackageId::parse(\\\"pkg-app\\\").unwrap();\\n    let edge = make_dep_edge(&dependent, &dep_target, \\\"^1.0.0\\\", Ecosystem::Cargo);\\n\\n    let graph = TestGraph {\\n        packages: vec![bare_package(&dep_target), bare_package(&dependent)],\\n        edges: vec![edge],\\n    };\\n\\n    let mut base = BTreeMap::new();\\n    base.insert(dep_target.clone(), Version::semver(1, 0, 0));\\n    base.insert(dependent.clone(), Version::semver(1, 0, 0));\\n\\n    let mut seed = BTreeMap::new();\\n    seed.insert(dep_target.clone(), Severity::Major);\\n\\n    let groups = GroupTable::default();\\n    let cfg = CascadeConfig {\\n        mode: CascadeMode::OutOfRange,\\n        bump_severity: CascadeBumpSeverity::Patch,\\n        peer_escalation: true,\\n        preserve_npm_ranges: false,\\n    };\\n    let reasons = BTreeMap::new();\\n    let named_by = BTreeMap::new();\\n    let identity = IdentityIndex::default();\\n\\n    let input = CascadeInput {\\n        graph: &graph,\\n        groups: &groups,\\n        cfg: &cfg,\\n        seed: &seed,\\n        reasons: &reasons,\\n        named_by: &named_by,\\n        base: &base,\\n        pre: None,\\n        tags: &TagIndex::empty(),\\n        identity: &identity,\\n    };\\n\\n    let outcome = run_cascade(input).unwrap();\\n    let rewrite = outcome\\n        .rewrites\\n        .values()\\n        .find(|r| r.dependency == dep_target)\\n        .expect(\\\"rewrite for dep_target must be produced\\\");\\n\\n    assert_eq!(\\n        rewrite.key.name, \\\"foo\\\",\\n        \\\"Bare target with no IdentityIndex.native registration must fall back to edge.to.name()\\\"\\n    );\\n}\\n```\",","         \"Run (with the T3 fix still reverted): `cargo test -p callisto-graph --lib cascade::tests::test_none_registration_fallback_uses_package_id_name_ac003 cascade::tests::test_bare_target_with_no_registration_falls_back_to_name_ac007`. Expected: both pass even with the fix reverted, confirming these two tests genuinely exercise only the untouched fallback path (this is the expected, documented outcome for a regression-invariance probe, not a false-positive test).\",","         \"Restore T3's fix: replace the reverted `name: edge.to.name().to_string(),` expression back to the corrected expression from T3:\\n```rust\\n                                name: input\\n                                    .identity\\n                                    .native_name(&edge.to, eco)\\n                                    .map(str::to_string)\\n                                    .unwrap_or_else(|| edge.to.name().to_string()),\\n```\",","         \"Run: `cargo test -p callisto-graph --lib cascade::tests::test_none_registration_fallback_uses_package_id_name_ac003 cascade::tests::test_bare_target_with_no_registration_falls_back_to_name_ac007 cascade::tests::test_dual_identity_rewrite_key_uses_dependents_ecosystem_native_name`. Expected: all 3 pass (3 passed; 0 failed).\""]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"e0fed798-9bc0-40d6-be81-b4da6b92194d","session_id":"bb531e8d-c394-4e47-a8ae-e4a9ceeca6d2","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.233","gitBranch":"main","slug":"shimmying-giggling-hickey"}
