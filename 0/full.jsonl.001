tput_tokens\":16000}); text(r.output);\n\n","type":"input_text"},{"text":"\n[78] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\n[package]\nname = \"callisto-graph\"\nversion = \"0.7.2\"\nedition.workspace = true\nlicense = \"AGPL-3.0-only\"\ndescription = \"Callisto Release Engine — Dependency DAG solver and topological cascade release planner.\"\nrepository.workspace = true\nreadme = \"README.md\"\n\n[lints]\nworkspace = true\n\n[features]\ndefault = [\"cargo\", \"npm\"]\ncargo = [\"callisto-manifests/cargo\"]\nnpm = [\"callisto-manifests/npm\"]\ninference = [\"dep:callisto-conventional\"]\n\n[dependencies]\ntempfile = { workspace = true }\ncallisto-model = { path = \"../callisto-model\", version = \"0.7.0\" }\ncallisto-vcs = { path = \"../callisto-vcs\", version = \"0.7.0\" }\ncallisto-manifests = { path = \"../callisto-manifests\", version = \"0.7.0\" }\ncallisto-format = { path = \"../callisto-format\", version = \"0.7.0\" }\ncallisto-changelog = { path = \"../callisto-changelog\", version = \"0.7.0\" }\ncallisto-conventional = { path = \"../callisto-conventional\", version = \"0.7.0\", optional = true }\ndunce = { workspace = true }\nignore = { workspace = true }\ntoml = { workspace = true }\ntoml_edit = { workspace = true }\nserde = { workspace = true }\nserde_json = { workspace = true, features = [\"preserve_order\"] }\nglobset = { workspace = true }\nyaml-rust2 = { workspace = true }\nthiserror = { workspace = true }\nmiette = { workspace = true }\nindexmap = { workspace = true }\npetgraph = { workspace = true }\nurl = { workspace = true }\n\n[dev-dependencies]\ncallisto-model = { path = \"../callisto-model\", features = [\"test-util\"] }\ncallisto-fixtures = { path = \"../callisto-fixtures\" }\ntempfile = { workspace = true }\nrstest.workspace = true\ninsta.workspace = true\nserial_test.workspace = true\ncrates/callisto-moon/Cargo.toml:116:tempfile = { workspace = true }\ncrates/callisto-manifests/Cargo.toml:35:tempfile.workspace = true\ncrates/callisto-model/Cargo.toml:29:tempfile.workspace = true\ncrates/callisto-vcs/Cargo.toml:27:tempfile = { workspace = true }\ncrates/callisto-fixtures/Cargo.toml:17:tempfile = { workspace = true }\ncrates/callisto-graph/Cargo.toml:20:tempfile = { workspace = true }\ncrates/callisto-graph/Cargo.toml:44:tempfile = { workspace = true }\nCargo.toml:32:tempfile = \"3\"\ncrates/callisto-cli/Cargo.toml:46:tempfile = { workspace = true }\ncrates/callisto-cli/Cargo.toml:50:tempfile = { workspace = true }\ncrates/callisto-changelog/Cargo.toml:17:tempfile = { workspace = true }\ncrates/callisto-conventional/Cargo.toml:21:tempfile.workspace = true\ncrates/callisto-model/src/exec.rs:66:    fn run_with_stdin(\ncrates/callisto-graph/src/commands/release.rs:1620:        fn run_with_stdin(\ncrates/callisto-graph/src/commands/release_decision.rs:581:    let output = runner.run_with_stdin(\"git\", \u0026BATCH_ARGS, root, stdin.as_bytes())?;\ncrates/callisto-graph/src/commands/release_decision.rs:1037:        fn run_with_stdin(\ncrates/callisto-graph/src/commands/release_observation.rs:908:        .run_quiet(\"curl\", \u0026args, root, OBSERVATION_TIMEOUT)\n\n","type":"input_text"},{"text":"\n[79] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n '^tar|flate2|async-compression' Cargo.toml crates/*/Cargo.toml Cargo.lock | head -40 \u0026\u0026 rtk rg -n \\\"crate.*metadata|CrateMetadata|dependencies.*features\\\" crates/callisto-* -g '*.rs' | head -100\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":12000}); text(r.output);\n\n","type":"input_text"},{"text":"\n[80] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\nCargo.lock:1884:name = \"flate2\"\nCargo.lock:6571: \"flate2\",\nCargo.lock:7463: \"flate2\",\nCargo.lock:8859: \"flate2\",\n\n","type":"input_text"},{"text":"\n[81] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n '^name = \\\"tar\\\"|^name = \\\"fla