{"parentUuid":"9d6fb998-eb32-4f38-9260-ad4f1ebe27d9","isSidechain":false,"promptId":"ef104ad3-6fa5-4537-a098-be1c6f44b9c4","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FZuFQPe6qx7QEhKcLqozLB","type":"tool_result","content":"name: 'Callisto Validate Action'\ndescription: 'Validates pending changesets, package discovery, configuration health, and release plan DAG'\n\nruns:\n  using: 'composite'\n  steps:\n    - name: Setup Callisto Environment\n      uses: ./.github/actions/setup-callisto\n\n    - name: Validate Configuration, Package Discovery & Changesets\n      shell: bash\n      env:\n        FORCE_COLOR: \"1\"\n        CLICOLOR_FORCE: \"1\"\n      run: callisto validate\n\n    - name: Pre-Flight Release Plan Simulation (DAG Pre-Check)\n      shell: bash\n      env:\n        FORCE_COLOR: \"1\"\n        CLICOLOR_FORCE: \"1\"\n      run: |\n        echo \"::group::Simulating Release Publish Plan\"\n        callisto plan-publish --format text || true\n        echo \"::endgroup::\"\n\n    - name: Render PR Release Pre-Flight Summary\n      shell: bash\n      env:\n        FORCE_COLOR: \"1\"\n        CLICOLOR_FORCE: \"1\"\n      run: |\n        echo \"### Callisto Release Pre-Flight Verification\" >> $GITHUB_STEP_SUMMARY\n        echo \"- **Package Discovery**: All workspace crates and packages are correctly tracked.\" >> $GITHUB_STEP_SUMMARY\n        echo \"- **Configuration Health**: \\`callisto.toml\\` schema and rules are valid.\" >> $GITHUB_STEP_SUMMARY\n        echo \"- **Changeset Integrity**: Pending changesets are valid.\" >> $GITHUB_STEP_SUMMARY\n        echo \"\" >> $GITHUB_STEP_SUMMARY\n        echo \"#### Workspace Package Status\" >> $GITHUB_STEP_SUMMARY\n        echo '```' >> $GITHUB_STEP_SUMMARY\n        callisto status >> $GITHUB_STEP_SUMMARY\n        echo '```' >> $GITHUB_STEP_SUMMARY","is_error":false}]},"uuid":"5f2c8517-d689-400f-8e57-6b298342158b","timestamp":"2026-08-21T18:52:51.098Z","toolUseResult":{"stdout":"name: '