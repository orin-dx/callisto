{"parentUuid":"e19560d2-4e86-42dc-8e0a-980e3d6733cf","isSidechain":false,"message":{"model":"claude-sonnet-5","id":"msg_011CeH4xuHL9KZ3E8WaMUWuq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JFnhgX7RUnvATwDNrQD7oa","name":"Read","input":{"file_path":"/Users/gabe/Projects/callisto/crates/callisto-changelog/src/write.rs"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":479,"cache_read_input_tokens":370420,"output_tokens":120,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":479,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":120,"cache_read_input_tokens":370420,"cache_creation_input_tokens":479,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":479},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CeH4xsxxS6SxtPn12R3Zz","type":"assistant","uuid":"2d55abda-93e7-493a-a472-210d9fbdae74","timestamp":"2026-08-22T03:22:28.588Z","effort":"high","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
{"parentUuid":"2d55abda-93e7-493a-a472-210d9fbdae74","isSidechain":false,"promptId":"f33ed927-5970-4ad9-b678-041679a8cd99","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JFnhgX7RUnvATwDNrQD7oa","type":"tool_result","content":"1\tuse std::fs;\n2\tuse std::path::Path;\n3\t\n4\tuse callisto_model::{ApplyPermit, Version};\n5\t\n6\tuse crate::ChangelogError;\n7\t\n8\t/// Prepend a rendered changelog entry for `display_name` to the changelog file\n9\t/// at `changelog_path` (relative to `root`).\n10\t///\n11\t/// # Concurrency\n12\t///\n13\t/// This function is **not safe for concurrent calls on the same `path`**. It\n14\t/// reads the existing file contents and then writes atomically, but a second\n15\t/// concurrent call for the same changelog file would read stale content between\n16\t/// those two points. Callers must ensure sequential access per changelog file.\n17\t/// If the codebase ever moves to parallel `apply`, add a per-path lock or\n18\t/// channel before removing this note.\n19\tpub fn prepend(\n20\t    root: &Path,\n21\t    changelog_path: &Path,\n22\t    display_name: &str,\n23\t    rendered: &str,\n24\t    permit: &ApplyPermit,\n25\t) -> Result<(), ChangelogError> {\n26\t    let full_path = root.join(changelog_path);\n27\t    if let Some(parent) = full_path.parent() {\n28\t        fs::create_dir_all(parent).map_err(|e| ChangelogError::WriteFailed {\n29\t            path: changelog_path.to_path_buf(),\n30\t            message: e.to_string(),\n31\t        })?;\n32\t    }\n33\t\n34\t    let existing = if full_path.exists() {\n35\t        fs::read_to_string(&full_path).map_err(|e| ChangelogError::ReadFailed {\n36\t            path: changelog_path.to_path_buf(),\n37\t            message: e.to_string(),\n38\t        })?\n39\t    } else {\n40\t        format!(\"# {display_name}\\n\\n\")\n41\t    };\n42\t\n43\t    // Normalise CRLF → LF so the prefix patterns always match, then restore\n44\t    // the original line endings on the way out if the file used CRLF.\n45\t    let had_crlf = existing.contains(\"\\r\\n\");\n46\t    let normalised = if had_crlf {\n47\t        existing.replace(\"\\r\\n\", \"\\n\")\n48\t    } else {\n49\t        existing.clone()\n50\t    };\n51\t\n52\t    // Bug 8 guard: if the version heading we are about to insert already exists\n53\t    // in the file, skip the write entirely (idempotent behaviour). The heading\n54\t    // is the first line of `rendered` (e.g. \"## 1.0.0\").\n55\t    let version_heading = rendered.lines().next().unwrap_or(\"\").trim();\n56\t    if !version_heading.is_empty() && normalised.lines().any(|l| l.trim() == version_heading) {\n57\t        return Ok(());\n58\t    }\n59\t\n60\t    let mut new_content = String::new();\n61\t    if let Some(rest) = normalised.strip_prefix(&format!(\"# {display_name}\\n\\n\")) {\n62\t        new_content.push_str(&format!(\"# {display_name}\\n\\n\"));\n63\t        new_content.push_str(rendered);\n64\t        if !rendered.ends_with('\\n') {\n65\t            new_content.push('\\n');\n66\t        }\n67\t        new_content.push('\\n');\n68\t        new_content.push_str(rest);\n69\t    } else if let Some(rest) = normalised.strip_prefix(&format!(\"# {display_name}\\n\")) {\n70\t        new_content.push_str(&format!(\"# {display_name}\\n\\n\"));\n71\t        new_content.push_str(rendered);\n72\t        if !rendered.ends_with('\\n') {\n73\t            new_content.push('\\n');\n74\t        }\n75\t        new_content.push('\\n');\n76\t        new_content.push_str(rest);\n77\t    } else {\n78\t        // The existing header didn't match display_name (e.g. casing change,\n79\t        // HTML anchor, or package rename). Always emit the correct H1 first so\n80\t        // the output is well-formed: H1 → new entry → existing body.\n81\t        new_content.push_str(&format!(\"# {display_name}\\n\\n\"));\n82\t        new_content.push_str(rendered);\n83\t        if !rendered.ends_with('\\n') {\n84\t            new_content.push('\\n');\n85\t        }\n86\t        new_content.push('\\n');\n87\t        new_content.push_str(&normalised);\n88\t    }\n89\t\n90\t    if had_crlf {\n91\t        new_content = new_content.replace('\\n', \"\\r\\n\");\n92\t    }\n93\t\n94\t    callisto_model::atomic::atomic_write(&full_path, &new_content, permit).map_err(|e| {\n95\t        ChangelogError::WriteFailed {\n96\t            path: changelog_path.to_path_buf(),\n97\t            message: e.to_string(),\n98\t        }\n99\t    })\n100\t}\n101\t\n102\tpub fn extract_section<'a>(changelog: &'a str, version: &Version) -> Option<&'a str> {\n103\t    let target_heading = format!(\"## {}\", version.render());\n104\t    let mut start_byte = None;\n105\t\n106\t    let mut offset = 0;\n107\t    for line in changelog.split_inclusive('\\n') {\n108\t        let trimmed = line.trim_end();\n109\t        if trimmed == target_heading {\n110\t            start_byte = Some(offset + line.len());\n111\t            break;\n112\t        }\n113\t        offset += line.len();\n114\t    }\n115\t\n116\t    let start = start_byte?;\n117\t    let slice_after = &changelog[start.min(changelog.len())..];\n118\t\n119\t    let mut end = slice_after.len();\n120\t    let mut line_offset = 0;\n121\t\n122\t    for line in slice_after.split_inclusive('\\n') {\n123\t        let trimmed = line.trim_start();\n124\t        if line_offset > 0 && (trimmed.starts_with(\"## \") || trimmed.starts_with(\"# \")) {\n125\t            end = line_offset;\n126\t            break;\n127\t        }\n128\t        line_offset += line.len();\n129\t    }\n130\t\n131\t    let raw_section = slice_after[..end.min(slice_after.len())].trim();\n132\t    if raw_section.is_empty() {\n133\t        None\n134\t    } else {\n135\t        Some(raw_section)\n136\t    }\n137\t}\n138\t\n139\t#[cfg(test)]\n140\tmod tests {\n141\t\n142\t    /// Tests exercise the write primitives directly rather than through a\n143\t    /// command handler, so they mint a permit without a dry-run flag to\n144\t    /// consult. Every non-test caller must go through\n145\t    /// `ApplyPermit::granted_unless_dry_run`.\n146\t    fn permit() -> callisto_model::ApplyPermit {\n147\t        callisto_model::ApplyPermit::force_for_tests()\n148\t    }\n149\t    use super::*;\n150\t    use callisto_model::VersionGrammar;\n151\t\n152\t    #[test]\n153\t    fn extracts_rendered_section() {\n154\t        let changelog = r#\"# my-pkg\n155\t\n156\t## 1.1.0\n157\t\n158\t### Minor Changes\n159\t\n160\t- Add cool feature\n161\t\n162\t## 1.0.0\n163\t\n164\t### Patch Changes\n165\t\n166\t- Initial release\n167\t\"#;\n168\t        let v1_1 = Version::parse(\"1.1.0\", VersionGrammar::SemVer).unwrap();\n169\t        let extracted = extract_section(changelog, &v1_1).unwrap();\n170\t        assert!(extracted.contains(\"### Minor Changes\"));\n171\t        assert!(extracted.contains(\"- Add cool feature\"));\n172\t        assert!(!extracted.contains(\"## 1.0.0\"));\n173\t    }\n174\t\n175\t    #[test]\n176\t    fn extracts_crlf_changelog_section() {\n177\t        let changelog = \"# my-pkg\\r\\n\\r\\n## 1.1.0\\r\\n\\r\\n### Minor Changes\\r\\n\\r\\n- Feature\\r\\n\\r\\n## 1.0.0\\r\\n\";\n178\t        let v1_1 = Version::parse(\"1.1.0\", VersionGrammar::SemVer).unwrap();\n179\t        let extracted = extract_section(changelog, &v1_1).unwrap();\n180\t        assert!(extracted.contains(\"### Minor Changes\"));\n181\t        assert!(extracted.contains(\"- Feature\"));\n182\t    }\n183\t\n184\t    /// Regression test for the drifted local `atomic_write` that only synced the\n185\t    /// parent directory. `prepend()` unconditionally calls `create_dir_all` for\n186\t    /// the changelog's parent, so when both the parent *and* grandparent\n187\t    /// directories are freshly created as part of the same operation, durability\n188\t    /// requires fsyncing both new directory entries — exactly what the canonical\n189\t    /// `callisto_model::atomic::atomic_write` does and the local copy did not.\n190\t    ///\n191\t    /// This test doesn't simulate a crash (that would require fault injection at\n192\t    /// the syscall level), but it does exercise `prepend()` through a freshly\n193\t    /// created two-level-deep directory tree end-to-end, proving the write path\n194\t    /// now routes through the shared implementation rather than a local\n195\t    /// duplicate that silently drops the grandparent sync.\n196\t    #[test]\n197\t    fn prepend_does_not_displace_header_in_crlf_changelog() {\n198\t        let workspace = tempfile::tempdir().unwrap();\n199\t        let root = workspace.path();\n200\t        let changelog_path = std::path::Path::new(\"CHANGELOG.md\");\n201\t        let full_path = root.join(changelog_path);\n202\t\n203\t        // Write an existing CRLF changelog.\n204\t        let existing_crlf = \"# My Package\\r\\n\\r\\n## 1.0.0\\r\\n\\r\\nSome content\\r\\n\";\n205\t        fs::write(&full_path, existing_crlf).unwrap();\n206\t\n207\t        prepend(\n208\t            root,\n209\t            changelog_path,\n210\t            \"My Package\",\n211\t            \"## 1.1.0\\n\\nNew stuff\\n\",\n212\t            &permit(),\n213\t        )\n214\t        .expect(\"prepend should succeed on a CRLF changelog\");\n215\t\n216\t        let result = fs::read_to_string(&full_path).unwrap();\n217\t\n218\t        // The header must remain the very first thing in the file.\n219\t        assert!(\n220\t            result.starts_with(\"# My Package\"),\n221\t            \"header was displaced — got:\\n{result}\"\n222\t        );\n223\t\n224\t        // The new section must appear before the old section.\n225\t        let pos_new = result.find(\"1.1.0\").expect(\"new version missing\");\n226\t        let pos_old = result.find(\"1.0.0\").expect(\"old version missing\");\n227\t        assert!(\n228\t            pos_new < pos_old,\n229\t            \"new entry should precede old entry — got:\\n{result}\"\n230\t        );\n231\t    }\n232\t\n233\t    #[test]\n234\t    fn prepend_else_branch_inserts_h1_header_before_new_entry_when_display_name_mismatches() {\n235\t        // The existing changelog uses \"old-name\" as the H1. prepend() is called\n236\t        // with display_name = \"new-name\", so neither strip_prefix pattern matches\n237\t        // and the else branch fires. Before the fix, the else branch emits the\n238\t        // rendered entry (an H2) first, leaving the H1 buried below it.\n239\t        let workspace = tempfile::tempdir().unwrap();\n240\t        let root = workspace.path();\n241\t        let changelog_path = std::path::Path::new(\"CHANGELOG.md\");\n242\t        let full_path = root.join(changelog_path);\n243\t\n244\t        let existing = \"# old-name\\n\\n## 1.0.0\\n\\nOld stuff\\n\";\n245\t        fs::write(&full_path, existing).unwrap();\n246\t\n247\t        prepend(\n248\t            root,\n249\t            changelog_path,\n250\t            \"new-name\",\n251\t            \"## 2.0.0\\n\\n### Patch Changes\\n\\n- Something\\n\",\n252\t            &permit(),\n253\t        )\n254\t        .expect(\"prepend should succeed\");\n255\t\n256\t        let result = fs::read_to_string(&full_path).unwrap();\n257\t\n258\t        assert!(\n259\t            result.starts_with(\"# new-name\\n\\n\"),\n260\t            \"result should start with H1 heading, got:\\n{result}\"\n261\t        );\n262\t        assert!(\n263\t            !result.starts_with(\"## 2.0.0\"),\n264\t            \"result must not start with H2 (no H1 at top), got:\\n{result}\"\n265\t        );\n266\t        let pos_new = result\n267\t            .find(\"## 2.0.0\")\n268\t            .expect(\"new version heading missing\");\n269\t        let pos_old = result\n270\t            .find(\"## 1.0.0\")\n271\t            .expect(\"old version heading missing\");\n272\t        assert!(\n273\t            pos_new < pos_old,\n274\t            \"new entry should precede old entry — got:\\n{result}\"\n275\t        );\n276\t    }\n277\t\n278\t    #[test]\n279\t    fn prepend_is_idempotent_for_same_version() {\n280\t        // If the existing changelog already contains the version heading being\n281\t        // inserted, prepend() should return the existing content unchanged\n282\t        // rather than duplicating the section.\n283\t        let workspace = tempfile::tempdir().unwrap();\n284\t        let root = workspace.path();\n285\t        let changelog_path = std::path::Path::new(\"CHANGELOG.md\");\n286\t        let full_path = root.join(changelog_path);\n287\t\n288\t        let existing = \"# my-pkg\\n\\n## 1.0.0\\n\\nSome content\\n\";\n289\t        fs::write(&full_path, existing).unwrap();\n290\t\n291\t        prepend(\n292\t            root,\n293\t            changelog_path,\n294\t            \"my-pkg\",\n295\t            \"## 1.0.0\\n\\nNew content\\n\",\n296\t            &permit(),\n297\t        )\n298\t        .expect(\"prepend should succeed\");\n299\t\n300\t        let result = fs::read_to_string(&full_path).unwrap();\n301\t\n302\t        let occurrences = result.matches(\"## 1.0.0\").count();\n303\t        assert_eq!(\n304\t            occurrences, 1,\n305\t            \"## 1.0.0 should appear exactly once, got {occurrences} times in:\\n{result}\"\n306\t        );\n307\t        assert!(\n308\t            result.contains(\"Some content\"),\n309\t            \"existing content should be preserved — got:\\n{result}\"\n310\t        );\n311\t    }\n312\t\n313\t    #[test]\n314\t    fn test_prepend_stable_after_prerelease_not_suppressed() {\n315\t        // CORR-001: \"## 1.0.0\" must not be suppressed by the idempotency guard\n316\t        // when the file already contains \"## 1.0.0-alpha.1\", because the stable\n317\t        // version string is a substring of the pre-release heading.\n318\t        let workspace = tempfile::tempdir().unwrap();\n319\t        let root = workspace.path();\n320\t        let changelog_path = std::path::Path::new(\"CHANGELOG.md\");\n321\t        let full_path = root.join(changelog_path);\n322\t\n323\t        let existing = \"## 1.0.0-alpha.1\\n\\n- alpha change\\n\";\n324\t        fs::write(&full_path, existing).unwrap();\n325\t\n326\t        prepend(\n327\t            root,\n328\t            changelog_path,\n329\t            \"my-pkg\",\n330\t            \"## 1.0.0\\n\\n### Patch Changes\\n\\n- Stable release\\n\",\n331\t            &permit(),\n332\t        )\n333\t        .expect(\"prepend should succeed\");\n334\t\n335\t        let result = fs::read_to_string(&full_path).unwrap();\n336\t\n337\t        // The stable heading must appear as a standalone line, not just as\n338\t        // a substring match that could fire on \"## 1.0.0-alpha.1\".\n339\t        assert!(\n340\t            result.lines().any(|l| l.trim() == \"## 1.0.0\"),\n341\t            \"stable heading '## 1.0.0' must appear as its own line; got:\\n{result}\"\n342\t        );\n343\t        // The pre-release heading must still be present.\n344\t        assert!(\n345\t            result.contains(\"## 1.0.0-alpha.1\"),\n346\t            \"pre-release heading must still be present; got:\\n{result}\"\n347\t        );\n348\t    }\n349\t\n350\t    #[test]\n351\t    fn prepend_creates_nested_grandparent_and_parent_dirs_via_shared_atomic_write() {\n352\t        let workspace = tempfile::tempdir().unwrap();\n353\t        let root = workspace.path();\n354\t\n355\t        // Neither \"packages\" (grandparent) nor \"packages/my-pkg\" (parent) exist yet.\n356\t        let changelog_path = std::path::Path::new(\"packages/my-pkg/CHANGELOG.md\");\n357\t        assert!(!root.join(\"packages\").exists());\n358\t\n359\t        prepend(\n360\t            root,\n361\t            changelog_path,\n362\t            \"my-pkg\",\n363\t            \"### Patch Changes\\n\\n- Fix bug\",\n364\t            &permit(),\n365\t        )\n366\t        .expect(\"prepend should create nested dirs and write durably\");\n367\t\n368\t        let full_path = root.join(changelog_path);\n369\t        assert!(full_path.exists());\n370\t        let contents = fs::read_to_string(&full_path).unwrap();\n371\t        assert!(contents.starts_with(\"# my-pkg\\n\\n\"));\n372\t        assert!(contents.contains(\"- Fix bug\"));\n373\t\n374\t        // No leftover temp files from the shared NamedTempFile-based atomic_write.\n375\t        let parent_entries: Vec<_> = fs::read_dir(full_path.parent().unwrap())\n376\t            .unwrap()\n377\t            .map(|e| e.unwrap().file_name())\n378\t            .collect();\n379\t        assert_eq!(\n380\t            parent_entries,\n381\t            vec![std::ffi::OsString::from(\"CHANGELOG.md\")]\n382\t        );\n383\t    }\n384\t}\n385\t"}]},"uuid":"dfa0d91d-03a6-458e-93e2-af4524370890","timestamp":"2026-08-22T03:22:28.666Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/crates/callisto-changelog/src/write.rs","content":"use std::fs;\nuse std::path::Path;\n\nuse callisto_model::{ApplyPermit, Version};\n\nuse crate::ChangelogError;\n\n/// Prepend a rendered changelog entry for `display_name` to the changelog file\n/// at `changelog_path` (relative to `root`).\n///\n/// # Concurrency\n///\n/// This function is **not safe for concurrent calls on the same `path`**. It\n/// reads the existing file contents and then writes atomically, but a second\n/// concurrent call for the same changelog file would read stale content between\n/// those two points. Callers must ensure sequential access per changelog file.\n/// If the codebase ever moves to parallel `apply`, add a per-path lock or\n/// channel before removing this note.\npub fn prepend(\n    root: &Path,\n    changelog_path: &Path,\n    display_name: &str,\n    rendered: &str,\n    permit: &ApplyPermit,\n) -> Result<(), ChangelogError> {\n    let full_path = root.join(changelog_path);\n    if let Some(parent) = full_path.parent() {\n        fs::create_dir_all(parent).map_err(|e| ChangelogError::WriteFailed {\n            path: changelog_path.to_path_buf(),\n            message: e.to_string(),\n        })?;\n    }\n\n    let existing = if full_path.exists() {\n        fs::read_to_string(&full_path).map_err(|e| ChangelogError::ReadFailed {\n            path: changelog_path.to_path_buf(),\n            message: e.to_string(),\n        })?\n    } else {\n        format!(\"# {display_name}\\n\\n\")\n    };\n\n    // Normalise CRLF → LF so the prefix patterns always match, then restore\n    // the original line endings on the way out if the file used CRLF.\n    let had_crlf = existing.contains(\"\\r\\n\");\n    let normalised = if had_crlf {\n        existing.replace(\"\\r\\n\", \"\\n\")\n    } else {\n        existing.clone()\n    };\n\n    // Bug 8 guard: if the version heading we are about to insert already exists\n    // in the file, skip the write entirely (idempotent behaviour). The heading\n    // is the first line of `rendered` (e.g. \"## 1.0.0\").\n    let version_heading = rendered.lines().next().unwrap_or(\"\").trim();\n    if !version_heading.is_empty() && normalised.lines().any(|l| l.trim() == version_heading) {\n        return Ok(());\n    }\n\n    let mut new_content = String::new();\n    if let Some(rest) = normalised.strip_prefix(&format!(\"# {display_name}\\n\\n\")) {\n        new_content.push_str(&format!(\"# {display_name}\\n\\n\"));\n        new_content.push_str(rendered);\n        if !rendered.ends_with('\\n') {\n            new_content.push('\\n');\n        }\n        new_content.push('\\n');\n        new_content.push_str(rest);\n    } else if let Some(rest) = normalised.strip_prefix(&format!(\"# {display_name}\\n\")) {\n        new_content.push_str(&format!(\"# {display_name}\\n\\n\"));\n        new_content.push_str(rendered);\n        if !rendered.ends_with('\\n') {\n            new_content.push('\\n');\n        }\n        new_content.push('\\n');\n        new_content.push_str(rest);\n    } else {\n        // The existing header didn't match display_name (e.g. casing change,\n        // HTML anchor, or package rename). Always emit the correct H1 first so\n        // the output is well-formed: H1 → new entry → existing body.\n        new_content.push_str(&format!(\"# {display_name}\\n\\n\"));\n        new_content.push_str(rendered);\n        if !rendered.ends_with('\\n') {\n            new_content.push('\\n');\n        }\n        new_content.push('\\n');\n        new_content.push_str(&normalised);\n    }\n\n    if had_crlf {\n        new_content = new_content.replace('\\n', \"\\r\\n\");\n    }\n\n    callisto_model::atomic::atomic_write(&full_path, &new_content, permit).map_err(|e| {\n        ChangelogError::WriteFailed {\n            path: changelog_path.to_path_buf(),\n            message: e.to_string(),\n        }\n    })\n}\n\npub fn extract_section<'a>(changelog: &'a str, version: &Version) -> Option<&'a str> {\n    let target_heading = format!(\"## {}\", version.render());\n    let mut start_byte = None;\n\n    let mut offset = 0;\n    for line in changelog.split_inclusive('\\n') {\n        let trimmed = line.trim_end();\n        if trimmed == target_heading {\n            start_byte = Some(offset + line.len());\n            break;\n        }\n        offset += line.len();\n    }\n\n    let start = start_byte?;\n    let slice_after = &changelog[start.min(changelog.len())..];\n\n    let mut end = slice_after.len();\n    let mut line_offset = 0;\n\n    for line in slice_after.split_inclusive('\\n') {\n        let trimmed = line.trim_start();\n        if line_offset > 0 && (trimmed.starts_with(\"## \") || trimmed.starts_with(\"# \")) {\n            end = line_offset;\n            break;\n        }\n        line_offset += line.len();\n    }\n\n    let raw_section = slice_after[..end.min(slice_after.len())].trim();\n    if raw_section.is_empty() {\n        None\n    } else {\n        Some(raw_section)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n\n    /// Tests exercise the write primitives directly rather than through a\n    /// command handler, so they mint a permit without a dry-run flag to\n    /// consult. Every non-test caller must go through\n    /// `ApplyPermit::granted_unless_dry_run`.\n    fn permit() -> callisto_model::ApplyPermit {\n        callisto_model::ApplyPermit::force_for_tests()\n    }\n    use super::*;\n    use callisto_model::VersionGrammar;\n\n    #[test]\n    fn extracts_rendered_section() {\n        let changelog = r#\"# my-pkg\n\n## 1.1.0\n\n### Minor Changes\n\n- Add cool feature\n\n## 1.0.0\n\n### Patch Changes\n\n- Initial release\n\"#;\n        let v1_1 = Version::parse(\"1.1.0\", VersionGrammar::SemVer).unwrap();\n        let extracted = extract_section(changelog, &v1_1).unwrap();\n        assert!(extracted.contains(\"### Minor Changes\"));\n        assert!(extracted.contains(\"- Add cool feature\"));\n        assert!(!extracted.contains(\"## 1.0.0\"));\n    }\n\n    #[test]\n    fn extracts_crlf_changelog_section() {\n        let changelog = \"# my-pkg\\r\\n\\r\\n## 1.1.0\\r\\n\\r\\n### Minor Changes\\r\\n\\r\\n- Feature\\r\\n\\r\\n## 1.0.0\\r\\n\";\n        let v1_1 = Version::parse(\"1.1.0\", VersionGrammar::SemVer).unwrap();\n        let extracted = extract_section(changelog, &v1_1).unwrap();\n        assert!(extracted.contains(\"### Minor Changes\"));\n        assert!(extracted.contains(\"- Feature\"));\n    }\n\n    /// Regression test for the drifted local `atomic_write` that only synced the\n    /// parent directory. `prepend()` unconditionally calls `create_dir_all` for\n    /// the changelog's parent, so when both the parent *and* grandparent\n    /// directories are freshly created as part of the same operation, durability\n    /// requires fsyncing both new directory entries — exactly what the canonical\n    /// `callisto_model::atomic::atomic_write` does and the local copy did not.\n    ///\n    /// This test doesn't simulate a crash (that would require fault injection at\n    /// the syscall level), but it does exercise `prepend()` through a freshly\n    /// created two-level-deep directory tree end-to-end, proving the write path\n    /// now routes through the shared implementation rather than a local\n    /// duplicate that silently drops the grandparent sync.\n    #[test]\n    fn prepend_does_not_displace_header_in_crlf_changelog() {\n        let workspace = tempfile::tempdir().unwrap();\n        let root = workspace.path();\n        let changelog_path = std::path::Path::new(\"CHANGELOG.md\");\n        let full_path = root.join(changelog_path);\n\n        // Write an existing CRLF changelog.\n        let existing_crlf = \"# My Package\\r\\n\\r\\n## 1.0.0\\r\\n\\r\\nSome content\\r\\n\";\n        fs::write(&full_path, existing_crlf).unwrap();\n\n        prepend(\n            root,\n            changelog_path,\n            \"My Package\",\n            \"## 1.1.0\\n\\nNew stuff\\n\",\n            &permit(),\n        )\n        .expect(\"prepend should succeed on a CRLF changelog\");\n\n        let result = fs::read_to_string(&full_path).unwrap();\n\n        // The header must remain the very first thing in the file.\n        assert!(\n            result.starts_with(\"# My Package\"),\n            \"header was displaced — got:\\n{result}\"\n        );\n\n        // The new section must appear before the old section.\n        let pos_new = result.find(\"1.1.0\").expect(\"new version missing\");\n        let pos_old = result.find(\"1.0.0\").expect(\"old version missing\");\n        assert!(\n            pos_new < pos_old,\n            \"new entry should precede old entry — got:\\n{result}\"\n        );\n    }\n\n    #[test]\n    fn prepend_else_branch_inserts_h1_header_before_new_entry_when_display_name_mismatches() {\n        // The existing changelog uses \"old-name\" as the H1. prepend() is called\n        // with display_name = \"new-name\", so neither strip_prefix pattern matches\n        // and the else branch fires. Before the fix, the else branch emits the\n        // rendered entry (an H2) first, leaving the H1 buried below it.\n        let workspace = tempfile::tempdir().unwrap();\n        let root = workspace.path();\n        let changelog_path = std::path::Path::new(\"CHANGELOG.md\");\n        let full_path = root.join(changelog_path);\n\n        let existing = \"# old-name\\n\\n## 1.0.0\\n\\nOld stuff\\n\";\n        fs::write(&full_path, existing).unwrap();\n\n        prepend(\n            root,\n            changelog_path,\n            \"new-name\",\n            \"## 2.0.0\\n\\n### Patch Changes\\n\\n- Something\\n\",\n            &permit(),\n        )\n        .expect(\"prepend should succeed\");\n\n        let result = fs::read_to_string(&full_path).unwrap();\n\n        assert!(\n            result.starts_with(\"# new-name\\n\\n\"),\n            \"result should start with H1 heading, got:\\n{result}\"\n        );\n        assert!(\n            !result.starts_with(\"## 2.0.0\"),\n            \"result must not start with H2 (no H1 at top), got:\\n{result}\"\n        );\n        let pos_new = result\n            .find(\"## 2.0.0\")\n            .expect(\"new version heading missing\");\n        let pos_old = result\n            .find(\"## 1.0.0\")\n            .expect(\"old version heading missing\");\n        assert!(\n            pos_new < pos_old,\n            \"new entry should precede old entry — got:\\n{result}\"\n        );\n    }\n\n    #[test]\n    fn prepend_is_idempotent_for_same_version() {\n        // If the existing changelog already contains the version heading being\n        // inserted, prepend() should return the existing content unchanged\n        // rather than duplicating the section.\n        let workspace = tempfile::tempdir().unwrap();\n        let root = workspace.path();\n        let changelog_path = std::path::Path::new(\"CHANGELOG.md\");\n        let full_path = root.join(changelog_path);\n\n        let existing = \"# my-pkg\\n\\n## 1.0.0\\n\\nSome content\\n\";\n        fs::write(&full_path, existing).unwrap();\n\n        prepend(\n            root,\n            changelog_path,\n            \"my-pkg\",\n            \"## 1.0.0\\n\\nNew content\\n\",\n            &permit(),\n        )\n        .expect(\"prepend should succeed\");\n\n        let result = fs::read_to_string(&full_path).unwrap();\n\n        let occurrences = result.matches(\"## 1.0.0\").count();\n        assert_eq!(\n            occurrences, 1,\n            \"## 1.0.0 should appear exactly once, got {occurrences} times in:\\n{result}\"\n        );\n        assert!(\n            result.contains(\"Some content\"),\n            \"existing content should be preserved — got:\\n{result}\"\n        );\n    }\n\n    #[test]\n    fn test_prepend_stable_after_prerelease_not_suppressed() {\n        // CORR-001: \"## 1.0.0\" must not be suppressed by the idempotency guard\n        // when the file already contains \"## 1.0.0-alpha.1\", because the stable\n        // version string is a substring of the pre-release heading.\n        let workspace = tempfile::tempdir().unwrap();\n        let root = workspace.path();\n        let changelog_path = std::path::Path::new(\"CHANGELOG.md\");\n        let full_path = root.join(changelog_path);\n\n        let existing = \"## 1.0.0-alpha.1\\n\\n- alpha change\\n\";\n        fs::write(&full_path, existing).unwrap();\n\n        prepend(\n            root,\n            changelog_path,\n            \"my-pkg\",\n            \"## 1.0.0\\n\\n### Patch Changes\\n\\n- Stable release\\n\",\n            &permit(),\n        )\n        .expect(\"prepend should succeed\");\n\n        let result = fs::read_to_string(&full_path).unwrap();\n\n        // The stable heading must appear as a standalone line, not just as\n        // a substring match that could fire on \"## 1.0.0-alpha.1\".\n        assert!(\n            result.lines().any(|l| l.trim() == \"## 1.0.0\"),\n            \"stable heading '## 1.0.0' must appear as its own line; got:\\n{result}\"\n        );\n        // The pre-release heading must still be present.\n        assert!(\n            result.contains(\"## 1.0.0-alpha.1\"),\n            \"pre-release heading must still be present; got:\\n{result}\"\n        );\n    }\n\n    #[test]\n    fn prepend_creates_nested_grandparent_and_parent_dirs_via_shared_atomic_write() {\n        let workspace = tempfile::tempdir().unwrap();\n        let root = workspace.path();\n\n        // Neither \"packages\" (grandparent) nor \"packages/my-pkg\" (parent) exist yet.\n        let changelog_path = std::path::Path::new(\"packages/my-pkg/CHANGELOG.md\");\n        assert!(!root.join(\"packages\").exists());\n\n        prepend(\n            root,\n            changelog_path,\n            \"my-pkg\",\n            \"### Patch Changes\\n\\n- Fix bug\",\n            &permit(),\n        )\n        .expect(\"prepend should create nested dirs and write durably\");\n\n        let full_path = root.join(changelog_path);\n        assert!(full_path.exists());\n        let contents = fs::read_to_string(&full_path).unwrap();\n        assert!(contents.starts_with(\"# my-pkg\\n\\n\"));\n        assert!(contents.contains(\"- Fix bug\"));\n\n        // No leftover temp files from the shared NamedTempFile-based atomic_write.\n        let parent_entries: Vec<_> = fs::read_dir(full_path.parent().unwrap())\n            .unwrap()\n            .map(|e| e.unwrap().file_name())\n            .collect();\n        assert_eq!(\n            parent_entries,\n            vec![std::ffi::OsString::from(\"CHANGELOG.md\")]\n        );\n    }\n}\n","numLines":385,"startLine":1,"totalLines":385}},"sourceToolAssistantUUID":"2d55abda-93e7-493a-a472-210d9fbdae74","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
