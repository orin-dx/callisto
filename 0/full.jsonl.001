#[serde(rename_all = \\\"camelCase\\\")]\\n-    pub enum ReleaseOperationState {\\n-        Pending,\\n-        Attempting,\\n-        Published,\\n-        AlreadySatisfied,\\n-        Failed,\\n-        Blocked { reason: OperationBlockReason },\\n-    }\\n-\\n-    impl Serialize for ReleaseExecutionState {\\n-        fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>\\n-        where\\n-            S: Serializer,\\n-        {\\n-            ReleaseExecutionStateWire {\\n-                schema_version: self.schema_version,\\n-                intent_digest: self.intent_digest.clone(),\\n-                operations: self\\n-                    .operations\\n-                    .iter()\\n-                    .map(|(operation, state)| ReleaseOperationStateEntry {\\n-                        operation: operation.clone(),\\n-                        state: *state,\\n-                    })\\n-                    .collect(),\\n-            }\\n-            .serialize(serializer)\\n-        }\\n-    }\\n-\\n-    impl<'de> Deserialize<'de> for ReleaseExecutionState {\\n-        fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\\n-        where\\n-            D: Deserializer<'de>,\\n-        {\\n-            let wire = ReleaseExecutionStateWire::deserialize(deserializer)?;\\n-            Self::from_wire(wire).map_err(serde::de::Error::custom)\\n-        }\\n-    }\\n-\\n-    impl ReleaseExecutionState {\\n-        pub const SCHEMA_VERSION: u8 = 1;\\n-\\n-        pub fn pending(intent: &ReleaseIntent) -> Self {\\n-            Self {\\n-                schema_version: Self::SCHEMA_VERSION,\\n-                intent_digest: intent.digest.clone(),\\n-                operations: intent\\n-                    .operations\\n-                    .iter()\\n-                    .map(|operation| (operation.id.clone(), ReleaseOperationState::Pending))\\n-                    .collect(),\\n-            }\\n-        }\\n-\\n-        pub fn intent_digest(&self) -> &IntentDigest {\\n-            &self.intent_digest\\n-        }\\n-\\n-        pub fn operation_state(&self, id: &ReleaseOperationId) -> Option<ReleaseOperationState> {\\n-            self.operations.get(id).copied()\\n-        }\\n-\\n-        pub fn validate_for_intent(&self, intent: &ReleaseIntent) -> Result<(), ReleaseExecutionStateError> {\\n-            if self.schema_version != Self::SCHEMA_VERSION {\\n-                return Err(ReleaseExecutionStateError::UnsupportedSchema {\\n-                    found: self.schema_version,\\n-                });\\n-            }\\n-            if self.intent_digest != intent.digest {\\n-                return Err(ReleaseExecutionStateError::MismatchedIntent);\\n-            }\\n-            let expected = intent\\n-                .operations\\n-                .iter()\\n-                .map(|operation| operation.id.clone())\\n-                .collect::<BTreeSet<_>>();\\n-            let actual = self.operations.keys().cloned().collect::<BTreeSet<_>>();\\n-            if actual != expected {\\n-                return Err(ReleaseExecutionStateError::MismatchedOperationRoster);\\n-            }\\n-            Ok(())\\n-        }\\n-\\n-        pub fn mark_attempting(&mut self, id: &ReleaseOperationId) -> Result<(), ReleaseExecutionStateError> {\\n-            let state = self\\n-                .operations\\n-                .get_mut(id)\\n-                .ok_or_else(|| ReleaseExecutionStateError::UnknownOperation {\\n-                    id: Box::new(id.clone()),\\n-                })?;\\n-            if *state != ReleaseOperationState::Pending {\\n-                return Err(ReleaseExecutionStateError::InvalidTransition {\\n-                    id: Box::new(id.clone()),\\n-                    from: *state,\\n-                });\\n-            }\\n-            *state = ReleaseOperationState::Attempting;\\n-            Ok(())\\n-        }\\n-\\n-        pub fn mark_terminal(\\n-            &mut self,\\n-            id: &ReleaseOperationId,\\n-            outcome: OperationOutcome,\\n-        ) -> Result<(), ReleaseExecutionStateError> {\\n-            let state = self\\n-                .operations\\n-                .get_mut(id)\\n-                .ok_or_else(|| ReleaseExecutionStateError::UnknownOperation {\\n-                    id: Box::new(id.clone()),\\n-                })?;\\n-            if *state != ReleaseOperationState::Attempting {\\n-                return Err(ReleaseExecutionStateError::InvalidTransition {\\n-                    id: Box::new(id.clone()),\\n-                    from: *state,\\n-                });\\n-            }\\n-            *state = match outcome {\\n-                OperationOutcome::Published => ReleaseOperationState::Published,\\n-                OperationOutcome::AlreadySatisfied => ReleaseOperationState::AlreadySatisfied,\\n-                OperationOutcome::Failed => ReleaseOperationState::Failed,\\n-                OperationOutcome::Blocked { reason } => ReleaseOperationState::Blocked { reason },\\n-            };\\n-            Ok(())\\n-        }\\n-\\n-        fn from_wire(wire: ReleaseExecutionStateWire) -> Result<Self, ReleaseExecutionStateError> {\\n-            if wire.schema_version != Self::SCHEMA_VERSION {\\n-                return Err(ReleaseExecutionStateError::UnsupportedSchema {\\n-                    found: wire.schema_version,\\n-                });\\n-            }\\n-            let mut operations = BTreeMap::new();\\n-            for entry in wire.operations {\\n-                if operations.insert(entry.operation.clone(), entry.state).is_some() {\\n-                    return Err(ReleaseExecutionStateError::DuplicateOperation {\\n-                        id: Box::new(entry.operation),\\n-                    });\\n-                }\\n-            }\\n-            Ok(Self {\\n-                schema_version: wire.schema_version,\\n-                intent_digest: wire.intent_digest,\\n-                operations,\\n-            })\\n-        }\\n-    }\\n-\\n-    #[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]\\n-    #[non_exhaustive]\\n-    pub enum ReleaseExecutionStateError {\\n-        #[error(\\\"unsupported release execution state schema version {found}\\\")]\\n-        UnsupportedSchema { found: u8 },\\n-        #[error(\\\"release state is bound to a different intent\\\")]\\n-        MismatchedIntent,\\n-        #[error(\\\"release state operation roster differs from the bound intent\\\")]\\n-        MismatchedOperationRoster,\\n-        #[error(\\\"release state contains duplicate operation `{id:?}`\\\")]\\n-        DuplicateOperation { id: Box<ReleaseOperationId> },\\n-        #[error(\\\"release state does not contain operation `{id:?}`\\\")]\\n-        UnknownOperation { id: Box<ReleaseOperationId> },\\n-        #[error(\\\"operation `{id:?}` cannot transition from {from:?}\\\")]\\n-        InvalidTransition {\\n-            id: Box<ReleaseOperationId>,\\n-            from: ReleaseOperationState,\\n-        },\\n-    }\\n-\\n@@\\n-        #[test]\\n-        fn execution_state_wire_is_keyed_by_promoted_product_operations() {\\n-            let intent = intent();\\n-            let state = ReleaseExecutionState::pending(&intent);\\n-            state.validate_for_intent(&intent).unwrap();\\n-            let wire = serde_json::to_value(&state).unwrap();\\n-            assert_eq!(wire[\\\"operations\\\"].as_array().unwrap().len(), intent.operations().len());\\n-            assert!(wire[\\\"operations\\\"].as_array().unwrap().iter().any(|entry| {\\n-                entry[\\\"operation\\\"][\\\"kind\\\"] == \\\"productTag\\\" && entry[\\\"operation\\\"][\\\"release\\\"][\\\"product\\\"] == \\\"callisto\\\"\\n-            }));\\n-            assert_eq!(serde_json::from_value::<ReleaseExecutionState>(wire).unwrap(), state);\\n-        }\\n*** End Patch\",\n  \"tool\": \"apply_patch\"\n}\n"},{"type":"input_text","text":">>> APPROVAL REQUEST END\n"}],"internal_chat_messag