le, or execute durable release intents'\n         callisto-cli:test |             cand completions 'Generate shell completion scripts'\n         callisto-cli:test |             cand schema 'Print the JSON schema for a report type'\n         callisto-cli:test |             cand help 'Print this message or the help of the given subcommand(s)'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;add'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;status'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;matrix'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;version'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;pre'= {\n         callisto-cli:test |             cand enter 'Enter prerelease mode, tagging subsequent version bumps with the given prerelease tag'\n         callisto-cli:test |             cand exit 'Exit prerelease mode, returning to normal versioning'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;pre;enter'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;pre;exit'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;validate'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;snapshot'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;init'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;plan-publish'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;publish'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;compose-pr-body'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;tag'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;filter-plan'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;release'= {\n         callisto-cli:test |             cand plan 'Create a read-only durable release intent from exact package selections'\n         callisto-cli:test |             cand inspect 'Display a durable intent, manifest, state, or receipt without recomputing it'\n         callisto-cli:test |             cand reconcile 'Report which pending operations are eligible without changing release state'\n         callisto-cli:test |             cand execute 'Execute a previously approved intent. This is the only durable mutation route'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;release;plan'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;release;inspect'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;release;reconcile'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;release;execute'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;completions'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;schema'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;help'= {\n         callisto-cli:test |         }\n         callisto-cli:test |     ]\n         callisto-cli:test |     $completions[$command]\n         callisto-cli:test | }\n         callisto-cli:test | # Print an optspec for argparse to handle cmd's options that are independent of any subcommand.\n         callisto-cli:test | function __fish_callisto_global_optspecs\n         callisto-cli:test |     string join \\n format= cwd= dry-run h/help V/version\n         callisto-cli:test | end\n         callisto-cli:test | \n         callisto-cli:test | function __fish_callisto_needs_command\n         callisto-cli:test |     # Figure out if the current invocation already has a command.\n         callisto-cli:test |     set -l cmd (commandline -opc)\n         callisto-cli:test |     set -e cmd[1]\n         callisto-cli:test |     argparse -s (__fish_callisto_global_optspecs) -- $cmd 2>/dev/null\n         callisto-cli:test |     or return\n         callisto-cli:test |     if set -q argv[1]\n         callisto-cli:test |         # Also print the command, so this can be used to figure out what it is.\n         callisto-cli:test |         echo $argv[1]\n         callisto-cli:test |         return 1\n         callisto-cli:test |     end\n         callisto-cli:test |     return 0\n         callisto-cli:test | end\n         callisto-cli:test | \n         callisto-cli:test | function __fish_callisto_using_subcommand\n         callisto-cli:test |     set -l cmd (__fish_callisto_needs_command)\n         callisto-cli:test |     test -z \"$cmd\"\n         callisto-cli:test |     and return 1\n         callisto-cli:test |     contains -- $cmd[1] $argv\n         callisto-cli:test | end\n         callisto-cli:test | \n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -l format -d 'Output format for command results' -r -f -a \"text\\t''\n         callisto-cli:test | json\\t''\"\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -l cwd -d 'Workspace directory to operate in (defaults to the current directory)' -r -F\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -l dry-run -d 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_needs_command\" -s h -l help -d 'Print help'\n         callisto-cli:test | compl