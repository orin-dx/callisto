n194\t                        dependency_to.render()\n195\t                    ));\n196\t                }\n197\t                callisto_model::BumpReason::PeerEscalation { via, spec } => {\n198\t                    body.push_str(&format!(\n199\t                        \"- Peer dependency escalation triggered by `{}` (spec `{}`).\\n\\n\",\n200\t                        via.display_name(),\n201\t                        spec\n202\t                    ));\n203\t                }\n204\t                callisto_model::BumpReason::FixedGroupUnion { group } => {\n205\t                    body.push_str(&format!(\n206\t                        \"- Fixed group synchronization for group `{}`.\\n\\n\",\n207\t                        group.as_str()\n208\t                    ));\n209\t                }\n210\t                callisto_model::BumpReason::LinkedGroupUnion { group } => {\n211\t                    body.push_str(&format!(\n212\t                        \"- Linked group version alignment for group `{}`.\\n\\n\",\n213\t                        group.as_str()\n214\t                    ));\n215\t                }\n216\t                callisto_model::BumpReason::Inference { commits, .. } => {\n217\t                    body.push_str(&format!(\n218\t                        \"- Inferred from {commits} commit(s) since the last release.\\n\\n\"\n219\t                    ));\n220\t                }\n221\t                callisto_model::BumpReason::PreRelease { tag } => {\n222\t                    body.push_str(&format!(\"- Pre-release finalization (tag `{tag}`).\\n\\n\"));\n223\t                }\n224\t                callisto_model::BumpReason::NewGroupMember { group } => {\n225\t                    body.push_str(&format!(\"- New member of group `{}`.\\n\\n\", group.as_str()));\n226\t                }\n227\t                _ => {}\n228\t            }\n229\t        }"}]},"uuid":"b9ab4607-f2cf-4f6c-a3a6-9ecfa82249ac","timestamp":"2026-08-20T23:56:41.511Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/commands/pr_body.rs","content":"    for bump in &plan.bumps {\n        let is_open = bump.severity == callisto_model::Severity::Major\n            || bump.severity == callisto_model::Severity::Minor;\n        let open_attr = if is_open { \" open\" } else { \"\" };\n\n        body.push_str(&format!(\n            \"<details{}>\\n<summary><b>{}</b> <code>{}</code> → <code>{}</code> ({})</summary>\\n\\n\",\n            open_attr,\n            bump.package.display_name(),\n            bump.from.render(),\n            bump.to.render(),\n            bump.severity\n        ));\n\n        body.push_str(&format!(\n            \"#### Version Change\\n`{}` ➔ `{}`\\n\\n\",\n            bump.from.render(),\n            bump.to.render()\n        ));\n\n        if let Some(ref reason) = bump.reason {\n            body.push_str(\"#### Release Reason\\n\");\n            match reason {\n                callisto_model::BumpReason::Changeset { changesets } => {\n                    body.push_str(&format!(\n                        \"- Associated changesets: `{}`\\n\\n\",\n                        changesets.join(\"`, `\")\n                    ));\n                }\n                callisto_model::BumpReason::Cascade {\n                    via,\n                    spec,\n                    dependency_to,\n                    ..\n                } => {\n                    body.push_str(&format!(\n                        \"- Automatic dependency cascade triggered by `{}` (spec `{}` target `{}`).\\n\\n\",\n                        via.display_name(),\n                        spec,\n                        dependency_to.render()\n                    ));\n                }\n                callisto_model::BumpReason::PeerEscalation { via, spec } => {\n                    body.push_str(&format!(\n                        \"- Peer dependency escalation triggered by `{}` (spec `{}`).\\n\\n\",\n                        via.display_name(),\n                        spec\n                    ));\n                }\n                callisto_model::BumpReason::FixedGroupUnion { group } => {\n                    body.push_str(&format!(\n                        \"- Fixed group synchronization for group `{}`.\\n\\n\",\n                        group.as_str()\n                    ));\n                }\n                callisto_model::BumpReason::LinkedGroupUnion { group } => {\n                    body.push_str(&format!(\n                        \"- Linked group version alignment for group `{}`.\\n\\n\",\n                        group.as_str()\n                    ));\n                }\n                callisto_model::BumpReason::Inference { commits, .. } => {\n                    body.push_str(&format!(\n                        \"- Inferred from {commits} commit(s) since the last release.\\n\\n\"\n                    ));\n                }\n                callisto_model::BumpReason::PreRelease { tag } => {\n                    body.push_str(&format!(\"- Pre-release finalization (tag `{tag}`).\\n\\n\"));\n                }\n                callisto_model::BumpReason::NewGroupMember { group } => {\n                    body.push_str(&format!(\"- New member of group `{}`.\\n\\n\", group.as_str()));\n                }\n                _ => {}\n            }\n        }","numLines":75,"startLine":155,"totalLines":401}},"sourceToolAssistantUUID":"6a0d4383-a588-4be2-9ec9-7cb6dc23dbc5","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"main","slug":"shimmying-giggling-hickey"}
