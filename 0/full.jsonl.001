{"parentUuid":"b1604846-be3f-4685-81f0-5a7bd17e11bf","isSidechain":false,"promptId":"90802363-3d8b-46b7-ade0-7b460f1a7c40","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012sDvtw1trGyNKdEDBqeThj","type":"tool_result","content":"        );\n    }\n}\n\n#[test]\nfn dual_manifest_name_in_the_wrong_ecosystem_is_resolved_by_neither_command() {\n    let dir = dual();\n    assert_same_packages(dir.path(), \"cargo/@org/native-core-js\");\n    let (status, version) = outcomes(dir.path(), \"cargo/@org/native-core-js\");\n    assert!(status.packages.is_empty() && version.packages.is_empty());\n}\n\n#[test]\nfn promoted_qualified_selectors_agree() {\n    let dir = promoted();\n    for (selector, expected) in [(\"cargo/foo\", \"cargo/foo\"), (\"npm/foo\", \"npm/foo\")] {\n        assert_same_packages(dir.path(), selector);\n        let (status, _) = outcomes(dir.path(), selector);\n        assert_eq!(status.packages, BTreeSet::from([expected.to_string()]), \"{selector}\");\n    }\n}\n\n#[test]\n\n#[test]\nfn selectors_resolve_the_same_in_a_prerelease_workspace() {\n    let dir = dual();\n    let (exit, _, stderr) = run(dir.path(), &[\"pre\", \"enter\", \"beta\"]);\n    assert_eq!(exit, Some(0), \"{stderr}\");\n    commit(dir.path());\n    for selector in [\n        \"@org/native-core-js\",\n        \"npm/@org/native-core-js\",\n        \"native-core\",\n        \"npm/native-core\",\n    ] {\n        assert_same_packages(dir.path(), selector);\n    }\n    let (status, version) = outcomes(dir.path(), \"@org/native-core-js\");\n    assert_eq!(status.packages, BTreeSet::from([\"native-core\".to_string()]));\n    assert_eq!(version.packages, status.packages);\n}","is_error":false}]},"uuid":"871cb6d1-da62-4388-8736-488ba0166a60","timestamp":"2026-10-21T20:08:43.050Z","toolUseResult":{"stdout":"        );\n    }\n}\n\n#[test]\nfn dual_manifest_name_in_the_wrong_ecosystem_is_resolved_by_neither_command() {\n    let dir = dual();\n    assert_same_packages(dir.path(), \"cargo/@org/native-core-js\");\n    let (status, version) = outcomes(dir.path(), \"cargo/@org/native-core-js\");\n    assert!(status.packages.is_empty() && version.packages.is_empty());\n}\n\n#[test]\nfn promoted_qualified_selectors_agree() {\n    let dir = promoted();\n    for (selector, expected) in [(\"cargo/foo\", \"cargo/foo\"), (\"npm/foo\", \"npm/foo\")] {\n        assert_same_packages(dir.path(), selector);\n        let (status, _) = outcomes(dir.path(), selector);\n        assert_eq!(status.packages, BTreeSet::from([expected.to_string()]), \"{selector}\");\n    }\n}\n\n#[test]\n\n#[test]\nfn selectors_resolve_the_same_in_a_prerelease_workspace() {\n    let dir = dual();\n    let (exit, _, stderr) = run(dir.path(), &[\"pre\", \"enter\", \"beta\"]);\n    assert_eq!(exit, Some(0), \"{stderr}\");\n    commit(dir.path());\n    for selector in [\n        \"@org/native-core-js\",\n        \"npm/@org/native-core-js\",\n        \"native-core\",\n        \"npm/native-core\",\n    ] {\n        assert_same_packages(dir.path(), selector);\n    }\n    let (status, version) = outcomes(dir.path(), \"@org/native-core-js\");\n    assert_eq!(status.packages, BTreeSet::from([\"native-core\".to_string()]));\n    assert_eq!(version.packages, status.packages);\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"eba336c3-f5ec-4adb-b3df-77c0850f7985","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-canonical-emission","root":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-canonical-emission","branch":"worktree-t06-canonical-emission","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":15,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callist