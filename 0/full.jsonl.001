n":5,"backupTime":"2026-08-17T09:48:40.690Z","realParentDir":"/private/tmp/claude-501/-Users-gabe-Projects-callisto/ae412d01-e061-4047-918b-0d1df3d4d118/scratchpad"},"/private/tmp/claude-501/-Users-gabe-Projects-callisto/5e79b5c6-5688-4728-8d81-ff2c106a0e2e/scratchpad/combined_shell.html":{"backupFileName":null,"version":5,"backupTime":"2026-08-17T09:48:40.690Z","realParentDir":"/private/tmp/claude-501/-Users-gabe-Projects-callisto/5e79b5c6-5688-4728-8d81-ff2c106a0e2e/scratchpad"},"/private/tmp/claude-501/-Users-gabe-Projects-callisto/5e79b5c6-5688-4728-8d81-ff2c106a0e2e/scratchpad/shell_template.html":{"backupFileName":null,"version":5,"backupTime":"2026-08-17T09:48:40.690Z","realParentDir":"/private/tmp/claude-501/-Users-gabe-Projects-callisto/5e79b5c6-5688-4728-8d81-ff2c106a0e2e/scratchpad"},"/private/tmp/claude-501/-Users-gabe-Projects-callisto/5e79b5c6-5688-4728-8d81-ff2c106a0e2e/scratchpad/build_audit_artifact.py":{"backupFileName":null,"version":5,"backupTime":"2026-08-17T09:48:40.690Z","realParentDir":"/private/tmp/claude-501/-Users-gabe-Projects-callisto/5e79b5c6-5688-4728-8d81-ff2c106a0e2e/scratchpad"},"/private/tmp/claude-501/-Users-gabe-Projects-callisto/5e79b5c6-5688-4728-8d81-ff2c106a0e2e/scratchpad/build_runtime_parts.py":{"backupFileName":null,"version":5,"backupTime":"2026-08-17T09:48:40.690Z","realParentDir":"/private/tmp/claude-501/-Users-gabe-Projects-callisto/5e79b5c6-5688-4728-8d81-ff2c106a0e2e/scratchpad"},"crates/callisto-graph/src/locate/membership.rs":{"backupFileName":"752c2cdd4e7aada6@v1","version":1,"backupTime":"2026-08-16T03:40:51.477Z","realParentDir":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/locate"},"crates/callisto-graph/src/config/groups.rs":{"backupFileName":"9b428aaf6bfd5b01@v2","version":2,"backupTime":"2026-08-14T20:05:33.732Z","realParentDir":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/config"},"crates/callisto-graph/src/cascade.rs":{"backupFileName":"103a6916f3ec5181@v2","version":2,"backupTime":"2026-08-14T20:05:33.732Z","realParentDir":"/Users/gabe/Projects/callisto/crates/callisto-graph/src"},"docs/00-design.md":{"backupFileName":"bab0b31210079523@v3","version":3,"backupTime":"2026-08-15T16:08:09.932Z","realParentDir":"/Users/gabe/Projects/callisto/docs"},"crates/callisto-model/src/matrix.rs":{"backupFileName":"dc955a0a6f0d0333@v2","version":2,"backupTime":"2026-08-14T20:05:33.732Z","realParentDir":"/Users/gabe/Projects/callisto/crates/callisto-model/src"},"crates/callisto-cli/src/workspace.rs":{"backupFileName":"f808d1204c545d56@v2","version":2,"backupTime":"2026-08-15T05:45:12.945Z","realParentDir":"/Users/gabe/Projects/callisto/crates/callisto-cli/src"},"crates/callisto-graph/src/commands/validate.rs":{"backupFileName":"911110fed81c2873@v2","version":2,"backupTime":"2026-08-14T20:05:33.732Z","realParentDir":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/commands"},"docs/01-spec.md":{"backupFileName":"fbff22697f901e69@v4","version":4,"backupTime":"2026-08-15T16:08:09.932Z","realParentDir":"/Users/gabe/Projects/callisto/docs"}},"timestamp":"2026-08-17T09:48:40.726Z"},"isSnapshotUpdate":false}
