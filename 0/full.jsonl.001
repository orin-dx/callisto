cal_git_remote(\"https://token@github.com/example/release-fixture.git\").is_err());\n    }\n\n    #[test]\n    fn validation_rejects_self_consistent_intent_with_unapproved_decision() {\n        let (dir, runner) = fixture();\n        let state_dir = tempfile::tempdir().unwrap();\n        let locator = crate::IgnoreWalkLocator::new(dir.path());\n        let forged = ReleaseDecisionV1::new(vec![callisto_model::ReleaseDecisionEntry {\n            package: ReleasePackageId::new(Ecosystem::Cargo, \"release-fixture\").unwrap(),\n            target_version: Version::parse(\"1.2.4\", VersionGrammar::SemVer).unwrap(),\n            reasons: vec![callisto_model::ReleaseInclusionReason::ExplicitSelection],\n        }])\n        .unwrap();\n        let intent = build_release_intent(dir.path(), \u0026locator, \u0026runner, \u0026forged, \"production\").unwrap();\n        assert!(matches!(\n            validate_release_intent_with_state_directory(dir.path(), \u0026locator, \u0026runner, Some(state_dir.path()), intent),\n            Err(GraphError::ReleaseIntentStale { .. })\n        ));\n    }\n\n    #[test]\n    fn github_api_observation_parser_requires_an_explicit_http_status() {\n        let (status, body) = parse_github_api_response(\n            \"gh\",\n            \u0026[\"api\"],\n            \"HTTP/2 404\\r\\ncontent-type: application/json\\r\\n\\r\\n{\\\"message\\\":\\\"Not Found\\\"}\",\n        )\n        .unwrap();\n        assert_eq!(status, 404);\n        assert_eq!(body, \"{\\\"message\\\":\\\"Not Found\\\"}\");\n        assert!(parse_github_api_response(\"gh\", \u0026[\"api\"], \"not a response\").is_err());\n    }\n\n    #[test]\n    fn prepared_capability_retains_exact_tag_and_registry_inputs() {\n        let (dir, runner) = fixture();\n   \u003ctruncated omitted_approx_tokens=\"1606\" /\u003eo_not_change_semantic_release_inputs() {\n        let (dir, runner) = fixture();\n        let locator = crate::IgnoreWalkLocator::new(dir.path());\n        let root = canonical_root(dir.path()).unwrap();\n        let workspace = Workspace::load(root.clone(), \u0026locator, \u0026runner).unwrap();\n        let source = observe_source(\u0026workspace).unwrap();\n        let before = derive_product_release(\u0026workspace, \u0026decision(), source.clone(), \"production\").unwrap();\n\n        std::fs::write(\n            root.join(\"callisto.toml\"),\n            release_config(\n                \"# formatting/comments are not release policy\\n[[package]]\\nmatch = \\\"release-fixture\\\"\\npublish-to = [\\\"crates-io\\\"]\\n\",\n            ),\n        )\n        .unwrap();\n        let reread = Workspace::load(root, \u0026locator, \u0026runner).unwrap();\n        let after = derive_product_release(\u0026reread, \u0026decision(), source, \"production\").unwrap();\n\n        assert_eq!(before.intent, after.intent);\n        assert_eq!(\n            before.operations.keys().collect::\u003cVec\u003c_\u003e\u003e(),\n            after.operations.keys().collect::\u003cVec\u003c_\u003e\u003e()\n        );\n    }\n\n    #[test]\n    fn effective_release_classification_rejects_authority() {\n        let (dir, runner) = fixture();\n        let locator = crate::IgnoreWalkLocator::new(dir.path());\n        let root = canonical_root(dir.path()).unwrap();\n        let workspace = Workspace::load(root.clone(), \u0026locator, \u0026runner).unwrap();\n        let source = observe_source(\u0026workspace).unwrap();\n        std::fs::write(\n            root.join(\"callisto.toml\"),\n            release_config(\n                \"[[package-set]]\\nmatch = 'cargo:*'\\nrelease-unit = 'dev-only'\\npublish-to = ['crates-io']\\n\",\n            ),\n        )\n        .unwrap();\n        let reread = Workspace::load(root, \u0026locator, \u0026runner).unwrap();\n        assert!(matches!(\n            derive_product_release(\u0026reread, \u0026decision(), source, \"production\"),\n            Err(GraphError::ReleasePackageNotSelected { .. })\n        ));\n    }\n}\n\n","type":"input_text"},{"text":"\n[92] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/commands/release.rs\\n@@\\n-    #[test]\\n-    fn github_api_observation_parser_requires_an_explicit_http_status() {\\n-        let (status, body) = parse_github_api_response(\\n-            \\\"gh\\\",\\n-            \u0026[\\\"api\\\"],\\n-            \\\"HTTP/2 404\\\\r\\\\ncontent-type: application/json\\\\r\\\\n\\\\r\\\\n{\\\\\\\"message\\\\\\\":\\\\\\\"Not Found\\\\\\\"}\\\",\\n-        )\\n-        .unwrap();\\n-        assert_eq!(status, 404);\\n-        assert_eq!(body, \\\"{\\\\\\\"message\\\\\\\":\\\\\\\"Not Found\\\\\\\"}\\\");\\n-        assert!(parse_github_api_response(\\\"gh\\\", \u0026[\\\"api\\\"], \\\"not a response\\\").is_err());\\n-    }\\n-\\n@@\\n-                PreparedOperation::RegistryArtifactPublish {\\n-                    package_dir,\\n-                    artifact,\\n-                    registry,\\n-                } =\u003e Some((package_dir, artifact, registry)),\\n+                PreparedOperation::RegistryArtifactPublish {\\n+                    artifact, registry, ..\\n+                } =\u003e Some((artifact, registry)),\\n@@\\n-        assert_eq!(registry.0, \u0026std::path::PathBuf::new());\\n-        assert_eq!(registry.1.package().name(), \\\"release-fixture\\\");\\n-        assert_eq!(registry.1.file_name(), \\\"release-fixture-1.2.3.crate\\\");\\n-        assert_eq!(registry.2.key.as_str(), \\\"cargo\\\");\\n-        assert!(matches!(registry.2.endpoints, PreparedRegistryEndpoints::Cargo { .. }));\\n-    }\\n-\\n-    #[test]\\n-    fn prepared_tag_adapter_accepts_only_the_exact_intended_target() {\\n-        let (dir, runner) = fixture();\\n-        let state_dir = tempfile::tempdir().unwrap();\\n-        let locator = crate::IgnoreWalkLocator::new(dir.path());\\n-        let intent = build_release_intent(dir.path(), \u0026locator, \u0026runner, \u0026decision(), \\\"production\\\").unwrap();\\n-        let validated =\\n-            validate_release_intent_with_state_directory(dir.path(), \u0026locator, \u0026runner, Some(state_dir.path()), intent)\\n-       \u003ctruncated omitted_approx_tokens=\"302\" /\u003e        let locator = crate::IgnoreWalkLocator::new(dir.path());\\n-        let intent = build_release_intent(dir.path(), \u0026locator, \u0026runner, \u0026decision(), \\\"production\\\").unwrap();\\n-        let validated =\\n-            validate_release_intent_with_state_directory(dir.path(), \u0026locator, \u0026runner, Some(state_dir.path()), intent)\\n-                .unwrap();\\n-        let tag_id = validated\\n-            .intent()\\n-            .operations()\\n-            .iter()\\n-            .find(|operation| matches!(operation.id(), ReleaseOperationId::ProductTag { .. }))\\n-            .expect(\\\"tag operation\\\")\\n-            .id()\\n-            .clone();\\n-        assert!(std::process::Command::new(\\\"git\\\")\\n-            .args([\\\"commit\\\", \\\"--allow-empty\\\", \\\"-qm\\\", \\\"other\\\"])\\n-            .current_dir(dir.path())\\n-            .status()\\n-            .unwrap()\\n-            .success());\\n-        assert!(std::process::Command::new(\\\"git\\\")\\n-            .args([\\n-                \\\"-c\\\",\\n-                \\\"tag.gpgSign=false\\\",\\n-                \\\"tag\\\",\\n-                \\\"-a\\\",\\n-                \\\"release-fixture@1.2.3\\\",\\n-                \\\"HEAD\\\",\\n-                \\\"-m\\\",\\n-                \\\"wrong\\\",\\n-            ])\\n-            .current_dir(dir.path())\\n-            .status()\\n-            .unwrap()\\n-            .success());\\n-        assert!(matches!(\\n-            validated.dispatch_prepared(\u0026callisto_model::ApplyPermit::force_for_tests(), \u0026tag_id),\\n-            Err(GraphError::ReleaseRemoteConflict {\\n-                conflict: RemoteConflict::TagTargetDiffers\\n-    