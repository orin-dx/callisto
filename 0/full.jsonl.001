{"parentUuid":"8701d26d-6282-4bbe-9b56-514ee20f883c","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011Cgyd7eLVLLtD2yuDdx7Eh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WJVdqvSMmTqSWksncSbwjy","name":"Write","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/small-batch-limit-and-preview/.changeset/pre-mode-never-downgrades.md","content":"---\ncallisto-cli: patch\n---\n\nIn pre-release mode, `callisto version` no longer lowers a package that already has a higher prerelease.\n\n- Before, a package whose changeset was already recorded in `pre.json` lost that bump on the next run. If a dependency or a fixed-group sibling then bumped it with a lower severity, it was recomputed from the starting version: `1.1.0-beta.0` became `1.0.1-beta.0`, a version older than the one already published.\n- Now the result is raised until it is not behind the current version, so that package goes to `1.1.0-beta.1`.\n- If no bump can get past the current version, for example after switching the pre-release tag from `rc` to `beta`, `version` stops with the existing version-regression error instead of writing an older version.\n- You do not need to do anything.\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":852,"cache_read_input_tokens":121951,"output_tokens":726,"output_tokens_details":{"thinking_tokens":153},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":852,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":726,"cache_read_input_tokens":121951,"cache_creation_input_tokens":852,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":852},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01WJVdqvSMmTqSWksncSbwjy":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/small-batch-limit-and-preview/.changeset/pre-mode-never-downgrades.md","content":"---\ncallisto-cli: patch\n---\n\nIn pre-release mode, `callisto version` no longer lowers a package that already has a higher prerelease.\n\n- Before, a package whose changeset was already recorded in `pre.json` lost that bump on the next run. If a dependency or a fixed-group sibling then bumped it with a lower severity, it was recomputed from the starting version: `1.1.0-beta.0` became `1.0.1-beta.0`, a version older than the one already published.\n- Now the result is raised until it is not behind the current version, so that package goes to `1.1.0-beta.1`.\n- If no bump can get past the current version, for example after switching the pre-release tag from `rc` to `beta`, `version` stops with the existing version-regression error instead of writing an older version.\n- You do not need to do anything.\n"}},"serverClassifierRequest":"161af23d-b555-427b-9f87-5fbb3b167371","apiBlockIndex":1,"requestId":"req_011Cgyd7dqyMnagMRajHzp59","requestRef":"5730c7bf-4039-4db3-be0a-5ec92017a544","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"c964dfcb-b8d0-4827-bfba-b6c54d4c1c40","timestamp":"2026-11-12T19:56:49.247Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/small-batch-limit-and-preview","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/pre-mode-no-downgrade","slug":"mossy-snacking-stream"}
