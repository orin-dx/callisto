he canonical npm client accepts the artifact directly.\npub(super) fn npm_tarball_publish_argv(\n    tarball: \u0026Path,\n    tag: \u0026str,\n    access: NpmAccess,\n    registry: \u0026str,\n) -\u003e Argv {\n    let tarball_argument = tarball.to_string_lossy().into_owned();\n    let mut args = vec![\"publish\".to_string(), tarball_argument, \"--ignore-scripts\".to_string()];\n    args.extend([\n        \"--tag\".to_string(),\n        tag.to_string(),\n        \"--access\".to_string(),\n        match access {\n            NpmAccess::Public =\u003e \"public\".to_string(),\n            NpmAccess::Restricted =\u003e \"restricted\".to_string(),\n        },\n        \"--registry\".to_string(),\n        registry.to_string(),\n    ]);\n    Argv {\n        program: \"npm\".to_string(),\n        args,\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    // ------------------------------------------------------------------ npm\n\n    #[test]\n    fn every_workspace_manager_converges_on_canonical_npm_exact_tarball_publish() {\n        let argv = npm_tarball_publish_argv(\n            Path::new(\"/private/pkg-a.tgz\"),\n            \"next\",\n            NpmAccess::Public,\n            \"https://registry.example.test/\",\n        );\n        assert_eq!(argv.program, \"npm\");\n        assert_eq!(\n            argv.args,\n            vec![\n                \"publish\",\n                \"/private/pkg-a.tgz\",\n                \"--ignore-scripts\",\n                \"--tag\",\n                \"next\",\n                \"--access\",\n                \"public\",\n                \"--registry\",\n                \"https://registry.example.test/\",\n            ]\n        );\n    }\n}\n\n","type":"input_text"},{"text":"\n[75] tool send_message call: {\"target\":\"/root/implement_pm4_profiles\",\"message\":\"REDACTED\"}\n","type":"input_text"},{"text":"\n[76] tool send_message call: {\"target\":\"/root\",\"message\":\"REDACTED\"}\n","type":"input_text"},{"text":"\n[77] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-vcs/src/access.rs\\n@@\\n     fn push_annotated_tag_confirms_by_reading_back_the_remote() {\\n@@\\n     }\\n+\\n+    #[test]\\n+    fn ensure_local_annotated_tag_reuses_only_an_exact_crash_recovery_tag() {\\n+        let (_remote, local, head) = remote_fixture();\\n+        let runner = RealGitRunner;\\n+        let git = GitAccess::discover(local.path(), \u0026runner);\\n+        let name = TagName::parse(\\\"release-local-retry\\\").unwrap();\\n+        let annotation = \\\"Release local retry\\\";\\n+\\n+        git.ensure_local_annotated_tag(\\n+            \u0026name,\\n+            \u0026head,\\n+            annotation,\\n+            crate::TagSignPolicy::ForceUnsigned,\\n+            \u0026permit(),\\n+        )\\n+        .unwrap();\\n+        git.ensure_local_annotated_tag(\\n+            \u0026name,\\n+            \u0026head,\\n+            annotation,\\n+            crate::TagSignPolicy::ForceUnsigned,\\n+            \u0026permit(),\\n+        )\\n+        .unwrap();\\n+\\n+        assert!(matches!(\\n+            git.ensure_local_annotated_tag(\\n+                \u0026name,\\n+                \u0026head,\\n+                \\\"Different annotation\\\",\\n+                crate::TagSignPolicy::ForceUnsigned,\\n+                \u0026permit(),\\n+            ),\\n+            Err(VcsError::LocalAnnotatedTagConflict {\\n+                conflict: crate::LocalAnnotatedTagConflict::Annotation,\\n+                ..\\n+            })\\n+        ));\\n+    }\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n","type":"input_text"},{"text":"\n[78] tool exec result: Script completed\nWall time 3.7 seconds\nOutput:\n\n{}\n","type":"input_text"},{"text":"\n[79] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '410,455p' crates/callisto-graph/src/error.rs \u0026\u0026 rtk rg -n \\\"CommandFailure::\\\" crates/