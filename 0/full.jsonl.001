ws), Err(ConfigError::Read { .. })));\n    }\n\n    #[test]\n    fn with_promoted_siblings_overlays_without_mutating_original() {\n        let tmp = tempfile::tempdir().expect(\"tempdir\");\n        let root = tmp.path();\n        fs::write(root.join(\"callisto.toml\"), \"\").expect(\"write callisto.toml\");\n        let cfg = load(root).expect(\"load should succeed\");\n        assert!(\n            cfg.promoted_siblings.is_empty(),\n            \"promoted_siblings must default to empty at config-load time\"\n        );\n\n        let mut local: BTreeMap<String, Vec<(PackageId, std::collections::BTreeSet<Ecosystem>)>> = BTreeMap::new();\n        let mut ecos = std::collections::BTreeSet::new();\n        ecos.insert(Ecosystem::Cargo);\n        local.insert(\n            \"native-core\".to_string(),\n            vec![(\n                PackageId::Prefixed {\n                    ecosystem: Ecosystem::Cargo,\n                    name: \"native-core\".to_string(),\n                },\n                ecos,\n            )],\n        );\n        let overlay = cfg.with_promoted_siblings(local);\n        assert_eq!(overlay.promoted_siblings.len(), 1);\n        assert!(\n            cfg.promoted_siblings.is_empty(),\n            \"original cfg must remain untouched by with_promoted_siblings\"\n        );\n    }\n\n    #[test]\n    fn promoted_siblings_field_is_pub_not_pub_crate() {\n        let tmp = tempfile::tempdir().expect(\"tempdir\");\n        let root = tmp.path();\n        fs::write(root.join(\"callisto.toml\"), \"\").expect(\"write callisto.toml\");\n        let cfg = load(root).expect(\"load should succeed\");\n        let _: &BTreeMap<String, Vec<(PackageId, std::collections::BTreeSet<Ecosystem>)>> = &cfg.promoted_siblings;\n    }\n\n    #[test]\n    fn test_config_resolve_rejects_traversal_in_changesets_dir() {\n        let tmp = tempfile::tempdir().expect(\"tempdir\");\n        let root = tmp.path();\n        fs::write(root.join(\"callisto.toml\"), \"[changesets]\\ndir = \\\"../../tmp\\\"\\n\").expect(\"write callisto.toml\");","is_error":false}]},"uuid":"5a67796b-e175-40a3-a271-bf57eb08ca4d","timestamp":"2026-10-21T19:04:07.698Z","toolUseResult":{"stdout":"crates/callisto-graph/src/walk.rs:14:use crate::config::resolve::{resolve_package_config, rule_applies};\ncrates/callisto-graph/src/walk.rs:620:        let pkg_override = resolve_package_config(&id, &package_ecosystems, cfg)?;\ncrates/callisto-graph/src/walk.rs:632:            if rule_applies(rule_id, &id, &package_ecosystems) {\ncrates/callisto-graph/src/aggregate/tests.rs:1444:/// With resolve_package_config (two-pass): the Prefixed rule wins -> OFF applied.\ncrates/callisto-graph/src/aggregate/tests.rs:1466:    // Two-pass resolve_package_config: pass 1 finds npm:pkg (Prefixed) -> OFF applied.\ncrates/callisto-graph/src/aggregate.rs:12:use crate::config::resolve::resolve_package_config;\ncrates/callisto-graph/src/aggregate.rs:245:        let policy = resolve_package_config(&pkg.id, &package_ecosystems, config)?\ncrates/callisto-graph/tests/per_package_config_test.rs:301:fn bare_rule_applies_when_no_prefixed_rule_matches_this_package() {\ncrates/callisto-graph/src/tags.rs:255:                    crate::config::resolve::resolve_package_config(&pkg.id, &package_ecosystems, cfg)?\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ConfigProvenance {\n    Default,\n    Explicit,\n}\n\nimpl ResolvedConfig {\n    pub(crate) fn with_promoted_siblings(\n        &self,\n        promoted_siblings: BTreeMap<String, Vec<(PackageId, BTreeSet<Ecosystem>)>>,\n    ) -> ResolvedConfig {\n        let mut overlay = self.clone();\n        overlay.promoted_siblings = promoted_siblings;\n        overlay\n    }\n\n    pub fn provenance(&self, key: &ConfigKey) -> ConfigProvenance {\n        self.provenance.get(key).copied().unwrap_or(ConfigProvenance::Default)\n    }\n\n            return;\n        };\n        assert!(matches!(load(&ws), Err(ConfigError::Read { .. })));\n    }\n\n    #