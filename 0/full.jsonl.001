,\n    })\n}\n\n/// Per-package overrides from a `[[package]]` block in `callisto.toml`.\n///\n/// Every field is `Option\u003cT\u003e` — `None` means \"not specified; use the package's default.\"\n/// Only fields that the user explicitly set in the `[[package]]` block are `Some`.\n#[derive(Clone, Debug)]\npub struct PackageConfig {\n    pub release_unit: Option\u003cReleaseUnitClassification\u003e,\n    pub release_trigger: Option\u003cReleaseTrigger\u003e,\n    pub publish_to: Option\u003cVec\u003cPublishTarget\u003e\u003e,\n    pub tag_template: Option\u003cTagTemplate\u003e,\n    /// Changelog path relative to the package's own root directory.\n    pub changelog: Option\u003cPathBuf\u003e,\n    pub pre_major_inference: Option\u003cPreMajorInferencePolicy\u003e,\n    /// Exact PyPI distribution descriptors. `None` means the package did not\n    /// opt into durable PyPI release; Callisto never infers wheel tags or an\n    /// sdist name from mutable build output.\n    pub release_artifacts: Option\u003cVec\u003cReleaseArtifactDescriptor\u003e\u003e,\n}\n\n/// One exact, immutable PyPI distribution expected from a release build.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct ReleaseArtifactDescriptor {\n    format: RegistryArtifactFormat,\n    file_name: String,\n}\n\nimpl ReleaseArtifactDescriptor {\n    pub fn format(\u0026self) -\u003e RegistryArtifactFormat {\n        self.format\n    }\n\n    pub fn file_name(\u0026self) -\u003e \u0026str {\n        \u0026self.file_name\n    }\n}\n\n/// Whether a discovered package participates in durable release authority.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub enum ReleaseUnitClassification {\n    #[default]\n    Releasable,\n    DevOnly,\n}\n\n/// Uses the same effective override as manifest discovery and aggregation.\npub fn is_release_unit(config: \u0026ResolvedConfig, id: \u0026PackageId) -\u003e Result\u003cbool, GraphError\u003e {\n    Ok(resolve_package_config(id, config)?\n        .and_then(|package| package.release_unit)\n        .unwrap_or_default()\n        == Rele\u003ctruncated omitted_approx_tokens=\"41\" /\u003elidate_syntactic(\u0026raw_groups)?;\n\n    // Resolve [[package]] blocks into per-package override rules.\n    // Order is preserved: first matching rule wins during package construction.\n    let mut packages: Vec\u003c(PackageId, PackageConfig)\u003e = Vec::new();\n    for raw_pkg in raw.package.unwrap_or_default() {\n        let pattern = PackageId::parse(\u0026raw_pkg.pattern).map_err(|e| ConfigError::UnknownKey {\n            path: callisto_toml.clone(),\n            key: format!(\"[[package]] match = {:?}: {e}\", raw_pkg.pattern),\n        })?;\n\n        let mut cfg = parse_package_config_fields(\n            \u0026callisto_toml,\n            \"[[package]]\",\n            \u0026raw_pkg.pattern,\n            raw_pkg.release_unit.as_deref(),\n            raw_pkg.release_trigger.as_deref(),\n            raw_pkg.tag_template.as_deref(),\n            raw_pkg.changelog.as_deref(),\n            raw_pkg.pre_major_inference.as_deref(),\n            raw_pkg.publish_to.as_deref(),\n        )?;\n        cfg.release_artifacts = parse_release_artifacts(\u0026pattern, \u0026cfg, raw_pkg.release_artifact.as_deref())?;\n\n        packages.push((pattern, cfg));\n    }\n\n    // Resolve [[package-set]] blocks into bulk config-override rules.\n    // Semantics: each rule matches ALL packages whose PackageId matches the pattern.\n    // A [[package]] rule takes priority; [[package-set]] is the fallback (see walk.rs).\n    let mut package_sets: Vec\u003c(PackagePattern, PackageConfig)\u003e = Vec::new();\n    for raw_pkg in raw.package_set.unwrap_or_default() {\n        let pattern = PackagePattern::parse(\u0026raw_pkg.pattern).map_err(|e| ConfigError::UnknownKey {\n            path: callisto_toml.clone(),\n            key: format!(\"[[package-set]] match = {:?}: {e}\", raw_pkg.pattern),\n        })?;\n\n592:    pub release_artifacts: Option\u003cVec\u003cReleaseArtifactDescriptor\u003e\u003e,\n814:        release_artifacts: None,\n818:fn parse_release_artifacts(\n1106:        cfg.release_artifacts = parse_release_artifacts(\u0026pattern, \u0026cfg, raw_pkg.release_artifact.as_deref())?;\n\n","type":"input_text"},{"text":"\n[75] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"release-artifact|PythonWheel|sdist\\\" crates/callisto-graph/src/config/resolve.rs | tail -80\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":12000}); text(r.output);\n\n","type":"input_text"},{"text":"\n[76] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\n591:    /// sdist name from mutable build output.\n829:            \"declare at least one nested [[package.release-artifact]] table\",\n868:    let mut sdist_count = 0;\n871:            \"wheel\" =\u003e RegistryArtifactFormat::PythonWheel,\n872:            \"sdist\" =\u003e {\n873:                sdist_count += 1;\n879:                    format!(\"unsupported format {other:?}; expected wheel or sdist\"),\n897:            RegistryArtifactFormat::PythonWheel =\u003e file_name.ends_with(\".whl\"),\n921:    if sdist_count \u003e 1 {\n924:            \"at most one sdist descriptor is allowed\",\n\n","type":"input_text"},{"text":"\n[77] tool send_message call: {\"target\":\"/root/implement_pm4_profiles\",\"message\":\"REDACTED\"}\n","type":"input_text"},{"text":"\n[78] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/commands/release.rs\\n@@\\n-        for (format, file_name) in registry_artifact_files(package_id, version)? {\\n+        let configured_artifacts = crate::config::resolve_package_config(\u0026package.id, \u0026workspace.config)?\\n+            .and_then(|config| config.release_artifacts.as_deref());\\n+        for (format, file_name) in registry_artifact_files(package_id, version, configured_ar