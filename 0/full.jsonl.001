{"parentUuid":"beb6aeaa-22d3-4c51-8d7f-d6d86e3495fd","isSidechain":false,"promptId":"90802363-3d8b-46b7-ade0-7b460f1a7c40","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012zho39xcBQA7cjpybznBbt","type":"tool_result","content":"    /// kept for wire compatibility.\n    ChangesetReadError,\n    /// Git repository or tag discovery failed. Not emitted since `plan-publish` was removed;\n    /// kept for wire compatibility.\n    GitDiscoveryFailed,\n    /// A bare (unprefixed) `[[package]]` config rule matched packages in two or more\n    /// ecosystems — almost always unintended; use an ecosystem-prefixed pattern instead.\n    BareRuleMatchesMultipleEcosystems,\n    /// `callisto matrix` found a platform triple in `napi.targets`/`[tool.maturin].targets`\n    /// that neither the shared triple-to-role table nor matrix's own host-runner table\n    /// recognizes — excluded from the report's `targets[]` rather than silently guessing.\n            json, r#\"\"changelog-read-error\"\"#,\n            \"DiagnosticCode::ChangelogReadError must serialize to \\\"changelog-read-error\\\"\",\n        );\n        let roundtrip: DiagnosticCode = serde_json::from_str(&json).unwrap();\n        assert_eq!(roundtrip, code, \"deserialized value must equal the original variant\",);\n    }\n\n    /// DiagnosticCode::BareRuleMatchesMultipleEcosystems must serialize\n    /// to the kebab-case string \"bare-rule-matches-multiple-ecosystems\" and\n    /// deserialize back to the same variant. The existing\n    /// `#[serde(rename_all = \"kebab-case\")]` on DiagnosticCode handles this\n    /// automatically — no per-variant annotation is needed.\n    #[test]\n    fn bare_rule_matches_multiple_ecosystems_serializes_to_kebab_case() {\n        let code = DiagnosticCode::BareRuleMatchesMultipleEcosystems;\n        let json = serde_json::to_string(&code).unwrap();\n        assert_eq!(\n            json,\n            r#\"\"bare-rule-matches-multiple-ecosystems\"\"#,\n            \"DiagnosticCode::BareRuleMatchesMultipleEcosystems must serialize to \\\"bare-rule-matches-multiple-ecosystems\\\"\",\n        );\n        let roundtrip: DiagnosticCode = serde_json::from_str(&json).unwrap();\n        assert_eq!(roundtrip, code, \"deserialized value must equal the original variant\",);\n    }\n\n      \"criterion\": \"With `--format json`, the status, add, init, pre and snapshot reports on stdout are single JSON objects with camelCase keys and a top-level `schemaVersion`, `command` (the subcommand name) and `dryRun`.\"\n    {\n      \"name\": \"Package id\",\n      \"signature\": \"PackageId = \\\"<name>\\\" | \\\"<ecosystem>/<name>\\\"\",\n      \"description\": \"Display and selector form: the bare manifest name, or `<ecosystem>/<name>` once another ecosystem declares the same name. JSON output, messages, changeset entries and `pre.json` keys use it; `<ecosystem>/<name>` selects the package whether or not it is promoted.\",\n      \"error_conditions\": [\n        \"A bare name shared by promoted packages is E103; a qualified name with no such manifest is E102.\"\n      ]","is_error":false}]},"uuid":"69922ae5-5155-402d-9b2c-1a40fa67fa7c","timestamp":"2026-10-21T20:11:00.331Z","toolUseResult":{"stdout":"    /// kept for wire compatibility.\n    ChangesetReadError,\n    /// Git repository or tag discovery failed. Not emitted since `plan-publish` was removed;\n    /// kept for wire compatibility.\n    GitDiscoveryFailed,\n    /// A bare (unprefixed) `[[package]]` config rule matched packages in two or more\n    /// ecosystems — almost always unintended; use an ecosystem-prefixed pattern instead.\n    BareRuleMatchesMultipleEcosystems,\n    /// `callisto matrix` found a platform triple in `napi.targets`/`[tool.maturin].targets`\n    /// that neither the shared triple-to-role table nor matrix's own host-runner table\n    /// recognizes — excluded from the report's `targets[]` rather than silently guessing.\n            json, r#\"\"changelog-read-error\"\"#,\n            \"DiagnosticCode::ChangelogReadError must serialize to \\\"changelog-read-error\\\"\",\n        );\n        let roundtrip: DiagnosticCode = serde_json::from_str(&json).unwrap();\n        assert_eq!(roundtrip, code, \"deserialized value must equal the original variant\",);\n    }\n\n    /// DiagnosticCode::BareRuleMatchesMultipleEcosystems must serialize\n    /// to the kebab-case string \"bare-rule-matches-multiple-ecosystems\" and\n    /// deserialize back to the same variant. The existing\n    /// `#[serde(rename_all = \"kebab-case\")]` on DiagnosticCode handles this\n    /// automatically — no per-variant annotation is needed.\n    #[test]\n    fn bare_rule_matches_multiple_ecosystems_serializes_to_kebab_case() {\n        let code = DiagnosticCode::BareRuleMatchesMultipleEcosystems;\n        let json = serde_json::to_string(&code).unwrap();\n        assert_eq!(\n            json,\n            r#\"\"bare-rule-matches-multiple-ecosystems\"\"#,\n            \"DiagnosticCode::BareRuleMatchesMultipleEcosystems must serialize to \\\"bare-rule-matches-multiple-ecosystems\\\"\",\n        );\n        let roundtrip: DiagnosticCode = serde_json::from_str(&json).unwrap();\n        assert_eq!(roundtrip, code, \"deserialized value must equal the original variant\",);\n    }\n\n      \"criterion\": \"With `--format json`, the status, add, init, pre and snapshot reports on stdout are single JSON objects with camelCase keys and a top-level `schemaVersion`, `command` (the subcommand name) and `dryRun`.\"\n    {\n      \"name\": \"Package id\",\n      \"signature\": \"PackageId = \\\"<name>\\\" | \\\"<ecosystem>/<name>\\\"\",\n      \"description\": \"Display and selector form: the bare manifest name, or `<ecosystem>/<name>` once another ecosystem declares the same name. JSON output, messages, changeset entries and `pre.json` keys use it; `<ecosystem>/<name>` selects the package whether or not it is promoted.\",\n      \"error_conditions\": [\n        \"A bare name shared by promoted packages is E103; a qualified name with no such manifest is E102.\"\n      ]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"b7588a16-f029-41f4-9a7d-0a87d4cbfd1c","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-canonical-emission","root":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-canonical-emission","branch":"worktree-t06-canonical-emission","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":19,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callisto","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-canonical-emission","platform":"macos"}},"sourceToolAssistantUUID":"beb6aeaa-22d3-4c51-8d7f-d6d86e3495fd","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-canonical-emission","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"worktree-t06-canonical-emission","slug":"lexical-jingling-puppy"}
