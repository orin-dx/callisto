tent, permit)\n            .map_err(|error| GraphError::ReleaseStateWrite {\n                path: self.path.clone(),\n                message: error.to_string(),\n            })\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use std::io;\n\n    use super::*;\n\n    #[derive(Clone, Copy, Debug)]\n    struct FailBeforeRename;\n\n    impl ReleaseReceiptWriter for FailBeforeRename {\n        fn write(&self, _path: &Path, _content: &str, _permit: &ApplyPermit) -> io::Result<()> {\n            Err(io::Error::other(\"injected pre-rename failure\"))\n        }\n    }\n\n    #[test]\n    fn store_has_only_an_explicit_path_and_atomic_writer_seam() {\n        let directory = tempfile::tempdir().unwrap();\n        let path = directory.path().join(\"receipt.json\");\n        let store = ReleaseReceiptStore::with_writer(&path, FailBeforeRename);\n        assert_eq!(store.path(), path);\n        assert_eq!(\n            std::fs::read_to_string(path).unwrap_err().kind(),\n            io::ErrorKind::NotFound\n        );\n    }\n}\n\n"},{"type":"input_text","text":"\n[77] tool exec call: const r = await tools.exec_command({cmd:\"rtk rg -n \\\"fn dispatch_prepared|pub\\\\(super\\\\) fn dispatch_prepared|pub fn validate_for_intent|impl CompleteObservationReceipt\\\" crates/callisto-graph/src/commands/release.rs crates/callisto-model/src/release.rs\",workdir:\"/private/tmp/callisto-release-recovery\",yield_time_ms:10000,max_output_tokens:16000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[78] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\ncrates/callisto-graph/src/commands/release.rs:501:    pub(crate) fn dispatch_prepared(\ncrates/callisto-model/src/release.rs:2070:        pub fn validate_for_intent(&self, intent: &ReleaseIntent) -> Result<(), ReleaseExecutionStateError> {\ncrates/callisto-model/src/release.rs:2688:        pub fn validate_for_intent(&self, intent: &ReleaseIntent) -> Result<(), SuccessorError> {\ncrates/callisto-model/src/release.rs:3383