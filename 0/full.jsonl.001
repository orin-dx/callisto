ace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --strict 'Enable strict mode: promote warning-level diagnostics to errors, causing a non-zero exit'\n         callisto-cli:test |             cand --strict-graph 'Treat dependency-graph warnings as errors'\n         callisto-cli:test |             cand --check 'Exit with a distinct status code indicating whether any changesets are pending'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;matrix'= {\n         callisto-cli:test |             cand --package 'Restrict output to one registered package''s name (PackageId::name())'\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;version'= {\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --refresh-lockfiles 'Regenerate lockfiles after applying the version bumps'\n         callisto-cli:test |             cand --strict 'Treat warning-level diagnostics as errors'\n         callisto-cli:test |             cand --strict-graph 'Tr