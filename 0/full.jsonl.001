{"type":"file-history-delta","messageId":"45f35ba1-4806-4604-b35c-9b3636282166","snapshotMessageId":"04394f46-f661-4838-b82b-85739f41259a","trackingPath":".changeset/identity-ecosystem-resolution.md","backup":{"backupFileName":null,"version":1,"backupTime":"2026-08-21T22:37:09.728Z","realParentDir":"/Users/gabe/Projects/callisto/.changeset"},"timestamp":"2026-08-21T22:37:09.750Z"}
{"parentUuid":"85837ac0-1070-4040-9613-83e4d80fb157","isSidechain":false,"message":{"model":"claude-sonnet-5","id":"msg_011CeGhCpTSw6gq9qSffAiai","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EJMnbkAtfUGspe3JNxn5yv","name":"Write","input":{"file_path":"/Users/gabe/Projects/callisto/.changeset/identity-ecosystem-resolution.md","content":"---\ncallisto-graph: minor\n---\n\n# Better cross-ecosystem package discovery\n\n- Cargo/npm/pnpm workspace membership is now honored during project discovery — fuzz targets and scratch examples excluded from a workspace stop showing up as release-managed packages.\n- Same-named packages in different ecosystems (a Rust crate and its Python binding, say) resolve correctly instead of erroring with a duplicate-package conflict.\n- `cargo:foo`/`npm:foo` ecosystem-prefixed group-member names now work.\n- A silent cross-ecosystem fallback in native-identity resolution (matching a same-named package in the wrong ecosystem when the intended lookup missed) has been removed.\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":472,"cache_read_input_tokens":218180,"output_tokens":341,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":472,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":341,"cache_read_input_tokens":218180,"cache_creation_input_tokens":472,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":472},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CeGhCoRS6BeWc7DrWn8Bc","type":"assistant","uuid":"45f35ba1-4806-4604-b35c-9b3636282166","timestamp":"2026-08-21T22:37:09.719Z","effort":"high","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"ext