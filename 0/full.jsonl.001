uman-readable summary of the change to record in the changeset' -r\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_using_subcommand add\" -l format -d 'Output format for command results' -r -f -a \"text\\t''\n         callisto-cli:test | json\\t''\"\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_using_subcommand add\" -l cwd -d 'Workspace directory to operate in (defaults to the current directory)' -r -F\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_using_subcommand add\" -l dry-run -d 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_using_subcommand add\" -s h -l help -d 'Print help'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_using_subcommand status\" -l format -d 'Output format for command results' -r -f -a \"text\\t''\n         callisto-cli:test | json\\t''\"\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_using_subcommand status\" -l cwd -d 'Workspace directory to operate in (defaults to the current directory)' -r -F\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_using_subcommand status\" -l strict -d 'Enable strict mode: promote warning-level diagnostics to errors, causing a non-zero exit'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_using_subcommand status\" -l strict-graph -d 'Treat dependency-graph warnings as errors'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_using_subcommand status\" -l check -d 'Exit with a distinct status code indicating whether any changesets are pending'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_using_subcommand status\" -l dry-run -d 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test | complete -c callisto -n \"__fish_callisto_using_subcommand status\" -s h -l help -d 'Print help'\n