d())\n                .stderr(std::process::Stdio::piped())\n                .spawn()\n                .map_err(|error| CommandError::Io {\n                    program: program.to_string(),\n                    message: error.to_s\u003ctruncated omitted_approx_tokens=\"6544\" /\u003e    if size \u003e MAX_ARCHIVE_ENTRY_BYTES {\n            return Err(invalid_artifact(\".crate archive entry exceeds the size bound\"));\n        }\n        total = total\n            .checked_add(size)\n            .ok_or_else(|| invalid_artifact(\".crate archive size overflow\"))?;\n        if total \u003e MAX_ARCHIVE_TOTAL_BYTES {\n            return Err(invalid_artifact(\".crate archive exceeds the expanded-size bound\"));\n        }\n        let path = entry.path().map_err(|error| invalid_artifact(error.to_string()))?;\n        validate_archive_path(\u0026path, expected_root)?;\n        if path == std::path::Path::new(expected_path) {\n            if selected.is_some() || !entry.header().entry_type().is_file() || size \u003e max_selected_bytes {\n                return Err(invalid_artifact(\n                    \"selected .crate metadata entry is duplicated or oversized\",\n                ));\n            }\n            let mut bytes = Vec::with_capacity(size as usize);\n            entry\n                .read_to_end(\u0026mut bytes)\n                .map_err(|error| invalid_artifact(error.to_string()))?;\n            selected = Some(bytes);\n        }\n    }\n    Ok(selected)\n}\n\nfn validate_archive_path(path: \u0026std::path::Path, expected_root: \u0026str) -\u003e Result\u003c(), GraphError\u003e {\n    let mut components = path.components();\n    if components.next() != Some(std::path::Component::Normal(expected_root.as_ref()))\n        || components.any(|component| !matches!(component, std::path::Component::Normal(_)))\n    {\n        return Err(invalid_artifact(\n            \".crate archive path escapes or changes its package root\",\n        ));\n    }\n    Ok(())\n}\n\n