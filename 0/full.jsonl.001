{"type":"api-request","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","id":"abbb9c0b-4d18-474b-bb35-09788059da87","timestamp":"2026-11-09T23:32:44.504Z","version":"2.1.311","querySource":"repl_main_thread:outputStyle:Concise","shapeHash":"3d38bda41afeaa80a7569742499e219aed533aeca653499439fd60bb5adbc429","params":{"model":"claude-sonnet-5-5","betas":["claude-code-20250219","oauth-2025-04-20","interleaved-thinking-2025-05-14","context-management-2025-06-27","prompt-caching-scope-2026-01-05","per-turn-control-2026-07-01","mid-conversation-tool-changes-2026-07-01","inline-tools-2026-09-15","advisor-tool-2026-03-01","thinking-token-count-2026-05-13","advanced-tool-use-2025-11-20","mid-conversation-system-clear-at-2026-08-21","effort-2025-11-24","dangerous-tool-use-2026-09-03","thinking-binding-controls-2026-08-01","thinking-display-updates-2026-08-18","afk-mode-2026-01-31","extended-cache-ttl-2025-04-11","cache-diagnosis-2026-04-07","message-threads-2026-08-12"],"max_tokens":128000,"thinking":{"type":"adaptive","display":"updates"},"context_management":{"edits":[{"type":"clear_thinking_20251015","keep":"all"}]},"output_config":{"effort":"medium"}},"base":"24f009b1-a288-4ac9-bb83-80eff397eb27","keep":605,"tail":["f4aadca07c36770eb7ea72462c17649ca6d4ca079f503981845d055ca1a95b83","491b2459976ed9c150ef84abc7c7182640f828b35468578b5d47cc012b7423f0","9e672f737c8f0cb9ef2d69d7b889f682a5168366108db95c1e4e82ba37be477e"],"cacheControl":[{"path":["system",1],"value":{"type":"ephemeral","ttl":"1h","scope":"global"}},{"path":["system",2],"value":{"type":"ephemeral","ttl":"1h"}},{"path":["messages",607,"content",0],"value":{"type":"ephemeral","ttl":"1h"}}],"requestDigest":"92666f16b14d25c7a5afae714802f75c4a048fc53331e178f4a852f9db308542"}
