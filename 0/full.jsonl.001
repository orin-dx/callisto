tionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format for command results')\n         callisto-cli:test |             [CompletionResult]::new('--cwd', '--cwd', [CompletionResultType]::ParameterName, 'Workspace directory to operate in (defaults to the current directory)')\n         callisto-cli:test |             [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Preview manifest and file changes without writing to disk')\n         callisto-cli:test |             [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;help' {\n         callisto-cli:test |             [CompletionResult]::new('add', 'add', [CompletionResultType]::ParameterValue, 'Create a new changeset describing pending package changes')\n         callisto-cli:test |             [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'Show the workspace''s pending changesets and diagnostics')\n         callisto-cli:test |             [CompletionResult]::new('matrix', 'matrix', [CompletionResultType]::ParameterValue, 'Print the workspace''s native-build target matrix as JSON or a table')\n         callisto-cli:test |             [CompletionResult]::new('version', 'version', [CompletionResultType]::ParameterValue, 'Consume pending changesets and bump package versions accordingly')\n         callisto-cli:test |             [CompletionResult]::new('pre', 'pre', [CompletionResultType]::ParameterValue, 'Manage prerelease mode for the workspace')\n         callisto-cli:test |             [CompletionResult]::new('validate', 'validate', [CompletionResultType]::ParameterValue, 'Check that changesets and