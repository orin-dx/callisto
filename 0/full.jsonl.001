{"parentUuid":"725db7c9-d34d-4499-9cde-4a37cf9b2410","isSidechain":false,"promptId":"3bc8f035-9064-4301-9122-df11c835d61d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ShXHKESKgrzoaA8TmRyMdq","type":"tool_result","content":"160\t        body.push_str(&format!(\n161\t            \"<details{}>\\n<summary><b>{}</b> <code>{}</code> → <code>{}</code> ({})</summary>\\n\\n\",\n162\t            open_attr,\n163\t            bump.package.display_name(),\n164\t            bump.from.render(),\n165\t            bump.to.render(),\n166\t            bump.severity\n167\t        ));\n168\t\n169\t        body.push_str(&format!(\n170\t            \"#### Version Change\\n`{}` ➔ `{}`\\n\\n\",\n171\t            bump.from.render(),\n172\t            bump.to.render()\n173\t        ));\n174\t\n175\t        if let Some(ref reason) = bump.reason {\n176\t            body.push_str(\"#### Release Reason\\n\");\n177\t            match reason {\n178\t                callisto_model::BumpReason::Changeset { changesets } => {\n179\t                    body.push_str(&format!(\n180\t                        \"- Associated changesets: `{}`\\n\\n\",\n181\t                        changesets.join(\"`, `\")\n182\t                    ));\n183\t                }\n184\t                callisto_model::BumpReason::Cascade {\n185\t                    via,\n186\t                    spec,\n187\t                    dependency_to,\n188\t                    ..\n189\t                } => {\n190\t                    body.push_str(&format!(\n191\t                        \"- Automatic dependency cascade triggered by `{}` (spec `{}` target `{}`).\\n\\n\",\n192\t                        via.display_name(),\n193\t                        spec,\n194\t                        dependency_to.render()\n195\t                    ));\n196\t                }\n197\t                callisto_model::BumpReason::PeerEscalation { via, spec } => {\n198\t                    body.push_str(&format!(\n199\t                        \"- Peer dependency escalation triggered by `{}` (spec `{}`).\\n\\n\",\n200\t                        via.display_name(),\n201\t                        spec\n202\t                    ));\n203\t                }\n204\t                callisto_model::BumpReason::FixedGroupUnion { group } => {\n205\t                    body.push_str(&format!(\n206\t                        \"- Fixed group synchronization for group `{}`.\\n\\n\",\n207\t                        group.as_str()\n208\t                    ));\n209\t                }\n210\t                callisto_model::BumpReason::LinkedGroupUnion { group } => {\n211\t                    body.push_str(&format!(\n212\t                        \"- Linked group version alignment for group `{}`.\\n\\n\",\n213\t                        group.as_str()\n214\t                    ));\n215\t                }\n216\t                _ => {}\n217\t            }\n218\t        }\n219\t\n220\t        body.push_str(\"</details>\\n\\n\");\n221\t    }\n222\t\n223\t    // 4. Instructions Footer\n224\t    let branch = opts\n225\t        .branch\n226\t        .as_deref()\n227\t        .unwrap_or(\"callisto/version-packages\");\n228\t    body.push_str(\"<details>\\n<summary><b>Release Workflow Instructions</b></summary>\\n\\n\");\n229\t    body.push_str(\"- **Merging this PR**: Merging into `main` will automatically publish all updated packages to their release registries.\\n\");"}]},"uuid":"d1d61a0d-6918-4fe4-8b47-2a2ee166c020","timestamp":"2026-08-20T23:30:35.020Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/commands/pr_body.rs","content":"        body.push_str(&format!(\n            \"<details{}>\\n<summary><b>{}</b> <code>{}</code> → <code>{}</code> ({})</summary>\\n\\n\",\n            open_attr,\n            bump.package.display_name(),\n            bump.from.render(),\n            bump.to.render(),\n            bump.severity\n        ));\n\n        body.push_str(&format!(\n            \"#### Version Change\\n`{}` ➔ `{}`\\n\\n\",\n            bump.from.render(),\n            bump.to.render()\n        ));\n\n        if let Some(ref reason) = bump.reason {\n            body.push_str(\"#### Release Reason\\n\");\n            match reason {\n                callisto_model::BumpReason::Changeset { changesets } => {\n                    body.push_str(&format!(\n                        \"- Associated changesets: `{}`\\n\\n\",\n                        changesets.join(\"`, `\")\n                    ));\n                }\n                callisto_model::BumpReason::Cascade {\n                    via,\n                    spec,\n                    dependency_to,\n                    ..\n                } => {\n                    body.push_str(&format!(\n                        \"- Automatic dependency cascade triggered by `{}` (spec `{}` target `{}`).\\n\\n\",\n                        via.display_name(),\n                        spec,\n                        dependency_to.render()\n                    ));\n                }\n                callisto_model::BumpReason::PeerEscalation { via, spec } => {\n                    body.push_str(&format!(\n                        \"- Peer dependency escalation triggered by `{}` (spec `{}`).\\n\\n\",\n                        via.display_name(),\n                        spec\n                    ));\n                }\n                callisto_model::BumpReason::FixedGroupUnion { group } => {\n                    body.push_str(&format!(\n                        \"- Fixed group synchronization for group `{}`.\\n\\n\",\n                        group.as_str()\n                    ));\n                }\n                callisto_model::BumpReason::LinkedGroupUnion { group } => {\n                    body.push_str(&format!(\n                        \"- Linked group version alignment for group `{}`.\\n\\n\",\n                        group.as_str()\n                    ));\n                }\n                _ => {}\n            }\n        }\n\n        body.push_str(\"</details>\\n\\n\");\n    }\n\n    // 4. Instructions Footer\n    let branch = opts\n        .branch\n        .as_deref()\n        .unwrap_or(\"callisto/version-packages\");\n    body.push_str(\"<details>\\n<summary><b>Release Workflow Instructions</b></summary>\\n\\n\");\n    body.push_str(\"- **Merging this PR**: Merging into `main` will automatically publish all updated packages to their release registries.\\n\");","numLines":70,"startLine":160,"totalLines":323}},"sourceToolAssistantUUID":"725db7c9-d34d-4499-9cde-4a37cf9b2410","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"main","slug":"shimmying-giggling-hickey"}
