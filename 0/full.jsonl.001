 credentials, then retry observation before applying any effect.\\\")\\n+    )]\\n+    ReleaseObservationUnverifiable {\\n+        operation: callisto_model::ReleaseOperationId,\\n+    },\\n+\\n+    #[error(\\\"release operation `{operation:?}` is not the exact missing work authorized by provider observation\\\")]\\n+    #[diagnostic(\\n+        code(E174),\\n+        help(\\\"Run reconciliation in dependency order; Callisto did not apply work whose prerequisites remain missing.\\\")\\n+    )]\\n+    ReleaseOperationNotMissing {\\n+        operation: callisto_model::ReleaseOperationId,\\n+    },\\n }\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n","type":"input_text"},{"text":"\n[81] tool exec result: Script completed\nWall time 3.3 seconds\nOutput:\n\n{}\n","type":"input_text"},{"text":"\n[82] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/commands/release.rs\\n@@\\n use callisto_model::{\\n-    ApplyPermit, ApprovedRegistryArtifact, CanonicalTranscript, CommandOutput, CommandRunner, CommitSha, Ecosystem,\\n+    ApplyPermit, ApprovedRegistryArtifact, CanonicalTranscript, CommandRunner, CommitSha, Ecosystem,\\n@@\\n use callisto_vcs::{\\n     access::{GitCommitTrustEvidence, GitHeadDisposition},\\n     release_lock::ReleaseWorkspaceLock,\\n-    GitAccess, GitDataSource, TagSignPolicy,\\n+    GitDataSource, TagSignPolicy,\\n };\\n \\n use crate::error::{\\n-    CommandFailure, ReleasePreconditionRequirement, ReleaseSelectionInvalidReason, RemoteConflict,\\n-    UnsupportedReleaseFeature,\\n+    CommandFailure, ReleasePreconditionRequirement, ReleaseSelectionInvalidReason, UnsupportedReleaseFeature,\\n };\\n use crate::{commands::registry_argv, DependencyResolver, GraphError, ProjectLocator, Workspace};\\n+\\n+use super::{\\n+    registry_artifacts::{cargo_upload_body, CargoAuthorizationHeader, PrivateArtifactFile},\\n+    release_artifacts::ValidatedArtifactManifest,\\