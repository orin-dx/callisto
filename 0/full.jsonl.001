{"parentUuid":"4a782212-ccfa-4ce9-96b4-8c18383031f1","isSidechain":false,"promptId":"df66e765-0060-4a70-b502-7d0857514317","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DpC2Mjm78Hn8bYj5rGLjAh","type":"tool_result","content":"      \"criterion\": \"A spec that no longer covers the new version is rewritten to it, keeping the operator and precision for Cargo and npm (`^1.2` becomes `^2.0` for 2.0.0), or to the exact version for npm when `preserve-npm-ranges = false`. A runtime, optional, build or peer dependent that is itself released in this run, for any reason, has every such spec on a bumped internal dependency raised to the dependency's new version the same way, even when the spec still covers it; a dependent that is not releasing keeps its spec unless out of range. `workspace = true`, pnpm rolling `workspace:` shorthands and catalog specs are never rewritten by either rule; an out-of-range pnpm explicit range is rewritten while retaining its `workspace:` protocol and alias. A dev dependent's spec is rewritten only when out of range. A spec that cannot be rewritten mechanically, such as an npm range with spaces, `||`, a hyphen or a wildcard, is left unchanged with a RangeNotRoundTrippable warning.\"","is_error":false}]},"uuid":"44561f22-011e-4d8b-8f14-281a921f82ce","timestamp":"2026-10-21T19:36:45.973Z","toolUseResult":{"stdout":"      \"criterion\": \"A spec that no longer covers the new version is rewritten to it, keeping the operator and precision for Cargo and npm (`^1.2` becomes `^2.0` for 2.0.0), or to the exact version for npm when `preserve-npm-ranges = false`. A runtime, optional, build or peer dependent that is itself released in this run, for any reason, has every such spec on a bumped internal dependency raised to the dependency's new version the same way, even when the spec still covers it; a dependent that is not releasing keeps its spec unless out of range. `workspace = true`, pnpm rolling `workspace:` shorthands and catalog specs are never rewritten by either rule; an out-of-range pnpm explicit range is rewritten while retaining its `workspace:` protocol and alias. A dev dependent's spec is rewritten only when out of range. A spec that cannot be rewritten mechanically, such as an npm range with spaces, `||`, a hyphen or a wildcard, is left unchanged with a RangeNotRoundTrippable warning.\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"349f21a3-43fd-4c2f-905a-21c31e665d24","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/range-hard-stop","root":"/Users/gabe/Projects/callisto/.claude/worktrees/range-hard-stop","branch":"worktree-range-hard-stop","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":7,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callisto","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/range-hard-stop","platform":"macos"}},"sourceToolAssistantUUID":"4a782212-ccfa-4ce9-96b4-8c18383031f1","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/range-hard-stop","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"worktree-range-hard-stop","slug":"lexical-jingling-puppy"}
