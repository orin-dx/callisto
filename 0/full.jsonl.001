{"parentUuid":"f3058e72-9473-4375-bfda-5c3cc2a61dfd","isSidechain":false,"promptId":"f5c3712b-9d58-46b9-ad02-83bddc7fe7dc","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VcP18ecGiZGAf5A4bWoXvn","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# Regression test for the \"Inspecting Workspace Status\" step's exit-code\n3\t# branching in action.yml (AC-01, AC-02, AC-04). Extracts the exact run-body\n4\t# text between the step's ::group::1. Inspecting Workspace Status marker and\n5\t# its matching ::endgroup:: marker directly out of action.yml, so this test\n6\t# always exercises the file's current real logic -- it cannot drift from it.\n7\tset -u\n8\tACTION_YML=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)/action.yml\"\n9\t\n10\textract_snippet() {\n11\t  sed -n '/::group::1\\. Inspecting Workspace Status/,/::endgroup::/p' \"$ACTION_YML\" | sed '1d;$d'\n12\t}\n13\t\n14\trun_case() {\n15\t  local stub_exit=\"$1\"\n16\t  local tmp_script\n17\t  tmp_script=\"$(mktemp)\"\n18\t  {\n19\t    echo \"callisto() { return ${stub_exit}; }\"\n20\t    extract_snippet\n21\t    echo 'echo \"__HAS_CHANGESETS=${HAS_CHANGESETS-<unset>}__\"'\n22\t  } > \"$tmp_script\"\n23\t  bash \"$tmp_script\"\n24\t  local code=$?\n25\t  rm -f \"$tmp_script\"\n26\t  return $code\n27\t}\n28\t\n29\tfail=0\n30\t\n31\t# AC-01: exit 1 -> HAS_CHANGESETS=true, step must not fail.\n32\tout=$(run_case 1); code=$?\n33\tif [[ $code -ne 0 ]] || [[ \"$out\" != *\"__HAS_CHANGESETS=true__\"* ]]; then\n34\t  echo \"FAIL AC-01: exit 1 case: code=$code out=$out\"; fail=1\n35\telse\n36\t  echo \"PASS AC-01\"\n37\tfi\n38\t\n39\t# AC-02: exit 2 -> HAS_CHANGESETS=false, step must not fail.\n40\tout=$(run_case 2); code=$?\n41\tif [[ $code -ne 0 ]] || [[ \"$out\" != *\"__HAS_CHANGESETS=false__\"* ]]; then\n42\t  echo \"FAIL AC-02: exit 2 case: code=$code out=$out\"; fail=1\n43\telse\n44\t  echo \"PASS AC-02\"\n45\tfi\n46\t\n47\t# AC-04: exit 0 -> step must fail (non-zero), HAS_CHANGESETS never read.\n48\tout=$(run_case 0); code=$?\n49\tif [[ $code -eq 0 ]] || [[ \"$out\" == *\"__HAS_CHANGESETS=true__\"* ]] || [[ \"$out\" == *\"__HAS_CHANGESETS=false__\"* ]]; then\n50\t  echo \"FAIL AC-04 (exit 0): code=$code out=$out\"; fail=1\n51\telse\n52\t  echo \"PASS AC-04 (exit 0)\"\n53\tfi\n54\t\n55\t# AC-04: exit 127 -> same requirement, a different unrecognised code.\n56\tout=$(run_case 127); code=$?\n57\tif [[ $code -eq 0 ]] || [[ \"$out\" == *\"__HAS_CHANGESETS=true__\"* ]] || [[ \"$out\" == *\"__HAS_CHANGESETS=false__\"* ]]; then\n58\t  echo \"FAIL AC-04 (exit 127): code=$code out=$out\"; fail=1\n59\telse\n60\t  echo \"PASS AC-04 (exit 127)\"\n61\tfi\n62\t\n63\texit $fail\n64\t"}]},"uuid":"8100c2c7-7a9e-48e6-9a60-743ff2f55f38","timestamp":"2026-08-21T21:40:17.206Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.github/actions/callisto-action/tests/test_status_check_branching.sh","content":"#!/usr/bin/env bash\n# Regression test for the \"Inspecting Workspace Status\" step's exit-code\n# branching in action.yml (AC-01, AC-02, AC-04). Extracts the exact run-body\n# text between the step's ::group::1. Inspecting Workspace Status marker and\n# its matching ::endgroup:: marker directly out of action.yml, so this test\n# always exercises the file's current real logic -- it cannot drift from it.\nset -u\nACTION_YML=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)/action.yml\"\n\nextract_snippet() {\n  sed -n '/::group::1\\. Inspecting Workspace Status/,/::endgroup::/p' \"$ACTION_YML\" | sed '1d;$d'\n}\n\nrun_case() {\n  local stub_exit=\"$1\"\n  local tmp_script\n  tmp_script=\"$(mktemp)\"\n  {\n    echo \"callisto() { return ${stub_exit}; }\"\n    extract_snippet\n    echo 'echo \"__HAS_CHANGESETS=${HAS_CHANGESETS-<unset>}__\"'\n  } > \"$tmp_script\"\n  bash \"$tmp_script\"\n  local code=$?\n  rm -f \"$tmp_script\"\n  return $code\n}\n\nfail=0\n\n# AC-01: exit 1 -> HAS_CHANGESETS=true, step must not fail.\nout=$(run_case 1); code=$?\nif [[ $code -ne 0 ]] || [[ \"$out\" != *\"__HAS_CHANGESETS=true__\"* ]]; then\n  echo \"FAIL AC-01: exit 1 case: code=$code out=$out\"; fail=1\nelse\n  echo \"PASS AC-01\"\nfi\n\n# AC-02: exit 2 -> HAS_CHANGESETS=false, step must not fail.\nout=$(run_case 2); code=$?\nif [[ $code -ne 0 ]] || [[ \"$out\" != *\"__HAS_CHANGESETS=false__\"* ]]; then\n  echo \"FAIL AC-02: exit 2 case: code=$code out=$out\"; fail=1\nelse\n  echo \"PASS AC-02\"\nfi\n\n# AC-04: exit 0 -> step must fail (non-zero), HAS_CHANGESETS never read.\nout=$(run_case 0); code=$?\nif [[ $code -eq 0 ]] || [[ \"$out\" == *\"__HAS_CHANGESETS=true__\"* ]] || [[ \"$out\" == *\"__HAS_CHANGESETS=false__\"* ]]; then\n  echo \"FAIL AC-04 (exit 0): code=$code out=$out\"; fail=1\nelse\n  echo \"PASS AC-04 (exit 0)\"\nfi\n\n# AC-04: exit 127 -> same requirement, a different unrecognised code.\nout=$(run_case 127); code=$?\nif [[ $code -eq 0 ]] || [[ \"$out\" == *\"__HAS_CHANGESETS=true__\"* ]] || [[ \"$out\" == *\"__HAS_CHANGESETS=false__\"* ]]; then\n  echo \"FAIL AC-04 (exit 127): code=$code out=$out\"; fail=1\nelse\n  echo \"PASS AC-04 (exit 127)\"\nfi\n\nexit $fail\n","numLines":64,"startLine":1,"totalLines":64}},"sourceToolAssistantUUID":"f3058e72-9473-4375-bfda-5c3cc2a61dfd","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
