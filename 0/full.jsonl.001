osystem_diagnostic_test.rs:199:        \"prefixed rules must not trigger BareRuleMatchesMultipleEcosystems; \\\n./crates/callisto-graph/tests/cross_ecosystem_diagnostic_test.rs:234:        .filter(|d| d.code == DiagnosticCode::BareRuleMatchesMultipleEcosystems)\n./crates/callisto-graph/tests/cross_ecosystem_diagnostic_test.rs:240:        \"[[package-set]] rules must not trigger BareRuleMatchesMultipleEcosystems; \\\n./crates/callisto-graph/tests/cross_ecosystem_diagnostic_test.rs:247:/// no BareRuleMatchesMultipleEcosystems diagnostic is present. The diagnostic\n./crates/callisto-graph/tests/cross_ecosystem_diagnostic_test.rs:275:        .filter(|d| d.code == DiagnosticCode::BareRuleMatchesMultipleEcosystems)\n./crates/callisto-graph/tests/cross_ecosystem_diagnostic_test.rs:310:        .filter(|d| d.code == DiagnosticCode::BareRuleMatchesMultipleEcosystems)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"49e21672-e276-45de-a51b-ada9689b0b55","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-canonical-config/crates/callisto-graph/tests","root":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-canonical-config","branch":"worktree-t06-canonical-config","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":29,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callisto","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-canonical-config/crates/callisto-graph/tests","platform":"macos"}},"sourceToolAssistantUUID":"88466a39-4ca6-465d-b364-eb3fb7f14062","permissionDecision":{"decision":"accept","source":"config","reaso