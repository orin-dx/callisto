{"parentUuid":"ce25678e-3ef0-4080-b6aa-d00b8675e13c","isSidechain":false,"promptId":"70114f87-e957-4ebe-a1f1-479e2d3bda05","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CwrbUByUWR7bFhBKyKkytP","type":"tool_result","content":"1\tuse callisto_model::{\n2\t    ApplyPermit, CommandRunner, CreatedTag, PublishPlan, TagReport, SCHEMA_VERSION,\n3\t};\n4\tuse callisto_vcs::{GitDataSource, VcsError};\n5\t\n6\tuse crate::error::GraphError;\n7\tuse crate::resolver::DependencyResolver;\n8\tuse crate::Workspace;\n9\t\n10\t#[derive(Clone, Debug, Default)]\n11\tpub struct TagOptions {\n12\t    pub floating_major: bool,\n13\t}\n14\t\n15\tpub fn create_tags<R: CommandRunner, D: DependencyResolver>(\n16\t    ws: &Workspace<'_, R, D>,\n17\t    plan: &PublishPlan,\n18\t    permit: Option<&ApplyPermit>,\n19\t) -> Result<TagReport, GraphError> {\n20\t    create_tags_with_options(ws, plan, &TagOptions::default(), permit)\n21\t}\n22\t\n23\t/// Creates one git tag per release in `plan`.\n24\t///\n25\t/// `permit` is the dry-run gate: `None` reports the tags that *would* be\n26\t/// created without touching a single ref, `Some` creates them. It replaces the\n27\t/// former `TagOptions::dry_run` bool so that the preview branch and the write\n28\t/// branch cannot disagree -- the write calls simply do not typecheck without a\n29\t/// permit in hand.\n30\tpub fn create_tags_with_options<R: CommandRunner, D: DependencyResolver>(\n31\t    ws: &Workspace<'_, R, D>,\n32\t    plan: &PublishPlan,\n33\t    opts: &TagOptions,\n34\t    permit: Option<&ApplyPermit>,\n35\t) -> Result<TagReport, GraphError> {\n36\t    let mut tags = Vec::new();\n37\t\n38\t    // `Workspace::git_access` never hard-fails on a missing gix discovery:\n39\t    // `wasm32` has no gix at all (excluded from that target's dependency\n40\t    // set), and even natively a failed discovery just means every op below\n41\t    // runs through the `CommandRunner` fallback instead. Its write\n42\t    // operations (`create_tag`/`create_floating_major`) additionally\n43\t    // guarantee a discovered repo's result is authoritative and never\n44\t    // masked by a shell retry -- see `GitAccess`'s doc comment. Sharing the\n45\t    // workspace-scoped instance (rather than a fresh `GitAccess::discover`)\n46\t    // means this command doesn't pay for a second discovery when `ws.tags()`\n47\t    // below also needs one.\n48\t    let git = ws.git_access();\n49\t\n50\t    for release in &plan.releases {\n51\t        let tag_str = release.tag_name.as_str();\n52\t\n53\t        let Some(permit) = permit else {\n54\t            if opts.floating_major {\n55\t                let tmpl = ws.tags()?.template(&release.package);\n56\t                if let Some(v_str) = tmpl.extract_version_str(release.tag_name.as_str()) {\n57\t                    let grammar = ws\n58\t                        .graph\n59\t                        .packages()\n60\t                        .find(|p| p.id == release.package)\n61\t                        .and_then(|p| p.version_grammar().ok())\n62\t                        .unwrap_or(callisto_model::VersionGrammar::SemVer);\n63\t                    if let Ok(ver) = callisto_model::Version::parse(v_str, grammar) {\n64\t                        if let Some(major_tag) = tmpl.render_floating_major(&ver) {\n65\t                            let major_already_existed = ws.tags()?.contains_tag(major_tag.as_str());\n66\t                            tags.push(CreatedTag {\n67\t                                package: release.package.clone(),\n68\t                                tag_name: major_tag,\n69\t                                sha: release.sha.clone(),\n70\t                                already_existed: major_already_existed,\n71\t                            });\n72\t                        }\n73\t                    }\n74\t                }\n75\t            }\n76\t\n77\t            let already_existed = ws.tags()?.contains_tag(tag_str);\n78\t            let sha = if already_existed {\n79\t                match git.resolve_commit(tag_str)? {\n80\t                    Some(actual) => actual,\n81\t                    None => {\n82\t                        return Err(GraphError::Vcs(VcsError::RefNotFound {\n83\t                            ref_name: tag_str.to_string(),\n84\t                        }))\n85\t                    }\n86\t                }\n87\t            } else {\n88\t                release.sha.clone()\n89\t            };\n90\t\n91\t            tags.push(CreatedTag {\n92\t                package: release.package.clone(),\n93\t                tag_name: release.tag_name.clone(),\n94\t                sha,\n95\t                already_existed,\n96\t            });\n97\t            continue;\n98\t        };\n99\t\n100\t        let already_existed = ws.tags()?.contains_tag(tag_str);\n101\t\n102\t        let sha = if already_existed {\n103\t            match git.resolve_commit(tag_str)? {\n104\t                Some(actual) => actual,\n105\t                None => {\n106\t                    return Err(GraphError::Vcs(VcsError::RefNotFound {\n107\t                        ref_name: tag_str.to_string(),\n108\t                    }))\n109\t                }\n110\t            }\n111\t        } else {\n112\t            let msg = format!(\"Release {}\", tag_str);\n113\t            git.create_tag(tag_str, &release.sha, Some(&msg), permit)?;\n114\t            release.sha.clone()\n115\t        };\n116\t\n117\t        if opts.floating_major {\n118\t            let tmpl = ws.tags()?.template(&release.package);\n119\t            let ver_str = tmpl.extract_version_str(release.tag_name.as_str());\n120\t            let grammar = ws\n121\t                .graph\n122\t                .packages()\n123\t                .find(|p| p.id == release.package)\n124\t                .and_then(|p| p.version_grammar().ok())\n125\t                .unwrap_or(callisto_model::VersionGrammar::SemVer);\n126\t\n127\t            if let Some(v_str) = ver_str {\n128\t                if let Ok(ver) = callisto_model::Version::parse(v_str, grammar) {\n129\t                    if let Some(major_tag) = tmpl.render_floating_major(&ver) {\n130\t                        let major_already_existed = ws.tags()?.contains_tag(major_tag.as_str());\n131\t                        git.create_floating_major(major_tag.as_str(), &release.sha, permit)?;\n132\t                        tags.push(CreatedTag {\n133\t                            package: release.package.clone(),\n134\t                            tag_name: major_tag,\n135\t                            sha: release.sha.clone(),\n136\t                            already_existed: major_already_existed,\n137\t                        });\n138\t                    }\n139\t                }\n140\t            }\n141\t        }\n142\t\n143\t        tags.push(CreatedTag {\n144\t            package: release.package.clone(),\n145\t            tag_name: release.tag_name.clone(),\n146\t            sha,\n147\t            already_existed,\n148\t        });\n149\t    }\n150\t\n151\t    Ok(TagReport {\n152\t        schema_version: SCHEMA_VERSION,\n153\t        tags,\n154\t        diagnostics: Vec::new(),\n155\t    })\n156\t}\n157\t"}]},"uuid":"114112f7-1dd8-4838-b37f-90575ecb8bab","timestamp":"2026-08-21T13:49:40.950Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/commands/tag.rs","content":"use callisto_model::{\n    ApplyPermit, CommandRunner, CreatedTag, PublishPlan, TagReport, SCHEMA_VERSION,\n};\nuse callisto_vcs::{GitDataSource, VcsError};\n\nuse crate::error::GraphError;\nuse crate::resolver::DependencyResolver;\nuse crate::Workspace;\n\n#[derive(Clone, Debug, Default)]\npub struct TagOptions {\n    pub floating_major: bool,\n}\n\npub fn create_tags<R: CommandRunner, D: DependencyResolver>(\n    ws: &Workspace<'_, R, D>,\n    plan: &PublishPlan,\n    permit: Option<&ApplyPermit>,\n) -> Result<TagReport, GraphError> {\n    create_tags_with_options(ws, plan, &TagOptions::default(), permit)\n}\n\n/// Creates one git tag per release in `plan`.\n///\n/// `permit` is the dry-run gate: `None` reports the tags that *would* be\n/// created without touching a single ref, `Some` creates them. It replaces the\n/// former `TagOptions::dry_run` bool so that the preview branch and the write\n/// branch cannot disagree -- the write calls simply do not typecheck without a\n/// permit in hand.\npub fn create_tags_with_options<R: CommandRunner, D: DependencyResolver>(\n    ws: &Workspace<'_, R, D>,\n    plan: &PublishPlan,\n    opts: &TagOptions,\n    permit: Option<&ApplyPermit>,\n) -> Result<TagReport, GraphError> {\n    let mut tags = Vec::new();\n\n    // `Workspace::git_access` never hard-fails on a missing gix discovery:\n    // `wasm32` has no gix at all (excluded from that target's dependency\n    // set), and even natively a failed discovery just means every op below\n    // runs through the `CommandRunner` fallback instead. Its write\n    // operations (`create_tag`/`create_floating_major`) additionally\n    // guarantee a discovered repo's result is authoritative and never\n    // masked by a shell retry -- see `GitAccess`'s doc comment. Sharing the\n    // workspace-scoped instance (rather than a fresh `GitAccess::discover`)\n    // means this command doesn't pay for a second discovery when `ws.tags()`\n    // below also needs one.\n    let git = ws.git_access();\n\n    for release in &plan.releases {\n        let tag_str = release.tag_name.as_str();\n\n        let Some(permit) = permit else {\n            if opts.floating_major {\n                let tmpl = ws.tags()?.template(&release.package);\n                if let Some(v_str) = tmpl.extract_version_str(release.tag_name.as_str()) {\n                    let grammar = ws\n                        .graph\n                        .packages()\n                        .find(|p| p.id == release.package)\n                        .and_then(|p| p.version_grammar().ok())\n                        .unwrap_or(callisto_model::VersionGrammar::SemVer);\n                    if let Ok(ver) = callisto_model::Version::parse(v_str, grammar) {\n                        if let Some(major_tag) = tmpl.render_floating_major(&ver) {\n                            let major_already_existed = ws.tags()?.contains_tag(major_tag.as_str());\n                            tags.push(CreatedTag {\n                                package: release.package.clone(),\n                                tag_name: major_tag,\n                                sha: release.sha.clone(),\n                                already_existed: major_already_existed,\n                            });\n                        }\n                    }\n                }\n            }\n\n            let already_existed = ws.tags()?.contains_tag(tag_str);\n            let sha = if already_existed {\n                match git.resolve_commit(tag_str)? {\n                    Some(actual) => actual,\n                    None => {\n                        return Err(GraphError::Vcs(VcsError::RefNotFound {\n                            ref_name: tag_str.to_string(),\n                        }))\n                    }\n                }\n            } else {\n                release.sha.clone()\n            };\n\n            tags.push(CreatedTag {\n                package: release.package.clone(),\n                tag_name: release.tag_name.clone(),\n                sha,\n                already_existed,\n            });\n            continue;\n        };\n\n        let already_existed = ws.tags()?.contains_tag(tag_str);\n\n        let sha = if already_existed {\n            match git.resolve_commit(tag_str)? {\n                Some(actual) => actual,\n                None => {\n                    return Err(GraphError::Vcs(VcsError::RefNotFound {\n                        ref_name: tag_str.to_string(),\n                    }))\n                }\n            }\n        } else {\n            let msg = format!(\"Release {}\", tag_str);\n            git.create_tag(tag_str, &release.sha, Some(&msg), permit)?;\n            release.sha.clone()\n        };\n\n        if opts.floating_major {\n            let tmpl = ws.tags()?.template(&release.package);\n            let ver_str = tmpl.extract_version_str(release.tag_name.as_str());\n            let grammar = ws\n                .graph\n                .packages()\n                .find(|p| p.id == release.package)\n                .and_then(|p| p.version_grammar().ok())\n                .unwrap_or(callisto_model::VersionGrammar::SemVer);\n\n            if let Some(v_str) = ver_str {\n                if let Ok(ver) = callisto_model::Version::parse(v_str, grammar) {\n                    if let Some(major_tag) = tmpl.render_floating_major(&ver) {\n                        let major_already_existed = ws.tags()?.contains_tag(major_tag.as_str());\n                        git.create_floating_major(major_tag.as_str(), &release.sha, permit)?;\n                        tags.push(CreatedTag {\n                            package: release.package.clone(),\n                            tag_name: major_tag,\n                            sha: release.sha.clone(),\n                            already_existed: major_already_existed,\n                        });\n                    }\n                }\n            }\n        }\n\n        tags.push(CreatedTag {\n            package: release.package.clone(),\n            tag_name: release.tag_name.clone(),\n            sha,\n            already_existed,\n        });\n    }\n\n    Ok(TagReport {\n        schema_version: SCHEMA_VERSION,\n        tags,\n        diagnostics: Vec::new(),\n    })\n}\n","numLines":157,"startLine":1,"totalLines":157}},"sourceToolAssistantUUID":"ce25678e-3ef0-4080-b6aa-d00b8675e13c","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
