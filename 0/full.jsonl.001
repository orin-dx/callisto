overned_by.clone(),\n                reason: b.reason.clone(),\n            });\n        }\n\n        VersionReport {\n            schema_version: SCHEMA_VERSION,\n            bumps,\n            lockfile_refresh_results: lockfiles,\n            diagnostics: self.diagnostics.clone(),\n        }\n    }''', '''    pub fn to_report(&self, ids: &ReportIds, lockfiles: Option<Vec<LockfileRefreshResult>>) -> VersionReport {\n        let mut bumps = Vec::new();\n        for b in &self.bumps {\n            let mut reason = b.reason.clone();\n            if let Some(reason) = &mut reason {\n                ids.reason(reason);\n            }\n            bumps.push(BumpRecord {\n                package: ids.of(&b.package),\n                from: b.from.clone(),\n                to: b.to.clone(),\n                severity: b.severity,\n                governed_by: b.governed_by.clone(),\n                reason,\n            });\n        }\n        let mut diagnostics = self.diagnostics.clone();\n        ids.diagnostics(&mut diagnostics);\n\n        VersionReport {\n            schema_version: PACKAGE_REPORT_SCHEMA_VERSION,\n            bumps,\n            lockfile_refresh_results: lockfiles,\n            diagnostics,\n        }\n    }''')\n\n# graph lib: Workspace::report_ids + re-export\nlib = 'crates/callisto-graph/src/lib.rs'\nrep(lib, '''    /// Returns the workspace's [`TagIndex`], building it on first access and''', '''    /// Each package's id as reports print it.\n    pub fn report_ids(&self) -> plan::ReportIds {\n        plan::ReportIds::new(self.graph.packages())\n    }\n\n    /// Returns the workspace's [`TagIndex`], building it on first access and''')\n\n# status\nst = 'crates/callisto-graph/src/commands/status.rs'\nrep(st, '''    let mut packages = Vec::new();\n    let base_versions = ws.base_versions()?;''', '''    let mut packages = Vec::new();\n    let ids = ws.report_ids();\n    let base_versions = ws.base_versions()?;''')\nrep(st, '''        packages.push(call