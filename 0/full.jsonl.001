-c80b11c22d71ceac","resolvedModel":"claude-haiku-4-5-20251001","teammate_id":"pr495-body@session-6cc3e47b","agent_id":"apr495-body-c80b11c22d71ceac","agent_type":"courier:pr-narrator","model":"claude-haiku-4-5-20251001","name":"pr495-body","color":"orange","tmux_session_name":"in-process","tmux_window_name":"in-process","tmux_pane_id":"in-process","team_name":"session-6cc3e47b","is_splitpane":false,"plan_mode_required":false},"serverClassifierContext":{"request":"ea8321bd-9a42-4acf-b893-698dd6dec09a","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/changeset-process","root":"/Users/gabe/Projects/callisto/.claude/worktrees/changeset-process","branch":"docs/changeset-process","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callisto","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/changeset-process","platform":"macos"}},"sourceToolAssistantUUID":"c152b7ad-8ec0-4abf-b25d-77dc833d5198","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/changeset-process","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"docs/changeset-process","slug":"mossy-snacking-stream"}
