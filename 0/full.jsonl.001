.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: taiki-e/install-action@7623a79cdfecb99d681017af368ca353d9f49bb5 # v2\n        with:\n          tool: just@1.58.0\n      - uses: moonrepo/setup-toolchain@261c62cb5b0f580c7be7c8cd0f023a2e96756095 # v0\n      - uses: orin-dx/actions/setup-rust@2521888266780dabc7f5fd4c32b02d6ab82849db # v1.1\n        with:\n          components: clippy\n      - run: just lint\n      - run: just doc-check\n\n  test:\n    name: Test Suite (${{ matrix.os }})\n    runs-on: ${{ matrix.os }}\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-latest, macos-latest]\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: taiki-e/install-action@7623a79cdfecb99d681017af368ca353d9f49bb5 # v2\n        with:\n          tool: just@1.58.0\n      - uses: moonrepo/setup-toolchain@261c62cb5b0f580c7be7c8cd0f023a2e96756095 # v0\n      - uses: orin-dx/actions/setup-rust@2521888266780dabc7f5fd4c32b02d6ab82849db # v1.1\n      - uses: taiki-e/install-action@7623a79cdfecb99d681017af368ca353d9f49bb5 # v2\n        with:\n          tool: cargo-nextest\n      # Real-registry e2e runs on Linux only; the tests skip elsewhere.\n      - name: Install Verdaccio (real-registry npm e2e coverage)\n        if: runner.os == 'Linux'\n        run: npm install -g verdaccio@6.10.4 # zizmor: ignore[adhoc-packages] pinned to an exact upstream release; a CI-only test-registry tool, not a shipped or lockfile-tracked dependency.\n      - name: Install pypiserver (real-registry PyPI e2e coverage)\n        if: runner.os == 'Linux'\n        # legacy-cgi: pypiserver 2.4.0 imports `cgi`, removed in Python 3.13.\n        # gunicorn: the test's `--server gunicorn` avoids a slow getfqdn() bind.\n        # setuptools/wheel: the test builds with `--no-isolation` against this venv's build\n        # backend, so no network fetch happens during `python -m build`; must be pre-installed.\n        run: |\n          python3 -m venv \"$RUNNER_TEMP/pypi-e2e-venv\"\n          \"$RUNNER_TEMP/pypi-e2e-venv/bin/pip\" install pypiserver==2.4.0 twine==6.2.0 build==1.4.4 legacy-cgi==2.6.3 gunicorn==26.2.0 setuptools==80.9.0 wheel==0.45.1\n          echo \"$RUNNER_TEMP/pypi-e2e-venv/bin\" >> \"$GITHUB_PATH\"\n      - name: Install cargo-http-registry (real-registry Cargo e2e coverage)\n        if: runner.os == 'Linux'\n        run: cargo install --locked cargo-http-registry@0.1.8 # zizmor: ignore[adhoc-packages] pinned to an exact upstream release; a CI-only test-registry tool, not a shipped or lockfile-tracked dependency.\n      - run: just test\n      - run: just release-workflow-behavior\n      - name: Verify Release-PR action against the real callisto binary\n        run: bash .github/actions/callisto-action/tests/test_release_pr_decide_binary_contract.sh\n\n  release-artifact-preflight:\n    name: Release Artifact Preflight (${{ matrix.id }})\n    runs-on: ${{ matrix.runner }}\n    strategy:\n      fail-fast: false\n      matrix:\n        include:\n          - id: macos-arm64\n            runner: macos-14\n            target: aarch64-apple-darwin\n            asset: callisto-aarch64-apple-darwin.tar.gz\n            kind: cli\n          - id: linux-gnu\n            runner: ubuntu-latest\n            target: x86_64-unknown-linux-gnu\n            asset: callisto-x86_64-unknown-linux-gnu.tar.gz\n            kind: cli\n          - id: linux-musl\n            runner: ubuntu-latest\n            target: x86_64-unknown-linux-musl\n            asset: callisto-x86_64-unknown-linux-musl.tar.gz\n            kind: cross\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: orin-dx/actions/setup-rust@2521888266780dabc7f5fd4c32b02d6ab82849db # v1.1\n      - name: Build the production artifact recipe\n        env:\n          CALLISTO_RELEASE_ARTIFACT_KIND: ${{ matrix.kind }}\n          CALLISTO_RELEASE_ARTIFACT_TARGET: ${{ matrix.target }}\n          CALLISTO_RELEASE_ARTIFACT_ASSET: ${{ matrix.asset }}\n          CALLISTO_RELEASE_SOURCE_ROOT: ${{ github.workspace }}\n          CALLISTO_RELEASE_ARTIFACT_DIR: ${{ runner.temp }}/release-artifact-preflight\n        run: bash .github/scripts/build-release-artifact.sh\n\n  coverage:\n    name: Code Coverage & Test Report\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: taiki-e/install-action@7623a79cdfecb99d681017af368ca353d9f49bb5 # v2\n        with:\n          tool: just@1.58.0\n      - uses: orin-dx/actions/setup-rust@2521888266780dabc7f5fd4c32b02d6ab82849db # v1.1\n        with:\n          components: llvm-tools-preview\n      - uses: taiki-e/install-action@7623a79cdfecb99d681017af368ca353d9f49bb5 # v2\n        with:\n          tool: cargo-llvm-cov\n      - run: just coverage 90\n      # Non-blocking for now: the workspace-total gate above can pass while\n      # a small crate is far below threshold (a few large crates dominate\n      # the total line count). Visible in logs so regressions get noticed;\n      # promote to a required check once existing per-crate gaps are closed.\n      - run: just coverage-per-crate 90 || echo \"::warning::one or more crates below 90% line coverage (non-blocking, see job log above)\"\n\n  security:\n    name: Security & Advisory Audit (Moon & Just)\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: taiki-e/install-action@7623a79cdfecb99d681017af368ca353d9f49bb5 # v2\n        with:\n          tool: just@1.58.0\n      - uses: moonrepo/setup-toolchain@261c62cb5b0f580c7be7c8cd0f023a2e96756095 # v0\n      - uses: orin-dx/actions/setup-rust@2521888266780dabc7f5fd4c32b02d6ab82849db # v1.1\n      - uses: taiki-e/install-action@7623a79cdfecb99d681017af368ca353d9f49bb5 # v2\n        with:\n          tool: cargo-deny\n      - run: just audit\n\n  validate:\n    name: Validate Changesets & Workspace Status\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: $/.github/actions/callisto-validate\ncallisto-action/\ncallisto-validate/\nsetup-callisto/\nrelease-workflow-behavior/\ntest-release-artifact-build-script.sh  3.2K\nverify-action-pins.sh  1.2K\nverify-release-workflow-contract.sh  8.7K\nverify-release-workflow-policy.sh  32.3K\n... (2 filtered)\n[see remaining: tail -n +1 \"$HOME/Library/Application Support/rtk/tee/1792607028_ls-hidden.log\"]\njustfile:89:# Security advisory, ban, license & source check via cargo-deny (workspace root, one pass)\njustfile:90:audit:\njustfile:91:    cargo deny check\njustfile:181:# Static security audit of workflows and actions (requires zizmor and ripgrep).\njustfile:206:ci: fmt-check lint test audit doc-check zizmor workflow-contracts release-workflow-behavior (coverage \"90\")\n.moon/cache/states/callisto-model/audit/lastRun.json:1:{\"exitCode\":0,\"hash\":\"8b869f63a449f9aa7c09efb91d5e3faacbaa0f90cf43dfadf99e5ec2fcaf8e8d\",\"lastRunTime\":1789875810146,\"target\":\"callisto-model:audit\"}\n.moon/cache/states/callisto-manifests/audit/lastRun.json:1:{\"exitCode\":0,\"hash\":\"f73252f486b9e6a0e0b8c9745bd1e2592ebb7b3afc3c082f9bb47f423595427f\",\"lastRunTime\":1789875810146,\"target\":\"callisto-manifests:audit\"}\n.moon/cache/states/callisto-vcs/audit/lastRun.json:1:{\"exitCode\":0,\"hash\":\"5c26e23b46ca789cf9bed0a391d231c106c98e0ed7f074736643c1ed0d795e6e\",\"lastRunTime\":17898758101