se, so the remote capability must use the\n    // same representation for equality, endpoint rendering, and its digest.\n    let owner = owner.to_ascii_lowercase();\n    let repository = repository.to_ascii_lowercase();\n    let port = parsed.port_or_known_default();\n    let port_text = match (parsed.scheme(), port) {\n        (\"https\", Some(443)) | (\"ssh\", Some(22)) | (_, None) => String::new(),\n        (_, Some(port)) => format!(\":{port}\"),\n    };\n    let endpoint = match parsed.scheme() {\n        \"https\" => format!(\"https://{host}{port_text}/{owner}/{repository}.git\"),\n        \"ssh\" => format!(\"ssh://git@{host}{port_text}/{owner}/{repository}.git\"),\n        _ => unreachable!(\"scheme checked above\"),\n    };\n    let mut transcript = CanonicalTranscript::semantic_input_v1();\n    transcript.push_str(\"gitRemote.scheme\", parsed.scheme());\n    transcript.push_str(\"gitRemote.host\", &host);\n    transcript.push_str(\n        \"gitRemote.port\",\n        &port.map_or_else(String::new, |port| port.to_string()),\n    );\n    transcript.push_str(\"gitRemote.owner\", &owner);\n    transcript.push_str(\"gitRemote.repository\", &repository);\n    if host != \"github.com\" {\n        return Err(GraphError::UnsafeGitRemote {\n            reason: \"release forge remote must be hosted on github.com\",\n        });\n    }\n    let github_repository =\n        GitHubRepository::parse(&format!(\"{owner}/{repository}\")).map_err(|error| GraphError::UnsafeGitRemote {\n            reason: github_repository_parse_error_reason(&error),\n        })?;\n    Ok(PreparedGitRemote {\n        remote_name: \"origin\",\n        endpoint,\n        identity: callisto_model::SemanticInputDigest::from_transcript(&transcript),\n        github_repository,\n    })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::super::release_observation::tests::{artifact_fixture, capability_workspace, CapabilityRunner};\n    use super::*;\n    use callisto_model::{CommandError, CommandOutput, Ecosystem, VersionGrammar};\n    use std::sync::atomic::{AtomicUsize, Ordering};\n\n    struct ScopedEnvironment {\n        name: &'static str,\n        previous: Option<std::ffi::OsString>,\n    }\n\n    impl ScopedEnvironment {\n        fn set(name: &'static str, value: &str) -> Self {\n            let previous = std::env::var_os(name);\n            std::env::set_var(name, value);\n            Self { name, previous }\n        }\n    }\n\n"},{"type":"input_text","text":"\n[77] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/commands/release.rs\\n@@\\n     fn dispatch_prepared_submits_the_exact_validated_cargo_body_with_a_finite_deadline() {\\n@@\\n         assert!(submissions[0].3.ends_with(&crate_bytes));\\n     }\\n+\\n+    #[test]\\n+    #[serial_test::serial]\\n+    fn dispatch_prepared_stages_exact_npm_bytes_with_canonical_argv_and_private_config() {\\n+        let (workspace, decision) = capability_workspace();\\n+        let runner = CapabilityRunner::default();\\n+        let locator = crate::IgnoreWalkLocator::new(workspace.path());\\n+        let intent = build_release_intent(workspace.path(), &locator, &runner, &decision, \\\"production\\\").unwrap();\\n+        let state = tempfile::tempdir().unwrap();\\n+        let validated = validate_release_intent_with_state_directory(\\n+            workspace.path(),\\n+            &locator,\\n+            &runner,\\n+            Some(state.path()),\\n+            intent,\\n+        )\\n+        .unwrap();\\n+        let (_artifact_directory, artifacts) = artifact_fixture(&validated, &runner);\\n+        let (operation, slot) = validated\\n+            .intent()\\n+            .operations()\\n+            .iter()\\n+            .find_map(|operation| match operation.id() {\\n+                ReleaseOperationId::RegistryArtifactPublish { package, slot, .. }\\n+                    if package.ecosystem() == Ecosystem::Npm =>\\n+                {\\n+                    Some((operation.id().clone(), slot.clone()))\\n+                }\\n+                _ => None,\\n+            })\\n+            .expect(\\\"npm publish operation\\\");\\n+        let expected = artifacts.snapshot(&slot).unwrap().bytes().to_vec();\\n+        runner.push_npm_absent();\\n+        runner.push_npm_exact(slot.file_name(), &expected);\\n+        let _credential = ScopedEnvironment::set(\\\"NPM_TOKEN\\\", \\\"private-test-token\\\");\\n+        let mut observations = ObservationSession::d<truncated omitted_approx_tokens=\"659\" />      .filter(|candidate| {\\n+                matches!(candidate, ReleaseArtifactSlot::RegistryPackage { package, .. }\\n+                    if package.ecosystem() == Ecosystem::Pypi)\\n+            })\\n+            .map(|candidate| {\\n+                let (digest, length) = artifacts.expectations().artifact(candidate).unwrap();\\n+                serde_json::json!({\\n+                    \\\"filename\\\": candidate.file_name(),\\n+                    \\\"size\\\": length,\\n+                    \\\"digests\\\": {\\\"sha256\\\": digest.as_str()}\\n+                })\\n+            })\\n+            .collect::<Vec<_>>();\\n+        runner.push_http(404, serde_json::json!({}));\\n+        runner.push_http(200, serde_json::json!({\\\"urls\\\": pypi_files}));\\n+        let _credential = ScopedEnvironment::set(\\\"TWINE_PASSWORD\\\", \\\"private-test-token\\\");\\n+        let mut observations = ObservationSession::default();\\n+\\n+        assert_eq!(\\n+            validated\\n+                .dispatch_prepared(\\n+                    &artifacts,\\n+                    &mut observations,\\n+                    &ApplyPermit::force_for_tests(),\\n+                    &operation,\\n+                )\\n+                .unwrap(),\\n+            OperationOutcome::Published\\n+        );\\n+        let calls = runner.take_timed_calls();\\n+        assert_eq!(calls.len(), 1);\\n+        let call = &calls[0];\\n+        assert_eq!(call.program, \\\"twine\\\");\\n+        assert_eq!(call.timeout, PROVIDER_EFFECT_TIMEOUT);\\n+        assert_eq!(call.staged_bytes, expected);\\n+        assert_eq!(call.args.first().map(String::as_str), Some(\\\"upload\\\"));\\n+        assert_eq!(call.args.last().map(|arg| Path::new(arg).file_name().unwrap()), Some(slot.file_name().as_ref()));\\n+        assert!(!call.args.iter().any(|arg| arg == \\\"--skip-existing\\\"));\\n+        assert!(!call.args.iter().any(|arg| matches!(arg.as_str(), \\\"build\\\" | \\\"glob\\\")));\\n+    }\\n \\n     #[test]\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n"},{"type":"input_text","text":"\n[78] tool exec result: Script completed\nWall time 3.8 seconds\nOutput:\n\n{}\n"},{"type":"input_text","text":"\n[79] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk just fmt && rtk proxy cargo test -p callisto-graph --lib dispatch_prepared_stages -- --nocapture\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":30000,\"max_output_tokens\":30000});\ntext(r.output);\nif (r.session_id) text(`SESSION_ID=${r.session_id}`);\n\n"},{"type":"input_text","text":"\n[80] tool exec result: Script completed\nWall time 7.4 seconds\nOutput:\n\nmoon run :format\n[ WARN 2026-09-16 21:59:47.904] moon_actions::actions::install_dependencies  No internet connection, skipping dependency install  root=\"\" toolchain_id=\"rust\"\n▮▮▮▮ callisto-conventional:format (cached, dc4efda0)\n▮▮▮▮ callisto-changelog:format (cached, 9f8d61e5)\n▮▮▮▮ callisto-vcs:format (cached, 2cb6dadf)\n▮▮▮▮ callisto-format:format (cached, 09a0bd3b)\n▮▮▮▮ callisto-fixtures:format (cached, 3cf39a4a)\n▮▮▮▮ callisto-moon:format (cached, efc9f627)\n▮▮▮▮ callisto-cli:format (cached, bb83a3b0)\n▮▮▮▮ callisto-manifests:format (cached, a86f43e4)\n▮▮▮▮ callisto-model:format (d13b1e13)\n▮▮▮▮ callisto-graph:format (09d03d40)\n▮▮▮▮ callisto-model:format (291ms, d13b1e13)\n▮▮▮▮ callisto-graph:format (420ms, 09