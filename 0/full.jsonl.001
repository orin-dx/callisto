t = self.runner.run(\"git\", &arg_refs, &self.root)?;\n        if !output.success() {\n            return Err(probe_failed(&arg_refs, &self.root, &output));\n        }\n        for record in output.stdout.split('\\u{1}').skip(1) {\n            let mut fields = record.split('\\0');\n            let Some(commit) = fields.next() else {\n                continue;\n            };\n            let index = touches.commits.len();\n            touches.commits.push(commit.to_owned());\n            for file in fields\n                .map(|file| file.trim_start_matches('\\n'))\n                .filter(|file| !file.is_empty())\n            {\n                touches.by_path.entry(PathBuf::from(file)).or_default().push(index);\n            }\n        }\n        Ok(touches)\n    }\n\n    /// Lists tag names, optionally filtered by `glob` (a [`globset::Glob`]\n    /// pattern; `None` matches every tag).\n    ///\n    /// Always fetches the full tag list and filters locally with the same\n    /// `globset` matcher `callisto-graph`'s `tags::matching_tags` uses, never\n    /// `git tag --list <pattern>`'s different glob dialect.\n    /// Whether the repository holds its whole history. A shallow clone does not, and a failing answer is not \"yes\".\n    pub fn has_full_history(&self) -> Result<bool, VcsError> {\n        let shallow = self\n2:516-        let mut args: Vec<String> = [\"log\", \"--no-show-signature\", \"--first-parent\", \"--format=%H\", \"--\"]\n7:521-        let output = self.runner.run(\"git\", &arg_refs, &self.root)?;\n9:523-            return Err(probe_failed(&arg_refs, &self.root, &output));\n23:537-            \"log\",","is_error":false}]},"uuid":"72f6c76b-fd99-4954-8cc1-a378196d0819","timestamp":"2026-11-11T19:21:05.508Z","toolUseResult":{"stdout":"    pub fn first_parent_commits_touching(&self, pathspecs: &[PathBuf]) -> Result<Vec<String>, VcsError> {\n        let mut args: Vec<String> = [\"log\", \"--no-show-signature\", \"--first-parent\", \"--format=%H\", \"--