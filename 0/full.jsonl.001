> grouped.patch.push(entry),\n            Severity::None => return Err(ChangelogError::SeverityNoneEntry),\n        }\n    }\n    Ok(grouped)\n}\n","numLines":24,"startLine":1,"totalLines":24}},"sourceToolAssistantUUID":"681bc44e-082a-4b8f-96cd-972fdd83e849","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
