tion_digest: \u0026TagAnnotationDigest,\n        permit: \u0026ApplyPermit,\n    ) -\u003e Result\u003cRemoteAnnotatedTagObservation, VcsError\u003e {\n        // Push is a mutation and must be paired with the shell transport's\n        // mandatory remote readback. Do not try native first: gix cannot\n        // provide that paired protocol, and a retry could double-apply it.\n        self.shell\n            .push_annotated_tag_and_confirm(remote, name, target_sha, annotation_digest, permit)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n\n    /// Tests exercise the write primitives directly rather than through a\n    /// command handler, so they mint a permit without a dry-run flag to\n    /// consult. Every non-test caller must go through\n    /// `ApplyPermit::granted_unless_dry_run`.\n    fn permit() -\u003e callisto_model::ApplyPermit {\n        callisto_model::ApplyPermit::force_for_tests()\n    }\n    use sup\u003ctruncated omitted_approx_tokens=\"1100\" /\u003e, repository, tag)\n        }\n        _ =\u003e OperationObservation::Unverifiable(ObservationFailure::Capability {\n            provider: ObservationProvider::PreparedCapability,\n        }),\n    }\n}\n\nfn observe_tag(\n    artifacts: \u0026ValidatedArtifactManifest\u003c'_, '_\u003e,\n    validated: \u0026ValidatedReleaseIntent\u003c'_\u003e,\n    release: \u0026ProductReleaseId,\n    name: \u0026TagName,\n    target: \u0026callisto_model::CommitSha,\n    annotation: \u0026str,\n    remote_name: \u0026str,\n) -\u003e OperationObservation {\n    let expected_annotation = TagAnnotationDigest::from_annotation(annotation);\n    match GitAccess::discover(validated.root(), validated.runner()).observe_remote_annotated_tag(\n        remote_name,\n        name,\n        target,\n        \u0026expected_annotation,\n    ) {\n        Ok(RemoteAnnotatedTagObservation::Absent) =\u003e OperationObservation::Absent,\n        Ok(RemoteAnnotatedTagObservation::Conflict(conflict)) =\u003e {\n            OperationObservation::Conflict(ExternalConflict::RemoteTag(conflict))\n        }\n        Ok(RemoteAnnotatedTagObservation::Exact) =\u003e {\n            let expectations = artifacts.expectations();\n            OperationObservation::Exact(ReleaseObservationEvidence::remote_tag(\n                release.clone(),\n                name.as_str(),\n                target.clone(),\n                expectations.tag_annotation_digest().clone(),\n            ))\n        }\n        Err(_) =\u003e OperationObservation::Unverifiable(ObservationFailure::Command {\n            provider: ObservationProvider::Git,\n        }),\n    }\n}\n\nfn observe_registry(\n    session: \u0026mut ObservationSession,\n    artifacts: \u0026ValidatedArtifactManifest\u003c'_, '_\u003e,\n    validated: \u0026ValidatedReleaseIntent\u003c'_\u003e,\n    package: \u0026ReleasePackageId,\n    version: \u0026Version,\n    registry: callisto_model::RegistryBindingId,\n    slot: \u0026ReleaseArtifactSlot,\n    endpoints: PreparedRegistryEndpointsView\u003c'_\u003e,\n) -\u003e OperationObservation {\n    let snapshot = match artifacts.snapshot(slot) {\n        Ok(snapshot) =\u003e snapshot,\n        Err(_) =\u003e {\n\n","type":"input_text"},{"text":"\n[88] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"enum RemoteConflict|RemoteConflict::|ReleaseRemoteConflict\\\" crates/callisto-graph/src crates/callisto-vcs/src\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":16000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[89] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\ncrates/callisto-graph/src/error.rs:459:    ReleaseRemoteConflict {\ncrates/callisto-graph/src/error.rs:577:/// [`GraphError::ReleaseRemoteConflict`] (E167).\ncrates/callisto-graph/src/error.rs:579:pub enum RemoteConflict {\n\n","type":"input_text"},{"text":"\n[90] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '560,620p' crates/callisto-graph/src/error.rs \u0026\u0026 rtk rg -n \\\"RemoteConflict\\\" crates/callisto-graph/src/commands/release.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":12000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[91] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\n    DecisionNotWrittenByCommit,\n    #[error(\"no changeset was consumed by this commit\")]\n    NoChangesetConsumed,\n    #[error(\"the changelog was not touched by this commit\")]\n    ChangelogNotTouched,\n    #[error(\"the manifest is not part of this commit's diff\")]\n    ManifestNotInDiff,\n    #[error(\"the manifest version does not match the claimed version\")]\n    ManifestVersionMismatch,\n    #[error(\"an unclaimed package's version changed in this commit\")]\n    UnclaimedVersionChange,\n    #[error(\"a claimed package was not observed in this commit\")]\n    ClaimedPackageNotObserved,\n}\n\n/// A remote Git tag or forge release that already exists with content\n/// differing from what this release intent authorized, carried by\n/// [`GraphError::ReleaseRemoteConflict`] (E167).\n#[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]\npub enum RemoteConflict {\n    #[error(\"a tag with this name already exists at a different target commit\")]\n    TagTargetDiffers,\n    #[error(\"a tag was pushed but was not observed on the remote afterward\")]\n    TagNotObservedAfterPush,\n    #[error(\"a forge release with this tag already exists with different attributes\")]\n    ForgeReleaseDiffers,\n    #[error(\"a forge release was created but was not observed afterward\")]\n    ForgeReleaseNotObservedAfterCreate,\n    #[error(\"the forge API returned an unexpected status\")]\n    ForgeApiStatus,\n}\n\n/// A release feature with no implemented dispatch for the given\n/// configuration, carried by [`GraphError::UnsupportedRelease`] (E168).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]\npub enum UnsupportedReleaseFeature {\n    #[error(\"ecosystem\")]\n    Ecosystem,\n    #[error(\"source identity\")]\n    SourceIdentity,\n    #[error(\"bump reason\")]\n    BumpReason,\n    #[error(\"publish target\")]\n    PublishTarget,\n}\n\n/// Why a `--package` release selection is invalid, carried by\n/// [`GraphError::ReleaseSelectionInvalid`] (E169).\n#[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]\npub enum ReleaseSelectionInvalidReason {\n    #[error(\"the package is selected more than once\")]\n    Duplicate,\n    #[error(\"the package is not part of this release plan\")]\n    NotInPlan,\n    #[error(\"the package has a duplicate registry target\")]\n    DuplicateRegistryTarget,\n}\n\n/// An unmet precondition for a release operation, carried by\n/// [`GraphError::ReleasePreconditionUnmet`] (E170).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]\n\n","type":"input_text"},{"text":"\n[92] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '400,465p' crates/callisto-vcs/src/shell.rs \u0026\u0026 rtk sed -n '550,585p' crates/callisto-vcs/src/lib.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":12000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[93] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\n        }\n\n        let arg_refs: Vec\u003c\u0026str\u003e = args.iter().map(String::as_str).collect();\n        let output = self.runner.run(\"git\", \u0026arg_refs, \u0026self.root)?;\n\n        if !output.success() {\n            return Err(VcsError::Git(format!(\n                \"`git log` failed in `{}`: {}\",\n                self.root.display(),\n                output.redacted_stderr()\n            )));\n        }\n\n        parse_git_log_output(\u0026output.stdout, \u0026self.root)\n    }\n\n    fn create_tag(\n        \u0026self,\n        name: \u0026str,\n        target_sha: \u0026CommitSha,\n        message: Option\u003c\u0026str\u003e,\n        sign: crate::TagSignPolicy,\n        _permit: \u0026ApplyPermit,\n    ) -\u003e Result\u003c(), VcsError\u003e {\n        // `--` marks the end of option parsing so `name` (validated\n        // upstream by `is_valid_git_ref_name`, but defended here too) can\n        // never be misread as a `git tag` flag even if it started with `-`.\n        let canonical_message = message.map(canonical_tag_annotation_message);\n        let mut args: Vec\u003c\u0026str\u003e = vec![\"tag\"];\n        if let Some(msg) = canonical_message.as_deref() {\n            // Unlike the default `git tag -m` cleanup, this preserves the\n            // shared canonical bytes used by native gix tag creation.\n            args.extend([\"-a\", \"--cleanup=verbatim\", \"-m\", msg]);\n        }\n        if matches!(sign, crate::TagSignPolicy::ForceUnsigned) {\n            args.push(\"--no-sign\");\n        }\n        args.extend([\"--\", name, target_sha.as_str()]);\n        let output = self.runner.run(\"git\", \u0026args, \u0026self.root)?;\n        if !output.success() {\n            return Err(VcsError::Git(format!(\n                \"`git tag` failed in `{}`: {}\",\n                self.root.display(),\n                output.redacted_stderr()\n            )));\n        }\n        Ok(())\n    }\n\n    fn create_floating_major(\n        \u0026self,\n        major_name: \u0026str,\n        target_sha: \u0026CommitSha,\n        _permit: \u0026ApplyPermit,\n    ) -\u003e Result\u003c(), VcsError\u003e {\n        let output = self\n            .runner\n            .run(\"git\", \u0026[\"tag\", \"-f\", \"--\", major_name, target_sha.as_str()], \u0026self.root)?;\n        if !output.success() {\n            return Err(VcsError::Git(format!(\n                \"`git tag -f` failed in `{}`: {}\",\n                self.root.display(),\n                output.redacted_stderr()\n            )));\n        }\n        Ok(())\n        #[cfg(target_arch = \"wasm32\")]\n        {\n            let _unused = (since, pathspecs);\n            Ok(Vec::new())\n        }\n    }\n\n    /// `sign` is accepted for interface parity with [`ShellGit::create_tag`]\n    /// but has no effect here: this constructs the tag object directly via\n    /// `gix`, which never shells out to `git` and so never consults\n    /// `tag.gpgSign`/`commit.gpgsign` in the first place.\n    pub fn create_tag(\n        \u0026self,\n        name: \u0026str,\n        target_sha: \u0026CommitSha,\n        message: Option\u003c\u0026str\u003e,\n        _sign: TagSignPolicy,\n        _permit: \u0026ApplyPermit,\n    ) -\u003e Result\u003c(), VcsError\u003e {\n        #[cfg(not(target_arch = \"wasm32\"))]\n        {\n            let oid = gix::ObjectId::from_hex(target_sha.as_ref().as_bytes())\n                .map_err(|e| VcsError::Git(format!(\"Invalid SHA: {e}\")))?;\n\n            if let Some(msg) = message {\n                let msg = canonical_tag_annotation_message(msg);\n                self.repo\n                    .tag(\n                        name,\n                        oid,\n                        gix::object::Kind::Commit,\n                        None,\n                        \u0026msg,\n                        gix::refs::transaction::PreviousValue::MustNotExist,\n                    )\n                    .map_err(|e| VcsError::Git(format!(\"Failed to create tag: {e}\")))?;\n\n","type":"input_text"},{"text":"\n[94] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '1,180p' crates/callisto-graph/src/commands/mod.rs \u0026\u0026 rtk fd release_receipt_store crates/callisto-graph/src/commands\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":12000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[95] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\nuse callisto_model::{Diagnostic, DiagnosticSeverity};\n\npub mod init;\npub mod matrix;\npub mod pr_body;\npub mod publish;\npub mod registry_argv;\nmod registry_artifacts;\npub mod release;\npub mod release_artifacts;\npub mod release_decision;\npub mod release_execution;\nmod release_observation;\npub mod release_store;\npub mod snapshot;\npub mod status;\npub mod tag;\npub mod validate;\npub mod version;\n\npub use callisto_model::{ReleaseDecisionEntry, ReleaseDecisionError, ReleaseDecisionV1, ReleaseInclusionReason};\npub use init::{init, InitOptions};\npub use matrix::{matrix, MatrixOptions};\npub use pr_body::{compose_pr_body, PrBodyOptions};\npub use publish::{filter_plan_by_report, plan_publish, PublishOptions};\npub use release::{\n    build_release_intent, validate_release_intent, validate_release_intent_with_state_directory, ValidatedReleaseIntent,\n};\npub use release_decision::{derive_release_commit_decision, derive_release_decision, derive_selected_release_decision};\npub use release_execution::{\n    execute_release, execute_release_with_artifacts, reconcile_release_execution, ReconciledReleaseExecution,\n};\npub use release_store::{AtomicReleaseStateWriter, ReleaseStateStore, ReleaseStateWriter};\npub use snapshot::plan_snapshot;\npub use status::{status, StatusOptions};\npub use tag::{create_tags, create_tags_with_options, TagOptions};\npub use validate::{validate, ValidateOptions};\npub use version::{plan_version, VersionOptions};\n\npub fn escalate(diagnostics: \u0026mut [Diagnostic], strict: bool, strict_graph: bool) {\n    for d in diagnostics {\n        let should_escalate = match d.escalated_by {\n            Some(callisto_model::StrictFlag::Strict) =\u003e strict,\n            Some(callisto_model::StrictFlag::StrictGraph) =\u003e strict || strict_graph,\n            None =\u003e false,\n        };\n        if should_escalate {\n            d.severity = DiagnosticSeverity::Error;\n        }\n    }\n}\ncrates/callisto-graph/src/commands/release_receipt_store.rs\n\n","type":"input_text"},{"text":"\n[96] tool exec call: const r = await tools.exec_command({\"cm