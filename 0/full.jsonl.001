it = (wanted.chars().count() / 3).max(1);\n+    let mut close: Vec<(usize, bool, String)> = known\n+        .into_iter()\n+        .filter_map(|candidate| {\n+            let distance = edit_distance(&wanted, &candidate.name().to_lowercase());\n+            let other_ecosystem = missing.ecosystem().is_some() && missing.ecosystem() != candidate.ecosystem();\n+            (distance <= limit).then(|| (distance, other_ecosystem, candidate.display_name()))\n+        })\n+        .collect();\n+    close.sort();\n+    close.dedup();\n+    if close.is_empty() {\n+        return String::new();\n+    }\n+    let names: Vec<String> = close\n+        .into_iter()\n+        .take(3)\n+        .map(|(_, _, name)| format!(\"`{name}`\"))\n+        .collect();\n+    format!(\"\\ndid you mean {}?\", names.join(\", \"))\n+}\n+\n+fn edit_distance(a: &str, b: &str) -> usize {\n+    let b: Vec<char> = b.chars().collect();\n+    let mut row: Vec<usize> = (0..=b.len()).collect();\n+    for (i, ca) in a.chars().enumerate() {\n+        let mut diagonal = std::mem::replace(&mut row[0], i + 1);\n+        for (j, cb) in b.iter().enumerate() {\n+            let above = row[j + 1];\n+            row[j + 1] = (diagonal + usize::from(ca != *cb)).min(above + 1).min(row[j] + 1);\n+            diagonal = above;\n+        }\n+    }\n+    row[b.len()]\n+}\n+\n #[cfg(test)]\n mod tests {\n     use super::*;\n@@ -1195,6 +1238,12 @@ pub enum ConfigError {\n }\n \n impl GraphError {\n+    /// E102 for `id`, suggesting up to three of `known` whose names are a small edit away.\n+    pub fn unknown_package(id: PackageId, known: impl IntoIterator<Item = PackageId>) -> Self {\n+        let hint = did_you_mean(&id, known);\n+        Self::UnknownPackage { id, hint }\n+    }\n+\n     /// The one filesystem path this error is about, when it carries it as a structured field.\n     pub fn path(&self) -> Option<&std::path::Path> {\n         match self {\ndiff --git a/crates/callisto-graph/src/identity.rs b/crates/callisto-graph/src/identity.rs\nindex cc51d3011..50c6d6fa4 100644\n--- a/crates/callisto-graph/src/identity.rs\n+++ b/crates/callisto-graph/src/identity.rs\n@@ -51,6 +51,26 @@ mod tests {\n         );\n     }\n \n+    #[test]\n+    fn resolve_miss_suggests_only_registered_names_that_are_close() {\n+        let mut index = IdentityIndex::default();\n+        for name in [\"lib\", \"lab-core\", \"unrelated\"] {\n+            let id = PackageId::Prefixed {\n+                ecosystem: Ecosystem::Cargo,\n+                name: name.to_string(),\n+            };\n+            index.native.insert((Ecosystem::Cargo, name.to_string()), id);\n+        }\n+        let GraphError::UnknownPackage { hint, .. } = index.resolve(\"cargo/lib2\").unwrap_err() else {\n+            panic!(\"expected E102\");\n+        };\n+        assert_eq!(hint, \"\\ndid you mean `cargo/lib`?\");\n+        let GraphError::UnknownPackage { hint, .. } = index.resolve(\"cargo/zzzzzz\").unwrap_err() else {\n+            panic!(\"expected E102\");\n+        };\n+        assert_eq!(hint, \"\");\n+    }\n+\n     #[test]\n     fn resolve_qualified_selector_is_exact_and_misses_report_e102() {\n         let mut index = IdentityIndex::default();\n@@ -388,7 +408,7 @@ impl IdentityIndex {\n                 .native\n                 .get(&(*ecosystem, name.clone()))\n                 .cloned()\n-                .ok_or_else(|| GraphError::UnknownPackage { id: id.clone() }),\n+                .ok_or_else(|| GraphError::unknown_package(id.clone(), self.native_ids())),\n             PackageId::Bare(name) => {\n                 let candidates: BTreeSet<PackageId> = self\n                     .native\n@@ -397,7 +417,7 @@ impl IdentityIndex {\n                     .map(|(_, registered)| registered.clone())\n                     .collect();\n                 match candidates.len() {\n-                    0 => Err(GraphError::UnknownPackage { id: id.clone() }),\n+                    0 => Err(GraphError::unknown_package(id.clone(), self.native_ids())),\n                     1 => Ok(candidates.into_iter().next().expect(\"len checked above\")),\n                     _ => Err(GraphError::AmbiguousName {\n                         name: name.clone(),\n@@ -580,6 +600,14 @@ impl IdentityIndex {\n         candidates.next().is_none().then_some(first)\n     }\n \n+    /// Every registered native name as an ecosystem-qualified id, the names a selector can spell.\n+    fn native_ids(&self) -> impl Iterator<Item = PackageId> + '_ {\n+        self.native.keys().map(|(ecosystem, name)| PackageId::Prefixed {\n+            ecosystem: *ecosystem,\n+            name: name.clone(),\n+        })\n+    }\n+\n     pub fn native_names(&self, id: &PackageId) -> impl Iterator<Item = (Ecosystem, &str)> + use<'_> {\n         let keys = self.by_package(|view| view.native.get(id).cloned().unwrap_or_default());\n         let results: Vec<(Ecosystem, &str)> = keys","is_error":false}]},"uuid":"345a4906-36f0-4863-8649-5522ea48c5b0","timestamp":"2026-11-10T16:12:43.369Z","toolUseResult":{"stdout":" M crates/callisto-cli/tests/status_version_selector_tests.rs\n M crates/callisto-graph/src/commands/matrix.rs\n M crates/callisto-graph/src/commands/release_decision.rs\n M crates/callisto-graph/src/error.rs\n M crates/callisto-graph/src/identity.rs\n M crates/callisto-graph/src/toposort.rs\n M crates/callisto-graph/tests/matrix_tests.rs\n M docs/errors.md\ndiff --git a/crates/callisto-graph/src/error.rs b/crates/callisto-graph/src/error.rs\nindex e9165afe5..7147c22f6 100644\n--- a/crates/callisto-graph/src/error.rs\n+++ b/crates/callisto-graph/src/error.rs\n@@ -84,9 +84,13 @@ pub enum GraphError {\n     #[error(\"package `{id}` was not found in the workspace\")]\n     #[diagnostic(\n         code(E102),\n-        help(\"Check the package's name and ecosystem, or that its directory has a manifest callisto discovers.\")\n+        help(\"Check the package's name and ecosystem, or that its directory has a manifest callisto discovers.{hint}\")\n     )]\n-    UnknownPackage { id: PackageId },\n+    UnknownPackage {\n+        id: PackageId,\n+        /// Empty, or a newline and `did you mean ...?` naming the closest workspace packages.\n+        hint: String,\n+    },\n \n     #[error(\"`{name}` names more than one package: {}\", .candidates.iter().map(|c| format!(\"`{}`\", c.display_name())).collect::<Vec<_>>().join(\", \"))]\n     #[diagnostic(\n@@ -998,6 +1002,45 @@ pub enum ReleasePreconditionRequirement {\n     PythonInterpreterOnPath,\n }\n \n+/// Names compare without the ecosystem prefix, so a wrong ecosystem is caught too; a same-ecosystem match ranks first.\n+fn did_you_mean(missing: &PackageId, known: impl IntoIterator<Item = PackageId>) -> String {\n+    let wanted = missing.name().to_lowercase();\n+    let limit = (wanted.chars().count() / 3).max(1);\n+    let mut close: Vec<(usize, bool, String)> = known\n+        .into_iter()\n+        .filter_map(|candidate| {\n+            let distance = edit_distance(&wanted, &candidate.name().to_lowercase());\n+            let other_ecosystem = missing.ecosystem().is_some() && missing.ecosystem() != candidate.ecosystem();\n+            (distance <= limit).then(|| (distance, other_ecosystem, candidate.display_name()))\n+        })\n+        .collect();\n+    close.sort();\n+    close.dedup();\n+    if close.is_empty() {\n+        return String::new();\n+    }\n+    let names: Vec<String> = close\n+        .into_iter()\n+        .take(3)\n+        .map(|(_, _, name)| format!(\"`{name}`\"))\n+        .collect();\n+    format!(\"\\ndid you mean {}?\", names.join(\", \"))\n+}\n+\n+fn edit_distance(a: &str, b: &str) -> usize {\n+    let b: Vec<char> = b.chars().collect();\n+    let mut row: Vec<usize> = (0..=b.len()).collect();\n+    for (i, ca) in a.chars().enumerate() {\n+        let mut diagonal = std::mem::replace(&mut row[0], i + 1);\n+        for (j, cb) in b.iter().enumerate() {\n+            let above = row[j + 1];\n+            row[j + 1] = (diagonal + usize::from(ca != *cb)).min(above + 1).min(row[j] + 1);\n+            diagonal = above;\n+        }\n+    }\n+    row[b.len()]\n+}\n+\n #[cfg(test)]\n mod tests {\n     use super::*;\n@@ -1195,6 +1238,12 @@ pub enum ConfigError {\n }\n \n impl GraphError {\n+    /// E102 for `id`, suggesting up to three of `known` whose names are a small edit away.\n+    pub fn unknown_package(id: PackageId, known: impl IntoIterator<Item = PackageId>) -> Self {\n+        let hint = did_you_mean(&id, known);\n+        Self::UnknownPackage { id, hint }\n+    }\n+\n     /// The one filesystem path this error is about, when it carries it as a structured field.\n     pub fn path(&self) -> Option<&std::path::Path> {\n         match self {\ndiff --git a/crates/callisto-graph/src/identity.rs b/crates/callisto-graph/src/identity.rs\nindex cc51d3011..50c6d6fa4 100644\n--- a/crates/callisto-graph/src/identity.rs\n+++ b/crates/callisto-graph/src/identity.rs\n@@ -51,6 +51,26 @@ mod tests {\n         );\n     }\n \n+    #[test]\n+    fn resolve_miss_suggests_only_registered_names_that_are_close() {\n+        let mut index = IdentityIndex::default();\n+        for name in [\"lib\", \"lab-core\", \"unrelated\"] {\n+            let id = PackageId::Prefixed {\n+                ecosystem: Ecosystem::Cargo,\n+                name: name.to_string(),\n+            };\n+            index.native.insert((Ecosystem::Cargo, name.to_string()), id);\n+        }\n+        let GraphError::UnknownPackage { hint, .. } = index.resolve(\"cargo/lib2\").unwrap_err() else {\n+            panic!(\"expected E102\");\n+        };\n+        assert_eq!(hint, \"\\ndid you mean `cargo/lib`?\");\n+        let GraphError::UnknownPackage { hint, .. } = index.resolve(\"cargo/zzzzzz\").unwrap_err() else {\n+            panic!(\"expected E102\");\n+        };\n+        assert_eq!(hint, \"\");\n+    }\n+\n     #[test]\n     fn resolve_qualified_selector_is_exact_and_misses_report_e102() {\n         let mut index = IdentityIndex::default();\n@@ -388,7 +408,7 @@ impl IdentityIndex {\n                 .native\n                 .get(&(*ecosystem, name.clone()))\n                 .cloned()\n-                .ok_or_else(|| GraphError::UnknownPackage { id: id.clone() }),\n+                .ok_or_else(|| GraphError::unknown_package(id.clone(), self.native_ids())),\n             PackageId::Bare(name) => {\n                 let candidates: BTreeSet<PackageId> = self\n                     .native\n@@ -397,7 +417,7 @@ impl IdentityIndex {\n                     .map(|(_, registered)| registered.clone())\n                     .collect();\n                 match candidates.len() {\n-                    0 => Err(GraphError::UnknownPackage { id: id.clone() }),\n+                    0 => Err(GraphError::unknown_package(id.clone(), self.native_ids())),\n                     1 => Ok(candidates.into_iter().next().expect(\"len checked above\")),\n                     _ => Err(GraphError::AmbiguousName {\n                         name: name.clone(),\n@@ -580,6 +600,14 @@ impl IdentityIndex {\n         candidates.next().is_none().then_some(first)\n     }\n \n+    /// Every registered native name as an ecosystem-qualified id, the names a selector can spell.\n+    fn native_ids(&self) -> impl Iterator<Item = PackageId> + '_ {\n+        self.native.keys().map(|(ecosystem, name)| PackageId::Prefixed {\n+            ecosystem: *ecosystem,\n+            name: name.clone(),\n+        })\n+    }\n+\n     pub fn native_names(&self, id: &PackageId) -> impl Iterator<Item = (Ecosystem, &str)> + use<'_> {\n         let keys = self.by_package(|view| view.native.get(id).cloned().unwrap_or_default());\n         let results: Vec<(Ecosystem, &str)> = keys","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"dangerouslyDisableSandbox":true},"serverClassifierContext":{"request":"9f390069-ee7d-43b1-b726-13329471a9f7","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-adb