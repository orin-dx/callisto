{"parentUuid":"54a7c71b-6c06-4f48-8aec-482899b7309a","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/commands/publish.rs","snippet":"1\tuse callisto_model::{\n2\t    CommandRunner, CratePublish, NpmMainPublish, PublishPlan, PublishTarget, PypiPublish,\n3\t    RegistryKey, ReleaseEntry, SCHEMA_VERSION,\n4\t};\n5\tuse callisto_vcs::GitDataSource;\n6\t\n7\tuse crate::error::GraphError;\n8\tuse crate::resolver::{DependencyResolver, DependencyResolverExt};\n9\tuse crate::Workspace;\n10\t\n11\t#[derive(Clone, Debug, Default)]\n12\tpub struct PublishOptions {\n13\t    /// When non-empty, only packages whose bare name (without ecosystem prefix)\n14\t    /// appears in this list are included in the plan. An empty `only` list\n15\t    /// means \"include all packages\" (the default).\n16\t    pub only: Vec<String>,\n17\t}\n18\t\n19\t/// Validates a `publishConfig.registry` URL read from a package's own\n20\t/// `package.json` before it is threaded into the publish plan (and\n21\t/// eventually into `npm publish --registry <url>` / `npm view --registry\n22\t/// <url>`, both run with `NPM_TOKEN` live in the process environment in CI).\n23\t///\n24\t/// `publishConfig.registry` is manifest-controlled data -- something a PR\n25\t/// author can set in their own package.json -- not operator-controlled\n26\t/// config, so it must never be trusted verbatim as a publish destination.\n27\t/// Two checks are enforced, mirroring the leading-`-` flag-injection guard\n28\t/// already applied to package names before they reach these same CLI\n29\t/// invocations (see `SubprocessRegistryClient::npm_publish`):\n30\t///\n31\t/// 1. The URL must use the `https` scheme. A scheme downgrade (e.g. `http`)\n32\t///    is rejected even if the host would otherwise be approved, since scheme\n33\t///    downgrade is itself part of the attack this guard defends against.\n34\t/// 2. The URL must exactly match a `url` configured on an `npm`-kind entry\n35\t///    in the operator's `[registries]` table in `callisto.toml`.\n36\t///\n37\t/// If the operator has configured no custom npm registries at all (no\n38\t/// `[registries.*]` block with `kind = \"npm\"` and a `url`), any override is\n39\t/// rejected. This is the conservative choice: `callisto.toml`, not an\n40\t/// attacker-influenced `package.json`, must always be the source of truth\n41\t/// for where credentials-bearing publish requests are allowed to go, so\n42\t/// operators who need a private npm registry must opt in explicitly by\n43\t/// declaring it in `[registries]`.\n44\tfn validate_npm_registry_url(\n45\t    url: &str,\n46\t    package: &PackageId,\n47\t    registries: &std::collections::BTreeMap<RegistryKey, crate::config::RegistryConfig>,\n48\t) -> Result<(), GraphError> {\n49\t    let is_approved = url.starts_with(\"https://\")\n50\t        && registries\n51\t            .values()\n52\t            .any(|cfg| cfg.kind == Ecosystem::Npm && cfg.url.as_deref() == Some(url));\n53\t\n54\t    if is_approved {\n55\t        Ok(())\n56\t    } else {\n57\t        Err(GraphError::UntrustedNpmRegistry {\n58\t            package: package.clone(),\n59\t            url: url.to_string(),\n60\t        })\n61\t    }\n62\t}\n63\t\n64\t/// Resolves a package's `changelog_section` for `plan_publish`: reads the file at\n65\t/// `ws_root.join(changelog_rel_path)` and extracts the `## {ver}` section via\n66\t/// `callisto_changelog::extract_section`. Every non-fatal outcome (file not found, no\n67\t/// matching heading, empty matched section, or an unreadable file) leaves the return value\n68\t/// `None` and pushes exactly one Warning diagnostic into `diagnostics` rather than aborting\n69\t/// the plan -- `ChangelogSectionNotFound` for the first three (AC-10b, AC-11, AC-12),\n70\t/// `ChangelogReadError` for a read failure that is not \"file does not exist\" (AC-12c).\n71\tfn resolve_changelog_section(\n72\t    ws_root: &std::path::Path,\n73\t    changelog_rel_path: &std::path::Path,\n74\t    pkg_id: &callisto_model::PackageId,\n75\t    ver: &callisto_model::Version,\n76\t    diagnostics: &mut Vec<callisto_model::Diagnostic>,\n77\t) -> Option<String> {\n78\t    let full_path = ws_root.join(changelog_rel_path);\n79\t    let content = match std::fs::read_to_string(&full_path) {\n80\t        Ok(c) => c,\n81\t        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {\n82\t            diagnostics.push(callisto_model::Diagnostic {\n83\t                code: callisto_model::DiagnosticCode::ChangelogSectionNotFound,\n84\t                severity: callisto_model::DiagnosticSeverity::Warning,\n85\t                message: format!(\n86\t                    \"no changelog file found at `{}` for package `{}`\",\n87\t                    changelog_rel_path.display(),\n88\t                    pkg_id.display_name()\n89\t                ),\n90\t                package: Some(pkg_id.clone()),\n91\t                path: Some(changelog_rel_path.to_path_buf()),\n92\t                escalated_by: None,\n93\t                governed_by: None,\n94\t            });\n95\t            return None;\n96\t        }\n97\t        Err(e) => {\n98\t            diagnostics.push(callisto_model::Diagnostic {\n99\t                code: callisto_model::DiagnosticCode::ChangelogReadError,\n100\t                severity: callisto_model::DiagnosticSeverity::Warning,\n101\t                message: format!(\n102\t                    \"could not read changelog at `{}` for package `{}`: {e}\",\n103\t                    changelog_rel_path.display(),\n104\t                    pkg_id.display_name()\n105\t                ),\n106\t                package: Some(pkg_id.clone()),\n107\t                path: Some(changelog_rel_path.to_path_buf()),\n108\t                escalated_by: None,\n109\t                governed_by: None,\n110\t            });\n111\t            return None;\n112\t        }\n113\t    };\n114\t\n115\t    match callisto_changelog::extract_section(&content, ver) {\n116\t        Some(section) => Some(section.to_string()),\n117\t        None => {\n118\t            diagnostics.push(callisto_model::Diagnostic {\n119\t                code: callisto_model::DiagnosticCode::ChangelogSectionNotFound,\n120\t                severity: callisto_model::DiagnosticSeverity::Warning,\n121\t                message: format!(\n122\t                    \"no `## {}` section found in `{}` for package `{}`\",\n123\t                    ver.render(),\n124\t                    changelog_rel_path.display(),\n125\t                    pkg_id.display_name()\n126\t                ),\n127\t                package: Some(pkg_id.clone()),\n128\t                path: Some(changelog_rel_path.to_path_buf()),\n129\t                escalated_by: None,\n130\t                governed_by: None,\n131\t            });\n132\t            None\n133\t        }\n134\t    }\n135\t}\n136\t\n137\tpub fn plan_publish<R: CommandRunner, D: DependencyResolver>(\n138\t    ws: &Workspace<'_, R, D>,\n139\t    opts: &PublishOptions,\n140\t) -> Result<PublishPlan, GraphError> {\n141\t    let mut rust_crates = Vec::new();\n142\t    let mut npm_main_packages = Vec::new();\n143\t    let mut npm_platform_packages = Vec::new();\n144\t    let mut pypi_packages = Vec::new();\n145\t    let mut releases = Vec::new();\n146\t\n147\t    let base_versions = ws.base_versions()?;\n148\t    let inference = crate::infer::NoInference;\n149\t    let mut diagnostics: Vec<callisto_model::Diagnostic> = Vec::new();\n150\t    let version_plan = match crate::commands::version::plan_version(\n151\t        ws,\n152\t        &inference,\n153\t        &crate::commands::version::VersionOptions::default(),\n154\t    ) {\n155\t        Ok(plan) => Some(plan),\n156\t        Err(e) => {\n157\t            diagnostics.push(callisto_model::Diagnostic {\n158\t                code: callisto_model::DiagnosticCode::ChangesetReadError,\n159\t                severity: callisto_model::DiagnosticSeverity::Warning,\n160\t                message: format!(\"Could not read changesets: {e}\"),\n161\t                package: None,\n162\t                path: None,\n163\t                escalated_by: None,\n164\t                governed_by: None,\n165\t            });\n166\t            None\n167\t        }\n168\t    };\n169\t\n170\t    // Build a single lookup map once — eliminates O(N) scans inside the topo loop\n171\t    // (PERF-003/004/005). Keys and values are borrowed from the graph for the\n172\t    // lifetime of this function, so no extra clones are needed for the lookups.\n173\t    let pkg_map: std::collections::HashMap<&callisto_model::PackageId, &callisto_model::Package> =\n174\t        ws.graph.packages().map(|p| (&p.id, p)).collect();\n\n... [1253 lines truncated] ..."},"type":"attachment","uuid":"e1228484-f5f6-4a95-8605-0dafa76e9e41","timestamp":"2026-08-22T17:56:41.995Z","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"rustfmt-max-width-120","slug":"shimmying-giggling-hickey"}
{"parentUuid":"e1228484-f5f6-4a95-8605-0dafa76e9e41","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/crates/callisto-graph/tests/cascade_tests.rs","snippet":"1\tmod fixtures;\n2\tuse callisto_graph::cascade::{run_cascade, CascadeInput};\n3\tuse callisto_graph::config::groups::GroupTable;\n4\tuse callisto_graph::config::{CascadeBumpSeverity, CascadeConfig, CascadeMode};\n5\tuse callisto_graph::toposort_impl;\n6\tuse callisto_graph::IdentityIndex;\n7\tuse callisto_graph::TagIndex;\n8\tuse callisto_model::{DepKind, DepSpec, PackageId, Severity, Version, VersionGrammar, VersionReq};\n9\tuse fixtures::GraphBuilder;\n10\tuse std::collections::{BTreeMap, HashSet};\n11\t\n12\t#[test]\n13\tfn test_blackbox_cascade_propagation() {\n14\t    let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n15\t    let pkg_b = PackageId::parse(\"pkg-b\").unwrap();\n16\t\n17\t    let graph = GraphBuilder::new()\n18\t        .package(pkg_a.clone(), |p| p)\n19\t        .package(pkg_b.clone(), |p| p)\n20\t        .edge(\n21\t            pkg_a.clone(),\n22\t            pkg_b.clone(),\n23\t            DepKind::Runtime,\n24\t            DepSpec::Range(\n25\t                VersionReq::parse(\"^1.0.0\", callisto_model::Ecosystem::Cargo).unwrap(),\n26\t                \"^1.0.0\".to_string(),\n27\t            ),\n28\t        )\n29\t        .build()\n30\t        .unwrap();\n31\t\n32\t    let groups = GroupTable::default();\n33\t    let cfg = CascadeConfig {\n34\t        mode: CascadeMode::OutOfRange,\n35\t        bump_severity: CascadeBumpSeverity::Patch,\n36\t        peer_escalation: true,\n37\t        preserve_npm_ranges: false,\n38\t    };\n39\t\n40\t    let mut seed = BTreeMap::new();\n41\t    seed.insert(pkg_b.clone(), Severity::Major);\n42\t\n43\t    let mut base = BTreeMap::new();\n44\t    base.insert(pkg_a.clone(), Version::semver(1, 0, 0));\n45\t    base.insert(pkg_b.clone(), Version::semver(1, 0, 0));\n46\t\n47\t    let reasons = BTreeMap::new();\n48\t    let named_by = BTreeMap::new();\n49\t\n50\t    let input = CascadeInput {\n51\t        graph: &graph,\n52\t        groups: &groups,\n53\t        cfg: &cfg,\n54\t        seed: &seed,\n55\t        reasons: &reasons,\n56\t        named_by: &named_by,\n57\t        base: &base,\n58\t        pre: None,\n59\t        tags: &TagIndex::empty(),\n60\t        identity: &IdentityIndex::default(),\n61\t    };\n62\t\n63\t    let outcome = run_cascade(input).unwrap();\n64\t    assert_eq!(outcome.severities.get(&pkg_b), Some(&Severity::Major));\n65\t    // pkg_a depends on pkg_b via ^1.0.0; after pkg_b bumps to 2.x the\n66\t    // constraint goes out of range, so cascade must propagate a bump to pkg_a.\n67\t    assert_eq!(\n68\t        outcome.severities.get(&pkg_a),\n69\t        Some(&Severity::Patch),\n70\t        \"cascade must propagate a Patch bump to pkg_a which depends on pkg_b\"\n71\t    );\n72\t}\n73\t\n74\t#[test]\n75\tfn test_diamond_cascade_convergence() {\n76\t    let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n77\t    let pkg_b = PackageId::parse(\"pkg-b\").unwrap();\n78\t    let pkg_c = PackageId::parse(\"pkg-c\").unwrap();\n79\t    let pkg_d = PackageId::parse(\"pkg-d\").unwrap();\n80\t\n81\t    let graph = GraphBuilder::new()\n82\t        .package(pkg_a.clone(), |p| p)\n83\t        .package(pkg_b.clone(), |p| p)\n84\t        .package(pkg_c.clone(), |p| p)\n85\t        .package(pkg_d.clone(), |p| p)\n86\t        .edge(\n87\t            pkg_a.clone(),\n88\t            pkg_b.clone(),\n89\t            DepKind::Runtime,\n90\t            DepSpec::Range(\n91\t                VersionReq::parse(\"^1.0.0\", callisto_model::Ecosystem::Cargo).unwrap(),\n92\t                \"^1.0.0\".to_string(),\n93\t            ),\n94\t        )\n95\t        .edge(\n96\t            pkg_a.clone(),\n97\t            pkg_c.clone(),\n98\t            DepKind::Runtime,\n99\t            DepSpec::Range(\n100\t                VersionReq::parse(\"^1.0.0\", callisto_model::Ecosystem::Cargo).unwrap(),\n101\t                \"^1.0.0\".to_string(),\n102\t            ),\n103\t        )\n104\t        .edge(\n105\t            pkg_b.clone(),\n106\t            pkg_d.clone(),\n107\t            DepKind::Runtime,\n108\t            DepSpec::Range(\n109\t                VersionReq::parse(\"^1.0.0\", callisto_model::Ecosystem::Cargo).unwrap(),\n110\t                \"^1.0.0\".to_string(),\n111\t            ),\n112\t        )\n113\t        .edge(\n114\t            pkg_c.clone(),\n115\t            pkg_d.clone(),\n116\t            DepKind::Runtime,\n117\t            DepSpec::Range(\n118\t                VersionReq::parse(\"^1.0.0\", callisto_model::Ecosystem::Cargo).unwrap(),\n119\t                \"^1.0.0\".to_string(),\n120\t            ),\n121\t        )\n122\t        .build()\n123\t        .unwrap();\n124\t\n125\t    let groups = GroupTable::default();\n126\t    let cfg = CascadeConfig {\n127\t        mode: CascadeMode::OutOfRange,\n128\t        bump_severity: CascadeBumpSeverity::Patch,\n129\t        peer_escalation: true,\n130\t        preserve_npm_ranges: false,\n131\t    };\n132\t\n133\t    let mut seed = BTreeMap::new();\n134\t    seed.insert(pkg_d.clone(), Severity::Major);\n135\t\n136\t    let mut base = BTreeMap::new();\n137\t    base.insert(pkg_a.clone(), Version::semver(1, 0, 0));\n138\t    base.insert(pkg_b.clone(), Version::semver(1, 0, 0));\n139\t    base.insert(pkg_c.clone(), Version::semver(1, 0, 0));\n140\t    base.insert(pkg_d.clone(), Version::semver(1, 0, 0));\n141\t\n142\t    let reasons = BTreeMap::new();\n143\t    let named_by = BTreeMap::new();\n144\t\n145\t    let input = CascadeInput {\n146\t        graph: &graph,\n147\t        groups: &groups,\n148\t        cfg: &cfg,\n149\t        seed: &seed,\n150\t        reasons: &reasons,\n151\t        named_by: &named_by,\n152\t        base: &base,\n153\t        pre: None,\n154\t        tags: &TagIndex::empty(),\n155\t        identity: &IdentityIndex::default(),\n156\t    };\n157\t\n158\t    let outcome = run_cascade(input).unwrap();\n159\t    assert_eq!(outcome.severities.get(&pkg_d), Some(&Severity::Major));\n160\t    assert!(outcome.severities.get(&pkg_b).unwrap() >= &Severity::Patch);\n161\t    assert!(outcome.severities.get(&pkg_c).unwrap() >= &Severity::Patch);\n162\t}\n163\t\n164\t#[test]\n165\tfn test_peer_dependency_escalation() {\n166\t    let pkg_app = PackageId::parse(\"pkg-app\").unwrap();\n167\t    let pkg_plugin = PackageId::parse(\"pkg-plugin\").unwrap();\n168\t\n169\t    let graph = GraphBuilder::new()\n170\t        .package(pkg_app.clone(), |p| p)\n171\t        .package(pkg_plugin.clone(), |p| p)\n172\t        .edge(\n173\t            pkg_plugin.clone(),\n174\t            pkg_app.clone(),\n175\t            DepKind::Peer,\n176\t            DepSpec::Range(\n177\t                VersionReq::parse(\"^1.0.0\", callisto_model::Ecosystem::Npm).unwrap(),\n178\t                \"^1.0.0\".to_string(),\n179\t            ),\n180\t        )\n181\t        .build()\n182\t        .unwrap();\n183\t\n184\t    let groups = GroupTable::default();\n185\t    let cfg = CascadeConfig {\n186\t        mode: CascadeMode::OutOfRange,\n187\t        bump_severity: CascadeBumpSeverity::Patch,\n188\t        peer_escalation: true,\n189\t        preserve_npm_ranges: false,\n190\t    };\n191\t\n192\t    let mut seed = BTreeMap::new();\n193\t    seed.insert(pkg_app.clone(), Severity::Major);\n194\t\n195\t    let mut base = BTreeMap::new();\n196\t    base.insert(pkg_app.clone(), Version::semver(1, 0, 0));\n197\t    base.insert(pkg_plugin.clone(), Version::semver(1, 0, 0));\n198\t\n199\t    let reasons = BTreeMap::new();\n200\t    let named_by = BTreeMap::new();\n201\t\n202\t    let input = CascadeInput {\n203\t        graph: &graph,\n204\t        groups: &groups,\n205\t        cfg: &cfg,\n206\t        seed: &seed,\n207\t        reasons: &reasons,\n208\t        named_by: &named_by,\n209\t        base: &base,\n210\t        pre: None,\n211\t        tags: &TagIndex::empty(),\n212\t        identity: &IdentityIndex::default(),\n213\t    };\n214\t\n215\t    let outcome = run_cascade(input).unwrap();\n216\t    assert_eq!(outcome.severities.get(&pkg_plugin), Some(&Severity::Major));\n217\t}\n218\t\n219\t#[test]\n220\tfn test_linked_group_converges_shared_version() {\n221\t    use callisto_graph::config::{GroupDef, GroupMember};\n222\t    use callisto_model::{GroupKind, GroupName};\n223\t\n224\t    let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n225\t    let pkg_b = PackageId::parse(\"pkg-b\").unwrap();\n226\t\n227\t    let graph = GraphBuilder::new()\n228\t        .package(pkg_a.clone(), |p| p)\n229\t        .package(pkg_b.clone(), |p| p)\n230\t        .build()\n231\t        .unwrap();\n232\t\n233\t    let mut groups = GroupTable::default();\n234\t    let group_name = GroupName(\"group-ab\".to_string());\n235\t    groups.linked.insert(\n236\t        group_name.clone(),\n\n... [211 lines truncated] ..."},"type":"attachment","uuid":"45d12773-b3de-40c2-a2ef-869352f84a39","timestamp":"2026-08-22T17:56:41.997Z","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"rustfmt-max-width-120","slug":"shimmying-giggling-hickey"}
