= ManifestWalkResolver::build(&root, locator, runner, &config, &manifest_cache)?;\n108-\n109-        config.groups = GroupTable::resolve(&config.raw_groups, graph.identity())?;\n110-\n111-        {\n112-            let mut by_name: BTreeMap<String, Vec<(PackageId, BTreeSet<Ecosystem>)>> =\n113-                BTreeMap::new();\n114-            let mut ecosystems_by_id: BTreeMap<(String, PackageId), BTreeSet<Ecosystem>> =\n115-                BTreeMap::new();\n116-            for ((eco, name), id) in &graph.identity().prefixed {\n117-                ecosystems_by_id\n118-                    .entry((name.clone(), id.clone()))\n119-                    .or_default()\n120-                    .insert(*eco);\n121-            }\n122-            for ((name, id), ecos) in ecosystems_by_id {\n123-                by_name.entry(name).or_default().push((id, ecos));\n124-            }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"4793cdee-4f3f-4f1c-bfd3-8b4c2b7b50e7","session_id":"bb531e8d-c394-4e47-a8ae-e4a9ceeca6d2","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.233","gitBranch":"main","slug":"shimmying-giggling-hickey"}
