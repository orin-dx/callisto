artifact attestations\",\"oid\":\"fac3b6dbed1afe06d5138afdf57e5d81baa6a521\"},{\"authoredDate\":\"2026-09-01T20:03:39Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T20:03:39Z\",\"messageBody\":\"Entire-Checkpoint: 01M1F93YHWHRG48M9QAZW3234H\",\"messageHeadline\":\"feat(release): derive CI roster from merged release commit\",\"oid\":\"b577a9a8a80241042a3f11a964debe51aed5dca0\"},{\"authoredDate\":\"2026-09-01T20:05:13Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T20:05:13Z\",\"messageBody\":\"\",\"messageHeadline\":\"ci: harden durable release workflow\",\"oid\":\"7c4c92cd0fcd18b30435b6b90c2681d82ae6a091\"},{\"authoredDate\":\"2026-09-01T20:05:50Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T20:05:50Z\",\"messageBody\":\"\",\"messageHeadline\":\"docs: explain durable release workflow\",\"oid\":\"ce35ea79a4d615efe28c2fd689880f94b1e514e5\"},{\"authoredDate\":\"2026-09-01T20:06:12Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T20:06:12Z\",\"messageBody\":\"Entire-Checkpoint: 01M1F98MFBY17JYEGZ346VXMXN\",\"messageHeadline\":\"feat(cli): verify artifact bytes before release execution\",\"oid\":\"d8ec8495d618f4e72eb3d812d613de857517fdab\"},{\"authoredDate\":\"2026-09-01T20:06:37Z\",\"authors\":[{\"email\":\"gabe@techworx.dev\",\"id\":\"MDQ6VXNlcjExNjc0Nw==\",\"login\":\"castrog\",\"name\":\"Gabe Castro\"}],\"committedDate\":\"2026-09-01T20:06:37Z\",\"messageBody\":\"\",\"messageHeadline\":\"ci: require verified release merge commits\",\"oid\":\"adbb3757a3560dd78aa0c5572af304ab8feda20f\"},{\"authoredDate\":\"2026-09-01T20:08: