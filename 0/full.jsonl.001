{"parentUuid":"39628def-9ef5-434c-9fd1-6aa23dfb01e5","isSidechain":false,"attachment":{"type":"file","filename":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-colon/crates/callisto-graph/tests/config_resolve_tests.rs","content":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-colon/crates/callisto-graph/tests/config_resolve_tests.rs","content":"/// Tests that `[[linked-group]]` and `[[fixed-group]]` blocks in callisto.toml are\n/// resolved into the workspace's `config.groups` table.\n///\n/// Regression test for the bug where `GroupTable::resolve()` was never called —\n/// `raw_groups` was validated syntactically but then dropped, and\n/// `ResolvedConfig.groups` was always set to `GroupTable::default()`.\nuse std::fs;\nuse std::path::Path;\n\nuse callisto_graph::locate::IgnoreWalkLocator;\nuse callisto_graph::Workspace;\nuse callisto_model::{CommandError, CommandOutput, CommandRunner};\n\nstruct NoopRunner;\n\nimpl CommandRunner for NoopRunner {\n    fn run(&self, _program: &str, _args: &[&str], _cwd: &Path) -> Result<CommandOutput, CommandError> {\n        Ok(CommandOutput {\n            exit_code: Some(0),\n            stdout: String::new(),\n            stderr: String::new(),\n        })\n    }\n}\n\n/// Set up a minimal two-package Cargo workspace with git init.\nfn write_two_crate_workspace(root: &Path, crate_a: &str, crate_b: &str) {\n    callisto_fixtures::git::init_repo(root);\n\n    fs::write(\n        root.join(\"Cargo.toml\"),\n        \"[workspace]\\nmembers = [\\\"crates/*\\\"]\\nresolver = \\\"2\\\"\\n\",\n    )\n    .unwrap();\n\n    for name in [crate_a, crate_b] {\n        let crate_dir = root.join(format!(\"crates/{name}\"));\n        fs::create_dir_all(&crate_dir).unwrap();\n        fs::write(\n            crate_dir.join(\"Cargo.toml\"),\n            format!(\"[package]\\nname = \\\"{name}\\\"\\nversion = \\\"0.1.0\\\"\\nedition = \\\"2021\\\"\\n\"),\n        )\n        .unwrap();\n    }\n}\n\n/// A `[[linked-group]]` defined in `callisto.toml` must appear in\n/// `ws.config.groups.linked` after `Workspace::load`.\n///\n/// Before the fix this assertion failed because `GroupTable::resolve` was\n/// never called and `groups` was always `GroupTable::default()` (empty maps).\n#[test]\nfn linked_group_is_resolved_into_config() {\n    let tmp = tempfile::tempdir().expect(\"tempdir\");\n    let root = tmp.path();\n    write_two_crate_workspace(root, \"alpha\", \"beta\");\n\n    fs::write(\n        root.join(\"callisto.toml\"),\n        r#\"\n[[linked-group]]\nname = \"ab\"\nmembers = [\"alpha\", \"beta\"]\n\"#,\n    )\n    .unwrap();\n\n    let runner = NoopRunner;\n    let locator = IgnoreWalkLocator::new(root);\n    let ws = Workspace::load(root.to_path_buf(), &locator, &runner).expect(\"workspace should load\");\n\n    assert!(\n        ws.config.groups.linked.keys().any(|k| k.as_str() == \"ab\"),\n        \"expected linked group 'ab' to be present, but groups.linked was empty — \\\n         GroupTable::resolve was not called (bug)\"\n    );\n}\n\n/// A `[[fixed-group]]` defined in `callisto.toml` must appear in\n/// `ws.config.groups.fixed` after `Workspace::load`.\n#[test]\nfn fixed_group_is_resolved_into_config() {\n    let tmp = tempfile::tempdir().expect(\"tempdir\");\n    let root = tmp.path();\n    write_two_crate_workspace(root, \"foo\", \"bar\");\n\n    fs::write(\n        root.join(\"callisto.toml\"),\n        r#\"\n[[fixed-group]]\nname = \"fb\"\nmembers = [\"foo\", \"bar\"]\n\"#,\n    )\n    .unwrap();\n\n    let runner = NoopRunner;\n    let locator = IgnoreWalkLocator::new(root);\n    let ws = Workspace::load(root.to_path_buf(), &locator, &runner).expect(\"workspace should load\");\n\n    assert!(\n        ws.config.groups.fixed.keys().any(|k| k.as_str() == \"fb\"),\n        \"expected fixed group 'fb' to be present, but groups.fixed was empty — \\\n         GroupTable::resolve was not called (bug)\"\n    );\n}\n\n/// Two Fixed groups' members that resolve to the\n/// SAME PackageId under different spellings must make Workspace::load\n/// (which calls GroupTable::resolve) fail with\n/// GraphError::ConflictingGroupMembership -- not silently let the second\n/// group's insert overwrite the first's claim.\n#[test]\nfn conflicting_fixed_group_membership_across_spellings_is_rejected() {\n    let tmp = tempfile::tempdir().expect(\"tempdir\");\n    let root = tmp.path();\n    write_two_crate_workspace(root, \"my-lib\", \"other-lib\");\n\n    fs::write(\n        root.join(\"callisto.toml\"),\n        r#\"\n[[fixed-group]]\nname = \"group-a\"\nmembers = [\"my-lib\"]\n\n[[fixed-group]]\nname = \"group-b\"\nmembers = [\"cargo/my-lib\"]\n\"#,\n    )\n    .unwrap();\n\n    let runner = NoopRunner;\n    let locator = IgnoreWalkLocator::new(root);\n    let result = Workspace::load(root.to_path_buf(), &locator, &runner);\n\n    match result {\n        Err(callisto_graph::error::GraphError::ConflictingGroupMembership { groups, .. }) => {\n            let names: Vec<String> = groups.iter().map(|g| g.as_str().to_string()).collect();\n            assert!(names.contains(&\"group-a\".to_string()));\n            assert!(names.contains(&\"group-b\".to_string()));\n        }\n        Err(other) => panic!(\"expected Err(ConflictingGroupMembership) naming group-a and group-b, got Err({other:?})\"),\n        Ok(_) => panic!(\"expected Err(ConflictingGroupMembership) naming group-a and group-b, got Ok(_)\"),\n    }\n}\n\n/// A resolved PackageId listed as a Fixed-group member under one\n/// spelling and a Linked-group member under a different spelling must also\n/// be rejected -- confirming the conflict check spans both group kinds and\n/// is not scoped separately to fixed_of and linked_of.\n#[test]\nfn conflicting_membership_across_fixed_and_linked_groups_is_rejected() {\n    let tmp = tempfile::tempdir().expect(\"tempdir\");\n    let root = tmp.path();\n    write_two_crate_workspace(root, \"my-lib\", \"other-lib\");\n\n    fs::write(\n        root.join(\"callisto.toml\"),\n        r#\"\n[[fixed-group]]\nname = \"fixed-a\"\nmembers = [\"my-lib\"]\n\n[[linked-group]]\nname = \"linked-b\"\nmembers = [\"cargo/my-lib\"]\n\"#,\n    )\n    .unwrap();\n\n    let runner = NoopRunner;\n    let locator = IgnoreWalkLocator::new(root);\n    let result = Workspace::load(root.to_path_buf(), &locator, &runner);\n\n    match result {\n        Err(callisto_graph::error::GraphError::ConflictingGroupMembership { groups, .. }) => {\n            let names: Vec<String> = groups.iter().map(|g| g.as_str().to_string()).collect();\n            assert!(names.contains(&\"fixed-a\".to_string()));\n            assert!(names.contains(&\"linked-b\".to_string()));\n        }\n        Err(other) => {\n            panic!(\"expected Err(ConflictingGroupMembership) naming fixed-a and linked-b, got Err({other:?})\")\n        }\n        Ok(_) => panic!(\"expected Err(ConflictingGroupMembership) naming fixed-a and linked-b, got Ok(_)\"),\n    }\n}\n\n/// A workspace where each resolved PackageId belongs to exactly\n/// one group (the ordinary, allowed case) must resolve Ok, and\n/// GraphError::ConflictingGroupMembership must never be constructed during\n/// that resolve() call.\n#[test]\nfn non_conflicting_group_membership_resolves_ok() {\n    let tmp = tempfile::tempdir().expect(\"tempdir\");\n    let root = tmp.path();\n    write_two_crate_workspace(root, \"alpha\", \"beta\");\n\n    fs::write(\n        root.join(\"callisto.toml\"),\n        r#\"\n[[fixed-group]]\nname = \"fixed-a\"\nmembers = [\"alpha\"]\n\n[[linked-group]]\nname = \"linked-b\"\nmembers = [\"beta\"]\n\"#,\n    )\n    .unwrap();\n\n    let runner = NoopRunner;\n    let locator = IgnoreWalkLocator::new(root);\n    let ws =\n        Workspace::load(root.to_path_buf(), &locator, &runner).expect(\"non-conflicting group config must resolve Ok\");\n\n    assert!(ws\n        .config\n        .groups\n        .fixed\n        .contains_key(&callisto_model::GroupName(\"fixed-a\".to_string())));\n    assert!(ws\n        .config\n        .groups\n        .linked\n        .contains_key(&callisto_model::GroupName(\"linked-b\".to_string())));\n}\n\n/// The colon form is not a spelling of a package: a group member written `cargo:my-lib` fails with the slash form named.\n#[test]\nfn a_group_member_in_the_colon_form_is_rejected_with_the_slash_form_named() {\n    let tmp = tempfile::tempdir().expect(\"tempdir\");\n    let root = tmp.path();\n    write_two_crate_workspace(root, \"my-lib\", \"other-lib\");\n    fs::write(\n        root.join(\"callisto.toml\"),\n        \"[[fixed-group]]\\nname = \\\"g\\\"\\nmembers = [\\\"cargo:my-lib\\\"]\\n\",\n    )\n    .unwrap();\n\n    let runner = NoopRunner;\n    let locator = IgnoreWalkLocator::new(root);\n    let Err(error) = Workspace::load(root.to_path_buf(), &locator, &runner) else {\n        panic!(\"the colon form must be rejected\");\n    };\n    let rendered = format!(\"{error}\");\n    assert!(\n        rendered.contains(\"cargo:my-lib\") && rendered.contains(\"colon form\"),\n        \"{rendered}\"\n    );\n    let help = miette::Diagnostic::help(&error)\n        .map(|h| h.to_string())\n        .unwrap_or_default();\n    assert!(help.contains(\"cargo/my-lib\"), \"{help}\");\n    assert_eq!(\n        miette::Diagnostic::code(&error).map(|c| c.to_string()).as_deref(),\n        Some(\"E316\")\n    );\n}\n","numLines":261,"startLine":1,"totalLines":261}},"displayPath":"crates/callisto-graph/tests/config_resolve_tests.rs"},"type":"attachment","uuid":"cf042724-9d0c-4a14-a4a0-3a0978d7652a","timestamp":"2026-10-21T05:37:09.525Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/gabe/Projects/callisto/.claude/worktrees/t06-colon/crates/callisto-graph/tests/config_resolve_tests.rs\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t/// Tests that `[[linked-group]]` and `[[fixed-group]]` blocks in callisto.toml are\n2\t/// resolved into the workspace's `config.groups` table.\n3\t///\n4\t/// Regression test for the bug where `GroupTable::resolve()` was never called —\n5\t/// `raw_groups` was validated syntactically but then dropped, and\n6\t/// `ResolvedConfig.groups` was always set to `GroupTable::default()`.\n7\tuse std::fs;\n8\tuse std::path::Path;\n9\t\n10\tuse callisto_graph::locate::IgnoreWalkLocator;\n11\tuse callisto_graph::Workspace;\n12\tuse callisto_model::{CommandError, CommandOutput, CommandRunner};\n13\t\n14\tstruct NoopRunner;\n15\t\n16\timpl CommandRunner for NoopRunner {\n17\t    fn run(&self, _program: &str, _args: &[&str], _cwd: &Path) -> Result<CommandOutput, CommandError> {\n18\t        Ok(CommandOutput {\n19\t            exit_code: Some(0),\n20\t            stdout: String::new(),\n21\t            stderr: String::new(),\n22\t        })\n23\t    }\n24\t}\n25\t\n26\t/// Set up a minimal two-package Cargo workspace with git init.\n27\tfn write_two_crate_workspace(root: &Path, crate_a: &str, crate_b: &str) {\n28\t    callisto_fixtures::git::init_repo(root);\n29\t\n30\t    fs::write(\n31\t        root.join(\"Cargo.toml\"),\n32\t        \"[workspace]\\nmembers = [\\\"crates/*\\\"]\\nresolver = \\\"2\\\"\\n\",\n33\t    )\n34\t    .unwrap();\n35\t\n36\t    for name in [crate_a, crate_b] {\n37\t        let crate_dir = root.join(format!(\"crates/{name}\"));\n38\t        fs::create_dir_all(&crate_dir).unwrap();\n39\t        fs::write(\n40\t            crate_dir.join(\"Cargo.toml\"),\n41\t            format!(\"[package]\\nname = \\\"{name}\\\"\\nversion = \\\"0.1.0\\\"\\nedition = \\\"2021\\\"\\n\"),\n42\t        )\n43\t        .unwrap();\n44\t    }\n45\t}\n46\t\n47\t/// A `[[linked-group]]` defined in `callisto.toml` must appear in\n48\t/// `ws.config.groups.linked` after `Workspace::load`.\n49\t///\n50\t/// Before the fix this assertion failed because `GroupTable::resolve` was\n51\t/// never called and `groups` was always `GroupTable::default()` (empty maps).\n52\t#[test]\n53\tfn linked_group_is_resolved_into_config() {\n54\t    let tmp = tempfile::tempdir().expect(\"tempdir\");\n55\t    let root = tmp.path();\n56\t    write_two_crate_workspace(root, \"alpha\", \"beta\");\n57\t\n58\t    fs::write(\n59\t        root.join(\"callisto.toml\"),\n60\t        r#\"\n61\t[[linked-group]]\n62\tname = \"ab\"\n63\tmembers = [\"alpha\", \"beta\"]\n64\t\"#,\n65\t    )\n66\t    .unwrap();\n67\t\n68\t    let runner = NoopRunner;\n69\t    let locator = IgnoreWalkLocator::new(root);\n70\t    let ws = Workspace::load(root.to_path_buf(), &locator, &runner).expect(\"workspace should load\");\n71\t\n72\t    assert!(\n73\t        ws.config.groups.linked.keys().any(|k| k.as_str() == \"ab\"),\n74\t        \"expected linked group 'ab' to be present, but groups.linked was empty — \\\n75\t         GroupTable::resolve was not called (bug)\"\n76\t    );\n77\t}\n78\t\n79\t/// A `[[fixed-group]]` defined in `callisto.toml` must appear in\n80\t/// `ws.config.groups.fixed` after `Workspace::load`.\n81\t#[test]\n82\tfn fixed_group_is_resolved_into_config() {\n83\t    let tmp = tempfile::tempdir().expect(\"tempdir\");\n84\t    let root = tmp.path();\n85\t    write_two_crate_workspace(root, \"foo\", \"bar\");\n86\t\n87\t    fs::write(\n88\t        root.join(\"callisto.toml\"),\n89\t        r#\"\n90\t[[fixed-group]]\n91\tname = \"fb\"\n92\tmembers = [\"foo\", \"bar\"]\n93\t\"#,\n94\t    )\n95\t    .unwrap();\n96\t\n97\t    let runner = NoopRunner;\n98\t    let locator = IgnoreWalkLocator::new(root);\n99\t    let ws = Workspace::load(root.to_path_buf(), &locator, &runner).expect(\"workspace should load\");\n100\t\n101\t    assert!(\n102\t        ws.config.groups.fixed.keys().any(|k| k.as_str() == \"fb\"),\n103\t        \"expected fixed group 'fb' to be present, but groups.fixed was empty — \\\n104\t         GroupTable::resolve was not called (bug)\"\n105\t    );\n106\t}\n107\t\n108\t/// Two Fixed groups' members that resolve to the\n109\t/// SAME PackageId under different spellings must make Workspace::load\n110\t/// (which calls GroupTable::resolve) fail with\n111\t/// GraphError::ConflictingGroupMembership -- not silently let the second\n112\t/// group's insert overwrite the first's claim.\n113\t#[test]\n114\tfn conflicting_fixed_group_membership_across_spellings_is_rejected() {\n115\t    let tmp = tempfile::tempdir().expect(\"tempdir\");\n116\t    let root = tmp.path();\n117\t    write_two_crate_workspace(root, \"my-lib\", \"other-lib\");\n118\t\n119\t    fs::write(\n120\t        root.join(\"callisto.toml\"),\n121\t        r#\"\n122\t[[fixed-group]]\n123\tname = \"group-a\"\n124\tmembers = [\"my-lib\"]\n125\t\n126\t[[fixed-group]]\n127\tname = \"group-b\"\n128\tmembers = [\"cargo/my-lib\"]\n129\t\"#,\n130\t    )\n131\t    .unwrap();\n132\t\n133\t    let runner = NoopRunner;\n134\t    let locator = IgnoreWalkLocator::new(root);\n135\t    let result = Workspace::load(root.to_path_buf(), &locator, &runner);\n136\t\n137\t    match result {\n138\t        Err(callisto_graph::error::GraphError::ConflictingGroupMembership { groups, .. }) => {\n139\t            let names: Vec<String> = groups.iter().map(|g| g.as_str().to_string()).collect();\n140\t            assert!(names.contains(&\"group-a\".to_string()));\n141\t            assert!(names.contains(&\"group-b\".to_string()));\n142\t        }\n143\t        Err(other) => panic!(\"expected Err(ConflictingGroupMembership) naming group-a and group-b, got Err({other:?})\"),\n144\t        Ok(_) => panic!(\"expected Err(ConflictingGroupMembership) naming group-a and group-b, got Ok(_)\"),\n145\t    }\n146\t}\n147\t\n148\t/// A resolved PackageId listed as a Fixed-group member under one\n149\t/// spelling and a Linked-group member under a different spelling must also\n150\t/// be rejected -- confirming the conflict check spans both group kinds and\n151\t/// is not scoped separately to fixed_of and linked_of.\n152\t#[test]\n153\tfn conflicting_membership_across_fixed_and_linked_groups_is_rejected() {\n154\t    let tmp = tempfile::tempdir().expect(\"tempdir\");\n155\t    let root = tmp.path();\n156\t    write_two_crate_workspace(root, \"my-lib\", \"other-lib\");\n157\t\n158\t    fs::write(\n159\t        root.join(\"callisto.toml\"),\n160\t        r#\"\n161\t[[fixed-group]]\n162\tname = \"fixed-a\"\n163\tmembers = [\"my-lib\"]\n164\t\n165\t[[linked-group]]\n166\tname = \"linked-b\"\n167\tmembers = [\"cargo/my-lib\"]\n168\t\"#,\n169\t    )\n170\t    .unwrap();\n171\t\n172\t    let runner = NoopRunner;\n173\t    let locator = IgnoreWalkLocator::new(root);\n174\t    let result = Workspace::load(root.to_path_buf(), &locator, &runner);\n175\t\n176\t    match result {\n177\t        Err(callisto_graph::error::GraphError::ConflictingGroupMembership { groups, .. }) => {\n178\t            let names: Vec<String> = groups.iter().map(|g| g.as_str().to_string()).collect();\n179\t            assert!(names.contains(&\"fixed-a\".to_string()));\n180\t            assert!(names.contains(&\"linked-b\".to_string()));\n181\t        }\n182\t        Err(other) => {\n183\t            panic!(\"expected Err(ConflictingGroupMembership) naming fixed-a and linked-b, got Err({other:?})\")\n184\t        }\n185\t        Ok(_) => panic!(\"expected Err(ConflictingGroupMembership) naming fixed-a and linked-b, got Ok(_)\"),\n186\t    }\n187\t}\n188\t\n189\t/// A workspace where each resolved PackageId belongs to exactly\n190\t/// one group (the ordinary, allowed case) must resolve Ok, and\n191\t/// GraphError::ConflictingGroupMembership must never be constructed during\n192\t/// that resolve() call.\n193\t#[test]\n194\tfn non_conflicting_group_membership_resolves_ok() {\n195\t    let tmp = tempfile::tempdir().expect(\"tempdir\");\n196\t    let root = tmp.path();\n197\t    write_two_crate_workspace(root, \"alpha\", \"beta\");\n198\t\n199\t    fs::write(\n200\t        root.join(\"callisto.toml\"),\n201\t        r#\"\n202\t[[fixed-group]]\n203\tname = \"fixed-a\"\n204\tmembers = [\"alpha\"]\n205\t\n206\t[[linked-group]]\n207\tname = \"linked-b\"\n208\tmembers = [\"beta\"]\n209\t\"#,\n210\t    )\n211\t    .unwrap();\n212\t\n213\t    let runner = NoopRunner;\n214\t    let locator = IgnoreWalkLocator::new(root);\n215\t    let ws =\n216\t        Workspace::load(root.to_path_buf(), &locator, &runner).expect(\"non-conflicting group config must resolve Ok\");\n217\t\n218\t    assert!(ws\n219\t        .config\n220\t        .groups\n221\t        .fixed\n222\t        .contains_key(&callisto_model::GroupName(\"fixed-a\".to_string())));\n223\t    assert!(ws\n224\t        .config\n225\t        .groups\n226\t        .linked\n227\t        .contains_key(&callisto_model::GroupName(\"linked-b\".to_string())));\n228\t}\n229\t\n230\t/// The colon form is not a spelling of a package: a group member written `cargo:my-lib` fails with the slash form named.\n231\t#[test]\n232\tfn a_group_member_in_the_colon_form_is_rejected_with_the_slash_form_named() {\n233\t    let tmp = tempfile::tempdir().expect(\"tempdir\");\n234\t    let root = tmp.path();\n235\t    write_two_crate_workspace(root, \"my-lib\", \"other-lib\");\n236\t    fs::write(\n237\t        root.join(\"callisto.toml\"),\n238\t        \"[[fixed-group]]\\nname = \\\"g\\\"\\nmembers = [\\\"cargo:my-lib\\\"]\\n\",\n239\t    )\n240\t    .unwrap();\n241\t\n242\t    let runner = NoopRunner;\n243\t    let locator = IgnoreWalkLocator::new(root);\n244\t    let Err(error) = Workspace::load(root.to_path_buf(), &locator, &runner) else {\n245\t        panic!(\"the colon form must be rejected\");\n246\t    };\n247\t    let rendered = format!(\"{error}\");\n248\t    assert!(\n249\t        rendered.contains(\"cargo:my-lib\") && rendered.contains(\"colon form\"),\n250\t        \"{rendered}\"\n251\t    );\n252\t    let help = miette::Diagnostic::help(&error)\n253\t        .map(|h| h.to_string())\n254\t        .unwrap_or_default();\n255\t    assert!(help.contains(\"cargo/my-lib\"), \"{help}\");\n256\t    assert_eq!(\n257\t        miette::Diagnostic::code(&error).map(|c| c.to_string()).as_deref(),\n258\t        Some(\"E316\")\n259\t    );\n260\t}\n261\t\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-colon","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.292","gitBranch":"fix/reject-colon-references","slug":"lexical-jingling-puppy"}
