{"parentUuid":"a0fdf01d-7615-4bec-91cd-cfa814b3e46a","isSidechain":false,"message":{"model":"claude-sonnet-5","id":"msg_011CeGRN8tbe2JwSsL1fWvq7","type":"message","role":"assistant","content":[{"type":"text","text":"Real findings. Applying all 5 fixes directly (mechanical, exact text already provided)."}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3621,"cache_read_input_tokens":810832,"output_tokens":645,"output_tokens_details":{"thinking_tokens":524},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3621,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":645,"cache_read_input_tokens":810832,"cache_creation_input_tokens":3621,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3621},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CeGRN6bwJWR7eciqD3JE5","type":"assistant","uuid":"ef2ceef6-256d-4053-8ff0-df3547d02ec2","timestamp":"2026-08-21T19:09:31.222Z","effort":"high","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
{"parentUuid":"ef2ceef6-256d-4053-8ff0-df3547d02ec2","isSidechain":false,"message":{"model":"claude-sonnet-5","id":"msg_011CeGRN8tbe2JwSsL1fWvq7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HSfate89AgsEFqHevmuuLA","name":"Read","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/specs/SPEC-005-release-entry-is-prerelease.json"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3621,"cache_read_input_tokens":810832,"output_tokens":645,"output_tokens_details":{"thinking_tokens":524},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3621,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":645,"cache_read_input_tokens":810832,"cache_creation_input_tokens":3621,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3621},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CeGRN6bwJWR7eciqD3JE5","type":"assistant","uuid":"6c9d9780-1b25-4b65-9294-e9cce502fa86","timestamp":"2026-08-21T19:09:31.223Z","effort":"high","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
{"parentUuid":"6c9d9780-1b25-4b65-9294-e9cce502fa86","isSidechain":false,"promptId":"6ed687cd-73ac-42da-8a69-13f26f4fa10b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HSfate89AgsEFqHevmuuLA","type":"tool_result","content":"1\t{\n2\t  \"id\": \"SPEC-005\",\n3\t  \"purpose\": \"Replace the GitHub Action's regex-on-tag-string guess for GitHub Release pre-release status with a real, parsed boolean carried on ReleaseEntry, so `--prerelease` is passed to `gh release create` based on the actual SemVer/PEP 440 pre-release status of the release's resolved Version, not on whether the rendered tag string happens to contain one of a fixed set of substrings.\",\n4\t  \"scope\": \"1. Add a new required boolean field to `ReleaseEntry` in crates/callisto-model/src/plan.rs. 2. Populate that field at the one construction site of ReleaseEntry in crates/callisto-graph/src/commands/publish.rs (plan_publish, inside the `releases.push(ReleaseEntry { ... })` block, currently lines 505-510), computed from the `ver: &Version` value already resolved and in scope at that call site via its existing `is_prerelease()` method. 3. Update .github/actions/callisto-action/action.yml's GitHub Release creation loop (currently lines 200-216) to read the new field via `jq` instead of regex-matching `$TAG`. 4. Add a new test to .github/actions/callisto-action/tests/ following the extraction-and-stub pattern established in test_status_check_branching.sh, proving the new loop's behavior for both a SemVer and a PEP 440 fixture, including the regression fixture for the original bug. 5. Update docs/01-spec.md's ReleaseEntry field documentation (struct doc block at lines 1740-1763 and the decision-table row referencing §M.12.2 at line 2667) to list the new field.\",\n5\t  \"non_goals\": [\n6\t    \"No `schemaVersion` bump on PublishPlan/ReleaseEntry's JSON schema -- this is an additive field, consistent with this session's established precedent (StatusReport's hasChangesets/lastReleasedVersion/releaseTrigger additions shipped with no schemaVersion bump).\",\n7\t    \"No change to plan_publish's function signature or parameters. `ver: &Version` is already in scope at the ReleaseEntry construction site (publish.rs line 75 parameter, used at line 507-509); no new parameter or return type is introduced.\",\n8\t    \"No change to Version::is_prerelease()'s SemVer/PEP 440 parsing logic itself (crates/callisto-model/src/version.rs:126-131) -- it is reused as-is, not modified or re-implemented.\",\n9\t    \"No fallback regex path retained in action.yml for any reason (e.g. absent field, older plan JSON) -- the regex-based `[[ \\\"$TAG\\\" =~ -(alpha|beta|rc|pre|next) ]]` branch is removed entirely, not kept as a secondary check, since the Action always invokes a freshly-built `callisto plan-publish --format json` in the same run and there is no cross-version JSON compatibility boundary to bridge.\",\n10\t    \"No changes to NpmMainPublish, NpmPublish, PypiPublish, or any other PublishPlan entry type -- only ReleaseEntry gains this field.\",\n11\t    \"No reconciliation of the pre-existing, unrelated drift where docs/01-spec.md's ReleaseEntry doc block (lines 1740-1763) omits the `package`/`PackageId` field that the live struct (crates/callisto-model/src/plan.rs:111-118) already has -- that gap predates this change and is out of scope here; only the new field is added to the doc.\",\n12\t    \"No update to README.md or ARCHITECTURE.md -- neither file documents ReleaseEntry's field shape or the Action's --prerelease behavior today (confirmed by grep), so neither requires a change under this spec.\",\n13\t    \"No change to how `gh release create`'s other flags (`--title`, `--generate-notes`) are derived -- only the `--prerelease` flag's derivation changes.\"\n14\t  ],\n15\t  \"api_surface\": [\n16\t    {\n17\t      \"name\": \"ReleaseEntry.is_prerelease\",\n18\t      \"signature\": \"pub is_prerelease: bool  // in crates/callisto-model/src/plan.rs, struct ReleaseEntry (currently lines 111-118), under #[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, JsonSchema)] and #[serde(rename_all = \\\"camelCase\\\")] -> JSON key \\\"isPrerelease\\\"\",\n19\t      \"description\": \"New required (non-Option, no skip_serializing_if) boolean field on ReleaseEntry. Always present in every serialized ReleaseEntry, including PublishPlan.releases[] JSON emitted by `callisto plan-publish --format json`.\"\n20\t    },\n21\t    {\n22\t      \"name\": \"Version::is_prerelease\",\n23\t      \"signature\": \"pub fn is_prerelease(&self) -> bool  // crates/callisto-model/src/version.rs:126-131 (unchanged; reused, not modified)\",\n24\t      \"description\": \"Existing method on callisto_model::Version, already correct for both grammars: for SemVer, true iff `!v.pre.is_empty()`; for PEP 440, true iff `!v.is_post() && (v.is_pre() || v.is_dev())`. This is the single source of truth ReleaseEntry.is_prerelease must be derived from at construction time -- never re-derived from a tag string.\"\n25\t    }\n26\t  ],\n27\t  \"acceptance_criteria\": [\n28\t    { \"id\": \"AC-001\", \"criterion\": \"crates/callisto-model/src/plan.rs's ReleaseEntry struct has a new field `is_prerelease: bool` with no `Option` wrapper and no `#[serde(skip_serializing_if = ...)]` attribute, so the field appears in every serialized ReleaseEntry's JSON output as the key \\\"isPrerelease\\\" (per the struct's existing `#[serde(rename_all = \\\"camelCase\\\")]`), never omitted.\", \"is_error_case\": false },\n29\t    { \"id\": \"AC-002\", \"criterion\": \"Running `callisto plan-publish --format json` in a workspace with at least one publishable package produces a PublishPlan JSON whose `releases[]` entries each contain an `isPrerelease` boolean key (in addition to the existing `tagName`, `sha`, and optional `changelogSection` keys).\", \"is_error_case\": false },\n30\t    { \"id\": \"AC-003\", \"criterion\": \"For a package whose resolved release version is the SemVer value `1.2.3` (no pre-release component), the corresponding entry in `callisto plan-publish --format json`'s `releases[]` array has `isPrerelease: false`.\", \"is_error_case\": false },\n31\t    { \"id\": \"AC-004\", \"criterion\": \"Regression fixture (SemVer): for a package whose resolved release version is the SemVer value `1.0.0-1` (a valid SemVer pre-release with a purely numeric identifier, containing none of the substrings \\\"alpha\\\", \\\"beta\\\", \\\"rc\\\", \\\"pre\\\", or \\\"next\\\" anywhere in its rendered tag string), the corresponding entry in `callisto plan-publish --format json`'s `releases[]` array has `isPrerelease: true`.\", \"is_error_case\": false },\n32\t    { \"id\": \"AC-005\", \"criterion\": \"Regression fixture (PEP 440, the original bug this spec exists to fix): for a package whose resolved release version is the PEP 440 value `1.2.3a1` (a canonical PEP 440 pre-release with no dash and no substring match against \\\"alpha\\\", \\\"beta\\\", \\\"rc\\\", \\\"pre\\\", or \\\"next\\\" anywhere in its rendered tag string, e.g. tag `v1.2.3a1`), the corresponding entry in `callisto plan-publish --format json`'s `releases[]` array has `isPrerelease: true`.\", \"is_error_case\": false },\n33\t    { \"id\": \"AC-006\", \"criterion\": \"For a package whose resolved release version is the PEP 440 value `1.0.0.dev1` (a dev-release, which the codebase's existing `Version::is_prerelease()` test `pep440_dev_release_is_prerelease` at crates/callisto-model/src/version.rs:365 already asserts must be treated as pre-release), the corresponding `releases[]` entry has `isPrerelease: true`, proving the field is computed via `Version::is_prerelease()` end-to-end through plan_publish rather than a narrower ad hoc check that only recognizes alpha/beta/rc.\", \"is_error_case\": false },\n34\t    { \"id\": \"AC-007\", \"criterion\": \"ReleaseEntry.is_prerelease is computed at its one construction site in crates/callisto-graph/src/commands/publish.rs (the `releases.push(ReleaseEntry { ... })` block) directly from the `ver: &Version` value already resolved and in scope there, by calling `ver.is_prerelease()` -- confirmable by inspecting that no new call to `Version::parse`, no string parsing of `tag_name`, and no regex against the tag string appears anywhere in that construction path.\", \"is_error_case\": false },\n35\t    { \"id\": \"AC-008\", \"criterion\": \".github/actions/callisto-action/action.yml's GitHub Release creation loop (the `::group::5. Creating GitHub Release Entries` block) no longer contains the pattern `=~ -(alpha|beta|rc|pre|next)` anywhere in its script body.\", \"is_error_case\": false },\n36\t    { \"id\": \"AC-009\", \"criterion\": \"For each tag processed by .github/actions/callisto-action/action.yml's GitHub Release creation loop, `gh release create \\\"$TAG\\\" --title \\\"$TAG\\\" --generate-notes` is invoked with the additional flag `--prerelease` if and only if that tag's matching entry in `$PLAN_JSON`'s `releases[]` array has `isPrerelease: true`; when `isPrerelease` is `false`, the same `gh release create` invocation runs with no `--prerelease` flag.\", \"is_error_case\": false },\n37\t    { \"id\": \"AC-010\", \"criterion\": \"A new test file under .github/actions/callisto-action/tests/ (either a new script or an extension of test_status_check_branching.sh) follows the same established harness pattern -- it extracts the exact current run-body text of the `::group::5. Creating GitHub Release Entries` block directly out of action.yml via a `sed` range between its `::group::` and matching `::endgroup::` markers, stubs `gh` (and `jq` remains real) to capture invocation arguments, feeds it a fixture `$PLAN_JSON` value, and asserts on the captured `gh release create` argument list -- so the test cannot drift from action.yml's actual current logic. This test includes at minimum: one case with `isPrerelease: true` where the tag string contains no alpha/beta/rc/pre/next substring (the AC-005 PEP 440 regression fixture), and one case with `isPrerelease: false`.\", \"is_error_case\": false },\n38\t    { \"id\": \"AC-011\", \"criterion\": \"docs/01-spec.md's ReleaseEntry struct documentation block (the section spanning the struct doc comments immediately preceding `pub struct ReleaseEntry` at line 1742, and the decision-table row at line 2667 referencing §M.12.2) is updated to list the new `is_prerelease` / `isPrerelease` field alongside the existing documented fields (`tag_name`, `sha`, `changelog_section`), stating that it is a required (non-optional) boolean.\", \"is_error_case\": false },\n39\t    { \"id\": \"AC-012\", \"criterion\": \"No existing test asserting the JSON shape of a ReleaseEntry (e.g. golden-file or snapshot tests in callisto-graph or callisto-fixtures covering PublishPlan/ReleaseEntry serialization) is left asserting the pre-change shape without `isPrerelease` -- every such test is updated to expect the new field, and the full workspace test suite (`just test` / `moon run :test`) passes with the field present.\", \"is_error_case\": true },\n40\t    { \"id\": \"AC-013\", \"criterion\": \"Because `ver` at ReleaseEntry's construction site in publish.rs is already typed as `&callisto_model::Version` (a value that can only exist as the result of a prior successful `Version::parse` earlier in the pipeline, before plan_publish's package-processing loop runs), there is no code path at the ReleaseEntry construction site where `is_prerelease` is computed from an unparseable or malformed version string -- Rust's type system rules out that error case at this call site, so no error-handling branch (e.g. a default-false fallback) needs to exist there, and none should be added.\", \"is_error_case\": true },\n41\t    { \"id\": \"AC-014\", \"criterion\": \"ReleaseEntry's `is_prerelease` field computation introduces no new dependency edge from callisto-model to any AGPL-licensed crate: `Version::is_prerelease()` is defined and remains defined in crates/callisto-model/src/version.rs, a crate whose Cargo.toml declares `license = \\\"MIT OR Apache-2.0\\\"` and whose `[dependencies]` list (semver, pep440_rs, serde, serde_json, thiserror, miette, camino, path-slash, schemars, tempfile) contains no AGPL crate; `cargo metadata`'s resolve graph for callisto-model shows no edge to any crate licensed AGPL after this change.\", \"is_error_case\": false }\n42\t  ],\n43\t  \"linked_requirement\": \"REQ-008\"\n44\t}\n45\t"}]},"uuid":"5de38361-9add-4273-beb0-ba52cdd5cbd9","timestamp":"2026-08-21T19:09:31.282Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/specs/SPEC-005-release-entry-is-prerelease.json","content":"{\n  \"id\": \"SPEC-005\",\n  \"purpose\": \"Replace the GitHub Action's regex-on-tag-string guess for GitHub Release pre-release status with a real, parsed boolean carried on ReleaseEntry, so `--prerelease` is passed to `gh release create` based on the actual SemVer/PEP 440 pre-release status of the release's resolved Version, not on whether the rendered tag string happens to contain one of a fixed set of substrings.\",\n  \"scope\": \"1. Add a new required boolean field to `ReleaseEntry` in crates/callisto-model/src/plan.rs. 2. Populate that field at the one construction site of ReleaseEntry in crates/callisto-graph/src/commands/publish.rs (plan_publish, inside the `releases.push(ReleaseEntry { ... })` block, currently lines 505-510), computed from the `ver: &Version` value already resolved and in scope at that call site via its existing `is_prerelease()` method. 3. Update .github/actions/callisto-action/action.yml's GitHub Release creation loop (currently lines 200-216) to read the new field via `jq` instead of regex-matching `$TAG`. 4. Add a new test to .github/actions/callisto-action/tests/ following the extraction-and-stub pattern established in test_status_check_branching.sh, proving the new loop's behavior for both a SemVer and a PEP 440 fixture, including the regression fixture for the original bug. 5. Update docs/01-spec.md's ReleaseEntry field documentation (struct doc block at lines 1740-1763 and the decision-table row referencing §M.12.2 at line 2667) to list the new field.\",\n  \"non_goals\": [\n    \"No `schemaVersion` bump on PublishPlan/ReleaseEntry's JSON schema -- this is an additive field, consistent with this session's established precedent (StatusReport's hasChangesets/lastReleasedVersion/releaseTrigger additions shipped with no schemaVersion bump).\",\n    \"No change to plan_publish's function signature or parameters. `ver: &Version` is already in scope at the ReleaseEntry construction site (publish.rs line 75 parameter, used at line 507-509); no new parameter or return type is introduced.\",\n    \"No change to Version::is_prerelease()'s SemVer/PEP 440 parsing logic itself (crates/callisto-model/src/version.rs:126-131) -- it is reused as-is, not modified or re-implemented.\",\n    \"No fallback regex path retained in action.yml for any reason (e.g. absent field, older plan JSON) -- the regex-based `[[ \\\"$TAG\\\" =~ -(alpha|beta|rc|pre|next) ]]` branch is removed entirely, not kept as a secondary check, since the Action always invokes a freshly-built `callisto plan-publish --format json` in the same run and there is no cross-version JSON compatibility boundary to bridge.\",\n    \"No changes to NpmMainPublish, NpmPublish, PypiPublish, or any other PublishPlan entry type -- only ReleaseEntry gains this field.\",\n    \"No reconciliation of the pre-existing, unrelated drift where docs/01-spec.md's ReleaseEntry doc block (lines 1740-1763) omits the `package`/`PackageId` field that the live struct (crates/callisto-model/src/plan.rs:111-118) already has -- that gap predates this change and is out of scope here; only the new field is added to the doc.\",\n    \"No update to README.md or ARCHITECTURE.md -- neither file documents ReleaseEntry's field shape or the Action's --prerelease behavior today (confirmed by grep), so neither requires a change under this spec.\",\n    \"No change to how `gh release create`'s other flags (`--title`, `--generate-notes`) are derived -- only the `--prerelease` flag's derivation changes.\"\n  ],\n  \"api_surface\": [\n    {\n      \"name\": \"ReleaseEntry.is_prerelease\",\n      \"signature\": \"pub is_prerelease: bool  // in crates/callisto-model/src/plan.rs, struct ReleaseEntry (currently lines 111-118), under #[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, JsonSchema)] and #[serde(rename_all = \\\"camelCase\\\")] -> JSON key \\\"isPrerelease\\\"\",\n      \"description\": \"New required (non-Option, no skip_serializing_if) boolean field on ReleaseEntry. Always present in every serialized ReleaseEntry, including PublishPlan.releases[] JSON emitted by `callisto plan-publish --format json`.\"\n    },\n    {\n      \"name\": \"Version::is_prerelease\",\n      \"signature\": \"pub fn is_prerelease(&self) -> bool  // crates/callisto-model/src/version.rs:126-131 (unchanged; reused, not modified)\",\n      \"description\": \"Existing method on callisto_model::Version, already correct for both grammars: for SemVer, true iff `!v.pre.is_empty()`; for PEP 440, true iff `!v.is_post() && (v.is_pre() || v.is_dev())`. This is the single source of truth ReleaseEntry.is_prerelease must be derived from at construction time -- never re-derived from a tag string.\"\n    }\n  ],\n  \"acceptance_criteria\": [\n    { \"id\": \"AC-001\", \"criterion\": \"crates/callisto-model/src/plan.rs's ReleaseEntry struct has a new field `is_prerelease: bool` with no `Option` wrapper and no `#[serde(skip_serializing_if = ...)]` attribute, so the field appears in every serialized ReleaseEntry's JSON output as the key \\\"isPrerelease\\\" (per the struct's existing `#[serde(rename_all = \\\"camelCase\\\")]`), never omitted.\", \"is_error_case\": false },\n    { \"id\": \"AC-002\", \"criterion\": \"Running `callisto plan-publish --format json` in a workspace with at least one publishable package produces a PublishPlan JSON whose `releases[]` entries each contain an `isPrerelease` boolean key (in addition to the existing `tagName`, `sha`, and optional `changelogSection` keys).\", \"is_error_case\": false },\n    { \"id\": \"AC-003\", \"criterion\": \"For a package whose resolved release version is the SemVer value `1.2.3` (no pre-release component), the corresponding entry in `callisto plan-publish --format json`'s `releases[]` array has `isPrerelease: false`.\", \"is_error_case\": false },\n    { \"id\": \"AC-004\", \"criterion\": \"Regression fixture (SemVer): for a package whose resolved release version is the SemVer value `1.0.0-1` (a valid SemVer pre-release with a purely numeric identifier, containing none of the substrings \\\"alpha\\\", \\\"beta\\\", \\\"rc\\\", \\\"pre\\\", or \\\"next\\\" anywhere in its rendered tag string), the corresponding entry in `callisto plan-publish --format json`'s `releases[]` array has `isPrerelease: true`.\", \"is_error_case\": false },\n    { \"id\": \"AC-005\", \"criterion\": \"Regression fixture (PEP 440, the original bug this spec exists to fix): for a package whose resolved release version is the PEP 440 value `1.2.3a1` (a canonical PEP 440 pre-release with no dash and no substring match against \\\"alpha\\\", \\\"beta\\\", \\\"rc\\\", \\\"pre\\\", or \\\"next\\\" anywhere in its rendered tag string, e.g. tag `v1.2.3a1`), the corresponding entry in `callisto plan-publish --format json`'s `releases[]` array has `isPrerelease: true`.\", \"is_error_case\": false },\n    { \"id\": \"AC-006\", \"criterion\": \"For a package whose resolved release version is the PEP 440 value `1.0.0.dev1` (a dev-release, which the codebase's existing `Version::is_prerelease()` test `pep440_dev_release_is_prerelease` at crates/callisto-model/src/version.rs:365 already asserts must be treated as pre-release), the corresponding `releases[]` entry has `isPrerelease: true`, proving the field is computed via `Version::is_prerelease()` end-to-end through plan_publish rather than a narrower ad hoc check that only recognizes alpha/beta/rc.\", \"is_error_case\": false },\n    { \"id\": \"AC-007\", \"criterion\": \"ReleaseEntry.is_prerelease is computed at its one construction site in crates/callisto-graph/src/commands/publish.rs (the `releases.push(ReleaseEntry { ... })` block) directly from the `ver: &Version` value already resolved and in scope there, by calling `ver.is_prerelease()` -- confirmable by inspecting that no new call to `Version::parse`, no string parsing of `tag_name`, and no regex against the tag string appears anywhere in that construction path.\", \"is_error_case\": false },\n    { \"id\": \"AC-008\", \"criterion\": \".github/actions/callisto-action/action.yml's GitHub Release creation loop (the `::group::5. Creating GitHub Release Entries` block) no longer contains the pattern `=~ -(alpha|beta|rc|pre|next)` anywhere in its script body.\", \"is_error_case\": false },\n    { \"id\": \"AC-009\", \"criterion\": \"For each tag processed by .github/actions/callisto-action/action.yml's GitHub Release creation loop, `gh release create \\\"$TAG\\\" --title \\\"$TAG\\\" --generate-notes` is invoked with the additional flag `--prerelease` if and only if that tag's matching entry in `$PLAN_JSON`'s `releases[]` array has `isPrerelease: true`; when `isPrerelease` is `false`, the same `gh release create` invocation runs with no `--prerelease` flag.\", \"is_error_case\": false },\n    { \"id\": \"AC-010\", \"criterion\": \"A new test file under .github/actions/callisto-action/tests/ (either a new script or an extension of test_status_check_branching.sh) follows the same established harness pattern -- it extracts the exact current run-body text of the `::group::5. Creating GitHub Release Entries` block directly out of action.yml via a `sed` range between its `::group::` and matching `::endgroup::` markers, stubs `gh` (and `jq` remains real) to capture invocation arguments, feeds it a fixture `$PLAN_JSON` value, and asserts on the captured `gh release create` argument list -- so the test cannot drift from action.yml's actual current logic. This test includes at minimum: one case with `isPrerelease: true` where the tag string contains no alpha/beta/rc/pre/next substring (the AC-005 PEP 440 regression fixture), and one case with `isPrerelease: false`.\", \"is_error_case\": false },\n    { \"id\": \"AC-011\", \"criterion\": \"docs/01-spec.md's ReleaseEntry struct documentation block (the section spanning the struct doc comments immediately preceding `pub struct ReleaseEntry` at line 1742, and the decision-table row at line 2667 referencing §M.12.2) is updated to list the new `is_prerelease` / `isPrerelease` field alongside the existing documented fields (`tag_name`, `sha`, `changelog_section`), stating that it is a required (non-optional) boolean.\", \"is_error_case\": false },\n    { \"id\": \"AC-012\", \"criterion\": \"No existing test asserting the JSON shape of a ReleaseEntry (e.g. golden-file or snapshot tests in callisto-graph or callisto-fixtures covering PublishPlan/ReleaseEntry serialization) is left asserting the pre-change shape without `isPrerelease` -- every such test is updated to expect the new field, and the full workspace test suite (`just test` / `moon run :test`) passes with the field present.\", \"is_error_case\": true },\n    { \"id\": \"AC-013\", \"criterion\": \"Because `ver` at ReleaseEntry's construction site in publish.rs is already typed as `&callisto_model::Version` (a value that can only exist as the result of a prior successful `Version::parse` earlier in the pipeline, before plan_publish's package-processing loop runs), there is no code path at the ReleaseEntry construction site where `is_prerelease` is computed from an unparseable or malformed version string -- Rust's type system rules out that error case at this call site, so no error-handling branch (e.g. a default-false fallback) needs to exist there, and none should be added.\", \"is_error_case\": true },\n    { \"id\": \"AC-014\", \"criterion\": \"ReleaseEntry's `is_prerelease` field computation introduces no new dependency edge from callisto-model to any AGPL-licensed crate: `Version::is_prerelease()` is defined and remains defined in crates/callisto-model/src/version.rs, a crate whose Cargo.toml declares `license = \\\"MIT OR Apache-2.0\\\"` and whose `[dependencies]` list (semver, pep440_rs, serde, serde_json, thiserror, miette, camino, path-slash, schemars, tempfile) contains no AGPL crate; `cargo metadata`'s resolve graph for callisto-model shows no edge to any crate licensed AGPL after this change.\", \"is_error_case\": false }\n  ],\n  \"linked_requirement\": \"REQ-008\"\n}\n","numLines":45,"startLine":1,"totalLines":45}},"sourceToolAssistantUUID":"6c9d9780-1b25-4b65-9294-e9cce502fa86","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
