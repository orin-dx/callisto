, 0));\n    let pre_state = callisto_model::format::PreState {\n        mode: callisto_model::format::PreMode::Pre,\n        tag: \"beta\".to_string(),\n        initial_versions,\n        changesets: vec![\"cool-thing\".to_string()],\n    };\n\n    let inference = crate::infer::NoInference;\n    let agg = aggregate(\n        &graph,\n        &identity_for(&graph.pkg),\n        &cfg,\n        &git,\n        &tags,\n        &base_versions,\n        Some(&pre_state),\n        &inference,\n    )\n    .unwrap();\n\n    assert_eq!(agg.new_pre_changesets, vec![\"small-fix\".to_string()]);\n    assert_eq!(\n        agg.severities.get(&pkg_id),\n        Some(&Severity::Minor),\n        \"the recorded minor changeset must still set the severity the new patch changeset is added to\"\n    );\n    assert_eq!(\n        agg.changelog_inputs.get(&pkg_id).map(|input| input.entries.len()),\n        Some(1),\n        \"only the new changeset is logged\"\n    );\n}\n\n/// With no changeset on disk in pre mode, nothing is new."},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01SJF22LMbqi9ugjfvwjE7by","name":"Bash","input":{"command":"cargo test -p callisto-graph --lib aggregate:: > /Users/gabe/.claude/jobs/15c732d1/tmp/agg1.log 2>&1; echo exit=$?; rg -N 'FAILED|panicked|test result' -A4 /Users/gabe/.claude/jobs/15c732d1/tmp/agg1.log | head -20","description":"Run aggregate unit tests","timeout":600000},"caller":{"type":"direct"}}]}}
