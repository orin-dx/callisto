{"parentUuid":"e46209f2-ae96-4ec1-86da-a8cf2d44158d","isSidechain":false,"promptId":"50792f05-f687-4e79-85b2-53e371804b7c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TZBWN42K3GqwcJtQoyZgoJ","type":"tool_result","content":"    /// The committed decision file a release commit writes.\n    #[arg(long, value_name = \"FILE\", default_value = \".callisto/release-decision.json\")]\n    pub decision: PathBuf,\n    /// Count only this release commit and newer ones: the way past a release that cannot finish.\n    #[arg(long, value_name = \"SHA\")]\n    pub from: Option<String>,\n    /// How many of the newest release commits to examine.\n    #[arg(long, value_name = \"N\", default_value_t = 10)]\n    pub limit: usize,\n}\n\n        .map_err(|error| CliError::ReleasePendingFromInvalid {\n            reason: error.to_string(),\n        })?;\n    let runner = CliCommandRunner;\n    let workspace = load_workspace(global, &runner)?;\n    let decision_path = workspace_decision_path(&args.decision, &workspace.root)?;\n    let found = pending_releases(&workspace, &decision_path, args.limit, from.as_ref())?;\n    match global.format {\n        OutputFormat::Json => {\n            let releases: Vec<_> = found\n                .iter()\n                .map(|release| {\n                    serde_json::json!({\n                        \"source\": release.source.as_str(),\n                        \"packages\": release\n                            .packages\n                            .iter()\n                            .map(|(package, version)| serde_json::json!({\n                                \"package\": package.to_string(),\n                                \"version\": version.render(),\n                            }))\n                            .collect::<Vec<_>>(),\n                        \"missing\": release.missing,\n                    })\n                })\n                .collect();\n(eval):1: no matches found: --include=*.md","is_error":f