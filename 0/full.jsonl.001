test | test commands::completions::tests::handle_generates_the_binary_name_into_the_completion_script ... ok\n         callisto-cli:test | test commands::pre::tests::handle_exit_reports_io_error_for_a_nonexistent_cwd ... ok\n         callisto-cli:test | test commands::publish::tests::credential_check_default_crates_io_registry_warns_on_missing_token ... ok\n         callisto-cli:test | test commands::publish::tests::credential_check_no_warnings_when_all_tokens_present ... ok\n         callisto-cli:test | {\n         callisto-cli:test |   \"command\": \"plan-publish\",\n         callisto-cli:test |   \"schemaVersion\": 1,\n         callisto-cli:test |   \"rustCrates\": [\n         callisto-cli:test |     {\n         callisto-cli:test |       \"name\": \"test-crate\",\n         callisto-cli:test |       \"version\": \"1.0.0\",\n         callisto-cli:test |       \"publishTo\": \"cratesIo\"\n         callisto-cli:test |     }\n         callisto-cli:test |   ],\n         callisto-cli:test |   \"npmPlatformPackages\": [],\n         callisto-cli:test |   \"npmMainPackages\": [],\n         callisto-cli:test |   \"releases\": []\n         callisto-cli:test | }\n         callisto-cli:test | \n         callisto-cli:test | use builtin;\n         callisto-cli:test | use str;\n         callisto-cli:test | \n         callisto-cli:test | set edit:completion:arg-completer[callisto] = {|@words|\n         callisto-cli:test |     fn spaces {|n|\n         callisto-cli:test |         builtin:repeat $n ' ' | str:join ''\n         callisto-cli:test |     }\n         callisto-cli:test |     fn cand {|text desc|\n         callisto-cli:test |         edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc\n         callisto-cli:test |     }\n         callisto-cli:test |     var command = 'callisto'\n         callisto-cli:test |     for word $words[1..-1] {\n         callisto-cli:test |         if (str:has-prefix $word '-') {\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         set command = $command';'$word\n         callisto-cli:test |     }\n         callisto-cli:test |     var completions = [\n         callisto-cli:test |         &'callisto'= {\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |             cand -V 'Print version'\n         callisto-cli:test |             cand --version 'Print version'\n         callisto-cli:test |             cand add 'Create a new changeset describing pending package changes'\n         callisto-cli:test |             cand status 'Show the workspace''s pending changesets and diagnostics'\n         callisto-cli:test |             cand matrix 'Print the workspace''s native-build target matrix as JSON or a table'\n         callisto-cli:test |             cand version 'Consume pending changesets and bump package versions accordingly'\n         callisto-cli:test |             cand pre 'Manage prerelease mode for the workspace'\n         callisto-cli:test |             cand validate 'Check that changesets and the dependency graph are well-formed'\n         callisto-cli:test |             cand snapshot 'Apply a temporary, non-persistent version bump for a snapshot release'\n         callisto-cli:test |             cand init 'Scaffold Callisto configuration in the current workspace'\n         callisto-cli:test |             cand plan-publish 'Compute which packages are ready to publish and print the publish plan'\n         callisto-cli:test |             cand publish 'Publish ready packages