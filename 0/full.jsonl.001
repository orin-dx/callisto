{"parentUuid":"85f295e8-e6f0-46af-952d-cdbb841e5945","isSidechain":false,"promptId":"4f144308-e30b-4671-99b2-6f9559f2c99a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WaKExRaGSiwV1WqPCjybYe","type":"tool_result","content":"diff --git a/crates/callisto-cli/tests/usage_exit_codes_tests.rs b/crates/callisto-cli/tests/usage_exit_codes_tests.rs\nindex b39735a27..432c79371 100644\n--- a/crates/callisto-cli/tests/usage_exit_codes_tests.rs\n+++ b/crates/callisto-cli/tests/usage_exit_codes_tests.rs\n@@ -106,6 +106,35 @@ fn bad_or_missing_flag_values_checked_after_parsing_exit_2() {\n     }\n }\n \n+#[test]\n+fn arguments_rejected_while_parsing_exit_2_and_help_and_version_exit_0() {\n+    let dir = workspace();\n+    let root = dir.path();\n+    for args in [\n+        vec![\"status\", \"--no-such-flag\"],\n+        vec![\"no-such-command\"],\n+        vec![\"--format\", \"yaml\", \"status\"],\n+        vec![\"pre\", \"enter\"],\n+        vec![\"--no-such-flag\"],\n+    ] {\n+        for format in [\"json\", \"text\"] {\n+            let out = Command::new(env!(\"CARGO_BIN_EXE_callisto\"))\n+                .args([\"--format\", format, \"--cwd\", root.to_str().unwrap()])\n+                .args(&args)\n+                .output()\n+                .unwrap();\n+            assert_eq!(out.status.code(), Some(2), \"{format} {args:?}: {}\", stderr_of(&out));\n+        }\n+    }\n+    for args in [vec![\"--help\"], vec![\"status\", \"--help\"], vec![\"--version\"]] {\n+        let out = Command::new(env!(\"CARGO_BIN_EXE_callisto\"))\n+            .args(&args)\n+            .output()\n+            .unwrap();\n+        assert_eq!(out.status.code(), Some(0), \"{args:?}: {}\", stderr_of(&out));\n+    }\n+}\n+\n #[test]\n fn runtime_failures_still_exit_1() {\n     let dir = workspace();\ndiff --git a/justfile b/justfile\nindex ad66f2612..b408b9573 100644\n--- a/justfile\n+++ b/justfile\n@@ -199,6 +199,7 @@ release-workflow-checks:\n workflow-contracts: release-workflow-checks\n     bash .github/tests/test_release_candidate_recovery.sh\n     bash .github/tests/verify-action-pins.sh\n+    bash .github/tests/verify-action-inputs.sh\n     bash .github/tests/test-release-artifact-build-script.sh\n     bash .github/tests/test-move-floating-tag.sh\n     bash .github/tests/test-hold-release-pr.sh\n(eval):1: no matches found: crates/*/tests/config_deny*","is_error":false}]},"uuid":"dea5d618-5688-45be-8bc7-cc0304370e39","timestamp":"2026-11-11T18:38:21.676Z","toolUseResult":{"stdout":"diff --git a/crates/callisto-cli/tests/usage_exit_codes_tests.rs b/crates/callisto-cli/tests/usage_exit_codes_tests.rs\nindex b39735a27..432c79371 100644\n--- a/crates/callisto-cli/tests/usage_exit_codes_tests.rs\n+++ b/crates/callisto-cli/tests/usage_exit_codes_tests.rs\n@@ -106,6 +106,35 @@ fn bad_or_missing_flag_values_checked_after_parsing_exit_2() {\n     }\n }\n \n+#[test]\n+fn arguments_rejected_while_parsing_exit_2_and_help_and_version_exit_0() {\n+    let dir = workspace();\n+    let root = dir.path();\n+    for args in [\n+        vec![\"status\", \"--no-such-flag\"],\n+        vec![\"no-such-command\"],\n+        vec![\"--format\", \"yaml\", \"status\"],\n+        vec![\"pre\", \"enter\"],\n+        vec![\"--no-such-flag\"],\n+    ] {\n+        for format in [\"json\", \"text\"] {\n+            let out = Command::new(env!(\"CARGO_BIN_EXE_callisto\"))\n+                .args([\"--format\", format, \"--cwd\", root.to_str().unwrap()])\n+                .args(&args)\n+                .output()\n+                .unwrap();\n+            assert_eq!(out.status.code(), Some(2), \"{format} {args:?}: {}\", stderr_of(&out));\n+        }\n+    }\n+    for args in [vec![\"--help\"], vec![\"status\", \"--help\"], vec![\"--version\"]] {\n+        let out = Command::new(env!(\"CARGO_BIN_EXE_callisto\"))\n+            .args(&args)\n+            .output()\n+            .unwrap();\n+        assert_eq!(out.status.code(), Some(0), \"{args:?}: {}\", stderr_of(&out));\n+    }\n+}\n+\n #[test]\n fn runtime_failures_still_exit_1() {\n     let dir = workspace();\ndiff --git a/justfile b/justfile\nindex ad66f2612..b408b9573 100644\n--- a/justfile\n+++ b/justfile\n@@ -199,6 +199,7 @@ release-workflow-checks:\n workflow-contracts: release-workflow-checks\n     bash .github/tests/test_release_candidate_recovery.sh\n     bash .github/tests/verify-action-pins.sh\n+    bash .github/tests/verify-action-inputs.sh\n     bash .github/tests/test-release-artifact-build-script.sh\n     bash .github/tests/test-move-floating-tag.sh\n     bash .github/tests/test-hold-release-pr.sh\n(eval):1: no matches found: crates/*/tests/config_deny*","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"dangerouslyDisableSandbox":true},"classifierBoundary":true,"serverClassifierContext":{"request":"34d2bfb4-432d-4aef-bdec-fc59ee459de5","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a5e465e9b44611fbd","root":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a5e465e9b44611fbd","branch":"test/stability-contracts","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callisto","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a5e465e9b44611fbd","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"85f295e8-e6f0-46af-952d-cdbb841e5945","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.clau