{"parentUuid":"7cbd297f-09be-466f-85e9-59ccb4d97167","isSidechain":false,"message":{"model":"claude-sonnet-5","id":"msg_011CeGjQnGnzgNrqPZSzfVve","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UAMNiufLorWCBj9kmnkRgk","name":"Read","input":{"file_path":"/Users/gabe/Projects/callisto/.changeset/release-pipeline-contract.md"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":371,"cache_read_input_tokens":251764,"output_tokens":133,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":371,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":133,"cache_read_input_tokens":251764,"cache_creation_input_tokens":371,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":371},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CeGjQmHG9vWNhPd34YTBc","type":"assistant","uuid":"e3e9adc9-5c74-4c67-95a9-cbfd52c955b2","timestamp":"2026-08-21T23:06:03.280Z","effort":"high","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
{"parentUuid":"e3e9adc9-5c74-4c67-95a9-cbfd52c955b2","isSidechain":false,"promptId":"e877a5a9-a850-4545-ae4f-100d7e4ceb26","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UAMNiufLorWCBj9kmnkRgk","type":"tool_result","content":"1\t---\n2\tcallisto-model: minor\n3\tcallisto-graph: minor\n4\tcallisto-cli: minor\n5\tcallisto-moon: patch\n6\t---\n7\t\n8\t# Release-pipeline / CI Action contract correctness\n9\t\n10\t## Breaking Changes\n11\t\n12\t- **JSON report fields renamed** — visible via `callisto-cli --format json`:\n13\t  - `ValidateReport.valid` → `ok`\n14\t  - `ComposePrBodyReport.pr_body` → `body`\n15\t  - `TagReport.created_tags` → `tags` (plus new `already_existed: bool`)\n16\t  - `StatusReport` gained `hasChangesets`, `lastReleasedVersion`, `releaseTrigger`\n17\t  - `ReleaseEntry` gained a required `isPrerelease: bool`, computed from the resolved version (covers both SemVer's `-` prerelease component and PEP 440's dev/pre segments)\n18\t  - Update anything parsing this JSON, including the shipped GitHub Action.\n19\t\n20\t## Fixes\n21\t\n22\t- `callisto tag` no longer fabricates a `sha`: when a tag already exists at a different commit, it now resolves the real target via `git rev-parse` (both apply and `--dry-run` modes).\n23\t- The shipped GitHub Action's `status --check` branching now matches the CLI's real exit codes (1 = pending, 2 = none pending) — the release-PR creation step was previously unreachable.\n24\t- The GitHub Action's GitHub Release creation loop now reads each release entry's `isPrerelease` field directly instead of guessing from the tag string (the old `-(alpha|beta|rc|pre|next)` regex missed PEP 440 prereleases like `1.2.3a1` entirely), and hard-fails before creating a release if that field is missing or non-boolean rather than silently treating it as `false`.\n25\t- `plan_publish` now reads the real `CHANGELOG.md` section back for each release instead of always leaving `changelogSection` blank.\n26\t"}]},"uuid":"db8729a9-df96-4907-99d4-fda555f672d3","timestamp":"2026-08-21T23:06:03.345Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.changeset/release-pipeline-contract.md","content":"---\ncallisto-model: minor\ncallisto-graph: minor\ncallisto-cli: minor\ncallisto-moon: patch\n---\n\n# Release-pipeline / CI Action contract correctness\n\n## Breaking Changes\n\n- **JSON report fields renamed** — visible via `callisto-cli --format json`:\n  - `ValidateReport.valid` → `ok`\n  - `ComposePrBodyReport.pr_body` → `body`\n  - `TagReport.created_tags` → `tags` (plus new `already_existed: bool`)\n  - `StatusReport` gained `hasChangesets`, `lastReleasedVersion`, `releaseTrigger`\n  - `ReleaseEntry` gained a required `isPrerelease: bool`, computed from the resolved version (covers both SemVer's `-` prerelease component and PEP 440's dev/pre segments)\n  - Update anything parsing this JSON, including the shipped GitHub Action.\n\n## Fixes\n\n- `callisto tag` no longer fabricates a `sha`: when a tag already exists at a different commit, it now resolves the real target via `git rev-parse` (both apply and `--dry-run` modes).\n- The shipped GitHub Action's `status --check` branching now matches the CLI's real exit codes (1 = pending, 2 = none pending) — the release-PR creation step was previously unreachable.\n- The GitHub Action's GitHub Release creation loop now reads each release entry's `isPrerelease` field directly instead of guessing from the tag string (the old `-(alpha|beta|rc|pre|next)` regex missed PEP 440 prereleases like `1.2.3a1` entirely), and hard-fails before creating a release if that field is missing or non-boolean rather than silently treating it as `false`.\n- `plan_publish` now reads the real `CHANGELOG.md` section back for each release instead of always leaving `changelogSection` blank.\n","numLines":26,"startLine":1,"totalLines":26}},"sourceToolAssistantUUID":"e3e9adc9-5c74-4c67-95a9-cbfd52c955b2","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
