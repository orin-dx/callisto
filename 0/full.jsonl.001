{"parentUuid":"dfa5866b-6aba-4167-a1f4-2ad20ca626b6","isSidechain":false,"promptId":"011bae84-ade9-44c0-8dfb-2ca48d67535f","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XuFVNn59PJgLkgRoeywCn6","type":"tool_result","content":"1\tname: 'Callisto Release Action'\n2\tdescription: 'Automated changesets release manager: creates version PRs or publishes packages'\n3\tinputs:\n4\t  publish:\n5\t    description: 'Command to run when publishing packages (e.g. \"moon run :publish\", \"cargo publish\", or \"pnpm publish\")'\n6\t    required: false\n7\t  version_command:\n8\t    description: 'Custom version command to run (defaults to \"callisto version\")'\n9\t    required: false\n10\t    default: 'callisto version'\n11\t  commit_message:\n12\t    description: 'Commit message for the Version PR'\n13\t    required: false\n14\t    default: 'chore(release): version packages'\n15\t  title:\n16\t    description: 'Title for the Version PR'\n17\t    required: false\n18\t    default: 'chore(release): version packages'\n19\t  pr_label:\n20\t    description: 'Label to attach to the Version Packages Pull Request'\n21\t    required: false\n22\t    default: 'callisto: release'\n23\t  create_github_release:\n24\t    description: 'Whether to create GitHub Release entries for calculated tags'\n25\t    required: false\n26\t    default: 'true'\n27\t  setup_git_user:\n28\t    description: 'Whether to automatically configure git user.name and user.email'\n29\t    required: false\n30\t    default: 'true'\n31\t  branch:\n32\t    description: 'Base branch for Version PRs'\n33\t    required: false\n34\t    default: 'main'\n35\t  cwd:\n36\t    description: 'Working directory path if workspace is in a subfolder'\n37\t    required: false\n38\t    default: '.'\n39\t\n40\toutputs:\n41\t  hasChangesets:\n42\t    description: 'Whether pending changesets were found'\n43\t    value: ${{ steps.callisto-orchestrate.outputs.hasChangesets }}\n44\t  published:\n45\t    description: 'Whether packages were published'\n46\t    value: ${{ steps.callisto-orchestrate.outputs.published }}\n47\t  publishedPackages:\n48\t    description: 'JSON list of published packages'\n49\t    value: ${{ steps.callisto-orchestrate.outputs.publishedPackages }}\n50\t  nativeMatrix:\n51\t    description: 'JSON array of native platform build targets discovered from manifests (callisto matrix output). Empty array when no native packages are present or callisto matrix is not yet available.'\n52\t    value: ${{ steps.callisto-orchestrate.outputs.nativeMatrix }}\n53\t\n54\truns:\n55\t  using: 'composite'\n56\t  steps:\n57\t    - name: Setup Callisto Environment\n58\t      uses: ./.github/actions/setup-callisto\n59\t\n60\t    - name: Orchestrate Version PR or Publish\n61\t      id: callisto-orchestrate\n62\t      shell: bash\n63\t      env:\n64\t        INPUT_PUBLISH: ${{ inputs.publish }}\n65\t        INPUT_VERSION_COMMAND: ${{ inputs.version_command }}\n66\t        INPUT_COMMIT_MESSAGE: ${{ inputs.commit_message }}\n67\t        INPUT_TITLE: ${{ inputs.title }}\n68\t        INPUT_PR_LABEL: ${{ inputs.pr_label }}\n69\t        INPUT_CREATE_GITHUB_RELEASE: ${{ inputs.create_github_release }}\n70\t        INPUT_SETUP_GIT_USER: ${{ inputs.setup_git_user }}\n71\t        INPUT_BRANCH: ${{ inputs.branch }}\n72\t        INPUT_CWD: ${{ inputs.cwd }}\n73\t        GH_TOKEN: ${{ env.GITHUB_TOKEN }}\n74\t        NPM_TOKEN: ${{ env.NPM_TOKEN }}\n75\t        CARGO_REGISTRY_TOKEN: ${{ env.CARGO_REGISTRY_TOKEN }}\n76\t        TWINE_PASSWORD: ${{ env.TWINE_PASSWORD }}\n77\t        FORCE_COLOR: \"1\"\n78\t        CLICOLOR_FORCE: \"1\"\n79\t      run: |\n80\t        set -e\n81\t        if [[ \"$INPUT_CWD\" != \".\" ]]; then\n82\t          cd \"$INPUT_CWD\"\n83\t        fi\n84\t\n85\t        echo \"::group::1. Inspecting Workspace Status\"\n86\t        set +e\n87\t        callisto status --check\n88\t        STATUS_EXIT=$?\n89\t        set -e\n90\t        if [[ $STATUS_EXIT -eq 1 ]]; then\n91\t          HAS_CHANGESETS=true\n92\t        elif [[ $STATUS_EXIT -eq 2 ]]; then\n93\t          HAS_CHANGESETS=false\n94\t        else\n95\t          echo \"::error::callisto status --check exited with unexpected code $STATUS_EXIT (expected 1 for pending changesets or 2 for none pending)\"\n96\t          exit 1\n97\t        fi\n98\t        echo \"::endgroup::\"\n99\t\n100\t        if [[ \"$HAS_CHANGESETS\" == \"true\" ]]; then\n101\t          echo \"hasChangesets=true\" >> $GITHUB_OUTPUT\n102\t          echo \"published=false\" >> $GITHUB_OUTPUT\n103\t\n104\t          EXISTING_PR_BODY=$(gh pr list --head callisto/version-packages --json body --jq '.[0].body // empty' 2>/dev/null || true)\n105\t\n106\t          echo \"::group::2. Composing Version PR Body\"\n107\t          if [[ -n \"$EXISTING_PR_BODY\" ]]; then\n108\t            PR_BODY=$(echo \"$EXISTING_PR_BODY\" | callisto compose-pr-body --existing-body - --label \"$INPUT_PR_LABEL\" --branch \"$INPUT_BRANCH\" --format text)\n109\t          else\n110\t            PR_BODY=$(callisto compose-pr-body --label \"$INPUT_PR_LABEL\" --branch \"$INPUT_BRANCH\" --format text)\n111\t          fi\n112\t          echo \"$PR_BODY\"\n113\t          echo \"::endgroup::\"\n114\t\n115\t          echo \"::group::3. Bumping Package Versions ($INPUT_VERSION_COMMAND)\"\n116\t          read -ra _version_cmd <<< \"$INPUT_VERSION_COMMAND\"\n117\t          \"${_version_cmd[@]}\"\n118\t          echo \"::endgroup::\"\n119\t\n120\t          echo \"::group::4. Creating / Updating Version Packages Pull Request\"\n121\t          if [[ -n $(git status --porcelain) ]]; then\n122\t            if [[ \"$INPUT_SETUP_GIT_USER\" == \"true\" ]]; then\n123\t              git config user.name \"github-actions[bot]\"\n124\t              git config user.email \"github-actions[bot]@users.noreply.github.com\"\n125\t            fi\n126\t\n127\t            git checkout -B callisto/version-packages\n128\t            git add -A\n129\t            git commit -m \"$INPUT_COMMIT_MESSAGE\"\n130\t            git push origin callisto/version-packages --force\n131\t\n132\t            if [[ -n \"$INPUT_PR_LABEL\" ]]; then\n133\t              gh label create \"$INPUT_PR_LABEL\" --color \"0e8a16\" --description \"Release packages\" 2>/dev/null || true\n134\t            fi\n135\t\n136\t            EXISTING_PR=$(gh pr list --head callisto/version-packages --json number --jq '.[0].number // empty')\n137\t            if [[ -n \"$EXISTING_PR\" ]]; then\n138\t              gh pr edit \"$EXISTING_PR\" --title \"$INPUT_TITLE\" --body \"$PR_BODY\" || true\n139\t              if [[ -n \"$INPUT_PR_LABEL\" ]]; then\n140\t                gh pr edit \"$EXISTING_PR\" --add-label \"$INPUT_PR_LABEL\" || true\n141\t              fi\n142\t            else\n143\t              if [[ -n \"$INPUT_PR_LABEL\" ]]; then\n144\t                gh pr create --title \"$INPUT_TITLE\" --body \"$PR_BODY\" --head callisto/version-packages --base \"$INPUT_BRANCH\" --label \"$INPUT_PR_LABEL\" || gh pr create --title \"$INPUT_TITLE\" --body \"$PR_BODY\" --head callisto/version-packages --base \"$INPUT_BRANCH\"\n145\t              else\n146\t                gh pr create --title \"$INPUT_TITLE\" --body \"$PR_BODY\" --head callisto/version-packages --base \"$INPUT_BRANCH\"\n147\t              fi\n148\t            fi\n149\t\n150\t            echo \"### Version Packages PR Created/Updated\" >> $GITHUB_STEP_SUMMARY\n151\t            echo \"$PR_BODY\" >> $GITHUB_STEP_SUMMARY\n152\t          fi\n153\t          echo \"::endgroup::\"\n154\t        else\n155\t          echo \"hasChangesets=false\" >> $GITHUB_OUTPUT\n156\t\n157\t          # Emit native matrix targets for downstream build jobs, deduplicated\n158\t          # by artifactName in case the same triple is declared by more than\n159\t          # one package's platform-target group. set -o pipefail ensures a\n160\t          # hard `callisto matrix` error (e.g. malformed manifest, conflicting\n161\t          # platform-target sources) fails this step instead of silently\n162\t          # producing empty output.\n163\t          set -o pipefail\n164\t          NATIVE_MATRIX=$(callisto matrix --format json | jq -c '[.platformTargets[].targets[]] | unique_by(.artifactName)') || { echo \"::error::callisto matrix failed\"; exit 1; }\n165\t          echo \"nativeMatrix=$NATIVE_MATRIX\" >> $GITHUB_OUTPUT\n166\t\n167\t          if [[ -n \"$INPUT_PUBLISH\" && \"$INPUT_PUBLISH\" != \"false\" ]]; then\n168\t            echo \"::group::2. Calculating Topological Publish Plan\"\n169\t            PLAN_JSON=$(callisto plan-publish --format json)\n170\t            echo \"$PLAN_JSON\"\n171\t            echo \"::endgroup::\"\n172\t\n173\t            # Wire NPM_TOKEN into npm config so npm publish can authenticate.\n174\t            # NPM_TOKEN is forwarded explicitly in this step's env: block so it\n175\t            # is available regardless of how the caller sets it.\n176\t            if [[ -n \"$NPM_TOKEN\" ]]; then\n177\t              npm config set //registry.npmjs.org/:_authToken \"$NPM_TOKEN\"\n178\t            fi\n179\t\n180\t            echo \"::group::3. Executing Package Publishing\"\n181\t            if [[ \"$INPUT_PUBLISH\" != \"true\" ]]; then\n182\t              echo \"Executing custom publish script: $INPUT_PUBLISH\"\n183\t              read -ra _publish_cmd <<< \"$INPUT_PUBLISH\"\n184\t              \"${_publish_cmd[@]}\"\n185\t            else\n186\t              callisto publish\n187\t            fi\n188\t            echo \"::endgroup::\"\n189\t\n190\t            echo \"published=true\" >> $GITHUB_OUTPUT\n191\t            echo \"publishedPackages<<EOF\" >> $GITHUB_OUTPUT\n192\t            echo \"$PLAN_JSON\" >> $GITHUB_OUTPUT\n193\t            echo \"EOF\" >> $GITHUB_OUTPUT\n194\t\n195\t            echo \"::group::4. Tagging Release Commits & Updating Major Version Pointer Aliases\"\n196\t            callisto tag --plan \"$PLAN_JSON\" --floating-major || true\n197\t            git push origin --tags || true\n198\t            echo \"::endgroup::\"\n199\t\n200\t            if [[ \"$INPUT_CREATE_GITHUB_RELEASE\" == \"true\" ]]; then\n201\t              echo \"::group::5. Creating GitHub Release Entries\"\n202\t              for TAG in $(echo \"$PLAN_JSON\" | jq -r '.releases[]?.tagName // empty'); do\n203\t                if [[ -n \"$TAG\" ]]; then\n204\t                  echo \"Creating GitHub Release for tag: $TAG\"\n205\t                  \n206\t                  # Detect if tag is a SemVer prerelease (contains alpha/beta/rc/pre)\n207\t                  EXTRA_FLAGS=\"\"\n208\t                  if [[ \"$TAG\" =~ -(alpha|beta|rc|pre|next) ]]; then\n209\t                    EXTRA_FLAGS=\"--prerelease\"\n210\t                  fi\n211\t\n212\t                  gh release create \"$TAG\" --title \"$TAG\" --generate-notes $EXTRA_FLAGS || true\n213\t                fi\n214\t              done\n215\t              echo \"::endgroup::\"\n216\t            fi\n217\t\n218\t            echo \"### Packages Published Successfully\" >> $GITHUB_STEP_SUMMARY\n219\t          else\n220\t            echo \"published=false\" >> $GITHUB_OUTPUT\n221\t            echo \"No changesets pending and no publish command provided.\"\n222\t          fi\n223\t        fi\n224\t"}]},"uuid":"0bbb857f-6da0-4c26-8ecd-20b2c8b0fa2a","timestamp":"2026-08-21T18:55:36.990Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.github/actions/callisto-action/action.yml","content":"name: 'Callisto Release Action'\ndescription: 'Automated changesets release manager: creates version PRs or publishes packages'\ninputs:\n  publish:\n    description: 'Command to run when publishing packages (e.g. \"moon run :publish\", \"cargo publish\", or \"pnpm publish\")'\n    required: false\n  version_command:\n    description: 'Custom version command to run (defaults to \"callisto version\")'\n    required: false\n    default: 'callisto version'\n  commit_message:\n    description: 'Commit message for the Version PR'\n    required: false\n    default: 'chore(release): version packages'\n  title:\n    description: 'Title for the Version PR'\n    required: false\n    default: 'chore(release): version packages'\n  pr_label:\n    description: 'Label to attach to the Version Packages Pull Request'\n    required: false\n    default: 'callisto: release'\n  create_github_release:\n    description: 'Whether to create GitHub Release entries for calculated tags'\n    required: false\n    default: 'true'\n  setup_git_user:\n    description: 'Whether to automatically configure git user.name and user.email'\n    required: false\n    default: 'true'\n  branch:\n    description: 'Base branch for Version PRs'\n    required: false\n    default: 'main'\n  cwd:\n    description: 'Working directory path if workspace is in a subfolder'\n    required: false\n    default: '.'\n\noutputs:\n  hasChangesets:\n    description: 'Whether pending changesets were found'\n    value: ${{ steps.callisto-orchestrate.outputs.hasChangesets }}\n  published:\n    description: 'Whether packages were published'\n    value: ${{ steps.callisto-orchestrate.outputs.published }}\n  publishedPackages:\n    description: 'JSON list of published packages'\n    value: ${{ steps.callisto-orchestrate.outputs.publishedPackages }}\n  nativeMatrix:\n    description: 'JSON array of native platform build targets discovered from manifests (callisto matrix output). Empty array when no native packages are present or callisto matrix is not yet available.'\n    value: ${{ steps.callisto-orchestrate.outputs.nativeMatrix }}\n\nruns:\n  using: 'composite'\n  steps:\n    - name: Setup Callisto Environment\n      uses: ./.github/actions/setup-callisto\n\n    - name: Orchestrate Version PR or Publish\n      id: callisto-orchestrate\n      shell: bash\n      env:\n        INPUT_PUBLISH: ${{ inputs.publish }}\n        INPUT_VERSION_COMMAND: ${{ inputs.version_command }}\n        INPUT_COMMIT_MESSAGE: ${{ inputs.commit_message }}\n        INPUT_TITLE: ${{ inputs.title }}\n        INPUT_PR_LABEL: ${{ inputs.pr_label }}\n        INPUT_CREATE_GITHUB_RELEASE: ${{ inputs.create_github_release }}\n        INPUT_SETUP_GIT_USER: ${{ inputs.setup_git_user }}\n        INPUT_BRANCH: ${{ inputs.branch }}\n        INPUT_CWD: ${{ inputs.cwd }}\n        GH_TOKEN: ${{ env.GITHUB_TOKEN }}\n        NPM_TOKEN: ${{ env.NPM_TOKEN }}\n        CARGO_REGISTRY_TOKEN: ${{ env.CARGO_REGISTRY_TOKEN }}\n        TWINE_PASSWORD: ${{ env.TWINE_PASSWORD }}\n        FORCE_COLOR: \"1\"\n        CLICOLOR_FORCE: \"1\"\n      run: |\n        set -e\n        if [[ \"$INPUT_CWD\" != \".\" ]]; then\n          cd \"$INPUT_CWD\"\n        fi\n\n        echo \"::group::1. Inspecting Workspace Status\"\n        set +e\n        callisto status --check\n        STATUS_EXIT=$?\n        set -e\n        if [[ $STATUS_EXIT -eq 1 ]]; then\n          HAS_CHANGESETS=true\n        elif [[ $STATUS_EXIT -eq 2 ]]; then\n          HAS_CHANGESETS=false\n        else\n          echo \"::error::callisto status --check exited with unexpected code $STATUS_EXIT (expected 1 for pending changesets or 2 for none pending)\"\n          exit 1\n        fi\n        echo \"::endgroup::\"\n\n        if [[ \"$HAS_CHANGESETS\" == \"true\" ]]; then\n          echo \"hasChangesets=true\" >> $GITHUB_OUTPUT\n          echo \"published=false\" >> $GITHUB_OUTPUT\n\n          EXISTING_PR_BODY=$(gh pr list --head callisto/version-packages --json body --jq '.[0].body // empty' 2>/dev/null || true)\n\n          echo \"::group::2. Composing Version PR Body\"\n          if [[ -n \"$EXISTING_PR_BODY\" ]]; then\n            PR_BODY=$(echo \"$EXISTING_PR_BODY\" | callisto compose-pr-body --existing-body - --label \"$INPUT_PR_LABEL\" --branch \"$INPUT_BRANCH\" --format text)\n          else\n            PR_BODY=$(callisto compose-pr-body --label \"$INPUT_PR_LABEL\" --branch \"$INPUT_BRANCH\" --format text)\n          fi\n          echo \"$PR_BODY\"\n          echo \"::endgroup::\"\n\n          echo \"::group::3. Bumping Package Versions ($INPUT_VERSION_COMMAND)\"\n          read -ra _version_cmd <<< \"$INPUT_VERSION_COMMAND\"\n          \"${_version_cmd[@]}\"\n          echo \"::endgroup::\"\n\n          echo \"::group::4. Creating / Updating Version Packages Pull Request\"\n          if [[ -n $(git status --porcelain) ]]; then\n            if [[ \"$INPUT_SETUP_GIT_USER\" == \"true\" ]]; then\n              git config user.name \"github-actions[bot]\"\n              git config user.email \"github-actions[bot]@users.noreply.github.com\"\n            fi\n\n            git checkout -B callisto/version-packages\n            git add -A\n            git commit -m \"$INPUT_COMMIT_MESSAGE\"\n            git push origin callisto/version-packages --force\n\n            if [[ -n \"$INPUT_PR_LABEL\" ]]; then\n              gh label create \"$INPUT_PR_LABEL\" --color \"0e8a16\" --description \"Release packages\" 2>/dev/null || true\n            fi\n\n            EXISTING_PR=$(gh pr list --head callisto/version-packages --json number --jq '.[0].number // empty')\n            if [[ -n \"$EXISTING_PR\" ]]; then\n              gh pr edit \"$EXISTING_PR\" --title \"$INPUT_TITLE\" --body \"$PR_BODY\" || true\n              if [[ -n \"$INPUT_PR_LABEL\" ]]; then\n                gh pr edit \"$EXISTING_PR\" --add-label \"$INPUT_PR_LABEL\" || true\n              fi\n            else\n              if [[ -n \"$INPUT_PR_LABEL\" ]]; then\n                gh pr create --title \"$INPUT_TITLE\" --body \"$PR_BODY\" --head callisto/version-packages --base \"$INPUT_BRANCH\" --label \"$INPUT_PR_LABEL\" || gh pr create --title \"$INPUT_TITLE\" --body \"$PR_BODY\" --head callisto/version-packages --base \"$INPUT_BRANCH\"\n              else\n                gh pr create --title \"$INPUT_TITLE\" --body \"$PR_BODY\" --head callisto/version-packages --base \"$INPUT_BRANCH\"\n              fi\n            fi\n\n            echo \"### Version Packages PR Created/Updated\" >> $GITHUB_STEP_SUMMARY\n            echo \"$PR_BODY\" >> $GITHUB_STEP_SUMMARY\n          fi\n          echo \"::endgroup::\"\n        else\n          echo \"hasChangesets=false\" >> $GITHUB_OUTPUT\n\n          # Emit native matrix targets for downstream build jobs, deduplicated\n          # by artifactName in case the same triple is declared by more than\n          # one package's platform-target group. set -o pipefail ensures a\n          # hard `callisto matrix` error (e.g. malformed manifest, conflicting\n          # platform-target sources) fails this step instead of silently\n          # producing empty output.\n          set -o pipefail\n          NATIVE_MATRIX=$(callisto matrix --format json | jq -c '[.platformTargets[].targets[]] | unique_by(.artifactName)') || { echo \"::error::callisto matrix failed\"; exit 1; }\n          echo \"nativeMatrix=$NATIVE_MATRIX\" >> $GITHUB_OUTPUT\n\n          if [[ -n \"$INPUT_PUBLISH\" && \"$INPUT_PUBLISH\" != \"false\" ]]; then\n            echo \"::group::2. Calculating Topological Publish Plan\"\n            PLAN_JSON=$(callisto plan-publish --format json)\n            echo \"$PLAN_JSON\"\n            echo \"::endgroup::\"\n\n            # Wire NPM_TOKEN into npm config so npm publish can authenticate.\n            # NPM_TOKEN is forwarded explicitly in this step's env: block so it\n            # is available regardless of how the caller sets it.\n            if [[ -n \"$NPM_TOKEN\" ]]; then\n              npm config set //registry.npmjs.org/:_authToken \"$NPM_TOKEN\"\n            fi\n\n            echo \"::group::3. Executing Package Publishing\"\n            if [[ \"$INPUT_PUBLISH\" != \"true\" ]]; then\n              echo \"Executing custom publish script: $INPUT_PUBLISH\"\n              read -ra _publish_cmd <<< \"$INPUT_PUBLISH\"\n              \"${_publish_cmd[@]}\"\n            else\n              callisto publish\n            fi\n            echo \"::endgroup::\"\n\n            echo \"published=true\" >> $GITHUB_OUTPUT\n            echo \"publishedPackages<<EOF\" >> $GITHUB_OUTPUT\n            echo \"$PLAN_JSON\" >> $GITHUB_OUTPUT\n            echo \"EOF\" >> $GITHUB_OUTPUT\n\n            echo \"::group::4. Tagging Release Commits & Updating Major Version Pointer Aliases\"\n            callisto tag --plan \"$PLAN_JSON\" --floating-major || true\n            git push origin --tags || true\n            echo \"::endgroup::\"\n\n            if [[ \"$INPUT_CREATE_GITHUB_RELEASE\" == \"true\" ]]; then\n              echo \"::group::5. Creating GitHub Release Entries\"\n              for TAG in $(echo \"$PLAN_JSON\" | jq -r '.releases[]?.tagName // empty'); do\n                if [[ -n \"$TAG\" ]]; then\n                  echo \"Creating GitHub Release for tag: $TAG\"\n                  \n                  # Detect if tag is a SemVer prerelease (contains alpha/beta/rc/pre)\n                  EXTRA_FLAGS=\"\"\n                  if [[ \"$TAG\" =~ -(alpha|beta|rc|pre|next) ]]; then\n                    EXTRA_FLAGS=\"--prerelease\"\n                  fi\n\n                  gh release create \"$TAG\" --title \"$TAG\" --generate-notes $EXTRA_FLAGS || true\n                fi\n              done\n              echo \"::endgroup::\"\n            fi\n\n            echo \"### Packages Published Successfully\" >> $GITHUB_STEP_SUMMARY\n          else\n            echo \"published=false\" >> $GITHUB_OUTPUT\n            echo \"No changesets pending and no publish command provided.\"\n          fi\n        fi\n","numLines":224,"startLine":1,"totalLines":224}},"sourceToolAssistantUUID":"dfa5866b-6aba-4167-a1f4-2ad20ca626b6","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
