{"parentUuid":"7af496e3-1a3c-408c-b8cd-6c0df08e10f3","isSidechain":false,"promptId":"d50dc13a-9849-4c1d-a548-8de9362e2fef","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DjFZcvv3xr7c4yPxFCRHhp","type":"tool_result","content":"1\tuse callisto_graph::commands::{plan_version, VersionOptions};\n2\tuse callisto_graph::infer::NoInference;\n3\tuse callisto_graph::locate::IgnoreWalkLocator;\n4\tuse callisto_graph::Workspace;\n5\tuse callisto_graph::{apply_version_plan, ApplyOptions};\n6\tuse callisto_model::{\n7\t    ApplyPermit, CommandError, CommandOutput, CommandRunner, PackageId, Severity,\n8\t};\n9\tuse std::fs;\n10\tuse std::path::Path;\n11\t\n12\tstruct NoopRunner;\n13\t\n14\timpl CommandRunner for NoopRunner {\n15\t    fn run(\n16\t        &self,\n17\t        _program: &str,\n18\t        _args: &[&str],\n19\t        _cwd: &Path,\n20\t    ) -> Result<CommandOutput, CommandError> {\n21\t        Ok(CommandOutput {\n22\t            exit_code: Some(0),\n23\t            stdout: String::new(),\n24\t            stderr: String::new(),\n25\t        })\n26\t    }\n27\t}\n28\t\n29\tfn git_init_with_commit(root: &Path) {\n30\t    for args in [\n31\t        vec![\"init\", \"-q\"],\n32\t        vec![\"config\", \"user.email\", \"test@example.com\"],\n33\t        vec![\"config\", \"user.name\", \"Test\"],\n34\t    ] {\n35\t        std::process::Command::new(\"git\")\n36\t            .args(&args)\n37\t            .current_dir(root)\n38\t            .output()\n39\t            .expect(\"git command should run\");\n40\t    }\n41\t    fs::write(root.join(\".gitkeep\"), \"\").unwrap();\n42\t    for args in [vec![\"add\", \".\"], vec![\"commit\", \"-q\", \"-m\", \"init\"]] {\n43\t        std::process::Command::new(\"git\")\n44\t            .args(&args)\n45\t            .current_dir(root)\n46\t            .output()\n47\t            .expect(\"git command should run\");\n48\t    }\n49\t}\n50\t\n51\t/// Verifies that plan_version produces correct bumps for all packages in a\n52\t/// cascade chain: pkg-core receives a Major bump from a changeset; pkg-app\n53\t/// depends on pkg-core via ^1.0.0 and should receive a cascade bump.\n54\t///\n55\t/// This test is a correctness guard for the O(N²) → O(N) refactor:\n56\t///   PERF-006: pre-built pkg_map in the plan_version severity loop.\n57\t///   PERF-008: HashSet-based dedup in the pre-release changeset update path.\n58\t#[test]\n59\tfn test_plan_version_produces_correct_bumps_in_cascade() {\n60\t    let tmp = tempfile::tempdir().unwrap();\n61\t    let root = tmp.path();\n62\t    git_init_with_commit(root);\n63\t\n64\t    // pkg-core: the library that receives a breaking-change bump directly.\n65\t    fs::create_dir_all(root.join(\"pkg-core\")).unwrap();\n66\t    fs::write(\n67\t        root.join(\"pkg-core/Cargo.toml\"),\n68\t        \"[package]\\nname = \\\"pkg-core\\\"\\nversion = \\\"1.0.0\\\"\\n\",\n69\t    )\n70\t    .unwrap();\n71\t\n72\t    // pkg-app: depends on pkg-core, will receive a Patch cascade bump after\n73\t    // pkg-core bumps to 2.0.0 (out of range for ^1.0.0).\n74\t    fs::create_dir_all(root.join(\"pkg-app\")).unwrap();\n75\t    fs::write(\n76\t        root.join(\"pkg-app/Cargo.toml\"),\n77\t        \"[package]\\nname = \\\"pkg-app\\\"\\nversion = \\\"1.0.0\\\"\\n\\n[dependencies]\\npkg-core = \\\"1.0.0\\\"\\n\",\n78\t    )\n79\t    .unwrap();\n80\t\n81\t    // Changeset: major bump on pkg-core only.\n82\t    fs::create_dir_all(root.join(\".changeset\")).unwrap();\n83\t    fs::write(\n84\t        root.join(\".changeset/breaking-api.md\"),\n85\t        \"---\\n\\\"pkg-core\\\": major\\n---\\n\\nBreaking API change.\\n\",\n86\t    )\n87\t    .unwrap();\n88\t\n89\t    let locator = IgnoreWalkLocator::new(root);\n90\t    let runner = NoopRunner;\n91\t    let ws = Workspace::load(root.to_path_buf(), &locator, &runner)\n92\t        .expect(\"workspace should load from temp dir\");\n93\t\n94\t    let inference = NoInference;\n95\t    let opts = VersionOptions {\n96\t        strict: false,\n97\t        strict_graph: false,\n98\t        allow_empty_changesets: true,\n99\t    };\n100\t\n101\t    let plan = plan_version(&ws, &inference, &opts).expect(\"plan_version should succeed\");\n102\t\n103\t    let pkg_core = PackageId::parse(\"pkg-core\").unwrap();\n104\t    let pkg_app = PackageId::parse(\"pkg-app\").unwrap();\n105\t\n106\t    let bump_for = |id: &PackageId| plan.bumps.iter().find(|b| &b.package == id);\n107\t\n108\t    let core_bump = bump_for(&pkg_core).expect(\"pkg-core should have a planned bump\");\n109\t    assert_eq!(\n110\t        core_bump.severity,\n111\t        Severity::Major,\n112\t        \"pkg-core should receive a Major bump from the changeset\"\n113\t    );\n114\t\n115\t    let app_bump =\n116\t        bump_for(&pkg_app).expect(\"pkg-app should receive a cascade bump from pkg-core's major\");\n117\t    assert!(\n118\t        app_bump.severity != Severity::None,\n119\t        \"pkg-app cascade bump should be non-None, got {:?}\",\n120\t        app_bump.severity\n121\t    );\n122\t}\n123\t\n124\t/// Two packages in different directories sharing the same name must NOT\n125\t/// silently discard one of them. Before the fix, `ManifestWalkResolver::build`\n126\t/// used `BTreeMap::insert` with the `PackageId` (name-only) as key; the\n127\t/// second crate with the same name silently replaced the first with no error\n128\t/// or diagnostic, making one crate permanently invisible to all operations.\n129\t///\n130\t/// After the fix, `Workspace::load` must return `Err(GraphError::DuplicatePackage)`."}]},"uuid":"90662d68-0348-43e6-a17a-3bd824e33649","timestamp":"2026-08-21T17:41:28.178Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/crates/callisto-graph/tests/version_tests.rs","content":"use callisto_graph::commands::{plan_version, VersionOptions};\nuse callisto_graph::infer::NoInference;\nuse callisto_graph::locate::IgnoreWalkLocator;\nuse callisto_graph::Workspace;\nuse callisto_graph::{apply_version_plan, ApplyOptions};\nuse callisto_model::{\n    ApplyPermit, CommandError, CommandOutput, CommandRunner, PackageId, Severity,\n};\nuse std::fs;\nuse std::path::Path;\n\nstruct NoopRunner;\n\nimpl CommandRunner for NoopRunner {\n    fn run(\n        &self,\n        _program: &str,\n        _args: &[&str],\n        _cwd: &Path,\n    ) -> Result<CommandOutput, CommandError> {\n        Ok(CommandOutput {\n            exit_code: Some(0),\n            stdout: String::new(),\n            stderr: String::new(),\n        })\n    }\n}\n\nfn git_init_with_commit(root: &Path) {\n    for args in [\n        vec![\"init\", \"-q\"],\n        vec![\"config\", \"user.email\", \"test@example.com\"],\n        vec![\"config\", \"user.name\", \"Test\"],\n    ] {\n        std::process::Command::new(\"git\")\n            .args(&args)\n            .current_dir(root)\n            .output()\n            .expect(\"git command should run\");\n    }\n    fs::write(root.join(\".gitkeep\"), \"\").unwrap();\n    for args in [vec![\"add\", \".\"], vec![\"commit\", \"-q\", \"-m\", \"init\"]] {\n        std::process::Command::new(\"git\")\n            .args(&args)\n            .current_dir(root)\n            .output()\n            .expect(\"git command should run\");\n    }\n}\n\n/// Verifies that plan_version produces correct bumps for all packages in a\n/// cascade chain: pkg-core receives a Major bump from a changeset; pkg-app\n/// depends on pkg-core via ^1.0.0 and should receive a cascade bump.\n///\n/// This test is a correctness guard for the O(N²) → O(N) refactor:\n///   PERF-006: pre-built pkg_map in the plan_version severity loop.\n///   PERF-008: HashSet-based dedup in the pre-release changeset update path.\n#[test]\nfn test_plan_version_produces_correct_bumps_in_cascade() {\n    let tmp = tempfile::tempdir().unwrap();\n    let root = tmp.path();\n    git_init_with_commit(root);\n\n    // pkg-core: the library that receives a breaking-change bump directly.\n    fs::create_dir_all(root.join(\"pkg-core\")).unwrap();\n    fs::write(\n        root.join(\"pkg-core/Cargo.toml\"),\n        \"[package]\\nname = \\\"pkg-core\\\"\\nversion = \\\"1.0.0\\\"\\n\",\n    )\n    .unwrap();\n\n    // pkg-app: depends on pkg-core, will receive a Patch cascade bump after\n    // pkg-core bumps to 2.0.0 (out of range for ^1.0.0).\n    fs::create_dir_all(root.join(\"pkg-app\")).unwrap();\n    fs::write(\n        root.join(\"pkg-app/Cargo.toml\"),\n        \"[package]\\nname = \\\"pkg-app\\\"\\nversion = \\\"1.0.0\\\"\\n\\n[dependencies]\\npkg-core = \\\"1.0.0\\\"\\n\",\n    )\n    .unwrap();\n\n    // Changeset: major bump on pkg-core only.\n    fs::create_dir_all(root.join(\".changeset\")).unwrap();\n    fs::write(\n        root.join(\".changeset/breaking-api.md\"),\n        \"---\\n\\\"pkg-core\\\": major\\n---\\n\\nBreaking API change.\\n\",\n    )\n    .unwrap();\n\n    let locator = IgnoreWalkLocator::new(root);\n    let runner = NoopRunner;\n    let ws = Workspace::load(root.to_path_buf(), &locator, &runner)\n        .expect(\"workspace should load from temp dir\");\n\n    let inference = NoInference;\n    let opts = VersionOptions {\n        strict: false,\n        strict_graph: false,\n        allow_empty_changesets: true,\n    };\n\n    let plan = plan_version(&ws, &inference, &opts).expect(\"plan_version should succeed\");\n\n    let pkg_core = PackageId::parse(\"pkg-core\").unwrap();\n    let pkg_app = PackageId::parse(\"pkg-app\").unwrap();\n\n    let bump_for = |id: &PackageId| plan.bumps.iter().find(|b| &b.package == id);\n\n    let core_bump = bump_for(&pkg_core).expect(\"pkg-core should have a planned bump\");\n    assert_eq!(\n        core_bump.severity,\n        Severity::Major,\n        \"pkg-core should receive a Major bump from the changeset\"\n    );\n\n    let app_bump =\n        bump_for(&pkg_app).expect(\"pkg-app should receive a cascade bump from pkg-core's major\");\n    assert!(\n        app_bump.severity != Severity::None,\n        \"pkg-app cascade bump should be non-None, got {:?}\",\n        app_bump.severity\n    );\n}\n\n/// Two packages in different directories sharing the same name must NOT\n/// silently discard one of them. Before the fix, `ManifestWalkResolver::build`\n/// used `BTreeMap::insert` with the `PackageId` (name-only) as key; the\n/// second crate with the same name silently replaced the first with no error\n/// or diagnostic, making one crate permanently invisible to all operations.\n///\n/// After the fix, `Workspace::load` must return `Err(GraphError::DuplicatePackage)`.","numLines":130,"startLine":1,"totalLines":239}},"sourceToolAssistantUUID":"7af496e3-1a3c-408c-b8cd-6c0df08e10f3","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
