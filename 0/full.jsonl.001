letionResultType]::ParameterValue, 'Apply a temporary, non-persistent version bump for a snapshot release')\n         callisto-cli:test |             [CompletionResult]::new('init', 'init', [CompletionResultType]::ParameterValue, 'Scaffold Callisto configuration in the current workspace')\n         callisto-cli:test |             [CompletionResult]::new('plan-publish', 'plan-publish', [CompletionResultType]::ParameterValue, 'Compute which packages are ready to publish and print the publish plan')\n         callisto-cli:test |             [CompletionResult]::new('publish', 'publish', [CompletionResultType]::ParameterValue, 'Publish ready packages to their ecosystem registries via native CLI tools')\n         callisto-cli:test |             [CompletionResult]::new('compose-pr-body', 'compose-pr-body', [CompletionResultType]::ParameterValue, 'Generate a pull request body summarizing pending release changes')\n         callisto-cli:test |             [CompletionResult]::new('tag', 'tag', [CompletionResultType]::ParameterValue, 'Create git tags for packages in a publish plan')\n         callisto-cli:test |             [CompletionResult]::new('filter-plan', 'filter-plan', [CompletionResultType]::ParameterValue, 'Filter a publish plan down to what a publish report confirms actually succeeded, dropping anything that failed')\n         callisto-cli:test |             [CompletionResult]::new('release', 'release', [CompletionResultType]::ParameterValue, 'Create, inspect, reconcile, or execute durable release intents')\n         callisto-cli:test |             [CompletionResult]::new('completions', 'completions', [CompletionResultType]::ParameterValue, 'Generate shell completion scripts')\n         callisto-cli:test |             [CompletionResult]::new('schema', 'schema', [CompletionResultType]::ParameterValue, 'Print the JSON schema for a report type')\n         callisto-cli:test |             [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Pr