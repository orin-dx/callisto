{"parentUuid":"07a30f88-bfb4-41f6-9214-5a88a883cb03","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Bash","toolUseID":"toolu_01U1cxQLZ3cY7HkVkfnpsAb4","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"ae412d01-e061-4047-918b-0d1df3d4d118\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/callisto\\\",\\\"project\\\":\\\"callisto\\\",\\\"tool_name\\\":\\\"Bash\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":47},"type":"attachment","uuid":"dc4e4c48-f479-4573-93c8-2dfdf468b738","timestamp":"2026-08-18T09:10:43.375Z","session_id":"bb531e8d-c394-4e47-a8ae-e4a9ceeca6d2","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.233","gitBranch":"main","slug":"shimmying-giggling-hickey"}
{"parentUuid":"dc4e4c48-f479-4573-93c8-2dfdf468b738","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/cascade.rs","snippet":"1\tuse std::collections::{BTreeMap, BTreeSet};\n2\tuse std::path::PathBuf;\n3\t\n4\tuse callisto_model::{\n5\t    BumpReason, ConfigKey, Coverage, DepEdge, DepKind, DepSpec, Diagnostic, DiagnosticCode,\n6\t    DiagnosticSeverity, Ecosystem, GrammarMismatch, PackageId, Severity, Version,\n7\t};\n8\t\n9\tuse crate::config::GroupTable;\n10\tuse crate::config::{CascadeConfig, CascadeMode};\n11\tuse crate::error::GraphError;\n12\tuse crate::resolver::DependencyResolver;\n13\tuse crate::tags::TagIndex;\n14\t\n15\t#[derive(Clone, Debug, PartialEq, Eq)]\n16\tpub struct CascadeDecision {\n17\t    pub severity: Severity,\n18\t    pub rewrite: bool,\n19\t    pub governed_by: Option<ConfigKey>,\n20\t    pub escalated: bool,\n21\t    pub unknown_coverage: bool,\n22\t}\n23\t\n24\tpub fn cascade_action(\n25\t    kind: DepKind,\n26\t    coverage: Coverage,\n27\t    source: Severity,\n28\t    cfg: &CascadeConfig,\n29\t) -> CascadeDecision {\n30\t    use Coverage::*;\n31\t    use DepKind::*;\n32\t\n33\t    let effective = match (cfg.mode, coverage) {\n34\t        (CascadeMode::Always, _) => DoesNotCover,\n35\t        (CascadeMode::OutOfRange, Covers) => Covers,\n36\t        (CascadeMode::OutOfRange, DoesNotCover) => DoesNotCover,\n37\t        (CascadeMode::OutOfRange, Unknown) => Covers,\n38\t    };\n39\t\n40\t    let rewrite = matches!(coverage, DoesNotCover);\n41\t\n42\t    let (severity, governed_by, escalated) = match (kind, effective) {\n43\t        (Runtime | Optional | Build, Covers) => (Severity::None, None, false),\n44\t        (Runtime | Optional | Build, DoesNotCover) => (\n45\t            cfg.bump_severity.as_severity(),\n46\t            Some(ConfigKey::CASCADE_BUMP_SEVERITY),\n47\t            false,\n48\t        ),\n49\t        (Peer, Covers) => (Severity::None, None, false),\n50\t        (Peer, DoesNotCover)\n51\t            if cfg.peer_escalation\n52\t                && matches!(coverage, DoesNotCover)\n53\t                && matches!(source, Severity::Minor | Severity::Major) =>\n54\t        {\n55\t            (\n56\t                Severity::Major,\n57\t                Some(ConfigKey::CASCADE_PEER_ESCALATION),\n58\t                true,\n59\t            )\n60\t        }\n61\t        (Peer, DoesNotCover) => (\n62\t            cfg.bump_severity.as_severity(),\n63\t            Some(ConfigKey::CASCADE_BUMP_SEVERITY),\n64\t            false,\n65\t        ),\n66\t        (Dev, _) => (Severity::None, None, false),\n67\t        _ => (Severity::None, None, false),\n68\t    };\n69\t\n70\t    let governed_by = match (cfg.mode, coverage, severity) {\n71\t        (CascadeMode::Always, Covers | Unknown, s) if s != Severity::None => {\n72\t            Some(ConfigKey::CASCADE_MODE)\n73\t        }\n74\t        _ => governed_by,\n75\t    };\n76\t\n77\t    CascadeDecision {\n78\t        severity,\n79\t        rewrite,\n80\t        governed_by,\n81\t        escalated,\n82\t        unknown_coverage: matches!(coverage, Unknown),\n83\t    }\n84\t}\n85\t\n86\tpub fn coverage(spec: &DepSpec, new: &Version) -> Result<Coverage, GrammarMismatch> {\n87\t    match spec {\n88\t        DepSpec::Exact(v) => {\n89\t            if v == new {\n90\t                Ok(Coverage::Covers)\n91\t            } else {\n92\t                Ok(Coverage::DoesNotCover)\n93\t            }\n94\t        }\n95\t        DepSpec::CargoBare(v) => {\n96\t            if caret_covers(v, new)? {\n97\t                Ok(Coverage::Covers)\n98\t            } else {\n99\t                Ok(Coverage::DoesNotCover)\n100\t            }\n101\t        }\n102\t        DepSpec::Range(req, _) => {\n103\t            if req.matches(new)? {\n104\t                Ok(Coverage::Covers)\n105\t            } else {\n106\t                Ok(Coverage::DoesNotCover)\n107\t            }\n108\t        }\n109\t        DepSpec::Workspace(_) => Ok(Coverage::Covers),\n110\t        DepSpec::Catalog(_) | DepSpec::Opaque(_) => Ok(Coverage::Unknown),\n111\t    }\n112\t}\n113\t\n114\tpub(crate) fn caret_covers(cur: &Version, new: &Version) -> Result<bool, GrammarMismatch> {\n115\t    let cmp = Version::compare(new, cur)?;\n116\t    if cmp.is_lt() {\n117\t        return Ok(false);\n118\t    }\n119\t    // Pre-release versions are never covered by a caret range: ^1.2.3 must not\n120\t    // satisfy 1.9.0-alpha.1 even though 1.9.0-alpha.1 > 1.2.3 and they share\n121\t    // the same major. Caret ranges cover stable releases within the allowed\n122\t    // major/minor bounds only; a pre-release of an in-range stable version is\n123\t    // not itself a stable release and must not be treated as covered.\n124\t    if new.is_prerelease() {\n125\t        return Ok(false);\n126\t    }\n127\t    let cur_maj = cur.major().unwrap_or(0);\n128\t    let cur_min = cur.minor().unwrap_or(0);\n129\t    let new_maj = new.major().unwrap_or(0);\n130\t    let new_min = new.minor().unwrap_or(0);\n131\t\n132\t    if cur_maj > 0 {\n133\t        Ok(new_maj == cur_maj)\n134\t    } else if cur_min > 0 {\n135\t        Ok(new_maj == 0 && new_min == cur_min)\n136\t    } else {\n137\t        Ok(new == cur)\n138\t    }\n139\t}\n140\t\n141\tpub struct CascadeInput<'a, D: DependencyResolver> {\n142\t    pub graph: &'a D,\n143\t    pub groups: &'a GroupTable,\n144\t    pub cfg: &'a CascadeConfig,\n145\t    pub seed: &'a BTreeMap<PackageId, Severity>,\n146\t    pub reasons: &'a BTreeMap<PackageId, BumpReason>,\n147\t    pub named_by: &'a BTreeMap<PackageId, crate::aggregate::NamedBy>,\n148\t    pub base: &'a BTreeMap<PackageId, Version>,\n149\t    pub pre: Option<&'a callisto_format::PreState>,\n150\t    pub tags: &'a TagIndex,\n151\t}\n152\t\n153\t#[derive(Clone, Debug, Default)]\n154\tpub struct CascadeOutcome {\n155\t    pub severities: BTreeMap<PackageId, Severity>,\n156\t    pub targets: BTreeMap<PackageId, Version>,\n157\t    pub reasons: BTreeMap<PackageId, BumpReason>,\n158\t    pub governed_by: BTreeMap<PackageId, ConfigKey>,\n159\t    pub rewrites: BTreeMap<RewriteKey, SpecRewrite>,\n160\t    pub diagnostics: Vec<Diagnostic>,\n161\t    pub iterations: usize,\n162\t}\n163\t\n164\t/// Trait mirror of [`solve_cascade`]'s signature — no implementation exists in this crate\n165\t/// today (the free function is called directly by every current caller); kept as a seam for\n166\t/// a future test double the same way [`DependencyResolver`] is, rather than a live extension\n167\t/// point.\n168\tpub trait CascadeSolver<D: DependencyResolver> {\n169\t    fn solve_cascade(&self, input: CascadeInput<'_, D>) -> Result<CascadeOutcome, GraphError>;\n170\t}\n171\t\n172\tpub fn run_cascade<D: DependencyResolver>(\n173\t    input: CascadeInput<'_, D>,\n174\t) -> Result<CascadeOutcome, GraphError> {\n175\t    solve_cascade(input)\n176\t}\n177\t\n178\t/// Propagates `input.seed`'s severities outward to dependents until no target version\n179\t/// changes, or `convergence_bound`'s iteration cap is exceeded\n180\t/// ([`GraphError::CascadeNotConverged`]) — the safety bound that turns a would-be infinite\n181\t/// loop into a reportable bug rather than a hang, derived from the package count rather than\n182\t/// hand-tuned.\n183\t///\n184\t/// One pass: pop a package off the worklist, compute its bumped target version, then walk\n185\t/// every dependent edge and apply [`cascade_action`] to decide whether that dependent's own\n186\t/// severity/target needs to change and gets re-queued. A genuine cross-grammar coverage\n187\t/// failure (`coverage`'s `Err`, e.g. comparing a SemVer target against a PEP440 spec) does\n188\t/// abort the whole cascade with `Err(GraphError::GrammarMismatch)` — this function does not\n189\t/// swallow that. What *is* soft: a `DepSpec::Catalog`/`DepSpec::Opaque` entry never has its\n190\t/// coverage tested at all (`coverage` returns `Coverage::Unknown` unconditionally for both),\n191\t/// so it can't block anything either way — a `Catalog` entry is reported as\n192\t/// [`DiagnosticCode::CatalogSpecNotRewritten`], an `Opaque` one gets no diagnostic at all.\n193\t/// [`DiagnosticCode::RangeNotRoundTrippable`]'s own dominant real-world trigger is a\n194\t/// different step entirely — [`rewrite_spec`], below, when a mechanical range rewrite (not a\n195\t/// coverage test) fails on an otherwise-known-coverage spec.\n196\tpub fn solve_cascade<D: DependencyResolver>(\n197\t    input: CascadeInput<'_, D>,\n198\t) -> Result<CascadeOutcome, GraphError> {\n199\t    let mut out = CascadeOutcome {\n200\t        severities: input.seed.clone(),\n201\t        reasons: input.reasons.clone(),\n202\t        ..Default::default()\n203\t    };\n204\t\n\n... [1348 lines truncated] ..."},"type":"attachment","uuid":"2c15902a-cc66-4317-aa76-0550e714c67d","timestamp":"2026-08-18T09:10:43.692Z","session_id":"bb531e8d-c394-4e47-a8ae-e4a9ceeca6d2","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.233","gitBranch":"main","slug":"shimmying-giggling-hickey"}
