esultType]::ParameterName, 'Print help')\n         callisto-cli:test |             [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;plan-publish' {\n         callisto-cli:test |             [CompletionResult]::new('--package', '--package', [CompletionResultType]::ParameterName, 'Plan only the named package(s). Repeatable: `--package foo --package bar`')\n         callisto-cli:test |             [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format for command results')\n         callisto-cli:test |             [CompletionResult]::new('--cwd', '--cwd', [CompletionResultType]::ParameterName, 'Workspace directory to operate in (defaults to the current directory)')\n         callisto-cli:test |             [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Preview manifest and file changes without writing to disk')\n         callisto-cli:test |             [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;publish' {\n         callisto-cli:test |             [CompletionResult]::new('--package', '--package', [CompletionResultType]::ParameterName, 'Publish only the named package(s). Repeatable: `--package foo --package bar`. When omitted, all packages in the plan are published')\n         callisto-cli:test |             [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format for command results')\n         callisto-cli:test |             [CompletionResult]::new('--cwd', '--cwd', [CompletionResultType]::ParameterName, 'Workspace directory to operate in (defaults to the current directory)')\n         callisto-cli:test |             [CompletionResult]::new('--skip-publish-precheck', '--skip-publish-precheck', [CompletionResultType]::ParameterName, 'Skip the pre-publish \"already published?\" registry check and publish directly, relying on the registry''s own already-published response. Saves one round-trip per package, at the cost of re-running local publish lifecycle scripts (e.g. npm''s prepublishOnly) on a retried publish of an already-published version')\n         callisto-cli:test |             [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Preview manifest and file changes without writing to disk')\n         callisto-cli:test |             [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')\n         callisto-cli:test |             break\n         callisto-cli:test |         }\n         callisto-cli:test |         'callisto;compose-pr-body' {\n         callisto-cli:test |             [CompletionResult]::new('--existing-body', '--existing-body', [CompletionResultType]::ParameterName, 'Existing PR body text to merge with, or `-` to read it from stdin')\n         callisto-cli:test |             [CompletionResult]::new('--label', '--label', [CompletionResultType]::ParameterName, 'Label to attach to the PR body; repeatable')\n         callisto-cli:test |             [CompletionResult]::new('--branch', '--branch', [CompletionResultType]::ParameterName, 'Branch name to reference in the generated PR body')\n         callisto-cli:test |             [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format for command results')\n         callisto-cli:test |       