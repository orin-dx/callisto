sto -o bashdefault -o default callisto\n         callisto-cli:test | fi\n         callisto-cli:test | test commands::publish::tests::credential_check_warns_when_npm_token_missing ... ok\n         callisto-cli:test | test commands::publish::tests::credential_check_warns_when_pypi_password_missing ... ok\n         callisto-cli:test | test commands::completions::tests::handle_generates_the_binary_name_into_the_completion_script ... ok\n         callisto-cli:test | test commands::publish::tests::dry_run_empty_plan_message_is_present_tense ... ok\n         callisto-cli:test | test commands::publish::tests::dry_run_text_contains_dry_run_for_empty_plan ... ok\n         callisto-cli:test | test commands::publish::tests::dry_run_release_only_plan_is_not_empty ... ok\n         callisto-cli:test | test commands::publish::tests::plan_publish_json_includes_command_discriminator ... ok\n         callisto-cli:test | test commands::schema::tests::handle_rejects_unknown_target_type ... ok\n         callisto-cli:test | test commands::status::tests::check_exit_code_returns_2_when_no_changesets_pending ... ok\n         callisto-cli:test | test commands::status::tests::check_exit_code_returns_failure_when_changesets_pending ... ok\n         callisto-cli:test | \n         callisto-cli:test | use builtin;\n         callisto-cli:test | use str;\n         callisto-cli:test | \n         callisto-cli:test | set edit:completion:arg-completer[callisto] = {|@words|\n         callisto-cli:test |     fn spaces {|n|\n         callisto-cli:test |         builtin:repeat $n ' ' | str:join ''\n         callisto-cli:test |     }\n         callisto-cli:test |     fn cand {|text desc|\n         callisto-cli:test |         edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc\n         callisto-cli:test |     }\n         callisto-cli:test |     var command = 'callisto'\n         callisto-cli:test |     for word $words[1..-1] {\n         callisto-cli:test |         if (str:has-