{"parentUuid":"bf8f65f2-c7c8-49d3-98c0-55c35e634a0b","isSidechain":false,"promptId":"c6047eec-fc98-44af-b8bd-425109521d56","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GPXtTezuyNeNtQ8dAsqUqE","type":"tool_result","content":"        program: &str,\n        args: &[&str],\n        cwd: &std::path::Path,\n    ) -> Result<callisto_model::CommandOutput, callisto_model::CommandError> {\n        self.programs.lock().unwrap().push(program.to_owned());\n        callisto_cli::runner::CliCommandRunner.run(program, args, cwd)\n    }\n}\n\n/// `version --emit-preview` records the publishable packages whose source changed and that the plan leaves out, and the\n/// body leads with them; the package the changeset bumps is not among them.\n#[test]\nfn the_preview_lists_a_publishable_package_the_plan_leaves_out() {\n    let dir = setup_polyglot_git_repo();\n    let global = GlobalArgs {\n        format: OutputFormat::Json,\n        cwd: dir.path().to_path_buf(),\n        dry_run: false,\n    };\n    init_repo(&global);\n    commands::add::handle(\n        AddArgs {\n            packages: vec![\"cargo/core-crate:minor\".to_string()],\n            summary: Some(\"Retry uploads.\\n\\nAction: re-run the installer.\".to_string()),\n        },\n        &global,\n    )\n    .unwrap();\n\n    commands::version::handle(version_args(Some(\"preview.json\".into())), &global).unwrap();\n\n    let preview = callisto_graph::release_preview::ReleasePreview::from_json(\n        &std::fs::read_to_string(dir.path().join(\"preview.json\")).unwrap(),\n    )\n    .unwrap();\n    let names: Vec<&str> = preview\n        .unreleased\n        .iter()\n        .map(|change| change.package.as_str())\n        .collect();\n    assert!(names.contains(&\"@myorg/web-app\"), \"{names:?}\");\n    assert!(!names.contains(&\"core-crate\"), \"{names:?}\");\n\n    let body = callisto_graph::commands::render_pr_body_from_preview(&preview, &PrBodyOptions::default()).body;\n    assert!(body.contains(\"**Read before merging**\"), \"{body}\");\n    assert!(\n        body.contains(\"**Action required** (`core-crate`): re-run the installer.\"),\n        \"{body}\"\n    );\n    assert!(body.contains(\"**Changed, not releasing** (`@myorg/web-app`\"), \"{body}\");\n}","is_error":false}]},"uuid":"17bcbaff-dce5-40e5-a67a-85cdf63a53b6","timestamp":"2026-11-09T21:04:55.849Z","toolUseResult":{"stdout":"        program: &str,\n        args: &[&str],\n        cwd: &std::path::Path,\n    ) -> Result<callisto_model::CommandOutput, callisto_model::CommandError> {\n        self.programs.lock().unwrap().push(program.to_owned());\n        callisto_cli::runner::CliCommandRunner.run(program, args, cwd)\n    }\n}\n\n/// `version --emit-preview` records the publishable packages whose source changed and that the plan leaves out, and the\n/// body leads with them; the package the changeset bumps is not among them.\n#[test]\nfn the_preview_lists_a_publishable_package_the_plan_leaves_out() {\n    let dir = setup_polyglot_git_repo();\n    let global = GlobalArgs {\n        format: OutputFormat::Json,\n        cwd: dir.path().to_path_buf(),\n        dry_run: false,\n    };\n    init_repo(&global);\n    commands::add::handle(\n        AddArgs {\n            packages: vec![\"cargo/core-crate:minor\".to_string()],\n            summary: Some(\"Retry uploads.\\n\\nAction: re-run the installer.\".to_string()),\n        },\n        &global,\n    )\n    .unwrap();\n\n    commands::version::handle(version_args(Some(\"preview.json\".into())), &global).unwrap();\n\n    let preview = callisto_graph::release_preview::ReleasePreview::from_json(\n        &std::fs::read_to_string(dir.path().join(\"preview.json\")).unwrap(),\n    )\n    .unwrap();\n    let names: Vec<&str> = preview\n        .unreleased\n        .iter()\n        .map(|change| change.package.as_str())\n        .collect();\n    assert!(names.contains(&\"@myorg/web-app\"), \"{names:?}\");\n    assert!(!names.contains(&\"core-crate\"), \"{names:?}\");\n\n    let body = callisto_graph::commands::render_pr_body_from_preview(&preview, &PrBodyOptions::default()).body;\n    assert!(body.contains(\"**Read before merging**\"), \"{body}\");\n    assert!(\n        body.contains(\"**Action required** (`core-crate`): re-run the installer.\"),\n        \"{body}\"\n    );\n    assert!(body.contains(\"**Changed, not releasing** (`@myorg/web-app`\"), \"{body}\");\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"dangerouslyDisableSandbox":true},"serverClassifierContext":{"request":"cc6f95e3-8fb0-43ea-960b-fdf8505a9b0a","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/unreleased-needs-tag","root":"/Users/gabe/Projects/callisto/.claude/worktrees/unreleased-needs-tag","branch":"fix/unreleased-needs-a-tag","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callisto","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/unreleased-needs-tag","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"bf8f65f2-c7c8-49d3-98c0-55c35e634a0b","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/unreleased-needs-tag","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/unreleased-needs-a-tag","slug":"mossy-snacking-stream"}
