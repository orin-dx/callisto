{"parentUuid":"4b3b7917-2961-4370-ba80-37ac9869c26f","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Bash","toolUseID":"toolu_016mcDwihSw5Tcf65iUi1ggf","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"ae412d01-e061-4047-918b-0d1df3d4d118\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/callisto\\\",\\\"project\\\":\\\"callisto\\\",\\\"tool_name\\\":\\\"Bash\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":47},"type":"attachment","uuid":"29be8c9c-f990-4b6a-aa8c-3a874f913c28","timestamp":"2026-08-19T16:30:37.774Z","session_id":"bb531e8d-c394-4e47-a8ae-e4a9ceeca6d2","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.233","gitBranch":"main","slug":"shimmying-giggling-hickey"}
