      cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;help'= {\n         callisto-cli:test |             cand plan 'Create a read-only durable release intent from exact package selections'\n         callisto-cli:test |             cand inspect 'Display a durable intent, manifest, state, or receipt without recomputing it'\n         callisto-cli:test |             cand reconcile 'Report which pending operations are eligible without changing release state'\n         callisto-cli:test |             cand execute 'Execute a previously approved intent. This is the only durable mutation route'\n         callisto-cli:test |             cand help 'Print this message or the help of the given subcommand(s)'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;help;plan'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;help;inspect'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;help;reconcile'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;help;execute'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;help;help'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;completions'= {\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;schema'= {\n         callisto-cli:test |             cand --type 'Report type to print the schema for (status, version, snapshot, validate, tag, init, plan-publish, changeset, pre, matrix); defaults to status'\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help'= {\n         callisto-cli:test |             cand add 'Create a new changeset describing pending package changes'\n         callisto-cli:test |             cand status 'Show the workspace''s pending changesets and diagnostics'\n         callisto-cli:test |             cand matrix 'Print the workspace''s native-build target matrix as JSON or a table'\n         callisto-cli:test |             cand version 'Consume pending changesets and bump package versions accordingly'\n         callisto-cli:test |             cand pre 'Manage prerelease mode for the workspace'\n         callisto-cli:test |             cand validate 'Check that changesets and the dependency graph are well-formed'\n         callisto-cli:test |             cand snapshot 'Apply a temporary, non-persistent version bump for a snapshot release'\n         callisto-cli:test |             cand init 'Scaffold Callisto configuration in the current workspace'\n         callisto-cli:test |             cand plan-publish 'Compute which packages are ready to publish and print the publish plan'\n         callisto-cli:test |             cand publish 'Publish ready packages to their ecosystem registries via native CLI tools'\n         callisto-cli:test |             cand compose-pr-body 'Generate a pull request body summarizing pending release changes'\n         callisto-cli:test |             cand tag 'Create git tags for packages in a publish plan'\n         callisto-cli:test |             cand filter-plan 'Filter a publish plan down to what a publish report confirms actually succeeded, dropping anything that failed'\n         callisto-cli:test |             cand release 'Create, inspect, reconcile, or execute durable release intents'\n         callisto-cli:test |             cand completions 'Generate shell completion scripts'\n         callisto-cli:test |             cand schema 'Print the JSON schema for a report type'\n         callisto-cli:test |             cand help 'Print this message or the help of the given subcommand(s)'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;add'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;status'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;matrix'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;version'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;pre'= {\n         callisto-cli:test |             cand enter 'Enter prerelease mode, tagging subsequent version bumps with the given prerelease tag'\n         callisto-cli:test |             cand exit 'Exit prerelease mode, returning to normal versioning'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;pre;enter'= {\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;help;pre;exit'= {\n         callisto-cli:test |         }\n       