e for fixed or linked package groups.\n    GroupName\n}\n\n/// Group kind: Fixed vs Linked.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]\n#[serde(rename_all = \"lowercase\")]\npub enum GroupKind {\n    Fixed,\n    Linked,\n}\n\nstring_newtype! {\n    /// Registry key string e.g. \"cratesIo\", \"npm\".\n    RegistryKey\n}\n\nimpl RegistryKey {\n    /// Well-known registry key for crates.io.\n    pub const CRATES_IO: \u0026'static str = \"cratesIo\";\n    /// Well-known registry key for the npm registry.\n    pub const NPM: \u0026'static str = \"npm\";\n    /// Well-known registry key for PyPI.\n    pub const PYPI: \u0026'static str = \"pypi\";\n    /// Well-known registry key for NuGet.\n    pub const NUGET: \u0026'static str = \"nuget\";\n}\n\n/// A 40-character hex Git commit SHA.\n#[derive(Clone, Debug, PartialEq, Eq, Hash, PartialOrd, Ord, JsonSchema)]\n#[schemars(with = \"String\")]\npub struct CommitSha(String);\n\nimpl AsRef\u003cstr\u003e for CommitSha {\n    fn as_ref(\u0026self) -\u003e \u0026str {\n        \u0026self.0\n    }\n}\n\nimpl CommitSha {\n    /// Parses a 40-character hexadecimal Git commit SHA, trimming surrounding whitespace.\n    ///\n    /// # Errors\n    ///\n    /// Ret\u003ctruncated omitted_approx_tokens=\"382\" /\u003e   \"demo-1.2.3-cp312-cp312-macosx_11_0_arm64.whl\",\n                ),\n                (\n                    RegistryArtifactFormat::PythonWheel,\n                    \"demo-1.2.3-cp312-cp312-manylinux_2_28_x86_64.whl\",\n                ),\n                (RegistryArtifactFormat::PythonSdist, \"demo-1.2.3.tar.gz\"),\n            ]\n        );\n    }\n\n    #[test]\n    fn registry_credential_environment_policy_is_closed_and_key_derived() {\n        assert_eq!(\n            prepared_credential_policy(Ecosystem::Cargo, \u0026RegistryKey(\"crates-io\".to_string())).unwrap(),\n            PreparedCredentialEnvPolicy::CargoToken {\n                env_name: \"CARGO_REGISTRY_TOKEN\".to_string()\n            }\n        );\n        assert_eq!(\n            prepared_credential_policy(Ecosystem::Cargo, \u0026RegistryKey(\"rehearsal-cargo\".to_string())).unwrap(),\n            PreparedCredentialEnvPolicy::CargoToken {\n                env_name: \"CARGO_REGISTRIES_REHEARSAL_CARGO_TOKEN\".to_string()\n            }\n        );\n        assert_eq!(\n            prepared_credential_policy(Ecosystem::Npm, \u0026RegistryKey(\"rehearsal-npm\".to_string())).unwrap(),\n            PreparedCredentialEnvPolicy::NpmToken { env_name: \"NPM_TOKEN\" }\n        );\n        assert_eq!(\n            prepared_credential_policy(Ecosystem::Pypi, \u0026RegistryKey(\"rehearsal-pypi\".to_string())).unwrap(),\n            PreparedCredentialEnvPolicy::PypiToken {\n                password_env_name: \"TWINE_PASSWORD\",\n                username: \"__token__\"\n            }\n        );\n    }\n\n    #[test]\n    fn git_remote_binding_normalizes_credential_free_ssh_and_rejects_credentialed_https() {\n        let ssh = canonical_git_remote(\"git@GitHub.com:example/release-fixture.git\").unwrap();\n        assert_eq!(ssh.endpoint, \"ssh://git@github.com/example/release-fixture.git\");\n        assert_eq!(ssh.github_repository.as_slug(), \"example/release-fixture\");\n        let mixed_case_ssh = canonical_git_remote(\"git@GitHub.com:Example/Release-Fixture.git\").unwrap();\n\n","type":"input_text"},{"text":"\n[90] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/commands/release.rs\\n@@\\n         assert_eq!(\\n-            prepared_credential_policy(Ecosystem::Cargo, \u0026RegistryKey(\\\"crates-io\\\".to_string())).unwrap(),\\n+            prepared_credential_policy(Ecosystem::Cargo, \u0026RegistryKey(RegistryKey::CRATES_IO.to_string())).unwrap(),\\n             PreparedCredentialEnvPolicy::CargoToken {\\n                 env_name: \\\"CARGO_REGISTRY_TOKEN\\\".to_string()\\n             }\\n       