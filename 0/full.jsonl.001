     return OperationObservation::Conflict(ExternalConflict::RegistryLength {\n                slot,\n                observed: observed.byte_length,\n            });\n        }\n        if \u0026observed.digest != expected_digest {\n            return Operat\u003ctruncated omitted_approx_tokens=\"4470\" /\u003e      path.extend(segments.iter().copied());\n    }\n    Some(url.to_string())\n}\n\nfn malformed(provider: ObservationProvider) -\u003e OperationObservation {\n    OperationObservation::Unverifiable(ObservationFailure::MalformedResponse { provider })\n}\n\n#[cfg(test)]\nmod tests {\n    use std::{\n        collections::VecDeque,\n        path::Path,\n        sync::{Arc, Mutex},\n    };\n\n    use callisto_model::{CommandError, CommandRunner};\n\n    use super::*;\n\n    #[derive(Clone, Default)]\n    struct RecordingRunner {\n        calls: Arc\u003cMutex\u003cVec\u003c(String, Vec\u003cString\u003e)\u003e\u003e\u003e,\n        outputs: Arc\u003cMutex\u003cVecDeque\u003cResult\u003cCommandOutput, CommandError\u003e\u003e\u003e\u003e,\n    }\n\n    impl CommandRunner for RecordingRunner {\n        fn run(\u0026self, program: \u0026str, args: \u0026[\u0026str], _cwd: \u0026Path) -\u003e Result\u003cCommandOutput, CommandError\u003e {\n            self.calls.lock().unwrap().push((\n                program.to_string(),\n                args.iter().map(|value| value.to_string()).collect(),\n            ));\n            self.outputs.lock().unwrap().pop_front().unwrap()\n        }\n    }\n\n    fn output(exit_code: i32, stdout: \u0026str, stderr: \u0026str) -\u003e Result\u003cCommandOutput, CommandError\u003e {\n        Ok(CommandOutput {\n            exit_code: Some(exit_code),\n            stdout: stdout.to_string(),\n            stderr: stderr.to_string(),\n        })\n    }\n\n    #[test]\n    fn github_parser_accepts_real_nonzero_404_response_without_accepting_bare_error_text() {\n        let response = CommandOutput {\n            exit_code: Some(1),\n            stdout: \"HTTP/2 404 Not Found\\r\\ncontent-type: application/json\\r\\n\\r\\n{\\\"message\\\":\\\"Not Found\\\"}\".into(),\n            stderr: \"gh: Not Found (HTTP 404)\".into(),\n        };\n        assert_eq!(parse_http_response(\u0026response).map(|(status, _)| status), Some(404));\n        let bare = CommandOutput {\n            exit_code: Some(1),\n            stdout: String::new(),\n            stderr: \"gh: Not Found (HTTP 404)\".into(),\n        };\n        assert_eq!(parse_http_response(\u0026bare), None);\n\n","type":"input_text"},{"text":"\n[81] tool send_message call: {\"target\":\"/root\",\"message\":\"REDACTED\"}\n","type":"input_text"},{"text":"\n[82] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"cargo_publish_argv|npm_publish_argv|pypi_publish_argv|detect_npm_package_manager|run_argv|dispatch_registry|npm_version_is_published|cargo_version_is_published|poll_until_published\\\" crates/callisto-graph/src crates/callisto-graph/tests crates/callisto-cli/src\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":16000}); text(r.output);\n\n","type":"input_text"},{"text":"\n[83] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\n48 matches in 2 files:\n\ncrates/.../commands/registry_argv.rs:55:/// the durable release executor's own `dispatch_registry` had silently\ncrates/.../commands/registry_argv.rs:59:pub fn cargo_publish_argv(\ncrates/.../commands/registry_argv.rs:154:/// [`npm_publish_argv`].\ncrates/.../commands/registry_argv.rs:167:/// executor's `dispatch_registry` used to hardcode plain `npm publish`\ncrates/.../commands/registry_argv.rs:170:pub fn detect_npm_package_manager(workspace_root: \u0026Path) -\u003e NpmPackageManager {\ncrates/.../commands/registry_argv.rs:185:/// already-detected `package_manager` (see [`detect_npm_package_manager`]).\ncrates/.../commands/registry_argv.rs:198:pub fn npm_publish_argv(\ncrates/.../commands/registry_a