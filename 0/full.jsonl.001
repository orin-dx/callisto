(tempfile::TempDir, RealGitRunner) {\n1523:\"[package]\\nname = \\\"release-fixture\\\"\\nversion = \\\"1.2.2\\\"\\nedition = \\\"2021...\n1529:\"---\\nrelease-fixture: patch\\n---\\n\\nRelease fixture.\\n\",\n1535:\"[[package]]\\nmatch = \\\"release-fixture\\\"\\nchangelog = \\\"CHANGELOG.md\\\"\\npubl...\n1548:\"https://github.com/example/release-fixture.git\",\n1563:\"[package]\\nname = \\\"release-fixture\\\"\\nversion = \\\"1.2.3\\\"\\nedition = \\\"2021...\n1568:\"# Changelog\\n\\n## 1.2.3\\n\\nRelease fixture.\\n\\n## 1.2.2\\n\",\n  +33 more in crates/callisto-graph/src/commands/release.rs\n\n","type":"input_text"},{"text":"\n[71] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '1,300p' crates/callisto-graph/src/commands/release_artifacts.rs \u0026\u0026 rtk sed -n '1450,2100p' crates/callisto-graph/src/commands/release.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":50000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[72] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\n//! Artifact-byte and GitHub-attestation verification for durable releases.\n//!\n//! A manifest is only a claim. This module verifies the actual on-disk bytes\n//! and asks GitHub to validate the signing certificate against the policy\n//! embedded in the immutable release intent before an executor can upload an\n//! asset. It intentionally owns no upload side effect.\n\nuse std::{\n    collections::BTreeMap,\n    fs::{self, File},\n    path::{Component, Path, PathBuf},\n    time::Duration,\n};\n\nuse callisto_model::{ArtifactDigest, CommandRunner, ProvenancePolicy, ReleaseArtifactManifest, ReleaseArtifactSlot};\n\nuse crate::GraphError;\n\nuse super::release::ValidatedReleaseIntent;\n\nconst ATTESTATION_TIMEOUT: Duration = Duration::from_secs(120);\n\n#[derive(Debug)]\nstruct ValidatedArtifactEntry {\n    path: PathBuf,\n    digest: ArtifactDigest,\n    byte_length: u64,\n}\n\n/// Intent-bound capability proving that the complete manifest, every local\n/// byte sequence, and every required GitHub attestation were verified.\n///\n/// The raw manifest is deliberately not exposed. Provider dispatch receives\n/// bytes only through [`Self::snapshot`], which repeats path containment and\n/// byte identity checks immediately before the caller can submit them.\n#[derive(Debug)]\n#[allow(dead_code)] // the intent/manifest bindings become dispatch inputs in T3-DISPATCH\npub(super) struct ValidatedArtifactManifest\u003c'intent, 'runner\u003e {\n    validated_intent: \u0026'intent ValidatedReleaseIntent\u003c'runner\u003e,\n    manifest: ReleaseArtifactManifest,\n    artifact_root: PathBuf,\n    entries: BTreeMap\u003cReleaseArtifactSlot, ValidatedArtifactEntry\u003e,\n}\n\n#[derive(Debug)]\n#[allow(dead_code)] // consumed by exact-byte provider dispatch in T3-DISPATCH\npub(super) struct ArtifactSnapshot {\n    slot: ReleaseArtifactSlot,\n    bytes: Vec\u003cu8\u003e,\n}\n\nimpl ArtifactSnapshot {\n    #[allow(dead_code)] // consumed by exact-byte provider dispatch in T3-DISPATCH\n    pub(super) fn slot\u003ctruncated omitted_approx_tokens=\"8309\" /\u003e         ReleaseOperationId::ForgePublish { .. } =\u003e 4,\n            };\n            counts[index] += 1;\n            counts\n        });\n        assert_eq!(counts, [1, 1, 1, 6, 1]);\n        assert_eq!(inputs.operations.len(), intent.operations().len());\n        assert_eq!(\n            intent\n                .slots()\n                .iter()\n                .filter_map(ReleaseArtifactSlot::product_target)\n                .collect::\u003cBTreeSet\u003c_\u003e\u003e(),\n            ProductTarget::ALL.into_iter().collect()\n        );\n        assert_eq!(intent.product_release().tag(), \"release-fixture@1.2.3\");\n\n        let tag = inputs\n            .operations\n            .values()\n            .find_map(|operation| match operation {\n                PreparedOperation::ProductTag {\n                    name,\n                    target,\n                    annotation,\n                    ..\n                } =\u003e Some((name, target, annotation)),\n                _ =\u003e None,\n            })\n            .expect(\"the tag operation must retain its render, target, and annotation policy\");\n        assert_eq!(tag.0.as_str(), \"release-fixture@1.2.3\");\n        assert_eq!(tag.2, \"Release release-fixture@1.2.3\");\n        assert_eq!(tag.1.as_str().len(), 40);\n\n        let registry = inputs\n            .operations\n            .values()\n            .find_map(|operation| match operation {\n                PreparedOperation::RegistryArtifactPublish { artifact, registry, .. } =\u003e Some((artifact, registry)),\n                _ =\u003e None,\n            })\n            .expect(\"the publish operation must retain its exact routing input\");\n        assert_eq!(registry.0.package().name(), \"release-fixture\");\n        assert_eq!(registry.0.file_name(), \"release-fixture-1.2.3.crate\");\n        assert_eq!(registry.1.key.as_str(), \"cargo\");\n        assert!(matches!(registry.1.endpoints, PreparedRegistryEndpoints::Cargo { .. }));\n    }\n\n    #[test]\n    fn comments_in_callisto_toml_do_not_change_semantic_release_inputs() {\n\n","type":"input_text"},{"text":"\n[73] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"struct .*Runner|impl CommandRunner|verify_artifact_manifest|complete_with_generated_files|write_artifact\\\" crates/callisto-graph/src/commands/release_observation.rs | tail -100\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":18000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[74] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\n1078:    struct RecordingRunner {\n1083:    impl CommandRunner for RecordingRunner {\n1124:    struct CapabilityRunner {\n1183:    impl CommandRunner for CapabilityRunner {\n1442:   