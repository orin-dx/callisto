 without writing to disk'\n            cand -h 'Print help'\n            cand --help 'Print help'\n            cand plan 'Create a read-only durable release intent from exact package selections'\n            cand inspect 'Display a durable intent, manifest, state, or receipt without recomputing it'\n            cand reconcile 'Report which pending operations are eligible without changing release state'\n            cand execute 'Execute a previously approved intent. This is the only durable mutation route'\n            cand help 'Print this message or the help of the given subcommand(s)'\n        }\n        &'callisto;release;plan'= {\n            cand --package 'Exact qualified package identity, for example `cargo/callisto-cli`. Repeat this flag to select multiple packages. This local/manual mode cannot be combined with --from-release-commit'\n            cand --from-release-commit 'Exact merged release-PR commit checked out in this workspace. CI derives the roster from its versioned manifest delta and never reruns changeset planning'\n            cand --out 'Explicit path where the immutable intent JSON will be atomically written'\n            cand --format 'Output format for command results'\n            cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n            cand --dry-run 'Preview manifest and file changes without writing to disk'\n            cand -h 'Print help'\n            cand --help 'Print help'\n        }\n        &'callisto;release;inspect'= {\n            cand --input 'Explicit path to an intent, artifact manifest, state, or receipt JSON document'\n            cand --format 'Output format for command results'\n            cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n            cand --dry-run 'Preview manifest and file changes without writing to disk'\n            cand -h 'Print help'\n            cand --help 'Print help'\n        }\n        &'callisto;release;reconcile'= {\n            cand --intent 'Explicit path to the durable release intent JSON document'\n            cand --state 'Explicit state path. If omitted, reconciliation reports the initialized state'\n            cand --format 'Output format for command results'\n            cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n            cand --dry-run 'Preview manifest and file changes without writing to disk'\n            cand -h 'Print help'\n            cand --help 'Print help'\n        }\n        &'callisto;release;execute'= {\n            cand --intent 'Explicit path to the durable release intent JSON document'\n            cand --artifact-manifest 'Explicit artifact manifest path required when the intent declares binary slots'\n            cand --artifact-dir 'Directory containing the exact regular artifact files named by the manifest. Required with --artifact-manifest; it is never inferred from the checkout'\n            cand --state 'Explicit durable state path. If omitted, state is stored outside the checkout'\n            cand --format 'Output format for command results'\n            cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n            cand --dry-run 'Preview manifest and file changes without writing to disk'\n            cand -h 'Print help'\n            cand --help 'Print help'\n        }\n        &'callisto;release;help'= {\n            cand plan 'Create a read-only durable release intent from exact package selections'\n            cand inspect 'Display a durable intent, manifest, state, or receipt without recomputing it'\n            cand reconcile 'Report which pending operations are eligible without changing release state'\n            cand execute 'Execute a previously approved intent. This is the only durable mutation route'\n            cand help 'Print this message or the help of the given subcommand(s)'\n        }\n        &'callisto;release;help;plan'= {\n        }\n        &'callisto;release;help;inspect'= {\n        }\n        &'callisto;release;help;reconcile'= {\n        }\n        &'callisto;release;help;execute'= {\n        }\n        &'callisto;release;help;help'= {\n        }\n        &'callisto;completions'= {\n            cand --format 'Output format for command results'\n            cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n            cand --dry-run 'Preview manifest and file changes without writing to disk'\n            cand -h 'Print help'\n            cand --help 'Print help'\n        }\n        &'callisto;schema'= {\n            cand --type 'Report type to print the schema for (status, version, snapshot, validate, tag, init, plan-publish, changeset, pre, matrix); defaults to status'\n            cand --format 'Output format for command results'\n            cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n            cand --dry-run 'Preview manifest and file changes without writing to disk'\n            cand -h 'Print help'\n            cand --help 'Print help'\n        }\n        &'callisto;help'= {\n            cand add 'Create a new changeset describing pending package changes'\n            cand status 'Show the workspace''s pending changesets and diagnostics'\n            cand matrix 'Print the workspace''s native-build target matrix as JSON or a table'\n            cand version 'Consume pending changesets and bump package versions accordingly'\n            cand pre 'Manage prerelease mode for the workspace'\n            cand validate 'Check that changesets and the dependency graph are well-formed'\n            cand snapshot 'Apply a temporary, non-persistent version bump for a snapshot release'\n            cand init 'Scaffold Callisto configuration in the current workspace'\n            cand plan-publish 'Compute which packages are ready to publish and print the publish plan'\n            cand publish 'Publish ready packages to their ecosystem registries via native CLI tools'\n            cand compose-pr-body 'Generate a pull request body summarizing pending release changes'\n            cand tag 'Create git tags for packages in a publish plan'\n            cand filter-plan 'Filter a publish plan down to what a publish report confirms actually succeeded, dropping anything that failed'\n            cand release 'Create, inspect, reconcile, or execute durable release intents'\n            cand completions 'Generate shell completion scripts'\n            cand schema 'Print the JSON schema for a report type'\n            cand help 'Print this message or the help of the given subcommand(s)'\n        }\n        &'callisto;help;add'= {\n        }\n        &'callisto;help;status'= {\n        }\n        &'callisto;help;matrix'= {\n        }\n        &'callisto;help;version'= {\n        }\n        &'callisto;help;pre'= {\n            cand enter 'Enter prerelease mode, tagging subsequent version bumps with the given prerelease tag'\n            cand exit 'Exit prerelease mode, returning to normal versioning'\n        }\n        &'callisto;help;pre;enter'= {\n        }\n        &'callisto;help;pre;exit'= {\n        }\n        &'callisto;help;validate'= {\n        }\n        &'callisto;help;snapshot'= {\n        }\n        &'callisto;help;init'= {\n        }\n        &'callisto;help;plan-publish'= {\n        }\n        &'callisto;help;publish'= {\n        }\n        &'callisto;help;compose-pr-body'= {\n        }\n        &'callisto;help;tag'= {\n        }\n        &'callisto;help;filter-plan'= {\n        }\n        &'callisto;help;release'= {\n            cand plan 'Create a read-only durable release intent from exact package selections'\n            cand inspect 'Display a durable intent, manifest, state, or receipt without recomputing it'\n            cand reconcile 'Report which pending operations are eligible without changing release state'\n            cand execute 'Execute a previously approved intent. This is the only durable mutation route'\n        }\n        &'callisto;help;release;plan'= {\n        }\n        &'callisto;help;release;inspect'= {\n        }\n        &'callisto;help;release;reconcile'= {\n        }\n        &'callisto;help;release;execute'= {\n        }\n        &'callisto;help;completions'= {\n        }\n        &'callisto;help;schema'= {\n        }\n        &'callisto;help;help'= {\n        }\n    ]\n    $completions[$command]\n}\n# Print an optspec for argparse to handle cmd's options that are independent of any subcommand.\nfunction __fish_callisto_global_optspecs\n    string join \\n format= cwd= dry-run h/help V/version\nend\n\nfunction __fish_callisto_needs_command\n    # Figure out if the current invocation already has a command.\n    set -l cmd (commandline -opc)\n    set -e cmd[1]\n    argparse -s (__fish_callisto_global_optspecs) -- $cmd 2>/dev/null\n    or return\n    if set -q argv[1]\n        # Also print the command, so this can be used to figure out what it is.\n        echo $argv[1]\n        return 1\n    end\n    return 0\nend\n\nfunction __fish_callisto_using_subcommand\n    set -l cmd (__fish_callisto_needs_command)\n    test -z \"$cmd\"\n    and return 1\n    contains -- $cmd[1] $argv\nend\n\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -l format -d 'Output format for command results' -r -f -a \"text\\t''\njson\\t''\"\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -l cwd -d 'Workspace directory to operate in (defaults to the current directory)' -r -F\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -l dry-run -d 'Preview manifest and file changes without writing to disk'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -s h -l help -d 'Print help'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -s V -l version -d 'Print version'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"add\" -d 'Create a new changeset describing pending package changes'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"status\" -d 'Show the workspace\\'s pending changesets and diagnostics'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"matrix\" -d 'Print the workspace\\'s native-build target matrix as JSON or a table'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"version\" -d 'Consume pending changesets and bump package versions accordingly'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"pre\" -d 'Manage prerelease mode for the workspace'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"validate\" -d 'Check that changesets and the dependency graph are well-formed'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"snapshot\" -d 'Apply a temporary, non-persistent version bump for a snapshot release'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"init\" -d 'Scaffold Callisto configuration in the current workspace'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"plan-publish\" -d 'Compute which packages are ready to publish and print the publish plan'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"publish\" -d 'Publish ready packages to their ecosystem registries via native CLI tools'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"compose-pr-body\" -d 'Generate a pull request body summarizing pending release changes'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"tag\" -d 'Create git tags for packages in a publish plan'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"filter-plan\" -d 'Filter a publish plan down to what a publish report confirms actually succeeded, dropping anything that failed'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"release\" -d 'Create, inspect, reconcile, or execute durable release intents'\ncomplete -c callisto -n \"__fish_callisto_needs_command\" -f -a \"completions\" -d '