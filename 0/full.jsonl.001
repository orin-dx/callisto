stfile-133-          }\njustfile-134-        ' | sort)\njustfile-135-    echo \"$report\" | awk -F'\\t' '{printf \"%-25s lines=%-6s covered=%-6s cover=%6s%%  %s\\n\", $1, $2, $3, $4, $5}'\njustfile-136-    echo \"$report\" | grep -q FAIL && exit 1 || exit 0\njustfile-137-\njustfile-138-# Clean build targets, Moon task caches, and generated artifacts\njustfile-139-clean:\njustfile-140-    moon clean 2>/dev/null || true\njustfile-141-    cargo clean\njustfile:142:    rm -f lcov.info callisto-schema.json\njustfile-143-\njustfile-144-# Fast pre-commit hook validation (<500ms formatting check)\njustfile-145-pre-commit: fmt-check\njustfile-146-\njustfile-147-# Pre-push hook validation: formatting check plus clippy on affected projects only\njustfile-148-pre-push: fmt-check lint-affected\njustfile-149-\njustfile-150-# Install native Git pre-commit and pre-push hooks\n--\njustfile-155-    @chmod +x .git/hooks/pre-push\njustfile-156-    @echo \"Git pre-commit and pre-push hooks installed successfully.\"\njustfile-157-\njustfile-158-# Run full local CI verification pipeline via moon and just\njustfile-159-ci: fmt-check lint test audit doc-check wasm-check coverage\njustfile-160-\njustfile-161-# Same as `ci`, minus `coverage`. Real CI (callisto-ci.yml) already runs\njustfile-162-# coverage as its own parallel job on a separate runner; locally it's a\njustfile:163:# third full-workspace recompile under llvm-cov instrumentation tacked onto\njustfile-164-# the end of a serial pipeline. Use this for everyday pre-PR checks;\njustfile-165-# coverage numbers are a reporting concern, not something every local run\njustfile-166-# needs to regenerate.\njustfile-167-ci-fast: fmt-check lint test audit doc-check wasm-check\n--\ncrates/callisto-moon/src/extension.rs-133-/// No distinct \"unrecognized subcommand\" error path exists yet.\ncrates/callisto-moon/src/extension.rs-134-#[cfg(feature = \"pdk\")]\ncrates/callisto-moon/src/extension.rs-135-pub(crate) fn resolve_subcommand(args: &[String]) -> &str {\ncrates/callisto-moon/src/extension.rs-136-    args.first().map(|s| s.as_str()).unwrap_or(\"status\")\ncrates/callisto-moon/src/extension.rs-137-}\ncrates/callisto-moon/src/extension.rs-138-\ncrates/callisto-moon/src/extension.rs-139-// `execute_extension`/`initialize_extension` moved to `extension_pdk.rs` --\ncrates/callisto-moon/src/extension.rs-140-// both transitively call `crate::runner::MoonCommandRunner`'s wasm-only\ncrates/callisto-moon/src/extension.rs:141:// CommandRunner impl, so `cargo-llvm-cov` can never observe them executing\ncrates/callisto-moon/src/extension.rs-142-// natively. See that file's module doc comment.\ncrates/callisto-moon/src/extension.rs-143-\ncrates/callisto-moon/src/extension.rs-144-#[cfg(test)]\ncrates/callisto-moon/src/extension.rs-145-mod tests {\ncrates/callisto-moon/src/extension.rs-146-    use super::*;\ncrates/callisto-moon/src/extension.rs-147-\ncrates/callisto-moon/src/extension.rs-148-    #[test]\ncrates/callisto-moon/src/extension.rs-149-    fn test_moon_version_check() {\n--\ncrates/callisto-moon/src/extension_pdk.rs-1-//! `execute_extension`/`initialize_extension` -- the two `pdk`-feature\ncrates/callisto-moon/src/extension_pdk.rs-2-//! functions that transitively call `crate::runner::MoonCommandRunner`'s\ncrates/callisto-moon/src/extension_pdk.rs-3-//! wasm-only `CommandRunner` impl (via `Workspace::load`/`MoonProjectLocator`),\ncrates/callisto-moon/src/extension_pdk.rs:4://! and so can never actually execute inside a native `cargo-llvm-cov`\ncrates/callisto-moon/src/extension_pdk.rs-5-//! instrumented build (see `runner_pdk.rs`'s doc comment for the underlying\ncrates/callisto-moon/src/extension_pdk.rs-6-//! wasm-only-extern reason). Split into their own file so\ncrates/callisto-moon/src/extension_pdk.rs-7-//! `--ignore-filename-regex` can exclude it from coverage reports.\ncrates/callisto-moon/src/extension_pdk.rs-8-//!\ncrates/callisto-moon/src/extension_pdk.rs-9-//! Wire-level coverage (including their error paths) lives in\ncrates/callisto-moon/src/extension_pdk.rs-10-//! `tests/moon_wasm_sandbox.rs`, which drives the real compiled\ncrates/callisto-moon/src/extension_pdk.rs-11-//! `callisto-moon.wasm` module through an actual Extism/wasmtime host.\ncrates/callisto-moon/src/extension_pdk.rs-12-//!\n--\ncrates/callisto-moon/src/lib.rs-1-//! moon WASM extension for callisto.\ncrates/callisto-moon/src/lib.rs-2-\ncrates/callisto-moon/src/lib.rs-3-pub mod extension;\ncrates/callisto-moon/src/lib.rs-4-pub mod locator;\ncrates/callisto-moon/src/lib.rs-5-pub mod runner;\ncrates/callisto-moon/src/lib.rs-6-\ncrates/callisto-moon/src/lib.rs-7-// `execute_extension`/`initialize_extension` (extension_pdk.rs) and the\ncrates/callisto-moon/src/lib.rs-8-// `pdk`-feature `CommandRunner` impl (runner_pdk.rs) are split out from\ncrates/callisto-moon/src/lib.rs:9:// their sibling files so `cargo-llvm-cov`'s `--ignore-filename-regex` can\ncrates/callisto-moon/src/lib.rs-10-// exclude them: both only execute inside a real wasm32-wasip1 Extism host,\ncrates/callisto-moon/src/lib.rs-11-// which native coverage instrumentation can never observe. See each file's\ncrates/callisto-moon/src/lib.rs-12-// module doc comment.\ncrates/callisto-moon/src/lib.rs-13-#[cfg(feature = \"pdk\")]\ncrates/callisto-moon/src/lib.rs-14-mod extension_pdk;\ncrates/callisto-moon/src/lib.rs-15-#[cfg(feature = \"pdk\")]\ncrates/callisto-moon/src/lib.rs-16-mod runner_pdk;\ncrates/callisto-moon/src/lib.rs-17-\n--\ncrates/callisto-moon/Cargo.toml-4-edition.workspace = true\ncrates/callisto-moon/Cargo.toml-5-license = \"AGPL-3.0-only\"\ncrates/callisto-moon/Cargo.toml-6-description = \"Callisto Release Engine — Moon WASM PDK plugin for polyglot monorepo release automation.\"\ncrates/callisto-moon/Cargo.toml-7-repository.workspace = true\ncrates/callisto-moon/Cargo.toml-8-readme = \"README.md\"\ncrates/callisto-moon/Cargo.toml-9-\ncrates/callisto-moon/Cargo.toml-10-# No [lib] crate-type = [\"cdylib\", ...] here deliberately: declaring cdylib\ncrates/callisto-moon/Cargo.toml-11-# in the manifest makes cargo build a native cdylib artifact too whenever the\ncrates/callisto-moon/Cargo.toml:12:# \"pdk\" feature is enabled (e.g. `cargo llvm-cov --all-features` on macOS),\ncrates/callisto-moon/Cargo.toml-13-# and that native link fails -- the pdk-feature code references extism-pdk's\ncrates/callisto-moon/Cargo.toml-14-# WASM-host-only import symbols (_alloc, _input_length, etc.), which don't\ncrates/callisto-moon/Cargo.toml-15-# exist for native linking. The wasm32-wasip1 cdylib artifact is instead\ncrates/callisto-moon/Cargo.toml-16-# requested explicitly, only for that target, via `cargo rustc --crate-type\ncrates/callisto-moon/Cargo.toml-17-# cdylib` in `just wasm-check` and in tests/moon_wasm_sandbox.rs's build step.\ncrates/callisto-moon/Cargo.toml-18-\ncrates/callisto-moon/Cargo.toml-19-[features]\ncrates/callisto-moon/Cargo.toml-20-default = []\n--\ncrates/callisto-moon/src/runner.rs-4-use callisto_model::CommandError;\ncrates/callisto-moon/src/runner.rs-5-#[cfg(not(feature = \"pdk\"))]\ncrates/callisto-moon/src/runner.rs-6-use callisto_model::{CommandOutput, CommandRunner};\ncrates/callisto-moon/src/runner.rs-7-\ncrates/callisto-moon/src/runner.rs-8-pub struct MoonCommandRunner;\ncrates/callisto-moon/src/runner.rs-9-\ncrates/callisto-moon/src/runner.rs-10-// The `#[cfg(feature = \"pdk\")]` `CommandRunner` impl for `MoonCommandRunner`\ncrates/callisto-moon/src/runner.rs-11-// (the wasm32-wasip1 guest path, calling `warpgate_pdk::exec`) lives in\ncrates/callisto-moon/src/runner.rs:12:// `runner_pdk.rs`, split out so `cargo-llvm-cov` can exclude that file --\ncrates/callisto-moon/src/runner.rs-13-// see that file's module doc comment for why.\ncrates/callisto-moon/src/runner.rs-14-\ncrates/callisto-moon/src/runner.rs-15-// Native (non-WASM) builds of this crate — e.g. `cargo check`/`cargo test`\ncrates/callisto-moon/src/runner.rs-16-// without the `pdk` feature — never run inside