cies.miette]\nversion = \"7\"\nfeatures = [\"fancy\"]\n\n[dependencies.path-slash]\nversion = \"0.2\"\n\n[dependencies.pep440_rs]\nversion = \"0.7\"\n\n[dependencies.schemars]\nversion = \"0.8\"\n\n[dependencies.semver]\nversion = \"1\"\nfeatures = [\"serde\"]\n\n[dependencies.serde]\nversion = \"1\"\nfeatures = [\"derive\"]\n\n[dependencies.serde_json]\nversion = \"1\"\nfeatures = [\"preserve_order\"]\n\n[dependencies.sha2]\nversion = \"0.10\"\n\n[dependencies.tempfile]\nversion = \"3\"\n\n[dependencies.thiserror]\nversion = \"1\"\n\n[dev-dependencies.proptest]\nversion = \"1\"\n\n[lints.clippy]\nexpect_used = \"allow\"\nlet_underscore_must_use = \"deny\"\nlet_underscore_untyped = \"deny\"\nmap_err_ignore = \"deny\"\nmodule_name_repetitions = \"allow\"\nmust_use_candidate = \"allow\"\nunwrap_used = \"allow\"\n\n[lints.clippy.all]\nlevel = \"warn\"\npriority = -1\n\n[lints.rust]\nlet_underscore_drop = \"deny\"\nunsafe_code = \"forbid\"\nunused_must_use = \"deny\"\n\n","type":"input_text"},{"text":"\n[84] tool list_agents call: {}\n","type":"input_text"},{"text":"\n[85] tool list_agents result: {\"agents\":[{\"agent_name\":\"/root\",\"agent_status\":\"running\"},{\"agent_name\":\"/root/harden_cutover_model\",\"agent_status\":\"running\"},{\"agent_name\":\"/root/implement_pm4_profiles\",\"agent_status\":\"running\"},{\"agent_name\":\"/root/map_pm4_cutover\",\"agent_status\":{\"completed\":\"FAIL — T3 is materially improved, but not ready.\\n\\n### High: Unified observer is not yet the sole semantic owner\\n\\n- **Status**: CONFIRMED\\n- **Location**: `crates/callisto-graph/src/commands/release.rs:507-844`\\n- **Classification**: Spec Drift\\n- **Root Cause**: `dispatch_prepared` still routes ProductTag through the old local `observed_tag`; sibling npm, Cargo, and forge observers also remain. The local tag observer can treat a matching local-only tag as satisfied, violating the required remote-tag proof.\\n- **Verification**: Delete/migrate every sibling observer and test that a matching local-only tag is `Absent`, while only an exact remote annotated tag is `Exact`.\\n\\n### High: Tests do not exercise the production observer\\n\\n- **Status**: CONFIRMED\\n- **Location**: `release_observation.rs:1035-1224`\\n- **Classification**: Spec Drift\\n- **Root Cause**: No test calls `observe_prepared`, `observe_registry`, `observe_forge_publish`, or `fetch_github_release` through a validated intent/artifact capability. The “supported gh argv” test manually reconstructs the expected argv and invokes the runner directly, so a regression in production argv would still pass. Exact, Absent, Incomplete, Conflict, Unverifiable, tag substitution, asset mismatch, registry mismatch, and cache invalidation are not tested end to end.\\n- **Verification**: Build a validated fixture and drive every operation variant through `observe_prepared`, asserting calls and all five outcomes.\\n\\n### Medium: npm observation reads untrusted tarballs into memory before checking expected length\\n\\n- **Status**: CONFIRMED\\n- **Location**: `release_observation.rs:844-906`, called from `observe_registry:369+`\\n- **Classification**: Boundary Condition\\n- **Root Cause**: `fs::read` allocates the entire registry-provided tarball; only afterward does the caller compare length. A broken or hostile registry can return a multi-gigabyte file for the approved version and exhaust the process.\\n- **Verification**: Pass expected length into the helper, require a single `Component::Normal`, compare file metadata first, then stream the digest. Test an oversized response without allocating it.\\n\\nResolved during review:\\n\\n- Every observation now rechecks workspace trust and prepared remote identity.\\n- Cache invalidation exists for post-effect observation.\\n- npm absence requires structured `E404`/`ETARGET`.\\n- Published releases with an exact asset subset now return `Incomplete`.\\n- The orphan `PublishedReleaseIncomplete` conflict was removed.\\n- GitHub observation uses supported `gh api` arguments, handles nonzero 404 correctly, avoids `target_commitish`, and verifies typed asset digest/length.\\n- Cargo, npm, and PyPI provider logic is otherwise fail-closed and does not retain raw output or credentials.\\n\\n`CARGO_NET_OFFLINE=true moon run callisto-graph:test` reached compilation, but the joint cutover still fails in deferred T3-DISPATCH/T4 consumers and the legacy observer remnants. The temporary npm helper lifetime error found during that run was subsequently fixed.\"}}]}\n","type":"input_text"},{"text":"\n[86] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk cargo fmt --all \u0026\u0026 rtk cargo check -p callisto-graph --lib\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":30000,\"max_output_tokens\":30000});\ntext(r.output);\ntext(`exit=${r.exit_code}`);\n\n","type":"input_text"},{"text":"\n[87] tool exec result: Script completed\nWall time 1.3 seconds\nOutput:\n\nerror[E0432]: unresolved import `release_execution::converge_release`\n  --\u003e crates/callisto-graph/src/commands/mod.rs:30:29\n   |\n30 | pub use release_execution::{converge_release, reconcile_release_execution, ReconciledReleaseExecution};\n   |                             ^^^^^^^^^^^^^^^^ no `converge_release` in `commands::release_execution`\nerror[E0405]: cannot find trait `ReleaseStateWriter` in this scope\n  --\u003e crates/callisto-graph/src/commands/release_execution.rs:26:27\n   |\n26 | pub fn execute_release\u003cW: ReleaseStateWriter\u003e(\n   |                           ^^^^^^^^^^^^^^^^^^ not found in this scope\nerror[E0425]: cannot find type `ReleaseStateStore` in this scope\n  --\u003e crates/callisto-graph/src/commands/release_execution.rs:28:13\n   |\n28 |     store: \u0026ReleaseStateStore\u003cW\u003e,\n   |             ^^^^^^^^^^^^^^^^^ not found in this scope\nerror[E0425]: cannot find type `ReleaseExecutionStateV1` in this scope\n    --\u003e crates/callisto-graph/src/commands/release_exe