d.name() == primary_id.name() {\n223\t                    index\n224\t                        .prefixed\n225\t                        .insert((*eco, id.name().to_string()), primary_id.clone());\n226\t                }\n227\t            }\n228\t\n229\t            let current_decls = decls.clone();\n230\t            if let Some((existing_path, existing_decls)) =\n231\t                package_manifest_decls.insert(primary_id.clone(), (rel_path.clone(), decls))\n232\t            {\n233\t                let name = primary_id.name().to_string();\n234\t                let existing_set = claiming_ecosystems\n235\t                    .get(&existing_path)\n236\t                    .cloned()\n237\t                    .unwrap_or_default();\n238\t                let current_set = claiming_ecosystems\n239\t                    .get(&rel_path)\n240\t                    .cloned()\n241\t                    .unwrap_or_default();\n242\t                if !claiming_sets_disjoint(&existing_set, &current_set) {\n243\t                    return Err(GraphError::DuplicatePackage {\n244\t                        id: primary_id,\n245\t                        paths: vec![existing_path, rel_path],\n246\t                    });\n247\t                }\n248\t                // STALE-KEY REWRITE location (4): re-key package_manifest_decls under\n249\t                // each path's own newly-promoted Prefixed id, sourcing each path's own\n250\t                // decls -- captured via the `existing_decls` returned by `insert` above\n251\t                // and the `current_decls` clone taken before `insert` overwrote the map,\n252\t                // never via a `.get(&primary_id)` lookup after the fact (a lookup miss\n253\t                // there would silently substitute an empty Vec -- exactly the AC-04\n254\t                // manifests-bleed bug).\n255\t                let existing_id = PackageId::Prefixed {\n256\t                    ecosystem: primary_ecosystems[&existing_path],\n257\t         