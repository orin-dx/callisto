!(\n831-        matches!(err, GraphError::LockfileRefreshFailed { .. }),\n832-        \"expected LockfileRefreshFailed; got: {err:?}\"\n833-    );\n834-    let rendered = format!(\"{err}\");\n835-    assert!(\n836-        rendered.contains(\"pnpm-lock.yaml\"),\n837-        \"error must name the lockfile: {rendered}\"\n838-    );\n839-    assert!(\n840-        rendered.contains(\"pnpm install --lockfile-only\"),\n841-        \"error must name the command: {rendered}\"\n842-    );\n843-    assert!(\n844-        root.join(changeset).exists(),\n845-        \"refresh failure must retain the changeset input\"\n846-    );\n847-    let manifest: serde_json::Value =\n848-        serde_json::from_slice(&std::fs::read(root.join(\"package.json\")).unwrap()).unwrap();","is_error":false}]},"uuid":"363f8d4f-f47b-4e41-baf1-1d740ae33e1d","timestamp":"2026-11-14T02:47:25.858Z","toolUseResult":{"stdout":"790-        })\n791-    }\n792-}\n793-\n794-/// A lockfile refresh command that exits non-zero must stop `version`\n795-/// with a coded error naming the command and the lockfile, instead of\n796-/// being swallowed into a result entry.\n797-#[test]\n798:fn refresh_lockfiles_failure_stops_apply_with_coded_error_naming_command_and_lockfile() {\n799-    let dir = tempfile::tempdir().expect(\"create tempdir\");\n800-    let root = dir.path();\n801-    std::fs::write(root.join(\"pnpm-lock.yaml\"), \"# lock\").unwrap();\n802-    std::fs::write(root.join(\"package.json\"), r#\"{\"name\":\"my-pkg\",\"version\":\"1.0.0\"}\"#).unwrap();\n803-    std::fs::create_dir_all(root.join(\".changeset\")).unwrap();\n804-    let changeset = PathBuf::from(\".changeset/pending.md\");\n805-    std::fs::write(root.join(&changeset), \"---\\nnpm: patch\\n---\\n\\nFix\\n\").unwrap();\n806-\n807-    let runner = FailingProgramRunner {\n808-        failing_program: \"pnpm\",\n809-        exit_code: 1,\n810-        stderr: \"ERR_PNPM_NO_LOCKFILE\",\n811-    };\n812-\n813-    let plan = VersionPlan {\n814-        b