ned().collect();\n            for edge in dependents {\n                let cov = coverage(&edge.spec, &new_version).map_err(|source| GraphError::GrammarMismatch {\n                    from: edge.from.clone(),\n                    to: edge.to.clone(),\n                    source,\n                })?;\n\n                let d = cascade_action(edge.kind, cov, src_sev, input.cfg);\n\n                if d.unknown_coverage && !matches!(edge.spec, DepSpec::Opaque(_)) {\n                    let code = match edge.spec {\n                        DepSpec::Catalog(_) => DiagnosticCode::CatalogSpecNotRewritten,\n                        _ => DiagnosticCode::RangeNotRoundTrippable,\n                    };\n                    out.diagnostics.push(Diagnostic {\n                        code,\n                        severity: DiagnosticSeverity::Warning,\n                        message: format!(\n                            \"spec `{}` for `{}` could not be tested for coverage\",\n                            edge.spec.render(),\n                            edge.to.display_name()\n                        ),\n145:pub struct CascadeOutcome {\n146-    pub severities: BTreeMap<PackageId, Severity>,\n147-    pub targets: BTreeMap<PackageId, Version>,\n148-    pub reasons: BTreeMap<PackageId, BumpReason>,\n149-    pub governed_by: BTreeMap<PackageId, ConfigKey>,\n150-    pub rewrites: BTreeMap<RewriteKey, SpecRewrite>,\n151-    pub diagnostics: Vec<Diagnostic>,\n152-}\n153-\n154-pub fn run_cascade<D: DependencyResolver>(input: CascadeInput<'_, D>) -> Result<CascadeOutcome, GraphError> {\n155-    solve_cascade(input)\n156-}\n157-\n158-pub(crate) fn manifest_ecosystem(from_manifest: &std::path::Path) -> Ecosystem {\n159-    callisto_model::ManifestFormat::from_path(from_manifest)\n160-        .map(|fmt| fmt.ecosystem())\n161-        .unwrap_or(Ecosystem::Npm)\n162-}\n163-\n164-pub(crate) fn dependency_rewrite_key(edge: &DepEdge) -> RewriteKey {\n165-    RewriteKey {\n166-        target: i