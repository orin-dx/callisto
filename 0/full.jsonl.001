+    RemoteAnnotatedTagConflict, RemoteAnnotatedTagObservation, TagAnnotationDigest, VcsError,\\n@@\\n impl\u003c'r\u003e ShellGit\u003c'r\u003e {\\n@@\\n     pub fn new(runner: \u0026'r dyn CommandRunner, root: impl Into\u003cPathBuf\u003e) -\u003e Self {\\n@@\\n     }\\n+\\n+    /// Creates the exact local annotated tag, or proves that an existing tag\\n+    /// is identical and can be reused after a crash. This never deletes or\\n+    /// force-moves a ref.\\n+    pub(crate) fn ensure_local_annotated_tag(\\n+        \u0026self,\\n+        name: \u0026TagName,\\n+        target_sha: \u0026CommitSha,\\n+        annotation: \u0026str,\\n+        sign: crate::TagSignPolicy,\\n+        permit: \u0026ApplyPermit,\\n+    ) -\u003e Result\u003c(), VcsError\u003e {\\n+        let reference = format!(\\\"refs/tags/{}\\\", name.as_str());\\n+        let exists = self\\n+            .runner\\n+            .run(\\\"git\\\", \u0026[\\\"show-ref\\\", \\\"--verify\\\", \\\"--quiet\\\", \\\"--\\\", \u0026reference], \u0026self.root)?;\\n+        match exists.exit_code {\\n+            Some(1) =\u003e return self.create_tag(name.as_str(), target_sha, Some(annotation), sign, permit),\\n+            Some(0) =\u003e {}\\n+            _ =\u003e return Err(remote_command_error(\\\"git show-ref\\\", \u0026exists)),\\n+        }\\n+\\n+        let object = self.runner.run(\\n+            \\\"git\\\",\\n+            \u0026[\\\"--no-replace-objects\\\", \\\"cat-file\\\", \\\"-p\\\", \\\"--\\\", \u0026reference],\\n+            \u0026self.root,\\n+        )?;\\n+        if !object.success() {\\n+            return Err(remote_command_error(\\\"git cat-file\\\", \u0026object));\\n+        }\\n+        let (actual_target, actual_annotation) = parse_annotated_tag_object(\u0026object.stdout).map_err(|_| {\\n+            VcsError::LocalAnnotatedTagConflict {\\n+                name: name.clone(),\\n+                conflict: LocalAnnotatedTagConflict::NotAnnotated,\\n+            }\\n+        })?;\\n+        if actual_target != *target_sha {\\n+            return Err(VcsError::LocalAnnotatedTagConflict {\\n+                name: name.clone(),\\n+                conflict: LocalAnnotatedTagConflict::Target {\\n+                    expected: target_sha.clone(),\\n+                    actual: actual_target,\\n+                },\\n+            });\\n+        }\\n+        if TagAnnotationDigest::from_tag_object_message(actual_annotation.as_bytes())\\n+            != TagAnnotationDigest::from_annotation(annotation)\\n+        {\\n+            return Err(VcsError::LocalAnnotatedTagConflict {\\n+                name: name.clone(),\\n+                conflict: LocalAnnotatedTagConflict::Annotation,\\n+            });\\n+        }\\n+        Ok(())\\n+    }\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n\n","type":"input_text"},{"text":"\n[78] tool exec result: Script completed\nWall time 7.4 seconds\nOutput:\n\n{}\n","type":"input_text"},{"text":"\n[79] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-vcs/src/access.rs\\n@@\\n impl\u003c'r\u003e GitAccess\u003c'r\u003e {\\n@@\\n     pub fn discover(root: impl AsRef\u003cPath\u003e, runner: \u0026'r dyn CommandRunner) -\u003e Self {\\n@@\\n     }\\n+\\n+    /// Creates an exact local annotated release tag, or reuses the exact tag\\n+    /// left by a prior interrupted attempt. Conflicting refs are never\\n+    /// deleted or force-moved.\\n+    pub fn ensure_local_annotated_tag(\\n+        \u0026self,\\n+        name: \u0026TagName,\\n+        target_sha: \u0026CommitSha,\\n+        annotation: \u0026str,\\n+        sign: crate::TagSignPolicy,\\n+        permit: \u0026ApplyPermit,\\n+    ) -\u003e Result\u003c(), VcsError\u003e {\\n+        // This retry protocol must observe the invocation's live local refs,\\n+        // so it is intentionally shell-owned rather than using a native\\n+        // repository handle cached at discover