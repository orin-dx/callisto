{"type":"api-request-blob","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","hash":"d1a88b563dcb2dbbac4cef1dc04b1b558b904245103fa4722fb78a112b9b88bf","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01MHgQ543Hfb1ycZb9VPXkvu","name":"Read","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-canonical-config/crates/callisto-graph/src/config/resolve.rs","offset":800,"limit":70},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_014kf3RCiYDRYfd3GFu6poZ1","name":"Read","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-canonical-config/crates/callisto-graph/src/config/resolve.rs","offset":1005,"limit":200},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","hash":"8a0a1618f5fffc26363b261a13d2d8d2fea534dc68538cd9b4ff30223d1976b7","message":{"role":"user","content":[{"tool_use_id":"toolu_01MHgQ543Hfb1ycZb9VPXkvu","type":"tool_result","content":"800\t        let tmp = tempfile::tempdir().expect(\"tempdir\");\n801\t        let root = tmp.path();\n802\t        fs::write(root.join(\"callisto.toml\"), \"[changesets]\\ndir = \\\".changeset\\\"\\n\").expect(\"write callisto.toml\");\n803\t\n804\t        let result = load(root);\n805\t        assert!(\n806\t            result.is_ok(),\n807\t            \"expected load() to succeed for normal changesets dir, got: {result:?}\"\n808\t        );\n809\t    }\n810\t\n811\t    #[test]\n812\t    fn test_package_set_is_parsed_into_resolved_config() {\n813\t        let tmp = tempfile::tempdir().expect(\"tempdir\");\n814\t        let root = tmp.path();\n815\t        fs::write(\n816\t            root.join(\"callisto.toml\"),\n817\t            \"[[package-set]]\\nmatch = \\\"cargo/pkg-*\\\"\\npublish-to = [\\\"none\\\"]\\nrelease-trigger = \\\"auto\\\"\\n\",\n818\t        )\n819\t        .expect(\"write callisto.toml\");\n820\t\n821\t        let config = load(root).expect(\"load should succeed\");\n822\t        assert_eq!(\n823\t            config.package_sets.len(),\n824\t            1,\n825\t            \"one [[package-set]] rule expected; got: {:?}\",\n826\t            config.package_sets\n827\t        );\n828\t        let (pattern, pkg_cfg) = &config.package_sets[0];\n829\t        assert!(\n830\t            pattern.matches(&callisto_model::PackageId::parse(\"pkg-a\").unwrap()),\n831\t            \"pattern 'pkg-*' must match 'pkg-a'\"\n832\t        );\n833\t        assert_eq!(\n834\t            pkg_cfg.publish_to,\n835\t            Some(vec![callisto_model::PublishTarget::None]),\n836\t            \"publish-to = [\\\"none\\\"] must be parsed\"\n837\t        );\n838\t        assert_eq!(\n839\t            pkg_cfg.release_trigger,\n840\t            Some(callisto_model::ReleaseTrigger::Auto),\n841\t            \"release-trigger = \\\"auto\\\" must be parsed\"\n842\t        );\n843\t    }\n844\t\n845\t    #[test]\n846\t    fn test_typo_in_callisto_toml_is_rejected_not_silently_ignored() {\n847\t        let tmp = tempfile::tempdir().expect(\"tempdir\");\n848\t        let root = tmp.path();\n849\t        // \"cascade_mode\" is a common typo for [cascade] mode = \"always\"\n850\t        fs::write(root.join(\"callisto.toml\"), \"[cascade]\\ncascade_mode = \\\"always\\\"\\n\").expect(\"write callisto.toml\");\n851\t\n852\t        let result = load(root);\n853\t        assert!(\n854\t            result.is_err(),\n855\t            \"load() must reject unknown field 'cascade_mode'; \\\n856\t             silently ignoring it means the user's typo has no effect and they have no idea why\"\n857\t        );\n858\t    }\n859\t\n860\t    #[test]\n861\t    fn test_package_override_publish_to_is_parsed_not_discarded() {\n862\t        let tmp = tempfile::tempdir().expect(\"tempdir\");\n863\t        let root = tmp.path();\n864\t        fs::write(\n865\t            root.join(\"callisto.toml\"),\n866\t            \"[[package]]\\nmatch = \\\"cargo/my-crate\\\"\\npublish-to = [\\\"none\\\"]\\n\",\n867\t        )\n868\t        .expect(\"write callisto.toml\");\n869\t"},{"tool_use_id":"toolu_014kf3RCiYDRYfd3GFu6poZ1","type":"tool_result","content":"1005\t        assert!(\n1006\t            pcfg.changelog\n1007\t                .as_ref()\n1008\t                .map(|p| p.ends_with(\"FIRST.md\"))\n1009\t                .unwrap_or(false),\n1010\t            \"First MATCHING Prefixed entry (npm/pkg) must win: expected changelog ending \\\n1011\t             in FIRST.md. cargo/other skipped (name mismatch); pypi/pkg never reached. \\\n1012\t             Got changelog: {:?}\",\n1013\t            pcfg.changelog\n1014\t        );\n1015\t    }\n1016\t\n1017\t    /// No Prefixed rule matches \"pkg\". Pass 1 finds nothing.\n1018\t    /// Pass 2 finds the Bare \"pkg\" entry and returns it.\n1019\t    #[test]\n1020\t    fn resolve_package_config_bare_rule_wins_via_pass_2_when_no_prefixed_matches() {\n1021\t        let tmp = tempfile::tempdir().expect(\"tempdir\");\n1022\t        let root = tmp.path();\n1023\t        // cargo/other: Prefixed but name \"other\" != \"pkg\" — pass 1 skips, pass 2 skips\n1024\t        // pkg (Bare):  pass 1 skips (ecosystem() is None), pass 2 finds it — wins\n1025\t        fs::write(\n1026\t            root.join(\"callisto.toml\"),\n1027\t            \"[[package]]\\nmatch = \\\"cargo/other\\\"\\nchangelog = \\\"WRONG.md\\\"\\n\\n[[package]]\\nmatch = \\\"cargo/pkg\\\"\\nrelease-trigger = \\\"auto\\\"\\n\",\n1028\t        )\n1029\t        .expect(\"write callisto.toml\");\n1030\t        let cfg = load(root).expect(\"load should succeed\");\n1031\t        let id = PackageId::parse(\"pkg\").unwrap();\n1032\t        let pcfg = resolve_package_config(&id, &[], &cfg)\n1033\t            .unwrap()\n1034\t            .expect(\"resolve_package_config must return Some via pass 2 for Bare(\\\"pkg\\\")\");\n1035\t        assert_eq!(\n1036\t            pcfg.release_trigger,\n1037\t            Some(ReleaseTrigger::Auto),\n1038\t            \"Bare rule must win via pass 2: expected release_trigger = Some(Auto). \\\n1039\t             Got: {:?}\",\n1040\t            pcfg.release_trigger\n1041\t        );\n1042\t    }\n1043\t\n1044\t    /// No rule matches \"pkg\" at all.\n1045\t    /// Pass 1 and pass 2 both iterate zero matching entries; result is None.\n1046\t    #[test]\n1047\t    fn resolve_package_config_returns_none_when_no_rule_matches() {\n1048\t        let tmp = tempfile::tempdir().expect(\"tempdir\");\n1049\t        let root = tmp.path();\n1050\t        // Only a Prefixed rule for \"other\" — neither pass finds a match for \"pkg\".\n1051\t        fs::write(\n1052\t            root.join(\"callisto.toml\"),\n1053\t            \"[[package]]\\nmatch = \\\"cargo/other\\\"\\nchangelog = \\\"WRONG.md\\\"\\n\",\n1054\t        )\n1055\t        .expect(\"write callisto.toml\");\n1056\t        let cfg = load(root).expect(\"load should succeed\");\n1057\t        let id = PackageId::parse(\"pkg\").unwrap();\n1058\t        let result = resolve_package_config(&id, &[], &cfg).unwrap();\n1059\t        assert!(\n1060\t            result.is_none(),\n1061\t            \"resolve_package_config must return None when no rule matches; got Some(...)\"\n1062\t        );\n1063\t    }\n1064\t\n1065\t    /// Cfg.packages is empty. Both passes iterate zero entries.\n1066\t    /// Every query returns None regardless of the id argument.\n1067\t    #[test]\n1068\t    fn resolve_package_config_returns_none_for_empty_packages() {\n1069\t        let tmp = tempfile::tempdir().expect(\"tempdir\");\n1070\t        let root = tmp.path();\n1071\t        // No [[package]] sections at all — packages Vec is empty.\n1072\t        fs::write(root.join(\"callisto.toml\"), \"\").expect(\"write callisto.toml\");\n1073\t        let cfg = load(root).expect(\"load should succeed\");\n1074\t        assert!(\n1075\t            cfg.packages.is_empty(),\n1076\t            \"fixture must produce an empty packages Vec; got: {:?}\",\n1077\t            cfg.packages\n1078\t        );\n1079\t        for id_str in &[\"pkg\", \"npm/pkg\", \"cargo/pkg\"] {\n1080\t            let id = PackageId::parse(id_str).unwrap();\n1081\t            let result = resolve_package_config(&id, &[], &cfg).unwrap();\n1082\t            assert!(\n1083\t                result.is_none(),\n1084\t                \"resolve_package_config must return None for empty packages, \\\n1085\t                 id={id_str}\"\n1086\t            );\n1087\t        }\n1088\t    }\n1089\t\n1090\t    /// Two Prefixed rules — npm/foo declared first, cargo/foo declared second in Vec order.\n1091\t    /// Both rules set release_trigger with different values so the winner is directly observable.\n1092\t    /// npm/foo (first): release-trigger = \"auto\" -> release_trigger = Some(Auto).\n1093\t    /// cargo/foo (second): release-trigger = \"changeset\" -> release_trigger = Some(Changeset).\n1094\t    /// Pass 1 returns the first matching Prefixed entry in Vec (TOML declaration) order.\n1095\t    /// Vec order must govern: npm/foo is first -> release_trigger must be Some(Auto).\n1096\t    /// A sorted implementation (cargo < npm alphabetically) would return Some(Changeset).\n1097\t    #[test]\n1098\t    fn resolve_package_config_vec_declaration_order_not_alphabetical_sort() {\n1099\t        let tmp = tempfile::tempdir().expect(\"tempdir\");\n1100\t        let root = tmp.path();\n1101\t        // npm/foo FIRST in Vec: release-trigger = \"auto\"\n1102\t        // cargo/foo SECOND in Vec: release-trigger = \"changeset\"\n1103\t        // Querying Bare(\"foo\"): pass 1 returns npm/foo (first Prefixed match) -> Some(Auto).\n1104\t        // A sorted implementation would return cargo/foo (cargo < npm) -> Some(Changeset).\n1105\t        fs::write(\n1106\t            root.join(\"callisto.toml\"),\n1107\t            \"[[package]]\\nmatch = \\\"npm/foo\\\"\\nrelease-trigger = \\\"auto\\\"\\n\\n[[package]]\\nmatch = \\\"cargo/foo\\\"\\nrelease-trigger = \\\"changeset\\\"\\n\",\n1108\t        )\n1109\t        .expect(\"write callisto.toml\");\n1110\t        let cfg = load(root).expect(\"load should succeed\");\n1111\t        let id = PackageId::parse(\"foo\").unwrap();\n1112\t        let pcfg = resolve_package_config(&id, &[Ecosystem::Npm, Ecosystem::Cargo], &cfg)\n1113\t            .unwrap()\n1114\t            .expect(\"resolve_package_config must return Some for Bare(\\\"foo\\\")\");\n1115\t        assert_eq!(\n1116\t            pcfg.release_trigger,\n1117\t            Some(ReleaseTrigger::Auto),\n1118\t            \"npm/foo (declared first) must win over cargo/foo (declared second) — Vec order, \\\n1119\t             not alphabetical sort, governs first-match-wins. \\\n1120\t             A sorted implementation would incorrectly return Some(Changeset). Got: {:?}\",\n1121\t            pcfg.release_trigger\n1122\t        );\n1123\t    }\n1124\t\n1125\t    #[test]\n1126\t    fn resolve_package_config_returns_ambiguous_name_for_unprefixed_rule_matching_two_promoted_siblings() {\n1127\t        let tmp = tempfile::tempdir().expect(\"tempdir\");\n1128\t        let root = tmp.path();\n1129\t        fs::write(\n1130\t            root.join(\"callisto.toml\"),\n1131\t            \"[[package]]\\nmatch = \\\"cargo/native-core\\\"\\nrelease-trigger = \\\"auto\\\"\\n\",\n1132\t        )\n1133\t        .expect(\"write callisto.toml\");\n1134\t        let mut cfg = load(root).expect(\"load should succeed\");\n1135\t\n1136\t        let cargo_id = PackageId::Prefixed {\n1137\t            ecosystem: Ecosystem::Cargo,\n1138\t            name: \"native-core\".to_string(),\n1139\t        };\n1140\t        let npm_id = PackageId::Prefixed {\n1141\t            ecosystem: Ecosystem::Npm,\n1142\t            name: \"native-core\".to_string(),\n1143\t        };\n1144\t        let mut cargo_set = BTreeSet::new();\n1145\t        cargo_set.insert(Ecosystem::Cargo);\n1146\t        let mut npm_set = BTreeSet::new();\n1147\t        npm_set.insert(Ecosystem::Npm);\n1148\t        cfg.promoted_siblings.insert(\n1149\t            \"native-core\".to_string(),\n1150\t            vec![(cargo_id.clone(), cargo_set), (npm_id, npm_set)],\n1151\t        );\n1152\t\n1153\t        let err = resolve_package_config(&cargo_id, &[Ecosystem::Cargo], &cfg).unwrap_err();\n1154\t        match err {\n1155\t            GraphError::AmbiguousName { name, candidates } => {\n1156\t                assert_eq!(name, \"native-core\");\n1157\t                assert_eq!(candidates.len(), 2);\n1158\t            }\n1159\t            other => panic!(\"expected AmbiguousName, got {other:?}\"),\n1160\t        }\n1161\t    }\n1162\t\n1163\t    /// repro/ws-rule: a `pypi/foo` rule must not apply to a Cargo-only `foo`.\n1164\t    /// Before the fix, `PackageId::matches` treated the Bare query id as an\n1165\t    /// ecosystem wildcard, so a Prefixed rule for any ecosystem matched by\n1166\t    /// name alone -- `package_ecosystems` (the package's real, manifest-derived\n1167\t    /// ecosystems) is what makes the rule ecosystem-exact.\n1168\t    #[test]\n1169\t    fn resolve_package_config_prefixed_rule_does_not_apply_to_a_different_ecosystem_package() {\n1170\t        let tmp = tempfile::tempdir().expect(\"tempdir\");\n1171\t        let root = tmp.path();\n1172\t        fs::write(\n1173\t            root.join(\"callisto.toml\"),\n1174\t            \"[[package]]\\nmatch = \\\"pypi/foo\\\"\\nrelease-trigger = \\\"changeset\\\"\\n\",\n1175\t        )\n1176\t        .expect(\"write callisto.toml\");\n1177\t        let cfg = load(root).expect(\"load should succeed\");\n1178\t        let id = PackageId::parse(\"foo\").unwrap();\n1179\t        let result = resolve_package_config(&id, &[Ecosystem::Cargo], &cfg).unwrap();\n1180\t        assert!(\n1181\t            result.is_none(),\n1182\t            \"a `pypi/foo` rule must not apply to a package whose only real ecosystem is Cargo; got {result:?}\"\n1183\t        );\n1184\t    }\n1185\t\n1186\t    // --- parse_publish_target / parse_release_trigger direct coverage ------\n1187\t\n1188\t    #[test]\n1189\t    fn parse_publish_target_parses_all_known_variants() {\n1190\t        assert_eq!(parse_publish_target(\"crates-io\").unwrap(), PublishTarget::CratesIo);\n1191\t        assert_eq!(\n1192\t            parse_publish_target(\"npm\").unwrap(),\n1193\t            PublishTarget::Npm {\n1194\t                registry: None,\n1195\t                access: None\n1196\t            }\n1197\t        );\n1198\t        assert_eq!(\n1199\t            parse_publish_target(\"pypi\").unwrap(),\n1200\t            PublishTarget::Pypi { index: None }\n1201\t        );\n1202\t        assert_eq!(\n1203\t            parse_publish_target(\"nuget\").unwrap(),\n1204\t            PublishTarget::NuGet { source: None }"}]}}
