{"timestamp":"2026-09-02T02:59:22.421Z","ordinal":8874,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a04adc-934d-7aa3-b352-bdba70d0f67c","turn_id":"01a0600e-0262-7e41-937d-39490f5db101","item":{"type":"CommandExecution","id":"exec-18b37ede-f410-4d7b-b9b5-c346b6f0ed8a","process_id":"33112","command":["/bin/zsh","-lc","rtk git worktree list && rtk git status --short --branch && rtk sed -n '1,260p' .github/workflows/callisto-ci.yml && rtk rg -n -C 3 'cargo-nextest|nextest' .github justfile moon.yml .moon 2>/dev/null"],"cwd":"file:///Users/gabe/Projects/callisto","parsed_cmd":[{"type":"unknown","cmd":"rtk git worktree list && rtk git status --short --branch && rtk sed -n '1,260p' .github/workflows/callisto-ci.yml && rtk rg -n -C 3 'cargo-nextest|nextest' .github justfile moon.yml .moon 2>/dev/null"}],"source":"unified_exec_startup","status":"failed","stdout":"* codex-release-trust-specs...origin/main [ahead 3, behind 2]\n M crates/callisto-vcs/src/access.rs\n M crates/callisto-vcs/src/shell.rs\n?? .codex/\n?? .opencode/\n?? .playwright-mcp/\n?? err.log\nname: Callisto CI & Validation\n\non:\n  push:\n    branches:\n      - main\n  pull_request:\n    branches:\n      - main\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\npermissions:\n  contents: read\n  pull-requests: write\n  checks: write\n  statuses: write\n\njobs:\n  fmt:\n    name: Code Formatting (Moon & Just)\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - uses: extractions/setup-just@v2\n      - uses: moonrepo/setup-toolchain@v0\n      - uses: orin-dx/actions/setup-rust@v1.1\n        with:\n          components: rustfmt\n          targets: wasm32-wasip1\n      - run: just fmt-check\n\n  clippy:\n    name: Clippy Lints (Moon & Just)\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - uses: extractions/setup-just@v2\n      - uses: moonrepo/setup-toolchain@v0\n      - uses: orin-dx/actions/setup-rust@v1.1\n        with:\n          components: clippy\n          targets: wasm32-wasip1\n      - run: just lint\n\n  test:\n    name: Test Suite & WASM Check (${{ matrix.os }})\n    runs-on: ${{ matrix.os }}\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-latest, macos-latest]\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - uses: extractions/setup-just@v2\n      - uses: moonrepo/setup-toolchain@v0\n      - uses: orin-dx/actions/setup-rust@v1.1\n        with:\n          targets: wasm32-wasip1\n      - run: just test\n      - run: just wasm-check\n\n  coverage:\n    name: Code Coverage & Test Report\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - uses: extractions/setup-just@v2\n      - uses: orin-dx/actions/setup-rust@v1.1\n        with:\n          components: llvm-tools-preview\n          targets: wasm32-wasip1\n      - uses: taiki-e/install-action@v2\n        with:\n          tool: cargo-llvm-cov\n      - run: just wasm-check\n      - run: just coverage 90\n      # Non-blocking for now: the workspace-total gate above can pass while\n      # a small crate is far below threshold (a few large crates dominate\n      # the total line count). Visible in logs so regressions get noticed;\n      # promote to a required check once existing per-crate gaps are closed.\n      - run: just coverage-per-crate 90 || echo \"::warning::one or more crates below 90% line coverage (non-blocking, see job log above)\"\n      - uses: actions/upload-artifact@v4\n        with:\n          name: code-coverage-report\n          path: lcov.info\n\n  security:\n    name: Security & Advisory Audit (Moon & Just)\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - uses: extrac