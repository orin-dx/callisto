{"parentUuid":"23b43285-a2e1-40fe-a1a4-95104c551272","isSidechain":false,"promptId":"35b6619a-d515-4300-a461-744b9d7ddd67","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A9nHvzwGfADUPgSGPBUmj4","type":"tool_result","content":"1\tuse callisto_model::{CommandRunner, ValidateReport, SCHEMA_VERSION};\n2\t\n3\tuse crate::commands::escalate;\n4\tuse crate::error::GraphError;\n5\tuse crate::resolver::DependencyResolver;\n6\tuse crate::Workspace;\n7\t\n8\t#[derive(Clone, Debug, Default)]\n9\tpub struct ValidateOptions {\n10\t    pub staged: bool,\n11\t    pub since: Option<String>,\n12\t    pub strict: bool,\n13\t    pub strict_graph: bool,\n14\t}\n15\t\n16\tpub fn validate<R: CommandRunner, D: DependencyResolver>(\n17\t    ws: &Workspace<'_, R, D>,\n18\t    opts: &ValidateOptions,\n19\t) -> Result<ValidateReport, GraphError> {\n20\t    let mut diagnostics = Vec::new();\n21\t    let loaded = crate::load_changesets(&ws.root, &ws.config)?;\n22\t\n23\t    let target_changesets: Vec<_> = if opts.staged {\n24\t        let out = ws\n25\t            .runner\n26\t            .run(\"git\", &[\"diff\", \"--cached\", \"--name-only\"], &ws.root)?;\n27\t        if !out.success() {\n28\t            return Err(GraphError::Command(callisto_model::CommandError::Io {\n29\t                program: \"git\".to_string(),\n30\t                message: crate::apply::redact_git_stderr(&out.stderr),\n31\t            }));\n32\t        }\n33\t        let files: Vec<String> = out\n34\t            .stdout_trimmed()\n35\t            .lines()\n36\t            .map(|l| l.trim_matches('\"').to_string())\n37\t            .collect();\n38\t        loaded\n39\t            .into_iter()\n40\t            .filter(|cs| files.iter().any(|f| cs.path.ends_with(f)))\n41\t            .collect()\n42\t    } else if let Some(ref since) = opts.since {\n43\t        if since.starts_with('-') {\n44\t            return Err(GraphError::Command(callisto_model::CommandError::Io {\n45\t                program: \"git\".to_string(),\n46\t                message: \"invalid since ref\".to_string(),\n47\t            }));\n48\t        }\n49\t        let range = format!(\"{since}..HEAD\");\n50\t        let out = ws\n51\t            .runner\n52\t            .run(\"git\", &[\"diff\", \"--name-only\", &range, \"--\"], &ws.root)?;\n53\t        if !out.success() {\n54\t            return Err(GraphError::Command(callisto_model::CommandError::Io {\n55\t                program: \"git\".to_string(),\n56\t                message: crate::apply::redact_git_stderr(&out.stderr),\n57\t            }));\n58\t        }\n59\t        let files: Vec<String> = out\n60\t            .stdout_trimmed()\n61\t            .lines()\n62\t            .map(|l| l.trim_matches('\"').to_string())\n63\t            .collect();\n64\t        loaded\n65\t            .into_iter()\n66\t            .filter(|cs| files.iter().any(|f| cs.path.ends_with(f)))\n67\t            .collect()\n68\t    } else {\n69\t        loaded\n70\t    };\n71\t\n72\t    for cs in &target_changesets {\n73\t        if cs.changeset.entries.is_empty() {\n74\t            diagnostics.push(callisto_model::Diagnostic {\n75\t                code: callisto_model::DiagnosticCode::EmptyChangeset,\n76\t                severity: callisto_model::DiagnosticSeverity::Error,\n77\t                message: format!(\"Changeset `{}` is empty\", cs.path.display()),\n78\t                package: None,\n79\t                path: Some(cs.path.clone()),\n80\t                governed_by: None,\n81\t                escalated_by: None,\n82\t            });\n83\t        }\n84\t\n85\t        if !cs.changeset.entries.is_empty() && cs.changeset.summary.trim().is_empty() {\n86\t            diagnostics.push(callisto_model::Diagnostic {\n87\t                code: callisto_model::DiagnosticCode::EmptySummary,\n88\t                severity: callisto_model::DiagnosticSeverity::Error,\n89\t                message: format!(\n90\t                    \"Changeset `{}` has entries but a