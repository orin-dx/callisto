\n            expected: Box\u003cVersion\u003e,\n            found: Box\u003cVersion\u003e,\n        },\n        #[error(\"release decision does not derive the coordinated product release\")]\n        DecisionProductMismatch,\n        #[error(\"approved registry artifact is outside the release decision\")]\n        RegistryArtifactOutsideDecision,\n        #[error(\"artifact slot is unsafe\")]\n        UnsafeArtifactSlot,\n        #[error(\"artifact slot provenance is invalid\")]\n        InvalidProvenance,\n        #[error(\"product payloads do not share one provenance verification policy\")]\n        HeterogeneousProductProvenance,\n        #[error(\"reserved artifact file name is wrong\")]\n        WrongReservedFileName,\n        #[error(\"product payload filename or kin\u003ctruncated omitted_approx_tokens=\"667\" /\u003ea_version: u8,\n            package: ReleasePackageId,\n            version: Version,\n            #[serde(flatten)]\n            registry: RegistryBindingId,\n            slot: ReleaseArtifactSlot,\n            digest: ArtifactDigest,\n            #[serde(rename = \"byteLength\")]\n            byte_length: u64,\n        },\n        RemoteTag {\n            #[serde(rename = \"schemaVersion\")]\n            schema_version: u8,\n            release: ProductReleaseId,\n            name: String,\n            target: CommitSha,\n            #[serde(rename = \"annotationDigest\")]\n            annotation_digest: ArtifactDigest,\n        },\n        ForgePrepare {\n            #[serde(rename = \"schemaVersion\")]\n            schema_version: u8,\n            release: ProductReleaseId,\n            lifecycle: ForgePrepareLifecycle,\n        },\n        ForgePublish {\n            #[serde(rename = \"schemaVersion\")]\n            schema_version: u8,\n            release: ProductReleaseId,\n            #[serde(rename = \"assetRosterDigest\")]\n            asset_roster_digest: ArtifactDigest,\n        },\n        ForgeAsset {\n            #[serde(rename = \"schemaVersion\")]\n            schema_version: u8,\n            release: ProductReleaseId,\n            slot: ReleaseArtifactSlot,\n            digest: ArtifactDigest,\n            #[serde(rename = \"byteLength\")]\n            byte_length: u64,\n        },\n    }\n\n    impl ReleaseObservationEvidence {\n        pub const SCHEMA_VERSION: u8 = 1;\n\n        pub fn registry_artifact(\n            package: ReleasePackageId,\n            version: Version,\n            registry: RegistryBindingId,\n            slot: ReleaseArtifactSlot,\n            digest: ArtifactDigest,\n            byte_length: u64,\n        ) -\u003e Self {\n            Self::RegistryArtifact {\n                schema_version: Self::SCHEMA_VERSION,\n                package,\n                version,\n                registry,\n                slot,\n                digest,\n                byte_length,\n            }\n\n","type":"input_text"},{"text":"\n[89] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-model/src/release.rs\\n@@\\n-            let version = Version::parse(canonical, VersionGrammar::SemVer).map_err(|_| {\\n+            let version = Version::parse(canonical, VersionGrammar::SemVer).map_err(|_parse_error| {\\n@@\\n         #[error(\\\"registry artifact format does not match package ecosystem\\\")]\\n         RegistryFormatMismatch,\\n+        #[error(\\\"registry artifact version grammar does not match package ecosystem\\\")]\\n+        RegistryVersionGrammarMismatch,\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-model/src/release.rs\\n@@\\n         if approved\\n             .iter()\\n-            .any(|entry| decision_versions.get(\u0026entry.package).copied() != Some(\u0026release.version))\\n+            .any(|entry| {\\n+                decision_versions\\n+                    .get(\u0026entry.package)\\n+                    .is_none_or(|version| version.render() != release.