lt":{"stdout":"1280-// A shape no generated workflow covers skips the question with a note that\n1281-// also lands in InitReport.diagnostics for a --format json caller.\n1282-#[test]\n1283:fn unsupported_workspace_skips_workflow_generation_with_a_json_diagnostic() {\n1284-    let dir = platform_workspace_without_napi_targets();\n1285-    let out = Shared::default();\n1286-    let err = Shared::default();\n1287-    run(\n1288-        InitArgs::default(),\n1289-        &global(dir.path(), OutputFormat::Json, false),\n1290-        true,\n1291-        &mut Scripted::new(vec![Answer::Select(0), Answer::Confirm(true)], &out),\n1292-        &mut out.clone(),\n1293-        &mut err.clone(),\n1294-        &CliCommandRunner,\n1295-    )\n1296-    .unwrap();\n1297-    assert!(\n1298-        err.text().contains(\"Skipping GitHub Actions workflow generation\"),\n1299-        \"{}\",\n1300-        err.text()\n1301-    );\n1302-    let report: serde_json::Value = serde_json::from_str(&out.text()).unwrap();\n1303-    let diagnostics = report[\"diagnostics\"].as_array().unwrap();\n1304-    assert_eq!(diagnostics.len(), 1, \"{report}\");\n1305-    assert_eq!(diagnostics[0][\"code\"], \"workflow-generation-unsupported\");\n1306-    assert_eq!(diagnostics[0][\"severity\"], \"warning\");\n1307-    assert!(\n1308-        diagnostics[0][\"message\"].as_str().unwrap().contains(\"napi.targets\"),\n1309-        \"{report}\"\n1310-    );\n1311-    assert!(!dir.path().join(\".github/workflows/callisto-release.yml\").exists());\n1312-}\n1313-\n1314-// Passing --workflow for a shape no generated workflow covers errors, naming why.\n1315-#[test]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"dangerouslyDisableSandbox":true},"classifierBoundary":true,"serverClassifierContext":{"request":"747987a9-dbc0-4cc5-ac65-6035ca687786","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a66cc14c58c4599d3","root":"/Users/gabe/Projects/callisto/.cla