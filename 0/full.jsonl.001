pm_workspace, declares_python_workspace};\n+pub(crate) use membership::{declares_npm_workspace, declares_python_workspace, is_private_workspace_root};\n pub use root::find_workspace_root;\n \n pub trait ProjectLocator: Send + Sync {\ndiff --git a/crates/callisto-graph/src/walk.rs b/crates/callisto-graph/src/walk.rs\nindex b64515df1..f6696ac46 100644\n--- a/crates/callisto-graph/src/walk.rs\n+++ b/crates/callisto-graph/src/walk.rs\n@@ -147,7 +147,7 @@ impl ManifestWalkResolver {\n         let ctx = OpenContext::for_workspace_root(root)?;\n         let mut diagnostics = Vec::new();\n \n-        let discovered = discover(root, locator, manifest_cache, &ctx, &mut diagnostics)?;\n+        let discovered = discover(root, locator, cfg, manifest_cache, &ctx, &mut diagnostics)?;\n         let Identified {\n             package_manifest_decls,\n             index,\n@@ -195,11 +195,29 @@ struct Identified {\n fn discover<L: ProjectLocator>(\n     root: &Path,\n     locator: &L,\n+    cfg: &ResolvedConfig,\n     manifest_cache: &RefCell<BTreeMap<PathBuf, Arc<dyn Manifest>>>,\n     ctx: &OpenContext<'_>,\n     diagnostics: &mut Vec<Diagnostic>,\n ) -> Result<Discovered, GraphError> {\n-    let (projects, platform_candidates) = locator.projects_and_platform_candidates()?;\n+    let (located, platform_candidates) = locator.projects_and_platform_candidates()?;\n+\n+    // A private npm workspace root only holds scripts and tooling; a `[[package]]` block makes it a package.\n+    let mut projects = Vec::with_capacity(located.len());\n+    for proj in located {\n+        if proj.ecosystem == Ecosystem::Npm\n+            && proj.path == Path::new(\".\")\n+            && resolve_package_config(&[(Ecosystem::Npm, proj.id.name())], cfg).is_none()\n+            && crate::locate::is_private_workspace_root(root)?\n+        {\n+            eprintln!(\n+                \"note: ignored private workspace root `npm/{}` (name it in [[package]] to version it)\",\n+                proj.id.name()\n+            );\n+            continue;\n+        }\n+        projects.push(proj);\n+    }\n \n     // The locator already parsed each manifest, so reuse `proj.id`.\n     let mut by_path: BTreeMap<PathBuf, Vec<(Ecosystem, PackageId)>> = BTreeMap::new();\ndiff --git a/docs/specs/workspace.json b/docs/specs/workspace.json\nindex 62eb466a0..6a34fb1f6 100644\n--- a/docs/specs/workspace.json\n+++ b/docs/specs/workspace.json\n@@ -74,7 +74,7 @@\n     },\n     {\n       \"id\": \"WS-DISC-08\",\n-      \"criterion\": \"A hybrid root (root Cargo.toml with both [package] and [workspace], root pyproject.toml with both [project] and [tool.uv.workspace], or a root package.json with a `name`) is always admitted, even when `exclude` matches `.` or the member globs do not. A root package.json that is both `private` and versionless is never discovered as an npm package (it only holds `workspaces`), regardless of admission. A Cargo crate with no `version` (an internal tool such as an xtask) is not discovered as a package and a note names it; a crate that inherits its version with `version.workspace = true` is.\"\n+      \"criterion\": \"A hybrid root (root Cargo.toml with both [package] and [workspace], root pyproject.toml with both [project] and [tool.uv.workspace], or a root package.json with a `name`) is always admitted, even when `exclude` matches `.` or the member globs do not. A root package.json that is both `private` and versionless is never discovered as an npm package (it only holds `workspaces`), regardless of admission. A root package.json that is `private` and declares `workspaces` (or sits beside a pnpm-workspace.yaml with `packages`) is not discovered as an npm package even when it has a version, unless a `[[package]]` block names it, and a note names the skipped root. A Cargo crate with no `version` (an internal tool such as an xtask) is not discovered as a package and a note names it; a crate that inherits its version with `version.workspace = true` is.\"\n     },\n     {\n       \"id\": \"WS-DISC-09\",","is_error":false}]},"uuid":"7aee3bcc-0bf1-4674-ad1a-9bd5c821d6d9","timestamp":"2026-11-10T16:05:38.556Z","toolUseResult":{"stdout":" M crates/callisto-graph/src/locate/membership.rs\n M crates/callisto-graph/src/locate/mod.rs\n M crates/callisto-graph/src/walk.rs\n M docs/specs/workspace.json\n?? crates/callisto-cli/tests/private_workspace_root_tests.rs\ndiff --git a/crates/callisto-graph/src/locate/membership.rs b/crates/callisto-graph/src/locate/membership.rs\nindex cd46f56d5..b186c69ab 100644\n--- a/crates/callisto-graph/src/locate/membership.rs\n+++ b/crates/callisto-graph/src/locate/membership.rs\n@@ -638,6 +638,15 @@ pub(crate) fn declares_npm_workspace(dir: &Path) -> Result<bool, LocateError> {\n     read_npm_membership(dir).map(|membership| membership.globs.is_some())\n }\n \n+/// Whether `dir`'s `package.json` is `private` and holds an npm workspace: a container for scripts and tooling, not a\n+/// release unit.\n+pub(crate) fn is_private_workspace_root(dir: &Path) -> Result<bool, LocateError> {\n+    let Some(content) = read_root_manifest(&dir.join(ManifestFormat::PackageJson.file_name()))? else {\n+        return Ok(false);\n+    };\n+    Ok(callisto_manifests::npm_declares_private(&content) && declares_npm_workspace(dir)?)\n+}\n+\n /// Whether the uv workspace in `dir` is declared (`[tool.uv.workspace]` in its `pyproject.toml`).\n pub(crate) fn declares_python_workspace(dir: &Path) -> Result<bool, LocateError> {\n     read_python_membership(dir).map(|membership| membership.declared)\ndiff --git a/crates/callisto-graph/src/locate/mod.rs b/crates/callisto-graph/src/locate/mod.rs\nindex 342df67a0..b027fa234 100644\n--- a/crates/callisto-graph/src/locate/mod.rs\n+++ b/crates/callisto-graph/src/locate/mod.rs\n@@ -7,7 +7,7 @@ mod membership;\n pub mod root;\n \n pub use ignore_walk::IgnoreWalkLocator;\n-pub(crate) use membership::{declares_npm_workspace, declares_python_workspace};\n+pub(crate) use membership::{declares_npm_workspace, declares_python_workspace, is_private_workspace_root};\n pub use root::find_workspace_root;\n \n pub trait ProjectLocator: Send + Sync {\ndiff --git a/crates/callisto-graph/src/walk.rs b/crates/callisto-graph/src/walk.rs\nindex b64515df1..f6696ac46 100644\n--- a/crates/callisto-graph/src/walk.rs\n+++ b/crates/callisto-graph/src/walk.rs\n@@ -147,7 +147,7 @@ impl ManifestWalkResolver {\n         let ctx = OpenContext::for_workspace_root(root)?;\n         let mut diagnostics = Vec::new();\n \n-        let discovered = discover(root, locator, manifest_cache, &ctx, &mut diagnostics)?;\n+        let discovered = discover(root, locator, cfg, manifest_cache, &ctx, &mut diagnostics)?;\n         let Identified {\n             package_manifest_decls,\n             index,\n@@ -195,11 +195,29 @@ struct Identified {\n fn discover<L: ProjectLocator>(\n     root: &Path,\n     locator: &L,\n+    cfg: &ResolvedConfig,\n     manifest_cache: &RefCell<BTreeMap<PathBuf, Arc<dyn Manifest>>>,\n     ctx: &OpenContext<'_>,\n     diagnostics: &mut Vec<Diagnostic>,\n ) -> Result<Discovered, GraphError> {\n-    let (projects, platform_candidates) = locator.projects_and_platform_candidates()?;\n+    let (located, platform_candidates) = locator.projects_and_platform_candidates()?;\n+\n+    // A private npm workspace root only holds scripts and tooling; a `[[package]]` block makes it a package.\n+    let mut projects = Vec::with_capacity(located.len());\n+    for proj in located {\n+        if proj.ecosystem == Ecosystem::Npm\n+            && proj.path == Path::new(\".\")\n+            && resolve_package_config(&[(Ecosystem::Npm, proj.id.name())], cfg).is_none()\n+            && crate::locate::is_private_workspace_root(root)?\n+        {\n+            eprintln!(\n+                \"note: ignored private workspace root `npm/{}` (name it in [[package]] to version it)\",\n+                proj.id.name()\n+            );\n+            continue;\n+        }\n+        projects.push(proj);\n+    }\n \n     // The locator already parsed each manifest, so reuse `proj.id`.\n     let mut by_path: BTreeMap<PathBuf, Vec<(Ecosystem, PackageId)>> = BTreeMap::new();\ndiff --git a/docs/specs/workspace.json b/docs/specs/workspace.json\nindex 62eb466a0..6a34fb1f6 100644\n--- a/docs/specs/workspace.json\n+++ b/docs/specs/workspace.json\n@@ -74,7 +74,7 @@\n     },\n     {\n       \"id\": \"WS-DISC-08\",\n-      \"criterion\": \"A hybrid root (root Cargo.toml with both [package] and [workspace], root pyproject.toml with both [project] and [tool.uv.workspace], or a root package.json with a `name`) is always admitted, even when `exclude` matches `.` or the member globs do not. A root package.json that is both `private` and versionless is never discovered as an npm package (it only holds `workspaces`), regardless of admission. A Cargo crate with no `version` (an internal tool such as an xtask) is not discovered as a package and a note names it; a crate that inherits its version with `version.workspace = true` is.\"\n+      \"criterion\": \"A hybrid root (root Cargo.toml with both [package] and [workspace], root pyproject.toml with both [project] and [tool.uv.workspace], or a root package.json with a `name`) is always admitted, even when `exclude` matches `.` or the member globs do not. A root package.json that is both `private` and versionless is never discovered as an npm package (it only holds `workspaces`), regardless of admission. A root package.json that is `private` and declares `workspaces` (or sits beside a pnpm-workspace.yaml with `packages`) is not discovered as an npm package even when it has a version, unless a `[[package]]` block names it, and a note names the skipped root. A Cargo crate with no `version` (an internal tool such as an xtask) is not discovered as a package and a note names it; a crate that inherits its version with `version.workspace = true` is.\"\n     },\n     {\n       \"id\": \"WS-DISC-09\",","stderr":"","interrupted":false,"isImage":false