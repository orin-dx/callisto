{"parentUuid":"4d693fbd-3db0-4ea7-ba9c-684f2a1d07ff","isSidechain":false,"promptId":"51bf2e4a-aaab-45ba-a926-376f645f0712","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A3zVcPZDY5D8dM87yKpC3A","type":"tool_result","content":"The file /Users/gabe/Projects/callisto/.claude/worktrees/agent-af481f5a6fc7e809a/docs/errors.md has been updated successfully."}]},"uuid":"a7a23663-31f7-404c-bd80-7fd7b546024d","timestamp":"2026-11-12T07:29:36.979Z","toolUseResult":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-af481f5a6fc7e809a/docs/errors.md","oldString":"| E170 | Release precondition is unmet (e.g. detached HEAD, missing GitHub remote) |","newString":"| E170 | Release precondition is unmet (e.g. detached HEAD, missing GitHub remote, workspace below the repository root) |","originalFile":null,"structuredPatch":[{"oldStart":216,"oldLines":7,"newStart":216,"newLines":7,"lines":[" | E167 | Remote release state (tag, forge release, registry, or artifact) conflicts with this release intent | Either remote state differs from this release intent, or an effect this run made was not visible within a minute. Re-run to adopt a completed effect; if the conflict remains, reconcile the remote state by hand -- this intent's authorization is not in question. |"," | E168 | Release feature/combination is not implemented | This combination is not implemented for release; adjust the release configuration to use a supported combination. |"," | E169 | Release `--package` selection is invalid. A version `callisto snapshot` wrote is never selectable. | Select each package at most once, only packages with a pending release and a publish target, and every unreleased platform package a selected npm package depends on. |","-| E170 | Release precondition is unmet (e.g. detached HEAD, missing GitHub remote) | Satisfy the reported precondition (for example a detached HEAD or a configured GitHub remote) before retrying. |","+| E170 | Release precondition is unmet (e.g. detached HEAD, missing GitHub remote, workspace below the repository root) | Satisfy the reported precondition (for example a detached HEAD or a configured GitHub remote) before retrying. |"," | E171 | Internal release invariant violated | This is an internal callisto defect, not an operator action; report it along with the full error detail. |"," | E339 | A `[registries.<name>]` entry's `kind` does not match the ecosystem of a package that publishes to it (for example `[registries.cratesIo]` with `kind = \"npm\"`) | Set `kind = \"<expected>\"` on `[registries.<registry>]`, or remove the entry to use the built-in registry. No registry was contacted. |"," | E328 | `release pending --from` names a commit that is not a release commit on this branch | Pass a release commit from `callisto release pending` run without `--from`, on this branch's first-parent history. |"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"4d693fbd-3db0-4ea7-ba9c-684f2a1d07ff","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-af481f5a6fc7e809a","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/subdir-workspace-git-paths","slug":"mossy-snacking-stream"}
