entry).expect(\"closed entry serializes\"));\n                }\n            }\n            Ok(Self {\n                intent_digest: intent.digest.clone(),\n                entries,\n                tag_annot\u003ctruncated omitted_approx_tokens=\"442\" /\u003et(\n            \u0026self,\n            intent: \u0026ReleaseIntent,\n            expected: \u0026ObservationExpectations,\n        ) -\u003e Result\u003c(), SuccessorError\u003e {\n            if self.schema_version != Self::SCHEMA_VERSION || self.intent_digest != intent.digest {\n                return Err(SuccessorError::MismatchedObservationIntent);\n            }\n            Self::new(intent, expected, self.operations.clone()).map(|_| ())\n        }\n\n        pub fn schema_version(\u0026self) -\u003e u8 {\n            self.schema_version\n        }\n\n        pub fn intent_digest(\u0026self) -\u003e \u0026IntentDigest {\n            \u0026self.intent_digest\n        }\n\n        pub fn operations(\u0026self) -\u003e \u0026[ObservedOperation] {\n            \u0026self.operations\n        }\n    }\n\n    impl\u003c'de\u003e Deserialize\u003c'de\u003e for CompleteObservationReceipt {\n        fn deserialize\u003cD\u003e(deserializer: D) -\u003e Result\u003cSelf, D::Error\u003e\n        where\n        match exists.exit_code {\n            Some(1) =\u003e return self.create_tag(name.as_str(), target_sha, Some(annotation), sign, permit),\n            Some(0) =\u003e {}\n            _ =\u003e return Err(remote_command_error(\"git show-ref\", \u0026exists)),\n        }\n\n        let object = self.runner.run(\n            \"git\",\n            \u0026[\"--no-replace-objects\", \"cat-file\", \"-p\", \"--\", \u0026reference],\n            \u0026self.root,\n        )?;\n        if !object.success() {\n            return Err(remote_command_error(\"git cat-file\", \u0026object));\n        }\n        let (actual_target, actual_annotation) =\n            parse_annotated_tag_object(\u0026object.stdout).map_err(|_| Vcs