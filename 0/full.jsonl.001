{"parentUuid":"4d0662da-4ba6-4fee-87ab-cc47e1a9f0d4","isSidechain":false,"type":"system","subtype":"stop_hook_summary","hookCount":2,"hookInfos":[{"command":"sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code stop'","durationMs":2634},{"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-stop.sh","durationMs":1980}],"hookErrors":[],"hookAdditionalContext":[],"preventedContinuation":false,"stopReason":"","hasOutput":true,"level":"suggestion","timestamp":"2026-11-12T01:08:56.885Z","uuid":"ced2e3ec-767c-4132-ae26-d28a6c774f72","toolUseID":"2e51cc8d-981f-406a-ac2f-22d75735c052","session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/fix-changeset-list","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"docs/changeset-list-fix","slug":"mossy-snacking-stream"}
