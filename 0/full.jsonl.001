    match global.format {\n        OutputFormat::Json => write_json(&mut std::io::stdout(), &intent)?,\n        OutputFormat::Text => println!(\"Wrote release intent {} to {}\", intent.digest(), args.out.display()),\n    }\n    Ok(ExitCode::SUCCESS)\n}\n\nfn inspect(args: ReleaseIn<truncated omitted_approx_tokens=\"1130\" />          \"intent.json\",\n+            \"--artifact-manifest\",\n+            \"artifacts.json\",\n+            \"--artifact-dir\",\n+            \"dist\",\n+            \"--receipt\",\n+            \"receipt.json\",\n+        ])\n+        .is_ok());\n+        assert!(Cli::try_parse_from([\n+            \"callisto\",\n+            \"release\",\n+            \"reconcile\",\n+            \"--intent\",\n+            \"intent.json\",\n+            \"--artifact-manifest\",\n+            \"artifacts.json\",\n+            \"--artifact-dir\",\n+            \"dist\",\n+        ])\n+        .is_ok());\n+    }\n+\n     /// AC-006/AC-007 (parse slice): `callisto matrix --package foo` parses\n     /// into Command::Matrix with the package field populated; MatrixArgs\n     /// declares no --format of its own (the global flag is used instead).\n  +57 -10\n\ncrates/callisto-cli/src/commands/release.rs\n@@ -1,23 +1,13 @@\n-//! Read-only durable release interfaces.\n-//!\n-//! Planning deliberately accepts only exact package identities. It never\n-//! accepts an inline intent or searches for an authority file. Execution is\n-//! intentionally not wired until the provider adapter can prove exact remote\n-//! identities; exposing a permissive fallback here would recreate the legacy\n-//! publish/tag bypass this command family replaces.\n+//! Durable release interfaces over the graph crate's sealed coordinators.\n \n use std::process::ExitCode;\n \n use callisto_graph::commands::{\n     build_release_intent, derive_release_commit_decision, derive_selected_release_decision,\n-    execute_release_with_artifacts, reconcile_release_execution, validate_release_intent_with_state_directory,\n-    verify_artifact_manifest, ReleaseStateStore, VersionOptions,\n+    execute_release_from_artifacts, reconcile_release_from_artifacts, VersionOptions,\n };\n use callisto_graph::locate::IgnoreWalkLocator;\n-use callisto_model::{\n-    ApplyPermit, ArtifactManifestV1, ExecutionTrustProfileV1, ReleaseExecutionStateV1, ReleaseIntentV1,\n-    ReleasePackageId,\n-};\n\n"},{"type":"input_text","text":"\n[80] tool wait_agent call: {\"timeout_ms\":30000}\n"},{"type":"input_text","text":"\n[81] tool wait_agent result: {\"message\":\"Wait timed out.\",\"timed_out\":true}\n"},{"type":"input_text","text":"\n[82] tool list_agents call: {}\n"},{"type":"input_text","text":"\n[83] tool list_agents result: {\"agents\":[{\"agent_name\":\"/root\",\"agent_status\":\"running\"},{\"agent_name\":\"/root/harden_cutover_model\",\"agent_status\":\"running\"},{\"agent_name\":\"/root/implement_pm4_profiles\",\"agent_status\":\"running\"},{\"agent_name\":\"/root/map_pm4_cutover\",\"agent_status\":\"running\"}]}\n"},{"type":"input_text","text":"\n[84] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"environment:|approval|production\\\" .github/workflows/callisto-release.yml | head -60\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":8000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[85] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\n147:          callisto release plan --profile production --from-release-commit \"$GITHUB_SHA\" --decision .callisto/release-decision.json --out release-intent.json\n207:  production-activation:\n223:    needs: production-activation\n\n"},{"type":"input_text","text":"\n[86] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '185,235p' .github/workflows/callisto-release.yml\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":10000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[87] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\n          (cd .release-handoff && shasum -a 256 -c release-intent.json.sha256)\n          callisto release inspect --input .release-handoff/release-intent.json\n          mkdir -p release-artifacts\n          just build\n      - name: Attest declared binary artifacts\n        if: hashFiles('release-artifacts/**') != ''\n        uses: actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8 # v4.2.2\n        with:\n          subject-path: release-artifacts/**\n      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1\n        with:\n          name: release-build\n          # include-hidden-files: upload-artifact excludes dotfiles by\n          # default, and .release-handoff is one -- without this it silently\n          # uploads nothing and \"execute\" downloads an empty artifact.\n          include-hidden-files: true\n          path: |\n            .release-handoff\n            release-artifacts\n          if-no-files-found: error\n          retention-days: 7\n\n  production-activation:\n    name: Production activation is disabled pending rehearsal evidence\n    needs: build\n    runs-on: ubuntu-latest\n    permissions:\n      contents: read\n    steps:\n      - name: Fail closed until ORCH-008 validates exact-candidate rehearsal evidence\n        shell: bash\n        run: |\n          set -euo pipefail\n          echo '::error::Production release is disabled until ORCH-008 validates exact-candidate rehearsal evidence.'\n          exit 1\n\n  execute:\n    name: Execute approved release\n    needs: production-activation\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n      attestations: read\n      id-token: write\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          ref: ${{ github.sha }}\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: $/.github/actions/setup-callisto\n\n"},{"type":"input_text","text":"\n[88] tool wait_agent call: {\"timeout_ms\":30000}\n"},{"type":"input_text","text":"\n[89] tool wait_agent result: {\"message\":\"Wait timed out.\",\"timed_out\":true}\n"},{"type":"input_text","text":"\n[90] assistant: Completed the model/PM4 and T3 dispatch hardening assigned to this agent.\n\nKey results:\n\n- Native version grammars now survive durable JSON round-trips across decisions, intent slots, operation IDs, manifests, observations, and receipts.\n- Product versions derive order-independently from the common rendered SemVer, including PyPI-only `1.2.3`; PEP 440-only forms such as epochs/prereleases are rejected as product versions.\n- Graph decision derivation reparses versions using each ecosystem’s grammar.\n- Exact-byte Cargo, npm, and PyPI dispatch paths are covered, including staged-byte equality, finite deadlines, canonical npm argv/config, and no PyPI regeneration or `--skip-existing`.\n- The real CLI runner is tested through a loopback HTTP sink to prove exact binary stdin delivery.\n- Found and escalated the missing required `release plan --profile`; it is now explicit and the workflow passes `--profile production`.\n\nVerification:\n\n- `cargo test -p callisto-model`: 189 passed.\n- `cargo test -p callisto-graph --lib`: 402 passed.\n- Direct npm/PyPI dispatch tests: 2 passed.\n- CLI loopback HTTP sink test: passed outside the sandbox; sandbox blocks loopback binding.\n- `just fmt-check`: passed.\n\nImportant anchors:\n\n- Contextual decision decoding: `release.rs:430`\n- Contextual artifact-slot decoding: `release.rs:1431`\n- Contextual operation decoding: `release.rs:1830`\n- Mixed intent/manifest/receipt round-trip: `release.rs:5443`\n- npm exact dispatch regression: `release.rs:1614`\n- PyPI exact dispatch regression: `release.rs:1678`\n- CLI HTTP sink regression: `runner.rs:475`\n\nRemaining shared-tree blockers at handoff:\n\n- Full clippy still reports new graph warnings, chiefly unused internal prepared-view fields explicitly retained for T3/T4 and warnings in concurrently owned observation/execution code.\n- CLI all-target compilation was still blocked by stale V1 references in `durable_release_e2e_tests.rs`; that migration was in progress by the PM4/T5 owner.\n- No commit or push was performed.\n"},{"type":"input_text","text":"\n[91] assistant: I’m removing the obsolete model journal contract now, including its tests and re-exports, while preserving the receipt-based convergence types.\n"},{"type":"input_text","text":"\n[92] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"ReleaseExecutionState|ReleaseOperationState|ReleaseExecutionStateError\\\" crates/callisto-model/src crates/callisto-model/tests crates/callisto-graph/src | head -200\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":20000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[93] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\nrg: crates/callisto-model/tests: No such file or directory (os error 2)\n51 matches in 3 files:\n\ncrates/.../commands/release_store.rs:8:use callisto_model::{atomic::atomic_write, ApplyPermit, ReleaseExecutionState...\ncrates/.../commands/release_store.rs:83:pub fn load(&self, intent: &ReleaseIntent) -> Result<Option<ReleaseExecutionS...\ncrates/.../commands/release_store.rs:94:let state: ReleaseExecutionState =\ncrates/.../commands/release_store.rs:101:.map_err(|source| GraphError::ReleaseExecutionState { source })?;\ncrates/.../commands/release_store.rs:110:) -> Result<ReleaseExecutionState, GraphError> {\ncrates/.../commands/release_store.rs:114:let state = ReleaseExecutionState::pending(intent);\ncrates/.../commands/release_store.rs:123:state: &ReleaseExecutionState,\ncrates/.../commands/release_store.rs:128:.map_err(|source| GraphError::ReleaseExecutionState { source })?;\ncrates/.../commands/r