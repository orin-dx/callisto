{"parentUuid":"f87908ad-3371-4339-b6f5-7b5cf1b03330","isSidechain":false,"promptId":"8c6e2cb1-54ff-490d-a52b-a24351a58ede","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F6aTPSVqg1oM2RgATaVUtT","type":"tool_result","content":"1\tuse std::collections::{BTreeMap, BTreeSet, HashSet};\n2\t\n3\tuse callisto_model::{DepKind, PackageId};\n4\t\n5\tuse crate::error::GraphError;\n6\t\n7\tpub fn toposort_impl<F>(\n8\t    subset: &HashSet<PackageId>,\n9\t    all_packages: &[PackageId],\n10\t    outgoing_edges: F,\n11\t) -> Result<Vec<PackageId>, GraphError>\n12\twhere\n13\t    F: Fn(&PackageId) -> Vec<(PackageId, DepKind)>,\n14\t{\n15\t    let members: BTreeSet<PackageId> = subset.iter().cloned().collect();\n16\t    // Build a HashSet once so validation is O(N) rather than O(N²) slice scans.\n17\t    let all_set: std::collections::HashSet<&PackageId> = all_packages.iter().collect();\n18\t    for id in &members {\n19\t        if !all_set.contains(id) {\n20\t            return Err(GraphError::UnknownPackage { id: id.clone() });\n21\t        }\n22\t    }\n23\t\n24\t    let mut in_degree: BTreeMap<PackageId, usize> = BTreeMap::new();\n25\t    let mut adj: BTreeMap<PackageId, Vec<PackageId>> = BTreeMap::new();\n26\t\n27\t    for u in &members {\n28\t        in_degree.insert(u.clone(), 0);\n29\t        adj.insert(u.clone(), Vec::new());\n30\t    }\n31\t\n32\t    for u in &members {\n33\t        for (v, kind) in outgoing_edges(u) {\n34\t            if members.contains(&v)\n35\t                && matches!(kind, DepKind::Runtime | DepKind::Build | DepKind::Optional)\n36\t            {\n37\t                adj.get_mut(&v).unwrap().push(u.clone());\n38\t                *in_degree.get_mut(u).unwrap() += 1;\n39\t            }\n40\t        }\n41\t    }\n42\t\n43\t    let mut queue: BTreeSet<PackageId> = BTreeSet::new();\n44\t    for (u, &deg) in &in_degree {\n45\t        if deg == 0 {\n46\t            queue.insert(u.clone());\n47\t        }\n48\t    }\n49\t\n50\t    let mut sorted = Vec::new();\n51\t    while let Some(u) = queue.pop_first() {\n52\t        sorted.push(u.clone());\n53\t        if let Some(neighbors) = adj.get(&u) {\n54\t            for v in neighbors {\n55\t                let deg = in_degree.get_mut(v).unwrap();\n56\t                *deg -= 1;\n57\t                if *deg == 0 {\n58\t                    queue.insert(v.clone());\n59\t                }\n60\t            }\n61\t        }\n62\t    }\n63\t\n64\t    if sorted.len() < members.len() {\n65\t        let set: HashSet<PackageId> = sorted.iter().cloned().collect();\n66\t        let remaining: Vec<PackageId> = members.into_iter().filter(|m| !set.contains(m)).collect();\n67\t        let cycle = extract_cycle(&remaining, &adj);\n68\t        return Err(GraphError::Cycle { cycle });\n69\t    }\n70\t\n71\t    Ok(sorted)\n72\t}\n73\t\n74\tfn extract_cycle(\n75\t    remaining: &[PackageId],\n76\t    adj: &BTreeMap<PackageId, Vec<PackageId>>,\n77\t) -> Vec<PackageId> {\n78\t    use petgraph::algo::tarjan_scc;\n79\t    use petgraph::graph::DiGraph;\n80\t\n81\t    let mut graph = DiGraph::<PackageId, ()>::new();\n82\t    let mut node_map = BTreeMap::new();\n83\t    let mut rev_map = BTreeMap::new();\n84\t\n85\t    for pkg in remaining {\n86\t        let idx = graph.add_node(pkg.clone());\n87\t        node_map.insert(pkg.clone(), idx);\n88\t        rev_map.insert(idx, pkg.clone());\n89\t    }\n90\t\n91\t    for u in remaining {\n92\t        if let Some(neighbors) = adj.get(u) {\n93\t            for v in neighbors {\n94\t                if let (Some(&u_idx), Some(&v_idx)) = (node_map.get(u), node_map.get(v)) {\n95\t                    graph.add_edge(u_idx, v_idx, ());\n96\t                }\n97\t            }\n98\t        }\n99\t    }\n100\t\n101\t    let sccs = tarjan_scc(&graph);\n102\t    for scc in sccs {\n103\t        let is_self_loop = scc.len() == 1 && graph.contains_edge(scc[0], scc[0]);\n104\t        if scc.len() > 1 || is_self_loop {\n105\t            let mut cycle = Vec::new();\n106\t            let start_idx = scc[0];\n107\t            let mut curr = start_idx;\n108\t            let scc_set: std::collections::HashSet<_> = scc.iter().copied().collect();\n109\t\n110\t            cycle.push(rev_map[&curr].clone());\n111\t            loop {\n112\t                let mut next_found = None;\n113\t                for neighbor in graph.neighbors(curr) {\n114\t                    if scc_set.contains(&neighbor) {\n115\t                        next_found = Some(neighbor);\n116\t                        break;\n117\t                    }\n118\t                }\n119\t\n120\t                if let Some(next) = next_found {\n121\t                    curr = next;\n122\t                    cycle.push(rev_map[&curr].clone());\n123\t                    if curr == start_idx {\n124\t                        break;\n125\t                    }\n126\t                } else {\n127\t                    break;\n128\t                }\n129\t            }\n130\t\n131\t            if cycle.len() > 1 {\n132\t                return cycle;\n133\t            }\n134\t        }\n135\t    }\n136\t\n137\t    remaining.to_vec()\n138\t}\n139\t\n140\t#[cfg(test)]\n141\tmod tests {\n142\t    use super::*;\n143\t\n144\t    #[test]\n145\t    fn test_toposort_linear() {\n146\t        let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n147\t        let pkg_b = PackageId::parse(\"pkg-b\").unwrap();\n148\t\n149\t        let subset: HashSet<_> = vec![pkg_a.clone(), pkg_b.clone()].into_iter().collect();\n150\t        let all = vec![pkg_a.clone(), pkg_b.clone()];\n151\t\n152\t        let res = toposort_impl(&subset, &all, |id| {\n153\t            if id == &pkg_a {\n154\t                vec![(pkg_b.clone(), DepKind::Runtime)]\n155\t            } else {\n156\t                vec![]\n157\t            }\n158\t        })\n159\t        .unwrap();\n160\t\n161\t        assert_eq!(res, vec![pkg_b, pkg_a]);\n162\t    }\n163\t\n164\t    #[test]\n165\t    fn test_toposort_produces_correct_order_large_graph() {\n166\t        // Build a 10-package chain: pkg-a -> pkg-b -> ... -> pkg-i -> pkg-j\n167\t        // Each package depends on the next; pkg-j is the leaf with no dependencies.\n168\t        // Expected toposort order (dependencies first): [pkg-j, pkg-i, ..., pkg-a]\n169\t        let ids: Vec<PackageId> = (b'a'..=b'j')\n170\t            .map(|c| PackageId::parse(&format!(\"pkg-{}\", c as char)).unwrap())\n171\t            .collect();\n172\t\n173\t        let subset: HashSet<PackageId> = ids.iter().cloned().collect();\n174\t        let all: Vec<PackageId> = ids.clone();\n175\t\n176\t        let result = toposort_impl(&subset, &all, |id| {\n177\t            // Find the index of this package; if it's not the last, it depends on the next.\n178\t            if let Some(pos) = ids.iter().position(|x| x == id) {\n179\t                if pos + 1 < ids.len() {\n180\t                    return vec![(ids[pos + 1].clone(), DepKind::Runtime)];\n181\t                }\n182\t            }\n183\t            vec![]\n184\t        })\n185\t        .unwrap();\n186\t\n187\t        // pkg-j has no dependents so it sorts first; pkg-a sorts last.\n188\t        let expected: Vec<PackageId> = ids.iter().cloned().rev().collect();\n189\t        assert_eq!(result, expected);\n190\t    }\n191\t\n192\t    #[test]\n193\t    fn test_toposort_self_loop_cycle() {\n194\t        let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n195\t        let subset: HashSet<_> = vec![pkg_a.clone()].into_iter().collect();\n196\t        let all = vec![pkg_a.clone()];\n197\t\n198\t        let err = toposort_impl(&subset, &all, |id| {\n199\t            if id == &pkg_a {\n200\t                vec![(pkg_a.clone(), DepKind::Runtime)]\n201\t            } else {\n202\t                vec![]\n203\t            }\n204\t        })\n205\t        .unwrap_err();\n206\t\n207\t        if let GraphError::Cycle { cycle } = err {\n208\t            assert_eq!(cycle, vec![pkg_a.clone(), pkg_a]);\n209\t        } else {\n210\t            panic!(\"expected Cycle error\");\n211\t        }\n212\t    }\n213\t}\n214\t"}]},"uuid":"889e769a-a1e9-4d6b-86ac-9dd255e99359","timestamp":"2026-08-22T16:38:30.936Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/toposort.rs","content":"use std::collections::{BTreeMap, BTreeSet, HashSet};\n\nuse callisto_model::{DepKind, PackageId};\n\nuse crate::error::GraphError;\n\npub fn toposort_impl<F>(\n    subset: &HashSet<PackageId>,\n    all_packages: &[PackageId],\n    outgoing_edges: F,\n) -> Result<Vec<PackageId>, GraphError>\nwhere\n    F: Fn(&PackageId) -> Vec<(PackageId, DepKind)>,\n{\n    let members: BTreeSet<PackageId> = subset.iter().cloned().collect();\n    // Build a HashSet once so validation is O(N) rather than O(N²) slice scans.\n    let all_set: std::collections::HashSet<&PackageId> = all_packages.iter().collect();\n    for id in &members {\n        if !all_set.contains(id) {\n            return Err(GraphError::UnknownPackage { id: id.clone() });\n        }\n    }\n\n    let mut in_degree: BTreeMap<PackageId, usize> = BTreeMap::new();\n    let mut adj: BTreeMap<PackageId, Vec<PackageId>> = BTreeMap::new();\n\n    for u in &members {\n        in_degree.insert(u.clone(), 0);\n        adj.insert(u.clone(), Vec::new());\n    }\n\n    for u in &members {\n        for (v, kind) in outgoing_edges(u) {\n            if members.contains(&v)\n                && matches!(kind, DepKind::Runtime | DepKind::Build | DepKind::Optional)\n            {\n                adj.get_mut(&v).unwrap().push(u.clone());\n                *in_degree.get_mut(u).unwrap() += 1;\n            }\n        }\n    }\n\n    let mut queue: BTreeSet<PackageId> = BTreeSet::new();\n    for (u, &deg) in &in_degree {\n        if deg == 0 {\n            queue.insert(u.clone());\n        }\n    }\n\n    let mut sorted = Vec::new();\n    while let Some(u) = queue.pop_first() {\n        sorted.push(u.clone());\n        if let Some(neighbors) = adj.get(&u) {\n            for v in neighbors {\n                let deg = in_degree.get_mut(v).unwrap();\n                *deg -= 1;\n                if *deg == 0 {\n                    queue.insert(v.clone());\n                }\n            }\n        }\n    }\n\n    if sorted.len() < members.len() {\n        let set: HashSet<PackageId> = sorted.iter().cloned().collect();\n        let remaining: Vec<PackageId> = members.into_iter().filter(|m| !set.contains(m)).collect();\n        let cycle = extract_cycle(&remaining, &adj);\n        return Err(GraphError::Cycle { cycle });\n    }\n\n    Ok(sorted)\n}\n\nfn extract_cycle(\n    remaining: &[PackageId],\n    adj: &BTreeMap<PackageId, Vec<PackageId>>,\n) -> Vec<PackageId> {\n    use petgraph::algo::tarjan_scc;\n    use petgraph::graph::DiGraph;\n\n    let mut graph = DiGraph::<PackageId, ()>::new();\n    let mut node_map = BTreeMap::new();\n    let mut rev_map = BTreeMap::new();\n\n    for pkg in remaining {\n        let idx = graph.add_node(pkg.clone());\n        node_map.insert(pkg.clone(), idx);\n        rev_map.insert(idx, pkg.clone());\n    }\n\n    for u in remaining {\n        if let Some(neighbors) = adj.get(u) {\n            for v in neighbors {\n                if let (Some(&u_idx), Some(&v_idx)) = (node_map.get(u), node_map.get(v)) {\n                    graph.add_edge(u_idx, v_idx, ());\n                }\n            }\n        }\n    }\n\n    let sccs = tarjan_scc(&graph);\n    for scc in sccs {\n        let is_self_loop = scc.len() == 1 && graph.contains_edge(scc[0], scc[0]);\n        if scc.len() > 1 || is_self_loop {\n            let mut cycle = Vec::new();\n            let start_idx = scc[0];\n            let mut curr = start_idx;\n            let scc_set: std::collections::HashSet<_> = scc.iter().copied().collect();\n\n            cycle.push(rev_map[&curr].clone());\n            loop {\n                let mut next_found = None;\n                for neighbor in graph.neighbors(curr) {\n                    if scc_set.contains(&neighbor) {\n                        next_found = Some(neighbor);\n                        break;\n                    }\n                }\n\n                if let Some(next) = next_found {\n                    curr = next;\n                    cycle.push(rev_map[&curr].clone());\n                    if curr == start_idx {\n                        break;\n                    }\n                } else {\n                    break;\n                }\n            }\n\n            if cycle.len() > 1 {\n                return cycle;\n            }\n        }\n    }\n\n    remaining.to_vec()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn test_toposort_linear() {\n        let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n        let pkg_b = PackageId::parse(\"pkg-b\").unwrap();\n\n        let subset: HashSet<_> = vec![pkg_a.clone(), pkg_b.clone()].into_iter().collect();\n        let all = vec![pkg_a.clone(), pkg_b.clone()];\n\n        let res = toposort_impl(&subset, &all, |id| {\n            if id == &pkg_a {\n                vec![(pkg_b.clone(), DepKind::Runtime)]\n            } else {\n                vec![]\n            }\n        })\n        .unwrap();\n\n        assert_eq!(res, vec![pkg_b, pkg_a]);\n    }\n\n    #[test]\n    fn test_toposort_produces_correct_order_large_graph() {\n        // Build a 10-package chain: pkg-a -> pkg-b -> ... -> pkg-i -> pkg-j\n        // Each package depends on the next; pkg-j is the leaf with no dependencies.\n        // Expected toposort order (dependencies first): [pkg-j, pkg-i, ..., pkg-a]\n        let ids: Vec<PackageId> = (b'a'..=b'j')\n            .map(|c| PackageId::parse(&format!(\"pkg-{}\", c as char)).unwrap())\n            .collect();\n\n        let subset: HashSet<PackageId> = ids.iter().cloned().collect();\n        let all: Vec<PackageId> = ids.clone();\n\n        let result = toposort_impl(&subset, &all, |id| {\n            // Find the index of this package; if it's not the last, it depends on the next.\n            if let Some(pos) = ids.iter().position(|x| x == id) {\n                if pos + 1 < ids.len() {\n                    return vec![(ids[pos + 1].clone(), DepKind::Runtime)];\n                }\n            }\n            vec![]\n        })\n        .unwrap();\n\n        // pkg-j has no dependents so it sorts first; pkg-a sorts last.\n        let expected: Vec<PackageId> = ids.iter().cloned().rev().collect();\n        assert_eq!(result, expected);\n    }\n\n    #[test]\n    fn test_toposort_self_loop_cycle() {\n        let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n        let subset: HashSet<_> = vec![pkg_a.clone()].into_iter().collect();\n        let all = vec![pkg_a.clone()];\n\n        let err = toposort_impl(&subset, &all, |id| {\n            if id == &pkg_a {\n                vec![(pkg_a.clone(), DepKind::Runtime)]\n            } else {\n                vec![]\n            }\n        })\n        .unwrap_err();\n\n        if let GraphError::Cycle { cycle } = err {\n            assert_eq!(cycle, vec![pkg_a.clone(), pkg_a]);\n        } else {\n            panic!(\"expected Cycle error\");\n        }\n    }\n}\n","numLines":214,"startLine":1,"totalLines":214}},"sourceToolAssistantUUID":"f87908ad-3371-4339-b6f5-7b5cf1b03330","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"flatten-changelog-severity-grouping","slug":"shimmying-giggling-hickey"}
