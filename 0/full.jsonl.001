app_manifest}\"\n    );\n    assert!(\n        !dep_app_manifest.contains(\"\\\"^1.0.0\\\"\"),\n        \"dep-app's dependency spec on my-native-lib must have been rewritten away from the now out-of-range \\\"^1.0.0\\\"; got:\\n{dep_app_manifest}\"\n    );\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"4116aa59-6927-4d25-bff7-a3779c316faf","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
