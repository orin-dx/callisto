nds\nOutput:\n\n\n/// Credential-free, canonical registry routing. `endpoint` is populated only\n/// after parsing rejects userinfo, query, and fragments, so a later executor\n/// cannot recover credentials from this capability.\n#[allow(dead_code)] // consumed by the durable executor batch\n#[derive(Clone, Debug, PartialEq, Eq)]\nstruct PreparedRegistryBinding {\n    key: RegistryKey,\n    endpoints: PreparedRegistryEndpoints,\n    identity: RegistryBindingDigest,\n    credential: PreparedCredentialEnvPolicy,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\nenum PreparedCredentialEnvPolicy {\n    CargoToken {\n        env_name: String,\n    },\n    NpmToken {\n        env_name: &'static str,\n    },\n    PypiToken {\n        password_env_name: &'static str,\n        username: &'static str,\n    },\n}\n\n#[allow(dead_code)]\n#[derive(Clone, Debug, PartialEq, Eq)]\nenum PreparedRegistryEndpoints {\n    Cargo {\n        index: String,\n        api: String,\n    },\n    Npm {\n        registry: String,\n    },\n    Pypi {\n        upload: String,\n        metadata: String,\n        simple: String,\n    },\n}\n\n/// Read-only, graph-internal view of typed, credential-free registry routing.\n#[derive(Clone, Copy, Debug)]\npub(super) enum PreparedRegistryEndpointsView<'a> {\n    Cargo {\n        index: &'a str,\n        api: &'a str,\n    },\n    Npm {\n        registry: &'a str,\n    },\n    Pypi {\n        upload: &'a str,\n        metadata: &'a str,\n        simple: &'a str,\n    },\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub(super) enum PreparedCredentialEnvPolicyView<'a> {\n    CargoToken {\n        env_name: &'a str,\n    },\n    NpmToken {\n        env_name: &'static str,\n    },\n    PypiToken {\n        password_env_name: &'static str,\n        username: &'static str,\n    },\n}\n\n/// The exact prepared capability paired with one immutable operation.\n///\n/// This view is crate-private and non-serializable. It exposes only canonical,\n/// credential-fr