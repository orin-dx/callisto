dencies]` included\n/// — resolvable from the registry. A dev-dependency on a workspace sibling\n/// published in the same batch therefore still needs that sibling to\n/// publish first, or the verification build can fail with an unresolvable\n/// version requirement even though the two crates have no real ordering\n/// constraint between them otherwise. This function does not yet account\n/// for that (tracked separately) — it currently reuses the same\n/// cascade-scoped edge filter `toposort_impl` already applies.\nfn publish_order<D: DependencyResolver + ?Sized>(\n    resolver: &D,\n    subset: &HashSet<PackageId>,\n) -> Result<Vec<PackageId>, GraphError> {\n    let all_pkg_ids: Vec<PackageId> = resolver.packages().map(|p| p.id.clone()).collect();\n    toposort_impl(subset, &all_pkg_ids, |id| {\n        resolver\n            .dependencies_of(id)\n            .map(|e| (e.to.clone(), e.kind))\n            .collect()\n    })\n}","newString":"use std::collections::HashSet;\n\nuse callisto_model::{\n    CommandRunner, CratePublish, DepKind, NpmMainPublish, PackageId, PublishPlan, PublishTarget,\n    PypiPublish, RegistryKey, ReleaseEntry, SCHEMA_VERSION,\n};\nuse callisto_vcs::GitDataSource;\n\nuse crate::error::GraphError;\nuse crate::resolver::DependencyResolver;\nuse crate::toposort::toposort_impl;\nuse crate::Workspace;\n\n/// Edge kinds cascade/version-bump propagation cares about: a `Dev`-only\n/// dependency change correctly never forces a consumer's version to bump.\nconst CASCADE_ORDERING_KINDS: &[DepKind] = &[DepKind::Runtime, DepKind::Build, DepKind::Optional];\n\n/// Edge kinds publish ordering cares about: cascade's kinds, plus `Dev`.\n/// `cargo publish` (run without `--no-verify`, see `publish_client.rs`)\n/// re-extracts the packaged tarball and does a real local build to verify\n/// it, which needs *every* dependency in the crate's `Cargo.toml` —\n/// `[dev-dependencies]` included — resolvable from the registry. A\n/// dev-dependency on a workspace sibling published in the same batch\n/// therefore still needs that sibling to publish first, even though the\n/// two crates have no cascade-relevant ordering constraint between them.\nconst PUBLISH_ORDERING_KINDS: &[DepKind] = &[\n    DepKind::Runtime,\n    DepKind::Build,\n    DepKind::Optional,\n    DepKind::Dev,\n];\n\n/// Computes the order packages must be published in.\n///\n/// This is a thin, purpose-named wrapper around [`toposort_impl`] (the\n/// generic algorithm, reused as-is) rather than a generic\n/// `DependencyResolverExt::toposort()` on a shared trait — it exists\n/// specifically for `plan_publish` below, its only caller, and its\n/// semantics are publish-specific, not \"the one true topological sort.\"\n///\n/// Tries [`PUBLISH_ORDERING_KINDS`] first (including `Dev`, unlike cascade's\n/// own [`CASCADE_ORDERING_KINDS`]) so a dev-dependency on a same-batch\n/// sibling publishes in the right order. `Dev` edges are best-effort, not a\n/// hard requirement, precisely because mutual dev-only dependencies between\n/// two otherwise-unrelated packages are a legitimate pattern (e.g. two\n/// crates each dev-depending on the other for cross-integration tests) —\n/// unlike `Runtime`/`Build`/`Optional`, which must never cycle, a `Dev`\n/// cycle must not hard-fail the whole publish plan. If including `Dev`\n/// edges would produce a cycle, this falls back to\n/// [`CASCADE_ORDERING_KINDS`] alone, which is guaranteed not to introduce a\n/// *new* cycle here since it is a strict subset of the edges just proven\n/// cyclic — accepting the original race this function exists to close for\n/// that one pair, rather than failing the entire plan over it.\nfn publish_order<D: DependencyResolver + ?Sized>(\n    resolver: &D,\n    subset: &HashSet<PackageId>,\n) -> Result<Vec<PackageId>, GraphError> {\n    let all_pkg_ids: Vec<PackageId> = resolver.packages().map(|p| p.id.clone()).collect();\n    let edges_of = |id: &PackageId| -> Vec<(PackageId, DepKind)> {\n        resolver\n            .dependencies_of(id)\n            .map(|e| (e.to.clone(), e.kind))\n            .collect()\n    };\n\n    match toposort_impl(subset, &all_pkg_ids, PUBLISH_ORDERING_KINDS, edges_of) {\n        Ok(order) => Ok(order),\n        Err(GraphError::Cycle { .. }) => {\n            toposort_impl(subset, &all_pkg_ids, CASCADE_ORDERING_KINDS, edges_of)\n        }\n        Err(e) => Err(e),\n    }\n}","originalFile":null,"structuredPatch":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":7,"lines":[" use std::collections::HashSet;"," "," use callisto_model::{","-    CommandRunner, CratePublish, NpmMainPublish, PackageId, PublishPlan, PublishTarget,","+    CommandRunner, CratePublish, DepKind, NpmMainPublish, PackageId, PublishPlan, PublishTarget,","     PypiPublish, RegistryKey, ReleaseEntry, SCHEMA_VERSION,"," };"," use callisto_vcs::GitDataSource;"]},{"oldStart":11,"oldLines":6,"newStart":11,"newLines":25,"lines":[" use crate::toposort::toposort_impl;"," use crate::Workspace;"," ","+/// Edge kinds cascade/version-bump propagation cares about: a `Dev`-only","+/// dependency change correctly never forces a consumer's version to bump.","+const CASCADE_ORDERING_KINDS: &[DepKind] = &[DepKind::Runtime, DepKind::Build, DepKind::Optional];","+","+/// Edge kinds publish ordering cares about: cascade's kinds, plus `Dev`.","+/// `cargo publish` (run without `--no-verify`, see `publish_client.rs`)","+/// re-extracts the packaged tarball and does a real local build to verify","+/// it, which needs *every* dependency in the crate's `Cargo.toml` —","+/// `[dev-dependencies]` included — resolvable from the registry. A","+/// dev-dependency on a workspace sibling published in the same batch","+/// therefore still needs that sibling to publish first, even though the","+/// two crates have no cascade-relevant ordering constraint between them.","+const PUBLISH_ORDERING_KINDS: &[DepKind] = &[","+    DepKind::Runtime,","+    DepKind::Build,","+    DepKind::Optional,","+    DepKind::Dev,","+];","+"," /// Computes the order packages must be published in."," ///"," /// This is a thin, purpose-named wrapper around [`toposort_impl`] (the"]},{"oldStart":19,"oldLines":32,"newStart":38,"newLines":38,"lines":[" /// specifically for `plan_publish` below, its only caller, and its"," /// semantics are publish-specific, not \"the one true topological sort.\""," ///","-/// `toposort_impl` currently only treats `Runtime`/`Build`/`Optional`","-/// edges as ordering constraints, which matches cascade/version-bump","-/// propagation's own scope (a `Dev`-only dependency change correctly","-/// doesn't force a consumer's version to bump). For *publish* ordering","-/// specifically that scope is too narrow: `cargo publish` (run without","-/// `--no-verify`, see `publish_client.rs`) re-extracts the packaged","-/// tarball and does a real local build to verify it, which needs *every*","-/// dependency in the crate's `Cargo.toml` — `[dev-dependencies]` included","-/// — resolvable from the registry. A dev-dependency on a workspace sibling","-/// published in the same batch therefore still needs that sibling to","-/// publish first, or the verification build can fail with an unresolvable","-/// version requirement even though the two crates have no real ordering","-/// constraint between them otherwise. This function does not yet account","-/// for that (tracked separately) — it currently reuses the same","-/// cascade-scoped edge filter `toposort_impl` already applies.","+/// Tries [`PUBLISH_ORDERING_KINDS`] first (including `Dev`, unlike cascade's","+/// own [`CASCADE_ORDERING_KINDS`]) so a dev-dependency on a same-batch","+/// sibling publishes in the right order. `Dev` edges are best-effort, not a","+/// hard requirement, precisely because mutual dev-only dependencies between","+/// two otherwise-unrelated packages are a legitimate pattern (e.g. two","+/// crates each dev-depending on the other for cross-integration tests) —","+/// unlike `Runtime`/`B