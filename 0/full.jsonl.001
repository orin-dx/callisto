ng to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(pre)\n_arguments \"${_arguments_options[@]}\" : \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n\":: :_callisto__subcmd__pre_commands\" \\\n\"*::: :->pre\" \\\n&& ret=0\n\n    case $state in\n    (pre)\n        words=($line[1] \"${words[@]}\")\n        (( CURRENT += 1 ))\n        curcontext=\"${curcontext%:*:*}:callisto-pre-command-$line[1]:\"\n        case $line[1] in\n            (enter)\n_arguments \"${_arguments_options[@]}\" : \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n':tag:_default' \\\n&& ret=0\n;;\n(exit)\n_arguments \"${_arguments_options[@]}\" : \\\n'--format=[Output format for command results]:FORMAT:(text json)' \\\n'--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n'--dry-run[Preview manifest and file changes without writing to disk]' \\\n'-h[Print help]' \\\n'--help[Print help]' \\\n&& ret=0\n;;\n(help)\n_arguments \"${_arguments_options[@]}\" : \\\n\":: :_callisto__subcmd__pre__subcmd__help_commands\" \\\n\"*::: :->help\" \\\n&& ret=0\n\n    case $state in\n    (help)\n        words=($line[1] \"${words[@]}\")\n        (( CURRENT += 1 ))\n        curcontext=\"${curcontext%:*:*}:callisto-pre-help-command-$line[1]:\"\n        case $line[1] in\n            (enter)\n_arguments \"${_arguments_options[@]}\" : \\\n&& ret=0\n;;\n(exit)\n_arguments \"${_arguments_options[@]}\" : \\\n&& ret=0\n;;\n(help)\n_arguments \"${_arguments_options[@]}\" : \\\n&& ret=0\n;