{"parentUuid":"cc0c81de-83ec-4b09-9cfb-7b3c3ead3a94","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011CgFxGAEM7Ko9PuAZ4hwx7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JGuc89CcbWG5uruvTjU69R","name":"Write","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/dist-tag-snapshot/.changeset/prerelease-dist-tag-snapshot-refusal.md","content":"---\ncallisto-cli: minor\n---\n\nnpm prereleases now publish under the tag their version names: `1.0.0-beta.2` goes to `beta`, `2.0.0-rc.1` to `rc`, and `next` remains the fallback, instead of every prerelease landing on `next`. `release` now refuses a version that `callisto snapshot` wrote (E169), so a snapshot is never tagged or published.\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":770,"cache_read_input_tokens":440798,"output_tokens":542,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":770,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":542,"cache_read_input_tokens":440798,"cache_creation_input_tokens":770,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":770},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01JGuc89CcbWG5uruvTjU69R":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/dist-tag-snapshot/.changeset/prerelease-dist-tag-snapshot-refusal.md","content":"---\ncallisto-cli: minor\n---\n\nnpm prereleases now publish under the tag their version names: `1.0.0-beta.2` goes to `beta`, `2.0.0-rc.1` to `rc`, and `next` remains the fallback, instead of every prerelease landing on `next`. `relea