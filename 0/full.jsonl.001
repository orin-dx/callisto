md\"), \"# Changelog\\n\\n## 1.2.2\\n\").unwrap();\n        }\n        std::fs::create_dir_all(root.join(\".changeset\")).unwrap();\n        std::fs::write(\n            root.join(\".changeset/release.md\"),\n            \"---\\ncargo/release-fixture: patch\\nnpm/release-fixture: patch\\npypi/release-fixture: patch\\n---\\n\\nRelease fixture.\\n\",\n        )\n        .unwrap();\n        run_git(root, \u0026[\"add\", \".\"]);\n        run_git(root, \u0026[\"commit\", \"-q\", \"-m\", \"base\"]);\n\n        std::fs::write(\n            root.join(\"cargo/Cargo.toml\"),\n            \"[package]\\nname = \\\"release-fixture\\\"\\nversion = \\\"1.2.3\\\"\\nedition = \\\"2021\\\"\\n\",\n        )\n        .unwrap();\n        std::fs::remove_file(root.join(\".changeset/release.md\")).unwrap();\n        std::fs::write(\n            root.join(\"npm/package.json\"),\n            r#\"{\"name\":\"release-fixture\",\"version\":\"1.2.3\"}\"#,\n        )\n        .unwrap();\n        std::fs::write(\n            root.join(\"pypi/pyproject.toml\"),\n            \"[project]\\nname = \\\"release-fixture\\\"\\nversion = \\\"1.2.3\\\"\\n\",\n        )\n        .unwrap();\n        for directory in [\"cargo\", \"npm\", \"pypi\"] {\n            std::fs::write(\n                root.join(directory).join(\"CHANGELOG.md\"),\n                \"# Changelog\\n\\n## 1.2.3\\n\\nRelease fixture.\\n\\n## 1.2.2\\n\",\n            )\n            .unwrap();\n        }\n        std::fs::create_dir_all(root.join(\".callisto\")).unwrap();\n        std::fs::write(\n            root.join(super::super::release_decision::CANONICAL_RELEASE_DECISION_PATH),\n            serde_json::to_vec(\u0026decision).unwrap(),\n        )\n        .unwrap();\n        run_git(root, \u0026[\"add\", \"-A\"]);\n        run_git(root, \u0026[\"commit\", \"-q\", \"-m\", \"release\"]);\n        run_git(root, \u0026[\"checkout\", \"--detach\", \"-q\", \"HEAD\"]);\n        (directory, decision)\n    }\n\n    fn slot_bytes(slot: \u0026Re