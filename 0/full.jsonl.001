-action to the same commit in the linters composite action`) and push to that Dependabot branch: `git push origin HEAD:dependabot/github_actions/routine-actions-ef6b953f05`. Check that also `grep -rn 'uses:.*@' .github/actions` shows no other action pinned to a different commit than the workflows use.\nTASK 2 (separate branch off origin/main, `ci/dependabot-composite-actions`): edit `.github/dependabot.yml` so the github-actions ecosystem also updates the composite actions under `.github/actions/` (documented GitHub syntax: `directories:` list with `/` and `/.github/actions/*`; keep the existing groups, schedule and labels). Keep the diff minimal. Verify with the verify script, push `git push -u origin ci/dependabot-composite-actions`.\nTASK 3 (read-only): Dependabot PR #517 (`dependabot/cargo/routine-crates-db76e0ed47`): `gh pr checks 517` and `gh run view <run> --log-failed` for any failing job; report why it fails (do not fix).\nREPORT (under 150 words): both pushed commits (signed?), workflow-contracts exit, any other mismatched pins, #517 failure cause."},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":49,"cache_read_input_tokens":432317,"output_tokens":8580,"output_tokens_details":{"thinking_tokens":2322},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":49,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":8580,"cache_read_input_tokens":432317,"cache_creation_input_tokens":49,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":49},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Lan4aXLYazJKyRoryodCgR":{"description":"Dependabot pin fix and config","subagent_type":"ge