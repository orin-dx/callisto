{"parentUuid":"2bd7c05b-9741-4e7e-8aa9-2b1fe15c9964","isSidechain":false,"promptId":"dc0d202e-5626-4519-a868-de7dad954fe3","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TDiW15BfpgCEczu8tYobCS","type":"tool_result","content":"commit f9cf4917d238f58009e05ffad3e61fefdd7b31e5\nAuthor: Gabe Castro <gabe@techworx.dev>\nDate:   Sat Aug 8 10:38:14 2026 +0100\n\n    fix(format): exclude pre-release versions from caret range coverage\n    \n    caret_covers(cur, new) was returning true when `new` had the same major\n    version as `cur` but carried a pre-release suffix (e.g., 1.9.0-alpha.1).\n    This meant that ^1.2.3 would incorrectly satisfy 1.9.0-alpha.1, which\n    violates the SemVer/Cargo/npm convention that caret ranges cover only\n    stable releases within the permitted major/minor bounds.\n    \n    Fix: add an early-return for new.is_prerelease() after the < check so\n    that any pre-release candidate is unconditionally excluded from coverage.\n    Stable versions within the same major continue to be covered as before.\n    \n    Claude-Session: https://claude.ai/code/session_01NSixbn1hHH7WLXGqzF3GCz\n\ndiff --git a/crates/callisto-graph/src/cascade.rs b/crates/callisto-graph/src/cascade.rs\nindex 7fb0b529..135e7a38 100644\n--- a/crates/callisto-graph/src/cascade.rs\n+++ b/crates/callisto-graph/src/cascade.rs\n@@ -109,6 +109,14 @@ pub(crate) fn caret_covers(cur: &Version, new: &Version) -> Result<bool, Grammar\n     if cmp.is_lt() {\n         return Ok(false);\n     }\n+    // Pre-release versions are never covered by a caret range: ^1.2.3 must not\n+    // satisfy 1.9.0-alpha.1 even though 1.9.0-alpha.1 > 1.2.3 and they share\n+    // the same major. Caret ranges cover stable releases within the allowed\n+    // major/minor bounds only; a pre-release of an in-range stable version is\n+    // not itself a stable release and must not be treated as covered.\n+    if new.is_prerelease() {\n+        return Ok(false);\n+    }\n     let cur_maj = cur.major().unwrap_or(0);\n     let cur_min = cur.minor().unwrap_or(0);\n     let new_maj = new.major().unwrap_or(0);\n@@ -513,10 +521,48 @@ pub fn rewrite_spec(\n #[cfg(test)]\n mod tests {\n     use super::*;\n-    use callisto_model::{GroupKind, GroupName, Package, ReleaseTrigger};\n+    use callisto_model::{GroupKind, GroupName, Package, ReleaseTrigger, VersionGrammar};\n \n     use crate::config::{CascadeBumpSeverity, GroupDef, GroupMember};\n \n+    // -------------------------------------------------------------------------\n+    // T06: caret range must not cover pre-release versions\n+    // -------------------------------------------------------------------------\n+\n+    /// Spec: caret_covers(cur, new) must return false when `new` is a pre-release\n+    /// version, regardless of whether the major/minor bounds would otherwise be\n+    /// satisfied. \"^1.2.3\" should not be satisfied by \"1.9.0-alpha.1\" even though\n+    /// 1.9.0-alpha.1 > 1.2.3 and they share the same major version.\n+    #[test]\n+    fn caret_covers_excludes_prerelease_versions() {\n+        let v123 = Version::semver(1, 2, 3);\n+\n+        // Pre-release with same major: must be false even though major matches\n+        let pre_same_major = Version::parse(\"1.9.0-alpha.1\", VersionGrammar::SemVer).unwrap();","is_error":false}]},"uuid":"ffec76bd-7750-468b-a488-5d6b9a61f22b","timestamp":"2026-08-21T22:35:41.660Z","toolUseResult":{"stdout":"commit f9cf4917d238f58009e05ffad3e61fefdd7b31e5\nAuthor: Gabe Castro <gabe@techworx.dev>\nDate:   Sat Aug 8 10:38:14 2026 +0100\n\n    fix(format): exclude pre-release versions from caret range coverage\n    \n    caret_covers(cur, new) was returning true when `new` had the same major\n    version as `cur` but carried a pre-release suffix (e.g., 1.9.0-alpha.1).\n    This meant that ^1.2.3 would incorrectly satisfy 1.9.0-alpha.1, which\n    violates the SemVer/Cargo/npm convention that caret ranges cover only\n    stable releases within the permitted major/minor bounds.\n    \n    Fix: add an early-return for new.is_prerelease() after the < check so\n    that any pre-release candidate is unconditionally excluded from coverage.\n    Stable versions within the same major continue to be covered as before.\n    \n    Claude-Session: https://claude.ai/code/session_01NSixbn1hHH7WLXGqzF3GCz\n\ndiff --git a/crates/callisto-graph/src/cascade.rs b/crates/callisto-graph/src/cascade.rs\nindex 7fb0b529..135e7a38 100644\n--- a/crates/callisto-graph/src/cascade.rs\n+++ b/crates/callisto-graph/src/cascade.rs\n@@ -109,6 +109,14 @@ pub(crate) fn caret_covers(cur: &Version, new: &Version) -> Result<bool, Grammar\n     if cmp.is_lt() {\n         return Ok(false);\n     }\n+    // Pre-release versions are never covered by a caret range: ^1.2.3 must not\n+    // satisfy 1.9.0-alpha.1 even though 1.9.0-alpha.1 > 1.2.3 and they share\n+    // the same major. Caret ranges cover stable releases within the allowed\n+    // major/minor bounds only; a pre-release of an in-range stable version is\n+    // not itself a stable release and must not be treated as covered.\n+    if new.is_prerelease() {\n+        return Ok(false);\n+    }\n     let cur_maj = cur.major().unwrap_or(0);\n     let cur_min = cur.minor().unwrap_or(0);\n     let new_maj = new.major().unwrap_or(0);\n@@ -513,10 +521,48 @@ pub fn rewrite_spec(\n #[cfg(test)]\n mod tests {\n     use super::*;\n-    use callisto_model::{GroupKind, GroupName, Package, ReleaseTrigger};\n+    use callisto_model::{GroupKind, GroupName, Package, ReleaseTrigger, VersionGrammar};\n \n     use crate::config::{CascadeBumpSeverity, GroupDef, GroupMember};\n \n+    // -------------------------------------------------------------------------\n+    // T06: caret range must not cover pre-release versions\n+    // -------------------------------------------------------------------------\n+\n+    /// Spec: caret_covers(cur, new) must return false when `new` is a pre-release\n+    /// version, regardless of whether the major/minor bounds would otherwise be\n+    /// satisfied. \"^1.2.3\" should not be satisfied by \"1.9.0-alpha.1\" even though\n+    /// 1.9.0-alpha.1 > 1.2.3 and they share the same major version.\n+    #[test]\n+    fn caret_covers_excludes_prerelease_versions() {\n+        let v123 = Version::semver(1, 2, 3);\n+\n+        // Pre-release with same major: must be false even though major matches\n+        let pre_same_major = Version::parse(\"1.9.0-alpha.1\", VersionGrammar::SemVer).unwrap();","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"2bd7c05b-9741-4e7e-8aa9-2b1fe15c9964","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
