le summary of the change to record in the changeset'\n            cand --format 'Output format for command results'\n            cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n            cand --dry-run 'Preview manifest and file changes without writing to disk'\n            cand -h 'Print help'\n            cand --help 'Print help'\n        }\n        &'callisto;status'= {\n            cand --format 'Output format for command results'\n            cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n            cand --strict 'Enable strict mode: promote warning-level diagnostics to errors, causing a non-zero exit'\n            cand --strict-graph 'Treat dependency-graph warnings as errors'\n            cand --check 'Exit with a distinct status code indicating whether any changesets are pending'\n            cand --dry-run 'Preview manifest and file changes without writing to disk'\n            cand -h 'Print help'\n            cand --help 'Print help'\n        }\n        &'callisto;matrix'= {\n            cand --package 'Restrict output to one registered package''s name (PackageId::name())'\n            cand --format 'Output format for command results'\n            cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n            cand --dry-run 'Preview manifest and file changes without writing to disk'\n            cand -h 'Print help'\n            cand --help 'Print help'\n        }\n        &'callisto;version'= {\n            cand --format 'Output format for command results'\n            cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n            cand --refresh-lockfiles 'Regenerate lockfiles after applying the version bumps'\n            cand --strict 'Treat warning-level diagnostics as errors'\n            cand --strict-graph 'Treat dependency-graph warnings as errors'\n            cand --allow-empty-changesets 'Allow versioning