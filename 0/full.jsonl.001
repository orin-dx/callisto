exact dispatch regression: `release.rs:1678`\n- CLI HTTP sink regression: `runner.rs:475`\n\nRemaining shared-tree blockers at handoff:\n\n- Full clippy still reports new graph warnings, chiefly unused internal prepared-view fields explicitly retained for T3/T4 and warnings in concurrently owned observation/execution code.\n- CLI all-target compilation was still blocked by stale V1 references in `durable_release_e2e_tests.rs`; that migration was in progress by the PM4/T5 owner.\n- No commit or push was performed.\n"},{"type":"input_text","text":"\n[60] assistant: I’m removing the obsolete model journal contract now, including its tests and re-exports, while preserving the receipt-based convergence types.\n"},{"type":"input_text","text":"\n[61] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"ReleaseExecutionState|ReleaseOperationState|ReleaseExecutionStateError\\\" crates/callisto-model/src crates/callisto-model/tests crates/callisto-graph/src | head -200\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":20000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[63] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '2160,2395p' crates/callisto-model/src/release.rs && rtk rg -n \\\"execution_state|operation_state|mark_attempting|mark_outcome|ReleaseExecutionState\\\" crates/callisto-model/src/release.rs crates/callisto-model/src/lib.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":30000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[65] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '5970,6045p' crates/callisto-model/src/release.rs && rtk rg -n \\\"ReleaseExecutionState|ReleaseOperationState\\\" crates/callisto-model/src/lib.rs && rtk rg -n \\\"OperationBlockReason|OperationOutcome\\\" crates/callisto-model/src/release.rs crates/callisto-model/src/lib.rs | head -50\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":14000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[66] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\n        fn observation_wire_uses_canonical_camel_case_keys_only() {\n            let fixture = observation_fixture(true);\n            let wire = serde_json::to_value(fixture.receipt()).unwrap();\n            assert_no_snake_case_keys(&wire);\n            assert!(wire.get(\"schemaVersion\").is_some());\n            assert!(wire.get(\"intentDigest\").is_some());\n            assert!(wire.get(\"schema_version\").is_none());\n            assert!(wire.get(\"intent_digest\").is_none());\n\n            let evidence = wire[\"operations\"].as_array().unwrap();\n            assert!(evidence.iter().any(|entry| {\n                entry[\"evidence\"].get(\"registryKey\").is_some()\n                    && entry[\"evidence\"].get(\"bindingDigest\").is_some()\n                    && entry[\"evidence\"].get(\"byteLength\").is_some()\n            }));\n            assert!(evidence\n                .iter()\n                .any(|entry| entry[\"evidence\"].get(\"annotationDigest\").is_some()));\n            assert!(evidence\n                .iter()\n                .any(|entry| entry[\"evidence\"].get(\"assetRosterDigest\").is_some()));\n        }\n\n        #[test]\n        fn execution_state_wire_is_keyed_by_promoted_product_operations() {\n            let intent = intent();\n            let state = ReleaseExecutionState::pending(&intent);\n            state.validate_for_intent(&intent).unwrap();\n            let wire = serde_json::to_value(&state).unwrap();\n            assert_eq!(wire[\"operations\"].as_array().unwrap().len(), intent.operations().len());\n            assert!(wire[\"operations\"].as_array().unwrap().iter().any(|entry| {\n                entry[\"operation\"][\"kind\"] == \"productTag\" && entry[\"operation\"][\"release\"][\"product\