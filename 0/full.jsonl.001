ild failed, waiting for other jobs to finish...\n\n"},{"type":"input_text","text":"\n[68] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '320,338p' crates/callisto-cli/src/cli.rs && rtk sed -n '58,80p' crates/callisto-cli/src/commands/release.rs && rtk git diff -- crates/callisto-cli/src/cli.rs crates/callisto-cli/src/commands/release.rs | head -160\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":18000});\ntext(r.output);\n\n"},{"type":"input_text","text":"\n[69] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\n    pub out: Option<PathBuf>,\n}\n\n#[derive(Args, Clone, Debug)]\npub struct ReleasePlanArgs {\n    /// Named release destination profile from `[release.profiles]`. Use an\n    /// explicit rehearsal profile to exercise the full pipeline without\n    /// targeting production services.\n    #[arg(long, value_name = \"NAME\", required = true)]\n    pub profile: String,\n    /// Exact qualified package identity, for example `cargo/callisto-cli`. Repeat this flag to select multiple packages. This local/manual mode cannot be combined with --from-release-commit.\n    #[arg(\n        long = \"package\",\n        value_name = \"ECOSYSTEM/NAME\",\n        conflicts_with = \"from_release_commit\",\n        required_unless_present = \"from_release_commit\"\n    )]\n    pub packages: Vec<String>,\n    /// Exact merged release-PR commit checked out in this workspace. CI derives the roster from its versioned manifest delta and never reruns changeset planning.\n                })\n                .collect::<Result<Vec<_>, _>>()?;\n            let inference = select_inference();\n            let version_plan =\n                callisto_graph::commands::plan_version(&workspace, &inference, &VersionOptions::default())?;\n            derive_selected_release_decision(&workspace, &version_plan, &selections)?\n        }\n    };\n    let locator = IgnoreWalkLocator::new(&workspace.root);\n    let intent = build_release_intent(&workspace.root, &locator, &runner, &decision, &args.profile)?;\n    let permit = ApplyPermit::granted_unless_dry_run(global.dry_run)\n        .expect(\"release plan rejects --dry-run before creating its explicit output\");\n    write_intent(&args.out, &intent, &permit)?;\n    match global.format {\n        OutputFormat::Json => write_json(&mut std::io::stdout(), &intent)?,\n        OutputFormat::Text => println!(\"Wrote release intent {} to {}\", intent.digest(), args.out.display()),\n    }\n    Ok(ExitCode::SUCCESS)\n}\n\nfn inspect(args: ReleaseIn<truncated omitted_approx_tokens=\"1130\" />          \"intent.json\",\n+            \"--artifact-manifest\",\n+            \"artifacts.json\",\n+            \"--artifact-dir\",\n+            \"dist\",\n+            \"--receipt\",\n+            \"receipt.json\",\n+        ])\n+        .is_ok());\n+        assert!(Cli::try_parse_from([\n+            \"callisto\",\n+            \"release\",\n+            \"reconcile\",\n+            \"--intent\",\n+            \"intent.json\",\n+            \"--artifact-manifest\",\n+            \"artifacts.json\",\n+            \"--artifact-dir\",\n+            \"dist\",\n+        ])\n+        .is_ok());\n+    }\n+\n     /// AC-006/AC-007 (parse slice): `callisto matrix --package foo` parses\n     /// into Command::Matrix with the package field populated; MatrixArgs\n     /// declares no --format of its own (the global flag is used instead).\n  +57 -10\n\ncrates/callisto-cli/src/commands/release.rs\n@@ -1,23 +1,13 @@\n-//! Read-only durable release interfaces.\n-//!\n-//! Planning deliberately accepts only exact package identities. It never\n-//! accepts an inline intent or searches for an authority file. Execution is\n-//! intentionally not wired until the provider adapter can prove exact remote\n-//! identities; exposing a permissive fallback here would recreate the legacy\n-//! publish/tag bypass this command family replaces.\n+//! Durable