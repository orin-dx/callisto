{"parentUuid":"d065003f-6760-4ff5-a370-859bec259480","isSidechain":false,"promptId":"b5f1f17e-6f0f-410e-b205-05dcd0d14cfb","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EK61AiA2jxiWNT7cB1r1Q2","type":"tool_result","content":"930\t        b_target.is_prerelease(),\n931\t        \"B's cascade target in PreMode::Pre must also be a pre-release; got {}\",\n932\t        b_target.render()\n933\t    );\n934\t}\n935\t\n936\t/// A pre-release cycle must bump from the pinned baseline in\n937\t/// `PreState.initial_versions` (captured at `pre enter`), not from\n938\t/// whatever the current on-disk prerelease happens to be -- otherwise\n939\t/// the release segment re-derives from a moving target instead of the\n940\t/// pinned one.\n941\t#[test]\n942\tfn test_bump_target_uses_pinned_pre_baseline_not_current_prerelease() {\n943\t    let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n944\t\n945\t    let graph = TwoPackageGraph {\n946\t        packages: vec![bare_package(&pkg_a)],\n947\t    };\n948\t\n949\t    // On disk is 2.0.0-next.0 but the pinned baseline is 1.0.0, so a Minor bump must yield 1.1.0, not 2.0.0-next.1.\n950\t    let mut base = BTreeMap::new();\n951\t    base.insert(\n952\t        pkg_a.clone(),\n953\t        Version::parse(\"2.0.0-next.0\", callisto_model::VersionGrammar::SemVer).unwrap(),\n954\t    );\n955\t\n956\t    let mut initial_versions = indexmap::IndexMap::new();\n957\t    initial_versions.insert(\n958\t        \"pkg-a\".to_string(),\n959\t        Version::parse(\"1.0.0\", callisto_model::VersionGrammar::SemVer).unwrap(),\n960\t    );\n961\t    let pre = callisto_model::format::PreState {\n962\t        mode: callisto_model::format::PreMode::Pre,\n963\t        tag: \"next\".to_string(),\n964\t        initial_versions,\n965\t        changesets: Vec::new(),\n966\t    };\n967\t\n968\t    let groups = GroupTable::default();\n969\t    let cfg = CascadeConfig {\n970\t        mode: CascadeMode::OutOfRange,\n971\t        bump_severity: CascadeBumpSeverity::Patch,\n972\t        peer_escalation: true,\n973\t        preserve_npm_ranges: false,\n974\t    };\n975\t\n976\t    let seed = BTreeMap::new();\n977\t    let reasons = BTreeMap::new();\n978\t    let named_by = BTreeMap::new();\n979\t"}]},"uuid":"24618f73-64d1-40ce-bdfc-3658e9c21b0e","timestamp":"2026-11-12T20:01:42.778Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/.claude/worktrees/small-batch-limit-and-preview/crates/callisto-graph/src/cascade/tests.rs","content":"        b_target.is_prerelease(),\n        \"B's cascade target in PreMode::Pre must also be a pre-release; got {}\",\n        b_target.render()\n    );\n}\n\n/// A pre-release cycle must bump from the pinned baseline in\n/// `PreState.initial_versions` (captured at `pre enter`), not from\n/// whatever the current on-disk prerelease happens to be -- otherwise\n/// the release segment re-derives from a moving target instead of the\n/// pinned one.\n#[test]\nfn test_bump_target_uses_pinned_pre_baseline_not_current_prerelease() {\n    let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n\n    let graph = TwoPackageGraph {\n        packages: vec![bare_package(&pkg_a)],\n    };\n\n    // On disk is 2.0.0-next.0 but the pinned baseline is 1.0.0, so a Minor bump must yield 1.1.0, not 2.0.0-next.1.\n    let mut base = BTreeMap::new();\n    base.insert(\n        pkg_a.clone(),\n        Version::parse(\"2.0.0-next.0\", callisto_model::VersionGrammar::SemVer).unwrap(),\n    );\n\n    let mut initial_versions = indexmap::IndexMap::new();\n    initial_versions.insert(\n        \"pkg-a\".to_string(),\n        Version::parse(\"1.0.0\", callisto_model::VersionGrammar::SemVer).unwrap(),\n    );\n    let pre = callisto_model::format::PreState {\n        mode: callisto_model::format::PreMode::Pre,\n        tag: \"next\".to_string(),\n        initial_versions,\n        changesets: Vec::new(),\n    };\n\n    let groups = GroupTable::default();\n    let cfg = CascadeConfig {\n        mode: CascadeMode::OutOfRange,\n        bump_severity: CascadeBumpSeverity::Patch,\n        peer_escalation: true,\n        preserve_npm_ranges: false,\n    };\n\n    let seed = BTreeMap::new();\n    let reasons = BTreeMap::new();\n    let named_by = BTreeMap::new();\n","numLines":50,"startLine":930,"totalLines":2206}},"sourceToolAssistantUUID":"d065003f-6760-4ff5-a370-859bec259480","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/small-batch-limit-and-preview","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/pre-mode-no-downgrade","slug":"mossy-snacking-stream"}
