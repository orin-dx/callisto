{"parentUuid":"51ac15c4-02f5-4619-8b3a-2d9c34990e47","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Bash","toolUseID":"toolu_01KFQBEqcpadjJveDQhjbbKW","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"ae412d01-e061-4047-918b-0d1df3d4d118\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/callisto\\\",\\\"project\\\":\\\"callisto\\\",\\\"tool_name\\\":\\\"Bash\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":43},"type":"attachment","uuid":"d4a6fb5c-66cb-44ce-9946-e5c0fa1eac60","timestamp":"2026-08-21T13:14:52.911Z","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
{"parentUuid":"d4a6fb5c-66cb-44ce-9946-e5c0fa1eac60","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/commands/validate.rs","snippet":"1\tuse callisto_model::{CommandRunner, ValidateReport, SCHEMA_VERSION};\n2\t\n3\tuse crate::commands::escalate;\n4\tuse crate::error::GraphError;\n5\tuse crate::resolver::DependencyResolver;\n6\tuse crate::Workspace;\n7\t\n8\t#[derive(Clone, Debug, Default)]\n9\tpub struct ValidateOptions {\n10\t    pub staged: bool,\n11\t    pub since: Option<String>,\n12\t    pub strict: bool,\n13\t    pub strict_graph: bool,\n14\t}\n15\t\n16\tpub fn validate<R: CommandRunner, D: DependencyResolver>(\n17\t    ws: &Workspace<'_, R, D>,\n18\t    opts: &ValidateOptions,\n19\t) -> Result<ValidateReport, GraphError> {\n20\t    let mut diagnostics = Vec::new();\n21\t    let loaded = crate::load_changesets(&ws.root, &ws.config)?;\n22\t\n23\t    let target_changesets: Vec<_> = if opts.staged {\n24\t        let out = ws\n25\t            .runner\n26\t            .run(\"git\", &[\"diff\", \"--cached\", \"--name-only\"], &ws.root)?;\n27\t        if !out.success() {\n28\t            return Err(GraphError::Command(callisto_model::CommandError::Io {\n29\t                program: \"git\".to_string(),\n30\t                message: crate::apply::redact_git_stderr(&out.stderr),\n31\t            }));\n32\t        }\n33\t        let files: Vec<String> = out\n34\t            .stdout_trimmed()\n35\t            .lines()\n36\t            .map(|l| l.trim_matches('\"').to_string())\n37\t            .collect();\n38\t        loaded\n39\t            .into_iter()\n40\t            .filter(|cs| files.iter().any(|f| cs.path.ends_with(f)))\n41\t            .collect()\n42\t    } else if let Some(ref since) = opts.since {\n43\t        if since.starts_with('-') {\n44\t            return Err(GraphError::Command(callisto_model::CommandError::Io {\n45\t                program: \"git\".to_string(),\n46\t                message: \"invalid since ref\".to_string(),\n47\t            }));\n48\t        }\n49\t        let range = format!(\"{since}..HEAD\");\n50\t        let out = ws\n51\t            .runner\n52\t            .run(\"git\", &[\"diff\", \"--name-only\", &range, \"--\"], &ws.root)?;\n53\t        if !out.success() {\n54\t            return Err(GraphError::Command(callisto_model::CommandError::Io {\n55\t                program: \"git\".to_string(),\n56\t                message: crate::apply::redact_git_stderr(&out.stderr),\n57\t            }));\n58\t        }\n59\t        let files: Vec<String> = out\n60\t            .stdout_trimmed()\n61\t            .lines()\n62\t            .map(|l| l.trim_matches('\"').to_string())\n63\t            .collect();\n64\t        loaded\n65\t            .into_iter()\n66\t            .filter(|cs| files.iter().any(|f| cs.path.ends_with(f)))\n67\t            .collect()\n68\t    } else {\n69\t        loaded\n70\t    };\n71\t\n72\t    for cs in &target_changesets {\n73\t        if cs.changeset.entries.is_empty() {\n74\t            diagnostics.push(callisto_model::Diagnostic {\n75\t                code: callisto_model::DiagnosticCode::EmptyChangeset,\n76\t                severity: callisto_model::DiagnosticSeverity::Error,\n77\t                message: format!(\"Changeset `{}` is empty\", cs.path.display()),\n78\t                package: None,\n79\t                path: Some(cs.path.clone()),\n80\t                governed_by: None,\n81\t                escalated_by: None,\n82\t            });\n83\t        }\n84\t\n85\t        if !cs.changeset.entries.is_empty() && cs.changeset.summary.trim().is_empty() {\n86\t            diagnostics.push(callisto_model::Diagnostic {\n87\t                code: callisto_model::DiagnosticCode::EmptySummary,\n88\t                severity: callisto_model::DiagnosticSeverity::Error,\n89\t                message: format!(\n90\t                    \"Changeset `{}` has entries but an empty summary\",\n91\t                    cs.path.display()\n92\t                ),\n93\t                package: None,\n94\t                path: Some(cs.path.clone()),\n95\t                governed_by: None,\n96\t                escalated_by: None,\n97\t            });\n98\t        }\n99\t\n100\t        for entry in &cs.changeset.entries {\n101\t            match callisto_model::PackageId::parse(&entry.name) {\n102\t                Ok(id) => match id.resolve_unique(ws.graph.packages(), |p| &p.id) {\n103\t                    Ok(None) => {\n104\t                        diagnostics.push(callisto_model::Diagnostic {\n105\t                            code: callisto_model::DiagnosticCode::UnknownPackage,\n106\t                            severity: callisto_model::DiagnosticSeverity::Error,\n107\t                            message: format!(\n108\t                                \"Changeset `{}` references unknown package `{}`\",\n109\t                                cs.path.display(),\n110\t                                entry.name\n111\t                            ),\n112\t                            package: Some(id),\n113\t                            path: Some(cs.path.clone()),\n114\t                            governed_by: None,\n115\t                            escalated_by: None,\n116\t                        });\n117\t                    }\n118\t                    Ok(Some(_)) => {}\n119\t                    Err(candidates) => {\n120\t                        let names: Vec<String> = candidates\n121\t                            .iter()\n122\t                            .map(|p| p.id.display_name().to_string())\n123\t                            .collect();\n124\t                        diagnostics.push(callisto_model::Diagnostic {\n125\t                            code: callisto_model::DiagnosticCode::AmbiguousPackageName,\n126\t                            severity: callisto_model::DiagnosticSeverity::Error,\n127\t                            message: format!(\n128\t                                \"Changeset `{}` references ambiguous package `{}` (matches: {})\",\n129\t                                cs.path.display(),\n130\t                                entry.name,\n131\t                                names.join(\", \")\n132\t                            ),\n133\t                            package: Some(id),\n134\t                            path: Some(cs.path.clone()),\n135\t                            governed_by: None,\n136\t                            escalated_by: None,\n137\t                        });\n138\t                    }\n139\t                },\n140\t                Err(_) => {\n141\t                    diagnostics.push(callisto_model::Diagnostic {\n142\t                        code: callisto_model::DiagnosticCode::InvalidPackageName,\n143\t                        severity: callisto_model::DiagnosticSeverity::Error,\n144\t                        message: format!(\n145\t                            \"Changeset `{}` contains invalid package name `{}`\",\n146\t                            cs.path.display(),\n147\t                            entry.name\n148\t                        ),\n149\t                        package: None,\n150\t                        path: Some(cs.path.clone()),\n151\t                        governed_by: None,\n152\t                        escalated_by: None,\n153\t                    });\n154\t                }\n155\t            }\n156\t        }\n157\t    }\n158\t\n159\t    escalate(&mut diagnostics, opts.strict, opts.strict_graph);\n160\t\n161\t    let is_valid = diagnostics\n162\t        .iter()\n163\t        .all(|d| d.severity != callisto_model::DiagnosticSeverity::Error);\n164\t    Ok(ValidateReport {\n165\t        schema_version: SCHEMA_VERSION,\n166\t        ok: is_valid,\n167\t        diagnostics,\n168\t    })\n169\t}\n170\t\n171\t#[cfg(test)]\n172\tmod tests {\n173\t    use std::path::Path;\n174\t\n175\t    use callisto_model::{CommandError, CommandOutput, CommandRunner};\n176\t\n177\t    use super::*;\n178\t    use crate::locate::IgnoreWalkLocator;\n179\t    use crate::Workspace;\n180\t\n181\t    /// A `CommandRunner` that fails every call, echoing a stderr containing\n182\t    /// an authenticated GitHub remote URL -- the realistic shape a `git\n183\t    /// diff --cached` failure could surface in CI (e.g. a shallow clone or a\n184\t    /// detached-HEAD checkout with no cached index to diff against).\n185\t    struct LeakyGitRunner;\n186\t\n187\t    impl CommandRunner for LeakyGitRunner {\n188\t        fn run(\n189\t            &self,\n190\t            _program: &str,\n191\t            _args: &[&str],\n192\t            _cwd: &Path,\n193\t        ) -> Result<CommandOutput, CommandError> {\n194\t            Ok(CommandOutput {\n195\t                exit_code: Some(128),\n196\t                stdout: String::new(),\n\n... [91 lines truncated] ..."},"type":"attachment","uuid":"d8513e41-e843-44e9-8607-f31810b69a4a","timestamp":"2026-08-21T13:14:52.921Z","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
