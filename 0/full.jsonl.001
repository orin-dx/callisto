eport.body.contains(&expected_section),","+            \"body must contain render_section's verbatim output; body: {}\",","+            report.body","+        );","+        assert!(","+            !report.body.contains(\"Automatic dependency cascade triggered by\"),","+            \"body must NOT contain the fallback Cascade text when render_section succeeded; body: {}\",","+            report.body","+        );","+    }"," }"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"56eedb66-8d8e-491d-bbb6-6988679e1d2e","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"main","slug":"shimmying-giggling-hickey"}
