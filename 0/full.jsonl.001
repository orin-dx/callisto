),\n                \u0026fixture.expected.tag_annotation_digest\n            );\n            assert_eq!(\n                fixture.expected.asset_roster_digest(),\n                \u0026fixture.expected.asset_roster_digest\n            );\n            assert!(fixture\n                .expected\n                .artifact(fixture.manifest.entries()[0].slot())\n                .is_some());\n            assert!(fixture\n                .operations\n                .iter()\n                .all(|entry| entry.evidence().schema_version() == 1));\n            assert_eq!(\n                serde_json::from_value::\u003cCompleteObservationReceipt\u003e(serde_json::to_value(\u0026receipt).unwrap()).unwrap(),\n                receipt\n            );\n            assert!(receipt\n                .operations\n                .iter()\n                .any(|entry| entry.provenance == ObservationProvenance::NewlyProduced));\n            assert!(receipt\n                .operations\n                .iter()\n                .any(|entry| entry.provenance == ObservationProvenance::AlreadyPresent));\n            assert!(receipt.operations.iter().any(|entry| matches!(\n                (\u0026entry.operation, \u0026entry.evidence),\n                (\n                    ReleaseOperationId::RegistryArtifactPublish { .. },\n                    ReleaseObservationEvidence::RegistryArtifact { .. }\n\n","type":"input_text"},{"text":"\n[93] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '5435,5455p' crates/callisto-model/src/release.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":4000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[94] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\n                    ReleaseObservationEvidence::RegistryArtifact { .. }\n                )\n            )));\n        }\n\n        #[test]\n        fn observation_receipt_rejects_duplicate_missing_and_no