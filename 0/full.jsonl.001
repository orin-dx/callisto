 tests in crates/callisto-graph/tests/per_package_config_test.rs pass without modification.\",\n       \"is_error_case\": false\n     },\n     {\n=== uncommitted diff: ecosystem_bugs_test.rs ===\ndiff --git a/crates/callisto-graph/tests/ecosystem_bugs_test.rs b/crates/callisto-graph/tests/ecosystem_bugs_test.rs\nindex f21e8e7..82e299b 100644\n--- a/crates/callisto-graph/tests/ecosystem_bugs_test.rs\n+++ b/crates/callisto-graph/tests/ecosystem_bugs_test.rs\n@@ -249,17 +249,14 @@ fn cross_ecosystem_npm_to_cargo_dep_edge_is_discovered() {\n     );\n \n     // An UnknownPackage Warning diagnostic naming cargo:rust-addon must be present instead.\n-    let diag = ws\n-        .graph\n-        .diagnostics()\n-        .iter()\n-        .find(|d| {\n+    assert!(\n+        ws.graph.diagnostics().iter().any(|d| {\n             d.code == callisto_model::DiagnosticCode::UnknownPackage\n                 && d.severity == callisto_model::DiagnosticSeverity::Warning\n                 && d.message.contains(\"cargo:rust-addon\")\n-        })\n-        .expect(\"an UnknownPackage warning diagnostic naming cargo:rust-addon must be present\");\n-    let _ = diag;\n+        }),\n+        \"an UnknownPackage warning diagnostic naming cargo:rust-addon must be present\"\n+    );\n }\n \n /// Unit test for `IdentityIndex::resolve_native` cross-ecosystem fallback.","is_error":false}]},"uuid":"e28c5090-dfc5-4619-aa02-8cd7a56ada70","timestamp":"2026-08-17T13:02:05.092Z","toolUseResult":{"stdout":"=== uncommitted diff: track-f-resolution-extraction.json ===\ndiff --git a/.claude/specs/track-f-resolution-extraction.json b/.claude/specs/track-f-resolution-extraction.json\nindex 95453df..6daaac8 100644\n--- a/.claude/specs/track-f-resolution-extraction.json\n+++ b/.claude/specs/track-f-resolution-extraction.json\n@@ -53,7 +53,7 @@\n     },\n     {\n       \"id\": \"AC-F6\",\n-      \"criterion\": \"The inline two-pass [[package]] lookup in walk.rs (lines 160-169, the two cfg.packages.iter().find(...) calls joined by .or_else, followed by .map(|(_, cfg)| cfg)) is removed and replaced by a single call to resolve_package_config(&id, cfg). The trailing .map(|(_, cfg)| cfg) at line 169 is deleted because resolve_package_config already returns Option<&PackageConfig>, not Option<&(PackageId, PackageConfig)>. The resulting binding is: let pkg_override = resolve_package_config(&id, cfg);. All tests in crates/callisto-graph/tests/per_package_config_test.rs pass without modification.\",\n+      \"criterion\": \"The inline two-pass [[package]] lookup in walk.rs (lines 160-169, the two cfg.packages.iter().find(...) calls joined by .or_else, followed by .map(|(_, cfg)| cfg)) is removed and replaced by a single call to resolve_package_config(&id, &cfg_with_local_promotions)?. The trailing .map(|(_, cfg)| cfg) at line 169 is deleted because resolve_package_config already returns Result<Option<&PackageConfig>, GraphError>, not Option<&(PackageId, PackageConfig)>. The resulting binding is: let pkg_override = resolve_package_config(&id, &cfg_with_local_promotions)?;, where cfg_with_local_promotions is the build-local ResolvedConfig overlay constructed via cfg.with_promoted_siblings(...) per SPEC-TRACK3B1-IDENTITY-PROMOTION-CORE. All tests in crates/callisto-graph/tests/per_package_config_test.rs pass without modification.\",\n       \"is_error_case\": false\n     },\n     {\n=== uncommitted diff: ecosystem_bugs_test.rs ===\ndiff --git a/crates/callisto-graph/tests/ecosystem_bugs_test.rs b/crates/callisto-graph/tests/ecosystem_bugs_test.rs\nindex f21e8e7..82e299b 100644\n--- a/crates/callisto-graph/tests/ecosystem_bugs_test.rs\n+++ b/crates/callisto-graph/tests/ecosystem_bugs_test.rs\n@@ -249,17 +249,14 @@ fn cross_ecosystem_npm_to_cargo_dep_edge_is_discovered() {\n     );\n \n     // An UnknownPackage Warning diagnostic naming cargo:rust-addon must be present instead.\n-    let diag = ws\n-        .graph\n-        .diagnostics()\n-        .iter()\n-        .find(|d| {\n+    as