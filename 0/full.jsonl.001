{"parentUuid":"deba9e73-66fe-455e-bb8b-0e06e6cc1c9a","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/toposort.rs","snippet":"1\tuse std::collections::{BTreeMap, BTreeSet, HashSet};\n2\t\n3\tuse callisto_model::{DepKind, PackageId};\n4\t\n5\tuse crate::error::GraphError;\n6\t\n7\t/// Topologically sorts `subset` by the edges `outgoing_edges` reports, counting only edges\n8\t/// whose [`DepKind`] appears in `ordering_kinds` as ordering constraints. Different callers\n9\t/// need different kinds to count: cascade/version-bump propagation only cares about\n10\t/// `Runtime`/`Build`/`Optional` (a `Dev`-only change correctly shouldn't force a consumer's\n11\t/// version to bump), while publish ordering (`commands::publish::publish_order`) also needs\n12\t/// `Dev`, since `cargo publish`'s own local verification build needs every declared\n13\t/// dependency — dev included — resolvable. This function has no opinion on which kinds\n14\t/// matter; the caller states it explicitly via `ordering_kinds`.\n15\tpub fn toposort_impl<F>(\n16\t    subset: &HashSet<PackageId>,\n17\t    all_packages: &[PackageId],\n18\t    ordering_kinds: &[DepKind],\n19\t    outgoing_edges: F,\n20\t) -> Result<Vec<PackageId>, GraphError>\n21\twhere\n22\t    F: Fn(&PackageId) -> Vec<(PackageId, DepKind)>,\n23\t{\n24\t    let members: BTreeSet<PackageId> = subset.iter().cloned().collect();\n25\t    // Build a HashSet once so validation is O(N) rather than O(N²) slice scans.\n26\t    let all_set: std::collections::HashSet<&PackageId> = all_packages.iter().collect();\n27\t    for id in &members {\n28\t        if !all_set.contains(id) {\n29\t            return Err(GraphError::UnknownPackage { id: id.clone() });\n30\t        }\n31\t    }\n32\t\n33\t    let mut in_degree: BTreeMap<PackageId, usize> = BTreeMap::new();\n34\t    let mut adj: BTreeMap<PackageId, Vec<PackageId>> = BTreeMap::new();\n35\t\n36\t    for u in &members {\n37\t        in_degree.insert(u.clone(), 0);\n38\t        adj.insert(u.clone(), Vec::new());\n39\t    }\n40\t\n41\t    for u in &members {\n42\t        for (v, kind) in outgoing_edges(u) {\n43\t            if members.contains(&v) && ordering_kinds.contains(&kind) {\n44\t                adj.get_mut(&v).unwrap().push(u.clone());\n45\t                *in_degree.get_mut(u).unwrap() += 1;\n46\t            }\n47\t        }\n48\t    }\n49\t\n50\t    let mut queue: BTreeSet<PackageId> = BTreeSet::new();\n51\t    for (u, &deg) in &in_degree {\n52\t        if deg == 0 {\n53\t            queue.insert(u.clone());\n54\t        }\n55\t    }\n56\t\n57\t    let mut sorted = Vec::new();\n58\t    while let Some(u) = queue.pop_first() {\n59\t        sorted.push(u.clone());\n60\t        if let Some(neighbors) = adj.get(&u) {\n61\t            for v in neighbors {\n62\t                let deg = in_degree.get_mut(v).unwrap();\n63\t                *deg -= 1;\n64\t                if *deg == 0 {\n65\t                    queue.insert(v.clone());\n66\t                }\n67\t            }\n68\t        }\n69\t    }\n70\t\n71\t    if sorted.len() < members.len() {\n72\t        let set: HashSet<PackageId> = sorted.iter().cloned().collect();\n73\t        let remaining: Vec<PackageId> = members.into_iter().filter(|m| !set.contains(m)).collect();\n74\t        let cycle = extract_cycle(&remaining, &adj);\n75\t        return Err(GraphError::Cycle { cycle });\n76\t    }\n77\t\n78\t    Ok(sorted)\n79\t}\n80\t\n81\tfn extract_cycle(\n82\t    remaining: &[PackageId],\n83\t    adj: &BTreeMap<PackageId, Vec<PackageId>>,\n84\t) -> Vec<PackageId> {\n85\t    use petgraph::algo::tarjan_scc;\n86\t    use petgraph::graph::DiGraph;\n87\t\n88\t    let mut graph = DiGraph::<PackageId, ()>::new();\n89\t    let mut node_map = BTreeMap::new();\n90\t    let mut rev_map = BTreeMap::new();\n91\t\n92\t    for pkg in remaining {\n93\t        let idx = graph.add_node(pkg.clone());\n94\t        node_map.insert(pkg.clone(), idx);\n95\t        rev_map.insert(idx, pkg.clone());\n96\t    }\n97\t\n98\t    for u in remaining {\n99\t        if let Some(neighbors) = adj.get(u) {\n100\t            for v in neighbors {\n101\t                if let (Some(&u_idx), Some(&v_idx)) = (node_map.get(u), node_map.get(v)) {\n102\t                    graph.add_edge(u_idx, v_idx, ());\n103\t                }\n104\t            }\n105\t        }\n106\t    }\n107\t\n108\t    let sccs = tarjan_scc(&graph);\n109\t    for scc in sccs {\n110\t        let is_self_loop = scc.len() == 1 && graph.contains_edge(scc[0], scc[0]);\n111\t        if scc.len() > 1 || is_self_loop {\n112\t            let mut cycle = Vec::new();\n113\t            let start_idx = scc[0];\n114\t            let mut curr = start_idx;\n115\t            let scc_set: std::collections::HashSet<_> = scc.iter().copied().collect();\n116\t\n117\t            cycle.push(rev_map[&curr].clone());\n118\t            loop {\n119\t                let mut next_found = None;\n120\t                for neighbor in graph.neighbors(curr) {\n121\t                    if scc_set.contains(&neighbor) {\n122\t                        next_found = Some(neighbor);\n123\t                        break;\n124\t                    }\n125\t                }\n126\t\n127\t                if let Some(next) = next_found {\n128\t                    curr = next;\n129\t                    cycle.push(rev_map[&curr].clone());\n130\t                    if curr == start_idx {\n131\t                        break;\n132\t                    }\n133\t                } else {\n134\t                    break;\n135\t                }\n136\t            }\n137\t\n138\t            if cycle.len() > 1 {\n139\t                return cycle;\n140\t            }\n141\t        }\n142\t    }\n143\t\n144\t    remaining.to_vec()\n145\t}\n146\t\n147\t#[cfg(test)]\n148\tmod tests {\n149\t    use super::*;\n150\t\n151\t    #[test]\n152\t    fn test_toposort_linear() {\n153\t        let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n154\t        let pkg_b = PackageId::parse(\"pkg-b\").unwrap();\n155\t\n156\t        let subset: HashSet<_> = vec![pkg_a.clone(), pkg_b.clone()].into_iter().collect();\n157\t        let all = vec![pkg_a.clone(), pkg_b.clone()];\n158\t\n159\t        let res = toposort_impl(&subset, &all, &[DepKind::Runtime], |id| {\n160\t            if id == &pkg_a {\n161\t                vec![(pkg_b.clone(), DepKind::Runtime)]\n162\t            } else {\n163\t                vec![]\n164\t            }\n165\t        })\n166\t        .unwrap();\n167\t\n168\t        assert_eq!(res, vec![pkg_b, pkg_a]);\n169\t    }\n170\t\n171\t    #[test]\n172\t    fn test_toposort_produces_correct_order_large_graph() {\n173\t        // Build a 10-package chain: pkg-a -> pkg-b -> ... -> pkg-i -> pkg-j\n174\t        // Each package depends on the next; pkg-j is the leaf with no dependencies.\n175\t        // Expected toposort order (dependencies first): [pkg-j, pkg-i, ..., pkg-a]\n176\t        let ids: Vec<PackageId> = (b'a'..=b'j')\n177\t            .map(|c| PackageId::parse(&format!(\"pkg-{}\", c as char)).unwrap())\n178\t            .collect();\n179\t\n180\t        let subset: HashSet<PackageId> = ids.iter().cloned().collect();\n181\t        let all: Vec<PackageId> = ids.clone();\n182\t\n183\t        let result = toposort_impl(&subset, &all, &[DepKind::Runtime], |id| {\n184\t            // Find the index of this package; if it's not the last, it depends on the next.\n185\t            if let Some(pos) = ids.iter().position(|x| x == id) {\n186\t                if pos + 1 < ids.len() {\n187\t                    return vec![(ids[pos + 1].clone(), DepKind::Runtime)];\n188\t                }\n189\t            }\n190\t            vec![]\n191\t        })\n192\t        .unwrap();\n193\t\n194\t        // pkg-j has no dependents so it sorts first; pkg-a sorts last.\n195\t        let expected: Vec<PackageId> = ids.iter().cloned().rev().collect();\n196\t        assert_eq!(result, expected);\n197\t    }\n198\t\n199\t    #[test]\n200\t    fn test_toposort_self_loop_cycle() {\n201\t        let pkg_a = PackageId::parse(\"pkg-a\").unwrap();\n202\t        let subset: HashSet<_> = vec![pkg_a.clone()].into_iter().collect();\n203\t        let all = vec![pkg_a.clone()];\n204\t\n205\t        let err = toposort_impl(&subset, &all, &[DepKind::Runtime], |id| {\n206\t            if id == &pkg_a {\n207\t                vec![(pkg_a.clone(), DepKind::Runtime)]\n208\t            } else {\n209\t                vec![]\n210\t            }\n211\t        })\n212\t        .unwrap_err();\n213\t\n214\t        if let GraphError::Cycle { cycle } = err {\n215\t            assert_eq!(cycle, vec![pkg_a.clone(), pkg_a]);\n216\t        } else {\n217\t            panic!(\"expected Cycle error\");\n218\t        }\n219\t    }\n220\t}"},"type":"attachment","uuid":"14368725-81b5-4261-bf7d-a8461e129cf8","timestamp":"2026-08-22T17:44:30.719Z","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"fix-publish-order-dev-deps","slug":"shimmying-giggling-hickey"}
