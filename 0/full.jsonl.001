r == \"..\" || repository == \".\" || repository == \"..\" {\n        return Err(GraphError::UnsafeGitRemote {\n            reason: \"remote path must contain exactly an owner and repository\",\n        });\n    }\n    let repository = repository.strip_suffix(\".git\").unwrap_or(repository);\n    if repository.is_empty() {\n        return Err(GraphError::UnsafeGitRemote {\n            reason: \"repository name is empty\",\n        });\n    }\n    // GitHub repository identity is case-insensitive. Configuration already\n    // canonicalizes it to lowercase, so the remote capability must use the\n    // same representation for equality, endpoint rendering, and its digest.\n    let owner = owner.to_ascii_lowercase();\n    let repository = repository.to_ascii_lowercase();\n    let port = parsed.port_or_known_default();\n    let port_text = match (parsed.scheme(), port) {\n        (\"https\", Some(443)) | (\"ssh\", Some(22)) | (_, None) =\u003e String::new(),\n        (_, Some(port)) =\u003e format!(\":{port}\"),\n    };\n    let endpoint = match parsed.scheme() {\n        \"https\" =\u003e format!(\"https://{host}{port_text}/{owner}/{repository}.git\"),\n        \"ssh\" =\u003e format!(\"ssh://git@{host}{port_text}/{owner}/{repository}.git\"),\n        _ =\u003e unreachable!(\"scheme checked above\"),\n    };\n    let mut transcript = CanonicalTranscript::semantic_input_v1();\n    transcript.push_str(\"gitRemote.scheme\", parsed.scheme());\n    transcript.push_str(\"gitRemote.host\", \u0026host);\n    transcript.push_str(\n        \"gitRemote.port\",\n        \u0026port.map_or_else(String::new, |port| port.to_string()),\n    );\n    transcript.push_str(\"gitRemote.owner\", \u0026owner);\n    transcript.push_str(\"gitRemote.repository\", \u0026repository);\n    if host != \"github.com\" {\n        return Err(GraphError::UnsafeGitRemote {\n            reason: \"release forge remote must be hosted on github.com\",\n        });\n    }\n    let github_repository =\n        GitHubRepository::parse(\u0026format!(\"{owner}/{repository}\")).map_err(|error| GraphError::UnsafeGitRemote {\n            reason: github_repository_parse_error_reason(\u0026error),\n        })?;\n    Ok(PreparedGitRemote {\n        remote_name: \"origin\",\n        endpoint,\n        identity: callisto_model::SemanticInputDigest::from_transcript(\u0026transcript),\n        github_repository,\n    })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::super::release_observation::tests::{artifact_fixture, capability_workspace, CapabilityRunner};\n    use super::*;\n    use callisto_model::{CommandError, CommandOutput, Ecosystem, VersionGrammar};\n    use std::sync::atomic::{AtomicUsize, Ordering};\n\n    struct ScopedEnvironment {\n        name: \u0026'static str,\n        previous: Option\u003cstd::ffi::OsString\u003e,\n    }\n\n    impl ScopedEnvironment {\n        fn set(name: \u0026'static str, value: \u0026str) -\u003e Self {\n            let previous = std::env::var_os(name);\n            std::env::set_var(name, value);\n            Self { name, previous }\n        }\n    }\n\n","type":"input_text"},{"text":"\n[97] tool exec call: const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/callisto-release-recovery/crates/callisto-graph/src/commands/release.rs\\n@@\\n     fn dispatch_prepared_submits_the_exact_validated_cargo_body_with_a_finite_deadline() {\\n@@\\n         assert!(submissions[0].3.ends_with(\u0026crate_bytes));\\n     }\\n+\\n+    #[test]\\n+    #[serial_test::serial]\\n+    fn dispatch_prepared_stages_exact_npm_bytes_with_canonical_argv_and_private_config() {\\n+        let (workspace, decision) = capability_workspace();\\n+        let runner = CapabilityRunner::default();\\n+        let locator = crate::IgnoreWalkLocator::new(workspace.path());\\n+        let intent = build_release_intent(workspace.path(), \u0026locator, \u0026runner, \u0026decision, \\\"production\\\").unwrap();\\n+        let state = tempfile::tempdir().unwrap();\\n+        let validated = validate_release_intent_with_state_directory(\\n+            workspace.path(),\\n+            \u0026locator,\\n+            \u0026runner,\\n+            Some(state.path()),\\n+            intent,\\n+        )\\n+        .unwrap();\\n+        let (_artifact_directory, artifacts) = artifact_fixture(\u0026validated, \u0026runner);\\n+        let (operation, slot) = validated\\n+            .intent()\\n+            .operations()\\n+            .iter()\\n+            .find_map(|operation| match operation.id() {\\n+                ReleaseOperationId::RegistryArtifactPublish { package, slot, .. }\\n+                    if package.ecosystem() == Ecosystem::Npm =\u003e\\n+                {\\n+                    Some((operation.id().clone(), slot.clone()))\\n+                }\\n+                _ =\u003e None,\\n+            })\\n+            .expect(\\\"npm publish operation\\\");\\n+        let expected = artifacts.snapshot(\u0026slot).unwrap().bytes().to_vec();\\n+        runner.push_npm_absent();\\n+        runner.push_npm_exact(slot.file_name(), \u0026expected);\\n+        let _credential = ScopedEnvironment::set(\\\"NPM_TOKEN\\\", \\\"private-test-token\\\");\\n+        let mut observations = ObservationSession::d\u003ctruncated omitted_approx_tokens=\"659\" /\u003e      .filter(|candidate| {\\n+                matches!(candidate, ReleaseArtifactSlot::RegistryPackage { package, .. }\\n+                    if package.ecosystem() == Ecosystem::Pypi)\\n+            })\\n+            .map(|candidate| {\\n+                let (digest, length) = artifacts.expectations().artifact(candidate).unwrap();\\n+                serde_json::json!({\\n+                    \\\"filename\\\": candidate.file_name(),\\n+                    \\\"size\\\": length,\\n+                    \\\"digests\\\": {\\\"sha256\\\": digest.as_str()}\\n+                })\\n+            })\\n+            .collect::\u003cVec\u003c_\u003e\u003e();\\n+        runner.push_http(404, serde_json::