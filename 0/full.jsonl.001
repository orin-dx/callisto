{"parentUuid":"5509290b-58a1-4022-be62-2f617aa16397","isSidechain":false,"promptId":"f33ed927-5970-4ad9-b678-041679a8cd99","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QffP4Po7svd4fQA9U4qWFY","type":"tool_result","content":"1\tuse callisto_model::GroupKind;\n2\t\n3\tuse crate::{group_entries, ChangeSource, ChangelogError, ChangelogInput};\n4\t\n5\tpub fn render_section(input: &ChangelogInput) -> Result<String, ChangelogError> {\n6\t    if input.entries.is_empty() {\n7\t        return Err(ChangelogError::EmptyInput);\n8\t    }\n9\t    let grouped = group_entries(&input.entries)?;\n10\t    let mut out = String::new();\n11\t\n12\t    let heading = match &input.to {\n13\t        Some(v) => format!(\"## {}\", v.render()),\n14\t        None => \"## Unreleased\".to_string(),\n15\t    };\n16\t    out.push_str(&heading);\n17\t    out.push('\\n');\n18\t\n19\t    for (section_name, entries) in [\n20\t        (\"### Major Changes\", &grouped.major),\n21\t        (\"### Minor Changes\", &grouped.minor),\n22\t        (\"### Patch Changes\", &grouped.patch),\n23\t    ] {\n24\t        if entries.is_empty() {\n25\t            continue;\n26\t        }\n27\t\n28\t        // Pre-filter: only emit the section heading when at least one entry\n29\t        // will produce visible output. Changeset entries with blank summaries\n30\t        // are silently skipped in the loop below, so a section consisting\n31\t        // entirely of such entries must not emit its heading.\n32\t        let has_visible_output = entries.iter().any(|e| match &e.source {\n33\t            ChangeSource::Changeset { summary, .. } => !summary.trim().is_empty(),\n34\t            _ => true,\n35\t        });\n36\t        if !has_visible_output {\n37\t            continue;\n38\t        }\n39\t\n40\t        out.push('\\n');\n41\t        out.push_str(section_name);\n42\t        out.push('\\n');\n43\t        out.push('\\n');\n44\t\n45\t        let mut dep_updates = Vec::new();\n46\t\n47\t        for entry in entries {\n48\t            match &entry.source {\n49\t                ChangeSource::Changeset { summary, .. } => {\n50\t                    if summary.trim().is_empty() {\n51\t                        continue;\n52\t                    }\n53\t                    let indented = summary.trim_end_matches('\\n');\n54\t                    let indented = indented.replace('\\n', \"\\n  \");\n55\t                    out.push_str(&format!(\"- {indented}\\n\"));\n56\t                }\n57\t                ChangeSource::Commit { subject, sha } => {\n58\t                    out.push_str(&format!(\"- {subject} ({})\\n\", sha.short()));\n59\t                }\n60\t                ChangeSource::DependencyUpdate { dependency, to, .. } => {\n61\t                    dep_updates.push((dependency, to));\n62\t                }\n63\t                ChangeSource::PeerEscalation { dependency, to } => {\n64\t                    out.push_str(&format!(\n65\t                        \"- Peer dependency `{}` requires `{}`\\n\",\n66\t                        dependency.display_name(),\n67\t                        to.render()\n68\t                    ));\n69\t                }\n70\t                ChangeSource::GroupUnion { group, kind } => {\n71\t                    let k_str = match kind {\n72\t                        GroupKind::Fixed => \"fixed\",\n73\t                        GroupKind::Linked => \"linked\",\n74\t                    };\n75\t                    out.push_str(&format!(\n76\t                        \"- Released together with the `{group}` {k_str} group.\\n\"\n77\t                    ));\n78\t                }\n79\t                ChangeSource::NewGroupMember { group } => {\n80\t                    out.push_str(&format!(\"- Joined the `{group}` group at this version.\\n\"));\n81\t                }\n82\t            }\n83\t        }\n84\t\n85\t        if !dep_updates.is_empty() {\n86\t            out.push_str(\"- Dependency updates\\n\");\n87\t            for (dep, to_ver) in dep_updates {\n88\t                out.push_str(&format!(\n89\t                    \"  - `{}` → `{}`\\n\",\n90\t                    dep.display_name(),\n91\t                    to_ver.render()\n92\t                ));\n93\t            }\n94\t        }\n95\t    }\n96\t\n97\t    Ok(out)\n98\t}\n99\t\n100\t#[cfg(test)]\n101\tmod tests {\n102\t    use super::*;\n103\t    use crate::ChangelogEntry;\n104\t    use callisto_model::{PackageId, Severity, Version, VersionGrammar};\n105\t\n106\t    fn make_input(summary: &str) -> ChangelogInput {\n107\t        ChangelogInput {\n108\t            package: PackageId::parse(\"my-pkg\").unwrap(),\n109\t            from: Version::parse(\"1.0.0\", VersionGrammar::SemVer).unwrap(),\n110\t            to: Some(Version::parse(\"1.1.0\", VersionGrammar::SemVer).unwrap()),\n111\t            entries: vec![ChangelogEntry {\n112\t                severity: Severity::Patch,\n113\t                source: ChangeSource::Changeset {\n114\t                    filename: \"fix.md\".to_string(),\n115\t                    summary: summary.to_string(),\n116\t                },\n117\t            }],\n118\t        }\n119\t    }\n120\t\n121\t    #[test]\n122\t    fn renders_basic_changelog_section() {\n123\t        let input = ChangelogInput {\n124\t            package: PackageId::parse(\"my-pkg\").unwrap(),\n125\t            from: Version::parse(\"1.0.0\", VersionGrammar::SemVer).unwrap(),\n126\t            to: Some(Version::parse(\"1.1.0\", VersionGrammar::SemVer).unwrap()),\n127\t            entries: vec![ChangelogEntry {\n128\t                severity: Severity::Minor,\n129\t                source: ChangeSource::Changeset {\n130\t                    filename: \"cool-dragons.md\".to_string(),\n131\t                    summary: \"Add dragon feature\".to_string(),\n132\t                },\n133\t            }],\n134\t        };\n135\t\n136\t        let rendered = render_section(&input).unwrap();\n137\t        assert!(rendered.contains(\"## 1.1.0\"));\n138\t        assert!(rendered.contains(\"### Minor Changes\"));\n139\t        assert!(rendered.contains(\"- Add dragon feature\"));\n140\t    }\n141\t\n142\t    #[test]\n143\t    fn render_section_indents_multiline_summary_continuation_lines() {\n144\t        let input = make_input(\"First line.\\n\\nSecond paragraph.\");\n145\t        let rendered = render_section(&input).unwrap();\n146\t        // Continuation lines must be indented — bare \"\\nSecond paragraph.\" is wrong\n147\t        assert!(\n148\t            !rendered.contains(\"\\nSecond paragraph.\"),\n149\t            \"continuation line must not appear unindented; got:\\n{rendered}\"\n150\t        );\n151\t        // Must appear with at least 2-space indent\n152\t        assert!(\n153\t            rendered.contains(\"\\n  Second paragraph.\"),\n154\t            \"continuation line must be indented by 2 spaces; got:\\n{rendered}\"\n155\t        );\n156\t    }\n157\t\n158\t    #[test]\n159\t    fn render_section_handles_trailing_newline_in_summary() {\n160\t        let input = make_input(\"Fix bug.\\n\");\n161\t        let rendered = render_section(&input).unwrap();\n162\t        // A trailing newline in the summary must not produce a doubled blank line\n163\t        assert!(\n164\t            !rendered.contains(\"- Fix bug.\\n\\n\"),\n165\t            \"trailing newline in summary must not produce a doubled blank line; got:\\n{rendered}\"\n166\t        );\n167\t    }\n168\t\n169\t    #[test]\n170\t    fn test_render_section_all_empty_summaries_no_heading() {\n171\t        // CORR-002: when every entry in a section has a blank summary the\n172\t        // section heading must not be emitted at all.\n173\t        let input = ChangelogInput {\n174\t            package: PackageId::parse(\"my-pkg\").unwrap(),\n175\t            from: Version::parse(\"1.0.0\", VersionGrammar::SemVer).unwrap(),\n176\t            to: Some(Version::parse(\"1.1.0\", VersionGrammar::SemVer).unwrap()),\n177\t            entries: vec![ChangelogEntry {\n178\t                severity: Severity::Patch,\n179\t                source: ChangeSource::Changeset {\n180\t                    filename: \"empty.md\".to_string(),\n181\t                    summary: \"\".to_string(),\n182\t                },\n183\t            }],\n184\t        };\n185\t\n186\t        let rendered = render_section(&input).unwrap();\n187\t        assert!(\n188\t            !rendered.contains(\"### Patch Changes\"),\n189\t            \"section heading must not be emitted when all summaries are empty; got:\\n{rendered}\"\n190\t        );\n191\t    }\n192\t\n193\t    #[test]\n194\t    fn render_section_skips_entry_with_empty_summary() {\n195\t        let input = ChangelogInput {\n196\t            package: PackageId::parse(\"my-pkg\").unwrap(),\n197\t            from: Version::parse(\"1.0.0\", VersionGrammar::SemVer).unwrap(),\n198\t            to: Some(Version::parse(\"1.1.0\", VersionGrammar::SemVer).unwrap()),\n199\t            entries: vec![\n200\t                ChangelogEntry {\n201\t                    severity: Severity::Patch,\n202\t                    source: ChangeSource::Changeset {\n203\t                        filename: \"empty.md\".to_string(),\n204\t                        summary: \"\".to_string(),\n205\t                    },\n206\t                },\n207\t                ChangelogEntry {\n208\t                    severity: Severity::Patch,\n209\t                    source: ChangeSource::Changeset {\n210\t                        filename: \"real.md\".to_string(),\n211\t                        summary: \"Real change\".to_string(),\n212\t                    },\n213\t                },\n214\t            ],\n215\t        };\n216\t\n217\t        let rendered = render_section(&input).unwrap();\n218\t        assert!(\n219\t            !rendered.contains(\"- \\n\"),\n220\t            \"empty summary must not produce a blank bullet; got:\\n{rendered}\"\n221\t        );\n222\t        assert!(\n223\t            rendered.contains(\"- Real change\"),\n224\t            \"non-empty entry must still appear; got:\\n{rendered}\"\n225\t        );\n226\t    }\n227\t}\n228\t"}]},"uuid":"65c4205f-6466-4fe8-a13b-cd557c42998f","timestamp":"2026-08-22T03:21:12.558Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/callisto/crates/callisto-changelog/src/render.rs","content":"use callisto_model::GroupKind;\n\nuse crate::{group_entries, ChangeSource, ChangelogError, ChangelogInput};\n\npub fn render_section(input: &ChangelogInput) -> Result<String, ChangelogError> {\n    if input.entries.is_empty() {\n        return Err(ChangelogError::EmptyInput);\n    }\n    let grouped = group_entries(&input.entries)?;\n    let mut out = String::new();\n\n    let heading = match &input.to {\n        Some(v) => format!(\"## {}\", v.render()),\n        None => \"## Unreleased\".to_string(),\n    };\n    out.push_str(&heading);\n    out.push('\\n');\n\n    for (section_name, entries) in [\n        (\"### Major Changes\", &grouped.major),\n        (\"### Minor Changes\", &grouped.minor),\n        (\"### Patch Changes\", &grouped.patch),\n    ] {\n        if entries.is_empty() {\n            continue;\n        }\n\n        // Pre-filter: only emit the section heading when at least one entry\n        // will produce visible output. Changeset entries with blank summaries\n        // are silently skipped in the loop below, so a section consisting\n        // entirely of such entries must not emit its heading.\n        let has_visible_output = entries.iter().any(|e| match &e.source {\n            ChangeSource::Changeset { summary, .. } => !summary.trim().is_empty(),\n            _ => true,\n        });\n        if !has_visible_output {\n            continue;\n        }\n\n        out.push('\\n');\n        out.push_str(section_name);\n        out.push('\\n');\n        out.push('\\n');\n\n        let mut dep_updates = Vec::new();\n\n        for entry in entries {\n            match &entry.source {\n                ChangeSource::Changeset { summary, .. } => {\n                    if summary.trim().is_empty() {\n                        continue;\n                    }\n                    let indented = summary.trim_end_matches('\\n');\n                    let indented = indented.replace('\\n', \"\\n  \");\n                    out.push_str(&format!(\"- {indented}\\n\"));\n                }\n                ChangeSource::Commit { subject, sha } => {\n                    out.push_str(&format!(\"- {subject} ({})\\n\", sha.short()));\n                }\n                ChangeSource::DependencyUpdate { dependency, to, .. } => {\n                    dep_updates.push((dependency, to));\n                }\n                ChangeSource::PeerEscalation { dependency, to } => {\n                    out.push_str(&format!(\n                        \"- Peer dependency `{}` requires `{}`\\n\",\n                        dependency.display_name(),\n                        to.render()\n                    ));\n                }\n                ChangeSource::GroupUnion { group, kind } => {\n                    let k_str = match kind {\n                        GroupKind::Fixed => \"fixed\",\n                        GroupKind::Linked => \"linked\",\n                    };\n                    out.push_str(&format!(\n                        \"- Released together with the `{group}` {k_str} group.\\n\"\n                    ));\n                }\n                ChangeSource::NewGroupMember { group } => {\n                    out.push_str(&format!(\"- Joined the `{group}` group at this version.\\n\"));\n                }\n            }\n        }\n\n        if !dep_updates.is_empty() {\n            out.push_str(\"- Dependency updates\\n\");\n            for (dep, to_ver) in dep_updates {\n                out.push_str(&format!(\n                    \"  - `{}` → `{}`\\n\",\n                    dep.display_name(),\n                    to_ver.render()\n                ));\n            }\n        }\n    }\n\n    Ok(out)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::ChangelogEntry;\n    use callisto_model::{PackageId, Severity, Version, VersionGrammar};\n\n    fn make_input(summary: &str) -> ChangelogInput {\n        ChangelogInput {\n            package: PackageId::parse(\"my-pkg\").unwrap(),\n            from: Version::parse(\"1.0.0\", VersionGrammar::SemVer).unwrap(),\n            to: Some(Version::parse(\"1.1.0\", VersionGrammar::SemVer).unwrap()),\n            entries: vec![ChangelogEntry {\n                severity: Severity::Patch,\n                source: ChangeSource::Changeset {\n                    filename: \"fix.md\".to_string(),\n                    summary: summary.to_string(),\n                },\n            }],\n        }\n    }\n\n    #[test]\n    fn renders_basic_changelog_section() {\n        let input = ChangelogInput {\n            package: PackageId::parse(\"my-pkg\").unwrap(),\n            from: Version::parse(\"1.0.0\", VersionGrammar::SemVer).unwrap(),\n            to: Some(Version::parse(\"1.1.0\", VersionGrammar::SemVer).unwrap()),\n            entries: vec![ChangelogEntry {\n                severity: Severity::Minor,\n                source: ChangeSource::Changeset {\n                    filename: \"cool-dragons.md\".to_string(),\n                    summary: \"Add dragon feature\".to_string(),\n                },\n            }],\n        };\n\n        let rendered = render_section(&input).unwrap();\n        assert!(rendered.contains(\"## 1.1.0\"));\n        assert!(rendered.contains(\"### Minor Changes\"));\n        assert!(rendered.contains(\"- Add dragon feature\"));\n    }\n\n    #[test]\n    fn render_section_indents_multiline_summary_continuation_lines() {\n        let input = make_input(\"First line.\\n\\nSecond paragraph.\");\n        let rendered = render_section(&input).unwrap();\n        // Continuation lines must be indented — bare \"\\nSecond paragraph.\" is wrong\n        assert!(\n            !rendered.contains(\"\\nSecond paragraph.\"),\n            \"continuation line must not appear unindented; got:\\n{rendered}\"\n        );\n        // Must appear with at least 2-space indent\n        assert!(\n            rendered.contains(\"\\n  Second paragraph.\"),\n            \"continuation line must be indented by 2 spaces; got:\\n{rendered}\"\n        );\n    }\n\n    #[test]\n    fn render_section_handles_trailing_newline_in_summary() {\n        let input = make_input(\"Fix bug.\\n\");\n        let rendered = render_section(&input).unwrap();\n        // A trailing newline in the summary must not produce a doubled blank line\n        assert!(\n            !rendered.contains(\"- Fix bug.\\n\\n\"),\n            \"trailing newline in summary must not produce a doubled blank line; got:\\n{rendered}\"\n        );\n    }\n\n    #[test]\n    fn test_render_section_all_empty_summaries_no_heading() {\n        // CORR-002: when every entry in a section has a blank summary the\n        // section heading must not be emitted at all.\n        let input = ChangelogInput {\n            package: PackageId::parse(\"my-pkg\").unwrap(),\n            from: Version::parse(\"1.0.0\", VersionGrammar::SemVer).unwrap(),\n            to: Some(Version::parse(\"1.1.0\", VersionGrammar::SemVer).unwrap()),\n            entries: vec![ChangelogEntry {\n                severity: Severity::Patch,\n                source: ChangeSource::Changeset {\n                    filename: \"empty.md\".to_string(),\n                    summary: \"\".to_string(),\n                },\n            }],\n        };\n\n        let rendered = render_section(&input).unwrap();\n        assert!(\n            !rendered.contains(\"### Patch Changes\"),\n            \"section heading must not be emitted when all summaries are empty; got:\\n{rendered}\"\n        );\n    }\n\n    #[test]\n    fn render_section_skips_entry_with_empty_summary() {\n        let input = ChangelogInput {\n            package: PackageId::parse(\"my-pkg\").unwrap(),\n            from: Version::parse(\"1.0.0\", VersionGrammar::SemVer).unwrap(),\n            to: Some(Version::parse(\"1.1.0\", VersionGrammar::SemVer).unwrap()),\n            entries: vec![\n                ChangelogEntry {\n                    severity: Severity::Patch,\n                    source: ChangeSource::Changeset {\n                        filename: \"empty.md\".to_string(),\n                        summary: \"\".to_string(),\n                    },\n                },\n                ChangelogEntry {\n                    severity: Severity::Patch,\n                    source: ChangeSource::Changeset {\n                        filename: \"real.md\".to_string(),\n                        summary: \"Real change\".to_string(),\n                    },\n                },\n            ],\n        };\n\n        let rendered = render_section(&input).unwrap();\n        assert!(\n            !rendered.contains(\"- \\n\"),\n            \"empty summary must not produce a blank bullet; got:\\n{rendered}\"\n        );\n        assert!(\n            rendered.contains(\"- Real change\"),\n            \"non-empty entry must still appear; got:\\n{rendered}\"\n        );\n    }\n}\n","numLines":228,"startLine":1,"totalLines":228}},"sourceToolAssistantUUID":"5509290b-58a1-4022-be62-2f617aa16397","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"release-pipeline-and-matrix-hardening","slug":"shimmying-giggling-hickey"}
