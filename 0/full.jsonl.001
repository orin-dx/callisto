not forget to gate it\n/// the way a hand-copied check could.\npub(crate) fn check_schema_version\u003cE: serde::de::Error\u003e(found: u8, expected: u8, type_name: \u0026str) -\u003e Result\u003c(), E\u003e {\n    if found != expected {\n        return Err(E::custom(format!(\"unsupported {type_name} schema version\")));\n    }\n    Ok(())\n}\n\n/// Credential-free, deterministic release authori\u003ctruncated omitted_approx_tokens=\"7933\" /\u003e(\u0026self) -\u003e u8 {\n            match self {\n                Self::RegistryArtifact { schema_version, .. }\n                | Self::RemoteTag { schema_version, .. }\n                | Self::ForgePrepare { schema_version, .. }\n                | Self::ForgePublish { schema_version, .. }\n                | Self::ForgeAsset { schema_version, .. } =\u003e *schema_version,\n            }\n        }\n    }\n\n    #[derive(Deserialize)]\n    #[serde(rename_all = \"camelCase\", tag = \"kind\", deny_unknown_fields)]\n    enum ReleaseObservationEvidenceWire {\n        RegistryArtifact {\n            #[serde(rename = \"schemaVersion\")]\n            schema_version: u8,\n            package: ReleasePackageId,\n            version: Version,\n            #[serde(flatten)]\n            registry: RegistryBindingId,\n            slot: ReleaseArtifactSlot,\n            digest: ArtifactDigest,\n            #[serde(rename = \"byteLength\")]\n            byte_length: u64,\n        },\n        RemoteTag {\n            #[serde(rename = \"schemaVersion\")]\n            schema_version: u8,\n            release: ProductReleaseId,\n            name: String,\n            target: CommitSha,\n            #[serde(rename = \"annotationDigest\")]\n            annotation_digest: ArtifactDigest,\n        },\n        ForgePrepare {\n            #[serde(rename = \"schemaVersion\")]\n            schema_version: u8,\n            release: ProductReleaseId,\n            lifecycle: ForgePrepareLifecycle,\n        },\n        ForgePublish {\n            #[serde(rename = \"schemaVersion\")]\n            schema_version: u8,\n            release: ProductReleaseId,\n            #[serde(rename = \"assetRosterDigest\")]\n            asset_roster_digest: ArtifactDigest,\n        },\n        ForgeAsset {\n            #[serde(rename = \"schemaVersion\")]\n            schema_version: u8,\n            release: ProductReleaseId,\n            slot: ReleaseArtifactSlot,\n            digest: ArtifactDigest,\n            #[serde(rename = \"byteLength\")]\n            byte_length: u64,\n\n","type":"input_text"},{"text":"\n[83] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '3185,3295p' crates/callisto-model/src/release.rs \u0026\u0026 rtk sed -n '1650,1855p' crates/callisto-model/src/release.rs \u0026\u0026 rtk sed -n '60,120p' crates/callisto-graph/src/commands/release_decision.rs \u0026\u0026 rtk sed -n '1,120p' crates/callisto-model/src/version.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":30000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[84] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\n            byte_length: u64,\n        },\n    }\n\n    impl\u003c'de\u003e Deserialize\u003c'de\u003e for ReleaseObservationEvidence {\n        fn deserialize\u003cD\u003e(deserializer: D) -\u003e Result\u003cSelf, D::Error\u003e\n        where\n            D: Deserializer\u003c'de\u003e,\n        {\n            let wire = ReleaseObservationEvidenceWire::deserialize(deserializer)?;\n            let version = match \u0026wire {\n                ReleaseObservationEvidenceWire::RegistryArtifact { schema_version, .. }\n                | ReleaseObservationEvidenceWire::RemoteTag { schema_version, .. }\n                | ReleaseObservationEvidenceWire::ForgePrepare { schema_version, .. }\n                | ReleaseObservationEvidenceWire::ForgePublish { schema_version, .. }\n                | ReleaseObservationEvidenceWire::ForgeAsset { schema_version, .. } =\u003e *schema_version,\n            };\n            if version != 1 {\n                return Err(serde::de::Error::custom(\"unsupported observation evidence schema\"));\n            }\n            Ok(match wire {\n                ReleaseObservationEvidenceWire::RegistryArtifact {\n                    schema_version,\n                    package,\n                    version,\n                    registry,\n                    slot,\n                    digest,\n                    byte_length,\n                } =\u003e Self::RegistryArtifact {\n                    schema_version,\n                    package,\n                    version,\n                    registry,\n                    slot,\n                    digest,\n                    byte_length,\n                },\n                ReleaseObservationEvidenceWire::RemoteTag {\n                    schema_version,\n                    release,\n                    name,\n                    target,\n                    annotation_digest,\n                } =\u003e Self::RemoteTag {\n                    schema_version,\n                    release,\n                    name,\n                    target,\n        \u003ctruncated omitted_approx_tokens=\"3669\" /\u003eally-equal inputs produce identical `raw` values, and\n                // therefore compare `==` and hash equal (derived PartialEq/Eq/\n                // Hash include `raw`). SemVer has no analogous normalization\n                // requirement (each version already has one canonical form),\n                // so the caller's literal input is preserved for that grammar.\n                let canonical = parsed.to_string();\n                Ok(Version {\n                    grammar,\n                    raw: canonical,\n                    parsed: ParsedVersion::Pep440(parsed),\n                })\n            }\n            VersionGrammar::Maven =\u003e Err(VersionParseError {\n                raw: raw.to_string(),\n                grammar,\n                message: format!(\"{grammar:?} has no versioning implementation yet (§7.7)\"),\n            }),\n        }\n    }\n\n    pub fn semver(major: u64, minor: u64, patch: u64) -\u003e Self {\n        let parsed = semver::Version::new(major, minor, patch);\n        Version {\n            grammar: VersionGrammar::SemVer,\n            raw: parsed.to_string(),\n            parsed: ParsedVersion::SemVer(parsed),\n        }\n    }\n\n    pub fn grammar(\u0026self) -\u003e VersionGrammar {\n        self.grammar\n    }\n\n    pub fn render(\u0026self) -\u003e \u0026str {\n        \u0026self.raw\n    }\n\n    pub fn raw(\u0026self) -\u003e \u0026str {\n        \u0026self.raw\n    }\n\n    pub fn major(\u0026self) -\u003e Option\u003cu64\u003e {\n        match \u0026self.parsed {\n            ParsedVersion::SemVer(v) =\u003e Some(v.major),\n            ParsedVersion::Pep440(v) =\u003e v.release().first().copied(),\n        }\n    }\n\n    pub fn minor(\u0026self) -\u003e Option\u003cu64\u003e {\n        match \u0026self.parsed {\n            ParsedVersion::SemVer(v) =\u003e Some(v.minor),\n            ParsedVersion::Pep440(v) =\u003e v.release().get(1).copied(),\n        }\n    }\n\n    pub fn patch(\u0026self) -\u003e Option\u003cu64\u003e {\n        match \u0026self.parsed {\n            ParsedVersion::SemVer(v) =\u003e Some(v.patch),\n            ParsedVersion::Pep440(v) =\u003e v.release().get(2).copied(),\n        }\n    }\n\n","type":"input_text"},{"text":"\n[85] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"ReleaseDecision\\\\(|ReleaseDecisionError|from\\\\(.*ReleaseDecision\\\" crates/callisto-graph/src/error.rs crates/callisto-model/src/release.rs | head -80 \u0026\u0026 rtk sed -n '120,180p' crates/callisto-model/src/package.rs 2\u003e/dev/null || true \u0026\u0026 rtk rg -n \\\"fn ecosystem\\\" crates/callisto-model/src\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,