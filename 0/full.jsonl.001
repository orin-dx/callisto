yPI release artifact names for `{package}` require exact graph-owned distribution descriptors; wheel tags must not be guessed\"\n                ),\n            }),\n        _ =\u003e Err(GraphError::UnsupportedRelease {\n            feature: UnsupportedReleaseFeature::Ecosystem,\n        }),\n    }\n}\n\nfn canonical_operation_order(\n    operations: BTreeMap\u003cReleaseOperationId, ReleaseOperation\u003e,\n) -\u003e Result\u003cVec\u003cReleaseOperation\u003e, GraphError\u003e {\n    let mut remaining: BTreeMap\u003c_, usize\u003e = operations\n        .iter()\n        .map(|(id, operation)| (id.clone(), operation.prerequisites().len()))\n        .collect();\n    let mut dependents = BTreeMap::\u003cReleaseOperationId, Vec\u003cReleaseOperationId\u003e\u003e::new();\n    for (id, operation) in \u0026operations {\n        for prerequisite in operation.prerequisites() {\n            dependents.entry(prerequisite.clone()).or_default().push(id.clone());\n        }\n    }\n    let mut ready: BTreeSet\u003c_\u003e = remaining\n        .iter()\n        .filter_map(|(id, count)| (*count == 0).then_some(id.clone()))\n        .collect();\n    let mut ordered = Vec::with_capacity(operations.len());\n    while let Some(id) = ready.pop_first() {\n        ordered.push(operations.get(\u0026id).expect(\"known operation\").clone());\n        for dependent in dependents.get(\u0026id).into_iter().flatten() {\n            let count = remaining.get_mut(dependent).expect(\"known operation\");\n            *count -= 1;\n            if *count == 0 {\n                ready.insert(dependent.clone());\n            }\n        }\n \u003ctruncated omitted_approx_tokens=\"858\" /\u003e:PypiToken {\n            password_env_name: \"TWINE_PASSWORD\",\n            username: \"__token__\",\n        }),\n        _ =\u003e Err(GraphError::UnsupportedRelease {\n            feature: UnsupportedReleaseFeature::Ecosystem,\n        }),\n    }\n}\n\n/// Maps a `url::ParseError` to a specific, static diagnostic reason for\n/// [`GraphError::UnsafeRegistryBinding`]/[`GraphError::UnsafeGitRemote`],\n/// rather than discarding it behind one generic \"invalid URL\" message.\nfn url_parse_error_reason(error: url::ParseError) -\u003e \u0026'static str {\n    match error {\n        url::ParseError::RelativeUrlWithoutBase =\u003e \"URL has no scheme (e.g. missing `https://`)\",\n        url::ParseError::EmptyHost =\u003e \"URL host is empty\",\n        url::ParseError::InvalidPort =\u003e \"URL port is invalid\",\n        url::ParseError::InvalidIpv4Address | url::ParseError::InvalidIpv6Address =\u003e {\n            \"URL host is not a valid IP address\"\n        }\ncrates/callisto-graph/src/commands/release.rs:148:        api: String,\ncrates/callisto-graph/src/commands/release.rs:165:        api: \u0026'a str,\ncrates/callisto-graph/src/commands/release.rs:1192:                api: api.clone(),\ncrates/callisto-graph/src/config/resolve.rs:176:        api: String,\ncrates/callisto-graph/src/config/resolve.rs:375:                api: normalize_registry_url(registry, \"api-url\", raw.api_url.as_deref().expect(\"checked\"))?,\ncrates/callisto-graph/src/config/resolve.rs:1035:                api: \"https://crates.io/api/v1/crates/new\".to_string(),\ncrates/callisto-graph/src/config/resolve.rs:1483:                api: \"https://cargo.example.test/api\".to_string(),\ncrates/callisto-graph/src/config/resolve.rs:1511:                api: \"https://cargo.example.test/api/%2F/%20/%E2%98%83\".to_string(),\ncrates/callisto-graph/src/config/resolve.rs:1517:    fn built_in_crates_io_binding_uses_the_exact_publish_api_endpoint() {\ncrates/callisto-graph/src/config/resolve.rs:1528:                api: \"https://crates.io/api/v1/crates/new\".to_string(),\n\n","type":"input_text"},{"text":"\n[86] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk rg -n \\\"CRATES_IO\\\" crates/callisto-model/src crates/callisto-graph/src | head -30\",\"workdir\":\"/private/tmp/callisto-relea