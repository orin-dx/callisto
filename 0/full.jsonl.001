s its existing meaning, then `/`\n        // so `cargo/pkg-*` is accepted too, matching `PackageId::parse`'s two\n        // qualified forms.\n        let (ecosystem, rest) = [':', '/']\n            .into_iter()\n            .find_map(|sep| {\n                let (prefix, rest) = s.split_once(sep)?;\n                Ecosystem::from_prefix(prefix).map(|eco| (Some(eco), rest))\n            })\n            .unwrap_or((None, s));\n        let glob = Glob::new(rest)?;\n        Ok(Self {\n            raw: s.to_string(),\n            ecosystem,\n            matcher: glob.compile_matcher(),\n        })\n    }\n\n    /// Returns the ecosystem this pattern was scoped to via an\n    /// `ecosystem:` prefix, or `None` for a bare pattern.\n    pub fn ecosystem(&self) -> Option<Ecosystem> {\n        self.ecosystem\n    }\n\n    /// Returns true when the given `PackageId` matches this pattern.\n    ///\n    /// A bare pattern (no `ecosystem:` prefix) matches any ecosystem, so\n    /// `\"pkg-*\"` matches both `cargo:pkg-a` and `npm:pkg-b`. An\n    /// ecosystem-prefixed pattern like `\"cargo:pkg-*\"` matches only packages\n    /// in that ecosystem — `id.ecosystem()` must equal the parsed prefix\n    /// before the glob remainder is compared against `id.name()`.\n    pub fn matches(&self, id: &PackageId) -> bool {\n        self.matches_in_ecosystems(id.name(), id.ecosystem().as_slice())\n    }\n\n    /// Like [`Self::matches`], but checks a name against an explicit set of","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"41ad3aa2-d60e-426c-8aaa-a543d17e265d","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-colon","root":"/Users/gabe/Projects/callisto/.claude/worktrees/t06-colon","branch":"fix/reject-colon-references","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"