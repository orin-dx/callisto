{"parentUuid":"e2fb55df-fe63-4046-a573-148140755af3","isSidechain":false,"promptId":"d414fc59-b7f8-4e4f-b632-f1108dd317dd","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UswvirtgpNoYmdaDQEcjMD","type":"tool_result","content":"141-# Per-crate line coverage against a threshold (default 90%): the workspace total can pass while a small crate is far below.\n142-# Needs profile data from a prior `cargo llvm-cov` run; it does not re-run tests.\n143:coverage-per-crate threshold=\"90\":\n144-    #!/usr/bin/env bash\n145-    set -euo pipefail\n146-    cargo llvm-cov report --json --summary-only > /tmp/callisto-cov-summary.json\n147-    report=$(jq -r '\n148-        .data[0].files[]\n149-        | select(.filename | test(\"/crates/\"))\n150-        | {crate: (.filename | capture(\"/crates/(?<c>[^/]+)/\").c), count: .summary.lines.count, covered: .summary.lines.covered}\n151-        | [.crate, .count, .covered]\n152-        | @tsv\n153-      ' /tmp/callisto-cov-summary.json \\\n154-      | awk -F'\\t' -v threshold=\"{{threshold}}\" '\n155-          {sum[$1]+=$2; cov[$1]+=$3}\n156-          END {\n157-            for (c in sum) {\n158-              pct = (cov[c]/sum[c]*100)\n159-              status = (pct+0 < threshold+0) ? \"FAIL\" : \"pass\"\n160-              printf \"%s\\t%d\\t%d\\t%.2f\\t%s\\n\", c, sum[c], cov[c], pct, status\n161-            }\n162-          }\n163-        ' | sort)\n164-    echo \"$report\" | awk -F'\\t' '{printf \"%-25s lines=%-6s covered=%-6s cover=%6s%%  %s\\n\", $1, $2, $3, $4, $5}'\n165-    echo \"$report\" | grep -q FAIL && exit 1 || exit 0\n166-\n167-# Clean build targets, Moon task caches, and generated artifacts\n168-clean:","is_error":false}]},"uuid":"d2324451-0679-472b-94ae-132a48095663","timestamp":"2026-11-13T06:39:47.911Z","toolUseResult":{"stdout":"141-# Per-crate line coverage against a threshold (default 90%): the workspace total can pass while a small crate is far below.\n142-# Needs profile data from a prior