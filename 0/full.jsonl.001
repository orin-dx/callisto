`git --version` output (e.g. `\"git version 2.39.5\"`,\n/// `\"...2.39.5.windows.1\"` on Windows, `\"...2.39.5-rc1\"` for a pre-release).\n/// Only the leading `major.minor.patch` triple is parsed, each component\n/// truncated at its first non-digit char (`5-rc1` -> `5`) before reaching\n/// `semver`: an unstripped hyphenated suffix would make `semver::VersionReq`\n/// exclude it from the `>=2.20` floor entirely, since semver reqs never\n/// match a pre-release unless the requirement itself carries a matching\n/// tag -- irrelevant to a real git build tag. Extra dot-separated\n/// components (`.windows.1`) are ignored; a missing minor/patch defaults\n/// to `0`.\n///\n/// Comparison itself is delegated to [`semver::VersionReq`] parsing\n/// [`REQUIRED_GIT`], so the floor lives in one place, not a hand-maintained\n/// duplicate that could drift from the error message's constant."},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1273,"cache_read_input_tokens":627744,"output_tokens":1587,"output_tokens_details":{"thinking_tokens":490},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1273,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1587,"cache_read_input_tokens":627744,"cache_creation_input_tokens":1273,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1273},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CeJKzNHZhtxZvjEyB7K98","type":"assistant","uuid":"aa71a98a-cabd-4ada-bbd8-b8f30ab4e7d2","timestamp":"2026-08-22T19:20:17.058Z","effort":"high","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"d