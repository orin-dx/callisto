d | Set `pre-major-inference` to `off`, `conservative`, or `conservative-feat` in callisto.toml. |\norigin/main:docs/specs/versioning.json:92:      \"criterion\": \"`pre-major-inference` changes only inferred severity, and only for a package with a prior release tag whose \npub(crate) fn resolve_package_config<'a>(\n    native_names: &[(Ecosystem, &str)],\n    cfg: &'a ResolvedConfig,\n) -> Option<&'a PackageConfig> {\n    cfg.packages\n        .iter()\n        .find(|(rule_id, _)| rule_applies(rule_id, native_names))\n        .map(|(_, pcfg)| pcfg)\n}\n\npub fn parse_pre_major_policy(s: &str) -> Result<PreMajorInferencePolicy, ConfigError> {\n    match s {\n        \"off\" | \"false\" => Ok(PreMajorInferencePolicy::Off),\n        \"conservative\" => Ok(PreMajorInferencePolicy::Conservative),\n        \"conservative-feat\" => Ok(PreMajorInferencePolicy::ConservativeFeat),\n        _ => Err(ConfigError::InvalidPreMajorInference { found: s.to_string() }),\n    }\n}\n\n/// Parses the five override fields shared by `[[package]]` and\n/// `[[package-set]]` blocks (release-trigger, tag-template, changelog,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"c267f7b1-0fdd-4176-a910-c05cbd9560f4","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a3264fad8587e83c7","root":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a3264fad8587e83c7","branch":"fix/subdir-diff-and-pre-tags","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callisto","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/callis