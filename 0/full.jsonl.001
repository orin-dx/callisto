ther error-severity diagnostics'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;filter-plan'= {\n         callisto-cli:test |             cand --plan 'Path to a publish plan JSON file, inline JSON, or `-` to read it from stdin'\n         callisto-cli:test |             cand --report 'Path to a publish report JSON file, inline JSON, or `-` to read it from stdin'\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release'= {\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |             cand plan 'Create a read-only durable release intent from exact package selections'\n         callisto-cli:test |             cand inspect 'Display a durable intent, manifest, state, or receipt without recomputing it'\n         callisto-cli:test |             cand reconcile 'Report which pending operations are eligible without changing release state'\n         callisto-cli:test |             cand execute 'Execute a previously approved intent. This is the only durable mutation route'\n         callisto-cli:test |             cand help 'Print this message or the help of the given subcommand(s)'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;plan'= {\n         callisto-cli:test |             cand --package 'Exact qualified package identity, for example `cargo/callisto-cli`. Repeat this flag to select multiple packages. This local/manual mode cannot be combined with --from-release-commit'\n         callisto-cli:test |             cand --from-release-commit 'Exact merged release-PR commit checked out in this workspace. CI derives the roster from its versioned manifest delta and never reruns changeset planning'\n         callisto-cli:test |             cand --out 'Explicit path where the immutable intent JSON will be atomically written'\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;inspect'= {\n         callisto-cli:test |             cand --input 'Explicit path to an intent, artifact manifest, state, or receipt JSON document'\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --