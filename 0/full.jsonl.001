{"type":"bridge-session","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","bridgeSessionId":"cse_013R2ytxL4nYq1T7cJBdRjiu","lastSequenceNum":8710,"ownerAccountUuid":"138d593e-e185-4f72-89f2-82e1a501f134","ownerOrganizationUuid":"602db9b4-428d-49e6-a99c-64152cc62a79"}
{"parentUuid":"2f80f837-b7c0-457e-bb20-4bd4075ea010","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011CguYhJ6ukVYSh45NXVhVz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013hmsM7PzbYYUqHaNUw4pLb","name":"Write","input":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a66cc14c58c4599d3/.changeset/skip-private-workspace-root.md","content":"---\ncallisto-cli: minor\n---\n\nA private npm workspace root is no longer treated as a package.\n\n- A root `package.json` that is `private` and lists `workspaces` is skipped, so it stops appearing in `status` and in release plans. Many project templates give that root a version such as `0.0.0`, and until now Callisto listed it as a package even though it only holds scripts and tooling, is never published, and nothing depends on it by version.\n- `status` prints one line when it skips a root, so it never disappears silently.\n- To version the root anyway, add a `[[package]]` block to `callisto.toml` with `match = \"npm/<name>\"`, where `<name>` is the root's `package.json` name, such as `match = \"npm/monorepo\"`.\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3949,"cache_read_input_tokens":503514,"output_tokens":611,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3949,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":611,"cache_read_input_tokens":503514,"cache_creation_input_tokens":3949,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3949},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_013hmsM7PzbYYUqHaNUw4pLb":{"file_path":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a66cc14c58c4599d3/.changeset/skip-private-workspace-root.md","content":"---\ncallisto-cli: minor\n---\n\nA private npm workspace root is no longer treated as a package.\n\n- A root `package.json` that is `private` and lists `workspaces` is skipped, so it stops appearing in `status` and in release plans. Many project templates give that root a version such as `0.0.0`, and until now Callisto listed it as a package even though it only holds scripts and tooling, is never published, and nothing depends on it by version.\n- `status` prints one line when it skips a root, so it never disappears silently.\n- To version the root anyway, add a `[[package]]` block to `callisto.toml` with `match = \"npm/<name>\"`, where `<name>` is the root's `package.json` name, such as `match = \"npm/monorepo\"`.\n"}},"serverClassifierRequest":"e747d3ab-c388-4e1b-829b-75d74b9fb946","apiBlockIndex":0,"requestId":"req_011CguYhHoKDqCShxNKimyz5","requestRef":"7e43ee95-19d3-40d5-a323-5a63fbcb3122","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"d8aba489-bc4b-4bc0-bfac-3d1d120ee7f0","timestamp":"2026-11-10T16:16:27.550Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-a66cc14c58c4599d3","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"feat/skip-private-root","slug":"mossy-snacking-stream"}
