{"parentUuid":"6792ea7d-b352-4109-9a66-c83eb2b19d6c","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/justfile","snippet":"9\tbuild-release:\n10\t    cargo build --release -p callisto-cli\n11\t\n12\t# Run unit, integration, doctests, and E2E tests\n13\ttest:\n14\t    cargo nextest run --workspace || moon run :test\n15\t    cargo test --doc\n16\t\n17\t# Run Clippy lints (warnings treated as errors) via moon\n18\tlint:\n19\t    moon run :lint\n20\t\n21\t# Check code formatting compliance via moon\n22\tfmt-check:\n23\t    moon run :format-check\n24\t\n25\t# Format code automatically via moon\n26\tfmt:\n27\t    moon run :format\n28\t\n...\n86\tclean:\n87\t    moon clean 2>/dev/null || true\n88\t    cargo clean\n89\t    rm -f lcov.info callisto-schema.json\n90\t\n91\t# Fast pre-commit hook validation (<500ms formatting check)\n92\tpre-commit: fmt-check\n93\t\n94\t# Fast pre-push hook validation (<2s formatting and clippy lints check)\n95\tpre-push: fmt-check lint\n96\t\n97\t# Install native Git pre-commit and pre-push hooks\n98\thooks:\n99\t    @echo '#!/bin/sh\\njust pre-commit' > .git/hooks/pre-commit\n100\t    @chmod +x .git/hooks/pre-commit\n101\t    @echo '#!/bin/sh\\njust pre-push' > .git/hooks/pre-push\n102\t    @chmod +x .git/hooks/pre-push\n103\t    @echo \"Git pre-commit and pre-push hooks installed successfully.\""},"type":"attachment","uuid":"11d6075f-d18f-4867-99d3-4de91bcf0963","timestamp":"2026-08-23T20:07:05.119Z","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"docs-cleanup-rust-comments","slug":"shimmying-giggling-hickey"}
