{"parentUuid":"1f94a75d-f81d-4685-8faf-bf99d30beea5","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/locate/membership.rs","snippet":"1\tuse globset::{GlobBuilder, GlobSet, GlobSetBuilder};\n2\tuse std::path::Path;\n3\t\n4\t/// Builds a [`GlobSet`] from a list of glob strings, matched with\n5\t/// `literal_separator(true)` semantics (`*` does not cross `/`; `**` does)\n6\t/// against forward-slash-normalized, workspace-relative paths.\n7\t///\n8\t/// Per-entry glob-compile-failure rule: an entry that fails to compile is\n9\t/// skipped and treated as never-matching; every other syntactically valid\n10\t/// entry in the same list is still compiled and matched normally. Never\n11\t/// panics, never returns an error.\n12\tpub(crate) fn build_globset(entries: &[String]) -> GlobSet {\n13\t    let mut builder = GlobSetBuilder::new();\n14\t    for entry in entries {\n15\t        if let Ok(glob) = GlobBuilder::new(entry).literal_separator(true).build() {\n16\t            builder.add(glob);\n17\t        }\n18\t    }\n19\t    builder.build().unwrap_or_else(|_| GlobSet::empty())\n20\t}\n21\t\n22\t#[cfg(test)]\n23\tmod tests {\n24\t    #[test]\n25\t    fn yaml_rust2_smoke_test_parses_a_trivial_mapping() {\n26\t        let docs = yaml_rust2::YamlLoader::load_from_str(\"packages:\\n  - \\\"a\\\"\\n\").unwrap();\n27\t        assert_eq!(docs.len(), 1);\n28\t    }\n29\t}\n30\t\n31\t/// Cargo `[workspace]` members/exclude membership filter, computed once per\n32\t/// `IgnoreWalkLocator::projects()` call from the workspace root's\n33\t/// `Cargo.toml`.\n34\tpub(crate) struct CargoMembership {\n35\t    members: Option<GlobSet>,\n36\t    exclude: GlobSet,\n37\t    hybrid_root: bool,\n38\t}\n39\t\n40\timpl CargoMembership {\n41\t    /// `rel` must be a workspace-relative, forward-slash-normalized path.\n42\t    /// `is_root` is true exactly when `rel == Path::new(\".\")`.\n43\t    pub(crate) fn admits(&self, rel: &Path, is_root: bool) -> bool {\n44\t        if is_root && self.hybrid_root {\n45\t            return true;\n46\t        }\n47\t        if self.exclude.is_match(rel) {\n48\t            return false;\n49\t        }\n50\t        match &self.members {\n51\t            None => true,\n52\t            Some(members) => members.is_match(rel),\n53\t        }\n54\t    }\n55\t}\n56\t\n57\t/// Safely parses a TOML array-of-strings item, returning `None` for any\n58\t/// other shape (bare string, table, non-string entries, etc.) instead of\n59\t/// panicking.\n60\tfn parse_toml_string_array(item: &toml_edit::Item) -> Option<Vec<String>> {\n61\t    let arr = item.as_array()?;\n62\t    let mut out = Vec::with_capacity(arr.len());\n63\t    for v in arr.iter() {\n64\t        out.push(v.as_str()?.to_string());\n65\t    }\n66\t    Some(out)\n67\t}\n68\t\n69\tfn absent_cargo_membership() -> CargoMembership {\n70\t    CargoMembership {\n71\t        members: None,\n72\t        exclude: GlobSet::empty(),\n73\t        hybrid_root: false,\n74\t    }\n75\t}\n76\t\n77\t/// NAIVE first pass: only handles (1) Cargo.toml file entirely absent, and\n78\t/// (2) a well-formed [workspace] with members/exclude arrays of strings.\n79\t/// Every other shape (workspace table absent, TOML unparseable, members/\n80\t/// exclude present but not an array-of-strings, members key absent) is\n81\t/// NOT yet handled safely -- this deliberately panics or misbehaves on\n82\t/// those inputs today; TASK-03b/03c/03d/03e replace these naive lines.\n83\tpub(crate) fn read_cargo_membership(root: &Path) -> CargoMembership {\n84\t    let content = match std::fs::read_to_string(root.join(\"Cargo.toml\")) {\n85\t        Ok(c) => c,\n86\t        Err(_) => return absent_cargo_membership(),\n87\t    };\n88\t    let doc = match content.parse::<toml_edit::DocumentMut>() {\n89\t        Ok(d) => d,\n90\t        Err(_) => return absent_cargo_membership(),\n91\t    };\n92\t    let hybrid_root = doc.get(\"package\").is_some() && doc.get(\"workspace\").is_some();\n93\t    let Some(workspace) = doc.get(\"workspace\") else {\n94\t        return CargoMembership {\n95\t            members: None,\n96\t            exclude: GlobSet::empty(),\n97\t            hybrid_root,\n98\t        };\n99\t    };\n100\t    let members = workspace\n101\t        .get(\"members\")\n102\t        .and_then(parse_toml_string_array)\n103\t        .map(|v| build_globset(&v));\n104\t    let exclude = workspace\n105\t        .get(\"exclude\")\n106\t        .and_then(parse_toml_string_array)\n107\t        .map(|v| build_globset(&v))\n108\t        .unwrap_or_else(GlobSet::empty);\n109\t    CargoMembership {\n110\t        members,\n111\t        exclude,\n112\t        hybrid_root,\n113\t    }\n114\t}\n115\t\n116\t#[cfg(test)]\n117\tmod cargo_membership_tests {\n118\t    use super::*;\n119\t    use std::path::Path;\n120\t    use tempfile::tempdir;\n121\t\n122\t    #[test]\n123\t    fn read_cargo_membership_admits_all_when_no_cargo_toml_file_exists() {\n124\t        let dir = tempdir().unwrap();\n125\t        let m = read_cargo_membership(dir.path());\n126\t        assert!(m.admits(Path::new(\"crates/anything\"), false));\n127\t    }\n128\t\n129\t    #[test]\n130\t    fn read_cargo_membership_honors_well_formed_members_and_exclude() {\n131\t        let dir = tempdir().unwrap();\n132\t        std::fs::write(\n133\t            dir.path().join(\"Cargo.toml\"),\n134\t            \"[workspace]\\nmembers = [\\\"crates/*\\\"]\\nexclude = [\\\"crates/scratch-example\\\"]\\n\",\n135\t        )\n136\t        .unwrap();\n137\t        let m = read_cargo_membership(dir.path());\n138\t        assert!(m.admits(Path::new(\"crates/kept-example\"), false));\n139\t        assert!(!m.admits(Path::new(\"crates/scratch-example\"), false));\n140\t        assert!(!m.admits(Path::new(\"tools/outside\"), false));\n141\t    }\n142\t\n143\t    #[test]\n144\t    fn read_cargo_membership_falls_back_to_absent_when_members_is_bare_string() {\n145\t        let dir = tempdir().unwrap();\n146\t        std::fs::write(\n147\t            dir.path().join(\"Cargo.toml\"),\n148\t            \"[workspace]\\nmembers = \\\"crates/*\\\"\\n\",\n149\t        )\n150\t        .unwrap();\n151\t        let m = read_cargo_membership(dir.path());\n152\t        assert!(m.admits(Path::new(\"tools/outside\"), false));\n153\t    }\n154\t\n155\t    #[test]\n156\t    fn read_cargo_membership_falls_back_to_excluding_nothing_when_exclude_is_bare_string() {\n157\t        let dir = tempdir().unwrap();\n158\t        std::fs::write(\n159\t            dir.path().join(\"Cargo.toml\"),\n160\t            \"[workspace]\\nmembers = [\\\"crates/*\\\"]\\nexclude = \\\"crates/scratch-example\\\"\\n\",\n161\t        )\n162\t        .unwrap();\n163\t        let m = read_cargo_membership(dir.path());\n164\t        assert!(m.admits(Path::new(\"crates/scratch-example\"), false));\n165\t        assert!(!m.admits(Path::new(\"tools/outside\"), false));\n166\t    }\n167\t\n168\t    #[test]\n169\t    fn read_cargo_membership_detects_hybrid_root_and_exempts_it_from_exclude() {\n170\t        let dir = tempdir().unwrap();\n171\t        std::fs::write(\n172\t            dir.path().join(\"Cargo.toml\"),\n173\t            \"[package]\\nname = \\\"root-crate\\\"\\nversion = \\\"0.1.0\\\"\\n\\n[workspace]\\nmembers = [\\\"crates/*\\\"]\\nexclude = [\\\".\\\"]\\n\",\n174\t        )\n175\t        .unwrap();\n176\t        let m = read_cargo_membership(dir.path());\n177\t        assert!(m.admits(Path::new(\".\"), true));\n178\t    }\n179\t\n180\t    #[test]\n181\t    fn read_cargo_membership_admits_all_when_workspace_table_absent_but_file_exists() {\n182\t        let dir = tempdir().unwrap();\n183\t        std::fs::write(\n184\t            dir.path().join(\"Cargo.toml\"),\n185\t            \"[package]\\nname = \\\"solo\\\"\\nversion = \\\"0.1.0\\\"\\n\",\n186\t        )\n187\t        .unwrap();\n188\t        let m = read_cargo_membership(dir.path());\n189\t        assert!(m.admits(Path::new(\"crates/anything\"), false));\n190\t    }\n191\t\n192\t    #[test]\n193\t    fn read_cargo_membership_falls_back_to_absent_when_root_toml_is_unparseable() {\n194\t        let dir = tempdir().unwrap();\n195\t        std::fs::write(dir.path().join(\"Cargo.toml\"), \"[workspace\\nmembers = [\\n\").unwrap();\n196\t        let m = read_cargo_membership(dir.path());\n197\t        assert!(m.admits(Path::new(\"crates/anything\"), false));\n198\t    }\n199\t\n200\t    #[test]\n201\t    fn read_cargo_membership_honors_exclude_when_no_members_key_present() {\n202\t        let dir = tempdir().unwrap();\n203\t        std::fs::write(\n204\t            dir.path().join(\"Cargo.toml\"),\n205\t            \"[workspace]\\nexclude = [\\\"crates/foo\\\"]\\n\",\n206\t        )\n207\t        .unwrap();\n208\t        let m = read_cargo_membership(dir.path());\n209\t        assert!(!m.admits(Path::new(\"crates/foo\"), false));\n\n... [363 lines truncated] ..."},"type":"attachment","uuid":"2cb6f526-f3ea-4732-b5c7-42d8f1325506","timestamp":"2026-08-16T03:42:12.454Z","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.232","gitBranch":"main","slug":"shimmying-giggling-hickey"}
