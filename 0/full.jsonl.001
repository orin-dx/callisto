{"parentUuid":"c7e88c66-72a0-423f-9659-fe6e424104d3","isSidechain":false,"promptId":"54b26ed8-b071-4ecb-982a-8303d963cdc1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QgSBaTbkHFAB7eKwgqWX6d","type":"tool_result","content":"    let parent_ref = format!(\"{}^\", release_commit.as_str());\n    let parent_args = [\"rev-parse\", parent_ref.as_str()];\n    let parent = git_stdout(workspace.runner, &workspace.root, &parent_args)?;\n    CommitSha::parse(&parent).map_err(|source| command_malformed_output(\"git\", &parent_args, source.to_string()))?;\n\n    let diff_tree_args = [\n        \"diff-tree\",\n        \"--no-commit-id\",\n        \"--name-status\",\n        \"-r\",\n        \"--no-renames\",\n        parent.as_str(),\n        release_commit.as_str(),\n    ];\n    let changed = git_stdout(workspace.runner, &workspace.root, &diff_tree_args)?;\n    let changed = parse_name_status(&changed, &diff_tree_args)?;\n    Ok((parent, changed))\n}\n\n/// The commit has the shape of a version commit: it wrote the decision, consumed a changeset, and touched only the\n/// paths a version commit may touch.\nfn require_version_commit_shape<R: CommandRunner, D: DependencyResolver>(\n    workspace: &Workspace<'_, R, D>,\n    release_commit: &CommitSha,\n    changed: &[(String, String)],\n    decision_path: &str,\n) -> Result<(), GraphError> {\n    let changeset_dir = normalized_git_path(&workspace.config.changesets_dir)?;\n\n    // The decision must be written by this commit, not left over from an earlier release.\n    let decision_freshly_written = changed\n        .iter()\n        .any(|(status, path)| path == decision_path && matches!(status.as_str(), \"A\" | \"M\"));\n    if !decision_freshly_written {\n        return Err(GraphError::ReleaseCommitVerificationFailed {\n            commit: release_commit.clone(),\n            reason: CommitVerificationFailure::DecisionNotWrittenByCommit,","is_error":false}]},"uuid":"0f76a772-f93d-4427-bcf8-1b2cf6660945"