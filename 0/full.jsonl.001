{"parentUuid":"289813e3-b1d0-422b-b099-20efd8df53ca","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/callisto/crates/callisto-graph/src/commands/tag.rs","snippet":"1\tuse callisto_model::{\n2\t    ApplyPermit, CommandRunner, CreatedTag, PublishPlan, TagReport, SCHEMA_VERSION,\n3\t};\n4\tuse callisto_vcs::{GitDataSource, VcsError};\n5\t\n6\tuse crate::error::GraphError;\n7\tuse crate::resolver::DependencyResolver;\n8\tuse crate::Workspace;\n9\t\n10\t#[derive(Clone, Debug, Default)]\n11\tpub struct TagOptions {\n12\t    pub floating_major: bool,\n13\t}\n14\t\n15\tpub fn create_tags<R: CommandRunner, D: DependencyResolver>(\n16\t    ws: &Workspace<'_, R, D>,\n17\t    plan: &PublishPlan,\n18\t    permit: Option<&ApplyPermit>,\n19\t) -> Result<TagReport, GraphError> {\n20\t    create_tags_with_options(ws, plan, &TagOptions::default(), permit)\n21\t}\n22\t\n23\t/// Creates one git tag per release in `plan`.\n24\t///\n25\t/// `permit` is the dry-run gate: `None` reports the tags that *would* be\n26\t/// created without touching a single ref, `Some` creates them. It replaces the\n27\t/// former `TagOptions::dry_run` bool so that the preview branch and the write\n28\t/// branch cannot disagree -- the write calls simply do not typecheck without a\n29\t/// permit in hand.\n30\tpub fn create_tags_with_options<R: CommandRunner, D: DependencyResolver>(\n31\t    ws: &Workspace<'_, R, D>,\n32\t    plan: &PublishPlan,\n33\t    opts: &TagOptions,\n34\t    permit: Option<&ApplyPermit>,\n35\t) -> Result<TagReport, GraphError> {\n36\t    let mut tags = Vec::new();\n37\t\n38\t    // `Workspace::git_access` never hard-fails on a missing gix discovery:\n39\t    // `wasm32` has no gix at all (excluded from that target's dependency\n40\t    // set), and even natively a failed discovery just means every op below\n41\t    // runs through the `CommandRunner` fallback instead. Its write\n42\t    // operations (`create_tag`/`create_floating_major`) additionally\n43\t    // guarantee a discovered repo's result is authoritative and never\n44\t    // masked by a shell retry -- see `GitAccess`'s doc comment. Sharing the\n45\t    // workspace-scoped instance (rather than a fresh `GitAccess::discover`)\n46\t    // means this command doesn't pay for a second discovery when `ws.tags()`\n47\t    // below also needs one.\n48\t    let git = ws.git_access();\n49\t\n50\t    for release in &plan.releases {\n51\t        let tag_str = release.tag_name.as_str();\n52\t\n53\t        let Some(permit) = permit else {\n54\t            if opts.floating_major {\n55\t                let tmpl = ws.tags()?.template(&release.package);\n56\t                if let Some(v_str) = tmpl.extract_version_str(release.tag_name.as_str()) {\n57\t                    let grammar = ws\n58\t                        .graph\n59\t                        .packages()\n60\t                        .find(|p| p.id == release.package)\n61\t                        .and_then(|p| p.version_grammar().ok())\n62\t                        .unwrap_or(callisto_model::VersionGrammar::SemVer);\n63\t                    if let Ok(ver) = callisto_model::Version::parse(v_str, grammar) {\n64\t                        if let Some(major_tag) = tmpl.render_floating_major(&ver) {\n65\t                            tags.push(CreatedTag {\n66\t                                package: release.package.clone(),\n67\t                                tag_name: major_tag,\n68\t                                sha: release.sha.clone(),\n69\t                            });\n70\t                        }\n71\t                    }\n72\t                }\n73\t            }\n74\t\n75\t            let already_existed = ws.tags()?.contains_tag(tag_str);\n76\t            let sha = if already_existed {\n77\t                match git.resolve_commit(tag_str)? {\n78\t                    Some(actual) => actual,\n79\t                    None => {\n80\t                        return Err(GraphError::Vcs(VcsError::RefNotFound {\n81\t                            ref_name: tag_str.to_string(),\n82\t                        }))\n83\t                    }\n84\t                }\n85\t            } else {\n86\t                release.sha.clone()\n87\t            };\n88\t\n89\t            tags.push(CreatedTag {\n90\t                package: release.package.clone(),\n91\t                tag_name: release.tag_name.clone(),\n92\t                sha,\n93\t            });\n94\t            continue;\n95\t        };\n96\t\n97\t        let already_existed = ws.tags()?.contains_tag(tag_str);\n98\t\n99\t        let sha = if already_existed {\n100\t            match git.resolve_commit(tag_str)? {\n101\t                Some(actual) => actual,\n102\t                None => {\n103\t                    return Err(GraphError::Vcs(VcsError::RefNotFound {\n104\t                        ref_name: tag_str.to_string(),\n105\t                    }))\n106\t                }\n107\t            }\n108\t        } else {\n109\t            let msg = format!(\"Release {}\", tag_str);\n110\t            git.create_tag(tag_str, &release.sha, Some(&msg), permit)?;\n111\t            release.sha.clone()\n112\t        };\n113\t\n114\t        if opts.floating_major {\n115\t            let tmpl = ws.tags()?.template(&release.package);\n116\t            let ver_str = tmpl.extract_version_str(release.tag_name.as_str());\n117\t            let grammar = ws\n118\t                .graph\n119\t                .packages()\n120\t                .find(|p| p.id == release.package)\n121\t                .and_then(|p| p.version_grammar().ok())\n122\t                .unwrap_or(callisto_model::VersionGrammar::SemVer);\n123\t\n124\t            if let Some(v_str) = ver_str {\n125\t                if let Ok(ver) = callisto_model::Version::parse(v_str, grammar) {\n126\t                    if let Some(major_tag) = tmpl.render_floating_major(&ver) {\n127\t                        git.create_floating_major(major_tag.as_str(), &release.sha, permit)?;\n128\t                        tags.push(CreatedTag {\n129\t                            package: release.package.clone(),\n130\t                            tag_name: major_tag,\n131\t                            sha: release.sha.clone(),\n132\t                        });\n133\t                    }\n134\t                }\n135\t            }\n136\t        }\n137\t\n138\t        tags.push(CreatedTag {\n139\t            package: release.package.clone(),\n140\t            tag_name: release.tag_name.clone(),\n141\t            sha,\n142\t        });\n143\t    }\n144\t\n145\t    Ok(TagReport {\n146\t        schema_version: SCHEMA_VERSION,\n147\t        created_tags: tags,\n148\t        diagnostics: Vec::new(),\n149\t    })\n150\t}"},"type":"attachment","uuid":"4383f427-8c90-41f9-b46a-40430f4653b1","timestamp":"2026-08-19T21:27:30.200Z","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.233","gitBranch":"main","slug":"shimmying-giggling-hickey"}
