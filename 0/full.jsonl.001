/src/commands/release_observation.rs crates/callisto-graph/src/commands/release_artifacts.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":50000}); text(r.output);\n\n","type":"input_text"},{"text":"\n[72] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\n//! Pure argv construction for \"publish a package to its registry\", plus\n//! subprocess-output classification for the same three ecosystems (Cargo,\n//! npm, PyPI).\n//!\n//! This module owns exactly two questions per ecosystem: *what command do we\n//! run* (given package/plan facts and already-detected environment facts --\n//! never a [`callisto_model::CommandRunner`] call of its own) and *what did\n//! the finished command's output mean*. Actually invoking the command, and\n//! any retry/backoff policy around a failed attempt, is the caller's job --\n//! see `super::release::ValidatedReleaseIntent::dispatch_prepared`, the\n//! durable release executor's single production publish path.\n//!\n//! A small amount of local filesystem reading happens here (the Cargo\n//! on-disk version check, npm package-manager detection from lockfiles) --\n//! that's \"gathering the facts needed to build the right argv\", not\n//! executing a publish. It never shells out.\n\nuse std::path::{Path, PathBuf};\nuse std::time::Duration;\n\nuse callisto_manifests::WorkspaceCargoResolver;\nuse callisto_model::{\n    normalize_pypi_package_name, CommandOutput, Ecosystem, NpmAccess, PackageId, PublishOutcome, RegistryError, Version,\n};\n\nuse crate::error::GraphError;\n\n/// Default fallback wait (seconds) when a registry does not supply a\n/// `retry_after` value and the classifier cannot parse one from output.\nconst DEFAULT_RATE_LIMIT_WAIT_SECS: u64 = 60;\n\n/// One subprocess invocation: program, args, and working directory. Building\n/// this is the entire job of the `*_publish_argv` functions below --\n/// executing it is the caller's.\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct Argv {\n    pub program: String,\n    pub args: Vec\u003cString\u003e,\n    pub cwd: PathBuf,\n}\n\n// ---------------------------------------------------------------- cargo\n\n/// Builds the exact `cargo publish` argv for one crate: `--manifest-path`\n/// (so the caller can keep the wor\u003ctruncated omitted_approx_tokens=\"6598\" /\u003es/release_observation.rs:176:return OperationObservation::Unverifiable(ObservationFailure::Capability {\ncrates/.../commands/release_observation.rs:230:_ =\u003e OperationObservation::Unverifiable(ObservationFailure::Capability {\ncrates/.../commands/release_observation.rs:244:) -\u003e OperationObservation {\ncrates/.../commands/release_observation.rs:252:Ok(RemoteAnnotatedTagObservation::Absent) =\u003e OperationObservation::Absent,\ncrates/.../commands/release_observation.rs:254:OperationObservation::Conflict(ExternalConflict::RemoteTag(conflict))\ncrates/.../commands/release_observation.rs:258:OperationObservation::Exact(ReleaseObservationEvidence::remote_tag(\ncrates/.../commands/release_observation.rs:265:Err(_) =\u003e OperationObservation::Unverifiable(ObservationFailure::Command {\ncrates/.../commands/release_observation.rs:280:) -\u003e OperationObservation {\ncrates/.../commands/release_observation.rs:281:let snapshot = match artifacts.snapshot(slot) {\ncrates/.../commands/release_observation.rs:284:return OperationObservation::Unverifiable(ObservationFailure::Capability {\ncrates/.../commands/release_observation.rs:292:OperationObservation::Exact(ReleaseObservationEvidence::registry_artifact(\ncrates/.../commands/release_observation.rs:317:Ok(None) =\u003e OperationObservation::Absent,\ncrates/.../commands/release_observation.rs:332:OperationObservation::Conflict(ExternalConflict::RegistryDigest {\ncrates/.../commands/release_observation.rs:338:Err(failure) =\u003e OperationObservation::Unverifiable(failure),\ncrates/.../commands/release_observation.rs:351:Ok(None) =\u003e OperationObs