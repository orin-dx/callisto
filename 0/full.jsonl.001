;\n    let spec = format!(\"{head}:{dir}\");\n    if !head_object_exists(ws, &spec)? {\n        // The changesets directory didn't exist at HEAD (e.g. the first `version` run); nothing left pending.\n        return Ok(false);\n    }\n    let output = ws\n        .runner\n        .run(\"git\", &[\"ls-tree\", \"--name-only\", &spec], &ws.root)\n        .map_err(GraphError::Command)?;\n    if !output.success() {\n        return Err(GraphError::Command(callisto_model::CommandError::Failed {\n            program: \"git\".to_string(),\n            exit_code: output.exit_code,\n            stderr: output.stderr,\n        }));\n    }\n    Ok(output.stdout.lines().any(|name| {\n        let name = name.trim();\n        name.ends_with(\".md\") && name != \"README.md\"\n    }))\n}\n\nfn manifest_blob_at<R: CommandRunner, D: DependencyResolver>(\n    ws: &Workspace<'_, R, D>,\n    head: &str,\n    path: &str,\n) -> Result<Option<String>, GraphError> {\n    let spec = format!(\"{head}:{path}\");\n    if !head_object_exists(ws, &spec)? {\n        return Ok(None);\n    }\n    let output = ws","is_error":false}]},"uuid":"8df1ba6e-502f-480e-8832-d9b99469095f","timestamp":"2026-11-11T20:26:12.633Z","toolUseResult":{"stdout":"        })\n        .collect()\n}\n\nfn git_file<R: CommandRunner>(\n    runner: &R,\n    root: &std::path::Path,\n    commit: &str,\n    path: &str,\n) -> Result<String, GraphError> {\n    let object = format!(\"{commit}:{path}\");\n    git_stdout(runner, root, &[\"show\", &object])\n}\n\npub(super) fn normalized_git_path(path: &std::path::Path) -> Result<String, GraphError> {\n    let path = callisto_model::workspace_relative(path)?;\n\n/// Every path in `paths` at `commit`, in one `git cat-file --batch`.\nfn batch_manifest_blobs_at<R: CommandRunner>(\n    runner: &R,\n    root: &std::path::Path,\n    commit: &str,\n    paths: &[&str],\n) -> Result<Vec<BatchBlob>, GraphError> {\n    let objects: Vec<String> = paths.iter().map(|path| format!(\"{commit}:{path}\"))