est | \n         callisto-cli:test |     local context curcontext=\"$curcontext\" state line\n         callisto-cli:test |     _arguments \"${_arguments_options[@]}\" : \\\n         callisto-cli:test | '--format=[Output format for command results]:FORMAT:(text json)' \\\n         callisto-cli:test | '--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n         callisto-cli:test | '--dry-run[Preview manifest and file changes without writing to disk]' \\\n         callisto-cli:test | '-h[Print help]' \\\n         callisto-cli:test | '--help[Print help]' \\\n         callisto-cli:test | '-V[Print version]' \\\n         callisto-cli:test | '--version[Print version]' \\\n         callisto-cli:test | \":: :_callisto_commands\" \\\n         callisto-cli:test | \"*::: :->callisto\" \\\n         callisto-cli:test | && ret=0\n         callisto-cli:test |     case $state in\n         callisto-cli:test |     (callisto)\n         callisto-cli:test |         words=($line[1] \"${words[@]}\")\n         callisto-cli:test |         (( CURRENT += 1 ))\n         callisto-cli:test |         curcontext=\"${curcontext%:*:*}:callisto-command-$line[1]:\"\n         callisto-cli:test |         case $line[1] in\n         callisto-cli:test |             (add)\n         callisto-cli:test | _arguments \"${_arguments_options[@]}\" : \\\n         callisto-cli:test | '*--package=[Package and severity to include, as \\`name\\:severity\\` (patch, minor, or major); repeatable. Omit to enter the interactive wizard]:NAME:SEVERITY:_default' \\\n         callisto-cli:test | '--summary=[Human-readable summary of the change to record in the changeset]:SUMMARY:_default' \\\n         callisto-cli:test | '--format=[Output format for command results]:FORMAT:(text json)' \\\n         callisto-cli:test | '--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n         callisto-cli:test | '--dry-run[Preview manifest and file changes without writing to disk]' \\\n         callisto-cli:test | '-h[Print help]' \\\n         callisto-cli:test | '--help[Print help]' \\\n         callisto-cli:test | && ret=0\n         callisto-cli:test | ;;\n         callisto-cli:test | (status)\n         callisto-cli:test | _arguments \"${_arguments_options[@]}\" : \\\n         callisto-cli:test | '--format=[Output format for command results]:FORMAT:(text json)' \\\n         callisto-cli:test | '--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n         callisto-cli:test | '--strict[Enable strict mode\\: promote warning-level diagnostics to errors, causing a non-zero exit]' \\\n         callisto-cli:test | '--strict-graph[Treat dependency-graph warnings as errors]' \\\n         callisto-cli:test | '--check[Exit with a distinct status code indicating whether any changesets are pending]' \\\n         callisto-cli:test | '--dry-run[Preview manifest and file changes without writing to disk]' \\\n         callisto-cli:test | '-h[Print help]' \\\n         callisto-cli:test | '--help[Print help]' \\\n         callisto-cli:test | && ret=0\n         callisto-cli:test | ;;\n         callisto-cli:test | (matrix)\n         callisto-cli:test | _arguments \"${_arguments_options[@]}\" : \\\n         callisto-cli:test | '--package=[Restrict output to one registered package'\\''s name (PackageId\\:\\:name())]:PACKAGE:_default' \\\n         callisto-cli:test | '--format=[Output format for command results]:FORMAT:(text json)' \\\n         callisto-cli:test | '--cwd=[Workspace directory to operate in (defaults to the current directory)]:CWD:_files' \\\n         callisto-cli:test | '--dry-run[Preview manifest and file changes without writing to disk]' \\\n         callisto-cli:test | '-h[Print help]' \\\n         callisto-cli:test | '--help[Print help]' \\\n         callisto-cli:test | && ret=0\n         callisto-cli:test | ;;\n         callisto-cli:test | (version)\n         callisto-cli:test | 