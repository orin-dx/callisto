erate in (defaults to the current directory)'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;execute'= {\n         callisto-cli:test |             cand --intent 'Explicit path to the durable release intent JSON document'\n         callisto-cli:test |             cand --artifact-manifest 'Explicit artifact manifest path required when the intent declares binary slots'\n         callisto-cli:test |             cand --artifact-dir 'Directory containing the exact regular artifact files named by the manifest. Required with --artifact-manifest; it is never inferred from the checkout'\n         callisto-cli:test |             cand --state 'Explicit durable state path. If omitted, state is stored outside the checkout'\n         callisto-cli:test |             cand --format 'Output format for command results'\n         callisto-cli:test |             cand --cwd 'Workspace directory to operate in (defaults to the current directory)'\n         callisto-cli:test |             cand --dry-run 'Preview manifest and file changes without writing to disk'\n         callisto-cli:test |             cand -h 'Print help'\n         callisto-cli:test |             cand --help 'Print help'\n         callisto-cli:test |         }\n         callisto-cli:test |         &'callisto;release;help'= {\n         callisto-cli:test |             cand plan 'Create a read-only durable release intent from exact package selections'\n         callisto-cli:test |             cand inspect 'Display a durable intent, manifest, state, or receipt without recomputing it'\n         callisto-cli:test |             cand reconcile 'Report which pending operations are eligible without changing release state'\n         callisto-