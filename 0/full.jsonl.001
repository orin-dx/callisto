tual_target, actual_annotation) =\n            parse_annotated_tag_object(\u0026object.stdout).map_err(|_| VcsError::LocalAnnotatedTagConflict {\n                name: name.clone(),\n                conflict: LocalAnnotatedTagConflict::NotAnnotated,\n            })?;\n        if actual_target != *target_sha {\n            return Err(VcsError::LocalAnnotatedTagConflict {\n                name: name.clone(),\n                conflict: LocalAnnotatedTagConflict::Target {\n                    expected: target_sha.clone(),\n                    actual: actual_target,\n                },\n\n","type":"input_text"},{"text":"\n[69] tool exec call: const r = await tools.exec_command({\"cmd\":\"rtk sed -n '3735,3805p' crates/callisto-model/src/release.rs \u0026\u0026 rtk sed -n '3200,3285p' crates/callisto-model/src/release.rs\",\"workdir\":\"/private/tmp/callisto-release-recovery\",\"yield_time_ms\":10000,\"max_output_tokens\":12000});\ntext(r.output);\n\n","type":"input_text"},{"text":"\n[70] tool exec result: Script completed\nWall time 0.2 seconds\nOutput:\n\n                Ok(())\n            }\n            _ =\u003e Err(SuccessorError::MismatchedObservationEvidence),\n        }\n    }\n\n    #[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]\n    #[non_exhaustive]\n    pub enum SuccessorError {\n        #[error(\"registry key `{raw}` is malformed\")]\n        MalformedRegistryKey { raw: String },\n        #[error(\"product name `{raw}` is not canonical and safe\")]\n        InvalidProductName { raw: String },\n        #[error(\"release destination profile `{raw}` is not canonical and safe\")]\n        InvalidDestinationProfile { raw: String },\n        #[error(\"npm dist-tag `{raw}` is not canonical and safe\")]\n        InvalidNpmDistTag { raw: String },\n        #[error(\"release destination does not support ecosystem {ecosystem:?}\")]\n        UnsupportedDestinationEcosystem { ecosystem: Ecosystem },\n        #[error(\"coordinated release version `{version}` is not SemVer\")]\n        NonSemverProductVersion { version: Box\u003cVersion\u003e },\n        #[error(\"coordinated release has no package versions\")]\n        EmptyCoordinatedRoster,\n        #[error(\"coordinated release versions diverge: expected {expected}, found {found}\")]\n        DivergentCoordinatedVersion {\n            expected: Box\u003cVersion\u003e,\n            found: Box\u003cVersion\u003e,\n        },\n        #[error(\"release decision does not derive the coordinated product release\")]\n        DecisionProductMismatch,\n        #[error(\"approved registry artifact is outside the release decision\")]\n        RegistryArtifactOutsideDecision,\n        #[error(\"artifact slot is unsafe\")]\n        UnsafeArtifactSlot,\n        #[error(\"artifact slot provenance is invalid\")]\n        InvalidProvenance,\n        #[error(\"product payloads do not share one provenance verification policy\")]\n        HeterogeneousProductProvenance,\n        #[error(\"reserved artifact file name is wrong\")]\n        WrongReservedFileName,\n        #[error(\"product payload filename or kin\u003ctruncated omitted_approx_tokens=\"667\" /\u003ea_version: u8,\n            package: ReleasePackageId,\n            version: Version,\n            #[serde(flatten)]\n            registry: RegistryBindingId,\n            slot: ReleaseArtifactSlot,\n            digest: ArtifactDigest,\n            #[serde(rename = \"byteLength\")]\n            byte_length: u64,\n        },\n        RemoteTag {\n            #[serde(rename = \"schemaVersion\")]\n            schema_version: u8,\n            release: ProductReleaseId,\n            name: String,\n            target: CommitSha,\n            #[serde(rename = \"annotationDigest\")]\n            annotation_digest: ArtifactDigest,\n        },\n        ForgePrepare {\n            #[serde(rename = \"schemaVersion\")]\n            schema_version: u8,\n            release: ProductReleaseId,\n            lifecycle: ForgePrepareLifecycle,\n       