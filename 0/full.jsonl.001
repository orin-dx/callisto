\"ws\");\n+        init_repo(repo);\n+        write(&ws, \"pkg-a/Cargo.toml\", \"[package]\\n\");\n+        commit(repo, \"README.md\", \"r\\n\", \"chore: init\");\n+        run_git(repo, &[\"tag\", \"-a\", \"-m\", \"release\", \"pkg-a@0.1.0\"]);\n+        commit(repo, \"ws/pkg-a/src/lib.rs\", \"a\\n\", \"feat: a\");\n+\n+        let (result, _) = changed(&ws, &[make_pkg(\"pkg-a\")]);\n+\n+        assert!(result[&id(\"pkg-a\")]);\n+    }\n+\n     #[test]\n     fn an_uncommitted_change_counts_as_changed() {\n         let dir = tagged_repo();\ndiff --git a/crates/callisto-graph/src/commands/snapshot.rs b/crates/callisto-graph/src/commands/snapshot.rs\nindex 1f5ccbd11..09d07d4ba 100644\n--- a/crates/callisto-graph/src/commands/snapshot.rs\n+++ b/crates/callisto-graph/src/commands/snapshot.rs\n@@ -10,7 +10,7 @@ use crate::Workspace;\n pub fn validate_tag(tag: &str, dotted: bool) -> Result<(), GraphError> {\n     let identifier = |s: &str| !s.is_empty() && s.chars().all(|c| c.is_ascii_alphanumeric() || c == '-');\n     let valid = if dotted {\n-        tag.split('.').all(identifier)\n+        !tag.is_empty() && semver::Prerelease::new(tag).is_ok()\n     } else {\n         identifier(tag)\n     };\n@@ -211,7 +211,7 @@ mod tests {\n     use crate::{GraphError, Workspace};\n     use callisto_model::{CommandError, CommandOutput, CommandRunner};\n \n-    use super::plan_snapshot;\n+    use super::{plan_snapshot, validate_tag};\n \n     struct FailingTagsRunner;\n \n@@ -291,6 +291,19 @@ mod tests {\n         assert!(plan_snapshot(&ws, \"pr-42\").is_ok());\n     }\n \n+    #[rstest::rstest]\n+    #[case(\"beta.1\", true)]\n+    #[case(\"rc.2\", true)]\n+    #[case(\"alpha\", true)]\n+    #[case(\"01\", false)]\n+    #[case(\"beta.01\", false)]\n+    #[case(\"\", false)]\n+    #[case(\"a..b\", false)]\n+    #[case(\"a b\", false)]\n+    fn a_dotted_tag_must_be_a_valid_prerelease(#[case] tag: &str, #[case] valid: bool) {\n+        assert_eq!(validate_tag(tag, true).is_ok(), valid