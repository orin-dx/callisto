             &self.0\n            }\n        }\n\n        impl ::std::fmt::Display for $name {\n            fn fmt(&self, f: &mut ::std::fmt::Formatter<'_>) -> ::std::fmt::Result {\n                f.write_str(&self.0)\n            }\n        }\n    };\n}\n\npub(crate) use string_newtype_display;\n\n/// Defines a plain single-field `String` newtype: the common derive list,\n/// `#[schemars(with = \"String\")]`, transparent (unvalidated) serde, `as_str`,\n/// and `Display`. For newtypes that validate on construction/deserialize\n/// (e.g. [`TagName`](crate::tag::TagName), [`CommitSha`]), use\n/// [`string_newtype_display!`] instead and hand-write the rest.\nmacro_rules! string_newtype {\n    ($(#[$doc:meta])* $name:ident) => {\n        $(#[$doc])*\n        #[derive(Clone, Debug, PartialEq, Eq, Hash, PartialOrd, Ord, Serialize, Deserialize, JsonSchema)]\n        #[schemars(with = \"String\")]\n        #[serde(transparent)]\n        pub struct $name(pub String);\n\ncrates/callisto-model/src/report.rs:9:pub const SCHEMA_VERSION: u32 = 1;\ncrates/callisto-model/src/release/snapshot.rs:57:    pub const SCHEMA_VERSION: u8 = 1;\ncrates/callisto-model/src/release/intent.rs:96:    pub const SCHEMA_VERSION: u8 = 5;\ncrates/callisto-model/src/release/execution.rs:93:    pub const SCHEMA_VERSION: u8 = 3;\ncrates/callisto-model/src/release/execution.rs:419:    pub const SCHEMA_VERSION: u8 = 2;\ncrates/callisto-model/src/release_pr.rs:35:    pub const SCHEMA_VERSION: u8 = 1;\ncrates/callisto-model/src/release_pr.rs:103:    pub const SCHEMA_VERSION: u8 = 2;\ncrates/callisto-model/src/release_pr.rs:219:    pub const SCHEMA_VERSION: u8 = 2;\ncrates/callisto-model/src/release_pr.rs:580:    pub const SCHEMA_VERSION: u8 = 1;\ncrates/callisto-model/src/release/artifact.rs:189:    pub const SCHEMA_VERSION: u8 = 1;\ncrates/callisto-model/src/release/decision.rs:118:    pub const SCHEMA_VERSION: u8 = 2;\ndocs/specs/versioning.json:266:      \"criterion\": \"`version --emit-decision <path>` 