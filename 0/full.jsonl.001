{"parentUuid":"00acf283-6f93-4ef9-893e-2d541a6d18ae","isSidechain":false,"promptId":"086d689e-84e9-40a2-b78d-e56c8e1183ee","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tv31ej8LnsiETigdAdcWsw","type":"tool_result","content":"_2026-11-12 · [compare](https://github.com/orin-dx/callisto/compare/callisto@0.19.0...callisto@0.20.0)_\n\n### Minor Changes\n\n- Every JSON field Callisto writes is now camelCase, so scripts see one naming style.\n\n  - `version` and `snapshot` `--format json` reports: `reason.dep_kind` and `reason.dependency_to` are now `depKind` and `dependencyTo`.\n  - Release plumbing files: the preview's `short_sha` is `shortSha`, and the receipt's `peeled_commit`, `tag_name` and `byte_length` are `peeledCommit`, `tagName` and `byteLength`.\n  - A test now walks every report and file type and fails on a snake_case key.\n\n  Breaking: scripts that read `reason.dep_kind` or `reason.dependency_to` from `version` or `snapshot` JSON must use `depKind` and `dependencyTo`.\n\n  Action: keep Callisto and the release action on one version. A release preview or receipt written by 0.19 does not load in this version.\n- Mistyped config keys and pre-release tags are caught where you make them.","is_error":false}]},"uuid":"8495cf66-274d-45bb-a142-aa828b9e022b","timestamp":"2026-11-12T05:17:43.238Z","toolUseResult":{"stdout":"_2026-11-12 · [compare](https://github.com/orin-dx/callisto/compare/callisto@0.19.0...callisto@0.20.0)_\n\n### Minor Changes\n\n- Every JSON field Callisto writes is now camelCase, so scripts see one naming style.\n\n  - `version` and `snapshot` `--format json` reports: `reason.dep_kind` and `reason.dependency_to` are now `depKind` and `dependencyTo`.\n  - Release plumbing files: the preview's `short_sha` is `shortSha`, and the receipt's `peeled_commit`, `tag_name` and `byte_length` are `peeledCommit`, `tagName` and `byteLength`.\n  - A test now walks every report and file type and fails on a snake_case key.\n\n  Breaking: scripts that read `reason.dep_kind` or `reason.dependency_to` from `version` or `snapshot` JSON must use `depKind` and `dependencyTo`.\n\n  Action: keep Callisto and the release action on one version. A release preview or receipt written by 0.19 does not load in this version.\n- Mistyped config keys and pre-release tags are caught where you make them.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"dangerouslyDisableSandbox":true},"serverClassifierContext":{"request":"9446cb52-50d2-4c9c-a61f-c4dde0506508","context":{"git_state":{"cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-acb69fdff4fb3419d","root":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-acb69fdff4fb3419d","branch":"fix/no-pending-changesets-message","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/callisto","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/callisto","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-acb69fdff4fb3419d","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"00acf283-6f93-4ef9-893e-2d541a6d18ae","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"6cc3e47b-8406-4c17-94fb-22313682fad8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/agent-acb69fdff4fb3419d","sessionId":"6cc3e47b-8406-4c17-94fb-22313682fad8","version":"2.1.311","gitBranch":"fix/no-pending-changesets-message","slug":"mossy-snacking-stream"}
