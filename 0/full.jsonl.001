versions = BTreeMap::new();\n    base_versions.insert(pkg_id.clone(), Version::semver(0, 1, 0));\n\n    let mut initial_versions = indexmap::IndexMap::new();\n    initial_versions.insert(\"pkg-a\".to_string(), Version::semver(0, 1, 0));\n    let pre_state = callisto_model::format::PreState {\n        mode: callisto_model::format::PreMode::Pre,\n        tag: \"beta\".to_string(),\n        initial_versions,\n        changesets: vec![\"cool-thing\".to_string()],\n    };\n\n    let inference = crate::infer::NoInference;\n    let agg = aggregate(\n        &graph,\n        &identity_for(&graph.pkg),\n        &cfg,\n        &git,\n        &tags,\n        &base_versions,\n        Some(&pre_state),\n        &inference,\n    )\n    .unwrap();\n\n    assert_eq!(agg.new_pre_changesets, vec![\"small-fix\".to_string()]);\n    assert_eq!(\n        agg.severities.get(&pkg_id),\n        Some(&Severity::Minor),\n        \"the recorded minor changeset must still set the severity the new patch changeset is added to\"\n    );\n    assert_eq!(\n        agg.changelog_inputs.get(&pkg_id).map(|input| input.entries.len()),\n        Some(1),\n        \"only the new changeset is logged\"\n    );\n}\n\n/// With no changeset on disk in pre mode, nothing is new.","originalFile":null,"structuredPatch":[{"oldStart":1683,"oldLines":8,"newStart":1683,"newLines":73,"lines":["     );"," }"," ","-/// With no changeset on disk in pre mode, the run has no active changeset, not just an empty `new_pre_changesets`.","+/// A new changeset naming a package whose earlier changeset is already recorded still bumps it, at the higher severity."," #[test]","+fn test_pre_mode_new_changeset_counts_the_recorded_ones_toward_severity() {","+    let ws_dir = tempfile::tempdir().unwrap();","+    let root = ws_dir.path();","+    init_repo(root);","+","+    let cs_dir = root.join(\".changeset\");","+    std::fs::create_dir_all(&cs_dir).unwrap();","+    std::fs::write(","+        cs_dir.join(\"cool-thing.md\"),","+        \"---\\npkg-a: minor\\n---\\n\\nAdds a thing.\\n\",","+    )","+    .unwrap();","+    std::fs::write(cs_dir.join(\"small-fix.md\"), \"---\\npkg-a: patch\\n---\\n\\nFixes a thing.\\n\").unwrap();","+    std::fs::write(root.join(\"README.md\"), \"hello\\n\").unwrap();","+    run_git(root, &[\"add\", \".\"]);","+    run_git(root, &[\"commit\", \"-q\", \"-m\", \"initial commit\"]);","+","+    let pkg_id = PackageId::parse(\"pkg-a\").unwrap();","+    let graph = SinglePackageGraph {","+        pkg: make_pkg(pkg_id.clone()),","+    };","+    let cfg = crate::config::load(root).unwrap();","+    let runner = RealGitRunner;","+    let git = GitAccess::new(root, &runner);","+    let tags = crate::tags::TagIndex::build(&git, &graph, &Default::default(), &cfg).unwrap();","+    let mut base_versions = BTreeMap::new();","+    base_versions.insert(pkg_id.clone(), Version::semver(0, 1, 0));","+","+    let mut initial_versions = indexmap::IndexMap::new();","+    initial_versions.insert(\"pkg-a\".to_string(), Version::semver(0, 1, 0));","+    let pre_state = callisto_model::format::PreState {","+        mode: callisto_model::format::PreMode::Pre,","+        tag: \"beta\".to_string(),","+        initial_versions,","+        changesets: vec![\"cool-thing\".to_string()],","+    };","+","+    let inference = crate::infer::NoInference;","+    let agg = aggregate(","+        &graph,","+        &identity_for(&graph.pkg),","+        &cfg,","+        &git,","+        &tags,","+        &base_versions,","+        Some(&pre_state),","+        &inference,","+    )","+    .unwrap();","+","+    assert_eq!(agg.new_pre_changesets, vec![\"small-fix\".to_string()]);","+    assert_eq!(","+        agg.severities.get(&pkg_id),","+        Some(&Severity::Minor),","+        \"the recorded minor changeset must still set the severity the new patch changeset is added to\"","+    );","+    assert_eq!(","+        agg.changelog_inputs.get(&pkg_id).map(|input| input.entries.len()),","+        Some(1),","+        \"only the new changeset is logged\"","+    );","+}","+","+/// With no changeset on disk in pre mode, nothing is new.","+#[test]"," fn test_pre_mode_no_changesets_at_all_has_no_active_changeset() {","     let ws_dir = tempfile::tempdir().unwrap();","     let root = ws_dir.path();"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"ba29ab77-aca5-415c-9823-bb9f71836a0a","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"15c732d1-457b-4efc-91e5-664943f21b1c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto/.claude/worktrees/pre-mode-noop","sessionId":"15c732d1-457b-4efc-91e5-664943f21b1c","version":"2.1.304","gitBranch":"worktree-pre-mode-noop","slug":"lexical-jingling-puppy"}
