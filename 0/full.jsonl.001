p')\n            [CompletionResult]::new('-V', '-V ', [CompletionResultType]::ParameterName, 'Print version')\n            [CompletionResult]::new('--version', '--version', [CompletionResultType]::ParameterName, 'Print version')\n            [CompletionResult]::new('add', 'add', [CompletionResultType]::ParameterValue, 'Create a new changeset describing pending package changes')\n            [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'Show the workspace''s pending changesets and diagnostics')\n            [CompletionResult]::new('matrix', 'matrix', [CompletionResultType]::ParameterValue, 'Print the workspace''s native-build target matrix as JSON or a table')\n            [CompletionResult]::new('version', 'version', [CompletionResultType]::ParameterValue, 'Consume pending changesets and bump package versions accordingly')\n            [CompletionResult]::new('pre', 'pre', [CompletionResultType]::ParameterValue, 'Manage prerelease mode for the workspace')\n            [CompletionResult]::new('validate', 'validate', [CompletionResultType]::ParameterValue, 'Check that changesets and the dependency graph are well-formed')\n            [CompletionResult]::new('snapshot', 'snapshot', [CompletionResultType]::ParameterValue, 'Apply a temporary, non-persistent version bump for a snapshot release')\n            [CompletionResult]::new('init', 'init', [CompletionResultType]::ParameterValue, 'Scaffold Callisto configuration in the current workspace')\n            [CompletionResult]::new('plan-publish', 'plan-publish', [CompletionResultType]::ParameterValue, 'Compute which packages are ready to publish and print the publish plan')\n            [CompletionResult]::new('publish', 'publish', [CompletionResultType]::ParameterValue, 'Publish ready packages to their ecosystem registries via native CLI tools')\n            [CompletionResult]::new('compose-pr-body', 'compose-pr-body', [CompletionResultType]::ParameterValue, 'Generate a pull request body summarizing pending release changes')\n            [CompletionResult]::new('tag', 'tag', [CompletionResultType]::ParameterValue, 'Create git tags for packages in a publish plan')\n            [CompletionResult]::new('filter-plan', 'filter-plan', [CompletionResultType]::ParameterValue, 'Filter a publish plan down to what a publish report confirms actually succeeded, dropping anything that failed')\n            [CompletionResult]::new('release', 'release', [CompletionResultType]::ParameterValue, 'Create, inspect, reconcile, or execute durable release intents')\n            [CompletionResult]::new('completions', 'completions', [CompletionResultType]::ParameterValue, 'Generate shell completion scripts')\n            [CompletionResult]::new('schema', 'schema', [CompletionResultType]::ParameterValue, 'Print the JSON schema for a report type')\n            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')\n            break\n        }\n        'callisto;add' {\n            [CompletionResult]::new('--package', '--package', [CompletionResultType]::ParameterName, 'Package and severity to include, as `name:severity` (patch, minor, or major); repeatable. Omit to enter the interactive wizard')\n            [CompletionResult]::new('--summary', '--summary', [CompletionResultType]::ParameterName, 'Human-readable summary of the change to record in the changeset')\n            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format for command results')\n            [CompletionResult]::new('--cwd', '--cwd', [CompletionResultType]::ParameterName, 'Workspace directory to operate in (defaults to the current directory)')\n            [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Preview manifest and file changes without writing to disk')\n            [CompletionResult]::new('-h', '-h', [CompletionResult