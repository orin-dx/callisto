on::NewGroupMember { group } => {\n                        body.push_str(&format!(\"- New member of group `{}`.\\n\\n\", group.as_str()));\n                    }\n                    _ => {}\n                },\n                None => {\n                    body.push_str(\"_No changelog entries available._\\n\\n\");\n                }\n            }\n        }","originalFile":null,"structuredPatch":[{"oldStart":188,"oldLines":9,"newStart":188,"newLines":9,"lines":["         }"," ","         if !rendered {","-            if let Some(ref reason) = bump.reason {","-                body.push_str(\"#### Release Reason\\n\");","-                match reason {","+            body.push_str(\"#### Release Reason\\n\");","+            match &bump.reason {","+                Some(reason) => match reason {","                     callisto_model::BumpReason::Changeset { changesets } => {","                         body.push_str(&format!(","                             \"- Associated changesets: `{}`\\n\\n\","]},{"oldStart":241,"oldLines":6,"newStart":241,"newLines":9,"lines":["                         body.push_str(&format!(\"- New member of group `{}`.\\n\\n\", group.as_str()));","                     }","                     _ => {}","+                },","+                None => {","+                    body.push_str(\"_No changelog entries available._\\n\\n\");","                 }","             }","         }"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"10aeab2b-5fdc-42c1-b786-cd29f3013fcf","session_id":"ae412d01-e061-4047-918b-0d1df3d4d118","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/callisto","sessionId":"ae412d01-e061-4047-918b-0d1df3d4d118","version":"2.1.238","gitBranch":"main","slug":"shimmying-giggling-hickey"}
