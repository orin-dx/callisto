---
source: crates/callisto-graph/src/commands/init/tests.rs
expression: "render_workflow_0_8_0(&facts, \"trunk\")"
---
name: Release

on: {push: {branches: [trunk]}}

permissions: {}

jobs:
  version-pr:
    runs-on: ubuntu-latest
    permissions: {contents: write, pull-requests: write}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with: {fetch-depth: 0, persist-credentials: false}
      - uses: orin-dx/callisto/.github/actions/callisto-action@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa # callisto@0.8.0
        with: {mode: version-pr, branch: trunk}
        env:
          GH_TOKEN: ${{ github.token }}

  release:
    runs-on: ubuntu-latest
    concurrency: {group: callisto-release, cancel-in-progress: false}
    permissions: {contents: write, id-token: write}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with: {fetch-depth: 0} # zizmor: ignore[artipacked] tag push needs persisted credentials
      - name: Install the Python publishing tools
        run: |
          set -euo pipefail
          python3 -m venv "$RUNNER_TEMP/publish-venv"
          "$RUNNER_TEMP/publish-venv/bin/python" -m pip install --quiet build==1.4.4 twine==7.0.0
          echo "$RUNNER_TEMP/publish-venv/bin" >> "$GITHUB_PATH"
      - uses: orin-dx/callisto/.github/actions/callisto-action@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa # callisto@0.8.0
        with: {mode: release}
        env:
          CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN }}
          NPM_TOKEN: ${{ secrets.NPM_TOKEN }}
          NPM_CONFIG_PROVENANCE: "true"
          PYPI_TOKEN: ${{ secrets.PYPI_TOKEN }}
          GH_TOKEN: ${{ github.token }}
